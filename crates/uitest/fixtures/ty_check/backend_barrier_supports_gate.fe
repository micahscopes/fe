// mb2 B2 (negative): the `Supports<S>` op gate on barriers, orthogonal to the
// capability (mirrors B1's atomics supports-gate). The `barrier` op carries
// `where B: Supports<S>`, so support of the storage class is checked at the CALL
// SITE independently of holding the capability.
//
// Here the capability IS held (the `barrier` param provides `Barrier<EvmBackend,
// Shared>`), yet `barrier.barrier()` is rejected because `EvmBackend:
// Supports<Shared>` has no impl (EVM has no workgroup concept): `6-0003`, at the
// op. This is the "capability held but class unsupported" leg: type facts
// (`Supports<S>`) gate even when the term-level capability is in scope.

use core::backend::Shared
use core::barrier::Barrier
use std::evm::EvmBackend

fn evm_shared_barrier()
    uses (barrier: mut Barrier<EvmBackend, Shared>)
{
    barrier.barrier()
}
