// Diagnostic parity: the same mistake in an inherent associated const and in a
// trait associated const must produce the same diagnostic. This guards the
// recurring "trait const handled X, inherent const forgot X" (and vice versa)
// drift class: if the two paths ever diverge, this snapshot changes.
//
// Const-language checks apply to both kinds at declaration. Execution faults
// in ordinary associated values wait until use. Generated `#[event]` and
// `#[error]` implementations have their own materialization checks and error
// ownership. See `inherent_const_non_const_body.fe` for the non-const-call
// case, which remains a declaration error even when the value is unused.

trait HasConst {
    const C: u256
}

// --- type mismatch between value and declared type: both must report 8-0000,
// --- the same plain `TypeMismatch` a top-level `const` body gets ---
struct InhMismatch {}

impl InhMismatch {
    const C: u256 = true
}

struct TraitMismatch {}

impl HasConst for TraitMismatch {
    const C: u256 = true
}
