// FCO #42 regression — a derived assoc-const initializer that reads
// `<Ty as Trait>::CONST` for a concrete `Ty` NOT implementing the trait must
// DIAGNOSE (6-0003), not ICE in semantic const lowering ("const ref should
// resolve to a semantic instance", body.rs).
//
// Deriving `AbiSize` for `Bad { inner: NoAbi }` (NoAbi: !AbiSize) generates
// `impl AbiSize for Bad` whose HEAD_SIZE folds `<NoAbi as AbiSize>::HEAD_SIZE`.
// The `NoAbi: AbiSize` obligation is now registered at type-check and surfaced
// from `diags_assoc_consts`, so the unsatisfied bound is reported as 6-0003.

use core::abi::AbiSize
use core::derive::Evidence
use core::derive::ImplBuilder
use core::derive::Reflect

impl StableAbiSize: Derive for AbiSize {
    const fn derive<T>(ev: own Evidence<AbiSize<T>>) -> Evidence<AbiSize<T>>
        uses (
            reflect: Reflect<T>,
            builder: mut ImplBuilder<AbiSize<T>>,
        )
    {
        if reflect.is_struct() {
            let mut head = builder.bool(false)
            let mut dynamic = builder.bool(false)
            let mut first = true
            for field in reflect.fields() {
                builder.require<AbiSize>(field.ty())
                let field_head = builder.trait_const(field.ty(), "HEAD_SIZE")
                let field_dyn = builder.trait_const(field.ty(), "IS_DYNAMIC")
                if first {
                    head = field_head
                    first = false
                } else {
                    head = builder.add(head, field_head)
                }
                dynamic = builder.or(dynamic, field_dyn)
            }
            builder.emit_const("HEAD_SIZE", builder.ty<u256>(), head)
            builder.emit_const("IS_DYNAMIC", builder.ty<bool>(), dynamic)
        }
        builder.finish()
        ev
    }
}

struct NoAbi {}

struct Bad {
    inner: NoAbi,
}

derive AbiSize for Bad using StableAbiSize
