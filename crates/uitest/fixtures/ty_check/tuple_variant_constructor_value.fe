// Adopts master 4d8ec2073: the condition is checked at the written type.
enum Choice {
    Value(u256),
}

fn ignore<T>(_ item: T) {}

fn bind() {
    let constructor = Choice::Value
}

fn pair() {
    let pair = (Choice::Value, 0 as u256)
}

fn pass() {
    ignore(Choice::Value)
}

fn call() -> Choice {
    Choice::Value(1)
}
