// A braced condition followed by a `,` stays a condition, also where the
// block could be a function's body. RD95 retains trait-method conditions;
// only the false free-function condition is rejected.
trait Checked {
    fn after_bound<T>() -> bool where T: Copy, { true },
}

extern {
    fn external<T>() where T: Copy, { true },
}

fn free<T>() -> bool where T: Copy, { false }, { false }
