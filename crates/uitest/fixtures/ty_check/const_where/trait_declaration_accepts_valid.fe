trait Size {
    const SIZE: u256
}

struct Large {}
impl Size for Large {
    const SIZE: u256 = 64
}

trait BigOnly<T> where T: Size, T::SIZE >= 50 {
    fn big(self) -> u256
}

struct Carrier {}
impl BigOnly<Large> for Carrier {
    fn big(self) -> u256 { 7 }
}

fn use_large() -> u256 { <Carrier as BigOnly<Large>>::big(Carrier {}) }

struct GenericCarrier<T> {
    value: T
}
impl<T> BigOnly<T> for GenericCarrier<T> where T: Size, T::SIZE >= 50 {
    fn big(self) -> u256 { 9 }
}

fn use_generic() -> u256 {
    <GenericCarrier<Large> as BigOnly<Large>>::big(GenericCarrier { value: Large {} })
}

fn forward<T, U>(_ value: T) -> u256 where T: BigOnly<U>, U: Size {
    <T as BigOnly<U>>::big(value)
}

fn use_forward() -> u256 { forward<Carrier, Large>(Carrier {}) }
