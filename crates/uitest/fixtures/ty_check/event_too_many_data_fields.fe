// An event with seventeen non-indexed fields uses the shared ABI record
// encoder and must type-check without the old tuple-arity diagnostic.
use std::evm::Log

#[event]
struct TooWide {
    f0: u256,
    f1: u256,
    f2: u256,
    f3: u256,
    f4: u256,
    f5: u256,
    f6: u256,
    f7: u256,
    f8: u256,
    f9: u256,
    f10: u256,
    f11: u256,
    f12: u256,
    f13: u256,
    f14: u256,
    f15: u256,
    f16: u256,
}
