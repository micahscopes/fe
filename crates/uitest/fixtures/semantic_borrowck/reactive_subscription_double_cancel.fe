// A subscription has one cancellation owner. The first `cancel` consumes the
// token; a second cancellation is a compile-time move conflict.

use std::reactive::{Cancelled, Event, EventSource, Subscription, cancel_event}

struct Source {}
impl Copy for Source {}

impl EventSource for Source {
    fn subscribe(mut self) -> Subscription {
        Subscription::new()
    }

    fn next(mut self, _ subscription: own Subscription) -> (Subscription, Event) {
        (subscription, Event::none())
    }

    fn cancel(mut self, _ subscription: own Subscription) -> Cancelled {
        Cancelled { consumed: subscription.cursor() }
    }
}

fn double_cancel(_ subscription: own Subscription)
    uses (source: mut EventSource)
{
    cancel_event(subscription)
    cancel_event(subscription)
}
