// A single move of a non-`Copy` value out of a fixed array index is sound and must
// remain accepted. The companion double-move fixture proves that precise constant
// indexing does not weaken the repeated-consumption guard.

struct Widget {
    n: u32,
}

fn consume(_ w: own Widget) {}

fn make() -> Widget {
    Widget { n: 0 }
}

// One fixed-index consume: sound, accepted.
fn single_index_move() {
    let arr = [make(), make()]
    consume(arr[0])
}
