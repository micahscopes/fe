// mb2 CE-4 POSITIVE pin: a SINGLE move of a non-`Copy` value out of a fixed array index
// is SOUND and must stay ALLOWED. The fail-closed floor rejects only the DOUBLE/repeat
// consume (see arr_const_index_double_move.fe), not the first, one-shot consumption of a
// fixed element. This fixture guards against the floor being over-implemented into a
// blanket "no move out of an array index" rule. It must compile with no diagnostics.

struct Widget {
    n: u32,
}

fn consume(_ w: own Widget) {}

fn make() -> Widget {
    Widget { n: 0 }
}

// One fixed-index consume: sound, accepted.
fn single_index_move() {
    let arr = [make(), make()]
    consume(arr[0])
}
