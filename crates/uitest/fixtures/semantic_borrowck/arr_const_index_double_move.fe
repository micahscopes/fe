// Moving a non-`Copy` value out of a fixed array index consumes that element. A
// second move of the same `Index(Constant)` is a use-after-move (16-0002). This is
// the array-element form of the affine completion-token guard.

struct Widget {
    n: u32,
}

fn consume(_ w: own Widget) {}

fn make() -> Widget {
    Widget { n: 0 }
}

// Same constant index consumed twice: the second `arr[0]` is a use-after-move.
fn same_index_double_move() {
    let arr = [make(), make()]
    consume(arr[0])
    consume(arr[0])
}
