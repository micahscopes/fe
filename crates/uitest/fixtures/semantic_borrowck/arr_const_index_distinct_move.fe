// Distinct literal array indices remain `Index(Constant)` through semantic place
// lowering. The borrow checker can therefore prove that these two affine moves are
// disjoint instead of conservatively conflating them as dynamic aliases.

struct Widget {
    n: u32,
}

fn consume(_ w: own Widget) {}

fn make() -> Widget {
    Widget { n: 0 }
}

// Distinct constant indices consumed once each: sound and accepted.
fn distinct_index_move() {
    let arr = [make(), make()]
    consume(arr[0])
    consume(arr[1])
}
