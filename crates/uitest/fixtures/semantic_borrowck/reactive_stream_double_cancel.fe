// Stream preserves EventSource's affine cleanup ownership. Its first `cancel`
// consumes the subscription, so a second cancellation cannot compile.

use std::reactive::{Cancelled, Event, EventSource, Stream, Subscription}

struct Source {}
impl Copy for Source {}

impl EventSource for Source {
    fn subscribe(mut self) -> Subscription {
        Subscription::new()
    }

    fn next(mut self, _ subscription: own Subscription) -> (Subscription, Event) {
        (subscription, Event::none())
    }

    fn cancel(mut self, _ subscription: own Subscription) -> Cancelled {
        Cancelled { consumed: subscription.cursor() }
    }
}

fn double_stream_cancel(_ stream: Stream, _ subscription: own Subscription)
    uses (source: mut EventSource)
{
    stream.cancel(subscription)
    stream.cancel(subscription)
}
