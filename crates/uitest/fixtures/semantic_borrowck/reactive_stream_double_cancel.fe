// Stream preserves EventSource's affine cleanup ownership. Its first `cancel`
// consumes the subscription, so a second cancellation cannot compile.

use std::reactive::{Cancelled, Event, EventSource, Stream, Subscription}

struct Source {}
impl Copy for Source {}

impl EventSource<u32> for Source {
    fn subscribe(mut self) -> Subscription<u32> {
        Subscription::new(initial: 0)
    }

    fn next(mut self, _ subscription: own Subscription<u32>) -> (Subscription<u32>, Event<u32>) {
        (subscription, Event::absent())
    }

    fn cancel(mut self, _ subscription: own Subscription<u32>) -> Cancelled {
        Cancelled { consumed: subscription.cursor() }
    }
}

fn double_stream_cancel(_ stream: Stream<u32>, _ subscription: own Subscription<u32>)
uses (source: mut EventSource<u32>)
{
    stream.cancel(subscription)
    stream.cancel(subscription)
}
