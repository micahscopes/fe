// mb2 A5.3 (d): GAT signature conformance at ARITY 2, against the REAL
// `core::backend::Backend` trait (whose `type Ref<T, S>` declares two params).
// This is the arity-2 teeth for the A4 owner-exact/conformance stack: the DECL
// is the authority. Each impl below conforms on every member EXCEPT `Ref`, so
// exactly its own `Ref` diagnostic fires, no cascade.
//
//   (i)   `type Ref<T>`   -- arity 1 < decl arity 2  -> 6-0023 count mismatch
//   (ii)  `type Ref`      -- arity 0 < decl arity 2  -> 6-0023 count mismatch
//   (iii) `Ref` omitted   -- missing associated type -> missing-assoc-type diag
//
// mb2 D1: `Buffer<T>` is now bounded `: Functor<T>` on the real `Backend`, so
// each impl's `Buffer` RHS must satisfy it or a spurious `6-0003` would mask the
// intended `Ref` diagnostics. A fixture-local `Buf<T>: Functor<T>` discharges the
// Buffer bound cleanly, keeping ONLY the `Ref` diagnostics observable.

use core::backend::Backend
use core::conal::Functor
use core::Fn

struct RefArity1 {}
struct RefArity0 {}
struct RefMissing {}

// A local buffer container satisfying the D1 `type Buffer<T>: Functor<T>` bound,
// so the Buffer member is conforming and only the `Ref` arity teeth fire below.
struct Buf<T> {}
impl<T> Functor<T> for Buf<T> {
    type Out<Y> = Buf<Y>
    fn map<Y, F: Fn<T, Y>>(self, _ f: F) -> Buf<Y> {
        todo()
    }
}

// (i) impl arity (1) < decl arity (2): the RHS ignores the class param, so
// `X::Ref<u32, Global>` == `X::Ref<u32, Local>` -- the class-conflation the
// two-param decl exists to prevent.
impl Backend for RefArity1 {
    const WORD_BITS: usize = 256
    const OVERFLOW_WRAPS: bool = true
    const MAX_PAR_LOG2: usize = 14
    type Word = u256
    type Buffer<T> = Buf<T>
    type Ref<T> = u256
}

// (ii) impl arity (0) < decl arity (2): a bare `type Ref` collapses every
// instantiation to one type.
impl Backend for RefArity0 {
    const WORD_BITS: usize = 256
    const OVERFLOW_WRAPS: bool = true
    const MAX_PAR_LOG2: usize = 14
    type Word = u256
    type Buffer<T> = Buf<T>
    type Ref = u256
}

// (iii) `Ref` omitted entirely: a missing required associated type.
impl Backend for RefMissing {
    const WORD_BITS: usize = 256
    const OVERFLOW_WRAPS: bool = true
    const MAX_PAR_LOG2: usize = 14
    type Word = u256
    type Buffer<T> = Buf<T>
}
