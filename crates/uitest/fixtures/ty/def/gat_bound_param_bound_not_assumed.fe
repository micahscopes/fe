// mb2-a4.2 (v1 scope pin): a GAT param BOUND is NOT added as an assumption
// when discharging the RHS. The decl `type Elem<T: Marker>: Producer<T>`
// demands `T: Marker` of CALLERS, but the impl-RHS discharge here gets NO
// `T: Marker` assumption, so `Store<T>: Producer<T>` (which needs `U: Marker`
// via the blanket impl) is REJECTED: `TraitBoundNotSat`.
//
// This is sound-but-stricter: rejecting a valid RHS. Adding `T: Marker` as an
// assumption here is UNSOUND unless the DUAL caller-side obligation
// (projection use sites must prove `X: Marker`) lands in the SAME slice.
// Neither exists yet; they are one future PAIRED slice. This fixture pins the
// strict v1 behavior so the relaxation cannot land unpaired unnoticed.

trait Marker {}

trait Producer<T> {}

struct Store<T> {}

impl<U> Producer<U> for Store<U>
where U: Marker
{}

struct Evm {}

trait Backend {
    type Elem<T: Marker>: Producer<T>
}

impl Backend for Evm {
    type Elem<T> = Store<T>
}
