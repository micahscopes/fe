// `${...}` splice holes are only allowed inside a `quote` body, `$` must
// be immediately followed by `{`, and quotes and holes do not nest.

fn hole_outside_quote() -> bool {
    let x = ${true}
    x
}

fn dollar_without_brace() -> bool {
    let x = $true
    x
}

fn nested_quote() {
    let q = quote { quote { true } }
}

fn nested_hole() {
    let q = quote { ${ ${true} } }
}

// Where a struct literal cannot stand, `quote` is an ordinary name followed
// by the block, so a condition reads the variable.
fn quote_in_condition(quote: bool) -> bool {
    if quote {
        return true
    }
    while quote {
        return false
    }
    false
}
