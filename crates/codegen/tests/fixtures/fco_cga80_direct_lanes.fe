use core::derive::{Derive, Evidence, ImplBuilder, Reflect}

// Canonical Cl(4,1) support semantics. These ordinary Fe const helpers are the
// only source used by both the typed Schedule32 witness and the FCO emitter.
const fn sphere_blade(_ slot: usize) -> usize {
    1 << (slot + slot / 2)
}

const fn point_blade(_ slot: usize) -> usize {
    1 << slot
}

const fn raw_left_slot(_ triple: usize) -> usize { triple / 20 }
const fn raw_point_slot(_ triple: usize) -> usize { (triple / 4) % 5 }
const fn raw_right_slot(_ triple: usize) -> usize { triple % 4 }

const fn left_blade(_ triple: usize) -> usize {
    sphere_blade(raw_left_slot(triple))
}

const fn middle_blade(_ triple: usize) -> usize {
    point_blade(raw_point_slot(triple))
}

const fn right_blade(_ triple: usize) -> usize {
    sphere_blade(raw_right_slot(triple))
}

const fn popcount5(_ value: usize) -> usize {
    (value & 1) + ((value >> 1) & 1) + ((value >> 2) & 1)
        + ((value >> 3) & 1) + ((value >> 4) & 1)
}

// 0 is positive and 1 is negative. Generator 4 (mask 16) squares to -1.
const fn gp_negative(_ a: usize, _ b: usize) -> usize {
    (
        (((a >> 1) & 1) * popcount5(b & 1))
        + (((a >> 2) & 1) * popcount5(b & 3))
        + (((a >> 3) & 1) * popcount5(b & 7))
        + (((a >> 4) & 1) * popcount5(b & 15))
        + (((a >> 4) & 1) * ((b >> 4) & 1))
    ) & 1
}

const fn triple_negative(_ triple: usize) -> usize {
    let l = left_blade(triple)
    let p = middle_blade(triple)
    let r = right_blade(triple)
    gp_negative(l, p) ^ gp_negative(l ^ p, r)
}

const fn reverse_negative(_ triple: usize) -> usize {
    let l = left_blade(triple)
    let p = middle_blade(triple)
    let r = right_blade(triple)
    gp_negative(r, p) ^ gp_negative(r ^ p, l)
}

const fn canonical_tag(_ triple: usize) -> usize {
    let l = raw_left_slot(triple)
    let r = raw_right_slot(triple)
    let l0 = l & 1
    let l1 = (l >> 1) & 1
    let r0 = r & 1
    let r1 = (r >> 1) & 1
    let same_high = 1 - (l1 ^ r1)
    let greater = l1 * (1 - r1) + same_high * l0 * (1 - r0)
    1 - greater
}

const fn diagonal_tag(_ triple: usize) -> usize {
    let l = raw_left_slot(triple)
    let r = raw_right_slot(triple)
    (1 - ((l >> 1) ^ (r >> 1))) * (1 - ((l & 1) ^ (r & 1)))
}

const fn keep_tag(_ triple: usize) -> usize {
    canonical_tag(triple)
        * (1 - (triple_negative(triple) ^ reverse_negative(triple)))
}

const fn magnitude(_ triple: usize) -> usize {
    2 - diagonal_tag(triple)
}

const fn output_blade(_ triple: usize) -> usize {
    left_blade(triple) ^ middle_blade(triple) ^ right_blade(triple)
}

const fn survivor_count() -> usize {
    let mut triple: usize = 0
    let mut count: usize = 0
    while triple < 80 {
        if keep_tag(triple) != 0 { count = count + 1 }
        triple = triple + 1
    }
    count
}

const fn survivor_triple(_ target: usize) -> usize {
    let mut triple: usize = 0
    let mut seen: usize = 0
    while triple < 80 {
        if keep_tag(triple) != 0 {
            if seen == target { return triple }
            seen = seen + 1
        }
        triple = triple + 1
    }
    80
}

static_assert(survivor_count() == 32)

// The inspectable typed witness stores the canonical source-triple identity in
// exact survivor order. There is no generated or hand-authored survivor table.
struct Zero {}
struct Term<const Triple: usize> {}
struct Add<L, R> {}
recursive type fn Schedule<const N: usize>() -> (*) {
    match N {
        0 => Zero
        _ => Add<Term<{survivor_triple(N - 1)}>, Schedule<{N - 1}>>
    }
}
type Schedule32 = Schedule<32>

// BEGIN_FORCE_SCHEDULE32
struct NatZ {}
struct NatS<N> {}
recursive type fn Nat<const N: usize>() -> (*) {
    match N {
        0 => NatZ
        _ => NatS<Nat<{N - 1}>>
    }
}
trait PlanLength { type Out }
impl PlanLength for Zero { type Out = NatZ }
impl<const I: usize, Tail: PlanLength> PlanLength for Add<Term<I>, Tail> {
    type Out = NatS<<Tail as PlanLength>::Out>
}
fn takes_nat32(_ value: Nat<32>) {}
fn schedule_has_exactly_32_terms(value: <Schedule32 as PlanLength>::Out) {
    takes_nat32(value)
}
// END_FORCE_SCHEDULE32

// BEGIN_PROVIDER_EMITTER
// One reflected five-lane storage record lets the current provider API project
// inputs and materialize the result without runtime accessors.  The semantic
// names remain visible at the call boundary as aliases.
struct ConformalVector {
    e1: f32,
    e2: f32,
    e4: f32,
    e8: f32,
    e16: f32,
}
impl Copy for ConformalVector {}
type ConformalSphere = ConformalVector
type ConformalPoint = ConformalVector

trait Sandwich {
    fn sandwich(_ sphere: ConformalSphere, _ point: ConformalPoint) -> ConformalVector
}

struct CanonicalCgaProvider {}
impl Derive<Sandwich> for CanonicalCgaProvider {
    const fn derive<T>(ev: own Evidence<Sandwich<T>>) -> Evidence<Sandwich<T>>
        uses (reflect: Reflect<T>, builder: mut ImplBuilder<Sandwich<T>>)
    {
        // A typed f32 zero without a float-literal codegen primitive.
        let sphere = builder.arg_ref("sphere")
        let point_arg = builder.arg_ref("point")
        let s1 = sphere
        let s2 = sphere
        let s8 = sphere
        let s16 = sphere
        let p1 = point_arg
        let p2 = point_arg
        let p4 = point_arg
        let p8 = point_arg
        let p16 = point_arg
        let field_index = 0
        for field in reflect.fields() {
            if field_index == 0 { s1 = builder.field_get(sphere, field) }
            if field_index == 1 { s2 = builder.field_get(sphere, field) }
            if field_index == 3 { s8 = builder.field_get(sphere, field) }
            if field_index == 4 { s16 = builder.field_get(sphere, field) }
            if field_index == 0 { p1 = builder.field_get(point_arg, field) }
            if field_index == 1 { p2 = builder.field_get(point_arg, field) }
            if field_index == 2 { p4 = builder.field_get(point_arg, field) }
            if field_index == 3 { p8 = builder.field_get(point_arg, field) }
            if field_index == 4 { p16 = builder.field_get(point_arg, field) }
            field_index = field_index + 1
        }
        let zero = builder.sub(s1, s1)
        let lane1_0 = zero
        let lane1_1 = zero
        let lane1_2 = zero
        let lane1_3 = zero
        let lane2_0 = zero
        let lane2_1 = zero
        let lane2_2 = zero
        let lane2_3 = zero
        let lane4_0 = zero
        let lane4_1 = zero
        let lane4_2 = zero
        let lane4_3 = zero
        let lane8_0 = zero
        let lane8_1 = zero
        let lane8_2 = zero
        let lane8_3 = zero
        let lane16_0 = zero
        let lane16_1 = zero
        let lane16_2 = zero
        let lane16_3 = zero
        let survivor = 0

        // Exhaustively scan the canonical semantic universe. The provider
        // range and global step budgets fail closed if this ceases to be
        // bounded; no survivor list is supplied.
        for triple in 0..80 {
            if keep_tag(triple) != 0 {
                let left = s1
                if raw_left_slot(triple) == 1 { left = s2 }
                if raw_left_slot(triple) == 2 { left = s8 }
                if raw_left_slot(triple) == 3 { left = s16 }

                let point = p1
                if raw_point_slot(triple) == 1 { point = p2 }
                if raw_point_slot(triple) == 2 { point = p4 }
                if raw_point_slot(triple) == 3 { point = p8 }
                if raw_point_slot(triple) == 4 { point = p16 }

                let right = s1
                if raw_right_slot(triple) == 1 { right = s2 }
                if raw_right_slot(triple) == 2 { right = s8 }
                if raw_right_slot(triple) == 3 { right = s16 }

                let product = builder.share(builder.mul(builder.mul(left, point), right))
                let term = product
                // Preserve the canonical raw80 IEEE operation order: compute
                // the full left*point*right product before combining the two
                // equal ordered orientations.
                if magnitude(triple) == 2 {
                    term = builder.add(product, product)
                }
                if triple_negative(triple) != 0 { term = builder.neg(term) }

                let output = output_blade(triple)
                if output == 1 {
                    if survivor < 8 { lane1_0 = builder.add(term, lane1_0) }
                    else if survivor < 16 { lane1_1 = builder.add(term, lane1_1) }
                    else if survivor < 24 { lane1_2 = builder.add(term, lane1_2) }
                    else { lane1_3 = builder.add(term, lane1_3) }
                }
                if output == 2 {
                    if survivor < 8 { lane2_0 = builder.add(term, lane2_0) }
                    else if survivor < 16 { lane2_1 = builder.add(term, lane2_1) }
                    else if survivor < 24 { lane2_2 = builder.add(term, lane2_2) }
                    else { lane2_3 = builder.add(term, lane2_3) }
                }
                if output == 4 {
                    if survivor < 8 { lane4_0 = builder.add(term, lane4_0) }
                    else if survivor < 16 { lane4_1 = builder.add(term, lane4_1) }
                    else if survivor < 24 { lane4_2 = builder.add(term, lane4_2) }
                    else { lane4_3 = builder.add(term, lane4_3) }
                }
                if output == 8 {
                    if survivor < 8 { lane8_0 = builder.add(term, lane8_0) }
                    else if survivor < 16 { lane8_1 = builder.add(term, lane8_1) }
                    else if survivor < 24 { lane8_2 = builder.add(term, lane8_2) }
                    else { lane8_3 = builder.add(term, lane8_3) }
                }
                if output == 16 {
                    if survivor < 8 { lane16_0 = builder.add(term, lane16_0) }
                    else if survivor < 16 { lane16_1 = builder.add(term, lane16_1) }
                    else if survivor < 24 { lane16_2 = builder.add(term, lane16_2) }
                    else { lane16_3 = builder.add(term, lane16_3) }
                }
                survivor = survivor + 1
            }
        }

        let out1 = builder.add(builder.add(lane1_3, lane1_2), builder.add(lane1_1, lane1_0))
        let out2 = builder.add(builder.add(lane2_3, lane2_2), builder.add(lane2_1, lane2_0))
        let out4 = builder.add(builder.add(lane4_3, lane4_2), builder.add(lane4_1, lane4_0))
        let out8 = builder.add(builder.add(lane8_3, lane8_2), builder.add(lane8_1, lane8_0))
        let out16 = builder.add(builder.add(lane16_3, lane16_2), builder.add(lane16_1, lane16_0))
        let image = builder.struct_init()
        let field_index = 0
        for field in reflect.fields() {
            if field_index == 0 { image = builder.with_field(image, field, out1) }
            if field_index == 1 { image = builder.with_field(image, field, out2) }
            if field_index == 2 { image = builder.with_field(image, field, out4) }
            if field_index == 3 { image = builder.with_field(image, field, out8) }
            if field_index == 4 { image = builder.with_field(image, field, out16) }
            field_index = field_index + 1
        }
        builder.emit_method("sandwich", image)
        builder.finish()
        ev
    }
}

derive Sandwich for ConformalVector using CanonicalCgaProvider

// BEGIN_PUBLIC_ORACLES
pub fn cga_fco_e1(
    s1: f32, s2: f32, s8: f32, s16: f32,
    p1: f32, p2: f32, p4: f32, p8: f32, p16: f32,
) -> f32 {
    <ConformalVector as Sandwich>::sandwich(
        ConformalVector { e1: s1, e2: s2, e4: 0.0, e8: s8, e16: s16 },
        ConformalVector { e1: p1, e2: p2, e4: p4, e8: p8, e16: p16 },
    ).e1
}
pub fn cga_fco_e2(
    s1: f32, s2: f32, s8: f32, s16: f32,
    p1: f32, p2: f32, p4: f32, p8: f32, p16: f32,
) -> f32 {
    <ConformalVector as Sandwich>::sandwich(
        ConformalVector { e1: s1, e2: s2, e4: 0.0, e8: s8, e16: s16 },
        ConformalVector { e1: p1, e2: p2, e4: p4, e8: p8, e16: p16 },
    ).e2
}
pub fn cga_fco_e4(
    s1: f32, s2: f32, s8: f32, s16: f32,
    p1: f32, p2: f32, p4: f32, p8: f32, p16: f32,
) -> f32 {
    <ConformalVector as Sandwich>::sandwich(
        ConformalVector { e1: s1, e2: s2, e4: 0.0, e8: s8, e16: s16 },
        ConformalVector { e1: p1, e2: p2, e4: p4, e8: p8, e16: p16 },
    ).e4
}
pub fn cga_fco_e8(
    s1: f32, s2: f32, s8: f32, s16: f32,
    p1: f32, p2: f32, p4: f32, p8: f32, p16: f32,
) -> f32 {
    <ConformalVector as Sandwich>::sandwich(
        ConformalVector { e1: s1, e2: s2, e4: 0.0, e8: s8, e16: s16 },
        ConformalVector { e1: p1, e2: p2, e4: p4, e8: p8, e16: p16 },
    ).e8
}
pub fn cga_fco_e16(
    s1: f32, s2: f32, s8: f32, s16: f32,
    p1: f32, p2: f32, p4: f32, p8: f32, p16: f32,
) -> f32 {
    <ConformalVector as Sandwich>::sandwich(
        ConformalVector { e1: s1, e2: s2, e4: 0.0, e8: s8, e16: s16 },
        ConformalVector { e1: p1, e2: p2, e4: p4, e8: p8, e16: p16 },
    ).e16
}
// END_PROVIDER_EMITTER

// Order-sensitive provenance over the helper-derived Schedule32. CTFE freezes
// the value so the Wasm runtime does not need the wider compile-time `usize`
// arithmetic used by the bounded scan.
const fn schedule_order_hash() -> usize {
    let mut triple: usize = 0
    let mut hash: usize = 17
    while triple < 80 {
        if keep_tag(triple) != 0 {
            hash = (hash * 83 + triple + 1) % 1000003
        }
        triple = triple + 1
    }
    hash
}
const SCHEDULE_ORDER_HASH: i32 = schedule_order_hash().downcast_unchecked()
pub fn cga_schedule_order_hash() -> i32 {
    SCHEDULE_ORDER_HASH
}
// END_PUBLIC_ORACLES
