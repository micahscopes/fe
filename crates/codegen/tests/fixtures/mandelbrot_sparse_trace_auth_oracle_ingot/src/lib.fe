//! Thin zero-import Wasm boundary for sparse trace authentication.

use canonical_words::{
    BrowserWordReader,
    BrowserWordWriter,
    CanonicalWordStream,
    CanonicalWords,
    CanonicalWordsProvider,
    canonical_word_stream_count,
    encode_canonical_word_stream,
}
use core::BrowserBytes
use mandelbrot_proof_fixed_air::{
    FixedMandelbrotTransitionWitness,
    derive_fixed_mandelbrot_transition_witness,
    fixed_mandelbrot_transition_output,
}
use mandelbrot_proof_fixed_air_baby_bear::{
    SparseBaseAirRow,
    SparseInteractionAccumulators,
    SparseInteractionTraceDigest,
    SparseInteractionTraceRow,
    SparseTraceDigest,
    SparseTraceAuthentication,
    empty_sparse_trace_authentication,
    sparse_base_air_row_from_witness,
    sparse_interaction_challenges,
    sparse_interaction_trace_root_power_of_two,
    sparse_trace_root_power_of_two,
    verify_sparse_trace_authentication,
    write_sparse_interaction_air_rows,
    write_sparse_trace_authentication_power_of_two,
    zero_sparse_base_air_row,
    zero_sparse_interaction_accumulators,
    zero_sparse_interaction_trace_row,
}
use mandelbrot_proof_recursive::ComplexFixed
use poseidon_baby_bear::Poseidon2Digest
use precision::fixed::Fixed

type TransitionWitness4 = FixedMandelbrotTransitionWitness<4>
type SparseTraceAuthentication4 = SparseTraceAuthentication<4, 4, 48>

struct SparseAirPrefix4 {
    pub valid: bool,
    pub base: SparseTraceDigest<4>,
    pub base_rows: [SparseBaseAirRow; 4],
    pub interaction_rows: [SparseInteractionTraceRow; 4],
    pub accumulators: SparseInteractionAccumulators,
}
impl core::marker::Copy for SparseAirPrefix4 {}
derive CanonicalWords for SparseAirPrefix4 using CanonicalWordsProvider

struct SparseAirCheckpoint4 {
    pub prefix: SparseAirPrefix4,
    pub interaction: SparseInteractionTraceDigest<4>,
    pub accepts_candidate_a: bool,
    pub accepts_candidate_b: bool,
    pub invalid: SparseInteractionTraceDigest<4>,
}
impl core::marker::Copy for SparseAirCheckpoint4 {}
derive CanonicalWords for SparseAirCheckpoint4 using CanonicalWordsProvider

fn fixed4(_ negative: u32, _ limbs: [u32; 4]) -> Fixed<4> {
    Fixed { negative: negative == 1, limbs: limbs }
}

fn complex4(
    _ real_negative: u32,
    _ real: [u32; 4],
    _ imaginary_negative: u32,
    _ imaginary: [u32; 4],
) -> ComplexFixed<4> {
    ComplexFixed {
        real: fixed4(real_negative, real),
        imaginary: fixed4(imaginary_negative, imaginary),
    }
}

fn transition4(
    _ point_real_negative: u32,
    _ point_real: [u32; 4],
    _ point_imaginary_negative: u32,
    _ point_imaginary: [u32; 4],
    _ current_real_negative: u32,
    _ current_real: [u32; 4],
    _ current_imaginary_negative: u32,
    _ current_imaginary: [u32; 4],
) -> (ComplexFixed<4>, ComplexFixed<4>, TransitionWitness4) {
    let point = complex4(
        point_real_negative,
        point_real,
        point_imaginary_negative,
        point_imaginary,
    )
    let current = complex4(
        current_real_negative,
        current_real,
        current_imaginary_negative,
        current_imaginary,
    )
    (point, current, derive_fixed_mandelbrot_transition_witness(point, current))
}

pub fn fixed_transition4_sparse_trace_authentication_encoded(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ q0: u32, _ q1: u32, _ q2: u32, _ q3: u32,
) -> BrowserBytes {
    let (point, current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let mut authentication = empty_sparse_trace_authentication<4, 4, 48>()
    if !write_sparse_trace_authentication_power_of_two<4, 4096, 4, 4, 48>(
        point,
        current,
        next,
        witness,
        [q0, q1, q2, q3],
        mut authentication,
    ) {
        return BrowserBytes { ptr: 0, len: 0 }
    }
    let words = canonical_word_stream_count(ref authentication)
    encode_canonical_word_stream(
        ref authentication,
        BrowserWordWriter::allocate(words),
    ).finish()
}

pub fn fixed_transition4_sparse_trace_authentication_verify_at(
    _ ptr: u32,
    _ len: u32,
) -> u32 {
    let mut authentication: SparseTraceAuthentication4 =
        empty_sparse_trace_authentication<4, 4, 48>()
    let reader = authentication.decode_stream(BrowserWordReader::new(
        BrowserBytes { ptr: ptr, len: len },
    ))
    if !reader.complete() { return 0 }
    if verify_sparse_trace_authentication<4, 4096, 4, 48>(ref authentication) {
        1
    } else {
        0
    }
}

pub fn sparse_interaction_challenges4(
    _ valid: u32,
    _ r0: u32, _ r1: u32, _ r2: u32, _ r3: u32,
    _ r4: u32, _ r5: u32, _ r6: u32, _ r7: u32,
) -> [u32; 33] {
    let root = SparseTraceDigest<4> {
        valid: valid == 1,
        value: Poseidon2Digest::from_u32s([r0, r1, r2, r3, r4, r5, r6, r7]),
    }
    let challenges = sparse_interaction_challenges(root)
    let values = [
        challenges.product.beta,
        challenges.product.gamma,
        challenges.round.beta,
        challenges.round.gamma,
        challenges.linear.beta,
        challenges.linear.gamma,
        challenges.boundary.beta,
        challenges.boundary.gamma,
    ]
    let mut words = [0; 33]
    words[0] = if challenges.valid { 1 } else { 0 }
    let mut value: usize = 0
    while value < 8 {
        let coefficients = values[value].to_u32s()
        let mut coefficient: usize = 0
        while coefficient < 4 {
            words[1 + value * 4 + coefficient] = coefficients[coefficient]
            coefficient = coefficient + 1
        }
        value = value + 1
    }
    words
}

pub fn fixed_transition4_sparse_air_checkpoint_encoded(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ a0: u32, _ a1: u32, _ a2: u32, _ a3: u32,
    _ a4: u32, _ a5: u32, _ a6: u32, _ a7: u32,
    _ b0: u32, _ b1: u32, _ b2: u32, _ b3: u32,
    _ b4: u32, _ b5: u32, _ b6: u32, _ b7: u32,
) -> BrowserBytes {
    let (point, current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let base = sparse_trace_root_power_of_two<4, 4096>(
        point, current, next, witness,
    )
    if !base.valid { return BrowserBytes { ptr: 0, len: 0 } }

    let mut base_rows = [zero_sparse_base_air_row(); 4]
    let mut index: usize = 0
    while index < 4 {
        base_rows[index] = sparse_base_air_row_from_witness<4>(
            index.downcast_truncate(), point, current, next, witness,
        )
        index = index + 1
    }
    let mut interaction_rows = [zero_sparse_interaction_trace_row(); 4]
    let mut accumulators = zero_sparse_interaction_accumulators()
    let valid = write_sparse_interaction_air_rows<4, 4>(
        point,
        current,
        next,
        witness,
        base,
        0,
        mut accumulators,
        mut interaction_rows,
    )
    let prefix = SparseAirPrefix4 {
        valid: valid,
        base: base,
        base_rows: base_rows,
        interaction_rows: interaction_rows,
        accumulators: accumulators,
    }
    let interaction = sparse_interaction_trace_root_power_of_two<4, 4096>(
        point, current, next, witness, base,
    )
    let invalid = sparse_interaction_trace_root_power_of_two<4, 4096>(
        point,
        current,
        next,
        witness,
        SparseTraceDigest<4> { valid: false, value: base.value },
    )
    let candidate_a = Poseidon2Digest::from_u32s([
        a0, a1, a2, a3, a4, a5, a6, a7,
    ])
    let candidate_b = Poseidon2Digest::from_u32s([
        b0, b1, b2, b3, b4, b5, b6, b7,
    ])
    let checkpoint = SparseAirCheckpoint4 {
        prefix: prefix,
        interaction: interaction,
        accepts_candidate_a: interaction.value.equals(candidate_a),
        accepts_candidate_b: interaction.value.equals(candidate_b),
        invalid: invalid,
    }
    let words = canonical_word_stream_count(ref checkpoint)
    encode_canonical_word_stream(
        ref checkpoint,
        BrowserWordWriter::allocate(words),
    ).finish()
}
