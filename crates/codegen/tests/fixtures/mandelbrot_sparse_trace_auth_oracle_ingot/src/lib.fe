//! Thin zero-import Wasm boundary for sparse trace authentication.

use canonical_words::{
    BrowserWordReader,
    BrowserWordWriter,
    CanonicalWordStream,
    CanonicalWords,
    CanonicalWordsProvider,
    canonical_word_stream_count,
    encode_canonical_word_array,
    encode_canonical_word_stream,
}
use core::BrowserBytes
use mandelbrot_proof_fixed_air::{
    FixedMandelbrotTransitionWitness,
    derive_fixed_mandelbrot_transition_witness,
    fixed_mandelbrot_transition_output,
}
use mandelbrot_proof_fixed_air_baby_bear::{
    SparseBaseAirRow,
    SparseBaseAirFields,
    SparseBaseAirEvaluationTrace,
    SparseBaseAirLdeCodeword,
    SparseBaseLdeDigest,
    SparseAirEvaluationTrace,
    SparseAirLdeCodeword,
    SparseInteractionAccumulators,
    SparseInteractionAirFields,
    SparseInteractionAirEvaluationTrace,
    SparseInteractionAirLdeCodeword,
    SparseLdeInteractionChallenges,
    SparseInteractionTraceDigest,
    SparseInteractionTraceRow,
    SparseTraceDigest,
    SparseTraceAuthentication,
    SPARSE_BASE_AIR_FIELDS,
    SPARSE_INTERACTION_AIR_FIELDS,
    empty_sparse_trace_authentication,
    evaluate_sparse_composition_opened,
    sparse_base_air_row_from_witness,
    sparse_base_air_fields,
    sparse_base_lde_root_power_of_two,
    sparse_constraint_numerators_opened,
    sparse_interaction_air_fields,
    sparse_interaction_challenges,
    sparse_interaction_lde_root_power_of_two,
    sparse_lde_interaction_challenges,
    sparse_interaction_trace_root_power_of_two,
    sparse_opened_air_row,
    sparse_trace_root_power_of_two,
    verify_sparse_trace_authentication,
    write_sparse_air_evaluation_trace,
    write_sparse_air_lde,
    write_sparse_base_air_evaluation_trace,
    write_sparse_base_air_lde,
    write_sparse_interaction_air_rows,
    write_sparse_interaction_air_evaluation_trace,
    write_sparse_interaction_air_lde,
    write_sparse_lde_interaction_air_rows,
    write_sparse_trace_authentication_power_of_two,
    zero_sparse_base_air_row,
    zero_sparse_interaction_accumulators,
    zero_sparse_interaction_trace_row,
}
use mandelbrot_proof_recursive::ComplexFixed
use poseidon_baby_bear::Poseidon2Digest
use precision::baby_bear::{BabyBear, BabyBearExt4}
use precision::fixed::Fixed

type TransitionWitness4 = FixedMandelbrotTransitionWitness<4>
type SparseTraceAuthentication4 = SparseTraceAuthentication<4, 4, 48>

struct SparseAirPrefix4 {
    pub valid: bool,
    pub base: SparseTraceDigest<4>,
    pub base_rows: [SparseBaseAirRow<BabyBear>; 4],
    pub interaction_rows: [SparseInteractionTraceRow<BabyBearExt4>; 4],
    pub accumulators: SparseInteractionAccumulators,
}
impl core::marker::Copy for SparseAirPrefix4 {}
derive CanonicalWords for SparseAirPrefix4 using CanonicalWordsProvider

struct SparseAirCheckpoint4 {
    pub prefix: SparseAirPrefix4,
    pub base_fields: SparseBaseAirFields,
    pub interaction_fields: SparseInteractionAirFields,
    pub interaction: SparseInteractionTraceDigest<4>,
    pub accepts_candidate_a: bool,
    pub accepts_candidate_b: bool,
    pub invalid: SparseInteractionTraceDigest<4>,
}
impl core::marker::Copy for SparseAirCheckpoint4 {}
derive CanonicalWords for SparseAirCheckpoint4 using CanonicalWordsProvider

struct RejectedCosetShift {
    pub shift: BabyBear,
    pub accepted: bool,
}
impl core::marker::Copy for RejectedCosetShift {}
derive CanonicalWords for RejectedCosetShift using CanonicalWordsProvider

fn fixed4(_ negative: u32, _ limbs: [u32; 4]) -> Fixed<4> {
    Fixed { negative: negative == 1, limbs: limbs }
}

fn complex4(
    _ real_negative: u32,
    _ real: [u32; 4],
    _ imaginary_negative: u32,
    _ imaginary: [u32; 4],
) -> ComplexFixed<4> {
    ComplexFixed {
        real: fixed4(real_negative, real),
        imaginary: fixed4(imaginary_negative, imaginary),
    }
}

fn transition4(
    _ point_real_negative: u32,
    _ point_real: [u32; 4],
    _ point_imaginary_negative: u32,
    _ point_imaginary: [u32; 4],
    _ current_real_negative: u32,
    _ current_real: [u32; 4],
    _ current_imaginary_negative: u32,
    _ current_imaginary: [u32; 4],
) -> (ComplexFixed<4>, ComplexFixed<4>, TransitionWitness4) {
    let point = complex4(
        point_real_negative,
        point_real,
        point_imaginary_negative,
        point_imaginary,
    )
    let current = complex4(
        current_real_negative,
        current_real,
        current_imaginary_negative,
        current_imaginary,
    )
    (point, current, derive_fixed_mandelbrot_transition_witness(point, current))
}

pub fn fixed_transition4_sparse_trace_authentication_encoded(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ q0: u32, _ q1: u32, _ q2: u32, _ q3: u32,
) -> BrowserBytes {
    let (point, current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let mut authentication = empty_sparse_trace_authentication<4, 4, 48>()
    if !write_sparse_trace_authentication_power_of_two<4, 4096, 4, 4, 48>(
        point,
        current,
        next,
        witness,
        [q0, q1, q2, q3],
        mut authentication,
    ) {
        return BrowserBytes { ptr: 0, len: 0 }
    }
    let words = canonical_word_stream_count(ref authentication)
    encode_canonical_word_stream(
        ref authentication,
        BrowserWordWriter::allocate(words),
    ).finish()
}

pub fn fixed_transition4_sparse_trace_authentication_verify_at(
    _ ptr: u32,
    _ len: u32,
) -> u32 {
    let mut authentication: SparseTraceAuthentication4 =
        empty_sparse_trace_authentication<4, 4, 48>()
    let reader = authentication.decode_stream(BrowserWordReader::new(
        BrowserBytes { ptr: ptr, len: len },
    ))
    if !reader.complete() { return 0 }
    if verify_sparse_trace_authentication<4, 4096, 4, 48>(ref authentication) {
        1
    } else {
        0
    }
}

pub fn sparse_interaction_challenges4(
    _ valid: u32,
    _ r0: u32, _ r1: u32, _ r2: u32, _ r3: u32,
    _ r4: u32, _ r5: u32, _ r6: u32, _ r7: u32,
) -> [u32; 33] {
    let root = SparseTraceDigest<4> {
        valid: valid == 1,
        value: Poseidon2Digest::from_u32s([r0, r1, r2, r3, r4, r5, r6, r7]),
    }
    interaction_challenge_words(sparse_interaction_challenges(root))
}

fn interaction_challenge_words(
    _ challenges: mandelbrot_proof_fixed_air_baby_bear::SparseInteractionChallenges,
) -> [u32; 33] {
    let values = [
        challenges.product.beta,
        challenges.product.gamma,
        challenges.round.beta,
        challenges.round.gamma,
        challenges.linear.beta,
        challenges.linear.gamma,
        challenges.boundary.beta,
        challenges.boundary.gamma,
    ]
    let mut words = [0; 33]
    words[0] = if challenges.valid { 1 } else { 0 }
    let mut value: usize = 0
    while value < 8 {
        let coefficients = values[value].to_u32s()
        let mut coefficient: usize = 0
        while coefficient < 4 {
            words[1 + value * 4 + coefficient] = coefficients[coefficient]
            coefficient = coefficient + 1
        }
        value = value + 1
    }
    words
}

pub fn sparse_lde_interaction_challenges4(
    _ valid: u32,
    _ r0: u32, _ r1: u32, _ r2: u32, _ r3: u32,
    _ r4: u32, _ r5: u32, _ r6: u32, _ r7: u32,
) -> [u32; 33] {
    let root: SparseBaseLdeDigest<4, 4, 16> = SparseBaseLdeDigest {
        valid: valid == 1,
        value: Poseidon2Digest::from_u32s([
            r0, r1, r2, r3, r4, r5, r6, r7,
        ]),
    }
    let challenges = sparse_lde_interaction_challenges(root)
    let encoded = encode_canonical_word_array<
        SparseLdeInteractionChallenges<4, 4, 16>,
        33,
    >(ref challenges)
    if encoded.valid { encoded.words } else { [0; 33] }
}

fn write_sparse_air_rows4(
    _ point: ComplexFixed<4>,
    _ current: ComplexFixed<4>,
    _ next: ComplexFixed<4>,
    _ witness: TransitionWitness4,
    _ base: SparseTraceDigest<4>,
    _ base_rows: mut [SparseBaseAirRow<BabyBear>; 4],
    _ interaction_rows: mut [SparseInteractionTraceRow<BabyBearExt4>; 4],
    _ accumulators: mut SparseInteractionAccumulators,
) -> bool {
    let mut index: usize = 0
    while index < 4 {
        base_rows[index] = sparse_base_air_row_from_witness<4>(
            index.downcast_truncate(), point, current, next, witness,
        )
        index = index + 1
    }
    write_sparse_interaction_air_rows<4, 4>(
        point,
        current,
        next,
        witness,
        base,
        0,
        mut accumulators,
        mut interaction_rows,
    )
}

fn write_sparse_air_evaluation_trace4(
    _ point: ComplexFixed<4>,
    _ current: ComplexFixed<4>,
    _ next: ComplexFixed<4>,
    _ witness: TransitionWitness4,
    _ base: SparseTraceDigest<4>,
    _ evaluations: mut SparseAirEvaluationTrace<4>,
) -> bool {
    let mut base_rows = [zero_sparse_base_air_row(); 4]
    let mut interaction_rows = [zero_sparse_interaction_trace_row(); 4]
    let mut accumulators = zero_sparse_interaction_accumulators()
    write_sparse_air_rows4(
        point,
        current,
        next,
        witness,
        base,
        mut base_rows,
        mut interaction_rows,
        mut accumulators,
    ) && write_sparse_air_evaluation_trace<4>(
        ref base_rows,
        ref interaction_rows,
        mut evaluations,
    )
}

pub fn fixed_transition4_sparse_air_lde_encoded(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
) -> BrowserBytes {
    let (point, current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let base = sparse_trace_root_power_of_two<4, 4096>(
        point, current, next, witness,
    )
    if !base.valid { return BrowserBytes { ptr: 0, len: 0 } }

    let mut evaluations: SparseAirEvaluationTrace<4> = SparseAirEvaluationTrace {
        valid: false,
        base: [[BabyBear::zero(); SPARSE_BASE_AIR_FIELDS]; 4],
        interaction: [[BabyBear::zero(); SPARSE_INTERACTION_AIR_FIELDS]; 4],
    }
    let evaluations_valid = write_sparse_air_evaluation_trace4(
        point,
        current,
        next,
        witness,
        base,
        mut evaluations,
    )
    let mut lde: SparseAirLdeCodeword<16> = SparseAirLdeCodeword {
        valid: false,
        base: [[BabyBear::zero(); SPARSE_BASE_AIR_FIELDS]; 16],
        interaction: [[BabyBear::zero(); SPARSE_INTERACTION_AIR_FIELDS]; 16],
    }
    // Exercise rejection before the successful placement so the large
    // codeword never needs a second snapshot merely for this negative gate.
    // The successful writer overwrites every field before setting `valid`.
    let accepts_invalid_shift = write_sparse_air_lde<4, 16>(
        ref evaluations,
        BabyBear::one(),
        mut lde,
    )
    if evaluations_valid {
        write_sparse_air_lde<4, 16>(
            ref evaluations,
            BabyBear::from_u32(7),
            mut lde,
        )
    }
    let rejection = RejectedCosetShift {
        shift: BabyBear::one(),
        accepted: accepts_invalid_shift,
    }
    let words = canonical_word_stream_count(ref lde)
        + canonical_word_stream_count(ref rejection)
    let writer = encode_canonical_word_stream(
        ref lde,
        BrowserWordWriter::allocate(words),
    )
    encode_canonical_word_stream(ref rejection, writer).finish()
}

fn write_sparse_base_lde4(
    _ point: ComplexFixed<4>,
    _ current: ComplexFixed<4>,
    _ next: ComplexFixed<4>,
    _ witness: TransitionWitness4,
    _ output: mut SparseBaseAirLdeCodeword<16>,
) -> bool {
    let mut rows = [zero_sparse_base_air_row(); 4]
    let mut index: usize = 0
    while index < 4 {
        rows[index] = sparse_base_air_row_from_witness<4>(
            index.downcast_truncate(), point, current, next, witness,
        )
        index = index + 1
    }
    let mut evaluations: SparseBaseAirEvaluationTrace<4> =
        SparseBaseAirEvaluationTrace {
            valid: false,
            values: [[BabyBear::zero(); SPARSE_BASE_AIR_FIELDS]; 4],
        }
    write_sparse_base_air_evaluation_trace<4>(ref rows, mut evaluations)
        && write_sparse_base_air_lde<4, 16>(
            ref evaluations,
            BabyBear::from_u32(7),
            mut output,
        )
}

/// Commit the independently placeable base LDE before constructing any
/// interaction witness. A directed field mutation provides a root-level
/// binding gate without involving the later interaction codeword.
pub fn fixed_transition4_sparse_base_lde_root(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ mutation: u32,
) -> [u32; 9] {
    if mutation > 1 { return [0; 9] }
    let (point, current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let mut lde: SparseBaseAirLdeCodeword<16> = SparseBaseAirLdeCodeword {
        valid: false,
        values: [[BabyBear::zero(); SPARSE_BASE_AIR_FIELDS]; 16],
    }
    if !write_sparse_base_lde4(point, current, next, witness, mut lde) {
        return [0; 9]
    }
    if mutation == 1 {
        lde.values[0][35] = lde.values[0][35] + BabyBear::one()
    }
    let root = sparse_base_lde_root_power_of_two<4, 4, 16>(ref lde)
    let mut output = [0; 9]
    output[0] = if root.valid { 1 } else { 0 }
    let mut index: usize = 0
    while index < 8 {
        output[1 + index] = root.value.field(index.downcast_truncate()).to_u32()
        index = index + 1
    }
    output
}

/// Generate the interaction prefix only after the base LDE root has fixed its
/// branded quartic challenges, then commit the independently extended rows.
pub fn fixed_transition4_sparse_interaction_lde_root(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ mutation: u32,
) -> [u32; 17] {
    if mutation > 1 { return [0; 17] }
    let (point, current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let mut base_lde: SparseBaseAirLdeCodeword<16> = SparseBaseAirLdeCodeword {
        valid: false,
        values: [[BabyBear::zero(); SPARSE_BASE_AIR_FIELDS]; 16],
    }
    if !write_sparse_base_lde4(
        point, current, next, witness, mut base_lde,
    ) {
        return [0; 17]
    }
    let base = sparse_base_lde_root_power_of_two<4, 4, 16>(ref base_lde)
    let challenges = sparse_lde_interaction_challenges(base)
    let mut rows = [zero_sparse_interaction_trace_row(); 4]
    let mut accumulators = zero_sparse_interaction_accumulators()
    if !write_sparse_lde_interaction_air_rows<4, 4, 16, 4>(
        point,
        current,
        next,
        witness,
        challenges,
        0,
        mut accumulators,
        mut rows,
    ) {
        return [0; 17]
    }
    let mut evaluations: SparseInteractionAirEvaluationTrace<4> =
        SparseInteractionAirEvaluationTrace {
            valid: false,
            values: [[BabyBear::zero(); SPARSE_INTERACTION_AIR_FIELDS]; 4],
        }
    if !write_sparse_interaction_air_evaluation_trace<4>(
        ref rows,
        mut evaluations,
    ) {
        return [0; 17]
    }
    let mut lde: SparseInteractionAirLdeCodeword<16> =
        SparseInteractionAirLdeCodeword {
            valid: false,
            values: [[BabyBear::zero(); SPARSE_INTERACTION_AIR_FIELDS]; 16],
        }
    if !write_sparse_interaction_air_lde<4, 16>(
        ref evaluations,
        BabyBear::from_u32(7),
        mut lde,
    ) {
        return [0; 17]
    }
    if mutation == 1 {
        lde.values[0][0] = lde.values[0][0] + BabyBear::one()
    }
    let interaction = sparse_interaction_lde_root_power_of_two<4, 4, 16>(
        base,
        ref lde,
    )
    let mut output = [0; 17]
    output[0] = if interaction.valid { 1 } else { 0 }
    let mut index: usize = 0
    while index < 8 {
        output[1 + index] = interaction.base.value
            .field(index.downcast_truncate()).to_u32()
        output[9 + index] = interaction.value
            .field(index.downcast_truncate()).to_u32()
        index = index + 1
    }
    output
}

/// Exercise typed LDE-row reconstruction and the complete sparse composition
/// fold. The returned numerators let the Rust gate apply the four zerofiers
/// independently instead of treating a final-byte match as proof.
pub fn fixed_transition4_sparse_air_composition(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ challenge0: u32, _ challenge1: u32,
    _ challenge2: u32, _ challenge3: u32,
    _ evaluation: u32,
    _ mutation: u32,
) -> [u32; 39] {
    if evaluation >= 16 || mutation > 2 { return [0; 39] }
    let (point, current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let base = sparse_trace_root_power_of_two<4, 4096>(
        point, current, next, witness,
    )
    if !base.valid { return [0; 39] }

    let mut evaluations: SparseAirEvaluationTrace<4> = SparseAirEvaluationTrace {
        valid: false,
        base: [[BabyBear::zero(); SPARSE_BASE_AIR_FIELDS]; 4],
        interaction: [[BabyBear::zero(); SPARSE_INTERACTION_AIR_FIELDS]; 4],
    }
    if !write_sparse_air_evaluation_trace4(
        point, current, next, witness, base, mut evaluations,
    ) {
        return [0; 39]
    }
    let mut lde: SparseAirLdeCodeword<16> = SparseAirLdeCodeword {
        valid: false,
        base: [[BabyBear::zero(); SPARSE_BASE_AIR_FIELDS]; 16],
        interaction: [[BabyBear::zero(); SPARSE_INTERACTION_AIR_FIELDS]; 16],
    }
    if !write_sparse_air_lde<4, 16>(
        ref evaluations,
        BabyBear::from_u32(7),
        mut lde,
    ) {
        return [0; 39]
    }

    let index: usize = evaluation as usize
    if mutation == 1 {
        lde.base[index][35] = lde.base[index][35] + BabyBear::one()
    } else if mutation == 2 {
        lde.interaction[index][0] = lde.interaction[index][0] + BabyBear::one()
    }
    let next_index: usize = ((evaluation + 4) & 15) as usize
    let opened = sparse_opened_air_row(
        lde.base[index],
        lde.interaction[index],
    )
    let next_opened = sparse_opened_air_row(
        lde.base[next_index],
        lde.interaction[next_index],
    )
    let challenge = BabyBearExt4::from_u32s([
        challenge0, challenge1, challenge2, challenge3,
    ])
    let interaction_challenges = sparse_interaction_challenges(base)
    let numerators = sparse_constraint_numerators_opened<4>(
        challenge,
        interaction_challenges,
        ref opened,
        ref next_opened,
    )
    let root = BabyBear::two_adic_root(4)
    let evaluation_point = BabyBearExt4::from_base(
        BabyBear::from_u32(7) * root.pow_u32(evaluation),
    )
    let composition = evaluate_sparse_composition_opened<4, 4>(
        evaluation_point,
        challenge,
        interaction_challenges,
        ref opened,
        ref next_opened,
    )

    let values = [
        numerators.all_rows,
        numerators.pair_rows,
        numerators.first_row,
        numerators.last_row,
    ]
    let mut output = [0; 39]
    output[0] = if opened.valid { 1 } else { 0 }
    output[1] = if next_opened.valid { 1 } else { 0 }
    let mut value: usize = 0
    while value < 4 {
        let words = values[value].to_u32s()
        let mut coefficient: usize = 0
        while coefficient < 4 {
            output[2 + value * 4 + coefficient] = words[coefficient]
            coefficient = coefficient + 1
        }
        value = value + 1
    }
    output[18] = if composition.valid { 1 } else { 0 }
    let composition_words = composition.value.to_u32s()
    let opened_value = opened.base.witness.value.to_u32s()
    let opened_product = opened.interaction.product.accumulator.to_u32s()
    let next_value = next_opened.base.witness.value.to_u32s()
    let next_product = next_opened.interaction.product.accumulator.to_u32s()
    let mut coefficient: usize = 0
    while coefficient < 4 {
        output[19 + coefficient] = composition_words[coefficient]
        output[23 + coefficient] = opened_value[coefficient]
        output[27 + coefficient] = opened_product[coefficient]
        output[31 + coefficient] = next_value[coefficient]
        output[35 + coefficient] = next_product[coefficient]
        coefficient = coefficient + 1
    }
    output
}

pub fn fixed_transition4_sparse_air_checkpoint_encoded(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ a0: u32, _ a1: u32, _ a2: u32, _ a3: u32,
    _ a4: u32, _ a5: u32, _ a6: u32, _ a7: u32,
    _ b0: u32, _ b1: u32, _ b2: u32, _ b3: u32,
    _ b4: u32, _ b5: u32, _ b6: u32, _ b7: u32,
) -> BrowserBytes {
    let (point, current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let base = sparse_trace_root_power_of_two<4, 4096>(
        point, current, next, witness,
    )
    if !base.valid { return BrowserBytes { ptr: 0, len: 0 } }

    let mut base_rows = [zero_sparse_base_air_row(); 4]
    let mut interaction_rows = [zero_sparse_interaction_trace_row(); 4]
    let mut accumulators = zero_sparse_interaction_accumulators()
    let valid = write_sparse_air_rows4(
        point,
        current,
        next,
        witness,
        base,
        mut base_rows,
        mut interaction_rows,
        mut accumulators,
    )
    let prefix = SparseAirPrefix4 {
        valid: valid,
        base: base,
        base_rows: base_rows,
        interaction_rows: interaction_rows,
        accumulators: accumulators,
    }
    let interaction = sparse_interaction_trace_root_power_of_two<4, 4096>(
        point, current, next, witness, base,
    )
    let invalid = sparse_interaction_trace_root_power_of_two<4, 4096>(
        point,
        current,
        next,
        witness,
        SparseTraceDigest<4> { valid: false, value: base.value },
    )
    let candidate_a = Poseidon2Digest::from_u32s([
        a0, a1, a2, a3, a4, a5, a6, a7,
    ])
    let candidate_b = Poseidon2Digest::from_u32s([
        b0, b1, b2, b3, b4, b5, b6, b7,
    ])
    let checkpoint = SparseAirCheckpoint4 {
        prefix: prefix,
        base_fields: sparse_base_air_fields(ref base_rows[0]),
        interaction_fields: sparse_interaction_air_fields(ref interaction_rows[0]),
        interaction: interaction,
        accepts_candidate_a: interaction.value.equals(candidate_a),
        accepts_candidate_b: interaction.value.equals(candidate_b),
        invalid: invalid,
    }
    let words = canonical_word_stream_count(ref checkpoint)
    encode_canonical_word_stream(
        ref checkpoint,
        BrowserWordWriter::allocate(words),
    ).finish()
}
