        consumer = consumer.radix2_add(
            sparse_boundary_copy_consumer<BabyBear, 4>(challenge, task, row),
        )
        index = index + 1
    }
    constraints = constraints + 1
    if source.to_u32() != consumer.to_u32() { failures = failures + 1 }
    (failures, constraints, rows)
}

pub fn fixed_transition4_sparse_arithmetic_audit(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ challenge: u32,
    _ mutation_index: u32,
    _ mutation_lane: u32,
) -> (u32, u32, u32) {
    let (point, current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let challenge = BabyBear::from_u32(challenge)
    let rows = sparse_transition_trace_length<4>()
    let mut failures: u32 = 0
    let mut constraints: u32 = 0
    let mut previous_control = sparse_control_row_at<BabyBear, 4>(0)
    let mut previous = sparse_transition_row_from_witness<BabyBear, 4>(
        0,
        point,
        current,
        next,
        witness,
    )
    let mut index: u32 = 0
    while index < rows {
        let control = sparse_control_row_at<BabyBear, 4>(index)
        let mut row = sparse_transition_row_from_witness<BabyBear, 4>(
            index,
            point,
            current,
            next,
            witness,
        )
        if index == mutation_index {
            row = mutate_sparse_row(row, mutation_lane)
        }
        let local = evaluate_sparse_arithmetic_row<BabyBear, 4>(
            challenge,
            control,
            row,
        )
        constraints = constraints + local.constraints
        if !local.valid || local.folded.to_u32() != 0 {
            failures = failures + 1
        }
        if index == 0 {
            let initial = evaluate_sparse_arithmetic_initial(challenge, row)
            constraints = constraints + initial.constraints
            if !initial.valid || initial.folded.to_u32() != 0 {
                failures = failures + 1
            }
        } else {
            let link = evaluate_sparse_arithmetic_link(
                challenge,
                previous_control,
                previous,
                control,
                row,
            )
            constraints = constraints + link.constraints
            if !link.valid || link.folded.to_u32() != 0 {
                failures = failures + 1
            }
        }
        previous_control = control
        previous = row
        index = index + 1
    }
    (failures, constraints, rows)
}

fn mutate_product_interaction(
    _ interaction: mut SparseProductInteractionRow<BabyBear>,
    _ mutation: u32,
    _ index: u32,
    _ product_offset: u32,
) {
    let one = BabyBear::one()
    if mutation == 3 && index == 127 {
        interaction.inverses[0] = interaction.inverses[0] + one
    }
    if mutation == 4 && index == product_offset {
        interaction.inverses[1] = interaction.inverses[1] + one
    }
    if mutation == 5 && index == 251 {
        interaction.accumulator = interaction.accumulator + one
    }
}

/// Complete base-field product interaction audit. The production transcript
/// uses the same generic relation over the quartic extension; this base-field
/// entry keeps the exhaustive 4,096-row mutation gate inexpensive.
pub fn fixed_transition4_sparse_product_interaction_audit(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ beta: u32,
    _ gamma: u32,
    _ fold_challenge: u32,
    _ receipt_challenge: u32,
    _ mutation: u32,
) -> (u32, u32, u32, u32) {
    let (point, current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let challenges = SparseCopyChallenges {
        beta: BabyBear::from_u32(beta),
        gamma: BabyBear::from_u32(gamma),
    }
    let fold_challenge = BabyBear::from_u32(fold_challenge)
    let receipt_challenge = BabyBear::from_u32(receipt_challenge)
    let rows = sparse_transition_trace_length<4>()
    let product_offset = sparse_radix_task_count<4>() + sparse_carry_task_count<4>()
    let mut failures: u32 = 0
    let mut constraints: u32 = 0
    let mut accumulator = BabyBear::zero()
    let mut receipt = BabyBear::zero()
    let mut receipt_power = BabyBear::one()
    let mut previous_control = sparse_control_row_at<BabyBear, 4>(0)
    let mut previous_row = sparse_transition_row_from_witness<BabyBear, 4>(
        0, point, current, next, witness,
    )
    let mut previous_interaction = sparse_product_interaction_row<BabyBear, 4>(
        challenges,
        previous_control,
        previous_row,
        accumulator,
    )
    let mut index: u32 = 0
    while index < rows {
        let control = sparse_control_row_at<BabyBear, 4>(index)
        let mut row = sparse_transition_row_from_witness<BabyBear, 4>(
            index, point, current, next, witness,
        )
        if mutation == 1 && index == 127 {
            row.value = row.value + BabyBear::one()
        }
        if mutation == 2 && index == product_offset {
            row.auxiliary = row.auxiliary + BabyBear::one()
        }
        if mutation == 6 && index == product_offset {
            row.auxiliary = row.auxiliary + BabyBear::one()
            row.accumulator_after = row.accumulator_after + row.value
        }
        if mutation == 6 && index == product_offset + 1 {
            let first = sparse_transition_row_from_witness<BabyBear, 4>(
                product_offset,
                point,
                current,
                next,
                witness,
            )
            row.accumulator_before = row.accumulator_before + first.value
            row.value = row.value + first.value
        }
        let mut interaction = sparse_product_interaction_row<BabyBear, 4>(
            challenges,
            control,
            row,
            accumulator,
        )
        mutate_product_interaction(mut interaction, mutation, index, product_offset)
        let local = evaluate_sparse_product_interaction_row<BabyBear, 4>(
            fold_challenge,
            challenges,
            control,
            row,
            interaction,
        )
        constraints = constraints + local.constraints
        if !local.valid || local.folded.to_u32() != 0 {
            failures = failures + 1
        }
        if index == 0 {
            let initial = evaluate_sparse_product_interaction_initial(
                fold_challenge,
                interaction,
            )
            constraints = constraints + initial.constraints
            if !initial.valid || initial.folded.to_u32() != 0 {
                failures = failures + 1
            }
        } else {
            let link = evaluate_sparse_product_interaction_link<BabyBear, 4>(
                fold_challenge,
                previous_control,
                previous_row,
                previous_interaction,
                interaction,
            )
            constraints = constraints + link.constraints
            if !link.valid || link.folded.to_u32() != 0 {
                failures = failures + 1
            }
        }
        receipt = receipt + receipt_power * interaction.accumulator
        receipt_power = receipt_power * receipt_challenge
        receipt = receipt + receipt_power * interaction.inverses[0]
        receipt_power = receipt_power * receipt_challenge
        receipt = receipt + receipt_power * interaction.inverses[1]
        receipt_power = receipt_power * receipt_challenge
        accumulator = interaction.accumulator + local.delta
        previous_control = control
        previous_row = row
        previous_interaction = interaction
        index = index + 1
    }
    let terminal = evaluate_sparse_product_interaction_terminal<BabyBear, 4>(
        fold_challenge,
        previous_control,
        previous_row,
        previous_interaction,
    )
    constraints = constraints + terminal.constraints
    if !terminal.valid || terminal.folded.to_u32() != 0 {
        failures = failures + 1
    }
    (failures, constraints, rows, receipt.to_u32())
}

pub fn fixed_transition4_encoded(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
) -> BrowserBytes {
    let (_point, _current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let writer = BrowserWordWriter::allocate(<TransitionWitness4 as CanonicalWords>::WORDS)
    encode_canonical_words(ref witness, writer).finish()
}

pub fn fixed_transition4_mutation_holds(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ mutation: u32,
) -> u32 {
    let (point, mut current, mut witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let mut next = fixed_mandelbrot_transition_output(witness)
    if mutation == 1 { witness.xx.low_digits[0] = witness.xx.low_digits[0] + 1 }
    if mutation == 2 { witness.yy.low_digits[0] = witness.yy.low_digits[0] + 1 }
    if mutation == 3 { witness.xy.low_digits[0] = witness.xy.low_digits[0] + 1 }
    if mutation == 4 {
        witness.real_difference.left_difference_digits[0] =
            witness.real_difference.left_difference_digits[0] + 1
    }
    if mutation == 5 { witness.next_real.sum_digits[0] = witness.next_real.sum_digits[0] + 1 }
    if mutation == 6 { witness.double_xy.sum_digits[0] = witness.double_xy.sum_digits[0] + 1 }
    if mutation == 7 {
        witness.next_imaginary.sum_digits[0] = witness.next_imaginary.sum_digits[0] + 1
    }
    if mutation == 8 { current.real.limbs[0] = LIMB_BASE }
    if mutation == 9 { next.real.limbs[0] = next.real.limbs[0] + 1 }
    if mutation == 10 { next.imaginary.negative = !next.imaginary.negative }
    if fixed_mandelbrot_transition_witness_holds(point, current, next, witness) {
        1
    } else {
        0
    }
}

pub fn fixed_transition4_mutated_output_residual(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ mutation: u32,
) -> u32 {
    let (_point, _current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let mut next = fixed_mandelbrot_transition_output(witness)
    if mutation == 1 {
        next.real.limbs[0] = next.real.limbs[0] + 1
        return transition_output_limb_residual<BabyBear, 4>(
            witness,
            next,
            0,
            0,
        ).to_u32()
    }
    next.imaginary.negative = !next.imaginary.negative
    transition_output_sign_residual<BabyBear, 4>(witness, next, 1).to_u32()
}

pub fn fixed_transition4_constraint_fold(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ challenge: u32,
    _ mutation: u32,
) -> (u32, u32, u32) {
    let (mut point, current, mut witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let next = fixed_mandelbrot_transition_output(witness)
    if mutation == 1 { witness.xx.low_digits[0] = witness.xx.low_digits[0] + 1 }
    if mutation == 2 { witness.xx.low_carries[0] = witness.xx.low_carries[0] + 1 }
    if mutation == 3 { witness.xx.round_carries[0] = 1 - witness.xx.round_carries[0] }
    if mutation == 4 {
        witness.real_difference.left_borrows[0] =
            1 - witness.real_difference.left_borrows[0]
    }
    let mut proposed_next = next
    if mutation == 5 { proposed_next.real.limbs[0] = proposed_next.real.limbs[0] + 1 }
    if mutation == 6 { point.real.limbs[0] = point.real.limbs[0] + LIMB_BASE }
    let modulus = if mutation == 7 { 1 } else { BABY_BEAR_MODULUS }
    let evaluated = evaluate_transition_witness_constraints<BabyBear, 4>(
        BabyBear::from_u32(challenge),
        modulus,
        point,
        current,
        proposed_next,
        witness,
    )
    (
        if evaluated.valid { 1 } else { 0 },
        evaluated.constraints,
        evaluated.folded.to_u32(),
    )
}

pub fn fixed_linear4_encoded(
    _ left_negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ right_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ subtract_right: u32,
) -> BrowserBytes {
    let (_left, _right, witness) = linear4(
        left_negative,
        [l0, l1, l2, l3],
        right_negative,
        [r0, r1, r2, r3],
        subtract_right,
    )
    let writer = BrowserWordWriter::allocate(<LinearWitness4 as CanonicalWords>::WORDS)
    encode_canonical_words(ref witness, writer).finish()
}

pub fn fixed_linear4_mutation_holds(
    _ left_negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ right_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ subtract_right: u32,
    _ mutation: u32,
) -> u32 {
    let (mut left, right, mut witness) = linear4(
        left_negative,
        [l0, l1, l2, l3],
        right_negative,
        [r0, r1, r2, r3],
        subtract_right,
    )
    if mutation == 1 { witness.sum_digits[0] = witness.sum_digits[0] + 1 }
    if mutation == 2 { witness.sum_carries[0] = 1 - witness.sum_carries[0] }
    if mutation == 3 {
        witness.left_difference_digits[0] = witness.left_difference_digits[0] + 1
    }
    if mutation == 4 { witness.left_borrows[0] = 1 - witness.left_borrows[0] }
    if mutation == 5 {
        witness.right_difference_digits[0] = witness.right_difference_digits[0] + 1
    }
    if mutation == 6 { witness.right_borrows[0] = 1 - witness.right_borrows[0] }
    if mutation == 7 { witness.same_sign = !witness.same_sign }
    if mutation == 8 { witness.select_right = !witness.select_right }
    if mutation == 9 { witness.output_nonzero = !witness.output_nonzero }
    if mutation == 10 { witness.output.limbs[0] = witness.output.limbs[0] + 1 }
    if mutation == 11 { witness.output.negative = !witness.output.negative }
    if mutation == 12 { left.limbs[0] = 8192 }
    if fixed_linear_witness_holds(
        left,
        right,
        subtract_right == 1,
        witness,
    ) { 1 } else { 0 }
}

pub fn fixed_linear4_residual(
    _ left_negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ right_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ subtract_right: u32,
    _ relation: u32,
    _ index: u32,
) -> u32 {
    let (left, right, witness) = linear4(
        left_negative,
        [l0, l1, l2, l3],
        right_negative,
        [r0, r1, r2, r3],
        subtract_right,
    )
    if relation == 0 {
        return linear_addition_residual<BabyBear, 4>(left, right, witness, index).to_u32()
    }
    if relation == 1 {
        return linear_left_difference_residual<BabyBear, 4>(left, right, witness, index).to_u32()
    }
    if relation == 2 {
        return linear_right_difference_residual<BabyBear, 4>(left, right, witness, index).to_u32()
    }
    if relation == 3 {
        return linear_output_selection_residual<BabyBear, 4>(witness, index).to_u32()
    }
    if relation == 4 {
        return linear_same_sign_residual<BabyBear, 4>(
            left,
            right,
            subtract_right == 1,
            witness,
        ).to_u32()
    }
    if relation == 5 {
        return linear_comparison_residual<BabyBear, 4>(witness).to_u32()
    }
    if relation == 6 {
        return linear_output_sign_residual<BabyBear, 4>(
            left,
            right,
            subtract_right == 1,
            witness,
        ).to_u32()
    }
    if relation == 7 {
        return boolean_residual<BabyBear>(if witness.same_sign { 1 } else { 0 }).to_u32()
    }
    if relation == 8 {
        return boolean_residual<BabyBear>(if witness.select_right { 1 } else { 0 }).to_u32()
    }
    if relation == 9 {
        return boolean_residual<BabyBear>(if witness.output_nonzero { 1 } else { 0 }).to_u32()
    }
    if relation == 10 {
        return boolean_residual<BabyBear>(witness.sum_carries[index as usize]).to_u32()
    }
    if relation == 11 {
        return boolean_residual<BabyBear>(witness.left_borrows[index as usize]).to_u32()
    }
    if relation == 12 {
        return boolean_residual<BabyBear>(witness.right_borrows[index as usize]).to_u32()
    }
    let range = derive_radix_range_witness(witness.output.limbs)
    linear_output_nonzero_residual<BabyBear, 4>(witness, range).to_u32()
}

pub fn fixed_linear4_mutated_residual(
    _ left_negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ right_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ subtract_right: u32,
    _ mutation: u32,
) -> u32 {
    let (left, right, mut witness) = linear4(
        left_negative,
        [l0, l1, l2, l3],
        right_negative,
        [r0, r1, r2, r3],
        subtract_right,
    )
    if mutation == 1 {
        witness.sum_digits[0] = witness.sum_digits[0] + 1
        return linear_addition_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 2 {
        witness.sum_carries[0] = 1 - witness.sum_carries[0]
        return linear_addition_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 3 {
        witness.left_difference_digits[0] = witness.left_difference_digits[0] + 1
        return linear_left_difference_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 4 {
        witness.left_borrows[0] = 1 - witness.left_borrows[0]
        return linear_left_difference_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 5 {
        witness.right_difference_digits[0] = witness.right_difference_digits[0] + 1
        return linear_right_difference_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 6 {
        witness.right_borrows[0] = 1 - witness.right_borrows[0]
        return linear_right_difference_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 7 {
        witness.same_sign = !witness.same_sign
        return linear_same_sign_residual<BabyBear, 4>(
            left,
            right,
            subtract_right == 1,
            witness,
        ).to_u32()
    }
    if mutation == 8 {
        witness.select_right = !witness.select_right
        return linear_comparison_residual<BabyBear, 4>(witness).to_u32()
    }
    if mutation == 10 {
        witness.output.limbs[0] = witness.output.limbs[0] + 1
        return linear_output_selection_residual<BabyBear, 4>(witness, 0).to_u32()
    }
    witness.output.negative = !witness.output.negative
    linear_output_sign_residual<BabyBear, 4>(
        left,
        right,
        subtract_right == 1,
        witness,
    ).to_u32()
}

pub fn fixed_range4_encoded(
    _ negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
) -> BrowserBytes {
    let value = fixed4(negative, [l0, l1, l2, l3])
    let witness = derive_radix_range_witness(value.limbs)
    let writer = BrowserWordWriter::allocate(<RangeWitness4 as CanonicalWords>::WORDS)
    encode_canonical_words(ref witness, writer).finish()
}

pub fn fixed_range4_mutation_holds(
    _ negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ mutation: u32,
) -> u32 {
    let mut value = fixed4(negative, [l0, l1, l2, l3])
    let mut witness = derive_radix_range_witness(value.limbs)
    if mutation == 1 { witness.limbs[0].bits[0] = 1 - witness.limbs[0].bits[0] }
    if mutation == 2 {
        witness.limbs[0].nonzero_prefix[0] = 1 - witness.limbs[0].nonzero_prefix[0]
    }
    if mutation == 3 { witness.nonzero = !witness.nonzero }
    if mutation == 4 { value.limbs[0] = value.limbs[0] + LIMB_BASE }
    if mutation == 5 {
        value = fixed4(1, [0; 4])
        witness = derive_radix_range_witness(value.limbs)
    }
    if fixed_range_witness_holds(value, witness) { 1 } else { 0 }
}

pub fn fixed_range4_residual(
    _ negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ relation: u32,
    _ limb_index: u32,
    _ bit_index: u32,
) -> u32 {
    let value = fixed4(negative, [l0, l1, l2, l3])
    let witness = derive_radix_range_witness(value.limbs)
    if relation == 0 {
        return radix_bit_boolean_residual<BabyBear, 4>(
            witness,
            limb_index,
            bit_index,
        ).to_u32()
    }
    if relation == 1 {
        return radix_prefix_boolean_residual<BabyBear, 4>(
            witness,
            limb_index,
            bit_index,
        ).to_u32()
    }
    if relation == 2 {
        return radix_limb_reconstruction_residual<BabyBear, 4>(
            value.limbs,
            witness,
            limb_index,
        ).to_u32()
    }
    if relation == 3 {
        return radix_prefix_residual<BabyBear, 4>(
            witness,
            limb_index,
            bit_index,
        ).to_u32()
    }
    if relation == 4 {
        return radix_nonzero_residual<BabyBear, 4>(witness).to_u32()
    }
    if relation == 5 {
        return fixed_sign_zero_residual<BabyBear, 4>(value, witness).to_u32()
    }
    boolean_residual<BabyBear>(if witness.nonzero { 1 } else { 0 }).to_u32()
}

pub fn fixed_range4_mutated_residual(
    _ negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ mutation: u32,
) -> u32 {
    let mut value = fixed4(negative, [l0, l1, l2, l3])
    let mut witness = derive_radix_range_witness(value.limbs)
    if mutation == 1 {
        witness.limbs[0].bits[0] = 1 - witness.limbs[0].bits[0]
        return radix_limb_reconstruction_residual<BabyBear, 4>(
            value.limbs,
            witness,
            0,
        ).to_u32()
    }
    if mutation == 2 {
        witness.limbs[0].nonzero_prefix[0] = 1 - witness.limbs[0].nonzero_prefix[0]
        return radix_prefix_residual<BabyBear, 4>(witness, 0, 0).to_u32()
    }
    if mutation == 3 {
        witness.nonzero = !witness.nonzero
        return radix_nonzero_residual<BabyBear, 4>(witness).to_u32()
    }
    if mutation == 4 {
        value.limbs[0] = value.limbs[0] + LIMB_BASE
        return radix_limb_reconstruction_residual<BabyBear, 4>(
            value.limbs,
            witness,
            0,
        ).to_u32()
    }
    value = fixed4(1, [0; 4])
    witness = derive_radix_range_witness(value.limbs)
    fixed_sign_zero_residual<BabyBear, 4>(value, witness).to_u32()
}

