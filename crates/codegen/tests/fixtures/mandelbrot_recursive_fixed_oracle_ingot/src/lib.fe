//! Thin zero-import Wasm boundary for the recursive fixed-point oracle.

use canonical_words::{
    BrowserWordReader,
    BrowserWordWriter,
    CanonicalWords,
    encode_canonical_words,
}
use core::BrowserBytes
use mandelbrot_proof_recursive_baby_bear::{
    RecursiveCommittedInterval,
    commit_recursive_semantic_leaf,
    merge_recursive_committed_intervals,
}
use mandelbrot_proof_fixed_air::{
    FixedLinearWitness,
    FixedProductWitness,
    RadixRangeWitness,
    boolean_residual,
    convolution_left_index,
    convolution_residual,
    convolution_right_index,
    convolution_term_count,
    derive_fixed_product_witness,
    derive_fixed_difference_witness,
    derive_fixed_sum_witness,
    derive_radix_range_witness,
    fixed_linear_witness_holds,
    fixed_product_witness_holds,
    fixed_range_witness_holds,
    fixed_sign_zero_residual,
    linear_addition_residual,
    linear_comparison_residual,
    linear_left_difference_residual,
    linear_output_selection_residual,
    linear_output_sign_residual,
    linear_output_nonzero_residual,
    linear_right_difference_residual,
    linear_same_sign_residual,
    max_convolution_limbs_below,
    radix_bit_boolean_residual,
    radix_limb_reconstruction_residual,
    radix_nonzero_residual,
    radix_prefix_boolean_residual,
    radix_prefix_residual,
    rounding_residual,
}
use mandelbrot_proof_recursive::{
    ComplexFixed,
    HighPrecisionEscapeClaim,
    OrbitInterval,
    RecursiveOrbitAccumulator,
    certify_leaf,
    evaluate_chunk,
    initial_boundary,
    merge_adjacent,
}
use precision::baby_bear::{BabyBear, BABY_BEAR_MODULUS}
use precision::field::LIMB_BASE
use precision::fixed::Fixed

type Accumulator4 = RecursiveOrbitAccumulator<4>
type CommittedAccumulator4 = RecursiveCommittedInterval<4>
type ProductWitness4 = FixedProductWitness<4>
type LinearWitness4 = FixedLinearWitness<4>
type RangeWitness4 = RadixRangeWitness<4>

fn fixed4(_ negative: u32, _ limbs: [u32; 4]) -> Fixed<4> {
    Fixed { negative: negative == 1, limbs: limbs }
}

fn claim4(
    _ real_negative: u32,
    _ real: [u32; 4],
    _ imaginary_negative: u32,
    _ imaginary: [u32; 4],
    _ bound: u32,
) -> HighPrecisionEscapeClaim<4> {
    HighPrecisionEscapeClaim {
        point: ComplexFixed {
            real: fixed4(real_negative, real),
            imaginary: fixed4(imaginary_negative, imaginary),
        },
        bound: bound,
    }
}

fn encode_accumulator4(_ accumulator: Accumulator4) -> BrowserBytes {
    let writer = BrowserWordWriter::allocate(<Accumulator4 as CanonicalWords>::WORDS)
    encode_canonical_words(ref accumulator, writer).finish()
}

fn encode_committed_accumulator4(_ accumulator: CommittedAccumulator4) -> BrowserBytes {
    let writer = BrowserWordWriter::allocate(
        <CommittedAccumulator4 as CanonicalWords>::WORDS,
    )
    encode_canonical_words(ref accumulator, writer).finish()
}

fn product4(
    _ left_negative: u32,
    _ left: [u32; 4],
    _ right_negative: u32,
    _ right: [u32; 4],
) -> (Fixed<4>, Fixed<4>, ProductWitness4) {
    let left = fixed4(left_negative, left)
    let right = fixed4(right_negative, right)
    (left, right, derive_fixed_product_witness(left, right))
}

fn linear4(
    _ left_negative: u32,
    _ left: [u32; 4],
    _ right_negative: u32,
    _ right: [u32; 4],
    _ subtract_right: u32,
) -> (Fixed<4>, Fixed<4>, LinearWitness4) {
    let left = fixed4(left_negative, left)
    let right = fixed4(right_negative, right)
    let witness = if subtract_right == 1 {
        derive_fixed_difference_witness(left, right)
    } else {
        derive_fixed_sum_witness(left, right)
    }
    (left, right, witness)
}

pub fn fixed_linear4_encoded(
    _ left_negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ right_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ subtract_right: u32,
) -> BrowserBytes {
    let (_left, _right, witness) = linear4(
        left_negative,
        [l0, l1, l2, l3],
        right_negative,
        [r0, r1, r2, r3],
        subtract_right,
    )
    let writer = BrowserWordWriter::allocate(<LinearWitness4 as CanonicalWords>::WORDS)
    encode_canonical_words(ref witness, writer).finish()
}

pub fn fixed_linear4_mutation_holds(
    _ left_negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ right_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ subtract_right: u32,
    _ mutation: u32,
) -> u32 {
    let (mut left, right, mut witness) = linear4(
        left_negative,
        [l0, l1, l2, l3],
        right_negative,
        [r0, r1, r2, r3],
        subtract_right,
    )
    if mutation == 1 { witness.sum_digits[0] = witness.sum_digits[0] + 1 }
    if mutation == 2 { witness.sum_carries[0] = 1 - witness.sum_carries[0] }
    if mutation == 3 {
        witness.left_difference_digits[0] = witness.left_difference_digits[0] + 1
    }
    if mutation == 4 { witness.left_borrows[0] = 1 - witness.left_borrows[0] }
    if mutation == 5 {
        witness.right_difference_digits[0] = witness.right_difference_digits[0] + 1
    }
    if mutation == 6 { witness.right_borrows[0] = 1 - witness.right_borrows[0] }
    if mutation == 7 { witness.same_sign = !witness.same_sign }
    if mutation == 8 { witness.select_right = !witness.select_right }
    if mutation == 9 { witness.output_nonzero = !witness.output_nonzero }
    if mutation == 10 { witness.output.limbs[0] = witness.output.limbs[0] + 1 }
    if mutation == 11 { witness.output.negative = !witness.output.negative }
    if mutation == 12 { left.limbs[0] = 8192 }
    if fixed_linear_witness_holds(
        left,
        right,
        subtract_right == 1,
        witness,
    ) { 1 } else { 0 }
}

pub fn fixed_linear4_residual(
    _ left_negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ right_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ subtract_right: u32,
    _ relation: u32,
    _ index: u32,
) -> u32 {
    let (left, right, witness) = linear4(
        left_negative,
        [l0, l1, l2, l3],
        right_negative,
        [r0, r1, r2, r3],
        subtract_right,
    )
    if relation == 0 {
        return linear_addition_residual<BabyBear, 4>(left, right, witness, index).to_u32()
    }
    if relation == 1 {
        return linear_left_difference_residual<BabyBear, 4>(left, right, witness, index).to_u32()
    }
    if relation == 2 {
        return linear_right_difference_residual<BabyBear, 4>(left, right, witness, index).to_u32()
    }
    if relation == 3 {
        return linear_output_selection_residual<BabyBear, 4>(witness, index).to_u32()
    }
    if relation == 4 {
        return linear_same_sign_residual<BabyBear, 4>(
            left,
            right,
            subtract_right == 1,
            witness,
        ).to_u32()
    }
    if relation == 5 {
        return linear_comparison_residual<BabyBear, 4>(witness).to_u32()
    }
    if relation == 6 {
        return linear_output_sign_residual<BabyBear, 4>(
            left,
            right,
            subtract_right == 1,
            witness,
        ).to_u32()
    }
    if relation == 7 {
        return boolean_residual<BabyBear>(if witness.same_sign { 1 } else { 0 }).to_u32()
    }
    if relation == 8 {
        return boolean_residual<BabyBear>(if witness.select_right { 1 } else { 0 }).to_u32()
    }
    if relation == 9 {
        return boolean_residual<BabyBear>(if witness.output_nonzero { 1 } else { 0 }).to_u32()
    }
    if relation == 10 {
        return boolean_residual<BabyBear>(witness.sum_carries[index as usize]).to_u32()
    }
    if relation == 11 {
        return boolean_residual<BabyBear>(witness.left_borrows[index as usize]).to_u32()
    }
    if relation == 12 {
        return boolean_residual<BabyBear>(witness.right_borrows[index as usize]).to_u32()
    }
    let range = derive_radix_range_witness(witness.output.limbs)
    linear_output_nonzero_residual<BabyBear, 4>(witness, range).to_u32()
}

pub fn fixed_linear4_mutated_residual(
    _ left_negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ right_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ subtract_right: u32,
    _ mutation: u32,
) -> u32 {
    let (left, right, mut witness) = linear4(
        left_negative,
        [l0, l1, l2, l3],
        right_negative,
        [r0, r1, r2, r3],
        subtract_right,
    )
    if mutation == 1 {
        witness.sum_digits[0] = witness.sum_digits[0] + 1
        return linear_addition_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 2 {
        witness.sum_carries[0] = 1 - witness.sum_carries[0]
        return linear_addition_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 3 {
        witness.left_difference_digits[0] = witness.left_difference_digits[0] + 1
        return linear_left_difference_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 4 {
        witness.left_borrows[0] = 1 - witness.left_borrows[0]
        return linear_left_difference_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 5 {
        witness.right_difference_digits[0] = witness.right_difference_digits[0] + 1
        return linear_right_difference_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 6 {
        witness.right_borrows[0] = 1 - witness.right_borrows[0]
        return linear_right_difference_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 7 {
        witness.same_sign = !witness.same_sign
        return linear_same_sign_residual<BabyBear, 4>(
            left,
            right,
            subtract_right == 1,
            witness,
        ).to_u32()
    }
    if mutation == 8 {
        witness.select_right = !witness.select_right
        return linear_comparison_residual<BabyBear, 4>(witness).to_u32()
    }
    if mutation == 10 {
        witness.output.limbs[0] = witness.output.limbs[0] + 1
        return linear_output_selection_residual<BabyBear, 4>(witness, 0).to_u32()
    }
    witness.output.negative = !witness.output.negative
    linear_output_sign_residual<BabyBear, 4>(
        left,
        right,
        subtract_right == 1,
        witness,
    ).to_u32()
}

pub fn fixed_range4_encoded(
    _ negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
) -> BrowserBytes {
    let value = fixed4(negative, [l0, l1, l2, l3])
    let witness = derive_radix_range_witness(value.limbs)
    let writer = BrowserWordWriter::allocate(<RangeWitness4 as CanonicalWords>::WORDS)
    encode_canonical_words(ref witness, writer).finish()
}

pub fn fixed_range4_mutation_holds(
    _ negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ mutation: u32,
) -> u32 {
    let mut value = fixed4(negative, [l0, l1, l2, l3])
    let mut witness = derive_radix_range_witness(value.limbs)
    if mutation == 1 { witness.limbs[0].bits[0] = 1 - witness.limbs[0].bits[0] }
    if mutation == 2 {
        witness.limbs[0].nonzero_prefix[0] = 1 - witness.limbs[0].nonzero_prefix[0]
    }
    if mutation == 3 { witness.nonzero = !witness.nonzero }
    if mutation == 4 { value.limbs[0] = value.limbs[0] + LIMB_BASE }
    if mutation == 5 {
        value = fixed4(1, [0; 4])
        witness = derive_radix_range_witness(value.limbs)
    }
    if fixed_range_witness_holds(value, witness) { 1 } else { 0 }
}

pub fn fixed_range4_residual(
    _ negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ relation: u32,
    _ limb_index: u32,
    _ bit_index: u32,
) -> u32 {
    let value = fixed4(negative, [l0, l1, l2, l3])
    let witness = derive_radix_range_witness(value.limbs)
    if relation == 0 {
        return radix_bit_boolean_residual<BabyBear, 4>(
            witness,
            limb_index,
            bit_index,
        ).to_u32()
    }
    if relation == 1 {
        return radix_prefix_boolean_residual<BabyBear, 4>(
            witness,
            limb_index,
            bit_index,
        ).to_u32()
    }
    if relation == 2 {
        return radix_limb_reconstruction_residual<BabyBear, 4>(
            value.limbs,
            witness,
            limb_index,
        ).to_u32()
    }
    if relation == 3 {
        return radix_prefix_residual<BabyBear, 4>(
            witness,
            limb_index,
            bit_index,
        ).to_u32()
    }
    if relation == 4 {
        return radix_nonzero_residual<BabyBear, 4>(witness).to_u32()
    }
    if relation == 5 {
        return fixed_sign_zero_residual<BabyBear, 4>(value, witness).to_u32()
    }
    boolean_residual<BabyBear>(if witness.nonzero { 1 } else { 0 }).to_u32()
}

pub fn fixed_range4_mutated_residual(
    _ negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ mutation: u32,
) -> u32 {
    let mut value = fixed4(negative, [l0, l1, l2, l3])
    let mut witness = derive_radix_range_witness(value.limbs)
    if mutation == 1 {
        witness.limbs[0].bits[0] = 1 - witness.limbs[0].bits[0]
        return radix_limb_reconstruction_residual<BabyBear, 4>(
            value.limbs,
            witness,
            0,
        ).to_u32()
    }
    if mutation == 2 {
        witness.limbs[0].nonzero_prefix[0] = 1 - witness.limbs[0].nonzero_prefix[0]
        return radix_prefix_residual<BabyBear, 4>(witness, 0, 0).to_u32()
    }
    if mutation == 3 {
        witness.nonzero = !witness.nonzero
        return radix_nonzero_residual<BabyBear, 4>(witness).to_u32()
    }
    if mutation == 4 {
        value.limbs[0] = value.limbs[0] + LIMB_BASE
        return radix_limb_reconstruction_residual<BabyBear, 4>(
            value.limbs,
            witness,
            0,
        ).to_u32()
    }
    value = fixed4(1, [0; 4])
    witness = derive_radix_range_witness(value.limbs)
    fixed_sign_zero_residual<BabyBear, 4>(value, witness).to_u32()
}

pub fn fixed_product4_encoded(
    _ left_negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ right_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
) -> BrowserBytes {
    let (_left, _right, witness) = product4(
        left_negative,
        [l0, l1, l2, l3],
        right_negative,
        [r0, r1, r2, r3],
    )
    let writer = BrowserWordWriter::allocate(<ProductWitness4 as CanonicalWords>::WORDS)
    encode_canonical_words(ref witness, writer).finish()
}

pub fn fixed_product4_mutation_holds(
    _ left_negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ right_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ mutation: u32,
) -> u32 {
    let (mut left, right, mut witness) = product4(
        left_negative,
        [l0, l1, l2, l3],
        right_negative,
        [r0, r1, r2, r3],
    )
    if mutation == 1 { witness.low_digits[0] = witness.low_digits[0] + 1 }
    if mutation == 2 { witness.low_carries[0] = witness.low_carries[0] + 1 }
    if mutation == 3 { witness.round_up = !witness.round_up }
    if mutation == 4 { witness.output.limbs[0] = witness.output.limbs[0] + 1 }
    if mutation == 5 { witness.output.negative = !witness.output.negative }
    if mutation == 6 { left.limbs[0] = 8192 }
    if mutation == 7 { witness.high_digits[3] = witness.high_digits[3] + 1 }
    if fixed_product_witness_holds(left, right, witness) { 1 } else { 0 }
}

pub fn fixed_product4_residuals(
    _ left_negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ right_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
) -> (
    u32, u32, u32, u32, u32, u32, u32, u32,
    u32, u32, u32, u32, u32, u32,
) {
    let (left, right, witness) = product4(
        left_negative,
        [l0, l1, l2, l3],
        right_negative,
        [r0, r1, r2, r3],
    )
    (
        convolution_residual<BabyBear, 4>(left, right, witness, 0).to_u32(),
        convolution_residual<BabyBear, 4>(left, right, witness, 1).to_u32(),
        convolution_residual<BabyBear, 4>(left, right, witness, 2).to_u32(),
        convolution_residual<BabyBear, 4>(left, right, witness, 3).to_u32(),
        convolution_residual<BabyBear, 4>(left, right, witness, 4).to_u32(),
        convolution_residual<BabyBear, 4>(left, right, witness, 5).to_u32(),
        convolution_residual<BabyBear, 4>(left, right, witness, 6).to_u32(),
        convolution_residual<BabyBear, 4>(left, right, witness, 7).to_u32(),
        rounding_residual<BabyBear, 4>(witness, 0).to_u32(),
        rounding_residual<BabyBear, 4>(witness, 1).to_u32(),
        rounding_residual<BabyBear, 4>(witness, 2).to_u32(),
        rounding_residual<BabyBear, 4>(witness, 3).to_u32(),
        boolean_residual<BabyBear>(if witness.round_up { 1 } else { 0 }).to_u32(),
        boolean_residual<BabyBear>(if witness.round_overflow { 1 } else { 0 }).to_u32(),
    )
}

pub fn fixed_product4_mutated_residual(
    _ left_negative: u32,
    _ l0: u32,
    _ l1: u32,
    _ l2: u32,
    _ l3: u32,
    _ right_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ mutation: u32,
) -> u32 {
    let (left, right, mut witness) = product4(
        left_negative,
        [l0, l1, l2, l3],
        right_negative,
        [r0, r1, r2, r3],
    )
    if mutation == 1 {
        witness.low_digits[0] = witness.low_digits[0] + 1
        return convolution_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 2 {
        witness.low_carries[0] = witness.low_carries[0] + 1
        return convolution_residual<BabyBear, 4>(left, right, witness, 0).to_u32()
    }
    if mutation == 3 {
        witness.round_up = !witness.round_up
        return rounding_residual<BabyBear, 4>(witness, 0).to_u32()
    }
    if mutation == 4 {
        witness.output.limbs[0] = witness.output.limbs[0] + 1
        return rounding_residual<BabyBear, 4>(witness, 0).to_u32()
    }
    witness.high_digits[3] = witness.high_digits[3] + 1
    convolution_residual<BabyBear, 4>(left, right, witness, 7).to_u32()
}

pub fn convolution_schedule4(_ coefficient: u32, _ term: u32) -> (u32, u32, u32) {
    (
        convolution_term_count<4>(coefficient),
        convolution_left_index<4>(coefficient, term),
        convolution_right_index<4>(coefficient, term),
    )
}

pub fn convolution_schedule8(_ coefficient: u32, _ term: u32) -> (u32, u32, u32) {
    (
        convolution_term_count<8>(coefficient),
        convolution_left_index<8>(coefficient, term),
        convolution_right_index<8>(coefficient, term),
    )
}

pub fn baby_bear_safe_convolution_limbs() -> u32 {
    max_convolution_limbs_below(BABY_BEAR_MODULUS)
}

fn empty_accumulator4() -> Accumulator4 {
    let claim = claim4(0, [0; 4], 0, [0; 4], 1)
    let boundary = initial_boundary<4>()
    RecursiveOrbitAccumulator {
        valid: false,
        leaves: 0,
        interval: OrbitInterval { claim: claim, start: boundary, end: boundary },
    }
}

pub fn recursive_chunk4_encoded(
    _ real_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ imaginary_negative: u32,
    _ i0: u32,
    _ i1: u32,
    _ i2: u32,
    _ i3: u32,
    _ bound: u32,
    _ requested_steps: u32,
) -> BrowserBytes {
    let claim = claim4(
        real_negative,
        [r0, r1, r2, r3],
        imaginary_negative,
        [i0, i1, i2, i3],
        bound,
    )
    encode_accumulator4(evaluate_chunk(claim, initial_boundary<4>(), requested_steps))
}

/// Mutation modes exercise only parent topology:
/// 0 valid, 1 shared boundary mismatch, 2 statement mismatch,
/// 3 invalid child, 4 non-adjacent iteration.
pub fn recursive_merge4_encoded(
    _ real_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ imaginary_negative: u32,
    _ i0: u32,
    _ i1: u32,
    _ i2: u32,
    _ i3: u32,
    _ bound: u32,
    _ left_steps: u32,
    _ right_steps: u32,
    _ mutation: u32,
) -> BrowserBytes {
    let claim = claim4(
        real_negative,
        [r0, r1, r2, r3],
        imaginary_negative,
        [i0, i1, i2, i3],
        bound,
    )
    let left = evaluate_chunk(claim, initial_boundary<4>(), left_steps)
    let mut right_claim = claim
    let mut right_start = left.interval.end
    if mutation == 1 {
        right_start.z.real.limbs[0] = right_start.z.real.limbs[0] + 1
    }
    if mutation == 2 && right_claim.bound > 1 {
        right_claim.bound = right_claim.bound - 1
    }
    if mutation == 4 {
        right_start.iteration = right_start.iteration + 1
    }
    let mut right = evaluate_chunk(right_claim, right_start, right_steps)
    if mutation == 3 { right.valid = false }
    encode_accumulator4(merge_adjacent(left, right))
}

pub fn recursive_committed_leaf4_encoded(
    _ real_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ imaginary_negative: u32,
    _ i0: u32,
    _ i1: u32,
    _ i2: u32,
    _ i3: u32,
    _ bound: u32,
    _ requested_steps: u32,
) -> BrowserBytes {
    let claim = claim4(
        real_negative,
        [r0, r1, r2, r3],
        imaginary_negative,
        [i0, i1, i2, i3],
        bound,
    )
    let evaluated = evaluate_chunk(claim, initial_boundary<4>(), requested_steps)
    encode_committed_accumulator4(commit_recursive_semantic_leaf(evaluated.interval))
}

/// Mutation modes exercise the fixed-size committed parent boundary:
/// 0 valid, 1 shared-boundary digest, 2 statement digest, 3 invalid child,
/// 4 non-adjacent iteration, 5 overflowing leaf count.
pub fn recursive_committed_merge4_encoded(
    _ real_negative: u32,
    _ r0: u32,
    _ r1: u32,
    _ r2: u32,
    _ r3: u32,
    _ imaginary_negative: u32,
    _ i0: u32,
    _ i1: u32,
    _ i2: u32,
    _ i3: u32,
    _ bound: u32,
    _ left_steps: u32,
    _ right_steps: u32,
    _ mutation: u32,
) -> BrowserBytes {
    let claim = claim4(
        real_negative,
        [r0, r1, r2, r3],
        imaginary_negative,
        [i0, i1, i2, i3],
        bound,
    )
    let left_raw = evaluate_chunk(claim, initial_boundary<4>(), left_steps)
    let right_raw = evaluate_chunk(claim, left_raw.interval.end, right_steps)
    let left = commit_recursive_semantic_leaf(left_raw.interval)
    let mut right = commit_recursive_semantic_leaf(right_raw.interval)
    if mutation == 1 {
        right.start.value = poseidon_baby_bear::Poseidon2Digest::zero()
    }
    if mutation == 2 {
        right.statement.value = poseidon_baby_bear::Poseidon2Digest::zero()
    }
    if mutation == 3 { right.valid = false }
    if mutation == 4 { right.start_iteration = right.start_iteration + 1 }
    if mutation == 5 { right.leaves = mandelbrot_proof_recursive::MAX_RECURSIVE_CLAIM_BOUND }
    encode_committed_accumulator4(merge_recursive_committed_intervals(left, right))
}

pub fn recursive_accumulator4_decode_at(_ ptr: u32, _ len: u32) -> (u32, u32) {
    let mut accumulator = empty_accumulator4()
    let reader = BrowserWordReader::new(BrowserBytes { ptr: ptr, len: len })
    let reader = accumulator.decode(reader)
    if !reader.complete() { return (0, 0) }
    let replay = certify_leaf(accumulator.interval)
    (1, if accumulator.valid && accumulator.leaves == 1 && replay.valid { 1 } else { 0 })
}
