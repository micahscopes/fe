type Accumulator4 = RecursiveOrbitAccumulator<4>
type CommittedAccumulator4 = RecursiveCommittedInterval<4>
type ProductWitness4 = FixedProductWitness<4>
type LinearWitness4 = FixedLinearWitness<4>
type RangeWitness4 = RadixRangeWitness<4>
type TransitionWitness4 = FixedMandelbrotTransitionWitness<4>
type ProductCarryRangeWitness4 = FixedProductCarryRangeWitness<4>

fn fixed4(_ negative: u32, _ limbs: [u32; 4]) -> Fixed<4> {
    Fixed { negative: negative == 1, limbs: limbs }
}

fn claim4(
    _ real_negative: u32,
    _ real: [u32; 4],
    _ imaginary_negative: u32,
    _ imaginary: [u32; 4],
    _ bound: u32,
) -> HighPrecisionEscapeClaim<4> {
    HighPrecisionEscapeClaim {
        point: ComplexFixed {
            real: fixed4(real_negative, real),
            imaginary: fixed4(imaginary_negative, imaginary),
        },
        bound: bound,
    }
}

fn complex4(
    _ real_negative: u32,
    _ real: [u32; 4],
    _ imaginary_negative: u32,
    _ imaginary: [u32; 4],
) -> ComplexFixed<4> {
    ComplexFixed {
        real: fixed4(real_negative, real),
        imaginary: fixed4(imaginary_negative, imaginary),
    }
}

fn encode_accumulator4(_ accumulator: Accumulator4) -> BrowserBytes {
    let writer = BrowserWordWriter::allocate(<Accumulator4 as CanonicalWords>::WORDS)
    encode_canonical_words(ref accumulator, writer).finish()
}

fn encode_committed_accumulator4(_ accumulator: CommittedAccumulator4) -> BrowserBytes {
    let writer = BrowserWordWriter::allocate(
        <CommittedAccumulator4 as CanonicalWords>::WORDS,
    )
    encode_canonical_words(ref accumulator, writer).finish()
}

fn product4(
    _ left_negative: u32,
    _ left: [u32; 4],
    _ right_negative: u32,
    _ right: [u32; 4],
) -> (Fixed<4>, Fixed<4>, ProductWitness4) {
    let left = fixed4(left_negative, left)
    let right = fixed4(right_negative, right)
    (left, right, derive_fixed_product_witness(left, right))
}

fn linear4(
    _ left_negative: u32,
    _ left: [u32; 4],
    _ right_negative: u32,
    _ right: [u32; 4],
    _ subtract_right: u32,
) -> (Fixed<4>, Fixed<4>, LinearWitness4) {
    let left = fixed4(left_negative, left)
    let right = fixed4(right_negative, right)
    let witness = if subtract_right == 1 {
        derive_fixed_difference_witness(left, right)
    } else {
        derive_fixed_sum_witness(left, right)
    }
    (left, right, witness)
}

fn transition4(
    _ point_real_negative: u32,
    _ point_real: [u32; 4],
    _ point_imaginary_negative: u32,
    _ point_imaginary: [u32; 4],
    _ current_real_negative: u32,
    _ current_real: [u32; 4],
    _ current_imaginary_negative: u32,
    _ current_imaginary: [u32; 4],
) -> (ComplexFixed<4>, ComplexFixed<4>, TransitionWitness4) {
    let point = complex4(
        point_real_negative,
        point_real,
        point_imaginary_negative,
        point_imaginary,
    )
    let current = complex4(
        current_real_negative,
        current_real,
        current_imaginary_negative,
        current_imaginary,
    )
    (point, current, derive_fixed_mandelbrot_transition_witness(point, current))
}

fn product_node_code(_ node: ProductNode) -> u32 {
    match node {
        ProductNode::Xx => 0,
        ProductNode::Yy => 1,
        ProductNode::Xy => 2,
        ProductNode::Invalid => 99,
    }
}

fn linear_node_code(_ node: LinearNode) -> u32 {
    match node {
        LinearNode::RealDifference => 0,
        LinearNode::NextReal => 1,
        LinearNode::DoubleXy => 2,
        LinearNode::NextImaginary => 3,
        LinearNode::Invalid => 99,
    }
}

fn linear4_node(_ index: u32) -> LinearNode {
    match index {
        0 => LinearNode::RealDifference,
        1 => LinearNode::NextReal,
        2 => LinearNode::DoubleXy,
        3 => LinearNode::NextImaginary,
        _ => LinearNode::Invalid,
    }
}

fn coordinate_node_code(_ node: CoordinateNode) -> u32 {
    match node {
        CoordinateNode::Real => 0,
        CoordinateNode::Imaginary => 1,
        CoordinateNode::Invalid => 99,
    }
}

fn linear_limb_role_code(_ role: LinearLimbRole) -> u32 {
    match role {
        LinearLimbRole::Sum => 0,
        LinearLimbRole::LeftDifference => 1,
        LinearLimbRole::RightDifference => 2,
        LinearLimbRole::Select => 3,
        LinearLimbRole::Invalid => 99,
    }
}

fn range_node_code(_ node: RangeNode) -> u32 {
    match node {
        RangeNode::PointReal => 0,
        RangeNode::PointImaginary => 1,
        RangeNode::CurrentReal => 2,
        RangeNode::CurrentImaginary => 3,
        RangeNode::NextReal => 4,
        RangeNode::NextImaginary => 5,
        RangeNode::ProductLow(product) => 6 + 3 * product_node_code(product),
        RangeNode::ProductHigh(product) => 7 + 3 * product_node_code(product),
        RangeNode::ProductOutput(product) => 8 + 3 * product_node_code(product),
        RangeNode::LinearSum(linear) => 15 + 4 * linear_node_code(linear),
        RangeNode::LinearLeftDifference(linear) => 16 + 4 * linear_node_code(linear),
        RangeNode::LinearRightDifference(linear) => 17 + 4 * linear_node_code(linear),
        RangeNode::LinearOutput(linear) => 18 + 4 * linear_node_code(linear),
        RangeNode::Invalid => 99,
    }
}

pub fn sparse_transition4_metadata() -> (u32, u32, u32) {
    (
        sparse_transition_task_count<4>(),
        sparse_transition_trace_length<4>(),
        sparse_transition_trace_log<4>(),
    )
}

pub fn sparse_transition8_metadata() -> (u32, u32, u32) {
