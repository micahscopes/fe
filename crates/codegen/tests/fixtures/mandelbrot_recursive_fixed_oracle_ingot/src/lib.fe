pub fn fixed_transition4_sparse_linear_audit(
    _ prn: u32, _ pr0: u32, _ pr1: u32, _ pr2: u32, _ pr3: u32,
    _ pin: u32, _ pi0: u32, _ pi1: u32, _ pi2: u32, _ pi3: u32,
    _ crn: u32, _ cr0: u32, _ cr1: u32, _ cr2: u32, _ cr3: u32,
    _ cin: u32, _ ci0: u32, _ ci1: u32, _ ci2: u32, _ ci3: u32,
    _ challenge: u32,
    _ mutation_index: u32,
    _ mutation_lane: u32,
) -> (u32, u32, u32) {
    let (point, current, witness) = transition4(
        prn, [pr0, pr1, pr2, pr3], pin, [pi0, pi1, pi2, pi3],
        crn, [cr0, cr1, cr2, cr3], cin, [ci0, ci1, ci2, ci3],
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let challenge = BabyBear::from_u32(challenge)
    let rows = sparse_linear_task_count<4>()
    let linear_offset = sparse_radix_task_count<4>()
        + sparse_carry_task_count<4>()
        + sparse_product_task_count<4>()
        + sparse_round_task_count<4>()
    let mut failures: u32 = 0
    let mut constraints: u32 = 0
    let mut previous = sparse_linear4_row(point, witness, 0)
    let mut index: u32 = 0
    while index < rows {
        let task = sparse_transition_task_at<4>(linear_offset + index)
        let mut row = sparse_linear4_row(point, witness, index)
        if mutation_lane == 7 && mutation_index == 0 && index == 0 {
            let delta = BabyBear::from_u32(1)
            row.value = row.value.radix2_add(delta)
            row.state_before = row.state_before.radix2_add(delta)
        } else {
            if index == mutation_index {
                row = mutate_sparse_row(row, mutation_lane)
            }
        }
        let evaluated = evaluate_sparse_linear_row(challenge, task, row)
        constraints = constraints + evaluated.constraints
        if !evaluated.valid || evaluated.folded.to_u32() != 0 {
            failures = failures + 1
        }
        let linear_link = match task {
            SparseTransitionTask::LinearLimb(
                _node,
                LinearLimbRole::Sum,
                limb,
            ) => (true, limb),
            SparseTransitionTask::LinearLimb(
                _node,
                LinearLimbRole::LeftDifference,
                limb,
            ) => (true, limb),
            SparseTransitionTask::LinearLimb(
                _node,
                LinearLimbRole::RightDifference,
                limb,
            ) => (true, limb),
            _ => (false, 0),
        }
        if linear_link.0 {
            constraints = constraints + 1
            let residual = if linear_link.1 == 0 {
                sparse_linear_initial_residual(row)
            } else {
                sparse_linear_link_residual(previous, row)
            }
            if residual.to_u32() != 0 { failures = failures + 1 }
        }
        previous = row
        index = index + 1
    }

    let mut target_index: u32 = 0
    while target_index < 4 {
        let target = linear4_node(target_index)
        let mut source = BabyBear::from_u32(0)
        let mut consumer = BabyBear::from_u32(0)
        let mut source_index: u32 = 0
        while source_index < sparse_radix_task_count<4>() {
            let task = sparse_transition_task_at<4>(source_index)
            let row = sparse_radix4_row(point, current, next, witness, source_index)
            source = source.radix2_add(
                sparse_linear_copy_source<BabyBear, 4>(
                    challenge, target, task, row,
                ),
            )
            source_index = source_index + 1
        }
        source_index = 0
        while source_index < rows {
            let task = sparse_transition_task_at<4>(linear_offset + source_index)
            let mut row = sparse_linear4_row(point, witness, source_index)
            if mutation_lane == 7 && mutation_index == 0 && source_index == 0 {
                let delta = BabyBear::from_u32(1)
                row.value = row.value.radix2_add(delta)
                row.state_before = row.state_before.radix2_add(delta)
            } else {
                if source_index == mutation_index {
                    row = mutate_sparse_row(row, mutation_lane)
                }
            }
            source = source.radix2_add(
                sparse_linear_copy_source<BabyBear, 4>(
                    challenge, target, task, row,
                ),
            )
            consumer = consumer.radix2_add(
                sparse_linear_copy_consumer<BabyBear, 4>(
                    challenge, target, task, row,
                ),
            )
            source_index = source_index + 1
        }
        constraints = constraints + 1
        if source.to_u32() != consumer.to_u32() { failures = failures + 1 }
        target_index = target_index + 1
    }
    (failures, constraints, rows)
}

