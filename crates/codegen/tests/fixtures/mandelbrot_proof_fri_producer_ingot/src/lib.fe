pub struct FriRoundCycle {}

actor ProductionFriProver uses (Program<WebGpuBackend>) {
    round_placements: Shared<u32, ROUND_PLACEMENT_WORDS>,
    arena: Shared<u32, ARENA_WORDS>,
    control: Shared<u32, CONTROL_WORDS>,
    query_workspace: Shared<u32, QUERY_WORKSPACE_WORDS>,
    opening_workspace: Shared<u32, OPENING_WORKSPACE_WORDS>,
    evaluation_openings: Shared<u32, EVALUATION_OPENING_WORDS>,
    sibling_openings: Shared<u32, SIBLING_OPENING_WORDS>,

    fn prepare_rounds(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<1, 1, 1>>)
    {
        let lane = invocation.global.x
        if lane >= FRI_ROUNDS.downcast_truncate() { return }
        store_fri_round_placement<ROUND_PLACEMENT_WORDS>(
            self.round_placements,
            lane,
            <FoldSchedule as FriSchedulePlacement>::fri_round_placement(lane),
        )
    }

    /// Deterministic Fe-authored input for the independent browser oracle.
    /// Production composition and transcript buffers connect at this same
    /// typed resource boundary without changing the FRI schedule.
    fn seed_prover_input(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<INPUT_GROUPS, 1, 1>,
            >
        )
    {
        let lane = invocation.global.x
        if lane < PRODUCTION_LDE_LENGTH.downcast_truncate() {
            let base = COMPOSITION_START + lane * EXTENSION_WORDS.downcast_truncate()
            self.arena.store(index: base, value: lane + 1)
            self.arena.store(index: base + 1, value: lane * 3 + 5)
            self.arena.store(index: base + 2, value: lane * 7 + 11)
            self.arena.store(index: base + 3, value: lane * 13 + 17)
        }
        if lane < DIGEST_FIELDS.downcast_truncate() {
            self.control.store(
                index: TRANSCRIPTS_START + lane,
                value: lane * 17 + 5,
            )
        }
        if lane == 0 {
            self.arena.store(index: COMPOSITION_VALID, value: 1)
            self.control.store(index: TRANSCRIPT_VALID_START, value: 1)
        }
    }

    fn initialize_prover(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<PROVER_GROUPS, 1, 1>,
            >
        )
    {
        initialize_fri_prover_lane<
            FRI_ROUNDS,
            FOLDED_EVALUATIONS,
            LAYER_TREE_NODES,
            PROVER_LANES,
            ARENA_WORDS,
            CONTROL_WORDS,
        >(
            self.arena,
            arena_layout(),
            self.control,
            control_layout(),
            invocation,
        )
    }

    fn begin_round(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    Taper<Grid<PROVER_GROUPS, 1, 1>, 1, 0, 0, 0>,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        begin_fri_round_lane<
            FRI_ROUNDS,
            PROVER_LANES,
            ROUND_PLACEMENT_WORDS,
            ARENA_WORDS,
            CONTROL_WORDS,
        >(
            self.round_placements,
            self.arena,
            arena_layout(),
            self.control,
            control_layout(),
            invocation,
        )
    }

    fn derive_challenge(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    Repeat<1, 1, 1, FRI_CHALLENGE_STEPS>,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        advance_fri_challenge_lane<
            FRI_ROUNDS,
            PROVER_LANES,
            ROUND_PLACEMENT_WORDS,
            ARENA_WORDS,
            CONTROL_WORDS,
        >(
            self.round_placements,
            self.arena,
            arena_layout(),
            self.control,
            control_layout(),
            invocation,
        )
    }

    fn fold_round(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    Taper<Grid<PAIR_GROUPS, 1, 1>, 1, 0, 0, 0>,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        fold_fri_round_lane<
            FRI_ROUNDS,
            PROVER_LANES,
            ROUND_PLACEMENT_WORDS,
            ARENA_WORDS,
            CONTROL_WORDS,
        >(
            self.round_placements,
            self.arena,
            arena_layout(),
            self.control,
            control_layout(),
            invocation,
        )
    }

    fn initialize_leaves(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    Taper<Grid<PROVER_GROUPS, 1, 1>, 1, 0, 0, 0>,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        initialize_fri_leaf_lane<
            FRI_ROUNDS,
            PROVER_LANES,
            ROUND_PLACEMENT_WORDS,
            ARENA_WORDS,
            CONTROL_WORDS,
        >(
            self.round_placements,
            self.arena,
            arena_layout(),
            self.control,
            control_layout(),
            invocation,
        )
    }

    fn hash_leaves(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    Cooperate<
                        Taper<
                            Repeat<PROVER_GROUPS, 1, 1, FRI_LEAF_HASH_STEPS>,
                            1, 0, 0, 0,
                        >,
                        8,
                    >,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        advance_fri_leaf_lane<
            FRI_ROUNDS,
            PROVER_LANES,
            ROUND_PLACEMENT_WORDS,
            ARENA_WORDS,
            CONTROL_WORDS,
        >(
            self.round_placements,
            self.arena,
            arena_layout(),
            self.control,
            control_layout(),
            invocation,
        )
    }

    fn begin_tree(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    Taper<Grid<TREE_GROUPS, 1, 1>, 1, 0, 0, 0>,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        begin_fri_tree_lane<PROVER_LANES, ARENA_WORDS>(
            self.arena,
            arena_layout(),
            invocation,
        )
    }

    fn reduce_tree(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    Cooperate<
                        Taper<
                            Repeat<TREE_GROUPS, 1, 1, PROVER_TREE_STEPS>,
                            1, 0, 0, {1 + FRI_LEAF_HASH_STEPS},
                        >,
                        8,
                    >,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        advance_fri_tree_lane<
            FRI_ROUNDS,
            PROVER_LANES,
            ROUND_PLACEMENT_WORDS,
            ARENA_WORDS,
            CONTROL_WORDS,
        >(
            self.round_placements,
            self.arena,
            arena_layout(),
            self.control,
            control_layout(),
            invocation,
        )
    }

    fn begin_binding(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    Grid<1, 1, 1>,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        begin_fri_binding_lane<PROVER_LANES, ARENA_WORDS>(
            self.arena,
            arena_layout(),
            invocation,
        )
    }

    fn bind_transcript(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    Repeat<1, 1, 1, FRI_BINDING_STEPS>,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        advance_fri_binding_lane<
            FRI_ROUNDS,
            PROVER_LANES,
            ROUND_PLACEMENT_WORDS,
            ARENA_WORDS,
            CONTROL_WORDS,
        >(
            self.round_placements,
            self.arena,
            arena_layout(),
            self.control,
            control_layout(),
            invocation,
        )
    }

    fn finish_round(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<FriRoundCycle, Grid<1, 1, 1>, FRI_ROUNDS>,
            >
        )
    {
        finish_fri_round_lane<
            FRI_ROUNDS,
            ROUND_PLACEMENT_WORDS,
            CONTROL_WORDS,
        >(
            self.round_placements,
            self.control,
            control_layout(),
            invocation,
        )
    }

    fn sample_queries(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<
                    QUERY_SAMPLE_GROUPS,
                    1,
                    1,
                    INDEXED_DIGEST_SQUEEZE_STEPS,
                >,
            >
        )
    {
        let query_position = invocation.global.x
            / POSEIDON2_LANES.downcast_truncate()
        let item = fri_query_sample_work_item<QueryPlan>(query_position)
        let rounds: u32 = FRI_ROUNDS.downcast_truncate()
        let digest_fields: u32 = DIGEST_FIELDS.downcast_truncate()
        let final_transcript = TRANSCRIPTS_START + rounds * digest_fields
        let input_valid = item.valid
            && self.control.load(index: PROVER_COMPLETE) == 1
            && self.control.load(
                index: TRANSCRIPT_VALID_START
                    + FRI_ROUNDS.downcast_truncate(),
            ) == 1
        let transcript = Poseidon2Digest::from_u32s([
            self.control.load(index: final_transcript),
            self.control.load(index: final_transcript + 1),
            self.control.load(index: final_transcript + 2),
            self.control.load(index: final_transcript + 3),
            self.control.load(index: final_transcript + 4),
            self.control.load(index: final_transcript + 5),
            self.control.load(index: final_transcript + 6),
            self.control.load(index: final_transcript + 7),
        ])
        let step = advance_indexed_digest_squeeze_lane<
            QUERY_COUNT,
            QUERY_WORKSPACE_WORDS,
        >(
            self.query_workspace,
            invocation,
            fri_query_domain_tag(),
            transcript,
            item.query_identity,
            input_valid,
        )
        if !step.active {
            self.opening_workspace.store(
                index: QUERY_PADDING_START
                    + invocation.global.x - QUERY_SAMPLE_WORK_ITEMS,
                value: invocation.global.x + 1,
            )
        } else if !step.valid && step.field_lane == 0 {
            self.opening_workspace.store(
                index: QUERY_INDICES_START + step.state,
                value: 0,
            )
            self.opening_workspace.store(
                index: QUERY_VALIDITY_START + step.state,
                value: 0,
            )
        } else if step.complete {
            self.opening_workspace.store(
                index: QUERY_INDICES_START + step.state,
                value: step.value.coefficient(0).to_u32() & QUERY_HALF_MASK,
            )
            self.opening_workspace.store(
                index: QUERY_VALIDITY_START + step.state,
                value: 1,
            )
        }
    }

    fn open_evaluations(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<EVALUATION_GROUPS, 1, 1, FRI_ROUNDS>,
            >
        )
    {
        let lane = invocation.global.x
        let item = fri_query_evaluation_work_item<QueryPlan, FoldSchedule>(lane)
        if !item.valid {
            self.opening_workspace.store(
                index: OPENING_PADDING_START
                    + lane - EVALUATION_ITEMS.downcast_truncate(),
                value: lane + 1,
            )
            return
        }
        let query = self.opening_workspace.load(
            index: QUERY_INDICES_START + item.query_position,
        )
        let progress_index = EVALUATION_PROGRESS_START + lane
        let round = self.opening_workspace.load(index: progress_index)
        if round >= FRI_ROUNDS.downcast_truncate() { return }
        let cursor_base = EVALUATION_CURSOR_START
            + lane * FRI_QUERY_CURSOR_FIELDS.downcast_truncate()
        let placement = advance_fri_query_evaluation_storage<
            ROUND_PLACEMENT_WORDS,
            OPENING_WORKSPACE_WORDS,
        >(
            self.round_placements,
            self.opening_workspace,
            cursor_base,
            round,
            item.opening,
            query,
        )
        self.opening_workspace.store(index: progress_index, value: round + 1)
        if round + 1 != FRI_ROUNDS.downcast_truncate()
            || !placement.valid
            || self.control.load(index: PROVER_COMPLETE) != 1
            || self.arena.load(
                index: EVALUATION_VALID_START + placement.evaluation_index,
            ) != 1 {
            return
        }
        let source = EVALUATIONS_START
            + placement.evaluation_index
                * EXTENSION_WORDS.downcast_truncate()
        let destination = lane * EXTENSION_WORDS.downcast_truncate()
        self.evaluation_openings.store(
            index: destination,
            value: self.arena.load(index: source),
        )
        self.evaluation_openings.store(
            index: destination + 1,
            value: self.arena.load(index: source + 1),
        )
        self.evaluation_openings.store(
            index: destination + 2,
            value: self.arena.load(index: source + 2),
        )
        self.evaluation_openings.store(
            index: destination + 3,
            value: self.arena.load(index: source + 3),
        )
    }

    fn open_siblings(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<SIBLING_GROUPS, 1, 1, FRI_ROUNDS>,
            >
        )
    {
        let lane = invocation.global.x
        let item = fri_query_sibling_work_item<QueryPlan, FoldSchedule>(lane)
        if !item.valid {
            self.opening_workspace.store(
                index: OPENING_PADDING_START
                    + EVALUATION_PADDING.downcast_truncate()
                    + lane - SIBLING_ITEMS.downcast_truncate(),
                value: lane + 1,
            )
            return
        }
        let query = self.opening_workspace.load(
            index: QUERY_INDICES_START + item.query_position,
        )
        let progress_index = SIBLING_PROGRESS_START + lane
        let round = self.opening_workspace.load(index: progress_index)
        if round >= FRI_ROUNDS.downcast_truncate() { return }
        let cursor_base = SIBLING_CURSOR_START
            + lane * FRI_QUERY_CURSOR_FIELDS.downcast_truncate()
        let placement = advance_fri_query_sibling_storage<
            ROUND_PLACEMENT_WORDS,
            OPENING_WORKSPACE_WORDS,
        >(
            self.round_placements,
            self.opening_workspace,
            cursor_base,
            round,
            item.sibling,
            query,
        )
        self.opening_workspace.store(index: progress_index, value: round + 1)
        if round + 1 != FRI_ROUNDS.downcast_truncate()
            || !placement.valid
            || self.control.load(index: PROVER_COMPLETE) != 1
            || self.arena.load(
                index: NODE_VALID_START + placement.tree_node,
            ) != 1 {
            return
        }
        let source = TREE_START
            + placement.tree_node * DIGEST_FIELDS.downcast_truncate()
        let destination = lane * DIGEST_FIELDS.downcast_truncate()
        self.sibling_openings.store(
            index: destination,
            value: self.arena.load(index: source),
        )
        self.sibling_openings.store(
            index: destination + 1,
            value: self.arena.load(index: source + 1),
        )
        self.sibling_openings.store(
            index: destination + 2,
            value: self.arena.load(index: source + 2),
        )
        self.sibling_openings.store(
            index: destination + 3,
            value: self.arena.load(index: source + 3),
        )
        self.sibling_openings.store(
            index: destination + 4,
            value: self.arena.load(index: source + 4),
        )
        self.sibling_openings.store(
            index: destination + 5,
            value: self.arena.load(index: source + 5),
        )
        self.sibling_openings.store(
            index: destination + 6,
            value: self.arena.load(index: source + 6),
        )
        self.sibling_openings.store(
            index: destination + 7,
            value: self.arena.load(index: source + 7),
        )
    }

    fn compact_openings(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<1, 1, 1>>)
    {
        let round = invocation.global.x
        if round >= FRI_ROUNDS.downcast_truncate() { return }
        let mut query: u32 = 0
        while query < QUERY_COUNT.downcast_truncate() {
            if self.opening_workspace.load(
                index: QUERY_VALIDITY_START + query,
            ) != 1 {
                self.opening_workspace.store(
                    index: COMPACT_VALID_START + round,
                    value: 0,
                )
                return
            }
            query = query + 1
        }
        // Every metadata-valid bit already carries prover completion, final
        // transcript validity, and squeeze completion from `sample_queries`.
        // Compaction consumes that proof boundary instead of retaining either
        // the prover control buffer or the Poseidon scratch workspace.
        let valid = compact_fri_round_openings<
                QUERY_COUNT,
                EXTENSION_WORDS,
                DIGEST_FIELDS,
                OPENING_WORKSPACE_WORDS,
                ROUND_PLACEMENT_WORDS,
                ARENA_WORDS,
                OPENING_WORKSPACE_WORDS,
                OPENING_WORKSPACE_WORDS,
                EVALUATION_OPENING_WORDS,
                SIBLING_OPENING_WORDS,
            >(
                self.opening_workspace,
                QUERY_INDICES_START,
                self.round_placements,
                self.arena,
                EVALUATIONS_START,
                TREE_START,
                self.opening_workspace,
                OPENING_ACTIVITY_START,
                round,
                self.opening_workspace,
                COMPACT_LEAF_COUNT_START,
                COMPACT_SIBLING_COUNT_START,
                COMPACT_LEAF_INDEX_START,
                self.evaluation_openings,
                self.sibling_openings,
            )
        self.opening_workspace.store(
            index: COMPACT_VALID_START + round,
            value: if valid { 1 } else { 0 },
        )
    }

    fn paint(self, px: i32, py: i32) -> i32 uses (Pixel) {
        let mut openings_valid = true
        let mut round: u32 = 0
        while round < FRI_ROUNDS.downcast_truncate() {
            openings_valid = openings_valid
                && self.opening_workspace.load(
                    index: COMPACT_VALID_START + round,
                ) == 1
            round = round + 1
        }
        let color: u32 = if self.control.load(index: PROVER_COMPLETE) == 1
            && openings_valid {
            4278255360
        } else {
            4294901760
        }
        color.downcast_truncate()
    }
}
