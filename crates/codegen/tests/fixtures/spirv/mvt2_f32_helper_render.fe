// Focused aggregate-call boundary: a private straight-line helper accepts and
// returns the recursive four-leaf f32 value consumed by the Render export.

extern {
    fn __i32_from_f32(_: f32) -> i32
    const fn __bitcast<From, To>(_: From) -> To
}

pub struct ScF { pub s: f32 }
pub struct NdF<A> { pub a: A, pub b: A }

impl Copy for ScF {}
impl<A: Copy> Copy for NdF<A> {}

recursive type fn MvTF<const N: usize>() -> (*) {
    match N {
        0 => ScF
        _ => NdF<MvTF<{N - 1}>>
    }
}

#[inline(always)]
fn permute_mvt2(tree: MvTF<2>) -> MvTF<2> {
    NdF {
        a: NdF { a: tree.b.b, b: tree.a.b },
        b: NdF { a: tree.b.a, b: tree.a.a },
    }
}

#[inline(always)]
fn rebuild_mvt2(tree: MvTF<2>) -> MvTF<2> {
    permute_mvt2(tree)
}

pub fn mvt2_f32_helper_render(
    px: i32,
    py: i32,
    c0: f32,
    c1: f32,
    c2: f32,
    c3: f32,
) -> u32 {
    let tree: MvTF<2> = NdF {
        a: NdF { a: ScF { s: c0 }, b: ScF { s: c1 } },
        b: NdF { a: ScF { s: c2 }, b: ScF { s: c3 } },
    }
    let rebuilt: MvTF<2> = rebuild_mvt2(tree)
    let r: i32 = __i32_from_f32(rebuilt.a.a.s) + px
    let g: i32 = __i32_from_f32(rebuilt.a.b.s) + py
    let b: i32 = __i32_from_f32(rebuilt.b.a.s + 2.0 * rebuilt.b.b.s)
    __bitcast(r + g * 256 + b * 65536 + -16777216)
}
