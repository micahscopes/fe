// M2 (mandelbrot ladder rung 2): the REAL fractal compute. Signed Q12 fixed
// point (1.0 = 4096) in i32, overflow-free by construction (proof in
// mb2-mandelbrot-M2-spec.md section 2.2; re-derived in the e2e test).
//
// Grid convention (M1): the first two params ARE gid.xy. They are DECLARED i32:
// pixel indices are < 2^15, so the signless I32 binding of the u32 gid
// components is interpretation-neutral and no cast surface is needed. The
// fixed view is baked as Q12 literals (broadcast params are M5): 512x512,
// re in [-2.0, 1.0), im in [-1.5, 1.5), step 24 = 3.0*4096/512.
//
// Shape discipline (proven by M0's escape_time_u32.fe at the u32 word):
//   - continue-condition compare (`mag < 67108864`, i.e. 4.0 in Q24), signed
//     Slt, with the early `return i` in the else arm;
//   - every compare keeps the VARIABLE on the LEFT and a literal on the right
//     (a variable as the second compare operand is slot-copied out of R1);
//   - the *2 is a Mul (literal on the right, M0's `acc * 3` pattern), so no
//     Shl is needed anywhere.
pub fn mandel_pixel_q12(px: i32, py: i32) -> u32 {
    let c_re: i32 = -8192 + px * 24
    let c_im: i32 = -6144 + py * 24
    let mut zr: i32 = 0
    let mut zi: i32 = 0
    let mut i: u32 = 0
    while i < 100 {
        let rr: i32 = zr * zr
        let ii: i32 = zi * zi
        let mag: i32 = rr + ii
        if mag < 67108864 {
            let t: i32 = rr - ii
            let nzi: i32 = ((zr * 2) * zi) >> 12
            zr = (t >> 12) + c_re
            zi = nzi + c_im
            i = i + 1
        } else {
            return i
        }
    }
    i
}
