        let sphere: MvTF<5> = NdF { a: NdF { a: NdF { a: NdF { a: NdF { a: ScF { s: zero }, b: ScF { s: inv_cx } }, b: NdF { a: ScF { s: inv_cy }, b: ScF { s: zero } } }, b: NdF { a: NdF { a: ScF { s: zero }, b: ScF { s: zero } }, b: NdF { a: ScF { s: zero }, b: ScF { s: zero } } } }, b: NdF { a: NdF { a: NdF { a: ScF { s: sphere_e4 }, b: ScF { s: zero } }, b: NdF { a: ScF { s: zero }, b: ScF { s: zero } } }, b: NdF { a: NdF { a: ScF { s: zero }, b: ScF { s: zero } }, b: NdF { a: ScF { s: zero }, b: ScF { s: zero } } } } }, b: NdF { a: NdF { a: NdF { a: NdF { a: ScF { s: sphere_e5 }, b: ScF { s: zero } }, b: NdF { a: ScF { s: zero }, b: ScF { s: zero } } }, b: NdF { a: NdF { a: ScF { s: zero }, b: ScF { s: zero } }, b: NdF { a: ScF { s: zero }, b: ScF { s: zero } } } }, b: NdF { a: NdF { a: NdF { a: ScF { s: zero }, b: ScF { s: zero } }, b: NdF { a: ScF { s: zero }, b: ScF { s: zero } } }, b: NdF { a: NdF { a: ScF { s: zero }, b: ScF { s: zero } }, b: NdF { a: ScF { s: zero }, b: ScF { s: zero } } } } } }
        let sandwich: MvTF<5> = sandwich_support_cl41(sphere, point)
        let raw_1: f32 = sandwich.a.a.a.a.b.s
        let raw_2: f32 = sandwich.a.a.a.b.a.s
        let raw_4: f32 = sandwich.a.a.b.a.a.s
        let raw_8: f32 = sandwich.a.b.a.a.a.s
        let raw_16: f32 = sandwich.b.a.a.a.a.s
        let weight: f32 = raw_16 - raw_8
        // The recurrence-derived raw vector obeys raw_xy = weight*c - (p-c),
        // with non-positive weight. Adjusting its center term along with the
        // clamped weight preserves the regularized homogeneous point exactly.
        let safe_weight: f32 = if weight > -0.0004 { -0.0004 } else { weight }
        let weight_adjust: f32 = safe_weight - weight
