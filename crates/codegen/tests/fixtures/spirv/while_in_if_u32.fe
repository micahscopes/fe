// A loop nested inside a conditional: a `while` inside an `if`. This is the
// structurizer shape dec's grade-guarded operator loops produce after full
// inlining (a while-accumulator inside `if index < half`), and the shape the
// SPIR-V emitter must support: a `Region::Loop` inside an `IfThenElse` arm.
//
// The `px` param keeps the gate non-constant, so the branch survives SCCP to
// the emitter rather than being folded away (unlike a constant gate). u32-only,
// overflow-free (acc <= 0+1+..+6 = 21), so it lands in the browser word.
pub fn while_in_if_u32(px: i32, py: i32) -> u32 {
    let mut acc: u32 = 0
    if px < 128 {
        let mut i: u32 = 0
        while i < 7 {
            acc = acc + i
            i = i + 1
        }
    }
    acc + acc * 256 + acc * 65536 + 4278190080
}
