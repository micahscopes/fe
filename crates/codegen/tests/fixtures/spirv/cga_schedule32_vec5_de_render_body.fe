// Render body composed after the canonical Schedule<32> definitions in
// cga_schedule_ctfe_specialized_render.fe. The packager emits the composition as one
// standalone Fe source; this file deliberately owns no generated term table.

extern {
    fn __f32_from_i32(_: i32) -> f32
    fn __sqrt_f32(_: f32) -> f32
}

struct Vec5 { e1: f32, e2: f32, e4: f32, e8: f32, e16: f32 }
impl Copy for Vec5 {}

// Ground the recursive sparse products once per DE sample. The typed schedule
// reads this ephemeral scalar cache through blade-specific traits; no runtime
// blade selector or repeated Storage<N>/Next<I> proof graph remains per Term.
struct Prepared {
    s1: f32, s2: f32, s8: f32, s16: f32,
    p1: f32, p2: f32, p4: f32, p8: f32, p16: f32,
}
impl Copy for Prepared {}

fn prepare(sphere: Sphere, point: Point) -> Prepared {
    Prepared {
        s1: coefficient<Here, Sphere>(value: sphere),
        s2: coefficient<Next<Here>, Sphere>(value: sphere),
        s8: coefficient<Next<Next<Here>>, Sphere>(value: sphere),
        s16: coefficient<Next<Next<Next<Here>>>, Sphere>(value: sphere),
        p1: coefficient<Here, Point>(value: point),
        p2: coefficient<Next<Here>, Point>(value: point),
        p4: coefficient<Next<Next<Here>>, Point>(value: point),
        p8: coefficient<Next<Next<Next<Here>>>, Point>(value: point),
        p16: coefficient<Next<Next<Next<Next<Here>>>>, Point>(value: point),
    }
}

trait PreparedSphereCoefficient { fn read(value: Prepared) -> f32 }
impl PreparedSphereCoefficient for Blade<1> {
    fn read(value: Prepared) -> f32 { value.s1 }
}
impl PreparedSphereCoefficient for Blade<2> {
    fn read(value: Prepared) -> f32 { value.s2 }
}
impl PreparedSphereCoefficient for Blade<8> {
    fn read(value: Prepared) -> f32 { value.s8 }
}
impl PreparedSphereCoefficient for Blade<16> {
    fn read(value: Prepared) -> f32 { value.s16 }
}

trait PreparedPointCoefficient { fn read(value: Prepared) -> f32 }
impl PreparedPointCoefficient for Blade<1> {
    fn read(value: Prepared) -> f32 { value.p1 }
}
impl PreparedPointCoefficient for Blade<2> {
    fn read(value: Prepared) -> f32 { value.p2 }
}
impl PreparedPointCoefficient for Blade<4> {
    fn read(value: Prepared) -> f32 { value.p4 }
}
impl PreparedPointCoefficient for Blade<8> {
    fn read(value: Prepared) -> f32 { value.p8 }
}
impl PreparedPointCoefficient for Blade<16> {
    fn read(value: Prepared) -> f32 { value.p16 }
}

trait Eval5 {
    fn eval5(prepared: Prepared) -> Vec5
}

#[inline(always)]
fn add5(_ a: Vec5, _ b: Vec5) -> Vec5 {
    Vec5 {
        e1: a.e1 + b.e1,
        e2: a.e2 + b.e2,
        e4: a.e4 + b.e4,
        e8: a.e8 + b.e8,
        e16: a.e16 + b.e16,
    }
}

impl Eval5 for Zero {
    #[inline(always)]
    fn eval5(prepared: Prepared) -> Vec5 {
        Vec5 { e1: 0.0, e2: 0.0, e4: 0.0, e8: 0.0, e16: 0.0 }
    }
}

impl<
    const L: i32, const P: i32, const R: i32,
    const O: i32, const M: i32, const N: i32,
> Eval5 for Term<L, P, R, O, M, N>
    where Blade<L>: PreparedSphereCoefficient,
          Blade<P>: PreparedPointCoefficient,
          Blade<R>: PreparedSphereCoefficient,
{
    #[inline(always)]
    fn eval5(prepared: Prepared) -> Vec5 {
        let product: f32 =
            <Blade<L> as PreparedSphereCoefficient>::read(value: prepared)
            * <Blade<P> as PreparedPointCoefficient>::read(value: prepared)
            * <Blade<R> as PreparedSphereCoefficient>::read(value: prepared)
        let scaled: f32 = if M == 1 { product } else { product + product }
        let signed: f32 = if N == 0 { scaled } else { -scaled }
        Vec5 {
            e1: if O == 1 { signed } else { 0.0 },
            e2: if O == 2 { signed } else { 0.0 },
            e4: if O == 4 { signed } else { 0.0 },
            e8: if O == 8 { signed } else { 0.0 },
            e16: if O == 16 { signed } else { 0.0 },
        }
    }
}

impl<L: Eval5, R: Eval5> Eval5 for Add<L, R> {
    #[inline(always)]
    fn eval5(prepared: Prepared) -> Vec5 {
        add5(
            <L as Eval5>::eval5(prepared: prepared),
            <R as Eval5>::eval5(prepared: prepared),
        )
    }
}

#[inline(always)]
fn eval_specialized(prepared: Prepared) -> Vec5 {
    // Four typed chunk roots keep compiler normalization bounded while
    // preserving the canonical Schedule32 term set per DE sample.
    add5(
        add5(
            <ScheduleChunk24<8> as Eval5>::eval5(prepared: prepared),
            <ScheduleChunk16<8> as Eval5>::eval5(prepared: prepared),
        ),
        add5(
            <ScheduleChunk8<8> as Eval5>::eval5(prepared: prepared),
            <ScheduleChunk0<8> as Eval5>::eval5(prepared: prepared),
        ),
    )
}

pub fn cga_schedule32_vec5_de_render(
    px: i32,
    py: i32,
    cam_x: f32,
    cam_y: f32,
    zoom: f32,
    inv_cx: f32,
    inv_cy: f32,
) -> u32 {
    let fx: f32 = __f32_from_i32(px)
    let fy: f32 = __f32_from_i32(py)
    let sx: f32 = (fx - 64.0) * zoom
    let sy: f32 = (fy - 64.0) * zoom
    let rz: f32 = 1.8
    let inv_len: f32 = 1.0 / __sqrt_f32(sx * sx + sy * sy + rz * rz)
    let rdx: f32 = sx * inv_len
    let rdy: f32 = sy * inv_len
    let rdz: f32 = rz * inv_len

    let mut t: f32 = 0.0
    let mut i: i32 = 0
    while i < 72 {
        let x: f32 = cam_x + rdx * t
        let y: f32 = cam_y + rdy * t
        let z: f32 = -4.0 + rdz * t
        let radius2: f32 = x * x + y * y + z * z
        let center2: f32 = inv_cx * inv_cx + inv_cy * inv_cy
        let point: Point = Cell {
            head: x,
            tail: Cell {
                head: y,
                tail: Cell {
                    head: z,
                    tail: Cell {
                        head: (radius2 - 1.0) * 0.5,
                        tail: Cell {
                            head: (radius2 + 1.0) * 0.5,
                            tail: Nil {},
                        },
                    },
                },
            },
        }
        let sphere: Sphere = Cell {
            head: inv_cx,
            tail: Cell {
                head: inv_cy,
                tail: Cell {
                    head: center2 * 0.5 - 1.0,
                    tail: Cell { head: center2 * 0.5, tail: Nil {} },
                },
            },
        }

        // FOUR_CHUNK_TYPED_EVALUATION: four depth-8 typed roots preserve the
        // canonical Schedule<32> order and are balanced into all five lanes.
        let prepared: Prepared = prepare(sphere: sphere, point: point)
        let sandwich: Vec5 = eval_specialized(prepared: prepared)
        let weight: f32 = sandwich.e16 - sandwich.e8
        let safe_weight: f32 = if weight > -0.0004 { -0.0004 } else { weight }
        let weight_adjust: f32 = safe_weight - weight
        let qx: f32 = (sandwich.e1 + weight_adjust * inv_cx) / safe_weight
        let qy: f32 = (sandwich.e2 + weight_adjust * inv_cy) / safe_weight
        let qz: f32 = sandwich.e4 / safe_weight

        let tx: f32 = qx + 0.62
        let ty: f32 = qy - 0.08
        let ring_radius: f32 = __sqrt_f32(tx * tx + ty * ty) - 0.58
        let base: f32 = __sqrt_f32(ring_radius * ring_radius + qz * qz) - 0.17
        let distance: f32 = base * -safe_weight
        t = t + distance * 0.18
        if distance < 0.0022 {
            let shade: i32 = 38 + 24 * (i >> 3)
            if qy > 0.0 {
                return __bitcast(shade + 88 * 256 + (255 - shade) * 65536 + -16777216)
            }
            return __bitcast(56 + shade * 256 + 224 * 65536 + -16777216)
        }
        i = i + 1
    }
    let sky_color: i32 = 7 + 11 * 256 + 25 * 65536 + -16777216
    __bitcast(sky_color)
}
