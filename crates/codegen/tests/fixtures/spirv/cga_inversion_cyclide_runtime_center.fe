// Experimental scalarized CGA inversion study, not the recursive D2 product.
//
// A unit inversion sphere has a runtime center (inv_cx, inv_cy, 0). The target
// SDF is an offset torus. Its inverse is a cyclide-like surface whose bent ring,
// displaced opening, and changing upper/lower palette make the conformal
// distortion visually explicit. Default study values are inv_cx=0.5,
// inv_cy=0.0. The tiny exclusion ball around the inversion singularity keeps
// interactive center motion finite.
extern {
    fn __f32_from_i32(_: i32) -> f32
    fn __sqrt_f32(_: f32) -> f32
    const fn __bitcast<From, To>(_: From) -> To
}

pub fn cga_inversion_cyclide_runtime_center(
    px: i32,
    py: i32,
    cam_x: f32,
    cam_y: f32,
    zoom: f32,
    inv_cx: f32,
    inv_cy: f32,
) -> u32 {
    let fx: f32 = __f32_from_i32(px)
    let fy: f32 = __f32_from_i32(py)
    let sx: f32 = (fx - 64.0) * zoom
    let sy: f32 = (fy - 64.0) * zoom
    let rz: f32 = 1.8
    let inv_len: f32 = 1.0 / __sqrt_f32(sx * sx + sy * sy + rz * rz)
    let rdx: f32 = sx * inv_len
    let rdy: f32 = sy * inv_len
    let rdz: f32 = rz * inv_len

    let mut t: f32 = 0.0
    let mut i: i32 = 0
    while i < 72 {
        let x: f32 = cam_x + rdx * t
        let y: f32 = cam_y + rdy * t
        let z: f32 = -4.0 + rdz * t

        let vx: f32 = x - inv_cx
        let vy: f32 = y - inv_cy
        let rho2: f32 = vx * vx + vy * vy + z * z
        let safe_rho2: f32 = if rho2 < 0.0004 { 0.0004 } else { rho2 }

        // Normalized unit-sphere inversion q=c+(p-c)/|p-c|^2.
        let qx: f32 = inv_cx + vx / safe_rho2
        let qy: f32 = inv_cy + vy / safe_rho2
        let qz: f32 = z / safe_rho2

        // Offset torus in target space. Inversion produces the cyclide study.
        let tx: f32 = qx + 0.62
        let ty: f32 = qy - 0.08
        let ring_radius: f32 = __sqrt_f32(tx * tx + ty * ty) - 0.58
        let base: f32 = __sqrt_f32(ring_radius * ring_radius + qz * qz) - 0.17
        let distance: f32 = base * safe_rho2

        // Conservative stepping handles the strong curvature near the neck.
        t = t + distance * 0.18
        if distance < 0.0022 {
            let shade: i32 = 38 + i * 3
            let upper: bool = qy > 0.0
            if upper {
                let upper_color: i32 = shade + 88 * 256 + (255 - shade) * 65536 + -16777216
                return __bitcast(upper_color)
            }
            let lower_color: i32 = 56 + shade * 256 + 224 * 65536 + -16777216
            return __bitcast(lower_color)
        }
        i = i + 1
    }
    let sky_color: i32 = 7 + 11 * 256 + 25 * 65536 + -16777216
    __bitcast(sky_color)
}
