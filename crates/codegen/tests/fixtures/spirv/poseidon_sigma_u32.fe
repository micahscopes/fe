// browser keystone - single function, Add/Mul only, all values < 2^32
pub fn poseidon_sigma_u32() -> u32 {
    let a0: u32 = 1
    let s0: u32 = a0 + 13
    let a1: u32 = s0 * s0 + s0     // c=13   -> 210
    let s1: u32 = a1 + 41
    let a2: u32 = s1 * s1 + s1     // c=41   -> 63252
    let s2: u32 = a2 + 2026
    let a3: u32 = s2 * s2 + s2     // c=2026 -> 4261282562
    a3
}
