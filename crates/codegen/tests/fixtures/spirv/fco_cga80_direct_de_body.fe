extern {
    fn __f32_from_i32(_: i32) -> f32
    fn __sqrt_f32(_: f32) -> f32
    const fn __bitcast<From, To>(_: From) -> To
}

// Semantic sparse Cl(4,1) values. Their fields are exactly the compact support
// consumed by the specialized S*P*S kernel; callers do not construct or order
// raw coefficient tuples.
pub fn cga_schedule32_vec5_de_render(
    px: i32,
    py: i32,
    cam_x: f32,
    cam_y: f32,
    zoom: f32,
    inv_cx: f32,
    inv_cy: f32,
) -> u32 {
    let fx: f32 = __f32_from_i32(px)
    let fy: f32 = __f32_from_i32(py)
    let sx: f32 = (fx - 64.0) * zoom
    let sy: f32 = (fy - 64.0) * zoom
    let rz: f32 = 1.8
    let inv_len: f32 = 1.0 / __sqrt_f32(sx * sx + sy * sy + rz * rz)
    let rdx: f32 = sx * inv_len
    let rdy: f32 = sy * inv_len
    let rdz: f32 = rz * inv_len
    let center2: f32 = inv_cx * inv_cx + inv_cy * inv_cy
    let sphere: ConformalSphere = ConformalSphere {
        e1: inv_cx,
        e2: inv_cy,
        e4: 0.0,
        e8: center2 * 0.5 - 1.0,
        e16: center2 * 0.5,
    }

    let mut t: f32 = 0.0
    let mut i: i32 = 0
    while i < 72 {
        let x: f32 = cam_x + rdx * t
        let y: f32 = cam_y + rdy * t
        let z: f32 = -4.0 + rdz * t
        let radius2: f32 = x * x + y * y + z * z
        let point: ConformalPoint = ConformalPoint {
            e1: x,
            e2: y,
            e4: z,
            e8: (radius2 - 1.0) * 0.5,
            e16: (radius2 + 1.0) * 0.5,
        }

        // All five lanes are provider-emitted straight-line arithmetic derived
        // from the same canonical 80-candidate Fe helpers as Schedule32.
        let image: ConformalVector =
            <ConformalVector as Sandwich>::sandwich(sphere, point)

        let weight: f32 = image.e16 - image.e8
        let safe_weight: f32 = if weight > -0.0004 { -0.0004 } else { weight }
        let weight_adjust: f32 = safe_weight - weight
        let qx: f32 = (image.e1 + weight_adjust * inv_cx) / safe_weight
        let qy: f32 = (image.e2 + weight_adjust * inv_cy) / safe_weight
        let qz: f32 = image.e4 / safe_weight

        let tx: f32 = qx + 0.62
        let ty: f32 = qy - 0.08
        let ring_radius: f32 = __sqrt_f32(tx * tx + ty * ty) - 0.58
        let base: f32 = __sqrt_f32(ring_radius * ring_radius + qz * qz) - 0.17
        let distance: f32 = base * -safe_weight
        t = t + distance * 0.18
        if distance < 0.0022 {
            let shade: i32 = 38 + 24 * (i >> 3)
            if qy > 0.0 {
                return __bitcast(shade + 88 * 256 + (255 - shade) * 65536 + -16777216)
            }
            return __bitcast(56 + shade * 256 + 224 * 65536 + -16777216)
        }
        i = i + 1
    }
    let sky: i32 = 7 + 11 * 256 + 25 * 65536 + -16777216
    __bitcast(sky)
}
