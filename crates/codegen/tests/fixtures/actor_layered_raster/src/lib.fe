//! A fullscreen Fe pass followed by a small authored raster overlay. Source
//! order is the complete composition policy; no pass-name table or JSON blend
//! flag accompanies this actor.

use std::webgpu::{
    ClipPosition,
    FragmentStage,
    FragmentSurface,
    GpuProgram,
    Depth24LessEqualMsaa4,
    RasterConfiguration,
    RasterPlan,
    RasterVertex,
    SurfaceBackingExtent,
    SurfaceQuality,
    SurfaceQualityFacts,
    TriangleList,
    VertexStage,
    WebGpuBackend,
    raster_plan,
}

struct OverlayVarying { heat: f32 }
impl Copy for OverlayVarying {}

struct Offset { x: f32, y: f32 }
impl Copy for Offset {}

struct OverlayGeometry { lower: Offset, upper: Offset }
impl Copy for OverlayGeometry {}

/// A deliberately fixture-local policy with a non-reserved method name. Its
/// distinct arithmetic proves actor construction selects policy by Fe type
/// and semantic record shape rather than recognizing `ResponsiveBacking`.
struct HalfDeclaredBacking {}
impl HalfDeclaredBacking {
    pub fn decide_fixture(_ facts: own SurfaceQualityFacts) -> SurfaceBackingExtent {
        SurfaceBackingExtent {
            width: facts.declared_width * 0.5,
            height: facts.declared_height * 0.5,
        }
    }
}

actor LayeredSurface uses (
    GpuProgram<WebGpuBackend>, SurfaceQuality<HalfDeclaredBacking>,
) {
    tint: f32,
    geometry: OverlayGeometry,

    const fn raster_fixture() -> RasterPlan uses (RasterConfiguration) {
        raster_plan<Depth24LessEqualMsaa4>()
    }

    fn background(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        if px + py > 0 && self.tint + self.geometry.lower.x >= 0.0 {
            -15720400
        } else { 0 }
    }

    fn overlay_vertices(self, vertex_index: u32) -> RasterVertex<OverlayVarying>
        uses (VertexStage<OverlayVarying, TriangleList<6>>)
    {
        let corner: u32 = vertex_index % 6
        let mut x: f32 = self.geometry.lower.x
        let mut y: f32 = self.geometry.lower.y
        if corner == 1 { x = self.geometry.upper.x }
        if corner == 2 { y = self.geometry.upper.y }
        if corner == 3 { y = self.geometry.upper.y }
        if corner == 4 { x = self.geometry.upper.x }
        if corner == 5 {
            x = self.geometry.upper.x
            y = self.geometry.upper.y
        }
        RasterVertex {
            position: ClipPosition { x: x, y: y, z: 0.0, w: 1.0 },
            varying: OverlayVarying { heat: self.tint },
        }
    }

    fn overlay_fragment(self, varying: OverlayVarying) -> u32
        uses (FragmentStage<OverlayVarying>)
    {
        if varying.heat + self.tint > 1.0 { 4294901760 } else { 4278190335 }
    }
}
