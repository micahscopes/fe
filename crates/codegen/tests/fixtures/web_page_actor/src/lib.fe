use std::web::page::{
    ComponentComposition, ComponentView, Page, PageAttribute, PageBuilder,
    PageComposition, PageElement, PageText,
}
use std::web::identity::{ComponentAction, ComponentActionProvider}

enum FixtureAction {
    Unknown,
    Close,
    InspectWgsl,
    InspectWasm,
    InspectManifest,
}

impl Copy for FixtureAction {}

derive ComponentAction for FixtureAction using ComponentActionProvider

actor GalleryPage {
    version: u32,

    const fn compose() -> Page<10> uses (PageComposition) {
        PageBuilder::new()
            .open(element: PageElement::Main)
            .attribute(value: PageAttribute::id(value: "gallery"))
            .attribute(value: PageAttribute::hidden())
            .open(element: PageElement::Heading1)
            .text(value: PageText::one(value: "Hello <Fe>"))
            .close()
            .render_sequenced(
                source: PageText::one(value: "sketches/gradient"),
                wgsl_action: FixtureAction::InspectWgsl,
                wasm_action: FixtureAction::InspectWasm,
                manifest_action: FixtureAction::InspectManifest,
            )
            .render_sequenced(
                source: PageText::one(value: "sketches/plasma"),
                wgsl_action: FixtureAction::InspectWgsl,
                wasm_action: FixtureAction::InspectWasm,
                manifest_action: FixtureAction::InspectManifest,
            )
            .component(
                source: PageText::one(value: "sketches/todomvc/src/lib.fe"),
                mount: "todo-app",
            )
            .close()
            .finish(title: PageText::one(value: "Fe page"))
    }
}

actor TodoComponent {
    version: u32,

    const fn view() -> ComponentView<16> uses (ComponentComposition) {
        PageBuilder::new()
            .open(element: PageElement::Label)
            .attribute(value: PageAttribute::local_for(value: "toggle-all"))
            .text(value: PageText::one(value: "Toggle all"))
            .close()
            .open(element: PageElement::Input)
            .attribute(value: PageAttribute::local_id(value: "toggle-all"))
            .close()
            .accessible_icon_button(
                action: FixtureAction::Close,
                class: "close",
                label: "Close inspector",
                icon: "x",
            )
            .finish_component()
    }
}
