use std::web::page::{
    ComponentComposition, ComponentView, Page, PageAttribute, PageComposition,
    PageElement, PageOp, PageText,
}

actor GalleryPage {
    version: u32,

    const fn compose() -> Page<9> uses (PageComposition) {
        Page::exact(
            title: PageText::one(value: "Fe page"),
            body: [
                PageOp::open(element: PageElement::Main),
                PageOp::attribute(value: PageAttribute::id(value: "gallery")),
                PageOp::attribute(value: PageAttribute::hidden()),
                PageOp::open(element: PageElement::Heading1),
                PageOp::text(value: PageText::one(value: "Hello <Fe>")),
                PageOp::close(),
                PageOp::render(
                    source: PageText::one(value: "sketches/gradient"),
                    wgsl_action: 101,
                    wasm_action: 102,
                    manifest_action: 103,
                ),
                PageOp::component(
                    source: PageText::one(value: "sketches/todomvc/src/lib.fe"),
                    mount: "todo-app",
                ),
                PageOp::close(),
            ],
        )
    }
}

actor TodoComponent {
    version: u32,

    const fn view() -> ComponentView<7> uses (ComponentComposition) {
        ComponentView::exact(body: [
            PageOp::open(element: PageElement::Label),
            PageOp::attribute(value: PageAttribute::local_for(value: "toggle-all")),
            PageOp::text(value: PageText::one(value: "Toggle all")),
            PageOp::close(),
            PageOp::open(element: PageElement::Input),
            PageOp::attribute(value: PageAttribute::local_id(value: "toggle-all")),
            PageOp::close(),
        ])
    }
}
