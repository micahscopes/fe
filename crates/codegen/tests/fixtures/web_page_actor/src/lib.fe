use std::web::page::{
    ComponentComposition, ComponentView, Page, PageAttribute, PageBuilder,
    PageComposition, PageElement, PageOp, PageText,
}

actor GalleryPage {
    version: u32,

    const fn compose() -> Page<10> uses (PageComposition) {
        PageBuilder::new()
            .open(element: PageElement::Main)
            .attribute(value: PageAttribute::id(value: "gallery"))
            .attribute(value: PageAttribute::hidden())
            .open(element: PageElement::Heading1)
            .text(value: PageText::one(value: "Hello <Fe>"))
            .close()
            .render_sequenced(
                source: PageText::one(value: "sketches/gradient"),
                wgsl_action: 101,
                wasm_action: 102,
                manifest_action: 103,
            )
            .render_sequenced(
                source: PageText::one(value: "sketches/plasma"),
                wgsl_action: 101,
                wasm_action: 102,
                manifest_action: 103,
            )
            .component(
                source: PageText::one(value: "sketches/todomvc/src/lib.fe"),
                mount: "todo-app",
            )
            .close()
            .finish(title: PageText::one(value: "Fe page"))
    }
}

actor TodoComponent {
    version: u32,

    const fn view() -> ComponentView<7> uses (ComponentComposition) {
        ComponentView::exact(body: [
            PageOp::open(element: PageElement::Label),
            PageOp::attribute(value: PageAttribute::local_for(value: "toggle-all")),
            PageOp::text(value: PageText::one(value: "Toggle all")),
            PageOp::close(),
            PageOp::open(element: PageElement::Input),
            PageOp::attribute(value: PageAttribute::local_id(value: "toggle-all")),
            PageOp::close(),
        ])
    }
}
