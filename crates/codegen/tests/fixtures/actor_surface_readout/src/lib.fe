use core::actor::InitialState
use core::marker::Copy
use std::web::view::{Param,ParamReadout,Surface,Extent,SurfaceState,SurfaceEvent,ApplyParamBindings,ParamBindingsProvider}
use std::webgpu::{GpuProgram,WebGpuBackend,FragmentSurface,SurfaceTransition}
struct Controls {request:f32}
impl Copy for Controls {}
struct Params {request:Param,resolved:Param}
impl SurfaceState for Controls {type Params=Params}
derive ApplyParamBindings for Controls using ParamBindingsProvider
const fn params()->Params {
    Params {request:Param::range(min:0.0,max:8.0,init:2.0),resolved:Param::readout(ParamReadout::Integer)}
}
struct State {controls:Controls,resolved:u32}
actor ObservedSurface uses (GpuProgram<WebGpuBackend>) {
    controls:Controls,resolved:u32,
    const fn view()->Surface<Params> {Surface {extent:Extent::square(32),params:params()}}
    fn initial()->State uses (InitialState) {State {controls:Controls {request:2.0},resolved:4}}
    fn control(self,event:own SurfaceEvent)->State uses (SurfaceTransition) {
        State {controls:self.controls.apply_param_bindings(params(),event),resolved:self.resolved}
    }
    fn shade(self,x:i32,y:i32)->i32 uses (FragmentSurface) {-1}
}
