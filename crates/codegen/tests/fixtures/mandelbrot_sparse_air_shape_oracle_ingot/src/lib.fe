//! Executable boundary for the structurally derived sparse AIR shape.

use mandelbrot_proof_fixed_air_baby_bear::{
    SPARSE_BASE_AIR_FIELDS,
    SPARSE_INTERACTION_AIR_FIELDS,
    SparseCopyPortDegreeShape,
    sparse_all_rows_degree_shape,
    sparse_pair_rows_degree_shape,
    sparse_boundary_port_degree_shape,
    sparse_composition_degree_bound,
    sparse_constraint_shape,
    sparse_linear_port_degree_shape,
    sparse_round_port_degree_shape,
}

const PRODUCTION_TRACE_LENGTH: u32 = 4096

pub fn sparse_air_field_widths() -> (u32, u32) {
    (
        SPARSE_BASE_AIR_FIELDS.downcast_truncate(),
        SPARSE_INTERACTION_AIR_FIELDS.downcast_truncate(),
    )
}

pub fn sparse_air_shape_l4() -> (u32, u32, u32, u32, u32) {
    let shape = sparse_constraint_shape<4>()
    (
        shape.all_rows,
        shape.pair_rows,
        shape.first_row,
        shape.last_row,
        shape.total,
    )
}

pub fn sparse_air_degree_shape_l4() -> [u32; 9] {
    let shape = sparse_constraint_shape<4>()
    [
        if shape.valid { 1 } else { 0 },
        shape.all_rows_degree,
        shape.pair_rows_degree,
        shape.first_row_degree,
        shape.last_row_degree,
        shape.maximum_degree,
        sparse_composition_degree_bound(shape, PRODUCTION_TRACE_LENGTH),
        shape.total,
        if (sparse_composition_degree_bound(
            shape,
            PRODUCTION_TRACE_LENGTH,
        ) < PRODUCTION_TRACE_LENGTH) { 1 } else { 0 },
    ]
}

pub fn sparse_air_all_rows_degree_shape_l4() -> [u32; 8] {
    let shape = sparse_all_rows_degree_shape<4>()
    [
        if shape.valid { 1 } else { 0 },
        shape.control,
        shape.arithmetic,
        shape.product,
        shape.round,
        shape.linear,
        shape.boundary,
        shape.maximum,
    ]
}

pub fn sparse_air_pair_rows_degree_shape_l4() -> [u32; 8] {
    let shape = sparse_pair_rows_degree_shape<4>()
    [
        if shape.valid { 1 } else { 0 },
        shape.control,
        shape.arithmetic,
        shape.product,
        shape.round,
        shape.linear,
        shape.boundary,
        shape.maximum,
    ]
}

fn copy_port_shape_words(
    _ shape: SparseCopyPortDegreeShape,
) -> [u32; 9] {
    [
        if shape.valid { 1 } else { 0 },
        shape.selector,
        shape.coefficient,
        shape.address,
        shape.value,
        shape.compressed,
        shape.inverse_relation,
        shape.delta,
        shape.maximum,
    ]
}

pub fn sparse_round_port_degree_shape_l4(_ index: u32) -> [u32; 9] {
    copy_port_shape_words(sparse_round_port_degree_shape<4>(index))
}

pub fn sparse_linear_port_degree_shape_l4(_ index: u32) -> [u32; 9] {
    copy_port_shape_words(sparse_linear_port_degree_shape<4>(index))
}

pub fn sparse_boundary_port_degree_shape_l4(_ index: u32) -> [u32; 9] {
    copy_port_shape_words(sparse_boundary_port_degree_shape<4>(index))
}
