// Reusable finite sparse-operator plan vocabulary.
//
// A domain planner supplies its own CTFE candidate enumeration and constructs
// a ground `Add<Term<Candidate>, ... Zero>` tree.  This fragment deliberately
// owns only the shared representation and its exact structural-length witness;
// it does not prescribe a metric, support encoding, survivor ordering, or
// evaluator.

struct Zero {}
struct Term<const Candidate: usize> {}
struct Add<L, R> {}

struct NatZ {}
struct NatS<N> {}

recursive type fn Nat<const N: usize>() -> (*) {
    match N {
        0 => NatZ
        _ => NatS<Nat<{N - 1}>>
    }
}

trait PlanLength { type Out }

impl PlanLength for Zero {
    type Out = NatZ
}

impl<const Candidate: usize, Tail: PlanLength> PlanLength
    for Add<Term<Candidate>, Tail>
{
    type Out = NatS<<Tail as PlanLength>::Out>
}
