// Dimension-independent semantic checks: vectors in Cl(3) multiply into
// scalar+bivector support, and grade projection removes the scalar.
const VECTORS3: BladeSet = blade_set(22, 3)
const VECTOR_GP3: BladeSet = support_gp(VECTORS3, VECTORS3, 7)
const BIVECTORS3: BladeSet = support_grade(VECTOR_GP3, 2)
static_assert(support_dimension_valid(5))
static_assert(!support_dimension_valid(6))
static_assert(VECTOR_GP3.bits == 105)
static_assert(BIVECTORS3.bits == 104)
static_assert(support_cardinality(BIVECTORS3) == 3)

// Degenerate metric check: e3*e3 has no support when e3 squares to zero.
const E3: BladeSet = blade_set(16, 3)
static_assert(support_gp(E3, E3, 3).bits == 0)

// Ground probes force the support algebra through CTFE. The exported selector
// contains only constants; no dense or bitset support interpreter reaches
// runtime code.
const CASE0: u32 = support_gp(blade_set(22, 3), blade_set(22, 3), 7).bits
const CASE1: u32 = support_gp(blade_set(146, 3), blade_set(73, 3), 7).bits
const CASE2: u32 =
    support_gp(blade_set(65814, 5), blade_set(65798, 5), 31).bits
const CASE3: u32 = support_gp(blade_set(16, 3), blade_set(16, 3), 3).bits
const CASE4: u32 = support_gp(blade_set(255, 3), blade_set(255, 3), 0).bits
const CASE5: u32 = support_grade(blade_set(105, 3), 2).bits
const CASE6: u32 = support_grade(blade_set(4294967295, 5), 1).bits
const CASE7: u32 = support_grade(blade_set(65798, 5), 1).bits
const CASE8: u32 = support_grade(blade_set(255, 3), 4).bits
const CASE9: u32 = support_grade(blade_set(4294967295, 6), 1).bits

pub fn support_ctfe_case(index: u32) -> u32 {
    match index {
        0 => CASE0
        1 => CASE1
        2 => CASE2
        3 => CASE3
        4 => CASE4
        5 => CASE5
        6 => CASE6
        7 => CASE7
        8 => CASE8
        _ => CASE9
    }
}
