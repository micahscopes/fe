// Reusable, fixed-capacity sparse support algebra for diagonal Clifford
// metrics. A support bit at position B denotes basis blade mask B.
//
// The portable bound is five basis vectors: 2^5 basis blades fit exactly in
// an explicit `u32` shared by Wasm and SPIR-V. Operations fail closed to the
// empty set when asked for a larger dimension. Callers can pin the bound with
// `static_assert(support_dimension_valid(...))`.

struct BladeSet {
    bits: u32,
    dimension: u32,
}
impl Copy for BladeSet {}

const fn support_dimension_valid(_ dimension: u32) -> bool {
    dimension < 6
}

const fn support_capacity_mask(_ dimension: u32) -> u32 {
    match dimension {
        0 => 1
        1 => 3
        2 => 15
        3 => 255
        4 => 65535
        5 => 4294967295
        _ => 0
    }
}

const fn blade_set(_ bits: u32, _ dimension: u32) -> BladeSet {
    BladeSet {
        bits: bits & support_capacity_mask(dimension),
        dimension: dimension,
    }
}

const fn support_contains(_ support: BladeSet, _ blade: u32) -> bool {
    if !support_dimension_valid(support.dimension) {
        return false
    }
    if blade >= (1 << support.dimension) {
        return false
    }
    ((support.bits >> blade) & 1) == 1
}

const fn blade_grade(_ blade: u32) -> u32 {
    let mut value: u32 = blade
    let mut count: u32 = 0
    while 0 < value {
        count = count + (value & 1)
        value = value >> 1
    }
    count
}

const fn support_grade(_ support: BladeSet, _ grade: u32) -> BladeSet {
    if !support_dimension_valid(support.dimension) {
        return blade_set(0, support.dimension)
    }
    let blade_count: u32 = 1 << support.dimension
    let mut blade: u32 = 0
    let mut bits: u32 = 0
    while blade < blade_count {
        if support_contains(support, blade) && blade_grade(blade) == grade {
            bits = bits | (1 << blade)
        }
        blade = blade + 1
    }
    blade_set(bits, support.dimension)
}

// Candidate support for a geometric product in an orthogonal basis.
// `nonzero_square_generators` has one bit per basis generator. A shared
// generator whose square is zero annihilates that blade pair. Signs and
// coefficient cancellation do not affect this conservative support operation;
// exact cancellation belongs to the subsequent coefficient normalizer.
const fn support_gp(
    _ left: BladeSet,
    _ right: BladeSet,
    _ nonzero_square_generators: u32,
) -> BladeSet {
    if left.dimension == right.dimension {
    } else {
        return blade_set(0, left.dimension)
    }
    if !support_dimension_valid(left.dimension) {
        return blade_set(0, left.dimension)
    }
    let blade_count: u32 = 1 << left.dimension
    let mut l: u32 = 0
    let mut output: u32 = 0
    while l < blade_count {
        if support_contains(left, l) {
            let mut r: u32 = 0
            while r < blade_count {
                if support_contains(right, r) {
                    let shared: u32 = l & r
                    if (shared & nonzero_square_generators) == shared {
                        output = output | (1 << (l ^ r))
                    }
                }
                r = r + 1
            }
        }
        l = l + 1
    }
    blade_set(output, left.dimension)
}

const fn support_cardinality(_ support: BladeSet) -> u32 {
    let mut value: u32 = support.bits
    let mut count: u32 = 0
    while 0 < value {
        count = count + (value & 1)
        value = value >> 1
    }
    count
}

// Dimension-independent semantic checks: vectors in Cl(3) multiply into
// scalar+bivector support, and grade projection removes the scalar.
const VECTORS3: BladeSet = blade_set(22, 3)
const VECTOR_GP3: BladeSet = support_gp(VECTORS3, VECTORS3, 7)
const BIVECTORS3: BladeSet = support_grade(VECTOR_GP3, 2)
static_assert(support_dimension_valid(5))
static_assert(!support_dimension_valid(6))
static_assert(VECTOR_GP3.bits == 105)
static_assert(BIVECTORS3.bits == 104)
static_assert(support_cardinality(BIVECTORS3) == 3)

// Degenerate metric check: e3*e3 has no support when e3 squares to zero.
const E3: BladeSet = blade_set(16, 3)
static_assert(support_gp(E3, E3, 3).bits == 0)

// Ground probes force the support algebra through CTFE. The exported selector
// contains only constants; no dense or bitset support interpreter reaches
// runtime code.
const CASE0: u32 = support_gp(blade_set(22, 3), blade_set(22, 3), 7).bits
const CASE1: u32 = support_gp(blade_set(146, 3), blade_set(73, 3), 7).bits
const CASE2: u32 =
    support_gp(blade_set(65814, 5), blade_set(65798, 5), 31).bits
const CASE3: u32 = support_gp(blade_set(16, 3), blade_set(16, 3), 3).bits
const CASE4: u32 = support_gp(blade_set(255, 3), blade_set(255, 3), 0).bits
const CASE5: u32 = support_grade(blade_set(105, 3), 2).bits
const CASE6: u32 = support_grade(blade_set(4294967295, 5), 1).bits
const CASE7: u32 = support_grade(blade_set(65798, 5), 1).bits
const CASE8: u32 = support_grade(blade_set(255, 3), 4).bits
const CASE9: u32 = support_grade(blade_set(4294967295, 6), 1).bits

pub fn support_ctfe_case(index: u32) -> u32 {
    match index {
        0 => CASE0
        1 => CASE1
        2 => CASE2
        3 => CASE3
        4 => CASE4
        5 => CASE5
        6 => CASE6
        7 => CASE7
        8 => CASE8
        _ => CASE9
    }
}
