use mandelbrot_proof_recursive_verifier_air_baby_bear::{
    BinaryMerklePathRelationInputs,
    MERKLE_NODE_ASSERTIONS,
    MERKLE_NODE_PRODUCTS,
    MerkleNodeRelationInputs,
    PRODUCTION_BASE_LEAF_PRODUCTS,
    PRODUCTION_INTERACTION_LEAF_PRODUCTS,
    PRODUCTION_LEAF_ASSERTIONS,
    ProductionBaseLdeLeafRelationInputs,
    ProductionInteractionLdeLeafRelationInputs,
    RECEIPT_HEADER_ASSERTIONS,
    RECEIPT_HEADER_PRODUCTS,
    ReceiptHeaderRelationInputs,
    derive_receipt_header_relation_auxiliary,
    binary_merkle_path_relation_plan,
    evaluate_merkle_node_relation,
    evaluate_receipt_header_relation,
    merkle_node_relation_residuals,
    merkle_node_relation_witness,
    production_base_lde_leaf_relation_plan,
    production_interaction_lde_leaf_relation_plan,
    receipt_header_relation_residuals,
    receipt_header_relation_witness,
}
use mandelbrot_proof_fixed_air_baby_bear::{
    SPARSE_BASE_AIR_FIELDS,
    SPARSE_INTERACTION_AIR_FIELDS,
}
use poseidon_baby_bear::Poseidon2Digest
use precision::baby_bear::BabyBear
use precision::polynomial::Radix2Field
use quadratic_plan::{
    QuadraticRelationConstraintInterpreter,
    QuadraticRelationStreamConstraintInterpreter,
    QuadraticRelationStreamInterpreter,
    QuadraticRelationValueInterpreter,
    QuadraticRelationWitnessInterpreter,
}

const PATH_DEPTH: usize = 4
const PATH_PRODUCTS: usize = PATH_DEPTH * MERKLE_NODE_PRODUCTS
const PATH_ASSERTIONS: usize = PATH_DEPTH + 9

fn flag(_ value: bool) -> u32 {
    if value { 1 } else { 0 }
}

fn as_bool(_ value: u32) -> BabyBear {
    BabyBear::from_u32(if value == 1 { 1 } else { 0 })
}

/// Exercise direct evaluation, witness generation, and constraint replay for
/// the exact receipt-header task. A nonzero mutation changes one committed
/// product after witness generation.
pub fn receipt_header_relation_audit(
    _ receipt_valid: u32,
    _ base_root_valid: u32,
    _ interaction_root_valid: u32,
    _ shift: u32,
    _ accepted: u32,
    _ trace_valid: u32,
    _ mutation: u32,
) -> (u32, u32, u32, u32, u32, u32) {
    let inputs = ReceiptHeaderRelationInputs {
        receipt_valid: as_bool(receipt_valid),
        base_root_valid: as_bool(base_root_valid),
        interaction_root_valid: as_bool(interaction_root_valid),
        shift: BabyBear::from_u32(shift),
        accepted: as_bool(accepted),
        trace_valid: as_bool(trace_valid),
    }
    let auxiliary = derive_receipt_header_relation_auxiliary(inputs)
    let mut witness = receipt_header_relation_witness(inputs)
    if mutation > 0 && mutation <= RECEIPT_HEADER_PRODUCTS.downcast_truncate() {
        let index = (mutation - 1) as usize
        witness.nodes[index] = witness.nodes[index] + BabyBear::one()
    }
    let residuals = receipt_header_relation_residuals(inputs, auxiliary, witness)
    let mut nonzero_products: u32 = 0
    let mut product: usize = 0
    while product < RECEIPT_HEADER_PRODUCTS {
        if !residuals.products[product].radix2_is_zero() {
            nonzero_products = nonzero_products + 1
        }
        product = product + 1
    }
    let mut nonzero_assertions: u32 = 0
    let mut assertion: usize = 0
    while assertion < RECEIPT_HEADER_ASSERTIONS {
        if !residuals.assertions[assertion].radix2_is_zero() {
            nonzero_assertions = nonzero_assertions + 1
        }
        assertion = assertion + 1
    }
    (
        flag(evaluate_receipt_header_relation(inputs)),
        flag(residuals.valid),
        nonzero_products,
        nonzero_assertions,
        RECEIPT_HEADER_PRODUCTS.downcast_truncate(),
        RECEIPT_HEADER_ASSERTIONS.downcast_truncate(),
    )
}

fn digest(
    _ a0: u32,
    _ a1: u32,
    _ a2: u32,
    _ a3: u32,
    _ a4: u32,
    _ a5: u32,
    _ a6: u32,
    _ a7: u32,
) -> Poseidon2Digest {
    Poseidon2Digest::from_u32s([a0, a1, a2, a3, a4, a5, a6, a7])
}

/// Exercise one ordered Merkle dependency through direct, witness, and
/// constraint interpretations. `mutation` changes one committed product after
/// witness generation.
pub fn merkle_node_relation_audit(
    _ c0: u32,
    _ c1: u32,
    _ c2: u32,
    _ c3: u32,
    _ c4: u32,
    _ c5: u32,
    _ c6: u32,
    _ c7: u32,
    _ s0: u32,
    _ s1: u32,
    _ s2: u32,
    _ s3: u32,
    _ s4: u32,
    _ s5: u32,
    _ s6: u32,
    _ s7: u32,
    _ direction: u32,
    _ p0: u32,
    _ p1: u32,
    _ p2: u32,
    _ p3: u32,
    _ p4: u32,
    _ p5: u32,
    _ p6: u32,
    _ p7: u32,
    _ mutation: u32,
) -> (u32, u32, u32, u32, u32, u32) {
    let inputs = MerkleNodeRelationInputs {
        child: digest(c0, c1, c2, c3, c4, c5, c6, c7),
        sibling: digest(s0, s1, s2, s3, s4, s5, s6, s7),
        direction: BabyBear::from_u32(direction),
        expected_parent: digest(p0, p1, p2, p3, p4, p5, p6, p7),
    }
    let mut witness = merkle_node_relation_witness(inputs)
    if mutation > 0 && mutation <= MERKLE_NODE_PRODUCTS.downcast_truncate() {
        let index = (mutation - 1) as usize
        witness.nodes[index] = witness.nodes[index] + BabyBear::one()
    }
    let residuals = merkle_node_relation_residuals(inputs, witness)
    let mut nonzero_products: u32 = 0
    let mut product: usize = 0
    while product < MERKLE_NODE_PRODUCTS {
        if !residuals.products[product].radix2_is_zero() {
            nonzero_products = nonzero_products + 1
        }
        product = product + 1
    }
    let mut nonzero_assertions: u32 = 0
    let mut assertion: usize = 0
    while assertion < MERKLE_NODE_ASSERTIONS {
        if !residuals.assertions[assertion].radix2_is_zero() {
            nonzero_assertions = nonzero_assertions + 1
        }
        assertion = assertion + 1
    }
    (
        flag(evaluate_merkle_node_relation(inputs)),
        flag(residuals.valid),
        nonzero_products,
        nonzero_assertions,
        MERKLE_NODE_PRODUCTS.downcast_truncate(),
        MERKLE_NODE_ASSERTIONS.downcast_truncate(),
    )
}

fn path_inputs(
    _ path_index: u32,
    _ direction_source: u32,
    _ expected_root: Poseidon2Digest,
) -> BinaryMerklePathRelationInputs<PATH_DEPTH> {
    BinaryMerklePathRelationInputs {
        leaf: digest(0, 1, 2, 3, 5, 8, 13, 21),
        siblings: [
            digest(34, 55, 89, 144, 233, 377, 610, 987),
            digest(1597, 2584, 4181, 6765, 10946, 17711, 28657, 46368),
            digest(7, 11, 19, 31, 47, 71, 107, 163),
            digest(257, 389, 587, 887, 1327, 1999, 3001, 4513),
        ],
        directions: [
            BabyBear::from_u32(direction_source & 1),
            BabyBear::from_u32((direction_source >> 1) & 1),
            BabyBear::from_u32((direction_source >> 2) & 1),
            BabyBear::from_u32((direction_source >> 3) & 1),
        ],
        path_index: BabyBear::from_u32(path_index),
        expected_root: expected_root,
    }
}

/// Exercise a four-level path derived from the same ordered node denotation.
/// `path_index` is constrained against the separately supplied direction bits.
pub fn binary_merkle_path_relation_audit(
    _ path_index: u32,
    _ direction_source: u32,
    _ p0: u32,
    _ p1: u32,
    _ p2: u32,
    _ p3: u32,
    _ p4: u32,
    _ p5: u32,
    _ p6: u32,
    _ p7: u32,
    _ mutation: u32,
) -> (u32, u32, u32, u32, u32, u32) {
    let inputs = path_inputs(
        path_index,
        direction_source,
        digest(p0, p1, p2, p3, p4, p5, p6, p7),
    )
    let witnessed = binary_merkle_path_relation_plan(
        inputs,
        QuadraticRelationWitnessInterpreter<BabyBear, PATH_PRODUCTS, PATH_ASSERTIONS>::new(),
    )
    let mut witness = witnessed.interpreter.finish()
    if mutation > 0 && mutation <= PATH_PRODUCTS.downcast_truncate() {
        let index = (mutation - 1) as usize
        witness.nodes[index] = witness.nodes[index] + BabyBear::one()
    }
    let constrained = binary_merkle_path_relation_plan(
        inputs,
        QuadraticRelationConstraintInterpreter<BabyBear, PATH_PRODUCTS, PATH_ASSERTIONS>::new(
            witness,
        ),
    )
    let residuals = constrained.interpreter.finish()
    let direct = binary_merkle_path_relation_plan(inputs, QuadraticRelationValueInterpreter::new())
    let mut nonzero_products: u32 = 0
    let mut product: usize = 0
    while product < PATH_PRODUCTS {
        if !residuals.products[product].radix2_is_zero() {
            nonzero_products = nonzero_products + 1
        }
        product = product + 1
    }
    let mut nonzero_assertions: u32 = 0
    let mut assertion: usize = 0
    while assertion < PATH_ASSERTIONS {
        if !residuals.assertions[assertion].radix2_is_zero() {
            nonzero_assertions = nonzero_assertions + 1
        }
        assertion = assertion + 1
    }
    (
        flag(direct.interpreter.finish()),
        flag(residuals.valid),
        nonzero_products,
        nonzero_assertions,
        PATH_PRODUCTS.downcast_truncate(),
        PATH_ASSERTIONS.downcast_truncate(),
    )
}

fn base_leaf_values(_ seed: u32) -> [BabyBear; SPARSE_BASE_AIR_FIELDS] {
    let mut values = [BabyBear::zero(); SPARSE_BASE_AIR_FIELDS]
    let mut index: usize = 0
    while index < SPARSE_BASE_AIR_FIELDS {
        let lane: u32 = index.downcast_truncate()
        values[index] = BabyBear::from_u32(
            seed + lane * 17 + 1,
        )
        index = index + 1
    }
    values
}

fn interaction_leaf_values(
    _ seed: u32,
) -> [BabyBear; SPARSE_INTERACTION_AIR_FIELDS] {
    let mut values = [BabyBear::zero(); SPARSE_INTERACTION_AIR_FIELDS]
    let mut index: usize = 0
    while index < SPARSE_INTERACTION_AIR_FIELDS {
        let lane: u32 = index.downcast_truncate()
        values[index] = BabyBear::from_u32(
            seed + lane * 29 + 3,
        )
        index = index + 1
    }
    values
}

pub fn production_base_lde_leaf_relation_audit(
    _ seed: u32,
    _ index: u32,
    _ e0: u32,
    _ e1: u32,
    _ e2: u32,
    _ e3: u32,
    _ e4: u32,
    _ e5: u32,
    _ e6: u32,
    _ e7: u32,
    _ mutation: u32,
) -> (u32, u32, u32, u32, u32, u32) {
    let inputs = ProductionBaseLdeLeafRelationInputs {
        index: BabyBear::from_u32(index),
        values: base_leaf_values(seed),
        expected_commitment: digest(e0, e1, e2, e3, e4, e5, e6, e7),
    }
    let streamed = production_base_lde_leaf_relation_plan(
        inputs,
        QuadraticRelationStreamInterpreter<
            BabyBear,
            PRODUCTION_BASE_LEAF_PRODUCTS,
            PRODUCTION_LEAF_ASSERTIONS,
        >::new(),
    )
    let stream_codec_valid = streamed.codec_valid
    let stream = streamed.interpreter.finish()
    if mutation > 0 && mutation <= PRODUCTION_BASE_LEAF_PRODUCTS.downcast_truncate() {
        let node = mutation - 1
        let mut row = stream.product(node)
        row.output = row.output + BabyBear::one()
        stream.replace_product(node, row)
    }
    let constrained = production_base_lde_leaf_relation_plan(
        inputs,
        QuadraticRelationStreamConstraintInterpreter<
            BabyBear,
            PRODUCTION_BASE_LEAF_PRODUCTS,
            PRODUCTION_LEAF_ASSERTIONS,
        >::new(stream),
    )
    let constraint_codec_valid = constrained.codec_valid
    let relation = constrained.interpreter.finish()
    let direct = production_base_lde_leaf_relation_plan(
        inputs,
        QuadraticRelationValueInterpreter::new(),
    )
    (
        flag(direct.codec_valid && direct.interpreter.finish()),
        flag(stream_codec_valid && constraint_codec_valid && relation.shape_valid),
        relation.operand_copy_mismatches + relation.nonzero_products,
        relation.assertion_copy_mismatches + relation.nonzero_assertions,
        PRODUCTION_BASE_LEAF_PRODUCTS.downcast_truncate(),
        PRODUCTION_LEAF_ASSERTIONS.downcast_truncate(),
    )
}

pub fn production_interaction_lde_leaf_relation_audit(
    _ seed: u32,
    _ index: u32,
    _ b0: u32,
    _ b1: u32,
    _ b2: u32,
    _ b3: u32,
    _ b4: u32,
    _ b5: u32,
    _ b6: u32,
    _ b7: u32,
    _ e0: u32,
    _ e1: u32,
    _ e2: u32,
    _ e3: u32,
    _ e4: u32,
    _ e5: u32,
    _ e6: u32,
    _ e7: u32,
    _ mutation: u32,
) -> (u32, u32, u32, u32, u32, u32) {
    let inputs = ProductionInteractionLdeLeafRelationInputs {
        index: BabyBear::from_u32(index),
        base_lde_root: digest(b0, b1, b2, b3, b4, b5, b6, b7),
        values: interaction_leaf_values(seed),
        expected_commitment: digest(e0, e1, e2, e3, e4, e5, e6, e7),
    }
    let streamed = production_interaction_lde_leaf_relation_plan(
        inputs,
        QuadraticRelationStreamInterpreter<
            BabyBear,
            PRODUCTION_INTERACTION_LEAF_PRODUCTS,
            PRODUCTION_LEAF_ASSERTIONS,
        >::new(),
    )
    let stream_codec_valid = streamed.codec_valid
    let stream = streamed.interpreter.finish()
    if mutation > 0 && mutation <= PRODUCTION_INTERACTION_LEAF_PRODUCTS.downcast_truncate() {
        let node = mutation - 1
        let mut row = stream.product(node)
        row.output = row.output + BabyBear::one()
        stream.replace_product(node, row)
    }
    let constrained = production_interaction_lde_leaf_relation_plan(
        inputs,
        QuadraticRelationStreamConstraintInterpreter<
            BabyBear,
            PRODUCTION_INTERACTION_LEAF_PRODUCTS,
            PRODUCTION_LEAF_ASSERTIONS,
        >::new(stream),
    )
    let constraint_codec_valid = constrained.codec_valid
    let relation = constrained.interpreter.finish()
    let direct = production_interaction_lde_leaf_relation_plan(
        inputs,
        QuadraticRelationValueInterpreter::new(),
    )
    (
        flag(direct.codec_valid && direct.interpreter.finish()),
        flag(stream_codec_valid && constraint_codec_valid && relation.shape_valid),
        relation.operand_copy_mismatches + relation.nonzero_products,
        relation.assertion_copy_mismatches + relation.nonzero_assertions,
        PRODUCTION_INTERACTION_LEAF_PRODUCTS.downcast_truncate(),
        PRODUCTION_LEAF_ASSERTIONS.downcast_truncate(),
    )
}
