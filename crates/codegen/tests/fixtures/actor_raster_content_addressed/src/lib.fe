use std::webgpu::{
    ClipPosition,
    ContentAddressed,
    FragmentStage,
    GpuProgram,
    ImmutableStorageBuffer,
    RasterVertex,
    TriangleList,
    VertexStage,
    WebGpuBackend,
}

pub type FixtureBytes = ContentAddressed<
    0xdc08b6f2,
    0xc7aaeca6,
    0xd88cd9c8,
    0x2797b328,
    0x160ccb3b,
    0x1a84243b,
    0x8eadb296,
    0x744426c4,
>

struct FixtureVarying { selected: f32 }
impl Copy for FixtureVarying {}

actor ContentAddressedTriangle uses (GpuProgram<WebGpuBackend>) {
    fixture: ImmutableStorageBuffer<FixtureBytes, 4, u32>,

    fn vertices(self, vertex_index: u32) -> RasterVertex<FixtureVarying>
        uses (VertexStage<FixtureVarying, TriangleList<3>>)
    {
        RasterVertex {
            position: ClipPosition {
                x: if vertex_index == 1 { 3.0 } else { -1.0 },
                y: if vertex_index == 2 { 3.0 } else { -1.0 },
                z: 0.0,
                w: 1.0,
            },
            varying: FixtureVarying {
                selected: if self.fixture.load(index: vertex_index) != 0 { 1.0 } else { 0.0 },
            },
        }
    }

    fn shade(self, varying: FixtureVarying) -> u32
        uses (FragmentStage<FixtureVarying>)
    {
        if varying.selected > 0.5 && self.fixture.load(index: 0) == 858927408 {
            4294901760
        } else {
            4278190335
        }
    }
}
