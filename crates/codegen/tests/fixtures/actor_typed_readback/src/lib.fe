use core::{BrowserBytes, BrowserPtr}
use std::webgpu::{
    ComputeSurface,
    FixedDispatch,
    FragmentSurface,
    GpuProgram,
    ReadbackTransition,
    ReadbackWords,
    WebGpuBackend,
    Workgroup,
}

struct ReceiptBytes {
    bytes: BrowserBytes,
}
impl core::marker::Copy for ReceiptBytes {}

struct ReadbackState {
    accepted: u32,
}

actor TypedReadbackProbe uses (GpuProgram<WebGpuBackend>) {
    output: ReadbackWords<ReceiptBytes, 4>,
    accepted: u32,

    fn produce(self)
        uses (ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>)
    {
        self.output.store(index: 0, value: 17)
        self.output.store(index: 1, value: 19)
        self.output.store(index: 2, value: 23)
        self.output.store(index: 3, value: 29)
    }

    fn accept(self, message: own ReceiptBytes) -> ReadbackState
        uses (ReadbackTransition<ReceiptBytes>)
    {
        let bytes = message.bytes
        let aligned = (bytes.ptr & 3) == 0
        let word0: BrowserPtr<u32> = BrowserPtr::from_u32(bytes.ptr)
        let word1: BrowserPtr<u32> = BrowserPtr::from_u32(bytes.ptr + 4)
        let word2: BrowserPtr<u32> = BrowserPtr::from_u32(bytes.ptr + 8)
        let word3: BrowserPtr<u32> = BrowserPtr::from_u32(bytes.ptr + 12)
        let valid = aligned && bytes.len == 16
            && word0.read() == 17
            && word1.read() == 19
            && word2.read() == 23
            && word3.read() == 29
        ReadbackState {
            accepted: if valid { self.accepted + 1 } else { 0 },
        }
    }

    fn paint(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        self.accepted.downcast_truncate()
    }
}
