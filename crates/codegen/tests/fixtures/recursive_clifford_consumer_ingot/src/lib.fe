use sparse_clifford::{
    Cl41Metric,
    CliffordGetLeaf,
    CliffordGp,
    CliffordMvF32,
    CliffordSetLeaf,
    clifford_zero_mvt5,
}

extern {
    fn __i32_from_f32(_: f32) -> i32
    const fn __bitcast<From, To>(_: From) -> To
}

#[inline(always)]
fn authored_cl41_coefficient(
    output: i32,
    s1: f32,
    s2: f32,
    s8: f32,
    s16: f32,
    p1: f32,
    p2: f32,
    p4: f32,
    p8: f32,
    p16: f32,
) -> f32 {
    let zero: f32 = s1 - s1
    let sphere0: CliffordMvF32<5> = clifford_zero_mvt5(zero)
    let sphere1 = sphere0.clifford_set_leaf(index: 1, size: 32, value: s1)
    let sphere2 = sphere1.clifford_set_leaf(index: 2, size: 32, value: s2)
    let sphere3 = sphere2.clifford_set_leaf(index: 8, size: 32, value: s8)
    let sphere = sphere3.clifford_set_leaf(index: 16, size: 32, value: s16)

    let point0: CliffordMvF32<5> = clifford_zero_mvt5(zero)
    let point1 = point0.clifford_set_leaf(index: 1, size: 32, value: p1)
    let point2 = point1.clifford_set_leaf(index: 2, size: 32, value: p2)
    let point3 = point2.clifford_set_leaf(index: 4, size: 32, value: p4)
    let point4 = point3.clifford_set_leaf(index: 8, size: 32, value: p8)
    let point = point4.clifford_set_leaf(index: 16, size: 32, value: p16)

    let metric = Cl41Metric {}
    let first: CliffordMvF32<5> = sphere.clifford_gp(other: point, metric: metric, level: 5)
    let sandwich: CliffordMvF32<5> = first.clifford_gp(other: sphere, metric: metric, level: 5)
    sandwich.clifford_get_leaf(index: output, size: 32)
}

pub fn authored_cl41_wasm(
    output: i32,
    s1: f32,
    s2: f32,
    s8: f32,
    s16: f32,
    p1: f32,
    p2: f32,
    p4: f32,
    p8: f32,
    p16: f32,
) -> i32 {
    __i32_from_f32(
        authored_cl41_coefficient(
                output: output,
                s1: s1,
                s2: s2,
                s8: s8,
                s16: s16,
                p1: p1,
                p2: p2,
                p4: p4,
                p8: p8,
                p16: p16,
            )
            * 256.0,
    )
}

pub fn authored_cl41_render(
    px: i32,
    py: i32,
    s1: f32,
    s2: f32,
    s8: f32,
    s16: f32,
    p1: f32,
    p2: f32,
    p4: f32,
    p8: f32,
    p16: f32,
) -> u32 {
    __bitcast(
        __i32_from_f32(
            authored_cl41_coefficient(
                    output: px + py * 8,
                    s1: s1,
                    s2: s2,
                    s8: s8,
                    s16: s16,
                    p1: p1,
                    p2: p2,
                    p4: p4,
                    p8: p8,
                    p16: p16,
                )
                * 256.0,
        ),
    )
}
