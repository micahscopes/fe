//! Production-width WebGPU gate for the generated sparse base AIR trace.

use mandelbrot_proof_fixed_air_baby_bear::SPARSE_BASE_AIR_FIELDS
use mandelbrot_proof_fixed_air_webgpu::{
    SparseBaseArithmeticLinkPartition,
    SparseBaseArithmeticPlanPartition,
    SparseBaseBoundaryPlanPartition,
    SparseBaseControlLinkPartition,
    SparseBaseControlPartition,
    SparseBaseControlPlanPartition,
    SparseBaseLinearPlanPartition,
    SparseBaseRoundPlanPartition,
    SparseBoundaryWitnessFamily,
    SparseCarryWitnessFamily,
    SparseLinearWitnessFamily,
    SparsePaddingWitnessFamily,
    SparseProductWitnessFamily,
    SparseRadixWitnessFamily,
    SparseRoundWitnessFamily,
    finish_transition_witness_workspace,
    transition_witness_workspace_words,
    write_sparse_base_air_partition_lane,
    write_sparse_witness_family_lane,
    write_transition_final_linear_witness_lane,
    write_transition_primary_linear_witness_lane,
    write_transition_product_witness_lane,
}
use mandelbrot_proof_production_profile_baby_bear::{
    PRODUCTION_LIMBS,
    PRODUCTION_TRACE_LENGTH,
}
use mandelbrot_proof_recursive::ComplexFixed
use mandelbrot_proof_fixed_air_core::{
    sparse_boundary_task_count,
    sparse_carry_task_count,
    sparse_linear_task_count,
    sparse_product_task_count,
    sparse_radix_task_count,
    sparse_round_task_count,
    sparse_transition_task_count,
}
use precision::fixed::Fixed
use precision::baby_bear::BabyBear
use parallel_ntt_webgpu::{
    forward_batched_stage_grid_lane,
    inverse_batched_stage_grid_lane,
    prepare_batched_stage_grid,
    prepare_validated_batched_coset_extension,
    validate_batched_stage_grid,
}
use parallel_structure::FactorTree
use std::conal::{Pair, RBin}
use std::webgpu::{
    ComputeInvocation,
    ComputeSurface as Kernel,
    FixedDispatch as Grid,
    FragmentSurface as Pixel,
    GpuProgram as Program,
    RepeatedDispatch as Repeat,
    StorageBuffer as Shared,
    Workgroup as Threads,
    WebGpuBackend,
}

const THREADS: usize = 64
const TRACE_GROUPS: usize =
    (PRODUCTION_TRACE_LENGTH + THREADS - 1) / THREADS
const BASE_TRACE_WORDS: usize =
    PRODUCTION_TRACE_LENGTH * SPARSE_BASE_AIR_FIELDS
const BASE_LDE_LENGTH: usize = PRODUCTION_TRACE_LENGTH * 2
const BASE_LDE_WORDS: usize = BASE_LDE_LENGTH * SPARSE_BASE_AIR_FIELDS
const LDE_INPUT_LANES: usize = PRODUCTION_TRACE_LENGTH / 2
const LDE_OUTPUT_LANES: usize = BASE_LDE_LENGTH / 2
const LDE_INPUT_GRID_LANES: usize = SPARSE_BASE_AIR_FIELDS * LDE_INPUT_LANES
const LDE_OUTPUT_GRID_LANES: usize = SPARSE_BASE_AIR_FIELDS * LDE_OUTPUT_LANES
const LDE_INPUT_GROUPS: usize =
    (LDE_INPUT_GRID_LANES + THREADS - 1) / THREADS
const LDE_OUTPUT_GROUPS: usize =
    (LDE_OUTPUT_GRID_LANES + THREADS - 1) / THREADS
const LDE_VALIDATION_GROUPS: usize =
    (SPARSE_BASE_AIR_FIELDS + THREADS - 1) / THREADS
type BaseLdeInputPlan = RBin<Pair, 12>
type BaseLdeOutputPlan = RBin<Pair, 13>
const LDE_INPUT_STAGES: usize = <BaseLdeInputPlan as FactorTree>::FACTORS
const LDE_OUTPUT_STAGES: usize = <BaseLdeOutputPlan as FactorTree>::FACTORS
const TRANSITION_WORKSPACE_WORDS: usize =
    transition_witness_workspace_words<PRODUCTION_LIMBS>()

static_assert(PRODUCTION_LIMBS == 4)
static_assert(PRODUCTION_TRACE_LENGTH == 4096)
static_assert(SPARSE_BASE_AIR_FIELDS == 260)
static_assert(TRACE_GROUPS == 64)
static_assert(BASE_TRACE_WORDS == 1064960)
static_assert(BASE_LDE_LENGTH == 8192)
static_assert(BASE_LDE_WORDS == 2129920)
static_assert(LDE_INPUT_GRID_LANES == 532480)
static_assert(LDE_OUTPUT_GRID_LANES == 1064960)
static_assert(LDE_INPUT_GROUPS == 8320)
static_assert(LDE_OUTPUT_GROUPS == 16640)
static_assert(LDE_VALIDATION_GROUPS == 5)
static_assert(<BaseLdeInputPlan as FactorTree>::POINTS == PRODUCTION_TRACE_LENGTH)
static_assert(<BaseLdeOutputPlan as FactorTree>::POINTS == BASE_LDE_LENGTH)
static_assert(LDE_INPUT_STAGES == 12)
static_assert(LDE_OUTPUT_STAGES == 13)
static_assert(TRANSITION_WORKSPACE_WORDS == 217)

const fn witness_groups(_ rows: usize) -> usize {
    (rows + THREADS - 1) / THREADS
}

const RADIX_GROUPS: usize =
    witness_groups(sparse_radix_task_count<PRODUCTION_LIMBS>() as usize)
const CARRY_GROUPS: usize =
    witness_groups(sparse_carry_task_count<PRODUCTION_LIMBS>() as usize)
const PRODUCT_GROUPS: usize =
    witness_groups(sparse_product_task_count<PRODUCTION_LIMBS>() as usize)
const ROUND_GROUPS: usize =
    witness_groups(sparse_round_task_count<PRODUCTION_LIMBS>() as usize)
const LINEAR_GROUPS: usize =
    witness_groups(sparse_linear_task_count<PRODUCTION_LIMBS>() as usize)
const BOUNDARY_GROUPS: usize =
    witness_groups(sparse_boundary_task_count<PRODUCTION_LIMBS>() as usize)
const PADDING_GROUPS: usize = witness_groups(PRODUCTION_TRACE_LENGTH - sparse_transition_task_count<PRODUCTION_LIMBS>() as usize)

fn directed_point() -> ComplexFixed<4> {
    ComplexFixed {
        real: Fixed { negative: true, limbs: [0, 0, 6144, 0] },
        imaginary: Fixed { negative: false, limbs: [0, 0, 1024, 0] },
    }
}

fn directed_current() -> ComplexFixed<4> {
    ComplexFixed {
        real: Fixed { negative: false, limbs: [0, 0, 2048, 1] },
        imaginary: Fixed { negative: true, limbs: [0, 0, 3072, 0] },
    }
}

actor ProductionSparseBaseTrace uses (Program<WebGpuBackend>) {
    transition_workspace: Shared<u32, TRANSITION_WORKSPACE_WORDS>,
    base_trace: Shared<u32, BASE_TRACE_WORDS>,
    validity: Shared<u32, PRODUCTION_TRACE_LENGTH>,
    status: Shared<u32, 1>,
    lde_inverse_values: Shared<u32, BASE_TRACE_WORDS>,
    lde_inverse_progress: Shared<u32, LDE_INPUT_GRID_LANES>,
    lde_values: Shared<u32, BASE_LDE_WORDS>,
    lde_progress: Shared<u32, LDE_OUTPUT_GRID_LANES>,

    fn derive_products(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<3, 1, 1>, Grid<1, 1, 1>>)
    {
        write_transition_product_witness_lane<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(directed_current(), self.transition_workspace, invocation)
    }

    fn derive_primary_linears(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<2, 1, 1>, Grid<1, 1, 1>>)
    {
        write_transition_primary_linear_witness_lane<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(self.transition_workspace, invocation)
    }

    fn derive_final_linears(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<2, 1, 1>, Grid<1, 1, 1>>)
    {
        write_transition_final_linear_witness_lane<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(directed_point(), self.transition_workspace, invocation)
    }

    fn finish_transition(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        finish_transition_witness_workspace<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(self.transition_workspace, invocation)
    }

    fn write_control(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<TRACE_GROUPS, 1, 1>,
            >
        )
    {
        write_sparse_base_air_partition_lane<
            SparseBaseControlPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(),
            directed_current(),
            self.transition_workspace,
            self.base_trace,
            self.validity,
            invocation,
        )
    }

    fn write_control_plan(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseControlPlanPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_control_link(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseControlLinkPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_radix_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<RADIX_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparseRadixWitnessFamily,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_carry_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<CARRY_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparseCarryWitnessFamily, PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH, TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS, PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_product_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<PRODUCT_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparseProductWitnessFamily, PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH, TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS, PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_round_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<ROUND_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparseRoundWitnessFamily, PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH, TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS, PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_linear_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<LINEAR_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparseLinearWitnessFamily, PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH, TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS, PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_boundary_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<BOUNDARY_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparseBoundaryWitnessFamily, PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH, TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS, PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_padding_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<PADDING_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparsePaddingWitnessFamily, PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH, TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS, PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_arithmetic_plan(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseArithmeticPlanPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_arithmetic_link(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseArithmeticLinkPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_round_plan(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseRoundPlanPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_linear_plan(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseLinearPlanPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_boundary_plan(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseBoundaryPlanPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn finish_base_trace(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        if invocation.global.x != 0 { return }
        let mut row: u32 = 0
        let mut valid = true
        while row < PRODUCTION_TRACE_LENGTH.downcast_truncate() {
            valid = valid && self.validity.load(index: row) == 1
            row = row + 1
        }
        self.status.store(index: 0, value: if valid { 1 } else { 0 })
    }

    fn prepare_lde_inverse(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<LDE_INPUT_GROUPS, 1, 1>>)
    {
        prepare_batched_stage_grid<
            SPARSE_BASE_AIR_FIELDS,
            PRODUCTION_TRACE_LENGTH,
            LDE_INPUT_LANES,
            BASE_TRACE_WORDS,
            BASE_TRACE_WORDS,
            LDE_INPUT_GRID_LANES,
        >(
            self.base_trace,
            0,
            self.lde_inverse_values,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn advance_lde_inverse(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<LDE_INPUT_GROUPS, 1, 1, LDE_INPUT_STAGES>,
            >
        )
    {
        inverse_batched_stage_grid_lane<
            SPARSE_BASE_AIR_FIELDS,
            PRODUCTION_TRACE_LENGTH,
            LDE_INPUT_LANES,
            BASE_TRACE_WORDS,
            LDE_INPUT_GRID_LANES,
            BabyBear,
            BaseLdeInputPlan,
        >(
            self.lde_inverse_values,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn validate_lde_inverse(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<LDE_VALIDATION_GROUPS, 1, 1>,
            >
        )
    {
        validate_batched_stage_grid<
            SPARSE_BASE_AIR_FIELDS,
            PRODUCTION_TRACE_LENGTH,
            LDE_INPUT_LANES,
            LDE_INPUT_GRID_LANES,
            BaseLdeInputPlan,
        >(self.lde_inverse_progress, invocation)
    }

    fn prepare_lde_forward(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<LDE_OUTPUT_GROUPS, 1, 1>>)
    {
        prepare_validated_batched_coset_extension<
            SPARSE_BASE_AIR_FIELDS,
            PRODUCTION_TRACE_LENGTH,
            BASE_LDE_LENGTH,
            LDE_INPUT_LANES,
            LDE_OUTPUT_LANES,
            BASE_TRACE_WORDS,
            LDE_INPUT_GRID_LANES,
            BASE_LDE_WORDS,
            LDE_OUTPUT_GRID_LANES,
            BabyBear,
            BaseLdeInputPlan,
            BaseLdeOutputPlan,
        >(
            self.lde_inverse_values,
            self.lde_inverse_progress,
            self.lde_values,
            self.lde_progress,
            BabyBear::from_u32(7),
            invocation,
        )
    }

    fn advance_lde_forward(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<LDE_OUTPUT_GROUPS, 1, 1, LDE_OUTPUT_STAGES>,
            >
        )
    {
        forward_batched_stage_grid_lane<
            SPARSE_BASE_AIR_FIELDS,
            BASE_LDE_LENGTH,
            LDE_OUTPUT_LANES,
            BASE_LDE_WORDS,
            LDE_OUTPUT_GRID_LANES,
            BabyBear,
            BaseLdeOutputPlan,
        >(self.lde_values, self.lde_progress, invocation)
    }

    fn validate_lde_forward(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<LDE_VALIDATION_GROUPS, 1, 1>,
            >
        )
    {
        let validation = validate_batched_stage_grid<
            SPARSE_BASE_AIR_FIELDS,
            BASE_LDE_LENGTH,
            LDE_OUTPUT_LANES,
            LDE_OUTPUT_GRID_LANES,
            BaseLdeOutputPlan,
        >(self.lde_progress, invocation)
        if validation.active {
            self.validity.store(
                index: validation.batch,
                value: if validation.valid { 1 } else { 0 },
            )
        }
    }

    fn finish_lde(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        if invocation.global.x != 0 { return }
        let mut column: u32 = 0
        let mut valid = self.status.load(index: 0) == 1
        while column < SPARSE_BASE_AIR_FIELDS.downcast_truncate() {
            valid = valid && self.validity.load(index: column) == 1
            column = column + 1
        }
        self.status.store(index: 0, value: if valid { 1 } else { 0 })
    }

    fn paint(self, px: i32, py: i32) -> i32 uses (Pixel) {
        let color: u32 = if self.status.load(index: 0) == 1 {
            4278255360
        } else {
            4294901760
        }
        color.downcast_truncate()
    }
}
