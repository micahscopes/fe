    fn begin_fri_binding(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    FixedDispatch<1, 1, 1>,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        begin_fri_binding_lane<PROVER_LANES, BASE_TRACE_WORDS>(
            self.base_trace,
            fri_arena_layout(),
            invocation,
        )
    }

    fn bind_fri_transcript(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<
                    FriRoundCycle,
                    RepeatedDispatch<1, 1, 1, FRI_BINDING_STEPS>,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        advance_fri_binding_lane<
            FRI_ROUNDS,
            PROVER_LANES,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            self.transition_workspace,
            self.base_trace,
            fri_arena_layout(),
            self.validity,
            fri_control_layout(),
            invocation,
        )
    }

    fn finish_fri_round(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<FriRoundCycle, FixedDispatch<1, 1, 1>, FRI_ROUNDS>,
            >
        )
    {
        finish_fri_round_lane<
            FRI_ROUNDS,
            TRANSITION_WORKSPACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            self.transition_workspace,
            self.validity,
            fri_control_layout(),
            invocation,
        )
    }

    fn sample_fri_queries(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<
                    QUERY_SAMPLE_GROUPS,
                    1,
                    1,
                    INDEXED_DIGEST_SQUEEZE_STEPS,
                >,
            >
        )
    {
        let query_position = invocation.global.x
            / POSEIDON2_LANES.downcast_truncate()
        let item = fri_query_sample_work_item<QueryPlan>(query_position)
        let rounds: u32 = FRI_ROUNDS.downcast_truncate()
        let digest_fields: u32 = DIGEST_FIELDS.downcast_truncate()
        let final_transcript = FRI_TRANSCRIPTS_START + rounds * digest_fields
        let input_valid = item.valid
            && self.validity.load(index: FRI_PROVER_COMPLETE) == 1
            && self.validity.load(
                index: FRI_TRANSCRIPT_VALID_START
                    + FRI_ROUNDS.downcast_truncate(),
            ) == 1
        let transcript = Poseidon2Digest::from_u32s([
            self.validity.load(index: final_transcript),
            self.validity.load(index: final_transcript + 1),
            self.validity.load(index: final_transcript + 2),
            self.validity.load(index: final_transcript + 3),
            self.validity.load(index: final_transcript + 4),
            self.validity.load(index: final_transcript + 5),
            self.validity.load(index: final_transcript + 6),
            self.validity.load(index: final_transcript + 7),
        ])
        let step = advance_indexed_digest_squeeze_lane_at<
            QUERY_COUNT,
            BASE_LDE_WORDS,
        >(
            self.lde_values,
            0,
            invocation,
            fri_query_domain_tag(),
            transcript,
            item.query_identity,
            input_valid,
        )
        if !step.active {
            self.lde_values.store(
                index: QUERY_PADDING_START
                    + invocation.global.x - QUERY_SAMPLE_WORK_ITEMS,
                value: invocation.global.x + 1,
            )
        } else if !step.valid && step.field_lane == 0 {
            self.lde_values.store(
                index: QUERY_INDICES_START + step.state,
                value: 0,
            )
            self.lde_values.store(
                index: QUERY_VALIDITY_START + step.state,
                value: 0,
            )
        } else if step.complete {
            self.lde_values.store(
                index: QUERY_INDICES_START + step.state,
                value: step.value.coefficient(0).to_u32() & QUERY_HALF_MASK,
            )
            self.lde_values.store(
                index: QUERY_VALIDITY_START + step.state,
                value: 1,
            )
        }
    }

    fn open_fri_evaluations(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<EVALUATION_GROUPS, 1, 1, FRI_ROUNDS>,
            >
        )
    {
        let lane = invocation.global.x
        let item = fri_query_evaluation_work_item<QueryPlan, FoldSchedule>(lane)
        if !item.valid {
            self.lde_values.store(
                index: OPENING_PADDING_START
                    + lane - EVALUATION_ITEMS.downcast_truncate(),
                value: lane + 1,
            )
            return
        }
        let query = self.lde_values.load(
            index: QUERY_INDICES_START + item.query_position,
        )
        let progress_index = EVALUATION_PROGRESS_START + lane
        let round = self.lde_values.load(index: progress_index)
        if round >= FRI_ROUNDS.downcast_truncate() { return }
        let cursor_base = EVALUATION_CURSOR_START
            + lane * FRI_QUERY_CURSOR_FIELDS.downcast_truncate()
        let placement = advance_fri_query_evaluation_storage<
            TRANSITION_WORKSPACE_WORDS,
            BASE_LDE_WORDS,
        >(
            self.transition_workspace,
            self.lde_values,
            cursor_base,
            round,
            item.opening,
            query,
        )
        self.lde_values.store(index: progress_index, value: round + 1)
        if round + 1 != FRI_ROUNDS.downcast_truncate()
            || !placement.valid
            || self.validity.load(index: FRI_PROVER_COMPLETE) != 1
            || self.base_trace.load(
                index: FRI_EVALUATION_VALID_START + placement.evaluation_index,
            ) != 1 {
            return
        }
        let source = FRI_EVALUATIONS_START
            + placement.evaluation_index
                * EXTENSION_WORDS.downcast_truncate()
        let destination = lane * EXTENSION_WORDS.downcast_truncate()
        self.lde_progress.store(
            index: destination,
            value: self.base_trace.load(index: source),
        )
        self.lde_progress.store(
            index: destination + 1,
            value: self.base_trace.load(index: source + 1),
        )
        self.lde_progress.store(
            index: destination + 2,
            value: self.base_trace.load(index: source + 2),
        )
        self.lde_progress.store(
            index: destination + 3,
            value: self.base_trace.load(index: source + 3),
        )
    }

    fn open_fri_siblings(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<SIBLING_GROUPS, 1, 1, FRI_ROUNDS>,
            >
        )
    {
        let lane = invocation.global.x
        let item = fri_query_sibling_work_item<QueryPlan, FoldSchedule>(lane)
        if !item.valid {
            self.lde_values.store(
                index: OPENING_PADDING_START
                    + EVALUATION_PADDING.downcast_truncate()
                    + lane - SIBLING_ITEMS.downcast_truncate(),
                value: lane + 1,
            )
            return
        }
        let query = self.lde_values.load(
            index: QUERY_INDICES_START + item.query_position,
        )
        let progress_index = SIBLING_PROGRESS_START + lane
        let round = self.lde_values.load(index: progress_index)
        if round >= FRI_ROUNDS.downcast_truncate() { return }
        let cursor_base = SIBLING_CURSOR_START
            + lane * FRI_QUERY_CURSOR_FIELDS.downcast_truncate()
        let placement = advance_fri_query_sibling_storage<
            TRANSITION_WORKSPACE_WORDS,
            BASE_LDE_WORDS,
        >(
            self.transition_workspace,
            self.lde_values,
            cursor_base,
            round,
            item.sibling,
            query,
        )
        self.lde_values.store(index: progress_index, value: round + 1)
        if round + 1 != FRI_ROUNDS.downcast_truncate()
            || !placement.valid
            || self.validity.load(index: FRI_PROVER_COMPLETE) != 1
            || self.base_trace.load(
                index: FRI_NODE_VALID_START + placement.tree_node,
            ) != 1 {
            return
        }
        let source = FRI_TREE_START
            + placement.tree_node * DIGEST_FIELDS.downcast_truncate()
        let destination = lane * DIGEST_FIELDS.downcast_truncate()
        let mut field: u32 = 0
        while field < DIGEST_FIELDS.downcast_truncate() {
            self.lde_inverse_progress.store(
                index: destination + field,
                value: self.base_trace.load(index: source + field),
            )
            field = field + 1
        }
    }

    fn compact_fri_openings(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<1, 1, 1>>)
    {
        let round = invocation.global.x
        if round >= FRI_ROUNDS.downcast_truncate() { return }
        let mut query: u32 = 0
        while query < QUERY_COUNT.downcast_truncate() {
            if self.lde_values.load(
                index: QUERY_VALIDITY_START + query,
            ) != 1 {
                self.lde_values.store(
                    index: COMPACT_VALID_START + round,
                    value: 0,
                )
                return
            }
            query = query + 1
        }
        let valid = compact_fri_round_openings<
            QUERY_COUNT,
            EXTENSION_WORDS,
            DIGEST_FIELDS,
            BASE_LDE_WORDS,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            BASE_LDE_WORDS,
            BASE_LDE_WORDS,
            INTERACTION_LDE_WORDS,
            LDE_INPUT_GRID_LANES,
        >(
            self.lde_values,
            QUERY_INDICES_START,
            self.transition_workspace,
            self.base_trace,
            FRI_EVALUATIONS_START,
            FRI_TREE_START,
            self.lde_values,
            OPENING_ACTIVITY_START,
            round,
            self.lde_values,
            COMPACT_LEAF_COUNT_START,
            COMPACT_SIBLING_COUNT_START,
            COMPACT_LEAF_INDEX_START,
            self.lde_progress,
            self.lde_inverse_progress,
        )
        self.lde_values.store(
            index: COMPACT_VALID_START + round,
            value: if valid { 1 } else { 0 },
        )
    }

    fn paint(self, px: i32, py: i32) -> i32 uses (Pixel) {
        let mut openings_valid = true
        let mut round: u32 = 0
        while round < FRI_ROUNDS.downcast_truncate() {
            openings_valid = openings_valid
                && self.lde_values.load(index: COMPACT_VALID_START + round) == 1
            round = round + 1
        }
        let color: u32 = if self.validity.load(index: FRI_PROVER_COMPLETE) == 1
            && openings_valid {
            4278255360
        } else {
            4294901760
        }
        color.downcast_truncate()
    }
}
