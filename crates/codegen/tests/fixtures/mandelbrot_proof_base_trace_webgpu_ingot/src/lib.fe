                        Taper<
                            RepeatedDispatch<TREE_GROUPS, 1, 1, PROVER_TREE_STEPS>,
                            1, 0, 0, {1 + FRI_LEAF_HASH_STEPS},
                        >,
                        8,
                    >,
                    FRI_ROUNDS,
                >,
            >
        )
    {
        advance_fri_tree_lane<
            FRI_ROUNDS,
