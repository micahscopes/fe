            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            BASE_LDE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            LDE_INPUT_GRID_LANES,
        >(self.transition_workspace, self.lde_inverse_progress)
    }

    /// Commit the completed quartic codeword under BC02. The first tree-sized
    /// prefix of the retired base trace carries node validity, while the
    /// following disjoint region carries staged Poseidon state.
    fn prepare_composition_lde_commitments(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<BASE_TREE_LEAF_GROUPS, 1, 1>,
            >
        )
    {
        prepare_column_major_field_row_commitments_at<
            BASE_LDE_LENGTH,
            BASE_TRACE_WORDS,
        >(
            self.base_trace,
            COMPOSITION_COMMITMENT_WORKSPACE_START.downcast_truncate(),
            invocation,
        )
    }

    fn advance_composition_lde_commitments(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<
                    BASE_TREE_LEAF_GROUPS,
                    1,
                    1,
                    COMPOSITION_COMMITMENT_STEPS,
                >,
            >
        )
    {
        let row = invocation.global.x
        if row >= BASE_LDE_LENGTH.downcast_truncate() { return }
        let prefix: [BabyBear; 0] = []
        let step = advance_column_major_field_row_commitments_at<
            MandelbrotCompositionRowBabyBearV1,
            BASE_LDE_LENGTH,
            COMPOSITION_COMMITMENT_FIELDS,
            LDE_INPUT_GRID_LANES,
            0,
            BASE_TRACE_WORDS,
        >(
            self.lde_inverse_progress,
            self.base_trace,
            COMPOSITION_COMMITMENT_WORKSPACE_START.downcast_truncate(),
            ref prefix,
            invocation,
        )
        if step.complete {
            let validity_start: u32 = (BASE_LDE_LENGTH * COMPOSITION_COMMITMENT_FIELDS)
                .downcast_truncate()
            write_ordered_binary_tree_leaf<
                BASE_LDE_LENGTH,
                BASE_TRACE_WORDS,
                BASE_TRACE_WORDS,
            >(
                self.lde_inverse_values,
                self.base_trace,
                step.row,
                step.commitment.require(
                    sparse_composition_phase_is_valid<
                        PRODUCTION_LIMBS,
                        PRODUCTION_TRACE_LENGTH,
                        BASE_LDE_LENGTH,
                        TRANSITION_WORKSPACE_WORDS,
                    >(self.transition_workspace)
                        && self.lde_inverse_progress.load(index: validity_start + step.row) == 1,
                ),
            )
        }
    }

    fn prepare_composition_lde_tree(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<BASE_TREE_PARENT_GROUPS, 1, 1>,
            >
        )
    {
        prepare_ordered_binary_tree<
            BASE_LDE_LENGTH,
            PRODUCTION_TRACE_LENGTH,
        >(self.validity, invocation)
    }

    fn advance_composition_lde_tree(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<
                    BASE_TREE_PARENT_GROUPS,
                    1,
                    1,
                    BASE_TREE_LEVELS,
                >,
            >
        )
    {
        advance_ordered_binary_tree<
            BASE_LDE_LENGTH,
            BASE_TREE_LEVELS,
            BASE_TRACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            self.lde_inverse_values,
            self.base_trace,
            self.validity,
            invocation,
        )
    }

    fn finish_composition_lde_tree(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        if invocation.global.x != 0 { return }
        let root = finish_ordered_binary_tree<
            BASE_LDE_LENGTH,
            BASE_TREE_LEVELS,
            BASE_TRACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(self.lde_inverse_values, self.base_trace, self.validity)
        finish_sparse_bound_composition_commitment<
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            BASE_LDE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
        >(self.transition_workspace, root.value, root.valid)
    }

    /// Transpose the committed composition codeword into the FRI fold arena
    /// and carry the exact BC03 transcript across the phase boundary. Both
    /// source values were minted by the preceding Fe passes.
    fn seed_fri_input(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<BASE_TREE_LEAF_GROUPS, 1, 1>,
            >
        )
    {
        let lane = invocation.global.x
        if lane < BASE_LDE_LENGTH.downcast_truncate() {
            let destination = FRI_COMPOSITION_START
                + lane * EXTENSION_WORDS.downcast_truncate()
            let mut coefficient: u32 = 0
            while coefficient < EXTENSION_WORDS.downcast_truncate() {
                self.base_trace.store(
                    index: destination + coefficient,
                    value: self.lde_inverse_progress.load(
                        index: coefficient * BASE_LDE_LENGTH.downcast_truncate() + lane,
                    ),
                )
                coefficient = coefficient + 1
            }
        }
        if lane < DIGEST_FIELDS.downcast_truncate() {
            let transcript = sparse_composition_fri_transcript<
                PRODUCTION_LIMBS,
                PRODUCTION_TRACE_LENGTH,
                BASE_LDE_LENGTH,
                TRANSITION_WORKSPACE_WORDS,
            >(self.transition_workspace)
            self.validity.store(
                index: FRI_TRANSCRIPTS_START + lane,
                value: transcript.value.field(lane).to_u32(),
            )
            if lane == 0 {
                let valid = transcript.valid
                    && sparse_composition_commitment_is_valid<
                        PRODUCTION_LIMBS,
                        PRODUCTION_TRACE_LENGTH,
                        BASE_LDE_LENGTH,
                        TRANSITION_WORKSPACE_WORDS,
                    >(self.transition_workspace)
                self.base_trace.store(
                    index: FRI_COMPOSITION_VALID,
                    value: if valid { 1 } else { 0 },
                )
                self.validity.store(
                    index: FRI_TRANSCRIPT_VALID_START,
                    value: if valid { 1 } else { 0 },
                )
            }
        }
    }

    fn prepare_fri_rounds(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<1, 1, 1>>)
    {
        let lane = invocation.global.x
        if lane >= FRI_ROUNDS.downcast_truncate() { return }
        store_fri_round_placement<TRANSITION_WORKSPACE_WORDS>(
            self.transition_workspace,
            lane,
            <FoldSchedule as FriSchedulePlacement>::fri_round_placement(lane),
        )
    }

