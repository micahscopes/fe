/// Keep every authored proof stage at one queue-ordered submission boundary.
/// Some browser GPU processes lose the device when the entire protocol graph
/// is encoded into one command buffer. This Fe-owned physical policy preserves
/// the dependency graph while letting the fixed host yield between stages.
type Grid<const X: usize, const Y: usize, const Z: usize> = Cooperate<FixedDispatch<X, Y, Z>, 1>
type Repeat<const X: usize, const Y: usize, const Z: usize, const N: usize> = Cooperate<
    RepeatedDispatch<X, Y, Z, N>,
    N,
>

const THREADS: usize = 64
const TRACE_GROUPS: usize = (PRODUCTION_TRACE_LENGTH + THREADS - 1) / THREADS
const BASE_TRACE_WORDS: usize = PRODUCTION_TRACE_LENGTH * SPARSE_BASE_AIR_FIELDS
const INTERACTION_TRACE_WORDS: usize = PRODUCTION_TRACE_LENGTH * SPARSE_INTERACTION_AIR_FIELDS
const BASE_LDE_LENGTH: usize = PRODUCTION_TRACE_LENGTH * 2
const BASE_LDE_WORDS: usize = BASE_LDE_LENGTH * SPARSE_BASE_AIR_FIELDS
const INTERACTION_LDE_WORDS: usize = BASE_LDE_LENGTH * SPARSE_INTERACTION_AIR_FIELDS
const LDE_INPUT_LANES: usize = PRODUCTION_TRACE_LENGTH / 2
const LDE_OUTPUT_LANES: usize = BASE_LDE_LENGTH / 2
const LDE_INPUT_GRID_LANES: usize = SPARSE_BASE_AIR_FIELDS * LDE_INPUT_LANES
const LDE_OUTPUT_GRID_LANES: usize = SPARSE_BASE_AIR_FIELDS * LDE_OUTPUT_LANES
const INTERACTION_INPUT_GRID_LANES: usize = SPARSE_INTERACTION_AIR_FIELDS * LDE_INPUT_LANES
const INTERACTION_OUTPUT_GRID_LANES: usize = SPARSE_INTERACTION_AIR_FIELDS * LDE_OUTPUT_LANES
const LDE_INPUT_GROUPS: usize = (LDE_INPUT_GRID_LANES + THREADS - 1) / THREADS
const LDE_OUTPUT_GROUPS: usize = (LDE_OUTPUT_GRID_LANES + THREADS - 1) / THREADS
const LDE_VALIDATION_GROUPS: usize = (SPARSE_BASE_AIR_FIELDS + THREADS - 1) / THREADS
const INTERACTION_INPUT_GROUPS: usize = (INTERACTION_INPUT_GRID_LANES + THREADS - 1) / THREADS
const INTERACTION_OUTPUT_GROUPS: usize = (INTERACTION_OUTPUT_GRID_LANES + THREADS - 1) / THREADS
const INTERACTION_VALIDATION_GROUPS: usize = (SPARSE_INTERACTION_AIR_FIELDS + THREADS - 1) / THREADS
const BASE_TREE_NODES: usize = ordered_binary_tree_nodes(BASE_LDE_LENGTH)
const BASE_TREE_WORDS: usize = ordered_binary_tree_digest_words(BASE_LDE_LENGTH)
const BASE_TREE_PARENT_TASKS: usize = ordered_binary_tree_parent_tasks(BASE_LDE_LENGTH)
const BASE_TREE_LEVELS: usize = ordered_binary_tree_levels(BASE_LDE_LENGTH)
const BASE_TREE_LEAF_GROUPS: usize = (BASE_LDE_LENGTH + THREADS - 1) / THREADS
const BASE_TREE_PARENT_GROUPS: usize = (BASE_TREE_PARENT_TASKS + THREADS - 1) / THREADS
const BASE_COMMITMENT_STEPS: usize = column_major_field_row_commitment_steps(
    4,
    SPARSE_BASE_AIR_FIELDS,
)
const BASE_COMMITMENT_WORKSPACE_WORDS: usize = column_major_field_row_commitment_workspace_words(
    BASE_LDE_LENGTH,
)
const INTERACTION_LEAF_PREFIX_FIELDS: usize = 4 + DIGEST_FIELDS
const INTERACTION_COMMITMENT_STEPS: usize = column_major_field_row_commitment_steps(
    INTERACTION_LEAF_PREFIX_FIELDS,
    SPARSE_INTERACTION_AIR_FIELDS,
)
const INTERACTION_COMMITMENT_WORKSPACE_WORDS: usize = column_major_field_row_commitment_workspace_words(
    BASE_LDE_LENGTH,
)
const CHALLENGE_GROUPS: usize = digest_squeeze_batch_workgroups(
    SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
    THREADS,
)
const CHALLENGE_WORKSPACE_WORDS: usize = digest_squeeze_batch_workspace_words(
    SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
)
const CHALLENGE_OUTPUT_WORDS: usize = digest_squeeze_batch_output_words(
    SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
)
type BaseLdeInputPlan = RBin<Pair, 12>
type BaseLdeOutputPlan = RBin<Pair, 13>
type InteractionAccumulatorScanPlan = RBin<Pair, 12>
const LDE_INPUT_STAGES: usize = <BaseLdeInputPlan as FactorTree>::FACTORS
const LDE_OUTPUT_STAGES: usize = <BaseLdeOutputPlan as FactorTree>::FACTORS
const INTERACTION_ACCUMULATOR_SCAN_STAGES: usize = <InteractionAccumulatorScanPlan as FactorTree>::FACTORS
const INTERACTION_ACCUMULATOR_SCAN_WORDS: usize = PRODUCTION_TRACE_LENGTH
    * SPARSE_INTERACTION_ACCUMULATOR_FIELDS
const TRANSITION_PHASE_WORDS: usize = transition_phase_workspace_words<PRODUCTION_LIMBS>()
const COMPOSITION_WORKSPACE_WORDS: usize = sparse_composition_phase_workspace_words<
    PRODUCTION_LIMBS,
    PRODUCTION_TRACE_LENGTH,
    BASE_LDE_LENGTH,
>()
const TRANSITION_WORKSPACE_WORDS: usize = if TRANSITION_PHASE_WORDS > COMPOSITION_WORKSPACE_WORDS {
    TRANSITION_PHASE_WORDS
} else {
    COMPOSITION_WORKSPACE_WORDS
}
const COMPOSITION_CODEWORD_WORDS: usize = sparse_composition_codeword_words<BASE_LDE_LENGTH>()
const COMPOSITION_STAGING_WORDS: usize = sparse_composition_staging_words<BASE_LDE_LENGTH>()
const COMPOSITION_GROUPS: usize = (BASE_LDE_LENGTH + THREADS - 1) / THREADS
const COMPOSITION_VALIDITY_WORD: usize = sparse_composition_phase_validity_word<
    PRODUCTION_LIMBS,
    PRODUCTION_TRACE_LENGTH,
    BASE_LDE_LENGTH,
>()
const COMPOSITION_COMMITMENT_VALIDITY_WORD: usize = sparse_composition_commitment_validity_word<
    PRODUCTION_LIMBS,
    PRODUCTION_TRACE_LENGTH,
    BASE_LDE_LENGTH,
>()
const COMPOSITION_COMMITMENT_FIELDS: usize = COMPOSITION_CODEWORD_WORDS / BASE_LDE_LENGTH - 1
const COMPOSITION_COMMITMENT_STEPS: usize = column_major_field_row_commitment_steps(
    0,
    COMPOSITION_COMMITMENT_FIELDS,
)
const COMPOSITION_COMMITMENT_WORKSPACE_START: usize = BASE_TREE_NODES
const COMPOSITION_COMMITMENT_WORKSPACE_END: usize = COMPOSITION_COMMITMENT_WORKSPACE_START
    + column_major_field_row_commitment_workspace_words(BASE_LDE_LENGTH)

/// One semantic FRI schedule is interpreted directly over retired production
/// resources. The composition codeword is transposed once from its commitment
/// layout into the row-major fold arena; no host protocol table participates.
type FoldSchedule = FriSchedule<1, { PRODUCTION_LDE_LOG }>
type QueryPlan = FriQueryRangePlan<1, { PRODUCTION_SECURITY_QUERY_COUNT }>

const EXTENSION_WORDS: usize = 4
const FRI_ROUNDS: usize = <FoldSchedule as FriScheduleShape>::fri_schedule_metadata()
    .rounds as usize
const FOLDED_EVALUATIONS: usize = <FoldSchedule as FriScheduleShape>::fri_schedule_metadata()
    .folded_evaluations as usize
const LAYER_TREE_NODES: usize = <FoldSchedule as FriScheduleShape>::fri_schedule_metadata()
    .layer_tree_nodes as usize
const ROUND_PLACEMENT_WORDS: usize = fri_round_placement_storage_words(FRI_ROUNDS)
const PROVER_STATES: usize = fri_prover_states<FoldSchedule>()
const PROVER_GROUPS: usize = fri_prover_workgroups<FoldSchedule>(THREADS)
const PROVER_LANES: usize = PROVER_GROUPS * THREADS
const PAIR_GROUPS: usize = (PROVER_STATES + THREADS - 1) / THREADS
const TREE_GROUPS: usize = PROVER_GROUPS / 2
const PROVER_TREE_STEPS: usize = fri_prover_tree_steps<FoldSchedule>()

const FRI_COMPOSITION_START: u32 = 0
const FRI_COMPOSITION_WORDS: usize = BASE_LDE_LENGTH * EXTENSION_WORDS
const FRI_COMPOSITION_VALID: u32 = FRI_COMPOSITION_WORDS.downcast_truncate()
const FRI_EVALUATIONS_START: u32 = FRI_COMPOSITION_VALID + 1
const FRI_EVALUATION_WORDS: usize = FOLDED_EVALUATIONS * EXTENSION_WORDS
const FRI_EVALUATION_VALID_START: u32 = FRI_EVALUATIONS_START
    + FRI_EVALUATION_WORDS.downcast_truncate()
const FRI_TREE_START: u32 = FRI_EVALUATION_VALID_START + FOLDED_EVALUATIONS.downcast_truncate()
const FRI_TREE_WORDS: usize = LAYER_TREE_NODES * DIGEST_FIELDS
const FRI_NODE_VALID_START: u32 = FRI_TREE_START + FRI_TREE_WORDS.downcast_truncate()
const FRI_STATE_START: u32 = FRI_NODE_VALID_START + LAYER_TREE_NODES.downcast_truncate()
const FRI_STATE_WORDS: usize = fri_prover_state_words<FoldSchedule>()
const FRI_STATE_VALID_START: u32 = FRI_STATE_START + FRI_STATE_WORDS.downcast_truncate()
const FRI_STATE_VALID_WORDS: usize = fri_prover_valid_words<FoldSchedule>()
const FRI_TAIL_START: u32 = FRI_STATE_VALID_START + FRI_STATE_VALID_WORDS.downcast_truncate()
const FRI_TAIL_WORDS: usize = fri_prover_tail_words()
const FRI_PROGRESS_START: u32 = FRI_TAIL_START + FRI_TAIL_WORDS.downcast_truncate()
const FRI_PROGRESS_WORDS: usize = fri_prover_progress_words<FoldSchedule>(THREADS)
const FRI_ARENA_WORDS: usize = FRI_PROGRESS_START as usize + FRI_PROGRESS_WORDS

const FRI_TRANSCRIPTS_START: u32 = 0
const FRI_TRANSCRIPT_WORDS: usize = (FRI_ROUNDS + 1) * DIGEST_FIELDS
const FRI_TRANSCRIPT_VALID_START: u32 = FRI_TRANSCRIPT_WORDS.downcast_truncate()
const FRI_CHALLENGES_START: u32 = FRI_TRANSCRIPT_VALID_START + (FRI_ROUNDS + 1).downcast_truncate()
const FRI_CHALLENGE_WORDS: usize = FRI_ROUNDS * EXTENSION_WORDS
const FRI_CHALLENGE_VALID_START: u32 = FRI_CHALLENGES_START
    + FRI_CHALLENGE_WORDS.downcast_truncate()
const FRI_ROOTS_START: u32 = FRI_CHALLENGE_VALID_START + FRI_ROUNDS.downcast_truncate()
const FRI_ROOT_WORDS: usize = FRI_ROUNDS * DIGEST_FIELDS
const FRI_ROOT_VALID_START: u32 = FRI_ROOTS_START + FRI_ROOT_WORDS.downcast_truncate()
const FRI_ROUND_CURSOR: u32 = FRI_ROOT_VALID_START + FRI_ROUNDS.downcast_truncate()
const FRI_ROUND_VALID: u32 = FRI_ROUND_CURSOR + 1
const FRI_PROVER_COMPLETE: u32 = FRI_ROUND_VALID + 1
const FRI_CONTROL_WORDS: usize = FRI_PROVER_COMPLETE as usize + 1

const QUERY_COUNT: usize = fri_query_grid_metadata<QueryPlan, FoldSchedule>().query_count as usize
const EVALUATIONS_PER_QUERY: usize = fri_query_grid_metadata<QueryPlan, FoldSchedule>()
    .evaluations_per_query as usize
const SIBLINGS_PER_QUERY: usize = fri_query_grid_metadata<QueryPlan, FoldSchedule>()
    .siblings_per_query as usize
const EVALUATION_ITEMS: usize = fri_query_grid_metadata<QueryPlan, FoldSchedule>()
    .evaluation_items as usize
const SIBLING_ITEMS: usize = fri_query_grid_metadata<QueryPlan, FoldSchedule>()
    .sibling_items as usize
const EVALUATION_GROUPS: usize = fri_query_grid_workgroups(
    EVALUATION_ITEMS.downcast_truncate(),
    THREADS.downcast_truncate(),
) as usize
const SIBLING_GROUPS: usize = fri_query_grid_workgroups(
    SIBLING_ITEMS.downcast_truncate(),
    THREADS.downcast_truncate(),
) as usize
const EVALUATION_PADDING: usize = EVALUATION_GROUPS * THREADS - EVALUATION_ITEMS
const SIBLING_PADDING: usize = SIBLING_GROUPS * THREADS - SIBLING_ITEMS
const EVALUATION_OPENING_WORDS: usize = EVALUATION_ITEMS * EXTENSION_WORDS
const SIBLING_OPENING_WORDS: usize = SIBLING_ITEMS * DIGEST_FIELDS

const QUERY_WORKSPACE_WORDS: usize = indexed_digest_squeeze_workspace_words(QUERY_COUNT)
const QUERY_SAMPLE_GROUPS: usize = indexed_digest_squeeze_workgroups(QUERY_COUNT, THREADS)
const QUERY_SAMPLE_WORK_ITEMS: u32 = (QUERY_COUNT * POSEIDON2_LANES).downcast_truncate()
const QUERY_SAMPLE_PADDING: usize = QUERY_SAMPLE_GROUPS * THREADS - QUERY_COUNT * POSEIDON2_LANES
const QUERY_HALF_MASK: u32 = (BASE_LDE_LENGTH / 2 - 1).downcast_truncate()

const EVALUATION_CURSOR_START: u32 = 0
const EVALUATION_CURSOR_WORDS: usize = EVALUATION_ITEMS * FRI_QUERY_CURSOR_FIELDS
const EVALUATION_PROGRESS_START: u32 = EVALUATION_CURSOR_WORDS.downcast_truncate()
const SIBLING_CURSOR_START: u32 = EVALUATION_PROGRESS_START + EVALUATION_ITEMS.downcast_truncate()
const SIBLING_CURSOR_WORDS: usize = SIBLING_ITEMS * FRI_QUERY_CURSOR_FIELDS
const SIBLING_PROGRESS_START: u32 = SIBLING_CURSOR_START + SIBLING_CURSOR_WORDS.downcast_truncate()
const OPENING_ACTIVITY_START: u32 = SIBLING_PROGRESS_START + SIBLING_ITEMS.downcast_truncate()
const OPENING_STATE_WORDS: usize = OPENING_ACTIVITY_START as usize + LAYER_TREE_NODES

const OPENING_METADATA_START: u32 = OPENING_STATE_WORDS.downcast_truncate()
const COMPACT_VALID_START: u32 = OPENING_METADATA_START
const COMPACT_LEAF_COUNT_START: u32 = COMPACT_VALID_START + FRI_ROUNDS.downcast_truncate()
const COMPACT_SIBLING_COUNT_START: u32 = COMPACT_LEAF_COUNT_START + FRI_ROUNDS.downcast_truncate()
const COMPACT_LEAF_INDEX_START: u32 = COMPACT_SIBLING_COUNT_START + FRI_ROUNDS.downcast_truncate()
const COMPACT_METADATA_WORDS: usize = 3 * FRI_ROUNDS + EVALUATION_ITEMS
const OPENING_PADDING_START: u32 = OPENING_METADATA_START
    + COMPACT_METADATA_WORDS.downcast_truncate()
const QUERY_INDICES_START: u32 = OPENING_PADDING_START
    + (EVALUATION_PADDING + SIBLING_PADDING).downcast_truncate()
const QUERY_VALIDITY_START: u32 = QUERY_INDICES_START + QUERY_COUNT.downcast_truncate()
const QUERY_PADDING_START: u32 = QUERY_VALIDITY_START + QUERY_COUNT.downcast_truncate()
const OPENING_WORKSPACE_WORDS: usize = QUERY_PADDING_START as usize + QUERY_SAMPLE_PADDING

const fn fri_arena_layout() -> FriProverArenaLayout {
    FriProverArenaLayout {
        composition: FRI_COMPOSITION_START,
        composition_valid: FRI_COMPOSITION_VALID,
        evaluations: FRI_EVALUATIONS_START,
        evaluation_valid: FRI_EVALUATION_VALID_START,
        tree: FRI_TREE_START,
        node_valid: FRI_NODE_VALID_START,
        state: FRI_STATE_START,
        state_valid: FRI_STATE_VALID_START,
        tails: FRI_TAIL_START,
        progress: FRI_PROGRESS_START,
    }
}

const fn fri_control_layout() -> FriProverControlLayout {
    FriProverControlLayout {
        transcripts: FRI_TRANSCRIPTS_START,
        transcript_valid: FRI_TRANSCRIPT_VALID_START,
        challenges: FRI_CHALLENGES_START,
        challenge_valid: FRI_CHALLENGE_VALID_START,
        roots: FRI_ROOTS_START,
        root_valid: FRI_ROOT_VALID_START,
        round_cursor: FRI_ROUND_CURSOR,
        round_valid: FRI_ROUND_VALID,
        complete: FRI_PROVER_COMPLETE,
    }
}

const RETAINED_BASE_ROOT_NODE: u32 = 0

static_assert(PRODUCTION_LIMBS == 4)
static_assert(PRODUCTION_TRACE_LENGTH == 4096)
static_assert(SPARSE_BASE_AIR_FIELDS == 260)
static_assert(SPARSE_INTERACTION_AIR_FIELDS == 152)
static_assert(sparse_interaction_challenge_values() == 8)
static_assert(TRACE_GROUPS == 64)
static_assert(BASE_TRACE_WORDS == 1064960)
static_assert(INTERACTION_TRACE_WORDS == 622592)
static_assert(BASE_LDE_LENGTH == 8192)
