use std::conal::{Pair, RBin}
use std::webgpu::{
    CooperativeDispatch as Cooperate,
    ComputeInvocation,
    ComputeSurface as Kernel,
    FixedDispatch,
    FragmentSurface as Pixel,
    GpuProgram as Program,
    RepeatedDispatch,
    StorageBuffer as Shared,
    Workgroup as Threads,
    WebGpuBackend,
}

/// Keep every authored proof stage at one queue-ordered submission boundary.
/// Some browser GPU processes lose the device when the entire protocol graph
/// is encoded into one command buffer. This Fe-owned physical policy preserves
/// the dependency graph while letting the fixed host yield between stages.
type Grid<const X: usize, const Y: usize, const Z: usize> = Cooperate<FixedDispatch<X, Y, Z>, 1>
type Repeat<const X: usize, const Y: usize, const Z: usize, const N: usize> = Cooperate<
    RepeatedDispatch<X, Y, Z, N>,
    N,
>

const THREADS: usize = 64
const TRACE_GROUPS: usize = (PRODUCTION_TRACE_LENGTH + THREADS - 1) / THREADS
const BASE_TRACE_WORDS: usize = PRODUCTION_TRACE_LENGTH * SPARSE_BASE_AIR_FIELDS
const INTERACTION_TRACE_WORDS: usize = PRODUCTION_TRACE_LENGTH * SPARSE_INTERACTION_AIR_FIELDS
const BASE_LDE_LENGTH: usize = PRODUCTION_TRACE_LENGTH * 2
const BASE_LDE_WORDS: usize = BASE_LDE_LENGTH * SPARSE_BASE_AIR_FIELDS
const INTERACTION_LDE_WORDS: usize = BASE_LDE_LENGTH * SPARSE_INTERACTION_AIR_FIELDS
const LDE_INPUT_LANES: usize = PRODUCTION_TRACE_LENGTH / 2
const LDE_OUTPUT_LANES: usize = BASE_LDE_LENGTH / 2
const LDE_INPUT_GRID_LANES: usize = SPARSE_BASE_AIR_FIELDS * LDE_INPUT_LANES
const LDE_OUTPUT_GRID_LANES: usize = SPARSE_BASE_AIR_FIELDS * LDE_OUTPUT_LANES
const INTERACTION_INPUT_GRID_LANES: usize = SPARSE_INTERACTION_AIR_FIELDS * LDE_INPUT_LANES
const INTERACTION_OUTPUT_GRID_LANES: usize = SPARSE_INTERACTION_AIR_FIELDS * LDE_OUTPUT_LANES
const LDE_INPUT_GROUPS: usize = (LDE_INPUT_GRID_LANES + THREADS - 1) / THREADS
const LDE_OUTPUT_GROUPS: usize = (LDE_OUTPUT_GRID_LANES + THREADS - 1) / THREADS
const LDE_VALIDATION_GROUPS: usize = (SPARSE_BASE_AIR_FIELDS + THREADS - 1) / THREADS
const INTERACTION_INPUT_GROUPS: usize = (INTERACTION_INPUT_GRID_LANES + THREADS - 1) / THREADS
const INTERACTION_OUTPUT_GROUPS: usize = (INTERACTION_OUTPUT_GRID_LANES + THREADS - 1) / THREADS
const INTERACTION_VALIDATION_GROUPS: usize = (SPARSE_INTERACTION_AIR_FIELDS + THREADS - 1) / THREADS
const BASE_TREE_NODES: usize = ordered_binary_tree_nodes(BASE_LDE_LENGTH)
const BASE_TREE_WORDS: usize = ordered_binary_tree_digest_words(BASE_LDE_LENGTH)
const BASE_TREE_PARENT_TASKS: usize = ordered_binary_tree_parent_tasks(BASE_LDE_LENGTH)
const BASE_TREE_LEVELS: usize = ordered_binary_tree_levels(BASE_LDE_LENGTH)
const BASE_TREE_LEAF_GROUPS: usize = (BASE_LDE_LENGTH + THREADS - 1) / THREADS
const BASE_TREE_PARENT_GROUPS: usize = (BASE_TREE_PARENT_TASKS + THREADS - 1) / THREADS
const BASE_COMMITMENT_STEPS: usize = column_major_field_row_commitment_steps(
    4,
    SPARSE_BASE_AIR_FIELDS,
)
const BASE_COMMITMENT_WORKSPACE_WORDS: usize = column_major_field_row_commitment_workspace_words(
    BASE_LDE_LENGTH,
)
const CHALLENGE_GROUPS: usize = digest_squeeze_batch_workgroups(
    SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
    THREADS,
)
const CHALLENGE_WORKSPACE_WORDS: usize = digest_squeeze_batch_workspace_words(
    SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
)
const CHALLENGE_OUTPUT_WORDS: usize = digest_squeeze_batch_output_words(
    SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
)
type BaseLdeInputPlan = RBin<Pair, 12>
type BaseLdeOutputPlan = RBin<Pair, 13>
const LDE_INPUT_STAGES: usize = <BaseLdeInputPlan as FactorTree>::FACTORS
const LDE_OUTPUT_STAGES: usize = <BaseLdeOutputPlan as FactorTree>::FACTORS
const TRANSITION_WORKSPACE_WORDS: usize = transition_phase_workspace_words<PRODUCTION_LIMBS>()

static_assert(PRODUCTION_LIMBS == 4)
static_assert(PRODUCTION_TRACE_LENGTH == 4096)
static_assert(SPARSE_BASE_AIR_FIELDS == 260)
static_assert(SPARSE_INTERACTION_AIR_FIELDS == 152)
static_assert(sparse_interaction_challenge_values() == 8)
static_assert(TRACE_GROUPS == 64)
static_assert(BASE_TRACE_WORDS == 1064960)
static_assert(INTERACTION_TRACE_WORDS == 622592)
static_assert(BASE_LDE_LENGTH == 8192)
static_assert(BASE_LDE_WORDS == 2129920)
static_assert(INTERACTION_LDE_WORDS == 1245184)
static_assert(LDE_INPUT_GRID_LANES == 532480)
static_assert(LDE_OUTPUT_GRID_LANES == 1064960)
static_assert(INTERACTION_INPUT_GRID_LANES == 311296)
static_assert(INTERACTION_OUTPUT_GRID_LANES == 622592)
static_assert(LDE_INPUT_GROUPS == 8320)
static_assert(LDE_OUTPUT_GROUPS == 16640)
static_assert(LDE_VALIDATION_GROUPS == 5)
static_assert(INTERACTION_INPUT_GROUPS == 4864)
static_assert(INTERACTION_OUTPUT_GROUPS == 9728)
static_assert(INTERACTION_VALIDATION_GROUPS == 3)
static_assert(BASE_TREE_NODES == 16383)
static_assert(BASE_TREE_WORDS == 131064)
static_assert(BASE_TREE_PARENT_TASKS == 4096)
static_assert(BASE_TREE_LEVELS == 13)
static_assert(BASE_TREE_LEAF_GROUPS == 128)
static_assert(BASE_TREE_PARENT_GROUPS == 64)
static_assert(BASE_COMMITMENT_STEPS == 34)
static_assert(BASE_COMMITMENT_WORKSPACE_WORDS == 147456)
static_assert(SPARSE_LDE_INTERACTION_CHALLENGE_COUNT == 8)
static_assert(POSEIDON2_LANES == 16)
static_assert(DIGEST_SQUEEZE_STEPS == 89)
static_assert(CHALLENGE_GROUPS == 2)
static_assert(CHALLENGE_WORKSPACE_WORDS == 408)
static_assert(CHALLENGE_OUTPUT_WORDS == 40)
static_assert(BASE_TREE_WORDS <= BASE_TRACE_WORDS)
static_assert(BASE_TREE_NODES <= BASE_TRACE_WORDS)
static_assert(BASE_TREE_PARENT_TASKS <= PRODUCTION_TRACE_LENGTH)
static_assert(BASE_COMMITMENT_WORKSPACE_WORDS <= LDE_INPUT_GRID_LANES)
static_assert(CHALLENGE_WORKSPACE_WORDS <= LDE_INPUT_GRID_LANES)
static_assert(CHALLENGE_OUTPUT_WORDS <= PRODUCTION_TRACE_LENGTH)
static_assert(INTERACTION_TRACE_WORDS <= BASE_TRACE_WORDS)
static_assert(INTERACTION_TRACE_WORDS <= INTERACTION_LDE_WORDS)
static_assert(INTERACTION_INPUT_GRID_LANES <= LDE_INPUT_GRID_LANES)
static_assert(INTERACTION_OUTPUT_GRID_LANES <= BASE_TRACE_WORDS)
static_assert(<BaseLdeInputPlan as FactorTree>::POINTS == PRODUCTION_TRACE_LENGTH)
static_assert(<BaseLdeOutputPlan as FactorTree>::POINTS == BASE_LDE_LENGTH)
static_assert(LDE_INPUT_STAGES == 12)
static_assert(LDE_OUTPUT_STAGES == 13)
static_assert(TRANSITION_WORKSPACE_WORDS == 218)

const fn witness_groups(_ rows: usize) -> usize {
    (rows + THREADS - 1) / THREADS
}

const RADIX_GROUPS: usize = witness_groups(sparse_radix_task_count<PRODUCTION_LIMBS>() as usize)
const CARRY_GROUPS: usize = witness_groups(sparse_carry_task_count<PRODUCTION_LIMBS>() as usize)
const PRODUCT_GROUPS: usize = witness_groups(sparse_product_task_count<PRODUCTION_LIMBS>() as usize)
const ROUND_GROUPS: usize = witness_groups(sparse_round_task_count<PRODUCTION_LIMBS>() as usize)
const LINEAR_GROUPS: usize = witness_groups(sparse_linear_task_count<PRODUCTION_LIMBS>() as usize)
const BOUNDARY_GROUPS: usize = witness_groups(
    sparse_boundary_task_count<PRODUCTION_LIMBS>() as usize,
)
const PADDING_GROUPS: usize = witness_groups(
    PRODUCTION_TRACE_LENGTH - sparse_transition_task_count<PRODUCTION_LIMBS>() as usize,
)

fn directed_point() -> ComplexFixed<4> {
    ComplexFixed {
        real: Fixed { negative: true, limbs: [0, 0, 6144, 0] },
        imaginary: Fixed { negative: false, limbs: [0, 0, 1024, 0] },
    }
}

fn directed_current() -> ComplexFixed<4> {
    ComplexFixed {
        real: Fixed { negative: false, limbs: [0, 0, 2048, 1] },
        imaginary: Fixed { negative: true, limbs: [0, 0, 3072, 0] },
    }
}

actor ProductionSparseBaseTrace uses (Program<WebGpuBackend>) {
    transition_workspace: Shared<u32, TRANSITION_WORKSPACE_WORDS>,
    base_trace: Shared<u32, BASE_TRACE_WORDS>,
    validity: Shared<u32, PRODUCTION_TRACE_LENGTH>,
    lde_inverse_values: Shared<u32, BASE_TRACE_WORDS>,
    lde_inverse_progress: Shared<u32, LDE_INPUT_GRID_LANES>,
    lde_values: Shared<u32, BASE_LDE_WORDS>,
    lde_progress: Shared<u32, INTERACTION_LDE_WORDS>,

    fn derive_products(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<3, 1, 1>, Grid<1, 1, 1>>)
    {
        write_transition_product_witness_lane<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(directed_current(), self.transition_workspace, invocation)
    }

    fn derive_primary_linears(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<2, 1, 1>, Grid<1, 1, 1>>)
    {
        write_transition_primary_linear_witness_lane<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(self.transition_workspace, invocation)
    }

    fn derive_final_linears(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<2, 1, 1>, Grid<1, 1, 1>>)
    {
        write_transition_final_linear_witness_lane<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(directed_point(), self.transition_workspace, invocation)
    }

    fn finish_transition(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        finish_transition_witness_workspace<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(self.transition_workspace, invocation)
    }

    fn write_control(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<TRACE_GROUPS, 1, 1>,
            >
        )
    {
        write_sparse_base_air_partition_lane<
            SparseBaseControlPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(),
            directed_current(),
            self.transition_workspace,
            self.base_trace,
            self.validity,
            invocation,
        )
    }

    fn write_control_plan(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseControlPlanPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_control_link(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseControlLinkPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_radix_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<RADIX_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparseRadixWitnessFamily,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_carry_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<CARRY_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparseCarryWitnessFamily, PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH, TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS, PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_product_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<PRODUCT_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparseProductWitnessFamily, PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH, TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS, PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_round_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<ROUND_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparseRoundWitnessFamily, PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH, TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS, PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_linear_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<LINEAR_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparseLinearWitnessFamily, PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH, TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS, PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_boundary_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<BOUNDARY_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparseBoundaryWitnessFamily, PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH, TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS, PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_padding_witness(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<PADDING_GROUPS, 1, 1>>)
    {
        write_sparse_witness_family_lane<
            SparsePaddingWitnessFamily, PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH, TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS, PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_arithmetic_plan(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseArithmeticPlanPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_arithmetic_link(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseArithmeticLinkPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_round_plan(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseRoundPlanPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_linear_plan(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseLinearPlanPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn write_boundary_plan(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_base_air_partition_lane<
            SparseBaseBoundaryPlanPartition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            TRANSITION_WORKSPACE_WORDS,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            directed_point(), directed_current(), self.transition_workspace,
            self.base_trace, self.validity, invocation,
        )
    }

    fn finish_base_trace(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        if invocation.global.x != 0 { return }
        let mut row: u32 = 0
        let mut valid = true
        while row < PRODUCTION_TRACE_LENGTH.downcast_truncate() {
            valid = valid && self.validity.load(index: row) == 1
            row = row + 1
        }
        store_transition_phase_receipt<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(self.transition_workspace, valid)
    }

    fn prepare_lde_inverse(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<LDE_INPUT_GROUPS, 1, 1>>)
    {
        prepare_batched_stage_grid<
            SPARSE_BASE_AIR_FIELDS,
            PRODUCTION_TRACE_LENGTH,
            LDE_INPUT_LANES,
            BASE_TRACE_WORDS,
            BASE_TRACE_WORDS,
            LDE_INPUT_GRID_LANES,
        >(
            self.base_trace,
            0,
            self.lde_inverse_values,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn advance_lde_inverse(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<LDE_INPUT_GROUPS, 1, 1, LDE_INPUT_STAGES>,
            >
        )
    {
        inverse_batched_stage_grid_lane<
            SPARSE_BASE_AIR_FIELDS,
            PRODUCTION_TRACE_LENGTH,
            LDE_INPUT_LANES,
            BASE_TRACE_WORDS,
            LDE_INPUT_GRID_LANES,
            BabyBear,
            BaseLdeInputPlan,
        >(
            self.lde_inverse_values,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn validate_lde_inverse(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<LDE_VALIDATION_GROUPS, 1, 1>,
            >
        )
    {
        validate_batched_stage_grid<
            SPARSE_BASE_AIR_FIELDS,
            PRODUCTION_TRACE_LENGTH,
            LDE_INPUT_LANES,
            LDE_INPUT_GRID_LANES,
            BaseLdeInputPlan,
        >(self.lde_inverse_progress, invocation)
    }

    fn prepare_lde_forward(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<LDE_OUTPUT_GROUPS, 1, 1>>)
    {
        prepare_validated_batched_coset_extension<
            SPARSE_BASE_AIR_FIELDS,
            PRODUCTION_TRACE_LENGTH,
            BASE_LDE_LENGTH,
            LDE_INPUT_LANES,
            LDE_OUTPUT_LANES,
            BASE_TRACE_WORDS,
            LDE_INPUT_GRID_LANES,
            BASE_LDE_WORDS,
            INTERACTION_LDE_WORDS,
            BabyBear,
            BaseLdeInputPlan,
            BaseLdeOutputPlan,
        >(
            self.lde_inverse_values,
            self.lde_inverse_progress,
            self.lde_values,
            self.lde_progress,
            BabyBear::from_u32(7),
            invocation,
        )
    }

    fn advance_lde_forward(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<LDE_OUTPUT_GROUPS, 1, 1, LDE_OUTPUT_STAGES>,
            >
        )
    {
        forward_batched_stage_grid_lane<
            SPARSE_BASE_AIR_FIELDS,
            BASE_LDE_LENGTH,
            LDE_OUTPUT_LANES,
            BASE_LDE_WORDS,
            INTERACTION_LDE_WORDS,
            BabyBear,
            BaseLdeOutputPlan,
        >(self.lde_values, self.lde_progress, invocation)
    }

    fn validate_lde_forward(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<LDE_VALIDATION_GROUPS, 1, 1>,
            >
        )
    {
        let validation = validate_batched_stage_grid<
            SPARSE_BASE_AIR_FIELDS,
            BASE_LDE_LENGTH,
            LDE_OUTPUT_LANES,
            INTERACTION_LDE_WORDS,
            BaseLdeOutputPlan,
        >(self.lde_progress, invocation)
        if validation.active {
            self.validity.store(
                index: validation.batch,
                value: if validation.valid { 1 } else { 0 },
            )
        }
    }

    fn finish_lde(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        if invocation.global.x != 0 { return }
        let mut column: u32 = 0
        let mut valid = load_transition_phase_receipt<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(self.transition_workspace)
        while column < SPARSE_BASE_AIR_FIELDS.downcast_truncate() {
            valid = valid && self.validity.load(index: column) == 1
            column = column + 1
        }
        store_transition_phase_receipt<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(self.transition_workspace, valid)
    }

    /// The completed LDE retires the inverse values and transform cursors.
    /// Reuse those phase-local allocations as the ordered tree digest arena,
    /// node validity, and private parent cursors. The base trace remains live
    /// until it has generated the interaction trace.
    fn prepare_base_lde_commitments(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<BASE_TREE_LEAF_GROUPS, 1, 1>,
            >
        )
    {
        prepare_column_major_field_row_commitments<
            BASE_LDE_LENGTH,
            LDE_INPUT_GRID_LANES,
        >(self.lde_inverse_progress, invocation)
    }

    fn advance_base_lde_commitments(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<
                    BASE_TREE_LEAF_GROUPS,
                    1,
                    1,
                    BASE_COMMITMENT_STEPS,
                >,
            >
        )
    {
        let row = invocation.global.x
        if row >= BASE_LDE_LENGTH.downcast_truncate() { return }
        let prefix = [
            BabyBear::from_u32(PRODUCTION_LIMBS.downcast_truncate()),
            BabyBear::from_u32(PRODUCTION_TRACE_LENGTH.downcast_truncate()),
            BabyBear::from_u32(BASE_LDE_LENGTH.downcast_truncate()),
            BabyBear::from_u32(row),
        ]
        let step = advance_column_major_field_row_commitments<
            MandelbrotSparseBaseLdeLeafBabyBearV1,
            BASE_LDE_LENGTH,
            SPARSE_BASE_AIR_FIELDS,
            BASE_LDE_WORDS,
            4,
            LDE_INPUT_GRID_LANES,
        >(
            self.lde_values,
            self.lde_inverse_progress,
            ref prefix,
            invocation,
        )
        if step.complete {
            write_ordered_binary_tree_leaf<
                BASE_LDE_LENGTH,
                BASE_TRACE_WORDS,
                INTERACTION_LDE_WORDS,
            >(
                self.lde_inverse_values,
                self.lde_progress,
                step.row,
                step.commitment.require(
                    load_transition_phase_receipt<
                        PRODUCTION_LIMBS,
                        TRANSITION_WORKSPACE_WORDS,
                    >(self.transition_workspace),
                ),
            )
        }
    }

    fn prepare_base_lde_tree(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<BASE_TREE_PARENT_GROUPS, 1, 1>,
            >
        )
    {
        prepare_ordered_binary_tree<
            BASE_LDE_LENGTH,
            PRODUCTION_TRACE_LENGTH,
        >(self.validity, invocation)
    }

    fn advance_base_lde_tree(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<
                    BASE_TREE_PARENT_GROUPS,
                    1,
                    1,
                    BASE_TREE_LEVELS,
                >,
            >
        )
    {
        advance_ordered_binary_tree<
            BASE_LDE_LENGTH,
            BASE_TREE_LEVELS,
            BASE_TRACE_WORDS,
            INTERACTION_LDE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(
            self.lde_inverse_values,
            self.lde_progress,
            self.validity,
            invocation,
        )
    }

    fn finish_base_lde_tree(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        if invocation.global.x != 0 { return }
        let root = finish_ordered_binary_tree<
            BASE_LDE_LENGTH,
            BASE_TREE_LEVELS,
            BASE_TRACE_WORDS,
            INTERACTION_LDE_WORDS,
            PRODUCTION_TRACE_LENGTH,
        >(self.lde_inverse_values, self.lde_progress, self.validity)
        self.lde_progress.store(
            index: (BASE_TREE_NODES - 1).downcast_truncate(),
            value: if root.valid { 1 } else { 0 },
        )
    }

    fn prepare_base_lde_challenges(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<CHALLENGE_GROUPS, 1, 1>,
            >
        )
    {
        prepare_digest_squeeze_batch<
            SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
            LDE_INPUT_GRID_LANES,
            PRODUCTION_TRACE_LENGTH,
        >(
            self.lde_inverse_progress,
            self.validity,
            invocation,
        )
    }

    fn advance_base_lde_challenges(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<
                    CHALLENGE_GROUPS,
                    1,
                    1,
                    DIGEST_SQUEEZE_STEPS,
                >,
            >
        )
    {
        let state = invocation.global.x
            / POSEIDON2_LANES.downcast_truncate()
        if state >= SPARSE_LDE_INTERACTION_CHALLENGE_COUNT.downcast_truncate() {
            return
        }
        let root: u32 = (BASE_TREE_NODES - 1).downcast_truncate()
        advance_digest_squeeze_batch_lane<
            SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
            LDE_INPUT_GRID_LANES,
            PRODUCTION_TRACE_LENGTH,
        >(
            self.lde_inverse_progress,
            self.validity,
            invocation,
            sparse_lde_interaction_challenge_domain_tag(state),
            load_poseidon2_digest(self.lde_inverse_values, root),
            self.lde_progress.load(index: root) == 1,
        )
    }

    fn finish_base_lde_challenges(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        if invocation.global.x != 0 { return }
        let root: u32 = (BASE_TREE_NODES - 1).downcast_truncate()
        let valid = self.lde_progress.load(index: root) == 1
            && finish_digest_squeeze_batch<
                SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
                LDE_INPUT_GRID_LANES,
                PRODUCTION_TRACE_LENGTH,
            >(self.lde_inverse_progress, self.validity)
        self.lde_progress.store(
            index: root,
            value: if valid { 1 } else { 0 },
        )
    }

    fn write_interaction_product_locals(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_product_interaction_local_lane<
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            BASE_LDE_LENGTH,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
            INTERACTION_LDE_WORDS,
            LDE_INPUT_GRID_LANES,
        >(
            self.base_trace, self.validity, self.lde_progress,
            self.lde_inverse_progress, invocation,
        )
    }

    fn write_interaction_round_locals(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_round_interaction_local_lane<
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            BASE_LDE_LENGTH,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
            INTERACTION_LDE_WORDS,
            LDE_INPUT_GRID_LANES,
        >(
            self.base_trace, self.validity, self.lde_progress,
            self.lde_inverse_progress, invocation,
        )
    }

    fn write_interaction_linear_locals(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_linear_interaction_local_lane<
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            BASE_LDE_LENGTH,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
            INTERACTION_LDE_WORDS,
            LDE_INPUT_GRID_LANES,
        >(
            self.base_trace, self.validity, self.lde_progress,
            self.lde_inverse_progress, invocation,
        )
    }

    fn write_interaction_boundary_locals(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<TRACE_GROUPS, 1, 1>>)
    {
        write_sparse_boundary_interaction_local_lane<
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            BASE_LDE_LENGTH,
            BASE_TRACE_WORDS,
            PRODUCTION_TRACE_LENGTH,
            INTERACTION_LDE_WORDS,
            LDE_INPUT_GRID_LANES,
        >(
            self.base_trace, self.validity, self.lde_progress,
            self.lde_inverse_progress, invocation,
        )
    }

    fn finish_interaction_locals(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        if invocation.global.x != 0 { return }
        let mut row: u32 = 0
        let mut valid = true
        while row < PRODUCTION_TRACE_LENGTH.downcast_truncate() {
            valid = valid && self.lde_inverse_progress.load(index: row) == 1
            row = row + 1
        }
        store_transition_phase_receipt<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(self.transition_workspace, valid)
    }

    /// The base trace is retired once every interaction row is materialized.
    /// Reuse it for the smaller interaction inverse transform, then reuse the
    /// interaction-trace allocation for the larger coset codeword. The base
    /// LDE remains untouched for composition and authenticated openings.
    fn prepare_interaction_lde_inverse(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<INTERACTION_INPUT_GROUPS, 1, 1>>)
    {
        prepare_batched_stage_grid<
            SPARSE_INTERACTION_AIR_FIELDS,
            PRODUCTION_TRACE_LENGTH,
            LDE_INPUT_LANES,
            INTERACTION_LDE_WORDS,
            BASE_TRACE_WORDS,
            LDE_INPUT_GRID_LANES,
        >(
            self.lde_progress,
            0,
            self.base_trace,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn advance_interaction_lde_inverse(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<INTERACTION_INPUT_GROUPS, 1, 1, LDE_INPUT_STAGES>,
            >
        )
    {
        inverse_batched_stage_grid_lane<
            SPARSE_INTERACTION_AIR_FIELDS,
            PRODUCTION_TRACE_LENGTH,
            LDE_INPUT_LANES,
            BASE_TRACE_WORDS,
            LDE_INPUT_GRID_LANES,
            BabyBear,
            BaseLdeInputPlan,
        >(
            self.base_trace,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn validate_interaction_lde_inverse(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<INTERACTION_VALIDATION_GROUPS, 1, 1>,
            >
        )
    {
        validate_batched_stage_grid<
            SPARSE_INTERACTION_AIR_FIELDS,
            PRODUCTION_TRACE_LENGTH,
            LDE_INPUT_LANES,
            LDE_INPUT_GRID_LANES,
            BaseLdeInputPlan,
        >(self.lde_inverse_progress, invocation)
    }

    fn prepare_interaction_lde_forward(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<INTERACTION_OUTPUT_GROUPS, 1, 1>>)
    {
        prepare_validated_batched_coset_extension<
            SPARSE_INTERACTION_AIR_FIELDS,
            PRODUCTION_TRACE_LENGTH,
            BASE_LDE_LENGTH,
            LDE_INPUT_LANES,
            LDE_OUTPUT_LANES,
            BASE_TRACE_WORDS,
            LDE_INPUT_GRID_LANES,
            INTERACTION_LDE_WORDS,
            BASE_TRACE_WORDS,
            BabyBear,
            BaseLdeInputPlan,
            BaseLdeOutputPlan,
        >(
            self.base_trace,
            self.lde_inverse_progress,
            self.lde_progress,
            self.lde_inverse_values,
            BabyBear::from_u32(7),
            invocation,
        )
    }

    fn advance_interaction_lde_forward(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<INTERACTION_OUTPUT_GROUPS, 1, 1, LDE_OUTPUT_STAGES>,
            >
        )
    {
        forward_batched_stage_grid_lane<
            SPARSE_INTERACTION_AIR_FIELDS,
            BASE_LDE_LENGTH,
            LDE_OUTPUT_LANES,
            INTERACTION_LDE_WORDS,
            BASE_TRACE_WORDS,
            BabyBear,
            BaseLdeOutputPlan,
        >(self.lde_progress, self.lde_inverse_values, invocation)
    }

    fn validate_interaction_lde_forward(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Grid<INTERACTION_VALIDATION_GROUPS, 1, 1>,
            >
        )
    {
        let validation = validate_batched_stage_grid<
            SPARSE_INTERACTION_AIR_FIELDS,
            BASE_LDE_LENGTH,
            LDE_OUTPUT_LANES,
            BASE_TRACE_WORDS,
            BaseLdeOutputPlan,
        >(self.lde_inverse_values, invocation)
        if validation.active {
            self.validity.store(
                index: validation.batch,
                value: if validation.valid { 1 } else { 0 },
            )
        }
    }

    fn finish_interaction_lde(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        if invocation.global.x != 0 { return }
        let mut column: u32 = 0
        let mut valid = load_transition_phase_receipt<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(self.transition_workspace)
        while column < SPARSE_INTERACTION_AIR_FIELDS.downcast_truncate() {
            valid = valid && self.validity.load(index: column) == 1
            column = column + 1
        }
        store_transition_phase_receipt<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(self.transition_workspace, valid)
    }

    fn paint(self, px: i32, py: i32) -> i32 uses (Pixel) {
        let color: u32 = if load_transition_phase_receipt<
            PRODUCTION_LIMBS,
            TRANSITION_WORKSPACE_WORDS,
        >(self.transition_workspace) {
            4278255360
        } else {
            4294901760
        }
        color.downcast_truncate()
    }
}
