}
use poseidon_baby_bear::Poseidon2Digest
use precision::baby_bear::{BabyBear, BabyBearExt4}

fn geometry_words(_ geometry: mandelbrot_proof_air_core::Radix2QueryGeometry) -> (
    u32, u32, u32, u32, u32, u32,
) {
    (
        if geometry.valid { 1 } else { 0 },
        geometry.evaluation,
        geometry.next_evaluation,
        geometry.negative_evaluation,
        geometry.negative_next_evaluation,
        geometry.local_index,
    )
}

pub fn query_geometry4x16(_ query_index: u32) -> (u32, u32, u32, u32, u32, u32) {
    geometry_words(mandelbrot_proof_air_core::radix2_query_geometry<4, 16>(query_index))
}

pub fn query_geometry8x64(_ query_index: u32) -> (u32, u32, u32, u32, u32, u32) {
    geometry_words(mandelbrot_proof_air_core::radix2_query_geometry<8, 64>(query_index))
}

fn digest8(_ base: u32) -> Poseidon2Digest {
    Poseidon2Digest::from_u32s([
        base, base + 1, base + 2, base + 3,
        base + 4, base + 5, base + 6, base + 7,
    ])
}

fn fri_pattern8(_ seed: u32) -> [BabyBearExt4; 8] {
    let mut values = [BabyBearExt4::zero(); 8]
    let mut index: usize = 0
    while index < 8 {
        let i: u32 = index.downcast_truncate()
        values[index] = BabyBearExt4::from_u32s([
            seed + i,
            seed + 17 + i,
            seed + 37 + i + i,
            seed + 71 + i + i + i,
        ])
        index = index + 1
    }
    values
}

fn fri_pattern16(_ seed: u32) -> [BabyBearExt4; 16] {
    let mut values = [BabyBearExt4::zero(); 16]
    let mut index: usize = 0
    while index < 16 {
        let i: u32 = index.downcast_truncate()
        values[index] = BabyBearExt4::from_u32s([
            seed + i,
            seed + 17 + i,
            seed + 37 + i + i,
            seed + 71 + i + i + i,
        ])
        index = index + 1
    }
    values
}

fn row(
    _ step: u32,
    _ zr_sign: u32, _ zr: u32,
    _ zi_sign: u32, _ zi: u32,
    _ rr: u32, _ ii: u32, _ magnitude: u32,
    _ q_re_sign: u32, _ q_re: u32, _ r_re: u32,
    _ q_im_sign: u32, _ q_im: u32, _ r_im: u32,
    _ air_terminal: u32, _ active: u32, _ terminal: u32,
) -> EncodedProofRow {
    EncodedProofRow {
        active: active,
        terminal: terminal,
        air: EncodedAirRow {
            step: step,
            zr: SignedWord { sign: zr_sign, magnitude: zr },
            zi: SignedWord { sign: zi_sign, magnitude: zi },
            rr: rr,
            ii: ii,
            magnitude: magnitude,
            q_re: SignedWord { sign: q_re_sign, magnitude: q_re },
            r_re: r_re,
            q_im: SignedWord { sign: q_im_sign, magnitude: q_im },
            r_im: r_im,
            terminal: air_terminal,
        },
    }
}

pub fn encoded_row(
    _ step: u32,
    _ zr_sign: u32, _ zr: u32,
    _ zi_sign: u32, _ zi: u32,
    _ rr: u32, _ ii: u32, _ magnitude: u32,
    _ q_re_sign: u32, _ q_re: u32, _ r_re: u32,
    _ q_im_sign: u32, _ q_im: u32, _ r_im: u32,
    _ air_terminal: u32, _ active: u32, _ terminal: u32,
) -> (
    u32, u32, u32, u32, u32, u32, u32, u32, u32,
    u32, u32, u32, u32, u32, u32, u32, u32,
) {
    let row = row(
        step,
        zr_sign, zr,
        zi_sign, zi,
        rr, ii, magnitude,
        q_re_sign, q_re, r_re,
        q_im_sign, q_im, r_im,
        air_terminal, active, terminal,
    )
    let packed = encoded_row_fields(row)
    let digest = row_commitment(row)
    (
        if packed.is_valid() { 1 } else { 0 },
        packed.len_bits(),
        packed.field(0).to_u32(), packed.field(1).to_u32(),
        packed.field(2).to_u32(), packed.field(3).to_u32(),
        packed.field(4).to_u32(), packed.field(5).to_u32(),
        packed.field(6).to_u32(),
        digest.value.field(0).to_u32(), digest.value.field(1).to_u32(),
        digest.value.field(2).to_u32(), digest.value.field(3).to_u32(),
        digest.value.field(4).to_u32(), digest.value.field(5).to_u32(),
        digest.value.field(6).to_u32(), digest.value.field(7).to_u32(),
    )
}

pub fn encoded_auxiliary(
    _ step: u32,
    _ zr_sign: u32, _ zr: u32,
    _ zi_sign: u32, _ zi: u32,
    _ rr: u32, _ ii: u32, _ magnitude: u32,
    _ q_re_sign: u32, _ q_re: u32, _ r_re: u32,
    _ q_im_sign: u32, _ q_im: u32, _ r_im: u32,
    _ air_terminal: u32, _ active: u32, _ terminal: u32,
) -> (
    u32, u32,
    u32, u32, u32, u32, u32, u32, u32,
    u32, u32, u32, u32, u32, u32, u32,
    u32, u32, u32, u32, u32, u32, u32, u32,
) {
    let row = row(
        step,
        zr_sign, zr,
        zi_sign, zi,
        rr, ii, magnitude,
        q_re_sign, q_re, r_re,
        q_im_sign, q_im, r_im,
        air_terminal, active, terminal,
    )
    let packed = encoded_auxiliary_fields(row)
    let digest = auxiliary_commitment(row)
    (
        if packed.is_valid() { 1 } else { 0 },
        packed.len_bits(),
        packed.field(0).to_u32(), packed.field(1).to_u32(),
        packed.field(2).to_u32(), packed.field(3).to_u32(),
        packed.field(4).to_u32(), packed.field(5).to_u32(),
        packed.field(6).to_u32(), packed.field(7).to_u32(),
        packed.field(8).to_u32(), packed.field(9).to_u32(),
        packed.field(10).to_u32(), packed.field(11).to_u32(),
        packed.field(12).to_u32(), packed.field(13).to_u32(),
        digest.value.field(0).to_u32(), digest.value.field(1).to_u32(),
        digest.value.field(2).to_u32(), digest.value.field(3).to_u32(),
        digest.value.field(4).to_u32(), digest.value.field(5).to_u32(),
        digest.value.field(6).to_u32(), digest.value.field(7).to_u32(),
    )
}

pub fn encoded_public(
    _ c_re_sign: u32, _ c_re: u32,
    _ c_im_sign: u32, _ c_im: u32,
    _ bound: u32, _ terminal_step: u32,
    _ trace_length: u32, _ padded_length: u32,
) -> (
    u32, u32, u32, u32, u32, u32,
    u32, u32, u32, u32, u32, u32, u32, u32,
) {
    let public = EscapesByQ12Public {
        c_re: SignedWord { sign: c_re_sign, magnitude: c_re },
        c_im: SignedWord { sign: c_im_sign, magnitude: c_im },
        bound: bound,
        terminal_step: terminal_step,
        trace_length: trace_length,
        padded_length: padded_length,
    }
    let packed = encoded_public_fields(public)
    let digest = public_commitment(public)
    (
        if packed.is_valid() { 1 } else { 0 },
        packed.len_bits(),
        packed.field(0).to_u32(), packed.field(1).to_u32(),
        packed.field(2).to_u32(), packed.field(3).to_u32(),
        digest.value.field(0).to_u32(), digest.value.field(1).to_u32(),
        digest.value.field(2).to_u32(), digest.value.field(3).to_u32(),
        digest.value.field(4).to_u32(), digest.value.field(5).to_u32(),
        digest.value.field(6).to_u32(), digest.value.field(7).to_u32(),
    )
}

pub fn trace_root4(
    _ leaf0: u32,
    _ leaf1: u32,
    _ leaf2: u32,
    _ leaf3: u32,
    _ invalid_mask: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32, u32) {
    let root = trace_root_power_of_two<4>([
        RowDigest { valid: (invalid_mask & 1) == 0, value: digest8(leaf0) },
        RowDigest { valid: (invalid_mask & 2) == 0, value: digest8(leaf1) },
        RowDigest { valid: (invalid_mask & 4) == 0, value: digest8(leaf2) },
        RowDigest { valid: (invalid_mask & 8) == 0, value: digest8(leaf3) },
    ])
    (
        if root.valid { 1 } else { 0 },
        root.value.field(0).to_u32(), root.value.field(1).to_u32(),
        root.value.field(2).to_u32(), root.value.field(3).to_u32(),
        root.value.field(4).to_u32(), root.value.field(5).to_u32(),
        root.value.field(6).to_u32(), root.value.field(7).to_u32(),
    )
}

pub fn auxiliary_root4(
    _ leaf0: u32,
    _ leaf1: u32,
    _ leaf2: u32,
    _ leaf3: u32,
    _ invalid_mask: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32, u32) {
    let root = auxiliary_root_power_of_two<4>([
        AuxiliaryDigest { valid: (invalid_mask & 1) == 0, value: digest8(leaf0) },
        AuxiliaryDigest { valid: (invalid_mask & 2) == 0, value: digest8(leaf1) },
        AuxiliaryDigest { valid: (invalid_mask & 4) == 0, value: digest8(leaf2) },
        AuxiliaryDigest { valid: (invalid_mask & 8) == 0, value: digest8(leaf3) },
    ])
    (
        if root.valid { 1 } else { 0 },
        root.value.field(0).to_u32(), root.value.field(1).to_u32(),
        root.value.field(2).to_u32(), root.value.field(3).to_u32(),
        root.value.field(4).to_u32(), root.value.field(5).to_u32(),
        root.value.field(6).to_u32(), root.value.field(7).to_u32(),
    )
}

pub fn bind_roots(
    _ public: u32,
    _ trace: u32,
    _ auxiliary: u32,
    _ invalid_mask: u32,
) -> (
    u32, u32, u32, u32, u32, u32, u32, u32, u32,
    u32, u32, u32, u32, u32, u32, u32, u32, u32,
) {
    let statement = bind_statement(
        PublicDigest {
            valid: (invalid_mask & 1) == 0,
            value: digest8(public),
        },
        RowDigest {
            valid: (invalid_mask & 2) == 0,
            value: digest8(trace),
        },
    )
    let transcript = bind_auxiliary_trace(
        statement,
        AuxiliaryDigest {
            valid: (invalid_mask & 4) == 0,
            value: digest8(auxiliary),
        },
    )
    (
        if statement.valid { 1 } else { 0 },
        statement.value.field(0).to_u32(), statement.value.field(1).to_u32(),
        statement.value.field(2).to_u32(), statement.value.field(3).to_u32(),
        statement.value.field(4).to_u32(), statement.value.field(5).to_u32(),
        statement.value.field(6).to_u32(), statement.value.field(7).to_u32(),
        if transcript.valid { 1 } else { 0 },
        transcript.value.field(0).to_u32(), transcript.value.field(1).to_u32(),
        transcript.value.field(2).to_u32(), transcript.value.field(3).to_u32(),
        transcript.value.field(4).to_u32(), transcript.value.field(5).to_u32(),
        transcript.value.field(6).to_u32(), transcript.value.field(7).to_u32(),
    )
}

pub fn composition_challenge4(_ transcript: u32, _ valid: u32) -> (u32, u32, u32, u32, u32) {
    let challenge = composition_challenge(
        AirLdeTranscriptDigest {
            valid: valid == 1,
            value: digest8(transcript),
        },
    )
    let words = challenge.value.to_u32s()
    (
        if challenge.valid { 1 } else { 0 },
        words[0],
        words[1],
        words[2],
        words[3],
    )
}

pub fn air_transcript(
    _ proof: u32,
    _ main: u32,
    _ auxiliary: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let main_transcript = bind_main_lde(
        ProofTranscriptDigest { valid: true, value: digest8(proof) },
        MainLdeDigest { valid: true, value: digest8(main) },
    )
    let air = bind_auxiliary_lde(
        main_transcript,
        AuxiliaryLdeDigest { valid: true, value: digest8(auxiliary) },
    ).value
    (
        air.field(0).to_u32(), air.field(1).to_u32(),
        air.field(2).to_u32(), air.field(3).to_u32(),
        air.field(4).to_u32(), air.field(5).to_u32(),
        air.field(6).to_u32(), air.field(7).to_u32(),
    )
}

pub fn composition_transcript(
    _ air: u32,
    _ composition: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let digest = bind_composition(
        AirLdeTranscriptDigest { valid: true, value: digest8(air) },
        CompositionDigest { valid: true, value: digest8(composition) },
    ).value
    (
        digest.field(0).to_u32(), digest.field(1).to_u32(),
        digest.field(2).to_u32(), digest.field(3).to_u32(),
        digest.field(4).to_u32(), digest.field(5).to_u32(),
        digest.field(6).to_u32(), digest.field(7).to_u32(),
    )
}

pub fn fri_challenge1(_ transcript: u32) -> (u32, u32, u32, u32) {
    let words = fri_fold_challenge(
        CompositionTranscriptDigest { valid: true, value: digest8(transcript) },
    ).value.to_u32s()
    (words[0], words[1], words[2], words[3])
}

pub fn fri_challenge2(_ transcript: u32) -> (u32, u32, u32, u32) {
    let words = next_fri_fold_challenge<1, 2>(
        FriLayerTranscriptDigest<1> { valid: true, value: digest8(transcript) },
    ).value.to_u32s()
    (words[0], words[1], words[2], words[3])
}

pub fn fri_row1(
    _ c0: u32, _ c1: u32, _ c2: u32, _ c3: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let digest = fri_layer_row_commitment<1>(BabyBearExt4::from_u32s([c0, c1, c2, c3])).value
    (
        digest.field(0).to_u32(), digest.field(1).to_u32(),
        digest.field(2).to_u32(), digest.field(3).to_u32(),
        digest.field(4).to_u32(), digest.field(5).to_u32(),
        digest.field(6).to_u32(), digest.field(7).to_u32(),
    )
}

pub fn fri_fold8x4(
    _ seed: u32,
    _ beta0: u32, _ beta1: u32, _ beta2: u32, _ beta3: u32,
    _ shift: u32,
) -> (
    u32,
    u32, u32, u32, u32,
    u32, u32, u32, u32,
    u32, u32, u32, u32,
    u32, u32, u32, u32,
) {
    let folded = fold_fri_evaluations<8, 4>(
        fri_pattern8(seed),
        BabyBearExt4::from_u32s([beta0, beta1, beta2, beta3]),
        BabyBear::from_u32(shift),
    )
    let f0 = folded.evaluations[0].to_u32s()
    let f1 = folded.evaluations[1].to_u32s()
    let f2 = folded.evaluations[2].to_u32s()
    let f3 = folded.evaluations[3].to_u32s()
    (
        if folded.valid { 1 } else { 0 },
        f0[0], f0[1], f0[2], f0[3],
        f1[0], f1[1], f1[2], f1[3],
        f2[0], f2[1], f2[2], f2[3],
        f3[0], f3[1], f3[2], f3[3],
    )
}

pub fn fri_chain16_component(
    _ seed: u32,
    _ transcript: u32,
    _ shift: u32,
    _ component: u32,
) -> (u32, u32, u32, u32, u32, u32, u32) {
    if component >= 8 { return (0, 0, 0, 0, 0, 0, 0) }
    let proof = fold_all_fri16(
        fri_pattern16(seed),
        CompositionTranscriptDigest { valid: true, value: digest8(transcript) },
        BabyBear::from_u32(shift),
    )
    let c: usize = component as usize
    let final_words = proof.final_round.evaluation.to_u32s()
    (
        if proof.valid { 1 } else { 0 },
        proof.first.root.value.field(component).to_u32(),
        proof.second.root.value.field(component).to_u32(),
        proof.third.root.value.field(component).to_u32(),
        proof.final_round.root.value.field(component).to_u32(),
        if component < 4 { final_words[c] } else { 0 },
        proof.final_round.transcript.value.field(component).to_u32(),
    )
}

pub fn fri_query1(_ transcript: u32) -> (u32, u32, u32) {
    let challenge = fri_query_challenge<4, 1>(
        FriLayerTranscriptDigest<4> { valid: true, value: digest8(transcript) },
    )
    let index = fri_query_index_power_of_two<1, 8>(challenge)
    (
        if challenge.valid && index.valid { 1 } else { 0 },
        challenge.value.to_u32(),
        index.value,
    )
}

pub fn fri_query16_status(
    _ seed: u32,
    _ air_transcript: u32,
    _ shift: u32,
) -> (u32, u32, u32) {
    let air = AirLdeTranscriptDigest {
        valid: true,
        value: digest8(air_transcript),
    }
    let proof = open_fri_commitment_query16(
        fri_pattern16(seed),
        air,
        BabyBear::from_u32(shift),
    )
    (
        if proof.valid { 1 } else { 0 },
        if verify_fri_commitment_query16(air, BabyBear::from_u32(shift), proof) {
            1
        } else {
            0
        },
        proof.query_index,
    )
}

pub fn fri_query16_mutation(
    _ seed: u32,
    _ air_transcript: u32,
    _ shift: u32,
    _ mutation: u32,
) -> u32 {
    let air = AirLdeTranscriptDigest {
        valid: true,
        value: digest8(air_transcript),
    }
    let mut proof = open_fri_commitment_query16(
        fri_pattern16(seed),
        air,
        BabyBear::from_u32(shift),
    )
    if mutation == 1 {
        proof.query_index = proof.query_index ^ 1
    } else if mutation == 2 {
        proof.composition.positive = proof.composition.positive + BabyBearExt4::one()
    } else if mutation == 3 {
        proof.first.negative = proof.first.negative + BabyBearExt4::one()
    } else if mutation == 4 {
        proof.second.path.index = proof.second.path.index ^ 1
    } else if mutation == 5 {
        proof.first.path.positive_siblings[0] = digest8(997)
    } else if mutation == 6 {
        proof.final_evaluation = proof.final_evaluation + BabyBearExt4::one()
    } else if mutation == 7 {
        proof.third_root.value = digest8(991)
    } else if mutation == 8 {
        proof.valid = false
    }
    let verifier_air = AirLdeTranscriptDigest {
        valid: true,
        value: digest8(if mutation == 9 { air_transcript + 1 } else { air_transcript }),
    }
    if verify_fri_commitment_query16(
        verifier_air,
        BabyBear::from_u32(shift),
        proof,
    ) {
        1
    } else {
        0
    }
}

fn write_air_lde_row(_ seed: u32, _ evaluation: u32, _ row: mut AirLdeRow) {
    let mut column: usize = 0
    while column < mandelbrot_proof_baby_bear::MAIN_LDE_ROW_FIELDS {
        let column_u32: u32 = column.downcast_truncate()
        row.main[column] = BabyBear::from_u32(
            (seed + evaluation * 1009 + column_u32 * 37) % 1900000007,
        )
        column = column + 1
    }
    column = 0
    while column < mandelbrot_proof_kernel::AUXILIARY_ROW_BITS {
        let column_u32: u32 = column.downcast_truncate()
        row.auxiliary[column] = BabyBear::from_u32(
            (seed + 700001 + evaluation * 4001 + column_u32 * 53) % 1900000007,
        )
        column = column + 1
    }
}

/// Exercise the production seam from authenticated BabyBear LDE rows through
/// the shared AIR and into one FRI composition pair. The eight returned field
/// words let the Rust gate independently reconstruct both composition values;
/// the first lane records verifier acceptance after a selected mutation.
pub fn air_composition_query16(
    _ seed: u32,
    _ query_index: u32,
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ beta0: u32,
    _ beta1: u32,
    _ beta2: u32,
    _ beta3: u32,
    _ shift: u32,
    _ mutation: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32, u32) {
    if query_index >= 8 {
        return (0, 0, 0, 0, 0, 0, 0, 0, 0)
    }
    let mut rows = [mandelbrot_proof_baby_bear::ZERO_AIR_LDE_ROW; 16]
    let mut main_leaves = [MainLdeDigest {
        valid: false,
        value: Poseidon2Digest::zero(),
    }; 16]
    let mut auxiliary_leaves = [AuxiliaryLdeDigest {
        valid: false,
        value: Poseidon2Digest::zero(),
    }; 16]
    let mut evaluation: usize = 0
    while evaluation < 16 {
        let evaluation_u32: u32 = evaluation.downcast_truncate()
        write_air_lde_row(seed, evaluation_u32, mut rows[evaluation])
        main_leaves[evaluation] = main_lde_row_commitment(rows[evaluation].main)
        auxiliary_leaves[evaluation] = auxiliary_lde_row_commitment(
            rows[evaluation].auxiliary,
        )
        evaluation = evaluation + 1
    }
    let mut main_root = main_lde_root_power_of_two<16>(main_leaves)
    let auxiliary_root = auxiliary_lde_root_power_of_two<16>(auxiliary_leaves)
    let local_index = query_index & 3
    let local: usize = local_index as usize
    let main_path = main_lde_quartet_path_power_of_two<16, 4, 2>(
        main_leaves,
        local_index,
    )
    let auxiliary_path = auxiliary_lde_quartet_path_power_of_two<16, 4, 2>(
        auxiliary_leaves,
        local_index,
    )
    let mut opening = Checkpoint4AirLdeOpening<2> {
        valid: main_path.valid && auxiliary_path.valid,
        rows: [mandelbrot_proof_baby_bear::ZERO_AIR_LDE_ROW; 4],
        main_path: main_path,
        auxiliary_path: auxiliary_path,
    }
    opening.rows[0] = rows[local]
    opening.rows[1] = rows[local + 4]
    opening.rows[2] = rows[local + 8]
    opening.rows[3] = rows[local + 12]

    let mut challenge = mandelbrot_proof_baby_bear::CompositionChallenge {
        valid: true,
        value: BabyBearExt4::from_u32s([beta0, beta1, beta2, beta3]),
    }
    let shift = BabyBear::from_u32(shift)
    let positive_quarter: usize = if query_index < 4 { 0 } else { 1 }
    let positive_next_quarter = (positive_quarter + 1) & 3
    let negative_quarter = (positive_quarter + 2) & 3
    let negative_next_quarter = (positive_quarter + 3) & 3
    let positive = evaluate_composition_opened<4, 16>(
        c_re_q12,
        c_im_q12,
        challenge,
        shift,
        query_index,
        ref opening.rows[positive_quarter],
        ref opening.rows[positive_next_quarter],
    )
    let negative = evaluate_composition_opened<4, 16>(
        c_re_q12,
        c_im_q12,
        challenge,
        shift,
        query_index + 8,
        ref opening.rows[negative_quarter],
        ref opening.rows[negative_next_quarter],
    )
    if !positive.valid || !negative.valid {
        return (0, 0, 0, 0, 0, 0, 0, 0, 0)
    }

    if mutation == 1 {
        opening.rows[0].main[0] = opening.rows[0].main[0] + BabyBear::one()
    } else if mutation == 2 {
        opening.rows[0].auxiliary[0] = opening.rows[0].auxiliary[0] + BabyBear::one()
    } else if mutation == 3 {
        opening.main_path.first_siblings[0] = digest8(seed + 1700000)
    } else if mutation == 4 {
        opening.auxiliary_path.index = opening.auxiliary_path.index ^ 1
    } else if mutation == 5 {
        main_root.value = digest8(seed + 1800000)
    } else if mutation == 6 {
        challenge.value = challenge.value + BabyBearExt4::one()
    } else if mutation == 7 {
        opening.valid = false
    }
    let positive_opening = if mutation == 8 {
        positive.value + BabyBearExt4::one()
    } else {
        positive.value
    }
    let negative_opening = if mutation == 9 {
        negative.value + BabyBearExt4::one()
    } else {
        negative.value
    }
    let verifier_shift = if mutation == 10 { shift + BabyBear::one() } else { shift }
    let verifier_query = if mutation == 11 { query_index ^ 1 } else { query_index }
    let accepted = verify_checkpoint4_air_lde_composition_query<16, 4, 2>(
        c_re_q12,
        c_im_q12,
        challenge,
        verifier_shift,
        verifier_query,
        ref opening,
        main_root,
        auxiliary_root,
        positive_opening,
        negative_opening,
    )
    let positive_words = positive.value.to_u32s()
    let negative_words = negative.value.to_u32s()
    (
        if accepted { 1 } else { 0 },
        positive_words[0], positive_words[1], positive_words[2], positive_words[3],
        negative_words[0], negative_words[1], negative_words[2], negative_words[3],
    )
}

pub fn air_lde_quartet16(
    _ seed: u32,
    _ index: u32,
    _ mutation: u32,
) -> (u32, u32, u32, u32, u32, u32) {
    let mut main_leaves = [MainLdeDigest {
        valid: true,
        value: Poseidon2Digest::zero(),
    }; 16]
    let mut auxiliary_leaves = [AuxiliaryLdeDigest {
        valid: true,
        value: Poseidon2Digest::zero(),
    }; 16]
    let mut cursor: usize = 0
    while cursor < 16 {
        let cursor_u32: u32 = cursor.downcast_truncate()
        let offset: u32 = cursor_u32 * 16
        main_leaves[cursor].value = digest8(seed + offset)
        auxiliary_leaves[cursor].value = digest8(seed + 512 + offset)
        cursor = cursor + 1
    }
    let mut main_root = main_lde_root_power_of_two<16>(main_leaves)
    let auxiliary_root = auxiliary_lde_root_power_of_two<16>(auxiliary_leaves)
    let mut main_path = main_lde_quartet_path_power_of_two<16, 4, 2>(main_leaves, index)
    let mut auxiliary_path = auxiliary_lde_quartet_path_power_of_two<16, 4, 2>(
        auxiliary_leaves,
        index,
    )
    let local: usize = if index < 4 { index as usize } else { 0 }
    let mut first_main = main_leaves[local]
    let first_auxiliary = auxiliary_leaves[local]
    if mutation == 1 {
        first_main.value = digest8(seed + 4096)
    } else if mutation == 2 {
        main_path.first_siblings[0] = digest8(seed + 4112)
    } else if mutation == 3 {
        auxiliary_path.index = auxiliary_path.index ^ 1
    } else if mutation == 4 {
        main_root.value = digest8(seed + 4128)
    } else if mutation == 5 {
        first_main.valid = false
    } else if mutation == 6 {
        main_path.valid = false
    }
    let main_valid = verify_main_lde_quartet_path<2>(
        first_main,
        main_leaves[local + 4],
        main_leaves[local + 8],
        main_leaves[local + 12],
        main_path,
        main_root,
    )
    let auxiliary_valid = verify_auxiliary_lde_quartet_path<2>(
        first_auxiliary,
        auxiliary_leaves[local + 4],
        auxiliary_leaves[local + 8],
        auxiliary_leaves[local + 12],
        auxiliary_path,
        auxiliary_root,
    )
    (
        if main_path.valid { 1 } else { 0 },
        if auxiliary_path.valid { 1 } else { 0 },
        main_root.value.field(0).to_u32(),
        auxiliary_root.value.field(0).to_u32(),
        if main_valid { 1 } else { 0 },
        if auxiliary_valid { 1 } else { 0 },
    )
}

pub fn main_lde17(
    _ f0: u32, _ f1: u32, _ f2: u32, _ f3: u32,
    _ f4: u32, _ f5: u32, _ f6: u32, _ f7: u32,
    _ f8: u32, _ f9: u32, _ f10: u32, _ f11: u32,
    _ f12: u32, _ f13: u32, _ f14: u32, _ f15: u32,
    _ f16: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let digest = main_lde_row_commitment([
        BabyBear::from_u32(f0), BabyBear::from_u32(f1),
        BabyBear::from_u32(f2), BabyBear::from_u32(f3),
        BabyBear::from_u32(f4), BabyBear::from_u32(f5),
        BabyBear::from_u32(f6), BabyBear::from_u32(f7),
        BabyBear::from_u32(f8), BabyBear::from_u32(f9),
        BabyBear::from_u32(f10), BabyBear::from_u32(f11),
        BabyBear::from_u32(f12), BabyBear::from_u32(f13),
        BabyBear::from_u32(f14), BabyBear::from_u32(f15),
        BabyBear::from_u32(f16),
    ]).value
    (
        digest.field(0).to_u32(), digest.field(1).to_u32(),
        digest.field(2).to_u32(), digest.field(3).to_u32(),
        digest.field(4).to_u32(), digest.field(5).to_u32(),
        digest.field(6).to_u32(), digest.field(7).to_u32(),
    )
}

pub fn auxiliary_lde411(_ seed: u32) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let mut fields = [BabyBear::zero(); mandelbrot_proof_kernel::AUXILIARY_ROW_BITS]
    let mut index: usize = 0
    while index < mandelbrot_proof_kernel::AUXILIARY_ROW_BITS {
        let i: u32 = index.downcast_truncate()
        fields[index] = BabyBear::from_u32(((seed >> (i & 31)) ^ i ^ (i >> 3)) & 1073741823)
        index = index + 1
    }
    let digest = auxiliary_lde_row_commitment(fields).value
    (
        digest.field(0).to_u32(), digest.field(1).to_u32(),
        digest.field(2).to_u32(), digest.field(3).to_u32(),
        digest.field(4).to_u32(), digest.field(5).to_u32(),
        digest.field(6).to_u32(), digest.field(7).to_u32(),
    )
}

pub fn composition_row4(
    _ c0: u32, _ c1: u32, _ c2: u32, _ c3: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let digest = composition_row_commitment(BabyBearExt4::from_u32s([c0, c1, c2, c3])).value
    (
        digest.field(0).to_u32(), digest.field(1).to_u32(),
        digest.field(2).to_u32(), digest.field(3).to_u32(),
        digest.field(4).to_u32(), digest.field(5).to_u32(),
        digest.field(6).to_u32(), digest.field(7).to_u32(),
    )
}
