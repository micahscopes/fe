//! Executable boundary for the Fe-derived BabyBear Poseidon2 oracle.

use canonical_words::{CanonicalWords, CanonicalWordsProvider}
use poseidon_baby_bear::{
    Poseidon2Domain,
    Poseidon2FieldDomain,
    Poseidon2FieldPermutation,
    Poseidon2FieldSponge,
    Poseidon2WorkgroupPlan,
    Poseidon2WorkgroupSchedule,
    commit_canonical,
    commit_ext4_fields,
    commit_fields,
    commit_packed,
    parameter_plain,
    place_final_full_rounds,
    place_first_full_rounds,
    place_partial_rounds,
    permute16,
    poseidon2_workgroup_destination,
    poseidon2_workgroup_lane,
    runtime_parameter_plain,
}
use precision::baby_bear::{BabyBear, BabyBearExt4, BabyBearModulus, BABY_BEAR_MODULUS}
use precision::word_field_encoding::{PackedFieldBits, pack_bounded_words}

const fn protocol_tag(_ label: String<4>) -> u32 {
    let bytes = label.as_bytes()
    ((bytes[0] as u32) << 24)
        | ((bytes[1] as u32) << 16)
        | ((bytes[2] as u32) << 8)
        | (bytes[3] as u32)
}

struct PackingTestDomain {}
impl Poseidon2Domain for PackingTestDomain {
    const TAG: u32 = protocol_tag("BP01")
}

struct InvalidPackingTestDomain {}
impl Poseidon2Domain for InvalidPackingTestDomain {
    const TAG: u32 = BABY_BEAR_MODULUS
}

struct FieldVectorTestDomain {}
impl Poseidon2FieldDomain for FieldVectorTestDomain {
    const TAG: u32 = protocol_tag("BV01")
}

struct CanonicalMessage {
    enabled: bool,
    sequence: u32,
    values: [u32; 5],
}
impl core::marker::Copy for CanonicalMessage {}
derive CanonicalWords for CanonicalMessage using CanonicalWordsProvider

pub fn canonical7_commitment(
    _ enabled: u32,
    _ sequence: u32,
    _ v0: u32,
    _ v1: u32,
    _ v2: u32,
    _ v3: u32,
    _ v4: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32, u32) {
    let message = CanonicalMessage {
        enabled: enabled == 1,
        sequence: sequence,
        values: [v0, v1, v2, v3, v4],
    }
    let commitment = commit_canonical<FieldVectorTestDomain, CanonicalMessage>(ref message)
    let digest = commitment.digest()
    (
        if commitment.is_valid() { 1 } else { 0 },
        digest.field(0).to_u32(), digest.field(1).to_u32(),
        digest.field(2).to_u32(), digest.field(3).to_u32(),
        digest.field(4).to_u32(), digest.field(5).to_u32(),
        digest.field(6).to_u32(), digest.field(7).to_u32(),
    )
}

pub fn derived_parameter(_ index: u32) -> u32 { parameter_plain(index) }

pub fn runtime_derived_parameter(_ index: u32) -> u32 {
    runtime_parameter_plain(index)
}

fn permuted(
    _ a0: u32, _ a1: u32, _ a2: u32, _ a3: u32,
    _ a4: u32, _ a5: u32, _ a6: u32, _ a7: u32,
    _ a8: u32, _ a9: u32, _ a10: u32, _ a11: u32,
    _ a12: u32, _ a13: u32, _ a14: u32, _ a15: u32,
) -> [BabyBear; 16] {
    permute16(input: [
        BabyBear::from_u32(a0), BabyBear::from_u32(a1),
        BabyBear::from_u32(a2), BabyBear::from_u32(a3),
        BabyBear::from_u32(a4), BabyBear::from_u32(a5),
        BabyBear::from_u32(a6), BabyBear::from_u32(a7),
        BabyBear::from_u32(a8), BabyBear::from_u32(a9),
        BabyBear::from_u32(a10), BabyBear::from_u32(a11),
        BabyBear::from_u32(a12), BabyBear::from_u32(a13),
        BabyBear::from_u32(a14), BabyBear::from_u32(a15),
    ])
}

pub fn poseidon2_permute16(
    _ a0: u32, _ a1: u32, _ a2: u32, _ a3: u32,
    _ a4: u32, _ a5: u32, _ a6: u32, _ a7: u32,
    _ a8: u32, _ a9: u32, _ a10: u32, _ a11: u32,
    _ a12: u32, _ a13: u32, _ a14: u32, _ a15: u32,
) -> (
    u32, u32, u32, u32, u32, u32, u32, u32,
    u32, u32, u32, u32, u32, u32, u32, u32,
) {
    let output = permuted(
        a0, a1, a2, a3, a4, a5, a6, a7,
        a8, a9, a10, a11, a12, a13, a14, a15,
    )
    (
        output[0].to_u32(), output[1].to_u32(),
        output[2].to_u32(), output[3].to_u32(),
        output[4].to_u32(), output[5].to_u32(),
        output[6].to_u32(), output[7].to_u32(),
        output[8].to_u32(), output[9].to_u32(),
        output[10].to_u32(), output[11].to_u32(),
        output[12].to_u32(), output[13].to_u32(),
        output[14].to_u32(), output[15].to_u32(),
    )
}

fn workgroup_permuted(
    _ a0: u32, _ a1: u32, _ a2: u32, _ a3: u32,
    _ a4: u32, _ a5: u32, _ a6: u32, _ a7: u32,
    _ a8: u32, _ a9: u32, _ a10: u32, _ a11: u32,
    _ a12: u32, _ a13: u32, _ a14: u32, _ a15: u32,
) -> [BabyBear; 16] {
    let inputs = [
        a0, a1, a2, a3, a4, a5, a6, a7,
        a8, a9, a10, a11, a12, a13, a14, a15,
    ]
    let mut primary = [0; 16]
    let mut secondary = [0; 16]
    let mut lane: usize = 0
    while lane < 16 {
        primary[lane] = BabyBear::from_u32(inputs[lane]).to_montgomery_word()
        lane = lane + 1
    }

    let transition = <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    let mut step: u32 = 0
    while step < transition {
        let destination = poseidon2_workgroup_destination(step)
        let mut field_lane: u32 = 0
        while field_lane < 16 {
            let value = poseidon2_workgroup_lane(
                ref primary,
                ref secondary,
                step,
                field_lane,
            )
            if destination == 0 {
                primary[field_lane as usize] = value
            } else {
                secondary[field_lane as usize] = value
            }
            field_lane = field_lane + 1
        }
        step = step + 1
    }

    let mut output = [BabyBear::zero(); 16]
    lane = 0
    while lane < 16 {
        output[lane] = BabyBear::from_montgomery_word(secondary[lane])
        lane = lane + 1
    }
    output
}

pub fn poseidon2_workgroup_permute16(
    _ a0: u32, _ a1: u32, _ a2: u32, _ a3: u32,
    _ a4: u32, _ a5: u32, _ a6: u32, _ a7: u32,
    _ a8: u32, _ a9: u32, _ a10: u32, _ a11: u32,
    _ a12: u32, _ a13: u32, _ a14: u32, _ a15: u32,
) -> (
    u32, u32, u32, u32, u32, u32, u32, u32,
    u32, u32, u32, u32, u32, u32, u32, u32,
) {
    let output = workgroup_permuted(
        a0, a1, a2, a3, a4, a5, a6, a7,
        a8, a9, a10, a11, a12, a13, a14, a15,
    )
    (
        output[0].to_u32(), output[1].to_u32(),
        output[2].to_u32(), output[3].to_u32(),
        output[4].to_u32(), output[5].to_u32(),
        output[6].to_u32(), output[7].to_u32(),
        output[8].to_u32(), output[9].to_u32(),
        output[10].to_u32(), output[11].to_u32(),
        output[12].to_u32(), output[13].to_u32(),
        output[14].to_u32(), output[15].to_u32(),
    )
}

pub fn poseidon2_permute16_c0(
    _ a0: u32, _ a1: u32, _ a2: u32, _ a3: u32,
    _ a4: u32, _ a5: u32, _ a6: u32, _ a7: u32,
    _ a8: u32, _ a9: u32, _ a10: u32, _ a11: u32,
    _ a12: u32, _ a13: u32, _ a14: u32, _ a15: u32,
) -> u32 {
    permuted(
        a0, a1, a2, a3, a4, a5, a6, a7,
        a8, a9, a10, a11, a12, a13, a14, a15,
    )[0].to_u32()
}

fn pack4(
    _ a: u32, _ wa: u32,
    _ b: u32, _ wb: u32,
    _ c: u32, _ wc: u32,
    _ d: u32, _ wd: u32,
) -> PackedFieldBits<BabyBearModulus, 5> {
    pack_bounded_words<BabyBearModulus, 4, 5>(
        [a, b, c, d],
        [wa, wb, wc, wd],
    )
}

pub fn packed4(
    _ a: u32, _ wa: u32,
    _ b: u32, _ wb: u32,
    _ c: u32, _ wc: u32,
    _ d: u32, _ wd: u32,
) -> (u32, u32, u32, u32, u32, u32, u32) {
    let packed = pack4(a, wa, b, wb, c, wc, d, wd)
    (
        if packed.is_valid() { 1 } else { 0 },
        packed.len_bits(),
        packed.field(0).to_u32(),
        packed.field(1).to_u32(),
        packed.field(2).to_u32(),
        packed.field(3).to_u32(),
        packed.field(4).to_u32(),
    )
}

pub fn packed4_overflow_valid(
    _ a: u32, _ wa: u32,
    _ b: u32, _ wb: u32,
    _ c: u32, _ wc: u32,
    _ d: u32, _ wd: u32,
) -> u32 {
    let packed = pack_bounded_words<BabyBearModulus, 4, 4>(
        [a, b, c, d],
        [wa, wb, wc, wd],
    )
    if packed.is_valid() { 1 } else { 0 }
}

pub fn packed4_commitment(
    _ a: u32, _ wa: u32,
    _ b: u32, _ wb: u32,
    _ c: u32, _ wc: u32,
    _ d: u32, _ wd: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32, u32) {
    let digest = commit_packed<PackingTestDomain, 5>(pack4(a, wa, b, wb, c, wc, d, wd))
    let value = digest.digest()
    (
        if digest.is_valid() { 1 } else { 0 },
        value.field(0).to_u32(), value.field(1).to_u32(),
        value.field(2).to_u32(), value.field(3).to_u32(),
        value.field(4).to_u32(), value.field(5).to_u32(),
        value.field(6).to_u32(), value.field(7).to_u32(),
    )
}

pub fn packed4_invalid_domain(
    _ a: u32, _ wa: u32,
    _ b: u32, _ wb: u32,
    _ c: u32, _ wc: u32,
    _ d: u32, _ wd: u32,
) -> u32 {
    let digest = commit_packed<InvalidPackingTestDomain, 5>(
        pack4(a, wa, b, wb, c, wc, d, wd),
    )
    if digest.is_valid() { 1 } else { 0 }
}

fn pattern411(_ seed: u32) -> PackedFieldBits<BabyBearModulus, 14> {
    let mut packed = PackedFieldBits<BabyBearModulus, 14>::empty()
    let mut index: u32 = 0
    while index < 411 {
        let bit = ((seed >> (index & 31)) ^ index ^ (index >> 3)) & 1
        packed = packed.append(bit, 1)
        index = index + 1
    }
    packed
}

pub fn packed411(_ seed: u32) -> (
    u32, u32,
    u32, u32, u32, u32, u32, u32, u32,
    u32, u32, u32, u32, u32, u32, u32,
) {
    let packed = pattern411(seed)
    (
        if packed.is_valid() { 1 } else { 0 },
        packed.len_bits(),
        packed.field(0).to_u32(), packed.field(1).to_u32(),
        packed.field(2).to_u32(), packed.field(3).to_u32(),
        packed.field(4).to_u32(), packed.field(5).to_u32(),
        packed.field(6).to_u32(), packed.field(7).to_u32(),
        packed.field(8).to_u32(), packed.field(9).to_u32(),
        packed.field(10).to_u32(), packed.field(11).to_u32(),
        packed.field(12).to_u32(), packed.field(13).to_u32(),
    )
}

pub fn packed411_commitment(_ seed: u32) -> (u32, u32, u32, u32, u32, u32, u32, u32, u32) {
    let digest = commit_packed<PackingTestDomain, 14>(pattern411(seed))
    let value = digest.digest()
    (
        if digest.is_valid() { 1 } else { 0 },
        value.field(0).to_u32(), value.field(1).to_u32(),
        value.field(2).to_u32(), value.field(3).to_u32(),
        value.field(4).to_u32(), value.field(5).to_u32(),
        value.field(6).to_u32(), value.field(7).to_u32(),
    )
}

pub fn fields17(
    _ f0: u32, _ f1: u32, _ f2: u32, _ f3: u32,
    _ f4: u32, _ f5: u32, _ f6: u32, _ f7: u32,
    _ f8: u32, _ f9: u32, _ f10: u32, _ f11: u32,
    _ f12: u32, _ f13: u32, _ f14: u32, _ f15: u32,
    _ f16: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let digest = commit_fields<FieldVectorTestDomain, 17>([
        BabyBear::from_u32(f0), BabyBear::from_u32(f1),
        BabyBear::from_u32(f2), BabyBear::from_u32(f3),
        BabyBear::from_u32(f4), BabyBear::from_u32(f5),
        BabyBear::from_u32(f6), BabyBear::from_u32(f7),
        BabyBear::from_u32(f8), BabyBear::from_u32(f9),
        BabyBear::from_u32(f10), BabyBear::from_u32(f11),
        BabyBear::from_u32(f12), BabyBear::from_u32(f13),
        BabyBear::from_u32(f14), BabyBear::from_u32(f15),
        BabyBear::from_u32(f16),
    ])
    (
        digest.field(0).to_u32(), digest.field(1).to_u32(),
        digest.field(2).to_u32(), digest.field(3).to_u32(),
        digest.field(4).to_u32(), digest.field(5).to_u32(),
        digest.field(6).to_u32(), digest.field(7).to_u32(),
    )
}

fn restore_fields17_sponge(
    _ sponge: Poseidon2FieldSponge,
    _ rate: u32,
    _ written: u32,
) -> Poseidon2FieldSponge {
    let mut lanes = [0; 16]
    let mut lane: usize = 0
    while lane < 16 {
        lanes[lane] = sponge.lane_word(lane: lane.downcast_truncate())
        lane = lane + 1
    }
    Poseidon2FieldSponge::restore(
        lanes: lanes,
        rate: rate,
        expected: 17,
        written: written,
    )
}

fn restore_fields17_permutation(
    _ permutation: Poseidon2FieldPermutation,
    _ written: u32,
    _ phase: u32,
) -> Poseidon2FieldPermutation {
    let mut lanes = [0; 16]
    let mut lane: usize = 0
    while lane < 16 {
        lanes[lane] = permutation.lane_word(lane: lane.downcast_truncate())
        lane = lane + 1
    }
    Poseidon2FieldPermutation::restore(
        lanes: lanes,
        expected: 17,
        written: written,
        phase: phase,
    )
}

fn execute_fields17_permutation(
    _ permutation: own Poseidon2FieldPermutation,
    _ written: u32,
) -> Poseidon2FieldSponge {
    let mut scheduled = permutation
    place_first_full_rounds<0, 2>(mut scheduled)
    scheduled = restore_fields17_permutation(scheduled, written, phase: 2)
    place_first_full_rounds<2, 2>(mut scheduled)
    scheduled = restore_fields17_permutation(scheduled, written, phase: 4)
    place_partial_rounds<0, 7>(mut scheduled)
    scheduled = restore_fields17_permutation(scheduled, written, phase: 11)
    place_partial_rounds<7, 6>(mut scheduled)
    scheduled = restore_fields17_permutation(scheduled, written, phase: 17)
    place_final_full_rounds<0, 2>(mut scheduled)
    scheduled = restore_fields17_permutation(scheduled, written, phase: 19)
    place_final_full_rounds<2, 2>(mut scheduled)
    scheduled = restore_fields17_permutation(scheduled, written, phase: 21)
    scheduled.complete()
}

fn execute_fields17_round_steps(
    _ permutation: own Poseidon2FieldPermutation,
) -> Poseidon2FieldSponge {
    let mut scheduled = permutation
    while scheduled.phase() < 21 {
        scheduled.advance_round()
    }
    scheduled.complete()
}

/// The same field commitment as `fields17`, checkpointed through plain words
/// between sponge blocks and every bounded permutation region.
pub fn fields17_staged(
    _ f0: u32, _ f1: u32, _ f2: u32, _ f3: u32,
    _ f4: u32, _ f5: u32, _ f6: u32, _ f7: u32,
    _ f8: u32, _ f9: u32, _ f10: u32, _ f11: u32,
    _ f12: u32, _ f13: u32, _ f14: u32, _ f15: u32,
    _ f16: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32, u32) {
    let mut sponge = Poseidon2FieldSponge::begin<FieldVectorTestDomain>(expected: 17)
    let first = [
        BabyBear::from_u32(f0), BabyBear::from_u32(f1),
        BabyBear::from_u32(f2), BabyBear::from_u32(f3),
        BabyBear::from_u32(f4), BabyBear::from_u32(f5),
    ]
    let first_permutation = sponge.begin_permutation<6>(fields: ref first)
    sponge = execute_fields17_permutation(first_permutation, written: 6)
    sponge = restore_fields17_sponge(sponge, rate: 0, written: 6)
    let middle = [
        BabyBear::from_u32(f6), BabyBear::from_u32(f7),
        BabyBear::from_u32(f8), BabyBear::from_u32(f9),
        BabyBear::from_u32(f10), BabyBear::from_u32(f11),
        BabyBear::from_u32(f12), BabyBear::from_u32(f13),
    ]
    let middle_permutation = sponge.begin_permutation<8>(fields: ref middle)
    sponge = execute_fields17_permutation(middle_permutation, written: 14)
    sponge = restore_fields17_sponge(sponge, rate: 0, written: 14)
    let last = [
        BabyBear::from_u32(f14), BabyBear::from_u32(f15),
        BabyBear::from_u32(f16),
    ]
    sponge.absorb<3>(fields: ref last)
    sponge = restore_fields17_sponge(sponge, rate: 3, written: 17)
    let final_permutation = sponge.begin_finish_permutation()
    sponge = execute_fields17_permutation(final_permutation, written: 17)
    let commitment = sponge.finish()
    let digest = commitment.digest()
    (
        if commitment.is_valid() { 1 } else { 0 },
        digest.field(0).to_u32(), digest.field(1).to_u32(),
        digest.field(2).to_u32(), digest.field(3).to_u32(),
        digest.field(4).to_u32(), digest.field(5).to_u32(),
        digest.field(6).to_u32(), digest.field(7).to_u32(),
    )
}

/// The same commitment interpreted through the one-round scheduling kernel.
pub fn fields17_round_stepped(
    _ f0: u32, _ f1: u32, _ f2: u32, _ f3: u32,
    _ f4: u32, _ f5: u32, _ f6: u32, _ f7: u32,
    _ f8: u32, _ f9: u32, _ f10: u32, _ f11: u32,
    _ f12: u32, _ f13: u32, _ f14: u32, _ f15: u32,
    _ f16: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32, u32) {
    let mut sponge = Poseidon2FieldSponge::begin<FieldVectorTestDomain>(expected: 17)
    let first = [
        BabyBear::from_u32(f0), BabyBear::from_u32(f1),
        BabyBear::from_u32(f2), BabyBear::from_u32(f3),
        BabyBear::from_u32(f4), BabyBear::from_u32(f5),
    ]
    let first_permutation = sponge.begin_permutation<6>(fields: ref first)
    sponge = execute_fields17_round_steps(first_permutation)
    sponge = restore_fields17_sponge(sponge, rate: 0, written: 6)
    let middle = [
        BabyBear::from_u32(f6), BabyBear::from_u32(f7),
        BabyBear::from_u32(f8), BabyBear::from_u32(f9),
        BabyBear::from_u32(f10), BabyBear::from_u32(f11),
        BabyBear::from_u32(f12), BabyBear::from_u32(f13),
    ]
    let middle_permutation = sponge.begin_permutation<8>(fields: ref middle)
    sponge = execute_fields17_round_steps(middle_permutation)
    sponge = restore_fields17_sponge(sponge, rate: 0, written: 14)
    let last = [
        BabyBear::from_u32(f14), BabyBear::from_u32(f15),
        BabyBear::from_u32(f16),
    ]
    sponge.absorb<3>(fields: ref last)
    sponge = restore_fields17_sponge(sponge, rate: 3, written: 17)
    let final_permutation = sponge.begin_finish_permutation()
    sponge = execute_fields17_round_steps(final_permutation)
    let commitment = sponge.finish()
    let digest = commitment.digest()
    (
        if commitment.is_valid() { 1 } else { 0 },
        digest.field(0).to_u32(), digest.field(1).to_u32(),
        digest.field(2).to_u32(), digest.field(3).to_u32(),
        digest.field(4).to_u32(), digest.field(5).to_u32(),
        digest.field(6).to_u32(), digest.field(7).to_u32(),
    )
}

pub fn extensions2(
    _ a0: u32, _ a1: u32, _ a2: u32, _ a3: u32,
    _ b0: u32, _ b1: u32, _ b2: u32, _ b3: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let digest = commit_ext4_fields<FieldVectorTestDomain, 2>([
        BabyBearExt4::from_u32s([a0, a1, a2, a3]),
        BabyBearExt4::from_u32s([b0, b1, b2, b3]),
    ])
    (
        digest.field(0).to_u32(), digest.field(1).to_u32(),
        digest.field(2).to_u32(), digest.field(3).to_u32(),
        digest.field(4).to_u32(), digest.field(5).to_u32(),
        digest.field(6).to_u32(), digest.field(7).to_u32(),
    )
}
