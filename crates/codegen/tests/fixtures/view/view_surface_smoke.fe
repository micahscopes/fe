//! R1a gate: the `std::web::view` vocabulary is ordinary const-constructible
//! Fe. This standalone fixture const-constructs a `Surface` value through every
//! `Param` constructor and must type-check clean with no compiler change (the
//! const-projection seam that EVALUATES `view()` is R1b).

use std::web::view::{Extent, Param, Surface}

struct SmokeParams {
    gain: Param,
    theta: Param,
    scale: Param,
    steps: Param,
    res: Param,
}

/// The reserved shape a render actor's `view()` returns: an extent plus a
/// per-demo params record built entirely from the const constructors.
pub const fn smoke_view() -> Surface<SmokeParams> {
    Surface {
        extent: Extent::square(256),
        params: SmokeParams {
            gain: Param::unit(init: 0.5),
            theta: Param::angle(init: 0.6),
            scale: Param::range(min: 0.5, max: 4.0, init: 1.6),
            steps: Param::int(min: 1.0, max: 8.0, init: 3.0),
            res: Param::extent_x(),
        },
    }
}
