//! Executed oracle fixture for canonical row commitments, ordered Merkle
//! placement, and root-derived interaction challenges. The dimensions are
//! small, but the domains and field order match the production sparse proof.

use mandelbrot_proof_baby_bear_domains::{
    MandelbrotSparseBaseLdeLeafBabyBearV1,
    SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
    sparse_lde_interaction_challenge_domain_tag,
}
use poseidon_baby_bear_webgpu::{
    DIGEST_SQUEEZE_STEPS,
    POSEIDON2_LANES,
    advance_digest_squeeze_batch_lane,
    advance_column_major_field_row_commitments,
    column_major_field_row_commitment_steps,
    column_major_field_row_commitment_workspace_words,
    digest_squeeze_batch_output_words,
    digest_squeeze_batch_workgroups,
    digest_squeeze_batch_workspace_words,
    finish_digest_squeeze_batch,
    prepare_digest_squeeze_batch,
    prepare_column_major_field_row_commitments,
}
use poseidon_merkle_webgpu::{
    advance_ordered_binary_tree,
    finish_ordered_binary_tree,
    load_poseidon2_digest,
    ordered_binary_tree_digest_words,
    ordered_binary_tree_levels,
    ordered_binary_tree_nodes,
    ordered_binary_tree_parent_tasks,
    prepare_ordered_binary_tree,
    write_ordered_binary_tree_leaf,
}
use precision::baby_bear::BabyBear
use std::webgpu::{
    ComputeInvocation,
    ComputeSurface as Kernel,
    FixedDispatch as Grid,
    FragmentSurface as Pixel,
    GpuProgram as Program,
    RepeatedDispatch as Repeat,
    StorageBuffer as Shared,
    WebGpuBackend,
    Workgroup as Threads,
}

const LEAVES: usize = 8
const FIELDS: usize = 5
const VALUE_WORDS: usize = LEAVES * FIELDS
const PREFIX_FIELDS: usize = 4
const COMMITMENT_STEPS: usize = column_major_field_row_commitment_steps(
    PREFIX_FIELDS,
    FIELDS,
)
const COMMITMENT_WORKSPACE_WORDS: usize =
    column_major_field_row_commitment_workspace_words(LEAVES)
const TREE_NODES: usize = ordered_binary_tree_nodes(LEAVES)
const TREE_WORDS: usize = ordered_binary_tree_digest_words(LEAVES)
const PARENT_TASKS: usize = ordered_binary_tree_parent_tasks(LEAVES)
const LEVELS: usize = ordered_binary_tree_levels(LEAVES)
const THREADS: usize = 4
const LEAF_GROUPS: usize = (LEAVES + THREADS - 1) / THREADS
const PARENT_GROUPS: usize = (PARENT_TASKS + THREADS - 1) / THREADS
const CHALLENGE_THREADS: usize = POSEIDON2_LANES
const CHALLENGE_GROUPS: usize = digest_squeeze_batch_workgroups(
    SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
    CHALLENGE_THREADS,
)
const CHALLENGE_WORKSPACE_WORDS: usize = digest_squeeze_batch_workspace_words(
    SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
)
const CHALLENGE_OUTPUT_WORDS: usize = digest_squeeze_batch_output_words(
    SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
)

static_assert(TREE_NODES == 15)
static_assert(COMMITMENT_STEPS == 2)
static_assert(COMMITMENT_WORKSPACE_WORDS == 144)
static_assert(TREE_WORDS == 120)
static_assert(PARENT_TASKS == 4)
static_assert(LEVELS == 3)
static_assert(LEAF_GROUPS == 2)
static_assert(PARENT_GROUPS == 1)
static_assert(SPARSE_LDE_INTERACTION_CHALLENGE_COUNT == 8)
static_assert(CHALLENGE_THREADS == 16)
static_assert(CHALLENGE_GROUPS == 8)
static_assert(CHALLENGE_WORKSPACE_WORDS == 408)
static_assert(CHALLENGE_OUTPUT_WORDS == 40)

actor PortablePoseidonMerkle uses (Program<WebGpuBackend>) {
    values: Shared<u32, VALUE_WORDS>,
    commitment_workspace: Shared<u32, COMMITMENT_WORKSPACE_WORDS>,
    tree: Shared<u32, TREE_WORDS>,
    node_valid: Shared<u32, TREE_NODES>,
    progress: Shared<u32, PARENT_TASKS>,
    challenge_workspace: Shared<u32, CHALLENGE_WORKSPACE_WORDS>,
    challenge_output: Shared<u32, CHALLENGE_OUTPUT_WORDS>,

    fn prepare_commitments(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<LEAF_GROUPS, 1, 1>>)
    {
        prepare_column_major_field_row_commitments<
            LEAVES,
            COMMITMENT_WORKSPACE_WORDS,
        >(self.commitment_workspace, invocation)
    }

    fn advance_commitments(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<LEAF_GROUPS, 1, 1, COMMITMENT_STEPS>,
            >
        )
    {
        let row = invocation.global.x
        if row >= LEAVES.downcast_truncate() { return }
        let prefix = [
            BabyBear::from_u32(4),
            BabyBear::from_u32(4),
            BabyBear::from_u32(LEAVES.downcast_truncate()),
            BabyBear::from_u32(row),
        ]
        let step = advance_column_major_field_row_commitments<
            MandelbrotSparseBaseLdeLeafBabyBearV1,
            LEAVES,
            FIELDS,
            VALUE_WORDS,
            PREFIX_FIELDS,
            COMMITMENT_WORKSPACE_WORDS,
        >(
            self.values,
            self.commitment_workspace,
            ref prefix,
            invocation,
        )
        if step.complete {
            write_ordered_binary_tree_leaf<
                LEAVES,
                TREE_WORDS,
                TREE_NODES,
            >(
                self.tree,
                self.node_valid,
                step.row,
                step.commitment,
            )
        }
    }

    fn prepare_tree(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<PARENT_GROUPS, 1, 1>>)
    {
        prepare_ordered_binary_tree<LEAVES, PARENT_TASKS>(
            self.progress,
            invocation,
        )
    }

    fn advance_tree(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<PARENT_GROUPS, 1, 1, LEVELS>,
            >
        )
    {
        advance_ordered_binary_tree<
            LEAVES,
            LEVELS,
            TREE_WORDS,
            TREE_NODES,
            PARENT_TASKS,
        >(self.tree, self.node_valid, self.progress, invocation)
    }

    fn finish_tree(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        if invocation.global.x != 0 { return }
        let root = finish_ordered_binary_tree<
            LEAVES,
            LEVELS,
            TREE_WORDS,
            TREE_NODES,
            PARENT_TASKS,
        >(self.tree, self.node_valid, self.progress)
        self.node_valid.store(
            index: (TREE_NODES - 1).downcast_truncate(),
            value: if root.valid { 1 } else { 0 },
        )
    }

    fn prepare_challenges(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<CHALLENGE_THREADS, 1, 1>,
                Grid<CHALLENGE_GROUPS, 1, 1>,
            >
        )
    {
        prepare_digest_squeeze_batch<
            SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
            CHALLENGE_WORKSPACE_WORDS,
            CHALLENGE_OUTPUT_WORDS,
        >(self.challenge_workspace, self.challenge_output, invocation)
    }

    fn advance_challenges(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<CHALLENGE_THREADS, 1, 1>,
                Repeat<CHALLENGE_GROUPS, 1, 1, DIGEST_SQUEEZE_STEPS>,
            >
        )
    {
        let state = invocation.global.x
            / POSEIDON2_LANES.downcast_truncate()
        if state >= SPARSE_LDE_INTERACTION_CHALLENGE_COUNT.downcast_truncate() {
            return
        }
        advance_digest_squeeze_batch_lane<
            SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
            CHALLENGE_WORKSPACE_WORDS,
            CHALLENGE_OUTPUT_WORDS,
        >(
            self.challenge_workspace,
            self.challenge_output,
            invocation,
            sparse_lde_interaction_challenge_domain_tag(state),
            load_poseidon2_digest(self.tree, (TREE_NODES - 1).downcast_truncate()),
            self.node_valid.load(
                index: (TREE_NODES - 1).downcast_truncate(),
            ) == 1,
        )
    }

    fn finish_challenges(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<1, 1, 1>, Grid<1, 1, 1>>)
    {
        if invocation.global.x != 0 { return }
        let root: u32 = (TREE_NODES - 1).downcast_truncate()
        let valid = self.node_valid.load(index: root) == 1
            && finish_digest_squeeze_batch<
                SPARSE_LDE_INTERACTION_CHALLENGE_COUNT,
                CHALLENGE_WORKSPACE_WORDS,
                CHALLENGE_OUTPUT_WORDS,
            >(self.challenge_workspace, self.challenge_output)
        self.node_valid.store(index: root, value: if valid { 1 } else { 0 })
    }

    fn paint(self, px: i32, py: i32) -> i32 uses (Pixel) {
        self.node_valid.load(
            index: (TREE_NODES - 1).downcast_truncate(),
        ).downcast_truncate()
    }
}
