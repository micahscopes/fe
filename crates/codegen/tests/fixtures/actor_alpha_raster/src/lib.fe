use std::webgpu::{
    ClipPosition,
    FragmentStage,
    FragmentSurface,
    GpuProgram,
    NoDepth,
    Samples4,
    CullNone,
    OpaqueBlack,
    ClearThenLoadStore,
    ColorTarget,
    StraightAlpha,
    WithBlendConstant,
    RasterBlendConstant,
    ClearColor,
    RasterState,
    RasterConfiguration,
    RasterPlan,
    RasterVertex,
    TriangleList,
    VertexStage,
    WebGpuBackend,
    raster_plan,
}
struct Constant {}
impl RasterBlendConstant for Constant {
    const fn value() -> ClearColor {
        ClearColor { r: 0.25, g: 0.5, b: 0.75, a: 1.0 }
    }
}
type Alpha = RasterState<
    NoDepth,
    Samples4,
    CullNone,
    WithBlendConstant<ColorTarget<OpaqueBlack<ClearThenLoadStore>, StraightAlpha, 7>, Constant>,
>
struct Varying { x: f32 }
impl Copy for Varying {}
actor AlphaSurface uses (GpuProgram<WebGpuBackend>) {
    const fn raster()->RasterPlan uses (RasterConfiguration) {raster_plan<Alpha>()}
    fn background(self,x:i32,y:i32)->i32 uses (FragmentSurface) {-65536}
    fn vertices(self,index:u32)->RasterVertex<Varying> uses (VertexStage<Varying,TriangleList<3>>) {
        let x=if index==0 {-0.7} else if index==1 {0.7} else {0.0}
        let y=if index==2 {0.7} else {-0.7}
        RasterVertex {position:ClipPosition {x:x,y:y,z:0.5,w:1.0},varying:Varying {x:x}}
    }
    fn fragment(self,v:Varying)->i32 uses (FragmentStage<Varying>) {-2147483393}
}
