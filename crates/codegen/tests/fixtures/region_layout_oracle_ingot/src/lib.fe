use canonical_words::{CanonicalWords, CanonicalWordsProvider}
use region_layout::{
    Region,
    RegionSchema,
    RegionSchemaProvider,
    region_address,
    region_bounds,
}

struct Header { valid: bool, count: u32 }
impl core::marker::Copy for Header {}
derive CanonicalWords for Header using CanonicalWordsProvider

struct Query { index: u32, values: [u32; 3] }
impl core::marker::Copy for Query {}
derive CanonicalWords for Query using CanonicalWordsProvider

struct ProofRegions {
    header: Region<Header>,
    queries: Region<[Query; 2]>,
    digest: Region<[u32; 8]>,
}
impl core::marker::Copy for ProofRegions {}
derive RegionSchema for ProofRegions using RegionSchemaProvider

/// Returns start/width pairs for all three fields followed by total words.
pub fn layout_receipt() -> (u32, u32, u32, u32, u32, u32, u32) {
    let regions = <ProofRegions as RegionSchema>::regions()
    let header = region_bounds(regions.header)
    let queries = region_bounds(regions.queries)
    let digest = region_bounds(regions.digest)
    (
        header.start, header.words,
        queries.start, queries.words,
        digest.start, digest.words,
        <ProofRegions as RegionSchema>::WORDS,
    )
}

/// Returns validity and absolute address for an index relative to the query
/// region. Index eight is the first rejected coordinate.
pub fn query_address(_ index: u32) -> (u32, u32) {
    let regions = <ProofRegions as RegionSchema>::regions()
    let address = region_address(regions.queries, index)
    (if address.valid { 1 } else { 0 }, address.absolute)
}
