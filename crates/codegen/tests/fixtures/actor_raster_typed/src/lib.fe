use std::webgpu::{
    ClipPosition,
    FragmentStage,
    GpuProgram,
    RasterVertex,
    TriangleList,
    VertexStage,
    WebGpuBackend,
}

struct Normal { x: f32, y: f32, z: f32 }
impl Copy for Normal {}

struct MeshVarying { normal: Normal, heat: f32 }
impl Copy for MeshVarying {}

fn tinted_heat(_ heat: f32, _ tint: f32) -> f32 {
    heat + tint
}

fn shade_color(_ heat: f32, _ tint: f32) -> u32 {
    if tinted_heat(heat, tint) > 1.0 { 4294901760 } else { 4278190335 }
}

actor TypedMesh uses (GpuProgram<WebGpuBackend>) {
    tint: f32,

    fn vertices(self, vertex_index: u32) -> RasterVertex<MeshVarying>
        uses (VertexStage<MeshVarying, TriangleList<3>>)
    {
        RasterVertex {
            position: ClipPosition {
                x: if vertex_index == 1 { 3.0 } else { -1.0 },
                y: if vertex_index == 2 { 3.0 } else { -1.0 },
                z: 0.0,
                w: 1.0,
            },
            varying: MeshVarying {
                normal: Normal { x: 0.0, y: 0.0, z: 1.0 },
                heat: if vertex_index == 0 { 1.0 } else { 0.0 },
            },
        }
    }

    fn shade(self, varying: MeshVarying) -> u32
        uses (FragmentStage<MeshVarying>)
    {
        shade_color(varying.heat, self.tint)
    }
}
