//! Executable boundary for the shared BabyBear FRI pair denotation.

use fri_baby_bear::{
    FriFoldDomain,
    FriLayerRowDomain,
    FriLayerTranscriptDomain,
    fri_fold_domain_tag,
    fri_layer_row_domain_tag,
    fri_layer_transcript_domain_tag,
    fold_fri_pair_at_point,
    fold_fri_pair_at_power_of_two,
    fold_fri_pair_value_at_power_of_two,
}
use fri_structure::{
    FriQueryPlan,
    FriQueryPlanShape,
    FriRoundPlacement,
    FriSchedule,
    FriSchedulePlacement,
    FriScheduleQueryPlacement,
    FriScheduleShape,
    fri_query_evaluation_from_four_rounds,
    fri_query_sibling_from_four_rounds,
}
use poseidon_baby_bear::Poseidon2FieldDomain
type CheckpointFriSchedule16 = FriSchedule<1, 4>
type CheckpointFriQueryPlan1 = FriQueryPlan<1, 1>

pub fn fri_query_plan1_metadata() -> (u32, u32, u32) {
    let metadata = <CheckpointFriQueryPlan1
        as FriQueryPlanShape>::fri_query_plan_metadata()
    (metadata.samples, metadata.first_query, metadata.next_query)
}

fn schedule_words<S: FriScheduleShape>() -> (
    u32, u32, u32, u32, u32, u32, u32, u32, u32, u32,
) {
    let metadata = <S as FriScheduleShape>::fri_schedule_metadata()
    (
        metadata.rounds,
        metadata.first_round,
        metadata.next_round,
        metadata.input_log,
        metadata.folded_evaluations,
        metadata.layer_pair_openings,
        metadata.layer_path_siblings_per_side,
        metadata.layer_tree_nodes,
        metadata.query_evaluations,
        metadata.query_path_siblings,
    )
}

pub fn fri_schedule16_metadata() -> (
    u32, u32, u32, u32, u32, u32, u32, u32, u32, u32,
) {
    schedule_words<CheckpointFriSchedule16>()
}

fn round_words<S: FriSchedulePlacement>(_ index: u32) -> (
    u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32,
    u32, u32,
) {
    let placement = <S as FriSchedulePlacement>::fri_round_placement(index)
    (
        if placement.valid { 1 } else { 0 },
        placement.index,
        placement.round,
        placement.input_log,
        placement.input_width,
        placement.output_width,
        placement.output_offset,
        placement.tree_offset,
        placement.tree_nodes,
        placement.query_value_offset,
        placement.query_sibling_offset,
        placement.pair_width,
        placement.pair_depth,
    )
}

pub fn fri_schedule16_round(_ index: u32) -> (
    u32, u32, u32, u32, u32, u32, u32, u32, u32, u32, u32,
    u32, u32,
) {
    round_words<CheckpointFriSchedule16>(index)
}

pub fn fri_schedule16_query_evaluation(
    _ opening: u32,
    _ query: u32,
) -> (u32, u32, u32, u32) {
    let placement = <CheckpointFriSchedule16
        as FriScheduleQueryPlacement>::fri_query_evaluation_placement(
        opening,
        query,
    )
    (
        if placement.valid { 1 } else { 0 },
        placement.round_index,
        placement.round,
        placement.evaluation_index,
    )
}

pub fn fri_schedule16_query_sibling(
    _ sibling: u32,
    _ query: u32,
) -> (u32, u32, u32, u32) {
    let placement = <CheckpointFriSchedule16
        as FriScheduleQueryPlacement>::fri_query_sibling_placement(
        sibling,
        query,
    )
    (
        if placement.valid { 1 } else { 0 },
        placement.round_index,
        placement.round,
        placement.tree_node,
    )
}

fn schedule16_rounds() -> [FriRoundPlacement; 4] {
    [
        <CheckpointFriSchedule16 as FriSchedulePlacement>::fri_round_placement(0),
        <CheckpointFriSchedule16 as FriSchedulePlacement>::fri_round_placement(1),
        <CheckpointFriSchedule16 as FriSchedulePlacement>::fri_round_placement(2),
        <CheckpointFriSchedule16 as FriSchedulePlacement>::fri_round_placement(3),
    ]
}

pub fn fri_schedule16_query_evaluation_from_four_rounds(
    _ opening: u32,
    _ query: u32,
) -> (u32, u32, u32, u32) {
    let rounds = schedule16_rounds()
    let placement = fri_query_evaluation_from_four_rounds(ref rounds, opening, query)
    (
        if placement.valid { 1 } else { 0 },
        placement.round_index,
        placement.round,
        placement.evaluation_index,
    )
}

pub fn fri_schedule16_query_sibling_from_four_rounds(
    _ sibling: u32,
    _ query: u32,
) -> (u32, u32, u32, u32) {
    let rounds = schedule16_rounds()
    let placement = fri_query_sibling_from_four_rounds(ref rounds, sibling, query)
    (
        if placement.valid { 1 } else { 0 },
        placement.round_index,
        placement.round,
        placement.tree_node,
    )
}

fn domain_words<const ROUND: u32>() -> (u32, u32, u32) {
    (
        <FriFoldDomain<ROUND> as Poseidon2FieldDomain>::TAG,
        <FriLayerRowDomain<ROUND> as Poseidon2FieldDomain>::TAG,
        <FriLayerTranscriptDomain<ROUND> as Poseidon2FieldDomain>::TAG,
    )
}

pub fn fri_round_domains(_ index: u32) -> (u32, u32, u32) {
    match index {
        0 => domain_words<1>()
        1 => domain_words<2>()
        2 => domain_words<3>()
        3 => domain_words<4>()
        _ => (0, 0, 0)
    }
}

pub fn fri_runtime_round_domains(_ round: u32) -> (u32, u32, u32) {
    (
        fri_fold_domain_tag(round),
        fri_layer_row_domain_tag(round),
        fri_layer_transcript_domain_tag(round),
    )
}
use precision::baby_bear::{BabyBear, BabyBearExt4}

fn ext(_ a: u32, _ b: u32, _ c: u32, _ d: u32) -> BabyBearExt4 {
    BabyBearExt4::from_u32s([a, b, c, d])
}

fn words(_ valid: bool, _ value: BabyBearExt4) -> (u32, u32, u32, u32, u32) {
    let coefficients = value.to_u32s()
    (
        if valid { 1 } else { 0 },
        coefficients[0], coefficients[1], coefficients[2], coefficients[3],
    )
}

pub fn fri_pair_at_point(
    _ p0: u32, _ p1: u32, _ p2: u32, _ p3: u32,
    _ n0: u32, _ n1: u32, _ n2: u32, _ n3: u32,
    _ b0: u32, _ b1: u32, _ b2: u32, _ b3: u32,
    _ point: u32,
) -> (u32, u32, u32, u32, u32) {
    let folded = fold_fri_pair_at_point(
        ext(p0, p1, p2, p3),
        ext(n0, n1, n2, n3),
        ext(b0, b1, b2, b3),
        BabyBear::from_u32(point),
    )
    words(folded.valid, folded.evaluation)
}

pub fn fri_pair16_checked(
    _ p0: u32, _ p1: u32, _ p2: u32, _ p3: u32,
    _ n0: u32, _ n1: u32, _ n2: u32, _ n3: u32,
    _ b0: u32, _ b1: u32, _ b2: u32, _ b3: u32,
    _ shift: u32,
    _ index: u32,
) -> (u32, u32, u32, u32, u32) {
    let folded = fold_fri_pair_at_power_of_two<16>(
        ext(p0, p1, p2, p3),
        ext(n0, n1, n2, n3),
        ext(b0, b1, b2, b3),
        BabyBear::from_u32(shift),
        index,
    )
    words(folded.valid, folded.evaluation)
}

pub fn fri_pair16_value(
    _ p0: u32, _ p1: u32, _ p2: u32, _ p3: u32,
    _ n0: u32, _ n1: u32, _ n2: u32, _ n3: u32,
    _ b0: u32, _ b1: u32, _ b2: u32, _ b3: u32,
    _ shift: u32,
    _ index: u32,
) -> (u32, u32, u32, u32) {
    let coefficients = fold_fri_pair_value_at_power_of_two<16>(
        ext(p0, p1, p2, p3),
        ext(n0, n1, n2, n3),
        ext(b0, b1, b2, b3),
        BabyBear::from_u32(shift),
        index,
    ).to_u32s()
    (coefficients[0], coefficients[1], coefficients[2], coefficients[3])
}
