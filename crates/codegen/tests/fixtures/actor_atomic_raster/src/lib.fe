use std::webgpu::{
    AtomicStorageBuffer, StorageBuffer, GpuProgram, WebGpuBackend,
    ComputeSurface, Workgroup, FixedDispatch,
    VertexStage, FragmentStage, RasterVertex, ClipPosition, TriangleList,
}

struct Varying { intensity: f32 }
impl Copy for Varying {}

actor AtomicRaster uses (GpuProgram<WebGpuBackend>) {
    claims: AtomicStorageBuffer<4>,
    colors: StorageBuffer<u32, 1>,

    fn initialize(self)
        uses (ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>)
    {
        self.claims.atomic_store(index: 0, value: 4294967295)
        self.colors.store(index: 0, value: 4294901760)
    }

    fn vertices(self, index: u32) -> RasterVertex<Varying>
        uses (VertexStage<Varying, TriangleList<3>>)
    {
        RasterVertex {
            position: ClipPosition {
                x: if index == 1 { 0.8 } else { -0.8 },
                y: if index == 2 { 0.8 } else { -0.8 },
                z: 0.0, w: 1.0,
            },
            varying: Varying { intensity: 1.0 },
        }
    }

    fn shade(self, v: Varying) -> u32 uses (FragmentStage<Varying>) {
        if v.intensity > 0.5 { self.colors.load(index: 0) } else { 0 }
    }
}
