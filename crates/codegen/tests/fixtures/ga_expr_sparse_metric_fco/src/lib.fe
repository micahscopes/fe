use ga_expr::{
    AlgebraicBalanced, BasisMetric, BasisVector, CompileNamedVectorDotF32,
    CompileVectorScalarF32, EvaluateVectorScalarF32, GaProgram,
    MetricSum, MetricTerm, MetricZero,
    NegativeMagnitude, Null, Positive, PositiveMagnitude, Prime, ScalarProduct,
    SparseSymmetricMetric, SymmetricMatrixMetric, VectorInput,
}

type MetricTerms = MetricSum<
    MetricTerm<0, 0, 1, 0>,
    MetricSum<
        MetricTerm<1, 1, 1, 0>,
        MetricSum<
            MetricTerm<2, 2, 1, 0>,
            MetricSum<
                MetricTerm<3, 9, 1, 1>,
                MetricSum<
                    MetricTerm<4, 10, 1, 1>,
                    MetricSum<
                        MetricTerm<5, 11, 1, 1>,
                        MetricSum<
                            MetricTerm<6, 12, 1, 1>,
                            MetricSum<
                                MetricTerm<7, 13, 1, 1>,
                                MetricSum<MetricTerm<8, 14, 1, 1>, MetricZero>,
                            >,
                        >,
                    >,
                >,
            >,
        >,
    >,
>
type Metric = SparseSymmetricMetric<15, MetricTerms>
struct PointCoefficients {
    p0: f32, p1: f32, p2: f32, p3: f32, p4: f32, p5: f32,
    p6: f32, p7: f32, p8: f32, p9: f32, p10: f32, p11: f32,
}
struct QuadricCoefficients {
    q0: f32, q1: f32, q2: f32, q3: f32, q4: f32, q5: f32,
    q6: f32, q7: f32, q8: f32, q9: f32, q10: f32, q11: f32,
}
type Point = VectorInput<PointCoefficients, 32319>
type Quadric = VectorInput<QuadricCoefficients, 4095>
type Incidence = ScalarProduct<Point, Quadric>

struct Operands {
    point: PointCoefficients,
    quadric: QuadricCoefficients,
}

derive EvaluateVectorScalarF32 for Operands using CompileVectorScalarF32<
    GaProgram<Incidence, Metric, AlgebraicBalanced>
>

pub fn sparse_metric_probe(
    _ p0: f32, _ p1: f32, _ p2: f32, _ p3: f32,
    _ p4: f32, _ p5: f32, _ p6: f32, _ p7: f32,
    _ p8: f32, _ p9: f32, _ p10: f32, _ p11: f32,
    _ q0: f32, _ q1: f32, _ q2: f32, _ q3: f32,
    _ q4: f32, _ q5: f32, _ q6: f32, _ q7: f32,
    _ q8: f32, _ q9: f32, _ q10: f32, _ q11: f32,
) -> f32 {
    <Operands as EvaluateVectorScalarF32>::scalar(Operands {
        point: PointCoefficients {
            p0: p0, p1: p1, p2: p2, p3: p3,
            p4: p4, p5: p5, p6: p6, p7: p7,
            p8: p8, p9: p9, p10: p10, p11: p11,
        },
        quadric: QuadricCoefficients {
            q0: q0, q1: q1, q2: q2, q3: q3,
            q4: q4, q5: q5, q6: q6, q7: q7,
            q8: q8, q9: q9, q10: q10, q11: q11,
        },
    })
}

// A deliberately unrelated configured instance exercises the actual generic
// boundary: different dimension, supports, runtime carrier width, signed
// metric magnitudes, and expression operand order. Neither configuration is
// named in `CompileVectorScalarF32`.
type TinyMetricTerms = MetricSum<
    MetricTerm<0, 0, 2, 0>,
    MetricSum<
        MetricTerm<1, 3, 1, 1>,
        MetricSum<MetricTerm<2, 2, 3, 1>, MetricZero>,
    >,
>
type TinyMetric = SparseSymmetricMetric<4, TinyMetricTerms>
struct TinyLeftCoefficients { l0: f32, l1: f32, l2: f32 }
struct TinyRightCoefficients { r0: f32, r1: f32, r2: f32 }
type TinyLeft = VectorInput<TinyLeftCoefficients, 7>
type TinyRight = VectorInput<TinyRightCoefficients, 13>
type TinyScalar = ScalarProduct<TinyLeft, TinyRight>
type TinyScalarReversed = ScalarProduct<TinyRight, TinyLeft>

struct TinyOperands {
    left: TinyLeftCoefficients,
    right: TinyRightCoefficients,
}

struct ReversedTinyOperands {
    left: TinyLeftCoefficients,
    right: TinyRightCoefficients,
}

derive EvaluateVectorScalarF32 for TinyOperands using CompileVectorScalarF32<
    GaProgram<TinyScalar, TinyMetric, AlgebraicBalanced>
>
derive EvaluateVectorScalarF32 for ReversedTinyOperands using CompileVectorScalarF32<
    GaProgram<TinyScalarReversed, TinyMetric, AlgebraicBalanced>
>

pub fn tiny_metric_probe(
    _ l0: f32, _ l1: f32, _ l2: f32,
    _ r0: f32, _ r1: f32, _ r2: f32,
) -> f32 {
    <TinyOperands as EvaluateVectorScalarF32>::scalar(TinyOperands {
        left: TinyLeftCoefficients { l0: l0, l1: l1, l2: l2 },
        right: TinyRightCoefficients { r0: r0, r1: r1, r2: r2 },
    })
}

pub fn reversed_tiny_metric_probe(
    _ l0: f32, _ l1: f32, _ l2: f32,
    _ r0: f32, _ r1: f32, _ r2: f32,
) -> f32 {
    <ReversedTinyOperands as EvaluateVectorScalarF32>::scalar(ReversedTinyOperands {
        left: TinyLeftCoefficients { l0: l0, l1: l1, l2: l2 },
        right: TinyRightCoefficients { r0: r0, r1: r1, r2: r2 },
    })
}

// The same Cl(2,0,1-null-pair) scalar form authored two ways. Field order in
// both coefficient records is deliberately unrelated to basis order: FCO
// aligns by names and derives support/packing.
struct Pair0 {}
struct NullBasis {
    x: Positive,
    origin: Null<Pair0>,
    infinity: Prime<Pair0>,
}
struct MatrixBasis { x: BasisVector, origin: BasisVector, infinity: BasisVector }
struct XRow { x: PositiveMagnitude<1> }
struct OriginRow { infinity: NegativeMagnitude<1> }
struct NullMatrix { x: XRow, origin: OriginRow }

struct NamedLeft { infinity: f32, x: f32, origin: f32 }
struct NamedRight { origin: f32, infinity: f32, x: f32 }
type AutoNullMetric = BasisMetric<NullBasis>
type MatrixNullMetric = SymmetricMatrixMetric<MatrixBasis, NullMatrix>
struct AutoNullOperands { left: NamedLeft, right: NamedRight }
struct MatrixNullOperands { left: NamedLeft, right: NamedRight }
derive EvaluateVectorScalarF32 for AutoNullOperands using CompileNamedVectorDotF32<
    NamedLeft, NamedRight, AutoNullMetric,
>
derive EvaluateVectorScalarF32 for MatrixNullOperands using CompileNamedVectorDotF32<
    NamedLeft, NamedRight, MatrixNullMetric,
>

pub fn auto_null_metric_probe(
    _ lx: f32, _ lo: f32, _ li: f32,
    _ rx: f32, _ ro: f32, _ ri: f32,
) -> f32 {
    <AutoNullOperands as EvaluateVectorScalarF32>::scalar(AutoNullOperands {
        left: NamedLeft { infinity: li, x: lx, origin: lo },
        right: NamedRight { origin: ro, infinity: ri, x: rx },
    })
}

pub fn matrix_null_metric_probe(
    _ lx: f32, _ lo: f32, _ li: f32,
    _ rx: f32, _ ro: f32, _ ri: f32,
) -> f32 {
    <MatrixNullOperands as EvaluateVectorScalarF32>::scalar(MatrixNullOperands {
        left: NamedLeft { infinity: li, x: lx, origin: lo },
        right: NamedRight { origin: ro, infinity: ri, x: rx },
    })
}
