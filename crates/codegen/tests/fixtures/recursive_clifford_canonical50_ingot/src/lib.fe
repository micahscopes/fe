fn runtime_sphere_pair_left(_ rank: i32) -> i32 {
    if rank < 4 { 0 }
    else if rank < 7 { 1 }
    else if rank < 9 { 2 }
    else { 3 }
}

fn runtime_sphere_pair_right(_ rank: i32) -> i32 {
    match rank {
        0 => 0
        1 => 1
        2 => 2
        3 => 3
        4 => 1
        5 => 2
        6 => 3
        7 => 2
        8 => 3
        _ => 3
    }
}

fn runtime_sphere_seed_blade(_ index: i32) -> i32 {
    match index {
        0 => SPHERE_E1
        1 => SPHERE_E2
        2 => SPHERE_E4
        _ => SPHERE_E5
    }
}

fn runtime_point_seed_blade(_ index: i32) -> i32 {
    match index {
        0 => POINT_E1
        1 => POINT_E2
        2 => POINT_E3
        3 => POINT_E4
        _ => POINT_E5
    }
}

struct ObservedZero {}
struct ObservedTerm<const Candidate: i32> {}
struct ObservedAdd<L, R> {}

trait ObserveCanonical50 { type Out }
impl ObserveCanonical50 for Zero { type Out = ObservedZero }
impl<const Candidate: usize> ObserveCanonical50 for Term<Candidate> {
    type Out = ObservedTerm<{Candidate.downcast_truncate()}>
}
impl<L: ObserveCanonical50, R: ObserveCanonical50> ObserveCanonical50
    for Add<L, R>
{
    type Out = ObservedAdd<
        <L as ObserveCanonical50>::Out,
        <R as ObserveCanonical50>::Out,
    >
}

type ObservedCanonical50 =
    <Canonical50Schedule32 as ObserveCanonical50>::Out

trait InspectCanonical50 {
    fn field(index: i32, field: i32) -> i32
}
impl InspectCanonical50 for ObservedZero {
    fn field(index: i32, field: i32) -> i32 { -1 }
}
impl<const Candidate: i32> InspectCanonical50 for ObservedTerm<Candidate> {
    fn field(index: i32, field: i32) -> i32 {
        if index == 0 {
            let candidate: i32 = Candidate
            let pair = runtime_candidate_pair(candidate)
            let point = runtime_candidate_point(candidate)
            if field == 0 {
                candidate
            } else if field == 1 {
                runtime_projected_output(candidate)
            } else if field == 2 {
                runtime_sphere_seed_blade(runtime_sphere_pair_left(pair))
            } else if field == 3 {
                runtime_point_seed_blade(point)
            } else if field == 4 {
                runtime_sphere_seed_blade(runtime_sphere_pair_right(pair))
            } else if field == 5 {
                candidate_magnitude(candidate)
            } else {
                candidate_negative(candidate)
            }
        } else {
            -1
        }
    }
}
impl<H: InspectCanonical50, T: InspectCanonical50> InspectCanonical50
    for ObservedAdd<H, T>
{
    fn field(index: i32, field: i32) -> i32 {
        if index == 0 {
            <H as InspectCanonical50>::field(index: 0, field: field)
        } else {
            <T as InspectCanonical50>::field(
                index: index - 1, field: field,
            )
        }
    }
}

pub fn canonical50_schedule_field(index: i32, field: i32) -> i32 {
    <ObservedCanonical50 as InspectCanonical50>::field(
        index: index, field: field,
    )
}
