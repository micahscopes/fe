use canonical_cl41_schedule::{
    Canonical50Schedule32,
    candidate_output_blade_i32,
    canonical50_projected_sign,
}
use sparse_clifford::{Add, PlanLength, Term, Zero}


// Force the public recursive SparsePlan/Term representation itself.
fn canonical50_plan_has_32_terms(
    _ value: <Canonical50Schedule32 as PlanLength>::Out,
) {}

fn candidate_magnitude(_ candidate: i32) -> i32 {
    let pair = runtime_candidate_pair(candidate)
    if pair == 0 || pair == 4 || pair == 7 || pair == 9 { 1 } else { 2 }
}

fn runtime_candidate_pair(_ candidate: i32) -> i32 {
    if candidate < 5 { 0 }
    else if candidate < 10 { 1 }
    else if candidate < 15 { 2 }
    else if candidate < 20 { 3 }
    else if candidate < 25 { 4 }
    else if candidate < 30 { 5 }
    else if candidate < 35 { 6 }
    else if candidate < 40 { 7 }
    else if candidate < 45 { 8 }
    else { 9 }
}

fn runtime_candidate_point(_ candidate: i32) -> i32 {
    if candidate < 5 { candidate }
    else if candidate < 10 { candidate - 5 }
    else if candidate < 15 { candidate - 10 }
    else if candidate < 20 { candidate - 15 }
    else if candidate < 25 { candidate - 20 }
    else if candidate < 30 { candidate - 25 }
    else if candidate < 35 { candidate - 30 }
    else if candidate < 40 { candidate - 35 }
    else if candidate < 45 { candidate - 40 }
    else { candidate - 45 }
}

fn candidate_negative(_ candidate: i32) -> i32 {
    runtime_projected_sign(candidate)
}

