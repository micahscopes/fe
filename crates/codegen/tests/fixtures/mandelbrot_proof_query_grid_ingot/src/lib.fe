//! Portable WebGPU extraction of the production Mandelbrot FRI query grid.
//!
//! The 114-query count comes from the security policy, and the per-query
//! opening geometry comes from the thirteen-round FRI schedule. The actor
//! supplies only a portable workgroup tile. No query identity, opening count,
//! dispatch count, placement table, or authentication path is authored beside
//! those denotations.

use fri_structure::{
    FriQueryRangePlan,
    FriSchedule,
    FriSchedulePlacement,
    FriScheduleShape,
    fri_query_evaluation_work_item,
    fri_query_grid_metadata,
    fri_query_grid_workgroups,
    fri_query_sample_work_item,
    fri_query_sibling_work_item,
}
use fri_structure_webgpu::{
    FRI_QUERY_CURSOR_FIELDS,
    advance_fri_query_evaluation_storage,
    advance_fri_query_sibling_storage,
    fri_round_placement_storage_words,
    store_fri_round_placement,
}
use fri_baby_bear::fri_query_domain_tag
use fri_opening_webgpu::compact_fri_round_openings
use mandelbrot_proof_production_profile_baby_bear::{
    PRODUCTION_LDE_LENGTH,
    PRODUCTION_LDE_LOG,
    PRODUCTION_SECURITY_QUERY_COUNT,
}
use poseidon_baby_bear::{DIGEST_FIELDS, Poseidon2Digest}
use poseidon_baby_bear_webgpu::{
    INDEXED_DIGEST_SQUEEZE_STEPS,
    POSEIDON2_LANES,
    advance_indexed_digest_squeeze_lane,
    indexed_digest_squeeze_progress_words,
    indexed_digest_squeeze_state_words,
    indexed_digest_squeeze_tail_words,
    indexed_digest_squeeze_valid_words,
    indexed_digest_squeeze_workgroups,
    indexed_digest_squeeze_workspace_words,
}
use std::webgpu::{
    ComputeInvocation,
    ComputeSurface as Kernel,
    FixedDispatch as Grid,
    FragmentSurface as Pixel,
    GpuProgram as Program,
    RepeatedDispatch as Repeat,
    StorageBuffer as Shared,
    Workgroup as Threads,
    WebGpuBackend,
}

type QueryPlan = FriQueryRangePlan<1, {PRODUCTION_SECURITY_QUERY_COUNT}>
type FoldSchedule = FriSchedule<1, {PRODUCTION_LDE_LOG}>

const THREADS: usize = 64
const RECEIPT_WORDS: usize = 4
const DIGEST_WORDS: usize = 8
const QUERY_COUNT: usize =
    fri_query_grid_metadata<QueryPlan, FoldSchedule>().query_count as usize
const EVALUATIONS_PER_QUERY: usize =
    fri_query_grid_metadata<QueryPlan, FoldSchedule>().evaluations_per_query as usize
const SIBLINGS_PER_QUERY: usize =
    fri_query_grid_metadata<QueryPlan, FoldSchedule>().siblings_per_query as usize
const EVALUATION_ITEMS: usize =
    fri_query_grid_metadata<QueryPlan, FoldSchedule>().evaluation_items as usize
const SIBLING_ITEMS: usize =
    fri_query_grid_metadata<QueryPlan, FoldSchedule>().sibling_items as usize
const EVALUATION_GROUPS: usize = fri_query_grid_workgroups(
    EVALUATION_ITEMS.downcast_truncate(),
    THREADS.downcast_truncate(),
) as usize
const SIBLING_GROUPS: usize = fri_query_grid_workgroups(
    SIBLING_ITEMS.downcast_truncate(),
    THREADS.downcast_truncate(),
) as usize
const EVALUATION_PADDING: usize = EVALUATION_GROUPS * THREADS - EVALUATION_ITEMS
const SIBLING_PADDING: usize = SIBLING_GROUPS * THREADS - SIBLING_ITEMS
const PADDING_RECEIPT_WORDS: usize = EVALUATION_PADDING + SIBLING_PADDING
const EVALUATION_OPENING_WORDS: usize = EVALUATION_ITEMS * RECEIPT_WORDS
const SIBLING_OPENING_WORDS: usize = SIBLING_ITEMS * DIGEST_WORDS
const FRI_ROUNDS: usize =
    <FoldSchedule as FriScheduleShape>::fri_schedule_metadata().rounds as usize
const FOLDED_EVALUATIONS: usize =
    <FoldSchedule as FriScheduleShape>::fri_schedule_metadata()
        .folded_evaluations as usize
const LAYER_TREE_NODES: usize =
    <FoldSchedule as FriScheduleShape>::fri_schedule_metadata()
        .layer_tree_nodes as usize
const ROUND_PLACEMENT_WORDS: usize =
    fri_round_placement_storage_words(FRI_ROUNDS)
const FOLDED_EVALUATION_WORDS: usize = FOLDED_EVALUATIONS * RECEIPT_WORDS
const LAYER_TREE_WORDS: usize = LAYER_TREE_NODES * DIGEST_WORDS
const PROOF_DATA_WORDS: usize = FOLDED_EVALUATION_WORDS + LAYER_TREE_WORDS
const LAYER_TREE_START: u32 = FOLDED_EVALUATION_WORDS.downcast_truncate()
const EVALUATION_CURSOR_START: u32 = PROOF_DATA_WORDS.downcast_truncate()
const EVALUATION_CURSOR_WORDS: usize =
    EVALUATION_ITEMS * FRI_QUERY_CURSOR_FIELDS
const EVALUATION_PROGRESS_START: u32 =
    EVALUATION_CURSOR_START + EVALUATION_CURSOR_WORDS.downcast_truncate()
const SIBLING_CURSOR_START: u32 =
    EVALUATION_PROGRESS_START + EVALUATION_ITEMS.downcast_truncate()
const SIBLING_CURSOR_WORDS: usize = SIBLING_ITEMS * FRI_QUERY_CURSOR_FIELDS
const SIBLING_PROGRESS_START: u32 =
    SIBLING_CURSOR_START + SIBLING_CURSOR_WORDS.downcast_truncate()
const OPENING_ACTIVITY_START: u32 =
    SIBLING_PROGRESS_START + SIBLING_ITEMS.downcast_truncate()
const PROOF_ARENA_WORDS: usize =
    OPENING_ACTIVITY_START as usize + LAYER_TREE_NODES
const COMPACT_VALID_START: u32 = 0
const COMPACT_LEAF_COUNT_START: u32 = FRI_ROUNDS.downcast_truncate()
const COMPACT_SIBLING_COUNT_START: u32 =
    COMPACT_LEAF_COUNT_START + FRI_ROUNDS.downcast_truncate()
const COMPACT_LEAF_INDEX_START: u32 =
    COMPACT_SIBLING_COUNT_START + FRI_ROUNDS.downcast_truncate()
const COMPACT_METADATA_WORDS: usize =
    3 * FRI_ROUNDS + EVALUATION_ITEMS
const OPENING_PADDING_START: u32 = COMPACT_METADATA_WORDS.downcast_truncate()
const OPENING_METADATA_WORDS: usize =
    COMPACT_METADATA_WORDS + PADDING_RECEIPT_WORDS
const QUERY_STATE_WORDS: usize =
    indexed_digest_squeeze_state_words(QUERY_COUNT)
const QUERY_TAIL_WORDS: usize =
    indexed_digest_squeeze_tail_words(QUERY_COUNT)
const QUERY_VALID_WORDS: usize =
    indexed_digest_squeeze_valid_words(QUERY_COUNT)
const QUERY_PROGRESS_WORDS: usize =
    indexed_digest_squeeze_progress_words(QUERY_COUNT)
const QUERY_SAMPLE_GROUPS: usize =
    indexed_digest_squeeze_workgroups(QUERY_COUNT, THREADS)
const QUERY_SAMPLE_PADDING: usize =
    QUERY_SAMPLE_GROUPS * THREADS - QUERY_COUNT * POSEIDON2_LANES
const QUERY_SAMPLE_WORK_ITEMS: u32 =
    (QUERY_COUNT * POSEIDON2_LANES).downcast_truncate()
const QUERY_HALF_MASK: u32 = (PRODUCTION_LDE_LENGTH / 2 - 1).downcast_truncate()

const QUERY_TRANSCRIPT_WORDS: usize = DIGEST_FIELDS
const QUERY_TRANSCRIPT_START: u32 = 0
const QUERY_TRANSCRIPT_VALID: u32 =
    QUERY_TRANSCRIPT_START + QUERY_TRANSCRIPT_WORDS.downcast_truncate()
const QUERY_INDICES_START: u32 = QUERY_TRANSCRIPT_VALID + 1
const QUERY_PADDING_START: u32 = QUERY_INDICES_START + QUERY_COUNT.downcast_truncate()
const QUERY_CONTROL_WORDS: usize =
    QUERY_TRANSCRIPT_WORDS + 1 + QUERY_COUNT + QUERY_SAMPLE_PADDING
const QUERY_WORKSPACE_WORDS: usize =
    indexed_digest_squeeze_workspace_words(QUERY_COUNT)

static_assert(QUERY_COUNT == PRODUCTION_SECURITY_QUERY_COUNT)
static_assert(QUERY_COUNT == 114)
static_assert(EVALUATIONS_PER_QUERY == 25)
static_assert(SIBLINGS_PER_QUERY == 132)
static_assert(EVALUATION_ITEMS == 2850)
static_assert(SIBLING_ITEMS == 15048)
static_assert(EVALUATION_GROUPS == 45)
static_assert(SIBLING_GROUPS == 236)
static_assert(EVALUATION_PADDING == 30)
static_assert(SIBLING_PADDING == 56)
static_assert(POSEIDON2_LANES == 16)
static_assert(INDEXED_DIGEST_SQUEEZE_STEPS == 89)
static_assert(QUERY_STATE_WORDS == 3648)
static_assert(QUERY_TAIL_WORDS == 342)
static_assert(QUERY_VALID_WORDS == 114)
static_assert(QUERY_PROGRESS_WORDS == 1824)
static_assert(QUERY_SAMPLE_GROUPS == 29)
static_assert(QUERY_SAMPLE_PADDING == 32)
static_assert(QUERY_TRANSCRIPT_WORDS == 8)
static_assert(QUERY_CONTROL_WORDS == 155)
static_assert(QUERY_WORKSPACE_WORDS == 5928)
static_assert(QUERY_PADDING_START == 123)
static_assert(FRI_ROUNDS == 13)
static_assert(FOLDED_EVALUATIONS == 8191)
static_assert(LAYER_TREE_NODES == 16369)
static_assert(ROUND_PLACEMENT_WORDS == 169)
static_assert(PROOF_DATA_WORDS == 163716)
static_assert(OPENING_ACTIVITY_START == 324798)
static_assert(PROOF_ARENA_WORDS == 341167)
static_assert(COMPACT_METADATA_WORDS == 2889)
static_assert(OPENING_METADATA_WORDS == 2975)

actor ProductionQueryGrid uses (Program<WebGpuBackend>) {
    query_control: Shared<u32, QUERY_CONTROL_WORDS>,
    query_workspace: Shared<u32, QUERY_WORKSPACE_WORDS>,
    round_placements: Shared<u32, ROUND_PLACEMENT_WORDS>,
    proof_arena: Shared<u32, PROOF_ARENA_WORDS>,
    evaluation_openings: Shared<u32, EVALUATION_OPENING_WORDS>,
    sibling_openings: Shared<u32, SIBLING_OPENING_WORDS>,
    opening_metadata: Shared<u32, OPENING_METADATA_WORDS>,

    fn prepare_rounds(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<1, 1, 1>>)
    {
        let lane = invocation.global.x
        if lane >= FRI_ROUNDS.downcast_truncate() { return }
        store_fri_round_placement<ROUND_PLACEMENT_WORDS>(
            self.round_placements,
            lane,
            <FoldSchedule as FriSchedulePlacement>::fri_round_placement(lane),
        )
    }

    fn sample_queries(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<
                    QUERY_SAMPLE_GROUPS,
                    1,
                    1,
                    INDEXED_DIGEST_SQUEEZE_STEPS,
                >,
            >
        )
    {
        let query_position = invocation.global.x
            / POSEIDON2_LANES.downcast_truncate()
        let item = fri_query_sample_work_item<QueryPlan>(query_position)
        let input_valid = item.valid
            && self.query_control.load(index: QUERY_TRANSCRIPT_VALID) == 1
        let transcript = Poseidon2Digest::from_u32s([
            self.query_control.load(index: QUERY_TRANSCRIPT_START),
            self.query_control.load(index: QUERY_TRANSCRIPT_START + 1),
            self.query_control.load(index: QUERY_TRANSCRIPT_START + 2),
            self.query_control.load(index: QUERY_TRANSCRIPT_START + 3),
            self.query_control.load(index: QUERY_TRANSCRIPT_START + 4),
            self.query_control.load(index: QUERY_TRANSCRIPT_START + 5),
            self.query_control.load(index: QUERY_TRANSCRIPT_START + 6),
            self.query_control.load(index: QUERY_TRANSCRIPT_START + 7),
        ])
        let step = advance_indexed_digest_squeeze_lane<
            QUERY_COUNT,
            QUERY_WORKSPACE_WORDS,
        >(
            self.query_workspace,
            invocation,
            fri_query_domain_tag(),
            transcript,
            item.query_identity,
            input_valid,
        )
        if !step.active {
            self.query_control.store(
                index: QUERY_PADDING_START
                    + invocation.global.x - QUERY_SAMPLE_WORK_ITEMS,
                value: invocation.global.x + 1,
            )
        } else if !step.valid && step.field_lane == 0 {
            self.query_control.store(
                index: QUERY_INDICES_START + step.state,
                value: 0,
            )
        } else if step.complete {
            self.query_control.store(
                index: QUERY_INDICES_START + step.state,
                value: step.value.coefficient(0).to_u32() & QUERY_HALF_MASK,
            )
        }
    }

    fn open_evaluations(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<EVALUATION_GROUPS, 1, 1, FRI_ROUNDS>,
            >
        )
    {
        let lane = invocation.global.x
        let item = fri_query_evaluation_work_item<QueryPlan, FoldSchedule>(lane)
        if !item.valid {
            self.opening_metadata.store(
                index: OPENING_PADDING_START
                    + lane - EVALUATION_ITEMS.downcast_truncate(),
                value: lane + 1,
            )
            return
        }
        let query = self.query_control.load(
            index: QUERY_INDICES_START + item.query_position,
        )
        let progress_index = EVALUATION_PROGRESS_START + lane
        let round = self.proof_arena.load(index: progress_index)
        if round >= FRI_ROUNDS.downcast_truncate() { return }
        let cursor_base = EVALUATION_CURSOR_START
            + lane * FRI_QUERY_CURSOR_FIELDS.downcast_truncate()
        let placement = advance_fri_query_evaluation_storage<
            ROUND_PLACEMENT_WORDS,
            PROOF_ARENA_WORDS,
        >(
            self.round_placements,
            self.proof_arena,
            cursor_base,
            round,
            item.opening,
            query,
        )
        self.proof_arena.store(index: progress_index, value: round + 1)
        if round + 1 != FRI_ROUNDS.downcast_truncate() { return }
        if !placement.valid { return }
        let source = placement.evaluation_index
            * RECEIPT_WORDS.downcast_truncate()
        let destination = lane * RECEIPT_WORDS.downcast_truncate()
        self.evaluation_openings.store(
            index: destination,
            value: self.proof_arena.load(index: source),
        )
        self.evaluation_openings.store(
            index: destination + 1,
            value: self.proof_arena.load(index: source + 1),
        )
        self.evaluation_openings.store(
            index: destination + 2,
            value: self.proof_arena.load(index: source + 2),
        )
        self.evaluation_openings.store(
            index: destination + 3,
            value: self.proof_arena.load(index: source + 3),
        )
    }

    fn open_siblings(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Repeat<SIBLING_GROUPS, 1, 1, FRI_ROUNDS>,
            >
        )
    {
        let lane = invocation.global.x
        let item = fri_query_sibling_work_item<QueryPlan, FoldSchedule>(lane)
        if !item.valid {
            let evaluation_padding: u32 = EVALUATION_PADDING.downcast_truncate()
            self.opening_metadata.store(
                index: OPENING_PADDING_START + evaluation_padding
                    + lane - SIBLING_ITEMS.downcast_truncate(),
                value: lane + 1,
            )
            return
        }
        let query = self.query_control.load(
            index: QUERY_INDICES_START + item.query_position,
        )
        let progress_index = SIBLING_PROGRESS_START + lane
        let round = self.proof_arena.load(index: progress_index)
        if round >= FRI_ROUNDS.downcast_truncate() { return }
        let cursor_base = SIBLING_CURSOR_START
            + lane * FRI_QUERY_CURSOR_FIELDS.downcast_truncate()
        let placement = advance_fri_query_sibling_storage<
            ROUND_PLACEMENT_WORDS,
            PROOF_ARENA_WORDS,
        >(
            self.round_placements,
            self.proof_arena,
            cursor_base,
            round,
            item.sibling,
            query,
        )
        self.proof_arena.store(index: progress_index, value: round + 1)
        if round + 1 != FRI_ROUNDS.downcast_truncate() { return }
        if !placement.valid { return }
        let source = LAYER_TREE_START
            + placement.tree_node * DIGEST_WORDS.downcast_truncate()
        let destination = lane * DIGEST_WORDS.downcast_truncate()
        self.sibling_openings.store(
            index: destination,
            value: self.proof_arena.load(index: source),
        )
        self.sibling_openings.store(
            index: destination + 1,
            value: self.proof_arena.load(index: source + 1),
        )
        self.sibling_openings.store(
            index: destination + 2,
            value: self.proof_arena.load(index: source + 2),
        )
        self.sibling_openings.store(
            index: destination + 3,
            value: self.proof_arena.load(index: source + 3),
        )
        self.sibling_openings.store(
            index: destination + 4,
            value: self.proof_arena.load(index: source + 4),
        )
        self.sibling_openings.store(
            index: destination + 5,
            value: self.proof_arena.load(index: source + 5),
        )
        self.sibling_openings.store(
            index: destination + 6,
            value: self.proof_arena.load(index: source + 6),
        )
        self.sibling_openings.store(
            index: destination + 7,
            value: self.proof_arena.load(index: source + 7),
        )
    }

    fn compact_openings(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<1, 1, 1>>)
    {
        let round = invocation.global.x
        if round >= FRI_ROUNDS.downcast_truncate() { return }
        let valid = compact_fri_round_openings<
            QUERY_COUNT,
            RECEIPT_WORDS,
            DIGEST_WORDS,
            QUERY_CONTROL_WORDS,
            ROUND_PLACEMENT_WORDS,
            PROOF_ARENA_WORDS,
            OPENING_METADATA_WORDS,
            EVALUATION_OPENING_WORDS,
            SIBLING_OPENING_WORDS,
        >(
            self.query_control,
            QUERY_INDICES_START,
            self.round_placements,
            self.proof_arena,
            0,
            LAYER_TREE_START,
            OPENING_ACTIVITY_START,
            round,
            self.opening_metadata,
            COMPACT_LEAF_COUNT_START,
            COMPACT_SIBLING_COUNT_START,
            COMPACT_LEAF_INDEX_START,
            self.evaluation_openings,
            self.sibling_openings,
        )
        self.opening_metadata.store(
            index: COMPACT_VALID_START + round,
            value: if valid { 1 } else { 0 },
        )
    }

    fn paint(self, px: i32, py: i32) -> i32 uses (Pixel) {
        self.evaluation_openings.load(index: 0).downcast_truncate()
    }
}
