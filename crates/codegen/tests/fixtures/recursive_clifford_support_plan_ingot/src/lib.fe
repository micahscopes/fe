use sparse_clifford::{
    Add,
    Cl41Metric,
    CliffordGp,
    Nat,
    PlanLength,
    SparsePlan,
    Term,
    Zero,
    blade_set,
    clifford_support_bits_mvt5,
    clifford_support_mvt5,
    support_cardinality,
    support_grade,
}

// Interpret the authored Fuchs–Théry product over the conservative support
// coefficient algebra. This is the same public CliffordGp recurrence used by
// f32 values; only the coefficient interpretation changes.
const fn authored_sandwich_support_bits() -> u32 {
    let sphere = clifford_support_mvt5(65798)
    let point = clifford_support_mvt5(65814)
    let metric = Cl41Metric {}
    let first = sphere.clifford_gp(
        other: point,
        metric: metric,
        level: 5,
    )
    let sandwich = first.clifford_gp(
        other: sphere,
        metric: metric,
        level: 5,
    )
    clifford_support_bits_mvt5(sandwich)
}

// Support interpretation preserves every possibly nonzero term and therefore
// retains grade-3 candidates that cancel in the exact S*P*S coefficient
// algebra. The known vector result is selected compositionally by grade.
const fn authored_vector_support_bits() -> u32 {
    support_grade(
        blade_set(authored_sandwich_support_bits(), 5),
        1,
    ).bits
}

const fn authored_vector_support_count() -> usize {
    support_cardinality(
        blade_set(authored_vector_support_bits(), 5),
    ).downcast_truncate()
}

const fn authored_vector_keep0() -> u32 {
    authored_vector_support_bits() & 16777215
}

const fn authored_vector_keep1() -> u32 {
    authored_vector_support_bits() >> 24
}

static_assert(authored_sandwich_support_bits() == 376007062)
static_assert(authored_vector_support_bits() == 65814)
static_assert(authored_vector_support_count() == 5)

type AuthoredVectorPlan = SparsePlan<
    {authored_vector_keep0()},
    {authored_vector_keep1()},
    0, 0, 0, 0, 0, 0,
    32,
    {authored_vector_support_count()},
>

fn takes_nat5(_ value: Nat<5>) {}
fn authored_plan_has_five_terms(value: <AuthoredVectorPlan as PlanLength>::Out) {
    takes_nat5(value)
}

trait PlanOrderHash {
    const fn plan_order_hash() -> i32
}

impl PlanOrderHash for Zero {
    const fn plan_order_hash() -> i32 { 0 }
}

impl<const Candidate: usize, Tail: PlanOrderHash> PlanOrderHash
    for Add<Term<Candidate>, Tail>
{
    const fn plan_order_hash() -> i32 {
        let candidate: i32 = Candidate.downcast_truncate()
        candidate + 33 * <Tail as PlanOrderHash>::plan_order_hash()
    }
}

pub fn authored_support_plan_probe() -> i32 {
    <AuthoredVectorPlan as PlanOrderHash>::plan_order_hash()
}
