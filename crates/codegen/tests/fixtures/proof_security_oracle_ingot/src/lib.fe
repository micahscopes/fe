//! Executable boundary for conservative proof security policy arithmetic.

use canonical_words::{
    BrowserWordReader,
    BrowserWordWriter,
    CanonicalWords,
    decode_canonical_words,
    encode_canonical_words,
}
use mandelbrot_proof_air_core::{
    FriQueryRangePlan,
    FriQueryPlanShape,
    fri_query_range_identity,
}
use mandelbrot_proof_fixed_air_receipt_baby_bear::{
    SPARSE_SECURITY_PROFILE_FIELDS,
    SPARSE_SECURITY_PROFILE_WORDS,
    SparseDirectFriTranscriptProfile,
    commit_sparse_direct_fri_transcript_profile,
    production_checkpoint_security_profile,
    production_recursive_security_profile,
}
use proof_security::{
    DirectFriSecurityPolicy,
    derive_conjectured_direct_fri_policy,
    direct_fri_security_policy_is_derived,
    security_ceil_log2,
    security_floor_log2,
}

const BABY_BEAR_MODULUS: u32 = 2013265921
const EXTENSION_DEGREE: u32 = 4
const TRACE_LENGTH: u32 = 4096
const LDE_LENGTH: u32 = 8192
const COMPOSITION_DEGREE_BOUND: u32 = TRACE_LENGTH - 1
const FOLDING_ARITY: u32 = 2
const AIR_CONSTRAINT_CAP: u32 = 8192
const HASH_COLLISION_BITS: u32 = 128

const RECURSIVE_SECURITY_POLICY: DirectFriSecurityPolicy =
    derive_conjectured_direct_fri_policy(
        100,
        1024,
        BABY_BEAR_MODULUS,
        EXTENSION_DEGREE,
        TRACE_LENGTH,
        LDE_LENGTH,
        COMPOSITION_DEGREE_BOUND,
        FOLDING_ARITY,
        AIR_CONSTRAINT_CAP,
        HASH_COLLISION_BITS,
        0,
        0,
    )

pub type RecursiveSecurityQueryPlan = FriQueryRangePlan<
    1,
    {RECURSIVE_SECURITY_POLICY.query_count as usize},
>

/// Evidence that the policy-selected count is the type-level query plan.
/// No value-level query list exists between the two interpreters.
pub fn recursive_security_query_plan() -> (u32, u32, u32, u32, u32, u32) {
    let metadata = <RecursiveSecurityQueryPlan
        as FriQueryPlanShape>::fri_query_plan_metadata()
    (
        if RECURSIVE_SECURITY_POLICY.valid { 1 } else { 0 },
        metadata.samples,
        metadata.first_query,
        metadata.next_query,
        fri_query_range_identity(
            metadata.first_query,
            metadata.samples as usize,
            113,
        ),
        fri_query_range_identity(
            metadata.first_query,
            metadata.samples as usize,
            114,
        ),
    )
}

fn policy_words(_ policy: DirectFriSecurityPolicy) -> (
    u32, u32, u32, u32, u32, u32, u32, u32, u32, u32,
) {
    (
        if policy.valid { 1 } else { 0 },
        policy.query_count,
        policy.field_bits_q16.downcast_truncate(),
        policy.bits_per_query_q16.downcast_truncate(),
        policy.local_target_bits_q16.downcast_truncate(),
        policy.query_bits_q16.downcast_truncate(),
        policy.air_bits_q16.downcast_truncate(),
        policy.commit_bits_q16.downcast_truncate(),
        policy.local_attained_bits_q16.downcast_truncate(),
        policy.global_attained_bits_q16.downcast_truncate(),
    )
}

fn baby_bear_policy(
    _ target_bits: u32,
    _ max_composed_proofs: u32,
) -> DirectFriSecurityPolicy {
    derive_conjectured_direct_fri_policy(
        target_bits,
        max_composed_proofs,
        BABY_BEAR_MODULUS,
        EXTENSION_DEGREE,
        TRACE_LENGTH,
        LDE_LENGTH,
        COMPOSITION_DEGREE_BOUND,
        FOLDING_ARITY,
        AIR_CONSTRAINT_CAP,
        HASH_COLLISION_BITS,
        0,
        0,
    )
}

pub fn leaf_policy100() -> (
    u32, u32, u32, u32, u32, u32, u32, u32, u32, u32,
) {
    policy_words(baby_bear_policy(100, 1))
}

pub fn recursive_policy100x1024() -> (
    u32, u32, u32, u32, u32, u32, u32, u32, u32, u32,
) {
    policy_words(baby_bear_policy(100, 1024))
}

pub fn recursive_policy100x2048() -> (
    u32, u32, u32, u32, u32, u32, u32, u32, u32, u32,
) {
    policy_words(baby_bear_policy(100, 2048))
}

pub fn recursive_policy_degree_boundary() -> (u32, u32) {
    (
        RECURSIVE_SECURITY_POLICY.composition_degree_bound,
        RECURSIVE_SECURITY_POLICY.trace_length,
    )
}

/// Exercise both halves of the canonical `u64` leaf codec with a value whose
/// high and low words are both nonzero. This is the primitive needed by the
/// reflection-derived security-policy schema.
pub fn canonical_u64_roundtrip(_ value: u64) -> u64 {
    let bytes = encode_canonical_words(
        ref value,
        BrowserWordWriter::allocate(<u64 as CanonicalWords>::WORDS),
    ).finish()
    let mut decoded: u64 = 0
    let reader = decode_canonical_words(
        mut decoded,
        BrowserWordReader::new(bytes),
    )
    if reader.complete() { decoded } else { 0 as u64 }
}

/// Verifiers must recompute every derived policy lane. A serialized `valid`
/// bit therefore cannot bless mutations to either primary or derived data.
pub fn derived_policy_mutation(_ case: u32) -> u32 {
    let mut policy = RECURSIVE_SECURITY_POLICY
    match case {
        0 => {}
        1 => { policy.query_count = policy.query_count + 1 }
        2 => {
            policy.bits_per_query_q16 = policy.bits_per_query_q16 - 1
        }
        3 => {
            policy.global_attained_bits_q16 =
                policy.global_attained_bits_q16 + 1
        }
        _ => { policy.valid = false }
    }
    if direct_fri_security_policy_is_derived(policy) { 1 } else { 0 }
}

pub fn malformed_policy(_ case: u32) -> u32 {
    let policy = match case {
        0 => derive_conjectured_direct_fri_policy(
            100, 1, BABY_BEAR_MODULUS, EXTENSION_DEGREE,
            4095, LDE_LENGTH, 4094, FOLDING_ARITY, AIR_CONSTRAINT_CAP,
            HASH_COLLISION_BITS, 0, 0,
        ),
        1 => derive_conjectured_direct_fri_policy(
            100, 1, BABY_BEAR_MODULUS, EXTENSION_DEGREE,
            TRACE_LENGTH, 6144, COMPOSITION_DEGREE_BOUND,
            FOLDING_ARITY, AIR_CONSTRAINT_CAP,
            HASH_COLLISION_BITS, 0, 0,
        ),
        2 => derive_conjectured_direct_fri_policy(
            100, 0, BABY_BEAR_MODULUS, EXTENSION_DEGREE,
            TRACE_LENGTH, LDE_LENGTH, COMPOSITION_DEGREE_BOUND,
            FOLDING_ARITY, AIR_CONSTRAINT_CAP,
            HASH_COLLISION_BITS, 0, 0,
        ),
        3 => derive_conjectured_direct_fri_policy(
            100, 1, BABY_BEAR_MODULUS, EXTENSION_DEGREE,
            TRACE_LENGTH, LDE_LENGTH, COMPOSITION_DEGREE_BOUND,
            1, AIR_CONSTRAINT_CAP,
            HASH_COLLISION_BITS, 0, 0,
        ),
        4 => derive_conjectured_direct_fri_policy(
            100, 1, BABY_BEAR_MODULUS, EXTENSION_DEGREE,
            TRACE_LENGTH, LDE_LENGTH, COMPOSITION_DEGREE_BOUND,
            FOLDING_ARITY, 0,
            HASH_COLLISION_BITS, 0, 0,
        ),
        _ => derive_conjectured_direct_fri_policy(
            100, 1, BABY_BEAR_MODULUS, EXTENSION_DEGREE,
            TRACE_LENGTH, LDE_LENGTH, TRACE_LENGTH,
            FOLDING_ARITY, AIR_CONSTRAINT_CAP,
            HASH_COLLISION_BITS, 0, 0,
        ),
    }
    if policy.valid { 1 } else { 0 }
}

pub fn logarithm_bracket(_ value: u64) -> (u64, u64) {
    (security_floor_log2(value), security_ceil_log2(value))
}

fn production_profile_words(
    _ profile: SparseDirectFriTranscriptProfile,
) -> [u32; 22] {
    [
        if profile.valid { 1 } else { 0 },
        if profile.policy.valid { 1 } else { 0 },
        profile.policy.target_bits,
        profile.policy.max_composed_proofs,
        profile.policy.trace_length,
        profile.policy.lde_length,
        profile.policy.composition_degree_bound,
        profile.policy.query_count,
        if profile.air_shape.valid { 1 } else { 0 },
        profile.air_shape.all_rows,
        profile.air_shape.pair_rows,
        profile.air_shape.first_row,
        profile.air_shape.last_row,
        profile.air_shape.total,
        profile.air_shape.all_rows_degree,
        profile.air_shape.pair_rows_degree,
        profile.air_shape.first_row_degree,
        profile.air_shape.last_row_degree,
        profile.air_shape.maximum_degree,
        profile.executed_queries,
        SPARSE_SECURITY_PROFILE_WORDS.downcast_truncate(),
        SPARSE_SECURITY_PROFILE_FIELDS.downcast_truncate(),
    ]
}

pub fn production_checkpoint_profile_words() -> [u32; 22] {
    production_profile_words(production_checkpoint_security_profile())
}

pub fn production_recursive_profile_words() -> [u32; 22] {
    production_profile_words(production_recursive_security_profile())
}

/// Mutate the typed profile before committing it. Only the clean profile may
/// produce a nonzero domain-separated digest.
pub fn production_checkpoint_profile_commitment(
    _ mutation: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32, u32) {
    let mut profile = production_checkpoint_security_profile()
    match mutation {
        0 => {}
        1 => { profile.executed_queries = profile.executed_queries + 1 }
        2 => { profile.policy.query_count = profile.policy.query_count + 1 }
        3 => { profile.air_shape.total = profile.air_shape.total + 1 }
        4 => {
            profile.air_shape.maximum_degree =
                profile.air_shape.maximum_degree + 1
        }
        5 => {
            profile.policy.composition_degree_bound =
                profile.policy.composition_degree_bound + 1
        }
        _ => { profile.valid = false }
    }
    let commitment = commit_sparse_direct_fri_transcript_profile(ref profile)
    (
        if commitment.valid { 1 } else { 0 },
        commitment.value.field(0).to_u32(),
        commitment.value.field(1).to_u32(),
        commitment.value.field(2).to_u32(),
        commitment.value.field(3).to_u32(),
        commitment.value.field(4).to_u32(),
        commitment.value.field(5).to_u32(),
        commitment.value.field(6).to_u32(),
        commitment.value.field(7).to_u32(),
    )
}
