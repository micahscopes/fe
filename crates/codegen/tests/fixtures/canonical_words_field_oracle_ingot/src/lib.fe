//! Narrow executable gate for const-generic canonical field words.

use canonical_words::{
    BrowserWordReader,
    BrowserWordWriter,
    CanonicalWordStream,
    CanonicalWordStreamProvider,
    CanonicalWords,
    CanonicalWordsProvider,
    WordSink,
    WordSource,
    canonical_prefix_word_count,
    decode_canonical_prefix,
    encode_canonical_prefix,
    encode_canonical_word_array,
    encode_canonical_word_stream,
    encode_canonical_words,
}
use core::BrowserBytes
use precision::baby_bear::BabyBear
use precision::bn254_fr::Bn254Fr
use precision::field::FieldElement

type Fr = FieldElement<20, Bn254Fr>

const DERIVED_FIELD_COUNT: usize = 2 * 203 + 5

struct FieldArray<const N: usize> { values: [Fr; N] }
impl<const N: usize> core::marker::Copy for FieldArray<N> {}
impl<const N: usize> CanonicalWords for FieldArray<N> {
    const WORDS: u32 = <[Fr; N] as CanonicalWords>::WORDS

    fn encode<W: WordSink>(ref self, _ writer: W) -> W {
        self.values.encode(writer)
    }

    fn decode<R: WordSource>(mut self, _ reader: R) -> R {
        self.values.decode(reader)
    }
}

struct Envelope { valid: bool, fields: FieldArray<2> }
impl core::marker::Copy for Envelope {}
derive CanonicalWords for Envelope using CanonicalWordsProvider

struct BabyBearEnvelope { header: u32, value: BabyBear, footer: bool }
impl core::marker::Copy for BabyBearEnvelope {}
derive CanonicalWords for BabyBearEnvelope using CanonicalWordsProvider

struct SignedEnvelope { negative: i32, positive: i32 }
impl core::marker::Copy for SignedEnvelope {}
derive CanonicalWords for SignedEnvelope using CanonicalWordsProvider

struct DerivedRow { values: [Fr; DERIVED_FIELD_COUNT] }
impl core::marker::Copy for DerivedRow {}
derive CanonicalWords for DerivedRow using CanonicalWordsProvider

struct DerivedQuartet { rows: [DerivedRow; 4] }
impl core::marker::Copy for DerivedQuartet {}
derive CanonicalWords for DerivedQuartet using CanonicalWordsProvider

struct LargeSnapshot { valid: bool, values: [u32; 1001] }
impl core::marker::Copy for LargeSnapshot {}
derive CanonicalWords for LargeSnapshot using CanonicalWordsProvider

struct LargeBabyBearEnvelope {
    header: u32,
    values: [u32; 1001],
    field: BabyBear,
    footer: bool,
}
impl core::marker::Copy for LargeBabyBearEnvelope {}
derive CanonicalWords for LargeBabyBearEnvelope using CanonicalWordsProvider

struct SnapshotEnvelope { snapshot: LargeSnapshot }
impl core::marker::Copy for SnapshotEnvelope {}
derive CanonicalWords for SnapshotEnvelope using CanonicalWordsProvider

const EMPTY_LARGE_SNAPSHOT: LargeSnapshot = LargeSnapshot {
    valid: false,
    values: [0; 1001],
}

const EMPTY_LARGE_BABY_BEAR_ENVELOPE: LargeBabyBearEnvelope = LargeBabyBearEnvelope {
    header: 0,
    values: [0; 1001],
    field: BabyBear::zero(),
    footer: false,
}

fn write_snapshot_first(
    _ output: mut LargeSnapshot,
    _ valid: bool,
    _ value: u32,
) {
    output.valid = valid
    output.values[0] = value
}

struct CountedWords4 { count: u32, values: [u32; 4] }
impl core::marker::Copy for CountedWords4 {}
impl CanonicalWordStream for CountedWords4 {
    fn word_count(ref self) -> u32 {
        <u32 as CanonicalWords>::WORDS
            + canonical_prefix_word_count(ref self.values, self.count)
    }

    fn encode_stream<W: WordSink>(ref self, _ writer: W) -> W {
        let writer = self.count.encode_stream(writer)
        encode_canonical_prefix(ref self.values, self.count, writer)
    }

    fn decode_stream<R: WordSource>(mut self, _ reader: R) -> R {
        let reader = self.count.decode_stream(reader)
        decode_canonical_prefix(mut self.values, self.count, reader)
    }
}

struct StreamEnvelope { header: u32, body: CountedWords4, footer: bool }
impl core::marker::Copy for StreamEnvelope {}
derive CanonicalWordStream for StreamEnvelope using CanonicalWordStreamProvider

const EMPTY_STREAM_ENVELOPE: StreamEnvelope = StreamEnvelope {
    header: 0,
    body: CountedWords4 { count: 0, values: [0; 4] },
    footer: false,
}

pub fn canonical_field_word_count() -> u32 { <Fr as CanonicalWords>::WORDS }

/// Exercise the one-word field decoder through its ordinary mutable receiver.
/// This is the compact form used by production BabyBear receipt decoding.
pub fn canonical_baby_bear_decode(_ value: u32) -> (u32, u32) {
    let encoded = BrowserWordWriter::allocate(1).write(value).finish()
    let mut decoded = BabyBear::zero()
    let reader = decoded.decode(BrowserWordReader::new(encoded))
    (
        if reader.complete() { 1 } else { 0 },
        decoded.to_u32(),
    )
}

/// Match the production receipt path where the reflection-derived codec
/// projects a mutable field before invoking `WordField::decode`.
pub fn canonical_nested_baby_bear_decode(_ value: u32) -> (u32, u32, u32, u32) {
    let encoded = BrowserWordWriter::allocate(3)
        .write(17)
        .write(value)
        .write(1)
        .finish()
    let mut decoded = BabyBearEnvelope {
        header: 0,
        value: BabyBear::zero(),
        footer: false,
    }
    let reader = decoded.decode(BrowserWordReader::new(encoded))
    (
        if reader.complete() { 1 } else { 0 },
        decoded.header,
        decoded.value.to_u32(),
        if decoded.footer { 1 } else { 0 },
    )
}

pub fn canonical_field_one() -> BrowserBytes {
    let value = Fr::from_u32(1)
    encode_canonical_words(
        ref value,
        BrowserWordWriter::allocate(<Fr as CanonicalWords>::WORDS),
    ).finish()
}

pub fn canonical_envelope_word_count() -> u32 { <Envelope as CanonicalWords>::WORDS }

pub fn canonical_envelope() -> BrowserBytes {
    let value = Envelope {
        valid: true,
        fields: FieldArray { values: [Fr::from_u32(1), Fr::from_u32(2)] },
    }
    encode_canonical_words(
        ref value,
        BrowserWordWriter::allocate(<Envelope as CanonicalWords>::WORDS),
    ).finish()
}

pub fn canonical_envelope_roundtrip() -> u32 {
    let encoded = canonical_envelope()
    let mut decoded = Envelope {
        valid: false,
        fields: FieldArray { values: [Fr::zero(), Fr::zero()] },
    }
    let reader = decoded.decode(BrowserWordReader::new(encoded))
    let first = decoded.fields.values[0].to_plain_words()
    let second = decoded.fields.values[1].to_plain_words()
    if reader.complete()
        && decoded.valid
        && first[0] == 1
        && second[0] == 2
    {
        1
    } else {
        0
    }
}

pub fn canonical_envelope_word_array() -> BrowserBytes {
    let value = Envelope {
        valid: true,
        fields: FieldArray { values: [Fr::from_u32(1), Fr::from_u32(2)] },
    }
    let encoded = encode_canonical_word_array<Envelope, 41>(ref value)
    if !encoded.valid { return BrowserBytes { ptr: 0, len: 0 } }
    encode_canonical_words(
        ref encoded.words,
        BrowserWordWriter::allocate(41),
    ).finish()
}

pub fn canonical_envelope_word_array_widths() -> [u32; 3] {
    let value = Envelope {
        valid: true,
        fields: FieldArray { values: [Fr::from_u32(1), Fr::from_u32(2)] },
    }
    let narrow = encode_canonical_word_array<Envelope, 40>(ref value)
    let exact = encode_canonical_word_array<Envelope, 41>(ref value)
    let wide = encode_canonical_word_array<Envelope, 42>(ref value)
    [
        if narrow.valid { 1 } else { 0 },
        if exact.valid { 1 } else { 0 },
        if wide.valid { 1 } else { 0 },
    ]
}

pub fn canonical_signed_envelope(_ negative: i32, _ positive: i32) -> BrowserBytes {
    let value = SignedEnvelope { negative: negative, positive: positive }
    encode_canonical_words(
        ref value,
        BrowserWordWriter::allocate(<SignedEnvelope as CanonicalWords>::WORDS),
    ).finish()
}

pub fn canonical_signed_envelope_roundtrip(_ negative: i32, _ positive: i32) -> u32 {
    let encoded = canonical_signed_envelope(negative, positive)
    let mut decoded = SignedEnvelope { negative: 0, positive: 0 }
    let reader = decoded.decode(BrowserWordReader::new(encoded))
    if reader.complete() && decoded.negative == negative && decoded.positive == positive {
        1
    } else {
        0
    }
}

pub fn canonical_field_array16() -> BrowserBytes {
    let value = FieldArray { values: [Fr::from_u32(3); 16] }
    encode_canonical_words(
        ref value,
        BrowserWordWriter::allocate(<FieldArray<16> as CanonicalWords>::WORDS),
    ).finish()
}

pub fn canonical_empty_field_array() -> BrowserBytes {
    let value = FieldArray { values: [Fr::zero(); 0] }
    encode_canonical_words(
        ref value,
        BrowserWordWriter::allocate(<FieldArray<0> as CanonicalWords>::WORDS),
    ).finish()
}

pub fn canonical_derived_field_array() -> BrowserBytes {
    let value = FieldArray { values: [Fr::from_u32(5); DERIVED_FIELD_COUNT] }
    encode_canonical_words(
        ref value,
        BrowserWordWriter::allocate(
            <FieldArray<DERIVED_FIELD_COUNT> as CanonicalWords>::WORDS,
        ),
    ).finish()
}

pub fn canonical_derived_quartet() -> BrowserBytes {
    let value = DerivedQuartet {
        rows: [DerivedRow { values: [Fr::from_u32(7); DERIVED_FIELD_COUNT] }; 4],
    }
    encode_canonical_words(
        ref value,
        BrowserWordWriter::allocate(
            <DerivedQuartet as CanonicalWords>::WORDS,
        ),
    ).finish()
}

pub fn canonical_embedded_snapshot() -> BrowserBytes {
    let mut output = EMPTY_LARGE_SNAPSHOT
    write_snapshot_first(mut output, true, 7)
    let snapshot = output
    write_snapshot_first(mut output, false, 11)
    let value = SnapshotEnvelope { snapshot: snapshot }
    encode_canonical_words(
        ref value,
        BrowserWordWriter::allocate(<SnapshotEnvelope as CanonicalWords>::WORDS),
    ).finish()
}

pub fn canonical_large_baby_bear_roundtrip(_ value: u32) -> (u32, u32) {
    if value >= 2013265921 { return (0, 0) }
    let original = LargeBabyBearEnvelope {
        header: 17,
        values: [23; 1001],
        field: BabyBear::from_u32(value),
        footer: true,
    }
    let encoded = encode_canonical_words(
        ref original,
        BrowserWordWriter::allocate(<LargeBabyBearEnvelope as CanonicalWords>::WORDS),
    ).finish()
    let mut decoded = EMPTY_LARGE_BABY_BEAR_ENVELOPE
    let reader = decoded.decode(BrowserWordReader::new(encoded))
    if reader.complete()
        && decoded.header == 17
        && decoded.values[0] == 23
        && decoded.values[1000] == 23
        && decoded.footer
    {
        (1, decoded.field.to_u32())
    } else {
        (0, 0)
    }
}

pub fn canonical_stream_envelope(_ count: u32) -> BrowserBytes {
    let value = StreamEnvelope {
        header: 7,
        body: CountedWords4 { count: count, values: [11, 22, 33, 44] },
        footer: true,
    }
    encode_canonical_word_stream(
        ref value,
        BrowserWordWriter::growing(),
    ).finish_prefix()
}

pub fn canonical_growing_words(_ count: u32) -> BrowserBytes {
    if count > 257 { return BrowserBytes { ptr: 0, len: 0 } }
    let mut writer = BrowserWordWriter::growing()
    let mut index: u32 = 0
    while index < count {
        writer = writer.write(index + 17)
        index = index + 1
    }
    writer.finish_prefix()
}

pub fn canonical_oversized_writer_rejects() -> u32 {
    let encoded = BrowserWordWriter::allocate(1073741824).finish_prefix()
    if encoded.len == 0 { 1 } else { 0 }
}

pub fn canonical_stream_envelope_roundtrip(_ count: u32) -> u32 {
    let encoded = canonical_stream_envelope(count)
    if encoded.len == 0 { return 0 }
    let mut decoded = EMPTY_STREAM_ENVELOPE
    let reader = decoded.decode_stream(BrowserWordReader::new(encoded))
    if !reader.complete()
        || decoded.header != 7
        || !decoded.footer
        || decoded.body.count != count
    {
        return 0
    }
    let mut index: usize = 0
    while index < count as usize {
        let ordinal: u32 = index.downcast_truncate()
        if decoded.body.values[index] != (ordinal + 1) * 11 {
            return 0
        }
        index = index + 1
    }
    1
}
