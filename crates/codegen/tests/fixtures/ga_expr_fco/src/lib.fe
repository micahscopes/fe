//! Executable first slice of the typed GA expression compiler.
//!
//! The semantic expression is `(a ^ b) + (a ^ b)` over PGA(2,0,1) lines.
//! Its support is inferred compositionally from the expression type. A closed
//! CTFE type plan then represents the six normalized nonzero bilinear terms;
//! the FCO provider consumes that type witness and emits three branch-free
//! scalar lanes. There is no runtime plan, blade scan, or dynamic dispatch.
//!
//! This fixture deliberately selects `AlgebraicBalanced`: the planner combines
//! repeated coefficients before emission. That is algebraically correct, but
//! it may differ in last-bit f32 rounding from strict evaluation of the source
//! tree. The Rust gate tests both the declared emitted association and its
//! mathematical relationship to a dense semantic oracle.

use core::derive::{Derive, Evidence, ImplBuilder, Reflect}
use core::marker::Copy
use core::num::IntDowncast
use ga_expr::{
    AlgebraicBalanced, BilinearTerm, GaProgram, GaSupport, Input, Outer, Sum,
    TermAdd, TermZero, DiagonalMetric,
}

extern { fn __i32_from_f32(_: f32) -> i32 }

type Pga2 = DiagonalMetric<3, 6>
type LineA = Input<0, 22>
type LineB = Input<1, 22>
type TwiceWedgeExpr = Sum<Outer<LineA, LineB>, Outer<LineA, LineB>>
type TwiceWedgeProgram = GaProgram<TwiceWedgeExpr, Pga2, AlgebraicBalanced>

// The inferred output is exactly {e01,e02,e12}; neither scalar nor grade-1
// lanes survive support analysis.
static_assert(<TwiceWedgeExpr as GaSupport<Pga2>>::SUPPORT == 104)

const INPUT_WIDTH: usize = 3
const CANDIDATES: usize = INPUT_WIDTH * INPUT_WIDTH
const TERM_COUNT: usize = 6

const fn left_slot(_ candidate: usize) -> usize { candidate / INPUT_WIDTH }
const fn right_slot(_ candidate: usize) -> usize { candidate % INPUT_WIDTH }
const fn pairing(_ candidate: usize) -> usize {
    if left_slot(candidate) == right_slot(candidate) {
        0
    } else if left_slot(candidate) < right_slot(candidate) {
        1
    } else {
        2
    }
}
const fn survives(_ candidate: usize) -> bool { pairing(candidate) != 0 }
const fn output_blade(_ candidate: usize) -> usize {
    (1 << left_slot(candidate)) | (1 << right_slot(candidate))
}
const fn output_lane(_ blade: usize) -> usize {
    if blade == 3 { 0 } else if blade == 5 { 1 } else { 2 }
}

/// Find the `remaining`th survivor in ascending candidate order. This bounded
/// scan runs only during CTFE; the emitted shader never contains it.
const fn candidate_at_remaining(_ remaining: usize) -> usize {
    let target: usize = TERM_COUNT - remaining
    let mut candidate: usize = 0
    let mut seen: usize = 0
    while candidate < CANDIDATES {
        if survives(candidate) {
            if seen == target { return candidate }
            seen = seen + 1
        }
        candidate = candidate + 1
    }
    CANDIDATES
}

// One direct const call per staged type payload keeps recursive type
// normalization within FCO's intentionally small, auditable grammar.
const fn term_left(_ remaining: usize) -> usize {
    left_slot(candidate_at_remaining(remaining))
}
const fn term_right(_ remaining: usize) -> usize {
    INPUT_WIDTH + right_slot(candidate_at_remaining(remaining))
}
const fn term_blade(_ remaining: usize) -> usize {
    output_blade(candidate_at_remaining(remaining))
}
const fn term_negative(_ remaining: usize) -> usize {
    if pairing(candidate_at_remaining(remaining)) == 2 { 1 } else { 0 }
}

/// Closed recursive type computation. The expression's two identical outer
/// products have already been combined into exact integer magnitude 2; the
/// three diagonal-zero candidates never appear in the witness.
recursive type fn AlgebraicTwiceWedgePlan<const N: usize>() -> (*) {
    match N {
        0 => TermZero
        _ => TermAdd<
            BilinearTerm<
                {term_left(N)},
                {term_right(N)},
                {term_blade(N)},
                2,
                {term_negative(N)},
            >,
            AlgebraicTwiceWedgePlan<{N - 1}>,
        >
    }
}

type AlgebraicTwiceWedgePlan6 = AlgebraicTwiceWedgePlan<TERM_COUNT>
type ExpectedPlan = TermAdd<
    BilinearTerm<0, 4, 3, 2, 0>,
    TermAdd<
        BilinearTerm<0, 5, 5, 2, 0>,
        TermAdd<
            BilinearTerm<1, 3, 3, 2, 1>,
            TermAdd<
                BilinearTerm<1, 5, 6, 2, 0>,
                TermAdd<
                    BilinearTerm<2, 3, 5, 2, 1>,
                    TermAdd<BilinearTerm<2, 4, 6, 2, 1>, TermZero>,
                >,
            >,
        >,
    >,
>

// A type-equality gate: an incorrect candidate, sign, output blade, order, or
// coefficient makes the fixture fail before code generation.
fn exact_ctfe_plan(_ value: AlgebraicTwiceWedgePlan6) -> ExpectedPlan { value }

pub struct WedgeOperands {
    pub l0: f32, pub l1: f32, pub l2: f32,
    pub r0: f32, pub r1: f32, pub r2: f32,
}
impl Copy for WedgeOperands {}

pub trait EvaluateAlgebraicTwiceWedge {
    fn c0(_ operands: WedgeOperands) -> f32
    fn c1(_ operands: WedgeOperands) -> f32
    fn c2(_ operands: WedgeOperands) -> f32
}

struct AlgebraicTwiceWedgeProvider {}
impl Derive<EvaluateAlgebraicTwiceWedge> for AlgebraicTwiceWedgeProvider {
    const fn derive<T>(ev: own Evidence<EvaluateAlgebraicTwiceWedge<T>>)
        -> Evidence<EvaluateAlgebraicTwiceWedge<T>>
        uses (
            reflect: Reflect<T>,
            builder: mut ImplBuilder<EvaluateAlgebraicTwiceWedge<T>>,
        )
    {
        let operands = builder.arg_ref("operands")
        let acc0 = operands
        let acc1 = operands
        let acc2 = operands
        let count0 = 0
        let count1 = 0
        let count2 = 0

        for nested in builder.ty<AlgebraicTwiceWedgePlan6>().normalized_preorder_types() {
            if builder.same_ty(nested.constructor(), builder.ty<BilinearTerm>()) {
                let ordinal: usize = 0
                let left: usize = 0
                let right: usize = 0
                let blade: usize = 0
                let magnitude: usize = 0
                let negative: usize = 0
                for arg in nested.generic_args() {
                    if arg.is_const() {
                        if ordinal == 0 { left = arg.const_value() }
                        if ordinal == 1 { right = arg.const_value() }
                        if ordinal == 2 { blade = arg.const_value() }
                        if ordinal == 3 { magnitude = arg.const_value() }
                        if ordinal == 4 { negative = arg.const_value() }
                        ordinal = ordinal + 1
                    }
                }

                let lhs = operands
                let rhs = operands
                let index: usize = 0
                for field in reflect.fields() {
                    if index == left { lhs = builder.field_get(operands, field) }
                    if index == right { rhs = builder.field_get(operands, field) }
                    index = index + 1
                }

                // `share` is explicit today. The arbitrary-expression planner
                // will hash-cons pure product nodes before this emission phase.
                let product = builder.share(builder.mul(lhs, rhs))
                let term = product
                if magnitude == 2 { term = builder.add(product, product) }
                if negative == 1 { term = builder.neg(term) }

                let lane = output_lane(blade)
                if lane == 0 {
                    if count0 == 0 { acc0 = term } else { acc0 = builder.add(acc0, term) }
                    count0 = count0 + 1
                }
                if lane == 1 {
                    if count1 == 0 { acc1 = term } else { acc1 = builder.add(acc1, term) }
                    count1 = count1 + 1
                }
                if lane == 2 {
                    if count2 == 0 { acc2 = term } else { acc2 = builder.add(acc2, term) }
                    count2 = count2 + 1
                }
            }
        }

        builder.emit_method("c0", acc0)
        builder.emit_method("c1", acc1)
        builder.emit_method("c2", acc2)
        builder.finish()
        ev
    }
}

derive EvaluateAlgebraicTwiceWedge for WedgeOperands using AlgebraicTwiceWedgeProvider

fn operands(
    _ l0: f32, _ l1: f32, _ l2: f32,
    _ r0: f32, _ r1: f32, _ r2: f32,
) -> WedgeOperands {
    WedgeOperands { l0: l0, l1: l1, l2: l2, r0: r0, r1: r1, r2: r2 }
}

pub fn twice_wedge_c0(
    _ l0: f32, _ l1: f32, _ l2: f32,
    _ r0: f32, _ r1: f32, _ r2: f32,
) -> f32 {
    <WedgeOperands as EvaluateAlgebraicTwiceWedge>::c0(
        operands(l0, l1, l2, r0, r1, r2),
    )
}

pub fn twice_wedge_c1(
    _ l0: f32, _ l1: f32, _ l2: f32,
    _ r0: f32, _ r1: f32, _ r2: f32,
) -> f32 {
    <WedgeOperands as EvaluateAlgebraicTwiceWedge>::c1(
        operands(l0, l1, l2, r0, r1, r2),
    )
}

pub fn twice_wedge_c2(
    _ l0: f32, _ l1: f32, _ l2: f32,
    _ r0: f32, _ r1: f32, _ r2: f32,
) -> f32 {
    <WedgeOperands as EvaluateAlgebraicTwiceWedge>::c2(
        operands(l0, l1, l2, r0, r1, r2),
    )
}

/// Shader-shaped consumer used to prove the same generated implementation
/// lowers through the render/SPIR-V path. `px` and `py` are intentionally part
/// of the authored entry ABI even though this arithmetic probe is uniform.
pub fn twice_wedge_render(
    _ px: i32, _ py: i32,
    _ l0: f32, _ l1: f32, _ l2: f32,
    _ r0: f32, _ r1: f32, _ r2: f32,
) -> u32 {
    let v = twice_wedge_c0(l0, l1, l2, r0, r1, r2)
        + twice_wedge_c1(l0, l1, l2, r0, r1, r2)
        + twice_wedge_c2(l0, l1, l2, r0, r1, r2)
    __i32_from_f32(v.abs() * 256.0).downcast_truncate()
}
