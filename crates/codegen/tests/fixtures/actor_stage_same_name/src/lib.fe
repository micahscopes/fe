use std::webgpu::{StorageBuffer, GpuProgram, WebGpuBackend, ComputeSurface, Workgroup, FixedDispatch}

use ingot::helpers

actor SameName uses (GpuProgram<WebGpuBackend>) {
    output: StorageBuffer<u32, 1>,
    fn initialize(self) uses (ComputeSurface<Workgroup<1, 1, 1>, FixedDispatch<1, 1, 1>>) {
        helpers::initialize(self.output)
    }
}
