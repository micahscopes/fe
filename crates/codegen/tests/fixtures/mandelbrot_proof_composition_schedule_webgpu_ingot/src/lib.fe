    }

    fn linear_plan_second(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<GROUPS, 1, 1>>)
    {
        write_sparse_linear_plan_composition_lane<
            SparseLinearPlanSecondComposition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            LDE_LENGTH,
            WORKSPACE_WORDS,
