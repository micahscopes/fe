    {
        write_sparse_product_composition_lane<
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            LDE_LENGTH,
            WORKSPACE_WORDS,
            BASE_WORDS,
            INTERACTION_WORDS,
            OUTPUT_WORDS,
        >(
            BabyBear::from_u32(7),
            self.workspace,
            self.base,
            self.interaction,
            self.output,
            invocation,
        )
    }

    fn round_plan_first(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<GROUPS, 1, 1>>)
    {
        write_sparse_round_plan_composition_lane<
            SparseRoundPlanFirstComposition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            LDE_LENGTH,
            WORKSPACE_WORDS,
            BASE_WORDS,
            OUTPUT_WORDS,
        >(
            BabyBear::from_u32(7),
            self.workspace,
            self.base,
            self.output,
            invocation,
        )
    }

    fn round_plan_second(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<GROUPS, 1, 1>>)
    {
        write_sparse_round_plan_composition_lane<
            SparseRoundPlanSecondComposition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            LDE_LENGTH,
            WORKSPACE_WORDS,
            BASE_WORDS,
            OUTPUT_WORDS,
        >(
            BabyBear::from_u32(7),
            self.workspace,
            self.base,
            self.output,
            invocation,
        )
    }

    fn round_ports(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<GROUPS, 1, 1>>)
    {
        write_sparse_round_interaction_composition_lane<
            SparseRoundPortsComposition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            LDE_LENGTH,
            WORKSPACE_WORDS,
            BASE_WORDS,
            INTERACTION_WORDS,
            OUTPUT_WORDS,
        >(
            BabyBear::from_u32(7),
            self.workspace,
            self.base,
            self.interaction,
            self.output,
