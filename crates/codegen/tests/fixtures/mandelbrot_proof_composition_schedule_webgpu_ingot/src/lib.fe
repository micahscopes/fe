    fn linear_plan_third(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Grid<GROUPS, 1, 1>>)
    {
        write_sparse_linear_plan_composition_lane<
            SparseLinearPlanThirdComposition,
            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            LDE_LENGTH,
            WORKSPACE_WORDS,
            BASE_WORDS,
            OUTPUT_WORDS,
        >(
            BabyBear::from_u32(7),
            self.workspace,
