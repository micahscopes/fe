            PRODUCTION_LIMBS,
            PRODUCTION_TRACE_LENGTH,
            LDE_LENGTH,
            WORKSPACE_WORDS,
            BASE_WORDS,
            INTERACTION_WORDS,
            OUTPUT_WORDS,
        >(
            BabyBear::from_u32(7),
            self.workspace,
            self.base,
            self.interaction,
