// Reproduction fixture (reference side): the hand-written flattened kernel that
// the `Painter` actor's `paint` behavior must reproduce byte-for-byte in the
// sibling `actor_repro_actor` ingot. Context parameters (`px`, `py`) come first,
// then the actor's state fields (`a`, `b`, `c`) in declaration order.

pub fn paint(px: i32, py: i32, a: i32, b: i32, c: i32) -> i32 {
    let base: i32 = px + py + a
    if b < c {
        base + b
    } else {
        base - c
    }
}
