//! Executable boundary for the production sparse BabyBear prover.
//!
//! The fixture constructs its witness by evaluating the exact Fe recurrence.
//! No host-authored trace, commitment, challenge, or receipt enters this gate.

use core::BrowserBytes
use mandelbrot_proof_baby_bear::{
    composition_multi_opening_power_of_two,
}
use mandelbrot_proof_fixed_air_prover_baby_bear::{
    production_zero_base_lde_checkpoint,
    prove_production_sparse_interval,
}
use mandelbrot_proof_fixed_air_receipt_baby_bear::{
    PRODUCTION_COMPOSITION_MAX_LEAVES,
    PRODUCTION_COMPOSITION_MAX_SIBLINGS,
    PRODUCTION_LDE_LENGTH,
    decode_production_sparse_baby_bear_receipt,
    empty_production_sparse_baby_bear_receipt,
    verify_production_sparse_baby_bear_receipt,
}
use mandelbrot_proof_recursive::{
    ComplexFixed,
    HighPrecisionEscapeClaim,
    OrbitInterval,
    evaluate_chunk,
    initial_boundary,
}
use mandelbrot_proof_recursive_verifier_baby_bear::{
    verify_production_sparse_recursive_leaf,
}
use precision::baby_bear::{BabyBear, BabyBearExt4}
use precision::fixed::Fixed

fn production_zero_interval() -> OrbitInterval<4> {
    let claim: HighPrecisionEscapeClaim<4> = HighPrecisionEscapeClaim {
        point: ComplexFixed {
            real: Fixed::zero(),
            imaginary: Fixed::zero(),
        },
        bound: 8,
    }
    let evaluated = evaluate_chunk(claim, initial_boundary<4>(), 1)
    if !evaluated.valid || evaluated.leaves != 1 {
        return OrbitInterval {
            claim: claim,
            start: initial_boundary<4>(),
            end: initial_boundary<4>(),
        }
    }
    evaluated.interval
}

/// Prove the single exact transition `z_0 = 0` to `z_1 = 0` for `c = 0`.
/// The nonzero shift is the same independently exercised coset representative
/// used by the BabyBear LDE and sparse-authentication gates.
pub fn production_zero_interval_receipt() -> BrowserBytes {
    prove_production_sparse_interval(
        production_zero_interval(),
        BabyBear::from_u32(7),
    )
}

pub fn production_base_lde_checkpoint() -> bool {
    production_zero_base_lde_checkpoint()
}

/// Isolate the production-size composition Merkle opening. In particular this
/// exercises the compiler-derived compact schedule for the repeated digest
/// leaf array without pulling the complete prover into a focused regression.
pub fn production_composition_opening_checkpoint() -> bool {
    let evaluations = [BabyBearExt4::zero(); PRODUCTION_LDE_LENGTH]
    let requested: [u32; PRODUCTION_COMPOSITION_MAX_LEAVES] = [0, 1, 2, 3, 4, 5, 6, 7]
    composition_multi_opening_power_of_two<
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_COMPOSITION_MAX_LEAVES},
        {PRODUCTION_COMPOSITION_MAX_LEAVES},
        {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
    >(evaluations, requested).valid
}

/// Verify browser-owned canonical bytes without reusing prover residency.
pub fn verify_production_zero_interval_receipt(_ bytes: BrowserBytes) -> bool {
    let mut receipt = empty_production_sparse_baby_bear_receipt()
    if !decode_production_sparse_baby_bear_receipt(bytes, mut receipt) {
        return false
    }
    verify_production_sparse_baby_bear_receipt(
        production_zero_interval(),
        BabyBear::from_u32(7),
        ref receipt,
    )
}

/// Admit the same canonical receipt through the recursive authority boundary.
/// The returned carrier must remain the exact one-step interval committed by
/// the production verifier, not a host-provided validity bit.
pub fn verify_production_zero_interval_recursive_leaf(
    _ bytes: BrowserBytes,
) -> bool {
    let mut receipt = empty_production_sparse_baby_bear_receipt()
    if !decode_production_sparse_baby_bear_receipt(bytes, mut receipt) {
        return false
    }
    let leaf = verify_production_sparse_recursive_leaf(
        production_zero_interval(),
        BabyBear::from_u32(7),
        ref receipt,
    )
    let committed = leaf.commitment()
    leaf.is_valid()
        && committed.valid
        && committed.leaves == 1
        && committed.start_iteration == 0
        && committed.end_iteration == 1
        && committed.statement.valid
        && committed.start.valid
        && committed.end.valid
}

/// Test-only diagnostic projection for the recursive authority boundary. Zero
/// means the public boolean verifier accepted. Nonzero values identify the
/// first independently replayed boundary that failed after that rejection.
pub fn audit_production_zero_interval_recursive_leaf(
    _ bytes: BrowserBytes,
) -> u32 {
    if verify_production_zero_interval_recursive_leaf(bytes) { return 0 }

    let mut receipt = empty_production_sparse_baby_bear_receipt()
    if !decode_production_sparse_baby_bear_receipt(bytes, mut receipt) {
        return 1
    }
    if !verify_production_sparse_baby_bear_receipt(
        production_zero_interval(),
        BabyBear::from_u32(7),
        ref receipt,
    ) {
        return 2
    }
    let leaf = verify_production_sparse_recursive_leaf(
        production_zero_interval(),
        BabyBear::from_u32(7),
        ref receipt,
    )
    if !leaf.is_valid() { return 3 }
    let committed = leaf.commitment()
    if !committed.valid { return 4 }
    if committed.leaves != 1 { return 5 }
    if committed.start_iteration != 0 { return 6 }
    if committed.end_iteration != 1 { return 7 }
    if !committed.statement.valid { return 8 }
    if !committed.start.valid { return 9 }
    if !committed.end.valid { return 10 }
    11
}
