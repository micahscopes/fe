//! Executable boundary for the production sparse BabyBear prover.
//!
//! The fixture constructs its witness by evaluating the exact Fe recurrence.
//! No host-authored trace, commitment, challenge, or receipt enters this gate.

use core::{BrowserBytes, BrowserPtr, alloc_browser_object}
use mandelbrot_proof_baby_bear::{
    CompositionMultiOpening,
    FriMultiQueryEnd,
    FriMultiQueryFold,
    empty_composition_multi_opening,
    write_composition_multi_opening_power_of_two,
}
use mandelbrot_proof_fixed_air_prover_baby_bear::{
    production_zero_base_lde_checkpoint,
    prove_production_sparse_interval,
}
use mandelbrot_proof_fixed_air_receipt_baby_bear::{
    PRODUCTION_LDE_LENGTH,
    PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES,
    PRODUCTION_SECURITY_COMPOSITION_MAX_SIBLINGS,
    decode_production_sparse_baby_bear_receipt,
    empty_production_sparse_baby_bear_receipt,
    verify_production_sparse_baby_bear_receipt,
}
use mandelbrot_proof_recursive::{
    ComplexFixed,
    HighPrecisionEscapeClaim,
    OrbitInterval,
    evaluate_chunk,
    initial_boundary,
}
use mandelbrot_proof_recursive_verifier_baby_bear::{
    merge_verified_recursive_intervals,
    verify_production_sparse_recursive_leaf,
}
use poseidon_baby_bear::{DIGEST_FIELDS, Poseidon2Digest}
use precision::baby_bear::{BabyBear, BabyBearExt4}
use precision::fixed::Fixed

/// Test-only structural interpreter for the schedule-derived FRI carrier.
/// The mutation follows the recursive carrier type to its terminal evaluation,
/// so this gate does not repeat the production schedule depth or field path.
trait MutateFriTerminal {
    fn mutate_fri_terminal(mut self)
}

impl<const ROUND: u32> MutateFriTerminal for FriMultiQueryEnd<ROUND> {
    fn mutate_fri_terminal(mut self) {
        self.evaluation = self.evaluation + BabyBearExt4::one()
    }
}

impl<
    const ROUND: u32,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
    Tail: core::marker::Copy + MutateFriTerminal,
> MutateFriTerminal for FriMultiQueryFold<
    ROUND,
    MAX_LEAVES,
    MAX_SIBLINGS,
    Tail,
> {
    fn mutate_fri_terminal(mut self) {
        self.tail.mutate_fri_terminal()
    }
}

fn mutate_digest(_ digest: Poseidon2Digest) -> Poseidon2Digest {
    let mut words = [0; DIGEST_FIELDS]
    let mut index: u32 = 0
    while index < DIGEST_FIELDS.downcast_truncate() {
        words[index as usize] = digest.field(index).to_u32()
        index = index + 1
    }
    words[0] = (digest.field(0) + BabyBear::one()).to_u32()
    Poseidon2Digest::from_u32s(words)
}

fn production_zero_claim() -> HighPrecisionEscapeClaim<4> {
    HighPrecisionEscapeClaim {
        point: ComplexFixed {
            real: Fixed::zero(),
            imaginary: Fixed::zero(),
        },
        bound: 8,
    }
}

fn invalid_production_zero_interval(
    _ claim: HighPrecisionEscapeClaim<4>,
) -> OrbitInterval<4> {
    OrbitInterval {
        claim: claim,
        start: initial_boundary<4>(),
        end: initial_boundary<4>(),
    }
}

fn production_zero_interval_at(_ leaf: u32) -> OrbitInterval<4> {
    let claim = production_zero_claim()
    let initial = initial_boundary<4>()
    if leaf == 0 {
        let evaluated = evaluate_chunk(claim, initial, 1)
        if evaluated.valid && evaluated.leaves == 1 {
            return evaluated.interval
        }
        return invalid_production_zero_interval(claim)
    }
    if leaf != 1 { return invalid_production_zero_interval(claim) }

    let first = evaluate_chunk(claim, initial, 1)
    if !first.valid || first.leaves != 1 {
        return invalid_production_zero_interval(claim)
    }
    let second = evaluate_chunk(claim, first.interval.end, 1)
    if !second.valid || second.leaves != 1 {
        return invalid_production_zero_interval(claim)
    }
    second.interval
}

fn production_zero_interval() -> OrbitInterval<4> {
    production_zero_interval_at(0)
}

fn production_zero_second_interval() -> OrbitInterval<4> {
    production_zero_interval_at(1)
}

/// Prove the single exact transition `z_0 = 0` to `z_1 = 0` for `c = 0`.
/// The nonzero shift is the same independently exercised coset representative
/// used by the BabyBear LDE and sparse-authentication gates.
pub fn production_zero_interval_receipt() -> BrowserBytes {
    prove_production_sparse_interval(
        production_zero_interval(),
        BabyBear::from_u32(7),
    )
}

/// Prove either exact adjacent transition for the two-leaf recursive gate.
/// The leaf index selects public statement data; it does not select a second
/// proof implementation or host-provided witness.
pub fn production_zero_adjacent_interval_receipt(
    _ leaf: u32,
) -> BrowserBytes {
    if leaf > 1 { return BrowserBytes { ptr: 0, len: 0 } }
    prove_production_sparse_interval(
        production_zero_interval_at(leaf),
        BabyBear::from_u32(7),
    )
}

pub fn production_base_lde_checkpoint() -> bool {
    production_zero_base_lde_checkpoint()
}

/// Isolate the production-size composition Merkle opening. In particular this
/// exercises the compiler-derived compact schedule for the repeated digest
/// leaf array without pulling the complete prover into a focused regression.
pub fn production_composition_opening_checkpoint() -> bool {
    let evaluations = [BabyBearExt4::zero(); PRODUCTION_LDE_LENGTH]
    let requested: [u32; PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES] = [0; PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES]
    let mut opening = empty_composition_multi_opening<
        {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
        {PRODUCTION_SECURITY_COMPOSITION_MAX_SIBLINGS},
    >()
    write_composition_multi_opening_power_of_two<
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
        {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
        {PRODUCTION_SECURITY_COMPOSITION_MAX_SIBLINGS},
    >(ref evaluations, ref requested, mut opening) && opening.valid
}

struct ProductionCompositionCheckpointEvaluations {
    values: [BabyBearExt4; PRODUCTION_LDE_LENGTH],
}

struct ProductionCompositionCheckpointReceipt {
    opening: CompositionMultiOpening<
        {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
        {PRODUCTION_SECURITY_COMPOSITION_MAX_SIBLINGS},
    >,
}

struct ProductionCompositionCheckpointArtifacts {
    evaluations: BrowserPtr<ProductionCompositionCheckpointEvaluations>,
    receipt: BrowserPtr<ProductionCompositionCheckpointReceipt>,
}

fn allocate_production_composition_checkpoint_artifacts(_ reject: bool)
    -> ProductionCompositionCheckpointArtifacts
{
    let evaluations = alloc_browser_object<
        ProductionCompositionCheckpointEvaluations,
    >()
    let receipt = alloc_browser_object<ProductionCompositionCheckpointReceipt>()
    if reject {
        return ProductionCompositionCheckpointArtifacts {
            evaluations: evaluations,
            receipt: receipt,
        }
    }
    ProductionCompositionCheckpointArtifacts {
        evaluations: evaluations,
        receipt: receipt,
    }
}

fn initialize_production_composition_checkpoint_evaluations()
uses (evaluations: mut ProductionCompositionCheckpointEvaluations)
{
    let mut cursor: usize = 0
    while cursor < PRODUCTION_LDE_LENGTH {
        evaluations.values[cursor] = BabyBearExt4::zero()
        cursor = cursor + 1
    }
}

fn write_production_composition_checkpoint_opening() -> bool
uses (
    evaluations: ProductionCompositionCheckpointEvaluations,
    receipt: mut ProductionCompositionCheckpointReceipt,
)
{
    let requested: [u32; PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES] = [
        0;
        PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES
    ]
    write_composition_multi_opening_power_of_two<
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
        {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
        {PRODUCTION_SECURITY_COMPOSITION_MAX_SIBLINGS},
    >(
        ref evaluations.values,
        ref requested,
        mut receipt.opening,
    ) && receipt.opening.valid
}

/// Reproduce the production prover's pointer-bearing artifact return followed
/// by nested effect-provider reborrows, without compiling unrelated AIR work.
pub fn production_composition_effect_opening_checkpoint() -> bool {
    let artifacts = allocate_production_composition_checkpoint_artifacts(false)
    if artifacts.evaluations.address() == 0 || artifacts.receipt.address() == 0 {
        return false
    }
    with (artifacts.evaluations) {
        initialize_production_composition_checkpoint_evaluations()
    }
    with (artifacts.evaluations, artifacts.receipt) {
        write_production_composition_checkpoint_opening()
    }
}

/// Verify browser-owned canonical bytes without reusing prover residency.
pub fn verify_production_zero_interval_receipt(_ bytes: BrowserBytes) -> bool {
    let mut receipt = empty_production_sparse_baby_bear_receipt()
    if !decode_production_sparse_baby_bear_receipt(bytes, mut receipt) {
        return false
    }
    verify_production_sparse_baby_bear_receipt(
        production_zero_interval(),
        BabyBear::from_u32(7),
        ref receipt,
    )
}

/// Verify one canonical production receipt after a semantic Fe-side mutation.
/// Mutation zero is the clean control. The remaining modes target the root and
/// transcript chain, an authenticated AIR value, its Merkle path, a committed
/// composition value, and the schedule-derived terminal FRI evaluation. The
/// host knows only the mutation selector and never owns a receipt offset.
pub fn verify_production_zero_interval_receipt_mutation(
    _ bytes: BrowserBytes,
    _ mutation: u32,
) -> bool {
    let mut receipt = empty_production_sparse_baby_bear_receipt()
    if !decode_production_sparse_baby_bear_receipt(bytes, mut receipt) {
        return false
    }
    let one = BabyBear::one()
    match mutation {
        0 => {}
        1 => {
            receipt.base_root.value = mutate_digest(receipt.base_root.value)
        }
        2 => {
            if receipt.base.path.leaf_count == 0 { return false }
            receipt.base.values[0][0] = receipt.base.values[0][0] + one
        }
        3 => {
            if receipt.base.path.sibling_count == 0 { return false }
            receipt.base.path.siblings[0]
                = mutate_digest(receipt.base.path.siblings[0])
        }
        4 => {
            if receipt.fri.composition.path.leaf_count == 0 { return false }
            receipt.fri.composition.values[0]
                = receipt.fri.composition.values[0] + BabyBearExt4::one()
        }
        5 => { receipt.fri.layers.mutate_fri_terminal() }
        _ => { return false }
    }
    verify_production_sparse_baby_bear_receipt(
        production_zero_interval(),
        BabyBear::from_u32(7),
        ref receipt,
    )
}

/// Admit the same canonical receipt through the recursive authority boundary.
/// The returned carrier must remain the exact one-step interval committed by
/// the production verifier, not a host-provided validity bit.
pub fn verify_production_zero_interval_recursive_leaf(
    _ bytes: BrowserBytes,
) -> bool {
    let mut receipt = empty_production_sparse_baby_bear_receipt()
    if !decode_production_sparse_baby_bear_receipt(bytes, mut receipt) {
        return false
    }
    let leaf = verify_production_sparse_recursive_leaf(
        production_zero_interval(),
        BabyBear::from_u32(7),
        ref receipt,
    )
    let committed = leaf.commitment()
    leaf.is_valid()
        && committed.valid
        && committed.leaves == 1
        && committed.start_iteration == 0
        && committed.end_iteration == 1
        && committed.statement.valid
        && committed.start.valid
        && committed.end.valid
}

/// Test-only diagnostic projection for the recursive authority boundary. Zero
/// means the public boolean verifier accepted. Nonzero values identify the
/// first independently replayed boundary that failed after that rejection.
pub fn audit_production_zero_interval_recursive_leaf(
    _ bytes: BrowserBytes,
) -> u32 {
    if verify_production_zero_interval_recursive_leaf(bytes) { return 0 }

    let mut receipt = empty_production_sparse_baby_bear_receipt()
    if !decode_production_sparse_baby_bear_receipt(bytes, mut receipt) {
        return 1
    }
    if !verify_production_sparse_baby_bear_receipt(
        production_zero_interval(),
        BabyBear::from_u32(7),
        ref receipt,
    ) {
        return 2
    }
    let leaf = verify_production_sparse_recursive_leaf(
        production_zero_interval(),
        BabyBear::from_u32(7),
        ref receipt,
    )
    if !leaf.is_valid() { return 3 }
    let committed = leaf.commitment()
    if !committed.valid { return 4 }
    if committed.leaves != 1 { return 5 }
    if committed.start_iteration != 0 { return 6 }
    if committed.end_iteration != 1 { return 7 }
    if !committed.statement.valid { return 8 }
    if !committed.start.valid { return 9 }
    if !committed.end.valid { return 10 }
    11
}

/// Complete assembled-receipt mutation matrix. Each mutation is expressed in
/// Fe against the typed carrier after canonical decoding. Zero is the only
/// success result, while nonzero values identify the first acceptance error.
pub fn audit_production_zero_interval_receipt_matrix(
    _ bytes: BrowserBytes,
) -> u32 {
    if !verify_production_zero_interval_recursive_leaf(bytes) { return 1 }
    if !verify_production_zero_interval_receipt_mutation(bytes, 0) { return 2 }
    if verify_production_zero_interval_receipt_mutation(bytes, 1) { return 3 }
    if verify_production_zero_interval_receipt_mutation(bytes, 2) { return 4 }
    if verify_production_zero_interval_receipt_mutation(bytes, 3) { return 5 }
    if verify_production_zero_interval_receipt_mutation(bytes, 4) { return 6 }
    if verify_production_zero_interval_receipt_mutation(bytes, 5) { return 7 }
    0
}

/// Decode and verify two real adjacent production receipts before minting and
/// merging their private recursive authorities.
pub fn verify_and_merge_production_zero_adjacent_recursive_leaves(
    _ left_bytes: BrowserBytes,
    _ right_bytes: BrowserBytes,
) -> bool {
    let mut left_receipt = empty_production_sparse_baby_bear_receipt()
    let mut right_receipt = empty_production_sparse_baby_bear_receipt()
    if !decode_production_sparse_baby_bear_receipt(left_bytes, mut left_receipt)
        || !decode_production_sparse_baby_bear_receipt(right_bytes, mut right_receipt)
    {
        return false
    }
    let left = verify_production_sparse_recursive_leaf(
        production_zero_interval(),
        BabyBear::from_u32(7),
        ref left_receipt,
    )
    let right = verify_production_sparse_recursive_leaf(
        production_zero_second_interval(),
        BabyBear::from_u32(7),
        ref right_receipt,
    )
    let merged = merge_verified_recursive_intervals(left, right)
    let committed = merged.commitment()
    merged.is_valid()
        && committed.valid
        && committed.leaves == 2
        && committed.start_iteration == 0
        && committed.end_iteration == 2
        && committed.statement.valid
        && committed.start.valid
        && committed.end.valid
}

/// Failure-localizing projection for the exact two-receipt merge gate. Zero is
/// the only success value; all other values identify a rejected boundary.
pub fn audit_production_zero_adjacent_recursive_merge(
    _ left_bytes: BrowserBytes,
    _ right_bytes: BrowserBytes,
) -> u32 {
    if verify_and_merge_production_zero_adjacent_recursive_leaves(
        left_bytes,
        right_bytes,
    ) { return 0 }

    let mut left_receipt = empty_production_sparse_baby_bear_receipt()
    let mut right_receipt = empty_production_sparse_baby_bear_receipt()
    if !decode_production_sparse_baby_bear_receipt(left_bytes, mut left_receipt) {
        return 1
    }
    if !decode_production_sparse_baby_bear_receipt(right_bytes, mut right_receipt) {
        return 2
    }
    let left = verify_production_sparse_recursive_leaf(
        production_zero_interval(),
        BabyBear::from_u32(7),
        ref left_receipt,
    )
    if !left.is_valid() { return 3 }
    let right = verify_production_sparse_recursive_leaf(
        production_zero_second_interval(),
        BabyBear::from_u32(7),
        ref right_receipt,
    )
    if !right.is_valid() { return 4 }
    let merged = merge_verified_recursive_intervals(left, right)
    if !merged.is_valid() { return 5 }
    let committed = merged.commitment()
    if !committed.valid { return 6 }
    if committed.leaves != 2 { return 7 }
    if committed.start_iteration != 0 { return 8 }
    if committed.end_iteration != 2 { return 9 }
    if !committed.statement.valid { return 10 }
    if !committed.start.valid { return 11 }
    if !committed.end.valid { return 12 }
    13
}
