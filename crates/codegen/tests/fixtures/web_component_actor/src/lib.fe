//! First actor-like Fe web component reducer.
//!
//! The alias proves the compiler resolves nominal role identity. Event kinds,
//! target interpretation, lifecycle policy, and all state changes live here;
//! a future fixed custom-element host only transports these facts and applies
//! typed output effects.

use core::actor::{
    ComponentComposition as Composition, InitialState as Initial, ProjectState as Projection,
    ResidentTransition as Stateful,
}
use std::web::component::{
    BrowserBytes, ComponentEvent, ComponentEventKind, ComponentPatch, VisibleParts,
}
use std::web::identity::{
    ComponentAction, ComponentActionProvider, ComponentSchema, ComponentSchemaProvider,
    Part, Visibility,
}
use std::web::page::{ComponentView, PageAttribute, PageElement, PageOp, PageText}

pub enum InspectorAction {
    Unknown,
    Authored,
    Generated,
}

impl Copy for InspectorAction {}

derive ComponentAction for InspectorAction using ComponentActionProvider

struct InspectorView {
    authored: Part<Visibility>,
    generated: Part<Visibility>,
}

derive ComponentSchema for InspectorView using ComponentSchemaProvider

pub struct InspectorState {
    pub selected: InspectorAction,
    pub connected: bool,
    pub revision: u32,
}

actor SourceInspector {
    selected: InspectorAction,
    connected: bool,
    revision: u32,

    const fn view() -> ComponentView<23> uses (Composition) {
        let ui = <InspectorView as ComponentSchema>::component_parts()
        ComponentView::exact(body: [
            PageOp::open(element: PageElement::Button),
            PageOp::attribute(value: PageAttribute::action(value: InspectorAction::Authored)),
            PageOp::text(value: PageText::one(value: "Fe")),
            PageOp::close(),
            PageOp::open(element: PageElement::Button),
            PageOp::attribute(value: PageAttribute::action(value: InspectorAction::Generated)),
            PageOp::text(value: PageText::one(value: "Wasm")),
            PageOp::close(),
            PageOp::open(element: PageElement::Section),
            PageOp::attribute(value: PageAttribute::view(value: ui.authored)),
            PageOp::text(value: PageText::one(value: "authored")),
            PageOp::close(),
            PageOp::open(element: PageElement::Section),
            PageOp::attribute(value: PageAttribute::view(value: ui.generated)),
            PageOp::text(value: PageText::one(value: "generated")),
            PageOp::close(),
            PageOp::open(element: PageElement::Label),
            PageOp::attribute(value: PageAttribute::local_for(value: "choice")),
            PageOp::text(value: PageText::one(value: "Choice")),
            PageOp::close(),
            PageOp::open(element: PageElement::Input),
            PageOp::attribute(value: PageAttribute::local_id(value: "choice")),
            PageOp::close(),
        ])
    }

    const fn initial() -> InspectorState uses (Initial) {
        InspectorState {
            selected: InspectorAction::Authored,
            connected: false,
            revision: 0,
        }
    }

    fn project(self) -> ComponentPatch uses (Projection) {
        let ui = <InspectorView as ComponentSchema>::component_parts()
        let visible = if !self.connected {
            VisibleParts::none()
        } else {
            match self.selected {
                InspectorAction::Unknown => VisibleParts::none()
                InspectorAction::Authored => VisibleParts::none().show(target: ui.authored)
                InspectorAction::Generated => VisibleParts::none().show(target: ui.generated)
            }
        }
        ComponentPatch::new(
            visible: visible,
            focus_target: InspectorAction::Unknown,
            prevent_default: false,
            commands: BrowserBytes { ptr: 0, len: 0 },
        )
    }

    fn receive(self, event: own ComponentEvent<InspectorAction>) -> InspectorState uses (Stateful) {
        let mut selected: InspectorAction = self.selected
        let mut connected: bool = self.connected
        let mut revision: u32 = self.revision
        match event.kind {
            ComponentEventKind::Connected => {
                connected = true
                revision = revision + 1
            }
            ComponentEventKind::Disconnected => {
                connected = false
                revision = revision + 1
            }
            ComponentEventKind::Activate => {
                if connected {
                    selected = event.target
                    revision = revision + 1
                }
            }
            ComponentEventKind::KeyDown => {
                if connected {
                    if event.detail == 37 { selected = InspectorAction::Authored }
                    if event.detail == 39 { selected = InspectorAction::Generated }
                    revision = revision + 1
                }
            }
            _ => {}
        }
        InspectorState {
            selected: selected,
            connected: connected,
            revision: revision,
        }
    }
}
