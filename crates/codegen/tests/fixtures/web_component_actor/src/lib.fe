//! First actor-like Fe web component reducer.
//!
//! The alias proves the compiler resolves nominal role identity. Event kinds,
//! target interpretation, lifecycle policy, and all state changes live here;
//! a future fixed custom-element host only transports these facts and applies
//! typed output effects.

use core::actor::{
    InitialState as Initial, ProjectState as Projection,
    ResidentTransition as Stateful,
}
use std::web::component::{ComponentEvent, ComponentEventKind, ComponentPatch}
use std::web::component::BrowserBytes

pub struct InspectorState {
    pub selected: u32,
    pub connected: bool,
    pub revision: u32,
}

actor SourceInspector {
    selected: u32,
    connected: bool,
    revision: u32,

    const fn initial() -> InspectorState uses (Initial) {
        InspectorState {
            selected: 0,
            connected: false,
            revision: 0,
        }
    }

    fn project(self) -> ComponentPatch uses (Projection) {
        let mut visible_mask: u32 = 0
        if self.connected && self.selected < 32 {
            visible_mask = 1 << self.selected
        }
        ComponentPatch {
            visible_mask: visible_mask,
            focus_target: 0,
            flags: 0,
            commands: BrowserBytes { ptr: 0, len: 0 },
        }
    }

    fn receive(self, event: own ComponentEvent) -> InspectorState uses (Stateful) {
        let mut selected: u32 = self.selected
        let mut connected: bool = self.connected
        let mut revision: u32 = self.revision
        match event.kind {
            ComponentEventKind::Connected => {
                connected = true
                revision = revision + 1
            }
            ComponentEventKind::Disconnected => {
                connected = false
                revision = revision + 1
            }
            ComponentEventKind::Activate => {
                if connected {
                    selected = event.target
                    revision = revision + 1
                }
            }
            ComponentEventKind::KeyDown => {
                if connected {
                    if event.detail == 37 {
                        if selected > 0 { selected = selected - 1 }
                    } else {
                        if event.detail == 39 { selected = selected + 1 }
                    }
                    revision = revision + 1
                }
            }
            _ => {}
        }
        InspectorState {
            selected: selected,
            connected: connected,
            revision: revision,
        }
    }
}
