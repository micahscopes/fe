pub fn fixed_sqr_l8_limb7(sa: u32, a0: u32, a1: u32, a2: u32, a3: u32, a4: u32, a5: u32, a6: u32, a7: u32) -> u32 {
    let (_s, m) = sqr<8>(sa, build8(a0, a1, a2, a3, a4, a5, a6, a7))
    m.tail.tail.tail.tail.tail.tail.tail.value
}

pub fn fixed_escape_l8(cxs: u32, cx0: u32, cx1: u32, cx2: u32, cx3: u32, cx4: u32, cx5: u32, cx6: u32, cx7: u32, cys: u32, cy0: u32, cy1: u32, cy2: u32, cy3: u32, cy4: u32, cy5: u32, cy6: u32, cy7: u32, max_iter: i32) -> i32 {
    escape<8>(cxs, build8(cx0, cx1, cx2, cx3, cx4, cx5, cx6, cx7), cys, build8(cy0, cy1, cy2, cy3, cy4, cy5, cy6, cy7), max_iter)
}
