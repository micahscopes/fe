//! Gate fixture for the `Fixed<L>` bit-identical oracle
//! (SHARED_LIMB_CORE_DESIGN.md section 3; precision axis). NOT the source of
//! truth: these are thin, per-limb wasm-export wrappers around the real general
//! form, `precision::fixed::{mul, add, sub, sqr, escape}` at the explicit
//! `L in {2, 4, 6, 8}` instantiations (the tiers the adaptive mandelbrot
//! escape kernel selects among). Per-STATIC-limb wrappers exist because
//! `Limbs<L>` is an HList struct, not an array, so a runtime limb INDEX cannot
//! select a field (same convention as `precision_field_bn254fr_oracle_ingot`).
//!
//! GENERATED by crates/codegen/tests/fixtures/precision_fixed_oracle_ingot/gen_fixed_gate.py
//! (regenerate, do not hand-edit). The Rust oracle
//! `crates/codegen/tests/precision_fixed_oracle.rs` compiles this to wasm, runs
//! it under wasmtime, and compares every export LIMB-FOR-LIMB against an
//! independent num-bigint fixed-point reference.

use precision::fixed::{mul, add, sub, sqr, escape}
use precision::field::{Limbs, LimbLast, LimbMore}

// ---- L = 2 ----
fn build2(_ x0: u32, _ x1: u32) -> Limbs<2> {
    LimbMore { lead: x0, tail: LimbLast { value: x1 } }
}

pub fn fixed_mul_l2_sign(sa: u32, a0: u32, a1: u32, sb: u32, b0: u32, b1: u32) -> u32 {
    let (s, _m) = mul<2>(sa, build2(a0, a1), sb, build2(b0, b1))
    s
}
pub fn fixed_mul_l2_limb0(sa: u32, a0: u32, a1: u32, sb: u32, b0: u32, b1: u32) -> u32 {
    let (_s, m) = mul<2>(sa, build2(a0, a1), sb, build2(b0, b1))
    m.lead
}
pub fn fixed_mul_l2_limb1(sa: u32, a0: u32, a1: u32, sb: u32, b0: u32, b1: u32) -> u32 {
    let (_s, m) = mul<2>(sa, build2(a0, a1), sb, build2(b0, b1))
    m.tail.value
}

pub fn fixed_add_l2_sign(sa: u32, a0: u32, a1: u32, sb: u32, b0: u32, b1: u32) -> u32 {
    let (s, _m) = add<Limbs<2>>(sa, build2(a0, a1), sb, build2(b0, b1))
    s
}
