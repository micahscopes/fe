use canonical_words::{WordRead, WordSource}
use precision::baby_bear::BabyBear
use precision::polynomial::Radix2Field
use quadratic_plan::{
    QuadraticConstraintInterpreter,
    QuadraticPlanInterpreter,
    QuadraticWordConstraintInterpreter,
    QuadraticRelationConstraintInterpreter,
    QuadraticRelationInterpreter,
    QuadraticRelationStreamConstraintInterpreter,
    QuadraticRelationStreamInterpreter,
    QuadraticRelationValueInterpreter,
    QuadraticRelationWitnessInterpreter,
    QuadraticWitnessInterpreter,
}

struct TinyWordSource {
    words: [u32; 3],
    cursor: u32,
    valid: bool,
}
impl core::marker::Copy for TinyWordSource {}

impl TinyWordSource {
    fn new(_ words: [u32; 3]) -> Self {
        Self { words: words, cursor: 0, valid: true }
    }

    fn finish(self) -> bool { self.valid && self.cursor == 3 }
}

impl WordSource for TinyWordSource {
    fn read(self) -> WordRead<Self> {
        if !self.valid || self.cursor >= 3 {
            return WordRead {
                source: Self { words: self.words, cursor: self.cursor, valid: false },
                value: 0,
            }
        }
        WordRead {
            source: Self {
                words: self.words,
                cursor: self.cursor + 1,
                valid: true,
            },
            value: self.words[self.cursor as usize],
        }
    }

    fn reject(self) -> Self {
        Self { words: self.words, cursor: self.cursor, valid: false }
    }
}

struct TinyPlan<I: QuadraticPlanInterpreter<BabyBear>> {
    interpreter: I,
    output: BabyBear,
}
impl<I: QuadraticPlanInterpreter<BabyBear>> core::marker::Copy for TinyPlan<I> {}

/// One authored arithmetic plan shared by witness and constraint execution.
/// Its final value has degree four in the three input columns.
fn tiny_plan<I: QuadraticPlanInterpreter<BabyBear>>(
    _ interpreter: I,
    _ a: BabyBear,
    _ b: BabyBear,
    _ c: BabyBear,
) -> TinyPlan<I> {
    let ab = interpreter.multiply(a, b)
    let bc = ab.interpreter.multiply(b, c)
    let output = bc.interpreter.multiply(ab.value + c, bc.value)
    TinyPlan { interpreter: output.interpreter, output: output.value }
}

/// Returns validity, all residuals, all committed nodes, and the interpreted
/// output. A mutation changes one committed node after witness generation.
pub fn quadratic_plan_audit(
    _ a: u32,
    _ b: u32,
    _ c: u32,
    _ mutation: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let a = BabyBear::from_u32(a)
    let b = BabyBear::from_u32(b)
    let c = BabyBear::from_u32(c)
    let witnessed = tiny_plan(
        QuadraticWitnessInterpreter<BabyBear, 3>::new(),
        a,
        b,
        c,
    )
    let mut witness = witnessed.interpreter.finish()
    if mutation > 0 && mutation <= 3 {
        let index = (mutation - 1) as usize
        witness.nodes[index] = witness.nodes[index] + BabyBear::one()
    }
    let constrained = tiny_plan(
        QuadraticConstraintInterpreter<BabyBear, 3>::new(witness),
        a,
        b,
        c,
    )
    let residuals = constrained.interpreter.finish()
    (
        if residuals.valid { 1 } else { 0 },
        residuals.values[0].to_u32(),
        residuals.values[1].to_u32(),
        residuals.values[2].to_u32(),
        witness.nodes[0].to_u32(),
        witness.nodes[1].to_u32(),
        witness.nodes[2].to_u32(),
        constrained.output.to_u32(),
    )
}

/// Reinterpret the same plan from a caller-owned word source. No witness or
/// residual array exists inside the constraint interpreter.
pub fn quadratic_plan_word_audit(
    _ a: u32,
    _ b: u32,
    _ c: u32,
    _ mutation: u32,
) -> (u32, u32) {
    let a = BabyBear::from_u32(a)
    let b = BabyBear::from_u32(b)
    let c = BabyBear::from_u32(c)
    let witnessed = tiny_plan(
        QuadraticWitnessInterpreter<BabyBear, 3>::new(),
        a,
        b,
        c,
    )
    let witness = witnessed.interpreter.finish()
    let mut words = [
        witness.nodes[0].to_u32(),
        witness.nodes[1].to_u32(),
        witness.nodes[2].to_u32(),
    ]
    if mutation > 0 && mutation <= 3 {
        let index = (mutation - 1) as usize
        words[index] = BabyBear::from_u32(words[index]).radix2_add(BabyBear::one()).to_u32()
    }
    let constrained = tiny_plan(
        QuadraticWordConstraintInterpreter<TinyWordSource, 3>::new(
            TinyWordSource::new(words),
        ),
        a,
        b,
        c,
    )
    let checked = constrained.interpreter.finish()
    (
        if checked.valid && checked.reader.finish() { 1 } else { 0 },
        constrained.output.to_u32(),
    )
}

pub fn quadratic_plan_under_capacity(_ a: u32, _ b: u32, _ c: u32) -> u32 {
    let a = BabyBear::from_u32(a)
    let b = BabyBear::from_u32(b)
    let c = BabyBear::from_u32(c)
    let witnessed = tiny_plan(
        QuadraticWitnessInterpreter<BabyBear, 2>::new(),
        a,
        b,
        c,
    )
    let witness = witnessed.interpreter.finish()
    let constrained = tiny_plan(
        QuadraticConstraintInterpreter<BabyBear, 2>::new(witness),
        a,
        b,
        c,
    )
    if constrained.interpreter.finish().valid { 1 } else { 0 }
}

pub fn quadratic_plan_over_capacity(_ a: u32, _ b: u32, _ c: u32) -> u32 {
    let a = BabyBear::from_u32(a)
    let b = BabyBear::from_u32(b)
    let c = BabyBear::from_u32(c)
    let witnessed = tiny_plan(
        QuadraticWitnessInterpreter<BabyBear, 4>::new(),
        a,
        b,
        c,
    )
    let witness = witnessed.interpreter.finish()
    let constrained = tiny_plan(
        QuadraticConstraintInterpreter<BabyBear, 4>::new(witness),
        a,
        b,
        c,
    )
    if constrained.interpreter.finish().valid { 1 } else { 0 }
}

struct TinyRelation<I: QuadraticRelationInterpreter<BabyBear>> {
    interpreter: I,
    output: BabyBear,
}
impl<I: QuadraticRelationInterpreter<BabyBear>> core::marker::Copy
    for TinyRelation<I> {}

/// The same three-node arithmetic plan now also owns its two semantic
/// assertions. No interpreter carries a parallel copy of the relation.
fn tiny_relation<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreter: I,
    _ a: BabyBear,
    _ b: BabyBear,
    _ c: BabyBear,
    _ expected: BabyBear,
) -> TinyRelation<I> {
    let ab = interpreter.multiply(a, b)
    let bc = ab.interpreter.multiply(b, c)
    let output = bc.interpreter.multiply(a.radix2_add(ab.value), bc.value)
    let expected_output = output.interpreter.constrain_zero(
        output.value.radix2_sub(expected),
    )
    let input_relation = expected_output.interpreter.constrain_zero(
        c.radix2_sub(a.radix2_add(b)),
    )
    TinyRelation { interpreter: input_relation.interpreter, output: output.value }
}

pub fn quadratic_relation_audit(
    _ a: u32,
    _ b: u32,
    _ c: u32,
    _ expected: u32,
    _ mutation: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let a = BabyBear::from_u32(a)
    let b = BabyBear::from_u32(b)
    let c = BabyBear::from_u32(c)
    let expected = BabyBear::from_u32(expected)
    let witnessed = tiny_relation(
        QuadraticRelationWitnessInterpreter<BabyBear, 3, 2>::new(),
        a,
        b,
        c,
        expected,
    )
    let mut witness = witnessed.interpreter.finish()
    if mutation > 0 && mutation <= 3 {
        let index = (mutation - 1) as usize
        witness.nodes[index] = witness.nodes[index] + BabyBear::one()
    }
    let constrained = tiny_relation(
        QuadraticRelationConstraintInterpreter<BabyBear, 3, 2>::new(witness),
        a,
        b,
        c,
        expected,
    )
    let direct = tiny_relation(
        QuadraticRelationValueInterpreter::new(),
        a,
        b,
        c,
        expected,
    )
    let residuals = constrained.interpreter.finish()
    (
        if residuals.valid { 1 } else { 0 },
        residuals.products[0].to_u32(),
        residuals.products[1].to_u32(),
        residuals.products[2].to_u32(),
        residuals.assertions[0].to_u32(),
        residuals.assertions[1].to_u32(),
        constrained.output.to_u32(),
        if direct.interpreter.finish() { direct.output.to_u32() } else { 0 },
    )
}

/// Generate one memory-backed witness, optionally mutate one independent
/// layer, and re-interpret the same authored relation against that untrusted
/// stream. No second wiring description participates in the verification.
pub fn quadratic_relation_stream_audit(
    _ a: u32,
    _ b: u32,
    _ c: u32,
    _ expected: u32,
    _ mutation: u32,
) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let a = BabyBear::from_u32(a)
    let b = BabyBear::from_u32(b)
    let c = BabyBear::from_u32(c)
    let expected = BabyBear::from_u32(expected)
    let generated = tiny_relation(
        QuadraticRelationStreamInterpreter<BabyBear, 3, 2>::new(),
        a,
        b,
        c,
        expected,
    )
    let stream = generated.interpreter.finish()
    if mutation == 1 {
        let mut row = stream.product(0)
        row.output = row.output.radix2_add(BabyBear::one())
        let _replaced = stream.replace_product(0, row)
    } else if mutation == 2 {
        let mut row = stream.product(1)
        row.left = row.left.radix2_add(BabyBear::one())
        row.output = row.left.radix2_mul(row.right)
        let _replaced = stream.replace_product(1, row)
    } else if mutation == 3 {
        let _replaced = stream.replace_assertion(0, BabyBear::one())
    }
    let verified_expected = if mutation == 4 {
        expected.radix2_add(BabyBear::one())
    } else {
        expected
    }
    let verified = tiny_relation(
        QuadraticRelationStreamConstraintInterpreter<BabyBear, 3, 2>::new(
            stream,
        ),
        a,
        b,
        c,
        verified_expected,
    )
    let local = stream.audit()
    let constrained = verified.interpreter.finish()
    (
        if local.shape_valid { 1 } else { 0 },
        local.nonzero_products,
        local.nonzero_assertions,
        if constrained.shape_valid { 1 } else { 0 },
        constrained.operand_copy_mismatches,
        constrained.nonzero_products,
        constrained.assertion_copy_mismatches,
        constrained.nonzero_assertions,
    )
}

pub fn quadratic_relation_stream_wrong_shape(
    _ a: u32,
    _ b: u32,
    _ c: u32,
    _ expected: u32,
) -> u32 {
    let a = BabyBear::from_u32(a)
    let b = BabyBear::from_u32(b)
    let c = BabyBear::from_u32(c)
    let expected = BabyBear::from_u32(expected)
    let generated = tiny_relation(
        QuadraticRelationStreamInterpreter<BabyBear, 4, 2>::new(),
        a,
        b,
        c,
        expected,
    )
    let stream = generated.interpreter.finish()
    let verified = tiny_relation(
        QuadraticRelationStreamConstraintInterpreter<BabyBear, 4, 2>::new(
            stream,
        ),
        a,
        b,
        c,
        expected,
    )
    if verified.interpreter.finish().shape_valid { 1 } else { 0 }
}

pub fn quadratic_relation_wrong_product_shape(
    _ a: u32,
    _ b: u32,
    _ c: u32,
    _ expected: u32,
) -> u32 {
    let witnessed = tiny_relation(
        QuadraticRelationWitnessInterpreter<BabyBear, 2, 2>::new(),
        BabyBear::from_u32(a),
        BabyBear::from_u32(b),
        BabyBear::from_u32(c),
        BabyBear::from_u32(expected),
    )
    let constrained = tiny_relation(
        QuadraticRelationConstraintInterpreter<BabyBear, 2, 2>::new(
            witnessed.interpreter.finish(),
        ),
        BabyBear::from_u32(a),
        BabyBear::from_u32(b),
        BabyBear::from_u32(c),
        BabyBear::from_u32(expected),
    )
    if constrained.interpreter.finish().valid { 1 } else { 0 }
}

pub fn quadratic_relation_wrong_assertion_shape(
    _ a: u32,
    _ b: u32,
    _ c: u32,
    _ expected: u32,
) -> u32 {
    let witnessed = tiny_relation(
        QuadraticRelationWitnessInterpreter<BabyBear, 3, 1>::new(),
        BabyBear::from_u32(a),
        BabyBear::from_u32(b),
        BabyBear::from_u32(c),
        BabyBear::from_u32(expected),
    )
    let constrained = tiny_relation(
        QuadraticRelationConstraintInterpreter<BabyBear, 3, 1>::new(
            witnessed.interpreter.finish(),
        ),
        BabyBear::from_u32(a),
        BabyBear::from_u32(b),
        BabyBear::from_u32(c),
        BabyBear::from_u32(expected),
    )
    if constrained.interpreter.finish().valid { 1 } else { 0 }
}
