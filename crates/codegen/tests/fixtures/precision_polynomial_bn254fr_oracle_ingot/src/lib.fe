    words_tuple(output_words<16>(radix2_intt<16, 20, Bn254Fr>(
        radix2_ntt<16, 20, Bn254Fr>([
        FieldElement<20, Bn254Fr>::from_u32(a0),
        FieldElement<20, Bn254Fr>::from_u32(a1),
        FieldElement<20, Bn254Fr>::from_u32(a2),
        FieldElement<20, Bn254Fr>::from_u32(a3),
        FieldElement<20, Bn254Fr>::from_u32(a4),
        FieldElement<20, Bn254Fr>::from_u32(a5),
        FieldElement<20, Bn254Fr>::from_u32(a6),
        FieldElement<20, Bn254Fr>::from_u32(a7),
        FieldElement<20, Bn254Fr>::from_u32(a8),
        FieldElement<20, Bn254Fr>::from_u32(a9),
        FieldElement<20, Bn254Fr>::from_u32(a10),
        FieldElement<20, Bn254Fr>::from_u32(a11),
        FieldElement<20, Bn254Fr>::from_u32(a12),
        FieldElement<20, Bn254Fr>::from_u32(a13),
        FieldElement<20, Bn254Fr>::from_u32(a14),
        FieldElement<20, Bn254Fr>::from_u32(a15),
