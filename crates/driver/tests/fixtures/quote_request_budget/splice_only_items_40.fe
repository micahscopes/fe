// Budget: a body made only of two Code<Item> splices, doubled 40 times (about 2^40 empty items).
mod author {
    use core::meta::{Code, Item, Record, empty}
    pub const fn emit(_ record: Record) -> Code<Item> {
        let mut items: Code<Item> = empty<Item>()
        let mut i: usize = 0
        while i < 40 {
            items = quote {
                ${items}
                ${items}
            }
            i += 1
        }
        items
    }
}
#[generate(ingot::author::emit)]
struct T {}
