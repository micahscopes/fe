// Budget: Code<Item> spliced twice per step plus one literal item, 20 steps (about 2^20 items).
mod author {
    use core::meta::{Code, Item, Record, empty}
    pub const fn emit(_ record: Record) -> Code<Item> {
        let mut items: Code<Item> = empty<Item>()
        let mut i: usize = 0
        while i < 20 {
            items = quote {
                ${items}
                ${items}
                fn h() -> u256 { 1 }
            }
            i += 1
        }
        items
    }
}
#[generate(ingot::author::emit)]
struct T {}
