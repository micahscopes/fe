mod author {
    use core::meta::{Code, Item, Record}

    pub const fn make(record: Record) -> Code<Item> {
        let head_size: u256 = 42
        quote {
            impl core::abi::AbiSize for ${record} {
                const HEAD_SIZE: u256 = ${head_size}
                const IS_DYNAMIC: bool = false
            }
        }
    }
}

#[generate(ingot::author::make)]
struct Sample { value: u256 }

const fn answer() -> u256 { <Sample as core::abi::AbiSize>::HEAD_SIZE }
