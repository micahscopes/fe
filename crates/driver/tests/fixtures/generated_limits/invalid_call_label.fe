use core::meta::{Record, DeclarationName, DeclarationType, BodyExpr, FunctionDefinition, FunctionCall, CallArgument}

const fn identity(value: u256) -> u256 { value }

const fn make(_ record: Record) -> FunctionDefinition<1, 2> {
    FunctionDefinition {
        name: DeclarationName::Literal("apply"),
        public: true,
        const_function: true,
        parameters: [DeclarationType::U256],
        return_type: DeclarationType::U256,
        expressions: [
            BodyExpr::Parameter(0),
            BodyExpr::Call(FunctionCall {
                path: "ingot::identity",
                types: [Option::None, Option::None],
                arguments: [
                    Option::Some(CallArgument { label: Option::Some("not valid"), expression: 0 }),
                    Option::None,
                    Option::None,
                    Option::None,
                ],
            }),
        ],
        result: 1,
    }
}

#[generate(make)]
struct Target {}
