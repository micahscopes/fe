use core::abi::AbiSize
use core::meta::{Record, DeclarationName, DeclarationType, BodyExpr,
    FunctionCall, AssociatedConstant, RecordImplementation, field, field_type}

const fn size(_ record: Record) -> RecordImplementation<0, 3> {
    let first = field(record, 0)
    let second = field(record, 1)
    let no_type: Option<DeclarationType> = Option::None
    let call_first = FunctionCall {
        path: "core::abi::abi_field_head_size",
        types: [Option::Some(DeclarationType::Field(field_type(first))), no_type],
        arguments: [Option::None; 4],
    }
    let call_second = FunctionCall {
        path: "core::abi::abi_field_head_size",
        types: [Option::Some(DeclarationType::Field(field_type(second))), no_type],
        arguments: [Option::None; 4],
    }
    RecordImplementation {
        owner: record,
        trait_path: "core::abi::AbiSize",
        types: [Option::None; 2],
        constants: [
            Option::Some(AssociatedConstant::Expression(
                DeclarationName::Literal("HEAD_SIZE"), DeclarationType::U256,
                [BodyExpr::Call(call_first), BodyExpr::Call(call_second), BodyExpr::Add(0, 1)], 2,
            )),
            Option::Some(AssociatedConstant::Bool(DeclarationName::Literal("IS_DYNAMIC"), false)),
        ],
        method: Option::None,
    }
}

struct Pair {}
impl AbiSize for Pair {
    const HEAD_SIZE: u256 = 64
    const IS_DYNAMIC: bool = false
}

#[generate(size)]
struct Wrapped<T> where T: AbiSize { value: T, tag: u256 }

const fn answer() -> u256 {
    <Wrapped<Pair> as AbiSize>::HEAD_SIZE + <Wrapped<u256> as AbiSize>::HEAD_SIZE
}

#[test]
fn generic_head_size_uses_selected_field_types() {
    assert!(answer() == 160)
}
