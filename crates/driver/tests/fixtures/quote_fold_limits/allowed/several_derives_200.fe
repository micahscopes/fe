#[test]
fn derived_equality_checks_every_field() {
    assert!(make(0, 199).sum() == 19900)
    assert!(make(0, 199).xor() == 0)
    assert!(make(0, 198).xor() == 1)
    assert!(make(0, 199) == make(0, 199))
    assert!(!(make(0, 199) == make(1, 199)))
    assert!(!(make(0, 199) == make(0, 198)))
}
