use core::ops::Eq
pub trait Sum { fn sum(self) -> u256 }
pub trait Xor { fn xor(self) -> u256 }
mod author {
    use core::ops::Eq
    use ingot::{Sum, Xor}
    use core::meta::{Code, Expr, Item, Record, field, field_count}
    pub const fn derive_eq(record: Record) -> Code<Item> {
        let mut cmp: Code<Expr> = quote { true }
        let mut sum: Code<Expr> = quote { 0 }
        let mut xor: Code<Expr> = quote { 0 }
        let mut i: usize = 0
        while i < field_count(record) {
            let f = field(record, i)
            cmp = quote(other) { ${cmp} && self.${f} == other.${f} }
            sum = quote { ${sum} + self.${f} }
            xor = quote { ${xor} ^ self.${f} }
            i += 1
        }
        let eq: Code<Item> = quote {
            impl Eq for ${record} {
                fn eq(self, _ other: Self) -> bool { ${cmp} }
            }
        }
        let sum_item: Code<Item> = quote {
            impl Sum for ${record} { fn sum(self) -> u256 { ${sum} } }
        }
        let xor_item: Code<Item> = quote {
            impl Xor for ${record} { fn xor(self) -> u256 { ${xor} } }
        }
        quote {
            ${eq}
            ${sum_item}
            ${xor_item}
            fn derive_checkpoint() -> u256 { 0 }
        }
    }
}
#[generate(ingot::author::derive_eq)]
