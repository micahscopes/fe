pub trait Mark {}
impl Mark for u256 {}
pub trait Tag {}
mod author {
 use core::meta::{Code, Item, Where, Record}
 pub const fn emit(record: Record) -> Code<Item> {
 let bounds: Code<Where> = quote { where u256: ingot::sub::Mark }
 quote { pub fn generated<U>(_ value: U) -> u256 where U: ingot::sub::Mark { 7 } }
 }
}
#[generate(ingot::author::emit)]
pub struct Target {}
fn need<X: Tag>() {}
fn trigger() { generated(1 as u256) }
