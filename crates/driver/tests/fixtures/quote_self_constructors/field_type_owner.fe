pub trait Score { fn score(self) -> u256 }
pub enum Inner { A, B(u256) }
mod author {
    use core::meta::{Code, Item, Record, field, field_type}
    pub const fn emit(record: Record) -> Code<Item> {
        let ty = field_type(field(record, 0))
        quote {
            impl ingot::Score for ${ty} {
                fn score(self) -> u256 {
                    match self { Self::A => 1, Self::B(x) => x }
                }
            }
        }
    }
}
#[generate(ingot::author::emit)]
pub struct Outer { pub inner: Inner }
#[test]
fn values() {
    assert!(Inner::A.score() == 1)
    assert!(Inner::B(8).score() == 8)
}
