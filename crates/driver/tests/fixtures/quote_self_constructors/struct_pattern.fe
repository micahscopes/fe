pub trait Sum {
    fn sum(self) -> u256
    fn make(_ x: u256, _ y: u256) -> Self
}
mod author {
    use core::meta::{Code, Item, Record}
    pub const fn emit(record: Record) -> Code<Item> {
        quote {
            impl ingot::Sum for ${record} {
                fn sum(self) -> u256 {
                    let Self { x, y } = self
                    x * 10 + y
                }
                fn make(_ x: u256, _ y: u256) -> Self { Self { x, y } }
            }
        }
    }
}
#[generate(ingot::author::emit)]
pub struct P { pub x: u256, pub y: u256 }
#[test]
fn values() {
    assert!(P { x: 3, y: 4 }.sum() == 34)
    assert!(P::make(5, 6).sum() == 56)
}
