use core::meta::{Code, Item, Record, field, field_type}

trait Value<T> {
    fn value(own self) -> T
}

const fn derive_value(record: Record) -> Code<Item> {
    let f = field(record, 0)
    let ty = field_type(f)
    quote {
        impl ingot::Value<${ty}> for ${record} {
            fn value(own self) -> ${ty} { self.${f} }
        }
    }
}

#[generate(derive_value)]
struct Wrapped<T, const N: usize> where N > 0 { value: T }

pub fn main() -> u256 {
    let wrapped = Wrapped<u256, 7> { value: 41 }
    wrapped.value()
}

#[test]
fn generic_owner_preserves_value() {
    assert!(main() == 41)
}
