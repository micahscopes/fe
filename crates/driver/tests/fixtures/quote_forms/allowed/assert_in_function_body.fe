// `assert!` written directly in a quoted function body.
mod author {
    use core::meta::{Code, Item, Record}
    pub const fn emit(_ record: Record) -> Code<Item> {
        quote {
            pub fn gen(x: u256) -> u256 {
                assert!(x < 10)
                assert!(x < 20, "x is small")
                x
            }
        }
    }
}
#[generate(ingot::author::emit)]
struct T {}
