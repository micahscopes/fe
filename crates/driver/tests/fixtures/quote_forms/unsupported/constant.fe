// A named constant in an expression is refused at the form.
mod author {
    use core::meta::{Code, Item, Record}
    pub const LIMIT: u256 = 7
    pub const fn emit(_ record: Record) -> Code<Item> {
        quote {
            pub fn gen() -> u256 { LIMIT + ingot::author::LIMIT }
        }
    }
}
#[generate(ingot::author::emit)]
struct T {}
