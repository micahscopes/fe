pub const fn bump(_ value: u256) -> u256 { value + 100 }
use policy::make as make
use policy::ScratchProbe

#[generate(policy::make)]
struct Target { value: u256 }

#[generate(policy::quote_make)]
struct QuotedTarget {}

#[generate(policy::quote_scratch)]
struct ScratchTarget {}

const fn answer() -> u256 { apply(42) }
const fn answer_quote() -> u256 { quoted() }
const fn answer_scratch() -> u256 { ScratchTarget {}.scratch() }

mod scratch {
    pub struct Scratch { pub value: bool }
    pub const fn make() -> Scratch { Scratch { value: false } }
    pub const fn scratch_step(_ value: Scratch) -> u256 { 999 }
}

mod shadow {
    mod policy {
        pub const fn bump(_ value: u256) -> u256 { value + 100 }
    }

    #[generate(ingot::make)]
    struct Target { value: u256 }

    pub const fn answer() -> u256 { apply(42) }
}

const fn answer_shadow() -> u256 { shadow::answer() }
