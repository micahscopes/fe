use core::meta::{Record, DeclarationName, DeclarationType, BodyExpr, FunctionDefinition}

const fn make(_ record: Record) -> FunctionDefinition<0, 1> {
    FunctionDefinition {
        name: DeclarationName::Literal("seven"),
        public: true,
        const_function: true,
        parameters: [],
        return_type: DeclarationType::U256,
        expressions: [BodyExpr::U256(7)],
        result: 0,
    }
}

mod target {
    type u256 = u8

    #[generate(ingot::make)]
    struct Marker { value: u8 }
}

const fn answer() -> u256 { target::seven() }
