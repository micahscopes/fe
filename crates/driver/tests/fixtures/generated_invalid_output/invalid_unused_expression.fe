use core::meta::{Record, DeclarationName, DeclarationType, BodyExpr, FunctionDefinition}

const fn make(_ record: Record) -> FunctionDefinition<1, 3> {
    FunctionDefinition {
        name: DeclarationName::Literal("apply"),
        public: true,
        const_function: true,
        parameters: [DeclarationType::U256],
        return_type: DeclarationType::U256,
        expressions: [
            BodyExpr::Parameter(0),
            BodyExpr::Bool(true),
            BodyExpr::Add(0, 1),
        ],
        result: 0,
    }
}

#[generate(make)]
struct Target {}
