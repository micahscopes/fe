use core::meta::{Code, Item, Record}

const fn make(record: Record) -> Code<Item> {
    quote {
        const fn pass(_ value: ${record}) -> ${record} { value }
    }
}

#[generate(make)]
struct Wrapped<const N: usize> { value: u256 }

const fn answer() -> u256 { pass(Wrapped<3> { value: 42 }).value }
