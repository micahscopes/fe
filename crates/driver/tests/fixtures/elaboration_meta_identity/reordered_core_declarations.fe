mod author {
    use core::meta::{Code, DeclarationName, Item, Record}

    pub const fn make(_ record: Record) -> Code<Item> {
        let name = DeclarationName::Literal("calc")
        let result: u256 = 42
        quote {
            const fn ${name}() -> u256 { ${result} }
        }
    }
}

#[generate(ingot::author::make)]
struct Sample {}

const fn answer() -> u256 { calc() }
