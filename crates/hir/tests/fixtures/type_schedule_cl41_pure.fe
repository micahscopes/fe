// Pure Fe type-normalization spike for the real Cl(4,1) S * P * S support.
//
// Sphere blades: {1, 2, 8, 16}; point blades: {1, 2, 4, 8, 16}.
// The 80 ordered source triples are canonicalized by sorting the two sphere
// operand slots.  This gives 5 * 10 = 50 candidates.  `coefficient_tag`
// combines the two orderings, including their Clifford signs: 18 cancel and
// are erased structurally, leaving the exact 32-term normal form below.

struct End {}
struct Candidate<const K: usize> {}
struct Cons<H, T> {}

struct Zero {}
// Coeff tags: 1 = +1, 2 = -1, 3 = +2, 4 = -2.
struct Term<
    const Blade: usize,
    const PointSlot: usize,
    const SphereLo: usize,
    const SphereHi: usize,
    const Coeff: usize,
> {}
struct Add<L, R> {}

recursive type fn Candidates<const N: usize>() -> (*) {
    match N {
        0 => End
        // Enumerate 0..49.  The accumulator prepends each surviving term, so
        // the resulting canonical spine is ordered 49..0.
        _ => Cons<Candidate<{50 - N}>, Candidates<{N - 1}>>
    }
}

const fn sphere_blade(_ slot: usize) -> usize {
    match slot {
        0 => 1
        1 => 2
        2 => 8
        _ => 16
    }
}

const fn point_blade(_ slot: usize) -> usize {
    match slot {
        0 => 1
        1 => 2
        2 => 4
        3 => 8
        _ => 16
    }
}

const fn pair_lo(_ pair: usize) -> usize {
    match pair {
        0 => 0
        1 => 0
        2 => 0
        3 => 0
        4 => 1
        5 => 1
        6 => 1
        7 => 2
        8 => 2
        _ => 3
    }
}

const fn pair_hi(_ pair: usize) -> usize {
    match pair {
        0 => 0
        1 => 1
        2 => 2
        3 => 3
        4 => 1
        5 => 2
        6 => 3
        7 => 2
        8 => 3
        _ => 3
    }
}

// Parity of swaps plus the e5^2 = -1 metric contribution.  Returning 0/1
// keeps the whole computation in usize const arguments.
const fn gp_negative(_ a: usize, _ b: usize) -> usize {
    (
        ((a >> 1) & 1) * (b & 1)
        + ((a >> 2) & 1) * ((b & 1) + ((b >> 1) & 1))
        + ((a >> 3) & 1) * ((b & 1) + ((b >> 1) & 1) + ((b >> 2) & 1))
        + ((a >> 4) & 1) * (
            (b & 1) + ((b >> 1) & 1) + ((b >> 2) & 1) + ((b >> 3) & 1)
        )
        + ((a >> 4) & 1) * ((b >> 4) & 1)
    ) % 2
}

const fn triple_negative(_ a: usize, _ p: usize, _ c: usize) -> usize {
    (gp_negative(a, p) + gp_negative(a ^ p, c)) % 2
}

const fn candidate_blade(_ k: usize) -> usize {
    let pslot: usize = k / 10
    let pair: usize = k % 10
    sphere_blade(pair_lo(pair)) ^ point_blade(pslot) ^ sphere_blade(pair_hi(pair))
}

// 0 = cancelled; the remaining tags are the exact signed multiplicity.
const fn coefficient_tag(_ k: usize) -> usize {
    let pslot: usize = k / 10
    let pair: usize = k % 10
    let lo: usize = pair_lo(pair)
    let hi: usize = pair_hi(pair)
    let a: usize = sphere_blade(lo)
    let p: usize = point_blade(pslot)
    let c: usize = sphere_blade(hi)
    let forward: usize = triple_negative(a, p, c)
    if lo == hi {
        if forward == 0 { 1 } else { 2 }
    } else {
        let reverse: usize = triple_negative(c, p, a)
        if forward != reverse { 0 }
        else if forward == 0 { 3 }
        else { 4 }
    }
}

// A CTFE scan performs filtering before type normalization.  It is still the
// algebra above, not a survivor lookup table: changing the metric or supports
// changes both the count and every selected key.
const fn survivor_count() -> usize {
    let mut k: usize = 0
    let mut count: usize = 0
    while k < 50 {
        if coefficient_tag(k) != 0 { count = count + 1 }
        k = k + 1
    }
    count
}

const fn survivor_key(_ target: usize) -> usize {
    let mut k: usize = 0
    let mut seen: usize = 0
    while k < 50 {
        if coefficient_tag(k) != 0 {
            if seen == target { return k }
            seen = seen + 1
        }
        k = k + 1
    }
    // Unreachable when target < survivor_count().
    50
}

recursive type fn Schedule<const N: usize>() -> (*) {
    match N {
        0 => Zero
        _ => Add<
            Term<
                { candidate_blade(survivor_key(N - 1)) },
                { survivor_key(N - 1) / 10 },
                { pair_lo(survivor_key(N - 1) % 10) },
                { pair_hi(survivor_key(N - 1) % 10) },
                { coefficient_tag(survivor_key(N - 1)) },
            >,
            Schedule<{N - 1}>
        >
    }
}

static_assert(survivor_count() == 32)

// Force the complete ground schedule to normalize, then count its actual Add
// spine.  The payload assertions below establish the contents independently;
// this witness establishes that `Schedule<32>` itself materializes all and
// only those 32 nodes.
type SpecializedSandwich = Schedule<32>

struct NatZ {}
struct NatS<N> {}
recursive type fn Nat<const N: usize>() -> (*) {
    match N {
        0 => NatZ
        _ => NatS<Nat<{N - 1}>>
    }
}

trait PlanLength { type Out }
impl PlanLength for Zero { type Out = NatZ }
impl<TermNode, Tail: PlanLength> PlanLength for Add<TermNode, Tail> {
    type Out = NatS<<Tail as PlanLength>::Out>
}

fn takes_32_terms(_ length: Nat<32>) {}
fn ground_schedule_materializes_32_terms(
    length: <SpecializedSandwich as PlanLength>::Out,
) {
    takes_32_terms(length)
}

// Injective packing over these bounded fields.  Together these assertions are
// an exact, element-by-element oracle for the complete canonical schedule;
// unlike whole nested-type equality, they do not trigger pathological solver
// recomputation of every recursive suffix.
const fn term_code(_ k: usize) -> usize {
    candidate_blade(k) + 32 * (
        (k / 10) + 5 * (
            pair_lo(k % 10) + 4 * (
                pair_hi(k % 10) + 4 * coefficient_tag(k)
            )
        )
    )
}

const fn expected_term_code(_ index: usize) -> usize {
    match index {
        0 => 2561
        1 => 8322
        2 => 8968
        3 => 9616
        4 => 5921
        5 => 6721
        6 => 4961
        7 => 5154
        8 => 8353
        9 => 3394
        10 => 9160
        11 => 9808
        12 => 6754
        13 => 4994
        14 => 5188
        15 => 5988
        16 => 6788
        17 => 5028
        18 => 5224
        19 => 9057
        20 => 6024
        21 => 9218
        22 => 4264
        23 => 10032
        24 => 5064
        25 => 5264
        26 => 12289
        27 => 6064
        28 => 12450
        29 => 6864
        30 => 12616
        _ => 7664
    }
}

const fn schedule_is_exact() -> bool {
    let mut candidate: usize = 0
    let mut survivor: usize = 0
    while candidate < 50 {
        if coefficient_tag(candidate) != 0 {
            if survivor >= 32 || term_code(candidate) != expected_term_code(survivor) {
                return false
            }
            survivor = survivor + 1
        }
        candidate = candidate + 1
    }
    survivor == 32
}

static_assert(schedule_is_exact())

fn takes_first(_ term: Term<1, 0, 0, 0, 1>) {}
fn takes_middle(_ term: Term<4, 2, 1, 1, 2>) {}
fn takes_last(_ term: Term<16, 4, 3, 3, 2>) {}

fn first_witness(term: Term<
    { candidate_blade(survivor_key(0)) },
    { survivor_key(0) / 10 },
    { pair_lo(survivor_key(0) % 10) },
    { pair_hi(survivor_key(0) % 10) },
    { coefficient_tag(survivor_key(0)) },
>) { takes_first(term) }

fn middle_witness(term: Term<
    { candidate_blade(survivor_key(15)) },
    { survivor_key(15) / 10 },
    { pair_lo(survivor_key(15) % 10) },
    { pair_hi(survivor_key(15) % 10) },
    { coefficient_tag(survivor_key(15)) },
>) { takes_middle(term) }

fn last_witness(term: Term<
    { candidate_blade(survivor_key(31)) },
    { survivor_key(31) / 10 },
    { pair_lo(survivor_key(31) % 10) },
    { pair_hi(survivor_key(31) % 10) },
    { coefficient_tag(survivor_key(31)) },
>) { takes_last(term) }
