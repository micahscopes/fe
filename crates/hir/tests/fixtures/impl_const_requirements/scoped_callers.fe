trait Value { fn value(own self) -> u256 }
struct Wrapped<const N: usize> { value: u256 }
impl<const N: usize> Value for Wrapped<N> where N > 0 {
    fn value(own self) -> u256 { self.value }
}
fn helper<T: Value>(_ value: own T) -> u256 { value.value() }
fn permitted<const N: usize>(value: own Wrapped<N>) -> u256 where N > 0 {
    helper(value)
}
fn missing<const N: usize>(value: own Wrapped<N>) -> u256 {
    helper(value)
}
