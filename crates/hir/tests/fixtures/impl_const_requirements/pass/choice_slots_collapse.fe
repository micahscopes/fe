// Distinct declared bounds at one call stay distinct after T becomes u8.
trait Read<T> { const fn read() -> u256 }
struct S {}
impl<T> Read<T> for S { const fn read() -> u256 { 1 } }
impl Read<u8> for S as Alternative { const fn read() -> u256 { 2 } }
const fn consume<A, T>() -> u256 where A: Read<T>, A: Read<u8> {
    <A as Read<T>>::read() * 10 + <A as Read<u8>>::read()
}
const fn run<T>() -> u256 { with (Alternative) { consume<S, T>() } }
const R: u256 = run<u8>()
#[test]
fn t() { assert(R > 0) }
