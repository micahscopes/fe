// RD85: explicitly providing a value preserves ordinary implementation lookup.
trait Greet {
    fn greet(self) -> u32
}

struct U { id: u256 }

impl Greet for U {
    fn greet(self) -> u32 { return 1 }
}

impl Greet for U as Casual {
    fn greet(self) -> u32 { return 2 }
}

const Casual: u32 = 7

fn check() -> u32 {
    let supplied_value = Casual
    let u = U { id: 1 }
    with (supplied_value) { u.greet() } // <- here
}
