// Current-Fe sparse Cl(4,1) slice. Blade masks are the canonical 0..31
// Clifford basis indices. Candidate support deliberately includes scalar,
// bivector, and pseudoscalar noise; grade pruning retains the five vectors.

struct Missing {}
struct Found<const Slot: usize> {}
struct Select<const Present: usize, const Slot: usize> {}

trait SelectOut { type Out }
impl<const Slot: usize> SelectOut for Select<0, Slot> { type Out = Missing }
impl<const Slot: usize> SelectOut for Select<1, Slot> { type Out = Found<Slot> }

const GRADE1_MASK: usize = 65814 // bits 1, 2, 4, 8, 16
const CANDIDATE_MASK: usize = 2147549471 // grade-1 mask | bits 0, 3, 31

const fn popcount32(_ value: usize) -> usize {
    (value & 1)
        + ((value >> 1) & 1) + ((value >> 2) & 1) + ((value >> 3) & 1)
        + ((value >> 4) & 1) + ((value >> 5) & 1) + ((value >> 6) & 1)
        + ((value >> 7) & 1) + ((value >> 8) & 1) + ((value >> 9) & 1)
        + ((value >> 10) & 1) + ((value >> 11) & 1) + ((value >> 12) & 1)
        + ((value >> 13) & 1) + ((value >> 14) & 1) + ((value >> 15) & 1)
        + ((value >> 16) & 1) + ((value >> 17) & 1) + ((value >> 18) & 1)
        + ((value >> 19) & 1) + ((value >> 20) & 1) + ((value >> 21) & 1)
        + ((value >> 22) & 1) + ((value >> 23) & 1) + ((value >> 24) & 1)
        + ((value >> 25) & 1) + ((value >> 26) & 1) + ((value >> 27) & 1)
        + ((value >> 28) & 1) + ((value >> 29) & 1) + ((value >> 30) & 1)
        + ((value >> 31) & 1)
}

const fn kept(_ blade: usize) -> usize {
    ((CANDIDATE_MASK >> blade) & 1) * ((GRADE1_MASK >> blade) & 1)
}

const fn compact_rank(_ blade: usize) -> usize {
    popcount32((CANDIDATE_MASK & GRADE1_MASK) & ((1 << blade) - 1))
}

const fn support_cardinality() -> usize {
    popcount32(CANDIDATE_MASK & GRADE1_MASK)
}

recursive type fn FindVector<const Blade: usize>() -> (*) {
    match Blade {
        0 => <Select<{kept(0)}, {compact_rank(0)}> as SelectOut>::Out
        1 => <Select<{kept(1)}, {compact_rank(1)}> as SelectOut>::Out
        2 => <Select<{kept(2)}, {compact_rank(2)}> as SelectOut>::Out
        3 => <Select<{kept(3)}, {compact_rank(3)}> as SelectOut>::Out
        4 => <Select<{kept(4)}, {compact_rank(4)}> as SelectOut>::Out
        5 => <Select<{kept(5)}, {compact_rank(5)}> as SelectOut>::Out
        6 => <Select<{kept(6)}, {compact_rank(6)}> as SelectOut>::Out
        7 => <Select<{kept(7)}, {compact_rank(7)}> as SelectOut>::Out
        8 => <Select<{kept(8)}, {compact_rank(8)}> as SelectOut>::Out
        9 => <Select<{kept(9)}, {compact_rank(9)}> as SelectOut>::Out
        10 => <Select<{kept(10)}, {compact_rank(10)}> as SelectOut>::Out
        11 => <Select<{kept(11)}, {compact_rank(11)}> as SelectOut>::Out
        12 => <Select<{kept(12)}, {compact_rank(12)}> as SelectOut>::Out
        13 => <Select<{kept(13)}, {compact_rank(13)}> as SelectOut>::Out
        14 => <Select<{kept(14)}, {compact_rank(14)}> as SelectOut>::Out
        15 => <Select<{kept(15)}, {compact_rank(15)}> as SelectOut>::Out
        16 => <Select<{kept(16)}, {compact_rank(16)}> as SelectOut>::Out
        17 => <Select<{kept(17)}, {compact_rank(17)}> as SelectOut>::Out
        18 => <Select<{kept(18)}, {compact_rank(18)}> as SelectOut>::Out
        19 => <Select<{kept(19)}, {compact_rank(19)}> as SelectOut>::Out
        20 => <Select<{kept(20)}, {compact_rank(20)}> as SelectOut>::Out
        21 => <Select<{kept(21)}, {compact_rank(21)}> as SelectOut>::Out
        22 => <Select<{kept(22)}, {compact_rank(22)}> as SelectOut>::Out
        23 => <Select<{kept(23)}, {compact_rank(23)}> as SelectOut>::Out
        24 => <Select<{kept(24)}, {compact_rank(24)}> as SelectOut>::Out
        25 => <Select<{kept(25)}, {compact_rank(25)}> as SelectOut>::Out
        26 => <Select<{kept(26)}, {compact_rank(26)}> as SelectOut>::Out
        27 => <Select<{kept(27)}, {compact_rank(27)}> as SelectOut>::Out
        28 => <Select<{kept(28)}, {compact_rank(28)}> as SelectOut>::Out
        29 => <Select<{kept(29)}, {compact_rank(29)}> as SelectOut>::Out
        30 => <Select<{kept(30)}, {compact_rank(30)}> as SelectOut>::Out
        31 => <Select<{kept(31)}, {compact_rank(31)}> as SelectOut>::Out
        _ => FindVector<0>
    }
}

struct Cardinality<const N: usize> {}
fn takes_cardinality5(_ value: Cardinality<5>) {}
fn exact_pruned_cardinality(value: Cardinality<{support_cardinality()}>) {
    takes_cardinality5(value)
}

fn takes_missing(_ value: Missing) {}
fn takes_found0(_ value: Found<0>) {}
fn takes_found1(_ value: Found<1>) {}
fn takes_found2(_ value: Found<2>) {}
fn takes_found3(_ value: Found<3>) {}
fn takes_found4(_ value: Found<4>) {}
fn scalar_is_pruned(value: FindVector<0>) { takes_missing(value) }
fn e1_rank(value: FindVector<1>) { takes_found0(value) }
fn e2_rank(value: FindVector<2>) { takes_found1(value) }
fn bivector_is_pruned(value: FindVector<3>) { takes_missing(value) }
fn e3_rank(value: FindVector<4>) { takes_found2(value) }
fn e4_rank(value: FindVector<8>) { takes_found3(value) }
fn e5_rank(value: FindVector<16>) { takes_found4(value) }
fn pseudoscalar_is_pruned(value: FindVector<31>) { takes_missing(value) }

struct Compact5 { c0: i32, c1: i32, c2: i32, c3: i32, c4: i32 }
struct SparseVector { compact: Compact5 }
trait Coefficient { fn read(value: Compact5) -> i32 }
impl Coefficient for Missing { fn read(value: Compact5) -> i32 { 0 } }
impl Coefficient for Found<0> { fn read(value: Compact5) -> i32 { value.c0 } }
impl Coefficient for Found<1> { fn read(value: Compact5) -> i32 { value.c1 } }
impl Coefficient for Found<2> { fn read(value: Compact5) -> i32 { value.c2 } }
impl Coefficient for Found<3> { fn read(value: Compact5) -> i32 { value.c3 } }
impl Coefficient for Found<4> { fn read(value: Compact5) -> i32 { value.c4 } }

#[inline(always)]
fn coefficient<const Blade: usize>(value: SparseVector) -> i32
    where FindVector<Blade>: Coefficient
{
    <FindVector<Blade> as Coefficient>::read(value: value.compact)
}

pub fn cl41_e5(c0: i32, c1: i32, c2: i32, c3: i32, c4: i32) -> i32 {
    coefficient<16>(
        value: SparseVector {
            compact: Compact5 { c0: c0, c1: c1, c2: c2, c3: c3, c4: c4 },
        },
    )
}

pub fn cl41_bivector_default_zero(
    c0: i32, c1: i32, c2: i32, c3: i32, c4: i32,
) -> i32 {
    coefficient<3>(
        value: SparseVector {
            compact: Compact5 { c0: c0, c1: c1, c2: c2, c3: c3, c4: c4 },
        },
    )
}
