// A projection whose impl passes its own parameter through
// (`type Buffer<T> = Store<T>`) substitutes the argument, and agrees with the
// computed type it is given. The `takes_nf` / `takes_dup` calls type-check only
// if the projection reduces to the written-out type.

struct Par {}
struct Pair {}
struct Comp<A, B> {
    a: A,
    b: B,
}

recursive type fn RBin<T, const N: usize>() -> (*) {
    match N {
        0 => Par
        _ => Comp<RBin<T, {N - 1}>, T>
    }
}

trait Backend {
    type Buffer<T>
}

struct Store<T> {
    t: T,
}

struct PairOf<A, B> {
    a: A,
    b: B,
}

struct EvmB {}
struct DupB {}

impl Backend for EvmB {
    type Buffer<T> = Store<T>
}

// The argument appears twice in the impl's type; both copies reduce to the same
// type.
impl Backend for DupB {
    type Buffer<T> = PairOf<T, T>
}

fn takes_nf(_ x: Store<Comp<Comp<Comp<Par, Pair>, Pair>, Pair>>) {}

// The projection `EvmB::Buffer<RBin<Pair, 3>>` must equal
// `Store<Comp<Comp<Comp<Par, Pair>, Pair>, Pair>>`.
fn confluence(x: EvmB::Buffer<RBin<Pair, 3>>) {
    takes_nf(x)
}

fn takes_dup(_ x: PairOf<Comp<Comp<Par, Pair>, Pair>, Comp<Comp<Par, Pair>, Pair>>) {}

fn dup(x: DupB::Buffer<RBin<Pair, 2>>) {
    takes_dup(x)
}
