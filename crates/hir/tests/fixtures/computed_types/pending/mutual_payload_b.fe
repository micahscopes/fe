// RD115 pending: both declaration orders must produce one stable cycle error.
// Same items as p23_mutual_payload_a.fe; only the declaration order of the two
// computed types and their uses is swapped.
struct Cell<const N: u256> {}
const fn size_beta() -> u256 { core::size_of<Beta<0>>() }
const fn size_alpha() -> u256 { core::size_of<Alpha<0>>() }
recursive type fn Beta<const N: usize>() -> (*) {
    match N {
        0 => Cell<{size_alpha()}>
        _ => Beta<{N - 1}>
    }
}
recursive type fn Alpha<const N: usize>() -> (*) {
    match N {
        0 => Cell<{size_beta()}>
        _ => Alpha<{N - 1}>
    }
}
fn use_beta(x: Beta<0>) -> Beta<0> { x }
fn use_alpha(x: Alpha<0>) -> Alpha<0> { x }
