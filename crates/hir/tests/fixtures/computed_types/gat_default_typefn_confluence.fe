// An impl that leaves out an associated type uses the trait's default, and a
// projection through that default reduces together with a computed type to the
// written-out type. The uses below type-check only if both reductions agree.

struct Par {}
struct Pair {}
struct Comp<A, B> {
    a: A,
    b: B,
}

struct Store<T> {
    t: T,
}

recursive type fn RBin<T, const N: usize>() -> (*) {
    match N {
        0 => Par
        _ => Comp<RBin<T, {N - 1}>, T>
    }
}

struct Evm {}

trait Backend {
    // A plain default; the computed type arrives as a concrete argument.
    type Cell<T> = Store<T>
    // A default whose body applies a computed type to the parameter; projecting
    // substitutes the argument and then computes the type.
    type Buffer<T> = Store<RBin<T, 3>>
}

// Leaves out both associated types, so both defaults apply.
impl Backend for Evm {}

// Default with a concrete computed argument: `Evm::Cell<RBin<Pair, 2>>` inherits
// `Store<T>` at `T = RBin<Pair, 2>` and unfolds the arg to
// `Store<Comp<Comp<Par, Pair>, Pair>>`.
fn takes_cell_nf(_ x: Store<Comp<Comp<Par, Pair>, Pair>>) {}
fn merged_ground_typefn(x: Evm::Cell<RBin<Pair, 2>>) {
    takes_cell_nf(x)
}

// Default whose body applies a computed type: `Evm::Buffer<Pair>` inherits
// `Store<RBin<T, 3>>` at `T = Pair` and unfolds to
// `Store<Comp<Comp<Comp<Par, Pair>, Pair>, Pair>>`.
fn takes_buffer_nf(_ x: Store<Comp<Comp<Comp<Par, Pair>, Pair>, Pair>>) {}
fn merged_symbolic_typefn(x: Evm::Buffer<Pair>) {
    takes_buffer_nf(x)
}
