        let __fe_ptr = __fe_data.ptr()
        let mut __fe_tail = <Self as core::abi::AbiRecord<2> >::LAYOUT.head_size
        __fe_tail = core::abi::encode_field_at<std::abi::Sol, bool>(__fe_field_0, __fe_ptr, head_pos: <Self as core::abi::AbiRecord<2> >::LAYOUT.offsets[0], tail: __fe_tail)
