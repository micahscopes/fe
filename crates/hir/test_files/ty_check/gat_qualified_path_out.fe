// mb2 D2 HEADLINE: qualified-path + chained GAT-arg lowering (lobe 1 + lobe 2)
// over the REAL multi-backend `Backend`. A standalone ty_check fixture, so the
// spellings run against the real `core::Backend` / `core::conal::Functor` and
// the real `std::evm::EvmBackend`, not test-local traits. Every leg is
// zero-diagnostic; the note-dump `.snap` records the observed normal forms.
//
// The D1 decl bound `type Buffer<T>: Functor<T>` on `core::Backend` means a
// symbolic `B::Buffer<X>` IS a `Functor<X>` from `B: Backend` ALONE, with NO
// consumer where-bound: the element-changed return names itself (lobe 1), the
// chained spelling resolves (lobe 2), and `.par_map` / `.map` dispatch (lobe 2
// method revival). Pre-D2 these were `3-0000`, `2-0002`, and `2-0010`.

use core::Fn
use core::Backend
use core::StorPtr
use std::conal::Functor
use std::evm::EvmBackend

// ---- Lobe 1: qualified path in return position, NO where-bound ----
// `<B::Buffer<X> as Functor<X>>::Out<Y>` previously DROPPED `<Y>` in the
// `QualifiedTy` fast-path and the `* -> *` head hit `3-0000 expected * kind`;
// now the tail arg lowers and applies to the well-kinded projection.
fn qual<B: Backend, X, Y, F: Fn<X, Y>>(_ buf: B::Buffer<X>, _ f: F)
    -> <B::Buffer<X> as Functor<X>>::Out<Y>
{
    todo()
}

// ---- Lobe 2: chained applied-GAT projection, NO where-bound ----
// `B::Buffer<X>::Out<Y>` (a `TyApp` with an `AssocTy` head) previously hit
// `2-0002 Out is not found`; now the decl bound `type Buffer<T>: Functor<T>` is
// revived (owner-exact remap of `T` to `X`) so `Out` resolves.
fn chained<B: Backend, X, Y, F: Fn<X, Y>>(_ buf: B::Buffer<X>, _ f: F)
    -> B::Buffer<X>::Out<Y>
{
    todo()
}

// ---- Lobe 2 (method revival): `.par_map`, NO where-bound ----
// Previously `2-0010 no method named par_map`; now the decl bound feeds method
// resolution. `out` is recorded as `B::Buffer<X>::Out<Y>`.
fn method_par_map<B: Backend, X, Y, F: Fn<X, Y>>(buf: B::Buffer<X>, _ f: F) {
    let out = buf.par_map<Y, F>(f)
}

// ---- Lobe 2 (method revival): `.map`, NO where-bound ----
fn method_map<B: Backend, X, Y, F: Fn<X, Y>>(buf: B::Buffer<X>, _ f: F) {
    let mapped = buf.map<Y, F>(f)
}

// ---- Concrete leg: the qualified spelling projects through the real EVM impl
//      (`EvmBackend::Buffer<T> = StorPtr<T>`, `StorPtr<X>: Functor<X>` with
//      `Out<Y> = StorPtr<Y>`), so `<EvmBackend::Buffer<u32> as Functor<u32>>
//      ::Out<u64>` is `StorPtr<u64>`, pinned by a `StorPtr<u64>` acceptor. ----
fn takes_storptr(_ x: StorPtr<u64>) {}

fn use_concrete(_ buf: EvmBackend::Buffer<u32>) {
    let out: <EvmBackend::Buffer<u32> as Functor<u32>>::Out<u64> = todo()
    takes_storptr(out)
}
