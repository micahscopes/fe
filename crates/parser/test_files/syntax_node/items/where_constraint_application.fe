// Boundless constraint-application where-predicates (`where Eq<T>`) must parse
// as `WherePredicate` nodes (a type, no bound list), distinct from both
// type-bound predicates (`T: Bounds`) and const-expression predicates. The
// discriminator is: a path whose FINAL segment has generic args, followed by a
// token that does not continue an expression.

// Single concrete constraint application.
fn one<T>() where Eq<T> {
}

// Multiple, comma-separated, mixed with a type-bound predicate.
fn many<T, U>() where T: Sized, Eq<T>, Ord<U> {
}

// Multi-segment trait path head.
fn pathed<T>() where core::ops::Eq<T> {
}

// Constraint application on a struct (terminator is the field list `{`).
struct Holder<T> where Eq<T> {
    inner: T
}

// Trait method declaration with no body: terminator is the next item / `}`.
trait Bounded {
    fn needs<T>() where Eq<T>
}

// LOOK-ALIKES that must STAY const-expression predicates, not constraint
// applications:
//   - bare ident flag (no generic args)
fn flag() where FLAG {
}
//   - generic call (generic args, but `(` continues the expression)
fn gen_call<T>() where T: Sized, above_threshold<T>() {
}
//   - associated-const comparison off a generic path (operator continues)
fn cmp<T>() where T: Sized, Holder<T>::SIZE >= 50 {
}
