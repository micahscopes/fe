// Pending: checker carries the selection through Foo -> Bar -> Baz, but executable callee validation loses it (16-0009). Shares the instance-side gap with evidence_named_only_method_pending.fe.
// Depth: the named choice must reach a bound two blanket impls down.
// Authority: a named impl's own condition and prerequisites still apply.
trait Foo { const fn v() -> u256 }
trait Bar { const fn w() -> u256 }
trait Baz { const fn z() -> u256 }
trait Gate {}
struct S {}
impl Foo for S as OnlyNamed { const fn v() -> u256 { 5 } }
impl<T: Foo> Bar for T { const fn w() -> u256 { T::v() } }
impl<T: Bar> Baz for T { const fn z() -> u256 { T::w() + 1 } }
const DEEP: u256 = with (OnlyNamed) { <S as Baz>::z() }
#[test]
fn deep_is_6() { assert(DEEP == 6) }
