pub trait Tick { fn tick(mut self, _ cost: u256) }
pub struct Count { pub n: u256 }
impl Tick for Count { fn tick(mut self, _ cost: u256) { self.n = self.n + cost } }
impl Tick for Count as Double { fn tick(mut self, _ cost: u256) { self.n = self.n + 2 * cost } }

fn f() uses (t: mut Tick) {
    t.tick(5)
    t.tick(3)
}
fn g<T: Tick>(_ t: mut T) {
    t.tick(5)
    t.tick(3)
}

#[test]
fn provider_plain() {
    let mut c = Count { n: 0 }
    with (Tick = c) { f() }
    assert!(c.n == 8)
}
#[test]
fn provider_with_named() {
    let mut c = Count { n: 0 }
    with (Double, Tick = c) { f() }
    assert!(c.n == 16)
}
#[test]
fn provider_with_named_nested() {
    let mut c = Count { n: 0 }
    with (Double) { with (Tick = c) { f() } }
    assert!(c.n == 16)
}
#[test]
fn generic_control() {
    let mut c = Count { n: 0 }
    with (Double) { g(mut c) }
    assert!(c.n == 16)
}
#[test]
fn direct_control() {
    let mut c = Count { n: 0 }
    with (Double) { c.tick(5) }
    assert!(c.n == 10)
}

#[test]
fn provider_choice_restores_after_nested_opening() {
    let mut c = Count { n: 0 }
    with (Tick = c) {
        f()
        with (Double) { f() }
        f()
    }
    assert!(c.n == 32)
}

pub struct OnlyCount { pub n: u256 }
impl Tick for OnlyCount as OnlyDouble {
    fn tick(mut self, _ cost: u256) { self.n = self.n + 2 * cost }
}
impl Tick for OnlyCount as OnlyTriple {
    fn tick(mut self, _ cost: u256) { self.n = self.n + 3 * cost }
}
fn forward() uses (t: mut Tick) { f() }

#[test]
fn named_only_keyed_provider() {
    let mut c = OnlyCount { n: 0 }
    with (OnlyDouble, Tick = c) { forward() }
    assert!(c.n == 16)
}
#[test]
fn named_only_unkeyed_provider() {
    let mut c = OnlyCount { n: 0 }
    with (OnlyDouble, c) { forward() }
    assert!(c.n == 16)
}
#[test]
fn named_only_nested_provider_restores() {
    let mut c = OnlyCount { n: 0 }
    with (OnlyDouble, Tick = c) {
        forward()
        with (OnlyTriple) { forward() }
        forward()
    }
    assert!(c.n == 56)
}
