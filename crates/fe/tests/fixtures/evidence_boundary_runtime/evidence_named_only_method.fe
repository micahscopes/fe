// H1d: a method of a trait whose only impl is named, called through opened evidence.
// Found while baselining h1a (existed before this batch): a method of a trait
// that has only a named impl for Subject, called directly in the block. Named
// spelling versus evidence spelling of the same provision.
use core::obligations::{Evidence, prove}
trait Foo { const fn v() -> u256 }
struct Subject {}
impl Foo for Subject as OnlyNamed { const fn v() -> u256 { 5 } }
const fn named_call() -> u256 { with (OnlyNamed) { <Subject as Foo>::v() } }
const fn evidence_call(_ e: Evidence<Foo<Subject>>) -> u256 { with (e) { <Subject as Foo>::v() } }
const N: u256 = named_call()
const E: u256 = evidence_call(with (OnlyNamed) { prove<Foo<Subject>>() })
#[test]
fn named_5() { assert(N == 5) }
#[test]
fn evidence_5() { assert(E == 5) }
