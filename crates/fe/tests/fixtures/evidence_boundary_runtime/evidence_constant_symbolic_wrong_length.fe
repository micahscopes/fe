// Minimal form of p04-p06. `x` is built with the bound's T::N (1 element); inside
// `with (e)` it is passed where the evidence's T::N (2) is expected. Base
// reported an internal error (normalized-body repack check); head accepts and
// the callee reports length 2 for a 1-element array.
use core::obligations::{Evidence, prove}
trait Width { const N: usize }
struct Subject {}
impl Width for Subject { const N: usize = 1 }
impl Width for Subject as Wide { const N: usize = 2 }
const fn len<T: Width>(_ x: [u256; T::N]) -> usize { T::N }
const fn cross_len<T: Width>(_ e: Evidence<Width<T>>, _ x: [u256; T::N]) -> usize {
    with (e) { len<T>(x) }
}
const LEN: usize = cross_len<Subject>(with (Wide) { prove<Width<Subject>>() }, [5])
#[test]
fn one_element_array_reported_as_length_2() { assert(LEN == 2) }
