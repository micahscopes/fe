// Layout twin, named spelling: a two-element array against a derived length
// that is 2 under `Wide`. Expected: ACCEPT, value 6.
use core::obligations::{Evidence, prove}
trait Width { const N: usize }
trait Derived { const M: usize }
struct Subject {}
struct Wrap<T> {}
impl Width for Subject { const N: usize = 1 }
impl Width for Subject as Wide { const N: usize = 2 }
impl<T: Width> Derived for Wrap<T> { const M: usize = T::N }
const fn f() -> u256 {
    with (Wide) {
        let y: [u256; <Wrap<Subject> as Derived>::M] = [5, 6]
        y[1]
    }
}
const F: u256 = f()
#[test]
fn value_6() { assert(F == 6) }
