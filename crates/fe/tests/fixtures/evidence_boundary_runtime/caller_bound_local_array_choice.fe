// Caller-bound selected extent must agree in repeat evaluation and runtime type.
// INTENT: Direct-constant control for i1g: a generic local array of length
// INTENT: U::N, no derived constant, the caller answers the bound with BigOther
// INTENT: (7 elements, index 6 holds 9). Shows whether the backend panic needs
// INTENT: a derived constant at all. Valid: the test passes.
trait Width { const N: usize }
struct Other {}
impl Width for Other { const N: usize = 5 }
impl Width for Other as BigOther { const N: usize = 7 }
fn direct_index<U: Width>(_ index: usize) -> u256 {
    let y: [u256; U::N] = [9; U::N]
    y[index]
}
#[test]
fn direct_big_6_is_9() { assert(with (BigOther) { direct_index<Other>(6) } == 9) }
