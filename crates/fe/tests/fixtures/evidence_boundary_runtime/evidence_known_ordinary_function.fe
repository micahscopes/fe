// RD103 Q9 admission: locally known witnesses in ordinary functions.
// Dynamic witness return and parameter transport remain in the pending fixtures.
use core::obligations::{Evidence, prove}
trait Read { const fn read() -> u256 }
struct Subject {}
impl Read for Subject { const fn read() -> u256 { 1 } }
impl Read for Subject as Alternative { const fn read() -> u256 { 2 } }
impl Read for Subject as Third { const fn read() -> u256 { 3 } }

fn read_known_choice() -> u256 {
    let selected = with (Alternative) { prove<Read<Subject>>() }
    with (selected) { <Subject as Read>::read() }
}
#[test]
fn ordinary_function_opens_its_known_choice() {
    assert(read_known_choice() == 2)
}
#[test]
fn copied_same_goal_values_keep_their_own_choices() {
    let ordinary = prove<Read<Subject>>()
    let selected = with (Alternative) { prove<Read<Subject>>() }
    let copy = selected
    let first = with (ordinary) { <Subject as Read>::read() }
    let second = with (selected) { <Subject as Read>::read() }
    let again = with (ordinary) { <Subject as Read>::read() }
    assert(first * 100 + second * 10 + again == 121)
    let first = with (copy) { <Subject as Read>::read() }
    let second = with (ordinary) { <Subject as Read>::read() }
    let again = with (selected) { <Subject as Read>::read() }
    assert(first * 100 + second * 10 + again == 212)
}
#[test]
fn nested_choice_restores_the_opened_known_value() {
    let ordinary = prove<Read<Subject>>()
    let selected = with (Alternative) { prove<Read<Subject>>() }
    let left = with (ordinary) {
        let before = <Subject as Read>::read()
        let inner = with (Third) { <Subject as Read>::read() }
        let after = <Subject as Read>::read()
        before * 100 + inner * 10 + after
    }
    let right = with (selected) {
        let before = <Subject as Read>::read()
        let inner = with (Third) { <Subject as Read>::read() }
        let after = <Subject as Read>::read()
        before * 100 + inner * 10 + after
    }
    assert(left == 131)
    assert(right == 232)
}
