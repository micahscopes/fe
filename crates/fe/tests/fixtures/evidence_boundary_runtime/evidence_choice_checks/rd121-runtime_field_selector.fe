use core::obligations::{Evidence, prove}
trait Read { const fn read() -> u256 }
struct Subject {}
impl Read for Subject { const fn read() -> u256 { 1 } }
fn read(_ pick: (bool, u256)) -> u256 { let e = if pick.0 { prove<Read<Subject>>() } else { prove<Read<Subject>>() }
with (e) { <Subject as Read>::read() } }
