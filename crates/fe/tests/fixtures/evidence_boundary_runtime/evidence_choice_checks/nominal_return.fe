use core::obligations::{Evidence, prove}
trait Read { const fn read() -> u256 }
struct Subject {}
impl Read for Subject { const fn read() -> u256 { 1 } }
impl Read for Subject as Alternative { const fn read() -> u256 { 2 } }
struct Capsule { evidence: Evidence<Read<Subject>> }
fn choose(_ selected: bool) -> Capsule { if selected { Capsule { evidence: with (Alternative) { prove<Read<Subject>>() } } } else { Capsule { evidence: prove<Read<Subject>>() } } }
