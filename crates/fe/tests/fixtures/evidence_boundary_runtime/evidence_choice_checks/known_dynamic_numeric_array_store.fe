use core::obligations::{Evidence, prove}
trait Read { const fn read() -> u256 }
struct Subject {}
impl Read for Subject { const fn read() -> u256 { 1 } }
impl Read for Subject as Alternative { const fn read() -> u256 { 2 } }
struct Capsule { evidence: Evidence<Read<Subject>>, numbers: [u256; 2] }
fn choose(_ selected: bool, _ index: usize) -> Capsule {
    let mut result = Capsule { evidence: prove<Read<Subject>>(), numbers: [0, 0] }
    if selected { result.numbers[index] = 1 } else { result.numbers[index] = 2 }
    result
}
