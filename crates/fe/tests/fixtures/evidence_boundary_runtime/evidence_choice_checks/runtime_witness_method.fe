use core::obligations::{Evidence, prove}
trait Read { const fn read() -> u256 }
struct Subject {}
impl Read for Subject { const fn read() -> u256 { 1 } }
impl Read for Subject as Alternative { const fn read() -> u256 { 2 } }
struct Capsule { evidence: Evidence<Read<Subject>>, number: u256 }
impl Capsule {
    fn update(mut self, _ selected: bool) {
        if selected { self.evidence = with (Alternative) { prove<Read<Subject>>() } }
    }
}
fn choose(_ selected: bool) -> Capsule {
    let mut result = Capsule { evidence: prove<Read<Subject>>(), number: 0 }
    result.update(selected)
    result
}
