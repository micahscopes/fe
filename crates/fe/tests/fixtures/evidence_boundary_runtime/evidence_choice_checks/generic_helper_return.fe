use core::obligations::{Evidence, prove}
trait Read { const fn read() -> u256 }
struct Subject {}
impl Read for Subject { const fn read() -> u256 { 1 } }
impl Read for Subject as Alternative { const fn read() -> u256 { 2 } }
fn pick<T>(_ selected: bool, _ first: T, _ second: T) -> T { if selected { first } else { second } }
fn choose(_ selected: bool) -> Evidence<Read<Subject>> { let first = prove<Read<Subject>>()
let second = with (Alternative) { prove<Read<Subject>>() }
pick<Evidence<Read<Subject>>>(selected, first, second) }
