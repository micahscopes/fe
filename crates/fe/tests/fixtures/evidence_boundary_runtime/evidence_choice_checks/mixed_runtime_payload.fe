use core::obligations::{Evidence, prove}
trait Read { const fn read() -> u256 }
struct Subject {}
impl Read for Subject { const fn read() -> u256 { 1 } }
struct Capsule { evidence: Evidence<Read<Subject>>, number: u256 }
fn choose(_ selected: bool, _ number: u256) -> Capsule {
    if selected { Capsule { evidence: prove<Read<Subject>>(), number } }
    else { Capsule { evidence: prove<Read<Subject>>(), number: number + 1 } }
}
