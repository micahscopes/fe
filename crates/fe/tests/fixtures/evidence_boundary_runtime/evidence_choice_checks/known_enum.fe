use core::obligations::{Evidence, prove}
trait Read { const fn read() -> u256 }
struct Subject {}
impl Read for Subject { const fn read() -> u256 { 1 } }
impl Read for Subject as Alternative { const fn read() -> u256 { 2 } }
enum Choice { Ordinary, Alternative }
const fn pick() -> Choice { Choice::Alternative }
fn choose() -> Evidence<Read<Subject>> { match pick() { Choice::Alternative => with (Alternative) { prove<Read<Subject>>() }, Choice::Ordinary => prove<Read<Subject>>() } }
