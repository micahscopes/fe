use core::obligations::{Evidence, prove}
trait Read { const fn read() -> u256 }
struct Subject {}
impl Read for Subject { const fn read() -> u256 { 1 } }
const fn pick(_ selected: bool) -> Evidence<Read<Subject>> { if selected { prove<Read<Subject>>() } else { prove<Read<Subject>>() } }
fn read(_ selected: bool) -> u256 { let e = pick(selected)
with (e) { <Subject as Read>::read() } }
