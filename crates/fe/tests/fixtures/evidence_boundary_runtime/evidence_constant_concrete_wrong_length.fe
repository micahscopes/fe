// A value formed under the ordinary provision cannot cross into an opening
// that requires a different array length. Expect a frontend type mismatch.
use core::obligations::{Evidence, prove}
trait Width { const N: usize }
struct Subject {}
impl Width for Subject { const N: usize = 1 }
impl Width for Subject as Wide { const N: usize = 2 }
const fn len<T: Width>(_ x: [u256; T::N]) -> usize { T::N }
const fn cross_len(_ e: Evidence<Width<Subject>>, _ x: [u256; Subject::N]) -> usize {
    with (e) { len<Subject>(x) }
}
const LEN: usize = cross_len(with (Wide) { prove<Width<Subject>>() }, [5])
#[test]
fn ordinary_array_cannot_cross_into_wide_opening() { assert(LEN == 2) }
