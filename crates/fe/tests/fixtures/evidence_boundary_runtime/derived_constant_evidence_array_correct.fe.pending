// Pending: a concrete array literal cannot yet match an opened-evidence symbolic length.
// Direct Width::N has the same rejection on accepted c31; see DERIVED_CONST_EVIDENCE_FINDING_2026-10-10.md.
// Layout twin, evidence spelling: a two-element array against a derived length
// that is 2 under evidence carrying `Wide`. Expected: ACCEPT, value 6.
use core::obligations::{Evidence, prove}
trait Width { const N: usize }
trait Derived { const M: usize }
struct Subject {}
struct Wrap<T> {}
impl Width for Subject { const N: usize = 1 }
impl Width for Subject as Wide { const N: usize = 2 }
impl<T: Width> Derived for Wrap<T> { const M: usize = T::N }
const fn f() -> u256 {
    let e = with (Wide) { prove<Width<Subject>>() }
    with (e) {
        let y: [u256; <Wrap<Subject> as Derived>::M] = [5, 6]
        y[1]
    }
}
const F: u256 = f()
#[test]
fn value_6() { assert(F == 6) }
