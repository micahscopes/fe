// p10: the worktree has uncommitted edits (RD111 fix: StorageMap::set and StorPtr::write
// now need `uses (storage: mut RawStorage)`). Binary built 20:59 includes them. Check the
// ordinary contract pattern still works: a recv arm with `uses (mut balances)` writes a
// StorageMap field, and a free helper that takes the map mutably writes it.
// Expected: accepted, test passes (as on master).
use std::evm::*
msg M {
    #[selector = 0x01]
    Put { k: u256, v: u256 } -> u256,
}
fn helper(_ k: u256, _ v: u256) uses (balances: mut StorageMap<u256, u256>) {
    let mut copy = balances
    copy.set(key: k, value: v)
}
pub contract C {
    mut balances: StorageMap<u256, u256>,
    recv M {
        Put { k, v } -> u256 uses (mut balances) {
            balances.set(key: k, value: v)
            helper(k + 1, v)
            balances.get(k + 1)
        }
    }
}
#[test]
fn t() uses (evm: mut Evm) {
    let c = evm.create2<C>(value: 0, args: (), salt: 1)
    let r: u256 = evm.call(addr: c, gas: 1000000, value: 0, message: M::Put { k: 3, v: 7 })
    assert!(r == 7)
}

fn peek_storage(_ slot: u256) -> u256 uses (evm: Evm) {
    let pointer: StorPtr<u256> = evm.stor_ptr(slot)
    pointer.read()
}

fn peek_transient(_ slot: u256) -> u256 uses (evm: Evm) {
    let pointer: TStorPtr<u256> = evm.tstor_ptr(slot)
    pointer.read()
}

#[test]
fn copied_persistent_pointer_writes_with_the_capability() uses (evm: mut Evm) {
    let pointer: StorPtr<u256> = evm.stor_ptr(23)
    let copy = pointer
    with (RawStorage = evm) { copy.write(99) }
    assert!(peek_storage(23) == 99)
}

#[test]
fn copied_transient_pointer_writes_with_the_capability() uses (evm: mut Evm) {
    let pointer: TStorPtr<u256> = evm.tstor_ptr(29)
    let copy = pointer
    copy.write(77)
    assert!(peek_transient(29) == 77)
}
