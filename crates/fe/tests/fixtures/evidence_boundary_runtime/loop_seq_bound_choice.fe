use core::seq::Seq

struct Three {}
impl Seq for Three {
    type Item = u256
    fn len(self) -> usize { 3 }
    fn get(self, _ i: usize) -> u256 { i as u256 }
}
impl Seq for Three as Two {
    type Item = u256
    fn len(self) -> usize { 2 }
    fn get(self, _ i: usize) -> u256 { (i as u256) + 10 }
}
fn sum<T: Seq<Item = u256>>(_ t: T) -> u256 {
    let mut result: u256 = 0
    for x in t { result += x }
    result
}
#[test]
fn loop_reads_the_callers_bound_choice() {
    assert(sum(Three {}) == 3)
    assert(with (Two) { sum(Three {}) } == 21)
}

// Pending with the generic Seq loop migration: preserve the caller's Item width.
struct ByteValues {}
impl Seq for ByteValues {
    type Item = u8
    fn len(self) -> usize { 1 }
    fn get(self, _ i: usize) -> u8 { 1 }
}
impl Seq for ByteValues as NarrowSeq {
    type Item = u8
    fn len(self) -> usize { 1 }
    fn get(self, _ i: usize) -> u8 { 200 }
}
fn sum_bytes<T: Seq<Item = u8>>(_ values: T) -> u8 {
    let mut total: u8 = 0
    for x in values { total += x }
    total
}
#[test]
fn loop_keeps_the_callers_u8_item() {
    assert(sum_bytes(ByteValues {}) == 1)
    assert(with (NarrowSeq) { sum_bytes(ByteValues {}) } == 200)
}
