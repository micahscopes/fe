use core::meta::{FunctionEmission, ScalarBody, ScalarOp, record_field_count}
struct Packet { sequence: u256, ready: bool }
const fn author() -> FunctionEmission<ScalarBody<bool, 3>> {
    FunctionEmission { target: 23, value: ScalarBody {
        nodes: [ScalarOp::U256Parameter(0),
                ScalarOp::U256(record_field_count<Packet>() * 8),
                ScalarOp::Less(0, 1)],
        result: 2,
    } }
}
