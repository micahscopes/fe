// Target: Q6 (QUOTATION_DESIGN slice Q6, RD79 (1)). A quoted enum equality over unit, tuple and record variants runs and agrees with a hand-written twin.
// Oracle: values from mb2 `derived_eq_default_enum.fe` (VERIFIED by twins in PARITY_FIXTURE_AUDIT_2026-09-28) and twin `ShapeH`.
// Placeholders: RD79 fixes only `binders(v, n)`, `${lhs}` in a pattern and `${lhs.at(f)}`. The reflection names
//   (`variant_count`, `variant`, `variant_field_count`, `variant_field`), the `Arm` kind and the arm-list fold are
//   modeled on `field_count`/`field` and mb2's fold; rename to whatever Q6 lands.
use core::ops::Eq

mod author {
    use core::ops::Eq
    use core::meta::{Arm, Code, Expr, Item, Record, binders, empty, variant, variant_count, variant_field, variant_field_count}

    pub const fn enum_eq(record: Record) -> Code<Item> {
        let mut arms = empty<Arm>()
        let mut i: usize = 0
        while i < variant_count(record) {
            let v = variant(record, i)
            let lhs = binders(v, 0)
            let rhs = binders(v, 1)
            let mut cmp: Code<Expr> = quote { true }
            let mut j: usize = 0
            while j < variant_field_count(v) {
                let f = variant_field(v, j)
                cmp = quote { ${cmp} && ${lhs.at(f)} == ${rhs.at(f)} }
                j += 1
            }
            arms = quote(other) {
                ${arms}
                ${lhs} => match other {
                    ${rhs} => ${cmp}
                    _ => false
                }
            }
            i += 1
        }
        quote {
            impl Eq for ${record} {
                fn eq(self, _ other: Self) -> bool { match self { ${arms} } }
            }
        }
    }
}

#[generate(ingot::author::enum_eq)]
enum Direction {
    North,
    South,
    East,
    West,
}

#[generate(ingot::author::enum_eq)]
enum Shape {
    Circle(u256),
    Rect { w: u256, h: u256 },
    Empty,
}

enum ShapeH {
    Circle(u256),
    Rect { w: u256, h: u256 },
    Empty,
}

impl Eq for ShapeH {
    fn eq(self, _ other: Self) -> bool {
        match self {
            ShapeH::Circle(a) => match other {
                ShapeH::Circle(b) => true && a == b
                _ => false
            }
            ShapeH::Rect { w, h } => match other {
                ShapeH::Rect { w: w2, h: h2 } => true && w == w2 && h == h2
                _ => false
            }
            ShapeH::Empty => match other {
                ShapeH::Empty => true
                _ => false
            }
        }
    }
}

#[test]
fn unit_variants() {
    assert!(Direction::North == Direction::North)
    assert!(Direction::North != Direction::South)
    assert!(!Direction::East.eq(Direction::West))
}

#[test]
fn payload_variants_match_twin() {
    assert!(Shape::Circle(5) == Shape::Circle(5))
    assert!(Shape::Circle(5) != Shape::Circle(6))
    let r1 = Shape::Rect { w: 2, h: 3 }
    let r2 = Shape::Rect { w: 2, h: 3 }
    let r3 = Shape::Rect { w: 2, h: 4 }
    assert!(r1 == r2)
    let r4 = Shape::Rect { w: 2, h: 3 }
    assert!(r4 != r3)
    assert!(Shape::Circle(0) != Shape::Empty)
    assert!(ShapeH::Circle(5) == ShapeH::Circle(5))
    let h1 = ShapeH::Rect { w: 2, h: 3 }
    let h2 = ShapeH::Rect { w: 2, h: 4 }
    assert!(h1 != h2)
    assert!(ShapeH::Circle(0) != ShapeH::Empty)
}
