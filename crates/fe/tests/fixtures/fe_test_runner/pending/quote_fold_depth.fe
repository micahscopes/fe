// Target: F2 (MB3_QUOTE_HUNT_2026-09-28). Left folds of 64, 65 and 200 expression fragments are accepted and evaluate correctly.
// Oracle: independently computed sums (n additions of 1 to 0 give n); the 1,000-node transplant budget, not a depth of 64, is the limit.
mod author {
    use core::meta::{Code, Expr, Item, Record}

    const fn fold(_ n: u256) -> Code<Expr> {
        let mut acc: Code<Expr> = quote { 0 }
        let mut i: u256 = 0
        while i < n {
            acc = quote { ${acc} + 1 }
            i += 1
        }
        acc
    }

    pub const fn emit64(_ record: Record) -> Code<Item> {
        quote { pub fn total64() -> u256 { ${fold(64)} } }
    }

    pub const fn emit65(_ record: Record) -> Code<Item> {
        quote { pub fn total65() -> u256 { ${fold(65)} } }
    }

    pub const fn emit200(_ record: Record) -> Code<Item> {
        quote { pub fn total200() -> u256 { ${fold(200)} } }
    }
}

#[generate(ingot::author::emit64)]
struct T64 {}

#[generate(ingot::author::emit65)]
struct T65 {}

#[generate(ingot::author::emit200)]
struct T200 {}

#[test]
fn folds_past_depth_64_evaluate() {
    assert!(total64() == 64)
    assert!(total65() == 65)
    assert!(total200() == 200)
}
