// Target: RD84 (1) (DERIVE_USE_SITE_DESIGN section 5). One deriver type with two `Derive<_>` impls serves each trait it derives.
// Oracle: hand-computed values (field count 2; field-by-field equality).
use core::ops::Eq
use core::derive::Derive
use core::meta::{Code, Expr, Item, Record, Where, empty, field, field_count, field_type}

pub trait FieldCount {
    const N: usize
}

// Stable: one deriver type for two traits.
pub struct Stable {}

impl Derive<Eq> for Stable {
    const fn derive(_ record: Record) -> Code<Item> {
        let mut body: Code<Expr> = quote { true }
        let mut bounds = empty<Where>()
        let mut i: usize = 0
        while i < field_count(record) {
            let f = field(record, i)
            body = quote(other) { ${body} && self.${f} == other.${f} }
            bounds = quote { where ${bounds}, ${field_type(f)}: Eq }
            i += 1
        }
        quote { impl Eq for ${record} where ${bounds} { fn eq(self, _ other: Self) -> bool { ${body} } } }
    }
}

impl Derive<FieldCount> for Stable {
    const fn derive(_ record: Record) -> Code<Item> {
        let n = field_count(record)
        quote { impl FieldCount for ${record} { const N: usize = ${n} } }
    }
}

pub struct Point { pub x: u256, pub y: u256 }

impl Eq for Point with (Stable)

impl FieldCount for Point with (Stable)

fn same<T: Eq>(_ a: T, _ b: T) -> bool { a == b }

fn pt(_ x: u256, _ y: u256) -> Point { Point { x, y } }

#[test]
fn one_deriver_two_traits() {
    assert!(same(pt(1, 2), pt(1, 2)) && !same(pt(1, 2), pt(2, 2)))
    assert!(<Point as FieldCount>::N == 2)
}
