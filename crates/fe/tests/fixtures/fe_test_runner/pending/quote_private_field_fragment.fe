// Target: F3 / RD83 (2). A private provider field read inside a spliced expression fragment is accepted.
// Oracle: the hand-written twin `author::twin` returns the same value (7 + 1).
// Position: nested `Code<Expr>` fragment spliced into a method body.
trait Read {
    fn get(self) -> u256
}

mod author {
    use core::meta::{Code, Expr, Item, Record}

    pub struct Counter { value: u256 }

    fn make() -> Counter { Counter { value: 7 } }

    pub const fn emit(record: Record) -> Code<Item> {
        let read: Code<Expr> = quote { make().value }
        quote {
            impl ingot::Read for ${record} {
                fn get(self) -> u256 { ${read} + 1 }
            }
        }
    }

    pub fn twin() -> u256 { make().value + 1 }
}

#[generate(ingot::author::emit)]
struct Target {}

#[test]
fn generated_matches_twin() {
    assert!(author::twin() == 8)
    assert!(Target {}.get() == author::twin())
}
