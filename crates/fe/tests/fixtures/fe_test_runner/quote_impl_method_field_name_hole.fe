trait Value {
    fn value(self) -> u256
}

mod author {
    use core::meta::{Code, Item, Record, field}

    pub const fn emit(record: Record) -> Code<Item> {
        let selected = field(record, 0)
        quote {
            impl ingot::Value for ${record} {
                fn ${selected}(self) -> u256 { self.${selected} }
            }
        }
    }
}

#[generate(ingot::author::emit)]
struct Target { value: u256 }

#[test]
fn quoted_field_name_runs() {
    assert!(Target { value: 17 }.value() == 17)
}
