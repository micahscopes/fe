// Target: O4 (MB3_QUOTE_HUNT_2026-09-28). A for loop over an array field in a quoted body is accepted.
// Oracle: hand-written twin type `H` with the same method body; both give the value by hand in the test.
trait Work {
    fn work(self, _ k: u256) -> u256
}

mod author {
    use core::meta::{Code, Item, Record, field}

    pub const fn emit(record: Record) -> Code<Item> {
        let a = field(record, 0)
        quote {
            impl ingot::Work for ${record} {
                fn work(self, _ k: u256) -> u256 {
                    let mut sum: u256 = k
                    for v in self.${a} {
                        sum += v
                    }
                    sum
                }
            }
        }
    }
}

#[generate(ingot::author::emit)]
struct G { a: [u256; 3] }

struct H { a: [u256; 3] }

impl Work for H {
    fn work(self, _ k: u256) -> u256 {
        let mut sum: u256 = k
        for v in self.a {
            sum += v
        }
        sum
    }
}

#[test]
fn generated_matches_twin() {
    assert!(H { a: [1, 2, 3] }.work(4) == 10)
    assert!(G { a: [1, 2, 3] }.work(4) == (H { a: [1, 2, 3] }).work(4))
}
