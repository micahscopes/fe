trait Number {
    const VALUE: u256
}

mod author {
    use core::meta::{Code, Item, Record}

    pub const fn emit(record: Record) -> Code<Item> {
        quote {
            impl ingot::Number for ${record} {
                const VALUE: u256 = ${7 as u256}
            }
        }
    }
}

#[generate(ingot::author::emit)]
struct Target {}

#[test]
fn quoted_impl_const_runs() {
    assert!(Target::VALUE == 7)
}
