mod author {
    use core::meta::{Code, DeclarationName, Item, Record}

    pub const fn emit(_ record: Record) -> Code<Item> {
        let name = DeclarationName::Literal("answer")
        quote {
            pub fn ${name}() -> u256 { 43 }
        }
    }
}

#[generate(ingot::author::emit)]
struct Target {}

#[test]
fn quoted_function_name_runs() {
    assert!(answer() == 43)
}
