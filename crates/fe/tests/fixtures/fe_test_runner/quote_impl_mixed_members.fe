trait Combined {
    type Out
    const VALUE: u256
    fn get(self) -> u256
}

mod author {
    use core::meta::{Code, Item, Record, field}

    pub const fn emit(record: Record) -> Code<Item> {
        let selected = field(record, 0)
        quote {
            impl ingot::Combined for ${record} {
                type Out = u256
                const VALUE: u256 = ${7 as u256}
                fn get(self) -> u256 { self.${selected} }
            }
        }
    }
}

#[generate(ingot::author::emit)]
struct Target { value: u256 }

fn answer() -> Target::Out { 43 }

#[test]
fn quoted_impl_mixed_members_run() {
    assert!(Target { value: 42 }.get() == 42)
    assert!(Target::VALUE == 7)
    assert!(answer() == 43)
}
