trait Positive {
    fn value<const N: usize>(self) -> usize where N > 0
}

mod author {
    use core::meta::{Code, Item, Record}

    pub const fn emit(record: Record) -> Code<Item> {
        quote {
            impl ingot::Positive for ${record} {
                fn value<const N: usize>(self) -> usize where N > 0 { N }
            }
        }
    }
}

#[generate(ingot::author::emit)]
struct Target { value: u256 }

#[test]
fn quoted_const_where_rejects_zero() {
    assert!(Target { value: 1 }.value<0>() == 0)
}
