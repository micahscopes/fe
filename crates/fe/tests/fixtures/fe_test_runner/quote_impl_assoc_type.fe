trait Family {
    type Out
}

mod author {
    use core::meta::{Code, Item, Record}

    pub const fn emit(record: Record) -> Code<Item> {
        quote {
            impl ingot::Family for ${record} {
                type Out = u256
            }
        }
    }
}

#[generate(ingot::author::emit)]
struct Target {}

fn answer() -> Target::Out { 43 }

#[test]
fn quoted_impl_assoc_type_runs() {
    assert!(answer() == 43)
}
