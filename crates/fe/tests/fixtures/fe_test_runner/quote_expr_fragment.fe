mod author {
    use core::meta::{Code, Expr, Item, Record}

    pub const fn emit(_ record: Record) -> Code<Item> {
        let seed: Code<Expr> = quote { 40 }
        let value: Code<Expr> = quote { ${seed} + 2 }
        quote {
            pub fn answer() -> u256 { ${value} }
        }
    }
}

#[generate(ingot::author::emit)]
struct Target {}

#[test]
fn composed_expression_runs() {
    assert!(answer() == 42)
}
