mod author {
    use core::meta::{Code, Item, Record, field, field_type}

    pub const fn emit(record: Record) -> Code<Item> {
        let selected = field(record, 0)
        let result = field_type(selected)
        quote {
            pub fn read(input: ${record}) -> ${result} { input.${selected} }
        }
    }
}

#[generate(ingot::author::emit)]
struct Target<Payload: Copy> { value: (Payload, (Payload, bool)) }

#[test]
fn quoted_generic_composite_accessor_keeps_both_elements() {
    let value = read(input: Target<u256> { value: (7, (11, true)) })
    assert!(value.0 == 7)
    assert!(value.1.0 == 11)
    assert!(value.1.1)
}
