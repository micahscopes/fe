trait Tag {}

trait Relay {
    fn relay<Payload: ingot::author::Tag>(self, value: own Payload) -> Payload
}

mod author {
    use core::meta::{Code, Item, Record}

    pub trait Tag {}
    impl Tag for bool {}

    pub const fn emit(record: Record) -> Code<Item> {
        quote {
            impl ingot::Relay for ${record} {
                fn relay<Payload: Tag>(self, value: own Payload) -> Payload { value }
            }
        }
    }
}

#[generate(ingot::author::emit)]
struct Target { value: u256 }

#[test]
fn quoted_method_bound_ignores_output_shadow() {
    assert!(Target { value: 1 }.relay<bool>(value: true))
}
