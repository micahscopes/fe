// Q6: a 70-arm fold uses empty and splice-only Code<Arm> composition.
trait Tagged { fn ordinal(self) -> usize }
mod author {
    use core::meta::{Arm, Code, Item, Record, binders, empty, variant, variant_count}
    pub const fn ordinal(record: Record) -> Code<Item> {
        let mut arms = empty<Arm>()
        let mut i: usize = 0
        while i < variant_count(record) {
            let group = binders(variant(record, i), 0)
            let one: Code<Arm> = quote { ${group} => ${i} }
            let nothing = empty<Arm>()
            arms = quote {
                ${arms}
                ${nothing}
                ${one}
            }
            i += 1
        }
        quote {
            impl ingot::Tagged for ${record} {
                fn ordinal(self) -> usize { match self { ${arms} } }
            }
        }
    }
}
#[generate(ingot::author::ordinal)]
enum Many {
    V0,
    V1,
    V2,
    V3,
    V4,
    V5,
    V6,
    V7,
    V8,
    V9,
