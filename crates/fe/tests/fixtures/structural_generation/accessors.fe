
mod authors {
    use core::meta::{Code, Item, empty, Record, FieldType, field_count, field, field_type, type_is, DeclarationName}
    trait Select: Copy { const fn include(self, _ ty: FieldType) -> bool }
    struct All {}
    struct Flags {}
    impl Copy for All {}
    impl Copy for Flags {}
    impl Select for All { const fn include(self, _ ty: FieldType) -> bool { true } }
    impl Select for Flags { const fn include(self, _ ty: FieldType) -> bool { type_is<bool>(ty) } }
    const fn generate(_ record: Record) -> Code<Item> uses (policy: Select) {
        let mut items = empty<Item>()
        let mut i: usize = 0
        while i < field_count(record) {
            let f = field(record, i)
            if policy.include(field_type(f)) {
                let name = DeclarationName::FieldPrefix("get_", f)
                let ty = field_type(f)
                items = quote {
                    ${items}
                    pub fn ${name}(_ value: ${record}) -> ${ty} { value.${f} }
                }
            }
            i += 1
        }
        items
    }
    pub const fn all(_ record: Record) -> Code<Item> {
        with (Select = All {}) { generate(record) }
    }
    pub const fn flags(_ record: Record) -> Code<Item> {
        with (Select = Flags {}) { generate(record) }
    }
}
mod owner {
    #[generate(ingot::authors::all)]
    pub struct Packet { nonce: u256, ready: bool, code: u64 }
    pub fn sample() -> Packet { Packet { nonce: 42, ready: true, code: 258 } }
}

mod flags {
    #[generate(ingot::authors::flags)]
    pub struct Packet { code: u64, ready: bool, nonce: u256 }
    pub fn sample() -> Packet { Packet { code: 9, ready: false, nonce: 123 } }
}
mod empty {
    #[generate(ingot::authors::all)]
    struct Empty {}
}
#[test]
fn all_accessors_execute() {
    assert!(owner::get_nonce(owner::sample()) == 42)
    assert!(owner::get_ready(owner::sample()))
    assert!(owner::get_code(owner::sample()) == 258)
}
#[test]
fn selected_accessor_executes() {
    assert!(!flags::get_ready(flags::sample()))
}
msg AccessorMessage {
    #[selector = 0x12345678]
    Code -> u256,
}
pub contract AccessorContract {
    recv AccessorMessage {
        Code -> u256 { return owner::get_code(owner::sample()) as u256 }
    }
}
