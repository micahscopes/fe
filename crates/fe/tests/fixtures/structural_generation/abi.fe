mod authors {
    use core::abi::{AbiSize, AbiRecordLayout, abi_record_layout, abi_field_head_size}
    use core::meta::{Code, Item, empty, Record, FieldType, FieldQuery, query_field, field_count, field, field_type,
        DeclarationName}

    struct Head<T> {}
    impl<T: AbiSize> FieldQuery<u256> for Head<T> {
        const fn evaluate() -> u256 { abi_field_head_size<T>() }
    }
    struct Dynamic<T> {}
    impl<T: AbiSize> FieldQuery<bool> for Dynamic<T> {
        const fn evaluate() -> bool { <T as AbiSize>::IS_DYNAMIC }
    }
    const fn head(_ ty: FieldType) -> u256 {
        query_field<Head, u256>(ty)
    }
    const fn dynamic(_ ty: FieldType) -> bool {
        query_field<Dynamic, bool>(ty)
    }
    const fn layout(_ record: Record) -> AbiRecordLayout<32> {
        assert!(field_count(record) <= 32)
        let mut sizes: [u256; 32] = [0; 32]
        let mut i: usize = 0
        while i < field_count(record) {
            sizes[i] = head(field_type(field(record, i)))
            i += 1
        }
        abi_record_layout(sizes)
    }
    pub const fn size(_ record: Record) -> Code<Item> {
        let mut is_dynamic = false
        let mut i: usize = 0
        while i < field_count(record) {
            let f = field(record, i)
            is_dynamic = is_dynamic || dynamic(field_type(f))
            i += 1
        }
        let head_size = layout(record).head_size
        quote {
            impl core::abi::AbiSize for ${record} {
                const HEAD_SIZE: u256 = ${head_size}
                const IS_DYNAMIC: bool = ${is_dynamic}
            }
        }
    }
    pub const fn offsets(_ record: Record) -> Code<Item> {
        let plan = layout(record)
        let mut items = empty<Item>()
        let mut i: usize = 0
        while i < field_count(record) {
            let name = DeclarationName::FieldPrefix("offset_", field(record, i))
            let offset = plan.offsets[i]
            items = quote {
                ${items}
                pub const fn ${name}() -> u256 { ${offset} }
            }
            i += 1
        }
        items
    }
    fn encode_sol<T>(_ value: own T, ptr: *u8, head_pos: u256, tail: u256) -> u256
        where T: core::abi::Encode<std::abi::Sol> + AbiSize
    {
        core::abi::encode_field_at<std::abi::Sol, T>(value, ptr, head_pos: head_pos, tail)
    }
    pub const fn encoder(_ record: Record) -> Code<Item> {
        let plan = layout(record)
        let head_size = plan.head_size
        let mut body: Code<core::meta::Expr> = quote { }
        let mut i: usize = 0
        while i < field_count(record) {
            let f = field(record, i)
            assert!(!dynamic(field_type(f)))
            let offset = plan.offsets[i]
            body = quote(ptr) {
                ${body}
                ingot::authors::encode_sol(self.${f}, ptr, head_pos: ${offset}, tail: ${head_size})
            }
            i += 1
        }
        quote {
            impl core::abi::Encode<std::abi::Sol> for ${record} {
                fn encode(own self, _ ptr: *u8) -> () { ${body} }
            }
        }
    }
}

mod empty {
    #[generate(ingot::authors::size)]
    #[generate(ingot::authors::encoder)]
    #[generate(ingot::authors::offsets)]
    pub struct Empty {}
    pub fn sample() -> Empty { Empty {} }
}
mod single {
    #[generate(ingot::authors::size)]
    #[generate(ingot::authors::encoder)]
    #[generate(ingot::authors::offsets)]
    pub struct Single { value: u256 }
    pub fn sample() -> Single { Single { value: 42 } }
}
mod packet {
    #[generate(ingot::authors::size)]
    #[generate(ingot::authors::encoder)]
    #[generate(ingot::authors::offsets)]
    pub struct Packet { nonce: u256, ready: bool, code: u64 }
    pub fn sample() -> Packet { Packet { nonce: 42, ready: true, code: 258 } }
}
mod reordered {
    #[generate(ingot::authors::size)]
    #[generate(ingot::authors::encoder)]
    #[generate(ingot::authors::offsets)]
    pub struct Reordered { code: u64, active: bool, identifier: u256 }
    pub fn sample() -> Reordered { Reordered { code: 258, active: false, identifier: 42 } }
}

use core::abi::{AbiSize, ByteInput, encode_alloc}
use std::abi::Sol

// Independent exact payload oracles: each raw 256-bit load covers all 32 bytes,
// including leading zeros. No decoder or generated offset computes expectations.
#[test]
fn empty_payload() {
    assert!(<empty::Empty as AbiSize>::HEAD_SIZE == 0)
    assert!(!<empty::Empty as AbiSize>::IS_DYNAMIC)
    let encoded = encode_alloc<Sol, empty::Empty>(empty::sample())
    assert!(encoded.len() == 0)
}
#[test]
fn single_payload() {
    assert!(<single::Single as AbiSize>::HEAD_SIZE == 32)
    assert!(!<single::Single as AbiSize>::IS_DYNAMIC)
    assert!(single::offset_value() == 0)
    let encoded = encode_alloc<Sol, single::Single>(single::sample())
    assert!(encoded.len() == 32)
    assert!(encoded.span().word_at(0) == 42)
}
#[test]
fn heterogeneous_payload() {
    assert!(<packet::Packet as AbiSize>::HEAD_SIZE == 96)
    assert!(!<packet::Packet as AbiSize>::IS_DYNAMIC)
    assert!(packet::offset_nonce() == 0)
    assert!(packet::offset_ready() == 32)
    assert!(packet::offset_code() == 64)
    let encoded = encode_alloc<Sol, packet::Packet>(packet::sample())
    assert!(encoded.len() == 96)
    assert!(encoded.span().word_at(0) == 42)
    assert!(encoded.span().word_at(32) == 1)
    assert!(encoded.span().word_at(64) == 258)
}
#[test]
fn reordered_payload() {
    assert!(<reordered::Reordered as AbiSize>::HEAD_SIZE == 96)
    assert!(!<reordered::Reordered as AbiSize>::IS_DYNAMIC)
    assert!(reordered::offset_code() == 0)
    assert!(reordered::offset_active() == 32)
    assert!(reordered::offset_identifier() == 64)
    let encoded = encode_alloc<Sol, reordered::Reordered>(reordered::sample())
    assert!(encoded.len() == 96)
    assert!(encoded.span().word_at(0) == 258)
    assert!(encoded.span().word_at(32) == 0)
    assert!(encoded.span().word_at(64) == 42)
}

msg AbiMessage {
    #[selector = 0x12345678]
    Code -> u256,
}
pub contract AbiContract {
    recv AbiMessage {
        Code -> u256 {
            let encoded = encode_alloc<Sol, packet::Packet>(packet::sample())
            return encoded.span().word_at(64)
        }
    }
}
