struct Item {}
trait Pick { fn value() -> u256 }
impl Pick for Item { fn value() -> u256 { 100 } }
impl Pick for Item as Discount { fn value() -> u256 { 70 } }
fn apply<F: Fn() -> u256>(_ f: F) -> u256 uses F::E { f() }
fn relay<T: Pick>() -> u256 {
    let f = || T::value()
    apply(f)
}
trait Price { fn amount(self) -> u256 }
impl Price for Item { fn amount(self) -> u256 { 100 } }
impl Price for Item as Wholesale { fn amount(self) -> u256 { 70 } }
fn charge() -> u256 uses (p: Price) { p.amount() }
#[test]
fn lexical_choice_escapes() {
    let chosen = with (Discount) { || Item::value() }
    assert!(apply(chosen) == 70)
}
#[test]
fn ordinary_closure() {
    let ordinary = || Item::value()
    assert!(apply(ordinary) == 100)
}
#[test]
fn captured_bound() { assert!(with (Discount) { relay<Item>() } == 70) }
#[test]
fn ordinary_bound() { assert!(relay<Item>() == 100) }
#[test]
fn effect_row() {
    let f = || charge()
    with (Wholesale, Price = Item {}) { assert!(apply(f) == 70) }
}
impl Pick for Item as OtherPick { fn value() -> u256 { 80 } }
impl Price for Item as Retail { fn amount(self) -> u256 { 80 } }
fn nested<T: Pick>() -> u256 {
    let outer = || {
        let inner = || T::value()
        apply(inner)
    }
    apply(outer)
}
#[test]
fn same_body_two_captures_and_nested_capture() {
    assert!(with (Discount) { relay<Item>() } == 70)
    assert!(with (OtherPick) { relay<Item>() } == 80)
    assert!(relay<Item>() == 100)
    assert!(with (Discount) { nested<Item>() } == 70)
    assert!(with (OtherPick) { nested<Item>() } == 80)
    assert!(nested<Item>() == 100)
}
#[test]
fn same_closure_multiple_row_dictionaries() {
    let f = || charge()
    with (Wholesale, Price = Item {}) { assert!(apply(f) == 70) }
    with (Retail, Price = Item {}) { assert!(apply(f) == 80) }
    with (Price = Item {}) { assert!(apply(f) == 100) }
}

fn applied_bound<T: Pick>() -> u256 { T::value() }
#[test]
fn applied_declared_bound_uses_its_dictionary() {
    assert!(with (Discount) { applied_bound<Item>() } == 70)
    assert!(applied_bound<Item>() == 100)
}
