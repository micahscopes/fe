// One deterministic event tape handles the EventSource runtime effect for an
// imperative consumer, Stream, and pure FRP transformations. All three
// subscriptions observe the same values and report identical cleanup through
// the same typed handler scope.

use core::Fn
use std::reactive::{
    Cancelled, Event, EventSource, Stepped, Stream, Subscription,
    cancel_event, filter_event, hold, map_event, next_event, subscribe_event,
}

struct Tape {
    values: [u32; 4],
}

impl Copy for Tape {}

impl EventSource<u32> for Tape {
    fn subscribe(mut self) -> Subscription<u32> {
        Subscription::new()
    }

    fn next(mut self, _ subscription: own Subscription<u32>) -> (Subscription<u32>, Event<u32>) {
        let advanced = subscription.advance()
        let next_subscription = advanced.0
        let cursor = advanced.1
        if cursor < 4 {
            (next_subscription, Event::occurrence(value: self.values[cursor as usize]))
        } else {
            (next_subscription, Event::absent())
        }
    }

    fn cancel(mut self, _ subscription: own Subscription<u32>) -> Cancelled {
        Cancelled { consumed: subscription.cursor() }
    }
}

// A stateful handler proves `mut EventSource` is resident for the handler
// scope. Stream remains zero-state; it does not courier this counter itself.
struct CounterSource {
    next_value: u32,
}

struct SparseSource {}
impl Copy for SparseSource {}

impl EventSource<u32> for SparseSource {
    fn subscribe(mut self) -> Subscription<u32> {
        Subscription::new()
    }

    fn next(mut self, _ subscription: own Subscription<u32>) -> (Subscription<u32>, Event<u32>) {
        let advanced = subscription.advance()
        let event = if advanced.1 == 0 {
            Event::absent()
        } else if advanced.1 == 1 {
            Event::occurrence(value: 73)
        } else {
            Event::end()
        }
        (advanced.0, event)
    }

    fn cancel(mut self, _ subscription: own Subscription<u32>) -> Cancelled {
        Cancelled { consumed: subscription.cursor() }
    }
}

impl EventSource<u32> for CounterSource {
    fn subscribe(mut self) -> Subscription<u32> {
        Subscription::new()
    }

    fn next(mut self, _ subscription: own Subscription<u32>) -> (Subscription<u32>, Event<u32>) {
        let value = self.next_value
        self.next_value = self.next_value + 1
        (subscription.advance().0, Event::occurrence(value: value))
    }

    fn cancel(mut self, _ subscription: own Subscription<u32>) -> Cancelled {
        Cancelled { consumed: subscription.cursor() }
    }
}

struct Double {}

impl Fn<u32, u32> for Double {
    fn call(self, _ value: own u32) -> u32 {
        value * 2
    }
}

struct AtLeastFour {}

impl Fn<u32, bool> for AtLeastFour {
    fn call(self, _ value: own u32) -> bool {
        value >= 4
    }
}

#[test]
fn imperative_stream_and_frp_consumers_share_values_and_cleanup() {
    let mut tape = Tape {
        values: [1, 2, 3, 4],
    }
    let stream: Stream<u32> = Stream::new()

    with (EventSource<u32> = tape) {
        let mut imperative = subscribe_event()
        let mut streamed = stream.subscribe()
        let mut reactive = subscribe_event()
        let mut held = Stepped { held: 0 }
        let mut i: u32 = 0

        while i < 4 {
            let raw_step = next_event(imperative)
            imperative = raw_step.0
            let raw = raw_step.1

            let stream_step = stream.next(streamed)
            streamed = stream_step.0
            let stream_event = stream_step.1

            let frp_step = next_event(reactive)
            reactive = frp_step.0
            let mapped = map_event(frp_step.1, Double {})
            let selected = filter_event(mapped, AtLeastFour {})
            held = hold(held, selected)

            assert(raw.is_occurrence())
            assert(stream_event.is_occurrence())
            assert(stream_event.value_or(fallback: 0) == raw.value_or(fallback: 0))
            assert(mapped.is_occurrence())
            assert(mapped.value_or(fallback: 0) == raw.value_or(fallback: 0) * 2)
            if raw.value_or(fallback: 0) >= 2 {
                assert(selected.is_occurrence())
                assert(held.held == raw.value_or(fallback: 0) * 2)
            } else {
                assert(!selected.is_occurrence())
                assert(held.held == 0)
            }
            i = i + 1
        }

        let imperative_cleanup = cancel_event(imperative)
        let stream_cleanup = stream.cancel(streamed)
        let reactive_cleanup = cancel_event(reactive)
        assert(imperative_cleanup.consumed == 4)
        assert(stream_cleanup.consumed == imperative_cleanup.consumed)
        assert(reactive_cleanup.consumed == imperative_cleanup.consumed)
        assert(held.held == 8)
    }
}

#[test]
fn event_source_handler_owns_resident_mutable_state() {
    let stream: Stream<u32> = Stream::new()
    let mut source = CounterSource { next_value: 41 }
    with (EventSource<u32> = source) {
        let subscription = stream.subscribe()
        let first = stream.next(subscription)
        assert(first.1.value_or(fallback: 0) == 41)
        let second = stream.next(first.0)
        assert(second.1.value_or(fallback: 0) == 42)
        assert(stream.cancel(second.0).consumed == 2)
    }
}

#[test]
fn absence_survives_map_filter_and_hold() {
    let absent: Event<u32> = map_event(Event::absent(), Double {})
    assert(!absent.is_occurrence())
    let selected = filter_event(absent, AtLeastFour {})
    assert(!selected.is_occurrence())
    assert(hold(Stepped { held: 9 }, selected).held == 9)
}

#[test]
fn next_ready_skips_absence_and_preserves_terminal_state() {
    let stream: Stream<u32> = Stream::new()
    with (EventSource<u32> = SparseSource {}) {
        let first = stream.next_ready(stream.subscribe())
        assert(first.1.value_or(fallback: 0) == 73)
        let terminal = stream.next_ready(first.0)
        match terminal.1 {
            Event::End => {}
            _ => { assert(false) }
        }
        assert(stream.cancel(terminal.0).consumed == 3)
    }
}
