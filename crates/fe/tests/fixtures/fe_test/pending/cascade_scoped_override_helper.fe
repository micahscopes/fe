// Target: RD84 (2) with RD71, rewrite of mb2 `fe_test/cascade_scoped_override_helper.fe` (DECIDED). The named override selected at a call reaches the generic helper's body.
// Oracle: mb2's asserted values, unchanged (`selection-17.rd84.fe` twin passes on mb3).
use core::ops::Eq
use core::derive::Derive
use core::meta::{Code, Expr, Item, Record, Where, empty, field, field_count, field_type}

// StableEq: field by field, one `F: Eq` bound per field (QUOTATION_DESIGN section 9).
pub struct StableEq {}

impl Derive<Eq> for StableEq {
    const fn derive(_ record: Record) -> Code<Item> {
        let mut body: Code<Expr> = quote { true }
        let mut bounds = empty<Where>()
        let mut i: usize = 0
        while i < field_count(record) {
            let f = field(record, i)
            body = quote(other) { ${body} && self.${f} == other.${f} }
            bounds = quote { where ${bounds}, ${field_type(f)}: Eq }
            i += 1
        }
        quote { impl Eq for ${record} where ${bounds} { fn eq(self, _ other: Self) -> bool { ${body} } } }
    }
}

pub struct Speaker { pub id: u256 }

// Was `#[derive(Eq)]`, the default-marked derived impl; now an ordinary declared derivation (RD84 (1)).
impl Eq for Speaker with (StableEq)

// Was an unnamed hand-written override coexisting with the derived default; now it takes a name (RD84 (2)).
impl Eq for Speaker as Override {
    fn eq(self, _ other: Speaker) -> bool { true }
}

fn same<T: Eq>(_ x: T, _ y: T) -> bool { x.eq(y) }

#[test]
fn scoped_override_propagates_through_generic_helper() {
    let a = Speaker { id: 7 }
    let b = Speaker { id: 8 }
    assert!(!same(a, b))
    let inside: bool = with (Override) { same(a, b) }
    assert!(inside)
    assert!(!same(a, b))
}

#[test]
fn structural_default_helper_still_holds_unscoped() {
    assert!(same(Speaker { id: 5 }, Speaker { id: 5 }))
    assert!(!same(Speaker { id: 5 }, Speaker { id: 6 }))
}
