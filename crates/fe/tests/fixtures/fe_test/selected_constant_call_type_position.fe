// expect selected=20
trait Compute {
    const N: usize
    const fn compute() -> u256
}
struct Subject {}
fn target() -> Subject { Subject {} }
impl Compute for Subject {
    const N: usize = 1
    const fn compute() -> u256 { 1 }
}
impl Compute for Subject as Other {
    const N: usize = 2
    const fn compute() -> u256 { 2 }
}
const fn size<T: Compute>() -> usize { T::N }
const fn selected() -> u256 {
    with (Other) {
        let values: [u256; size<Subject>()] = [10, 20]
        20
    }
}

#[test]
fn selected_constant_expectations() {
    assert!(selected() == 20)
}
