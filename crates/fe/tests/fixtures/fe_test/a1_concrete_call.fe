trait Compute { const fn compute() -> u256 }
struct Subject {}
impl Compute for Subject {
    const fn compute() -> u256 { 42 }
}
impl Compute for Subject as Flag {
    const fn compute() -> u256 { 7 }
}

const fn bounded<T: Compute>() -> u256 { Subject::compute() + 1 }
const fn selected() -> u256 { with (Flag) { bounded<Subject>() } }
const fn through_bound<T: Compute>() -> u256 { T::compute() }

#[test]
fn concrete_call_keeps_its_lexical_impl() {
    assert!(selected() == 43)
    assert!(with (Flag) { through_bound<Subject>() } == 7)
}
