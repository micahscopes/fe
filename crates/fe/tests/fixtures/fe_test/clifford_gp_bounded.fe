// A bounded Clifford product checks the recursive multivector representation
// against a separate flat blade calculation. Both use the same Fe primitives,
// but the flat calculation does not call the structural product.

use core::ops::{WrappingAdd, WrappingSub, WrappingMul}

pub struct Sc { pub s: u256 }
pub struct Nd<A> { pub a: A, pub b: A }

impl Copy for Sc {}
impl<A: Copy> Copy for Nd<A> {}

recursive type fn MvT<const N: usize>() -> (*) {
    match N {
        0 => Sc
        _ => Nd<MvT<{N - 1}>>
    }
}

const fn neg(_ value: u256) -> u256 {
    (0 as u256).wrapping_sub(value)
}

trait ApplySign {
    const fn apply_sign(self, _ sign: usize) -> Self
}
impl ApplySign for Sc {
    const fn apply_sign(self, _ sign: usize) -> Self {
        if sign == 0 {
            self
        } else if sign == 1 {
            Sc { s: neg(self.s) }
        } else {
            Sc { s: 0 }
        }
    }
}
impl<A: ApplySign> ApplySign for Nd<A> {
    const fn apply_sign(self, _ sign: usize) -> Self {
        Nd { a: self.a.apply_sign(sign), b: self.b.apply_sign(sign) }
    }
}

trait Invol {
    const fn invol(self) -> Self
}
impl Invol for Sc {
    const fn invol(self) -> Self { self }
}
impl<A: Invol + ApplySign> Invol for Nd<A> {
    const fn invol(self) -> Self {
        Nd { a: self.a.invol(), b: self.b.invol().apply_sign(1) }
    }
}

trait Add {
    const fn add(self, _ other: Self) -> Self
}
impl Add for Sc {
    const fn add(self, _ other: Self) -> Self {
        Sc { s: self.s.wrapping_add(other.s) }
    }
}
impl<A: Add> Add for Nd<A> {
    const fn add(self, _ other: Self) -> Self {
        Nd { a: self.a.add(other.a), b: self.b.add(other.b) }
    }
}

const fn metric_sign(_ n: usize, _ p: usize, _ q: usize) -> usize {
    if n <= p { 0 } else if n <= p + q { 1 } else { 2 }
}

trait Product {
    const fn product(self, _ other: Self, _ n: usize, _ p: usize, _ q: usize) -> Self
}
impl Product for Sc {
    const fn product(self, _ other: Self, _ n: usize, _ p: usize, _ q: usize) -> Self {
        Sc { s: self.s.wrapping_mul(other.s) }
    }
}
impl<A: Product + Invol + Add + ApplySign + Copy> Product for Nd<A> {
    const fn product(self, _ other: Self, _ n: usize, _ p: usize, _ q: usize) -> Self {
        let aa = self.a.product(other.a, n - 1, p, q)
        let bb = self.b.product(other.b.invol(), n - 1, p, q)
        let ab = self.a.product(other.b, n - 1, p, q)
        let ba = self.b.product(other.a.invol(), n - 1, p, q)
        Nd {
            a: aa.add(bb.apply_sign(metric_sign(n, p, q))),
            b: ab.add(ba),
        }
    }
}

const fn from2(_ xs: [u256; 2]) -> MvT<1> {
    Nd { a: Sc { s: xs[0] }, b: Sc { s: xs[1] } }
}

const fn from4(_ xs: [u256; 4]) -> MvT<2> {
    Nd {
        a: Nd { a: Sc { s: xs[0] }, b: Sc { s: xs[1] } },
        b: Nd { a: Sc { s: xs[2] }, b: Sc { s: xs[3] } },
    }
}

const fn structural2(_ xs: [u256; 2], _ ys: [u256; 2]) -> [u256; 2] {
    let result = from2(xs).product(from2(ys), 1, 0, 1)
    [result.a.s, result.b.s]
}

const fn structural4(_ xs: [u256; 4], _ ys: [u256; 4], _ p: usize, _ q: usize) -> [u256; 4] {
    let result = from4(xs).product(from4(ys), 2, p, q)
    [result.a.a.s, result.a.b.s, result.b.a.s, result.b.b.s]
}

// The flat oracle multiplies blade bitsets. At dimension two, the only swap
// sign comes from a left e2 crossing a right e1.
const fn flat4(_ xs: [u256; 4], _ ys: [u256; 4], _ p: usize, _ q: usize) -> [u256; 4] {
    let mut out: [u256; 4] = [0; 4]
    let mut left: usize = 0
    while left < 4 {
        let mut right: usize = 0
        while right < 4 {
            let mut sign: usize = 0
            if (left & 2) != 0 && (right & 1) != 0 { sign = 1 }
            let overlap = left & right
            if (overlap & 1) != 0 {
                if p >= 1 {} else if q >= 1 { sign = 1 - sign } else { sign = 2 }
            }
            if (overlap & 2) != 0 {
                if p >= 2 {} else if p + q >= 2 { sign = 1 - sign } else { sign = 2 }
            }
            let index = left ^ right
            let product = xs[left].wrapping_mul(ys[right])
            if sign == 0 {
                out[index] = out[index].wrapping_add(product)
            } else if sign == 1 {
                out[index] = out[index].wrapping_sub(product)
            }
            right += 1
        }
        left += 1
    }
    out
}

const CL2: [u256; 4] = structural4([1, 2, 3, 4], [5, 6, 7, 8], 2, 0)
const CL2_FLAT: [u256; 4] = flat4([1, 2, 3, 4], [5, 6, 7, 8], 2, 0)
static_assert(CL2[0] == CL2_FLAT[0])
static_assert(CL2[1] == CL2_FLAT[1])
static_assert(CL2[2] == CL2_FLAT[2])
static_assert(CL2[3] == CL2_FLAT[3])
static_assert(CL2[0] == 6)
static_assert(CL2[3] == 24)

#[test]
fn test_recursive_clifford_product_against_flat_oracle() {
    let xs: [u256; 4] = [1, 2, 3, 4]
    let ys: [u256; 4] = [5, 6, 7, 8]
    let euclidean = structural4(xs, ys, 2, 0)
    let wedge = structural4(xs, ys, 0, 0)
    let mixed = structural4(xs, ys, 1, 1)
    for i in 0..4 {
        assert!(euclidean[i] == flat4(xs, ys, 2, 0)[i])
        assert!(wedge[i] == flat4(xs, ys, 0, 0)[i])
        assert!(mixed[i] == flat4(xs, ys, 1, 1)[i])
    }
    assert!(euclidean[0] == 6)
    assert!(euclidean[1] == 20)
    assert!(euclidean[2] == 14)
    assert!(euclidean[3] == 24)
    assert!(wedge[0] == 5)
    assert!(wedge[1] == 16)
    assert!(wedge[2] == 22)
    assert!(wedge[3] == 24)
    let complex = structural2([1, 2], [3, 4])
    assert!(complex[0] == neg(5))
    assert!(complex[1] == 10)
}
