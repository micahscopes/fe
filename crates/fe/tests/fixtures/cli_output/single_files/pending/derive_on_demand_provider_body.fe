// Target: RD84 (3), design section 6 ("deriver blocks are also rejected in provider bodies and their helpers, which run before any round").
// expect: rejected at line 35 (the block inside the provider), because providers run before any round, so a deriver
//   block there can never be filled.
use core::ops::Eq
use core::derive::Derive
use core::meta::{Code, Expr, Item, Record, Where, empty, field, field_count, field_type}

// StableEq: field by field, one `F: Eq` bound per field (QUOTATION_DESIGN section 9).
pub struct StableEq {}

impl Derive<Eq> for StableEq {
    const fn derive(_ record: Record) -> Code<Item> {
        let mut body: Code<Expr> = quote { true }
        let mut bounds = empty<Where>()
        let mut i: usize = 0
        while i < field_count(record) {
            let f = field(record, i)
            body = quote(other) { ${body} && self.${f} == other.${f} }
            bounds = quote { where ${bounds}, ${field_type(f)}: Eq }
            i += 1
        }
        quote { impl Eq for ${record} where ${bounds} { fn eq(self, _ other: Self) -> bool { ${body} } } }
    }
}

pub struct Point { pub x: u256, pub y: u256 }

const fn needs_eq<T: Eq>() -> bool { true }

mod author {
    use core::meta::{Code, Item, Record}
    use ingot::{StableEq, Point, needs_eq}

    pub const fn emit(_ record: Record) -> Code<Item> {
        let ok = with (StableEq) { needs_eq<Point>() } // <- here
        quote { pub fn answer() -> bool { ${ok} } }
    }
}

#[generate(ingot::author::emit)]
struct Target {}
