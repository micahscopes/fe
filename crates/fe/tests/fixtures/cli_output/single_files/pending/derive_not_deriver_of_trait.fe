// Target: RD84, design section 8 row "not a deriver of that trait". Naming a deriver that derives a different trait is rejected.
// expect: rejected at line 22 (the `with` path), because `OtherDeriver` derives `Other`, not `Eq`; label on its
//   `Derive<Other>` impl.
use core::ops::Eq
use core::derive::Derive
use core::meta::{Code, Expr, Item, Record, Where, empty, field, field_count, field_type}

pub trait Other {
    fn o(self) -> bool
}

pub struct OtherDeriver {}

impl Derive<Other> for OtherDeriver {
    const fn derive(_ record: Record) -> Code<Item> {
        quote { impl Other for ${record} { fn o(self) -> bool { true } } }
    }
}

pub struct Point { pub x: u256, pub y: u256 }

impl Eq for Point with (OtherDeriver) // <- here
