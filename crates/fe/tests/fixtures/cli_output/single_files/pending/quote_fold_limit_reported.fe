// Target: F2 with PR_HYGIENE 12. A fold that exceeds the transplant budget is rejected by a named limit that reports its actual and maximum values.
// expect: rejected at line 11 (the folding quote), because 600 folded `+ 1` steps exceed the 1,000-node transplant budget;
//   the message names the limit and prints both numbers, with a secondary label at `#[generate]`. Not a depth-64 message.
mod author {
    use core::meta::{Code, Expr, Item, Record}

    pub const fn emit(_ record: Record) -> Code<Item> {
        let mut acc: Code<Expr> = quote { 0 }
        let mut i: u256 = 0
        while i < 600 {
            acc = quote { ${acc} + 1 } // <- here
            i += 1
        }
        quote { pub fn total() -> u256 { ${acc} } }
    }
}

#[generate(ingot::author::emit)]
struct Target {}
