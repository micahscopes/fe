trait Missing {}
trait Compute { const fn compute() -> u256 }
struct Other {}
struct Subject {}
impl Compute for Other {
    const fn compute() -> u256 { 1 }
}
impl Compute for Subject where Subject: Missing {
    const fn compute() -> u256 { 2 }
}
const fn selected() -> u256 {
    with (<Subject as Compute>) { 1 }
}
