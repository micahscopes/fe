// Target: Q6, translation of mb2 `quote_match_nonexhaustive.fe`. A generated match that misses a variant is the ordinary exhaustiveness error in generated code.
// expect: ordinary non-exhaustive-match error naming `Mode::Off`, with the authored match primary
//   and `#[generate]` secondary. mb2's provider-side check is not rebuilt (RD0).
// Uses active enum payload reflection and Arm-list splicing.
trait Tagged {
    fn tag(self) -> bool
}

mod author {
    use core::meta::{Arm, Code, Item, Record, binders, empty, variant}

    pub const fn first_only(record: Record) -> Code<Item> {
        let first = binders(variant(record, 0), 0)
        let mut arms = empty<Arm>()
        arms = quote {
            ${arms}
            ${first} => true
        }
        quote {
            impl ingot::Tagged for ${record} {
                fn tag(self) -> bool { match self { ${arms} } } // <- here
            }
        }
    }
}

#[generate(ingot::author::first_only)]
enum Mode {
    On,
    Off,
}
