// Package-like sparse Clifford prelude.
//
// This is a real Fe ingot with a public API. The current browser generators
// also prepend this canonical source to their self-contained published
// `kernel.fe` artifact; ordinary Fe applications can instead import the ingot.
// It deliberately owns only reusable representation and access semantics:
//   - fixed-capacity BladeSet support algebra for diagonal metrics;
//   - Zero/Term/Add sparse operator plans and their length witness;
//   - support-sized scalar storage with default-zero and present-only access.
//
// Domain code still owns its metric, candidate enumeration, survivor ordering,
// coefficient provider, and operator evaluator.
//
// A support bit at position B denotes basis blade mask B.
//
// Five basis vectors / 32 blades fit an explicit portable u32. Operations fail
// closed above that bound. This is composed into domain fixtures by the Rust
// single-file harness as well as through the ingot API.
pub struct BladeSet { pub bits: u32, pub dimension: u32 }
impl Copy for BladeSet {}

const fn support_dimension_valid(_ dimension: u32) -> bool {
    dimension < 6
}

const fn support_capacity_mask(_ dimension: u32) -> u32 {
    match dimension {
        0 => 1
        1 => 3
        2 => 15
        3 => 255
        4 => 65535
        5 => 4294967295
        _ => 0
    }
}

const fn blade_set(_ bits: u32, _ dimension: u32) -> BladeSet {
    BladeSet {
        bits: bits & support_capacity_mask(dimension),
        dimension: dimension,
    }
}

const fn support_contains(_ support: BladeSet, _ blade: u32) -> bool {
    if !support_dimension_valid(support.dimension) { return false }
    if blade < (1 << support.dimension) {
    } else {
        return false
    }
    ((support.bits >> blade) & 1) == 1
}

const fn blade_grade(_ blade: u32) -> u32 {
    let mut value: u32 = blade
    let mut count: u32 = 0
    while 0 < value {
        count = count + (value & 1)
        value = value >> 1
    }
    count
}

const fn support_grade(_ support: BladeSet, _ grade: u32) -> BladeSet {
    if !support_dimension_valid(support.dimension) {
        return blade_set(0, support.dimension)
    }
    let blade_count: u32 = 1 << support.dimension
    let mut blade: u32 = 0
    let mut bits: u32 = 0
    while blade < blade_count {
        if ((support.bits >> blade) & 1) == 1 && blade_grade(blade) == grade {
            bits = bits | (1 << blade)
        }
        blade = blade + 1
    }
    blade_set(bits, support.dimension)
}

// Conservative geometric-product support in an orthogonal basis. A shared
// generator outside `nonzero_square_generators` annihilates the pair.
// Coefficient cancellation is intentionally a later normalization step.
const fn support_gp(
    _ left: BladeSet,
    _ right: BladeSet,
    _ nonzero_square_generators: u32,
) -> BladeSet {
    if left.dimension == right.dimension {
    } else {
        return blade_set(0, left.dimension)
    }
    if !support_dimension_valid(left.dimension) {
        return blade_set(0, left.dimension)
    }
    let blade_count: u32 = 1 << left.dimension
    let mut l: u32 = 0
    let mut output: u32 = 0
    while l < blade_count {
        if ((left.bits >> l) & 1) == 1 {
            let mut r: u32 = 0
            while r < blade_count {
                if ((right.bits >> r) & 1) == 1 {
                    let shared: u32 = l & r
                    if (shared & nonzero_square_generators) == shared {
                        output = output | (1 << (l ^ r))
                    }
                }
                r = r + 1
            }
        }
        l = l + 1
    }
    blade_set(output, left.dimension)
}

const fn support_cardinality(_ support: BladeSet) -> u32 {
    let mut value: u32 = support.bits
    let mut count: u32 = 0
    while 0 < value {
        count = count + (value & 1)
        value = value >> 1
    }
    count
}

// Finite sparse-operator plan vocabulary. A domain planner supplies its own
// CTFE candidate enumeration and constructs a ground
// Add<Term<Candidate>, ... Zero> tree.

pub struct Zero {}
pub struct Term<const Candidate: usize> {}
pub struct Add<L, R> {}

pub struct NatZ {}
pub struct NatS<N> {}

pub recursive type fn Nat<const N: usize>() -> (*) {
    match N {
        0 => NatZ
        _ => NatS<Nat<{N - 1}>>
    }
}

pub trait PlanLength { type Out }

impl PlanLength for Zero {
    type Out = NatZ
}

impl<const Candidate: usize, Tail: PlanLength> PlanLength
    for Add<Term<Candidate>, Tail>
{
    type Out = NatS<<Tail as PlanLength>::Out>
}

// Bounded candidate-set planner. A domain encodes its surviving candidate
// identities in eight 24-bit browser-profile u32 words, while this shared layer owns
// cardinality, canonical ascending selection, and materialization of the
// ground plan type. The 192-candidate ceiling is explicit; this is not an
// unbounded sparse operator compiler.

const fn plan_mask_contains(
    _ keep0: u32, _ keep1: u32, _ keep2: u32, _ keep3: u32,
    _ keep4: u32, _ keep5: u32, _ keep6: u32, _ keep7: u32,
    _ candidate: usize,
) -> bool {
    if candidate < 24 {
        ((keep0 >> candidate.downcast_truncate()) & 1) == 1
    } else if candidate < 48 {
        ((keep1 >> (candidate - 24).downcast_truncate()) & 1) == 1
    } else if candidate < 72 {
        ((keep2 >> (candidate - 48).downcast_truncate()) & 1) == 1
    } else if candidate < 96 {
        ((keep3 >> (candidate - 72).downcast_truncate()) & 1) == 1
    } else if candidate < 120 {
        ((keep4 >> (candidate - 96).downcast_truncate()) & 1) == 1
    } else if candidate < 144 {
        ((keep5 >> (candidate - 120).downcast_truncate()) & 1) == 1
    } else if candidate < 168 {
        ((keep6 >> (candidate - 144).downcast_truncate()) & 1) == 1
    } else if candidate < 192 {
        ((keep7 >> (candidate - 168).downcast_truncate()) & 1) == 1
    } else {
        false
    }
}

const fn plan_mask_cardinality(
    _ keep0: u32, _ keep1: u32, _ keep2: u32, _ keep3: u32,
    _ keep4: u32, _ keep5: u32, _ keep6: u32, _ keep7: u32,
    _ candidate_count: usize,
) -> usize {
    let mut candidate: usize = 0
    let mut count: usize = 0
    while candidate < candidate_count && candidate < 192 {
        if plan_mask_contains(
            keep0, keep1, keep2, keep3, keep4, keep5, keep6, keep7, candidate,
        ) {
            count = count + 1
        }
        candidate = candidate + 1
    }
    count
}

const fn plan_mask_candidate(
    _ keep0: u32, _ keep1: u32, _ keep2: u32, _ keep3: u32,
    _ keep4: u32, _ keep5: u32, _ keep6: u32, _ keep7: u32,
    _ candidate_count: usize,
    _ target: usize,
) -> usize {
    let mut candidate: usize = 0
    let mut seen: usize = 0
    while candidate < candidate_count && candidate < 192 {
        if plan_mask_contains(
            keep0, keep1, keep2, keep3, keep4, keep5, keep6, keep7, candidate,
        ) {
            if seen == target { return candidate }
            seen = seen + 1
        }
        candidate = candidate + 1
    }
    candidate_count
}

pub recursive type fn SparsePlan<
    const Keep0: u32, const Keep1: u32, const Keep2: u32, const Keep3: u32,
    const Keep4: u32, const Keep5: u32, const Keep6: u32, const Keep7: u32,
    const CandidateCount: usize,
    const N: usize,
>() -> (*) {
    match N {
        0 => Zero
        _ => Add<
            Term<{plan_mask_candidate(
                Keep0, Keep1, Keep2, Keep3, Keep4, Keep5, Keep6, Keep7,
                CandidateCount, N - 1,
            )}>,
            SparsePlan<
                Keep0, Keep1, Keep2, Keep3, Keep4, Keep5, Keep6, Keep7,
                CandidateCount, {N - 1},
            >,
        >
    }
}

// Sparse runtime values selected from the 32 blades of Cl(p,q), p+q <= 5.
// Runtime storage contains exactly popcount(Support) scalars. A recursive
// rank-to-Here/Next type covers the whole bounded support. Missing coefficient
// reads specialize to zero; `sparse_present_coefficient` has no missing-blade
// implementation and therefore rejects absent access during type checking.

pub struct SparseNil {}
pub struct SparseCell<T> { pub head: f32, pub tail: T }
impl Copy for SparseNil {}
impl<T: Copy> Copy for SparseCell<T> {}

pub recursive type fn SparseStorage<const N: usize>() -> (*) {
    match N {
        0 => SparseNil
        _ => SparseCell<SparseStorage<{N - 1}>>
    }
}

const fn sparse_rank(_ support: usize, _ blade: usize) -> usize {
    let mut cursor: usize = 0
    let mut rank: usize = 0
    while cursor < blade && cursor < 32 {
        rank = rank + ((support >> cursor) & 1)
        cursor = cursor + 1
    }
    rank
}

const fn sparse_present(_ support: usize, _ blade: usize) -> usize {
    if blade < 32 {
        (support >> blade) & 1
    } else {
        0
    }
}

pub struct SparseMissing {}
pub struct SparseHere {}
pub struct SparseNext<I> {}
pub struct SparseSelect<const Present: usize, const Rank: usize> {}

pub recursive type fn SparseIndex<const Rank: usize>() -> (*) {
    match Rank {
        0 => SparseHere
        _ => SparseNext<SparseIndex<{Rank - 1}>>
    }
}

pub trait SparseSelectOut { type Out }
impl<const Rank: usize> SparseSelectOut for SparseSelect<0, Rank> {
    type Out = SparseMissing
}
impl<const Rank: usize> SparseSelectOut for SparseSelect<1, Rank> {
    type Out = SparseIndex<Rank>
}

pub trait SparseCoefficient<S> { fn read(value: S) -> f32 }
impl SparseCoefficient<SparseNil> for SparseMissing {
    fn read(value: SparseNil) -> f32 { 0.0 }
}
impl<T> SparseCoefficient<SparseCell<T>> for SparseMissing {
    fn read(value: SparseCell<T>) -> f32 { 0.0 }
}
impl<T> SparseCoefficient<SparseCell<T>> for SparseHere {
    fn read(value: SparseCell<T>) -> f32 { value.head }
}
impl<I, T> SparseCoefficient<SparseCell<T>> for SparseNext<I>
    where I: SparseCoefficient<T>
{
    fn read(value: SparseCell<T>) -> f32 {
        <I as SparseCoefficient<T>>::read(value: value.tail)
    }
}

// Deliberately lacks a SparseMissing implementation.
pub trait SparsePresentCoefficient<S> { fn read_present(value: S) -> f32 }
impl<T> SparsePresentCoefficient<SparseCell<T>> for SparseHere {
    fn read_present(value: SparseCell<T>) -> f32 { value.head }
}
impl<I, T> SparsePresentCoefficient<SparseCell<T>> for SparseNext<I>
    where I: SparsePresentCoefficient<T>
{
    fn read_present(value: SparseCell<T>) -> f32 {
        <I as SparsePresentCoefficient<T>>::read_present(value: value.tail)
    }
}

pub fn sparse_coefficient<I: SparseCoefficient<S>, S>(value: S) -> f32
{
    <I as SparseCoefficient<S>>::read(value: value)
}

pub fn sparse_present_coefficient<I: SparsePresentCoefficient<S>, S>(value: S) -> f32
{
    <I as SparsePresentCoefficient<S>>::read_present(value: value)
}

use core::derive::{Derive, Evidence, ImplBuilder, Reflect}

// Canonical Cl(4,1) support semantics. These ordinary Fe const helpers are the
// only source used by both the typed Schedule32 witness and the FCO emitter.
const fn sphere_blade(_ slot: usize) -> usize {
    1 << (slot + slot / 2)
}

const fn point_blade(_ slot: usize) -> usize {
    1 << slot
}

const fn raw_left_slot(_ triple: usize) -> usize { triple / 20 }
const fn raw_point_slot(_ triple: usize) -> usize { (triple / 4) % 5 }
const fn raw_right_slot(_ triple: usize) -> usize { triple % 4 }

const fn left_blade(_ triple: usize) -> usize {
    sphere_blade(raw_left_slot(triple))
}

const fn middle_blade(_ triple: usize) -> usize {
    point_blade(raw_point_slot(triple))
}

const fn right_blade(_ triple: usize) -> usize {
    sphere_blade(raw_right_slot(triple))
}

const fn popcount5(_ value: usize) -> usize {
    (value & 1) + ((value >> 1) & 1) + ((value >> 2) & 1)
        + ((value >> 3) & 1) + ((value >> 4) & 1)
}

// 0 is positive and 1 is negative. Generator 4 (mask 16) squares to -1.
const fn gp_negative(_ a: usize, _ b: usize) -> usize {
    (
        (((a >> 1) & 1) * popcount5(b & 1))
        + (((a >> 2) & 1) * popcount5(b & 3))
        + (((a >> 3) & 1) * popcount5(b & 7))
        + (((a >> 4) & 1) * popcount5(b & 15))
        + (((a >> 4) & 1) * ((b >> 4) & 1))
    ) & 1
}

const fn triple_negative(_ triple: usize) -> usize {
    let l = left_blade(triple)
    let p = middle_blade(triple)
    let r = right_blade(triple)
    gp_negative(l, p) ^ gp_negative(l ^ p, r)
}

const fn reverse_negative(_ triple: usize) -> usize {
    let l = left_blade(triple)
    let p = middle_blade(triple)
    let r = right_blade(triple)
    gp_negative(r, p) ^ gp_negative(r ^ p, l)
}

const fn canonical_tag(_ triple: usize) -> usize {
    let l = raw_left_slot(triple)
    let r = raw_right_slot(triple)
    let l0 = l & 1
    let l1 = (l >> 1) & 1
    let r0 = r & 1
    let r1 = (r >> 1) & 1
    let same_high = 1 - (l1 ^ r1)
    let greater = l1 * (1 - r1) + same_high * l0 * (1 - r0)
    1 - greater
}

const fn diagonal_tag(_ triple: usize) -> usize {
    let l = raw_left_slot(triple)
    let r = raw_right_slot(triple)
    (1 - ((l >> 1) ^ (r >> 1))) * (1 - ((l & 1) ^ (r & 1)))
}

const fn coefficient_keep_tag(_ triple: usize) -> usize {
    canonical_tag(triple)
        * (1 - (triple_negative(triple) ^ reverse_negative(triple)))
}

const fn magnitude(_ triple: usize) -> usize {
    2 - diagonal_tag(triple)
}

const fn output_blade(_ triple: usize) -> usize {
    left_blade(triple) ^ middle_blade(triple) ^ right_blade(triple)
}

// The shared BladeSet API derives admissible support compositionally. Its
// conservative result is grade-projected before coefficient/sign cancellation.
const SPHERE_SUPPORT: BladeSet = blade_set(65798, 5)
const POINT_SUPPORT: BladeSet = blade_set(65814, 5)
const SPHERE_POINT_BITS: u32 =
    support_gp(SPHERE_SUPPORT, POINT_SUPPORT, 31).bits
const SANDWICH_CANDIDATE_BITS: u32 =
    support_gp(blade_set(SPHERE_POINT_BITS, 5), SPHERE_SUPPORT, 31).bits
const SANDWICH_OUTPUT_BITS: u32 =
    support_grade(blade_set(SANDWICH_CANDIDATE_BITS, 5), 1).bits
static_assert(SANDWICH_OUTPUT_BITS == 65814)

const fn supported_output_tag(_ triple: usize) -> usize {
    // FCO's bounded provider executor cannot read struct-valued/global CTFE
    // results. This scalar literal is sealed by the assertion above.
    if ((65814 >> output_blade(triple)) & 1) == 1 { 1 } else { 0 }
}

const fn keep_tag(_ triple: usize) -> usize {
    supported_output_tag(triple) * coefficient_keep_tag(triple)
}

const fn schedule_keep_word(_ first: usize, _ last: usize) -> u32 {
    let mut triple: usize = first
    let mut keep_bits: u32 = 0
    while triple < last {
        if keep_tag(triple) != 0 {
            keep_bits = keep_bits | ((1 as u32) << (triple - first).downcast_truncate())
        }
        triple = triple + 1
    }
    keep_bits
}

const SCHEDULE_KEEP0: u32 = schedule_keep_word(0, 24)
const SCHEDULE_KEEP1: u32 = schedule_keep_word(24, 48)
const SCHEDULE_KEEP2: u32 = schedule_keep_word(48, 72)
const SCHEDULE_KEEP3: u32 = schedule_keep_word(72, 80)
const SCHEDULE_KEEP4: u32 = 0
const SCHEDULE_KEEP5: u32 = 0
const SCHEDULE_KEEP6: u32 = 0
const SCHEDULE_KEEP7: u32 = 0

const fn survivor_count() -> usize {
    plan_mask_cardinality(
        SCHEDULE_KEEP0, SCHEDULE_KEEP1, SCHEDULE_KEEP2,
        SCHEDULE_KEEP3, SCHEDULE_KEEP4, SCHEDULE_KEEP5,
        SCHEDULE_KEEP6, SCHEDULE_KEEP7, 80,
    )
}

const fn survivor_triple(_ target: usize) -> usize {
    plan_mask_candidate(
        SCHEDULE_KEEP0, SCHEDULE_KEEP1, SCHEDULE_KEEP2,
        SCHEDULE_KEEP3, SCHEDULE_KEEP4, SCHEDULE_KEEP5,
        SCHEDULE_KEEP6, SCHEDULE_KEEP7, 80, target,
    )
}

static_assert(survivor_count() == 32)
static_assert(SCHEDULE_KEEP0 == 2707775)
static_assert(SCHEDULE_KEEP1 == 4498990)
static_assert(SCHEDULE_KEEP2 == 8948932)
static_assert(SCHEDULE_KEEP3 == 136)

// The inspectable typed witness stores the canonical source-triple identity in
// exact survivor order. The literals keep today's semantic-MIR lowering from
// seeing a const-value path in a type argument; the assertions above prove
// that they are exactly the masks computed from the source semantics.
type Schedule32 =
    SparsePlan<2707775, 4498990, 8948932, 136, 0, 0, 0, 0, 80, 32>

// BEGIN_FORCE_SCHEDULE32
fn takes_nat32(_ value: Nat<32>) {}
fn schedule_has_exactly_32_terms(value: <Schedule32 as PlanLength>::Out) {
    takes_nat32(value)
}
// END_FORCE_SCHEDULE32

// BEGIN_PROVIDER_EMITTER
// One reflected five-lane storage record lets the current provider API project
// inputs and materialize the result without runtime accessors.  The semantic
// names remain visible at the call boundary as aliases.
struct ConformalVector {
    e1: f32,
    e2: f32,
    e4: f32,
    e8: f32,
    e16: f32,
}
impl Copy for ConformalVector {}
type ConformalSphere = ConformalVector
type ConformalPoint = ConformalVector

trait Sandwich {
    fn sandwich(_ sphere: ConformalSphere, _ point: ConformalPoint) -> ConformalVector
}

struct CanonicalCgaProvider {}
impl Derive<Sandwich> for CanonicalCgaProvider {
    const fn derive<T>(ev: own Evidence<Sandwich<T>>) -> Evidence<Sandwich<T>>
        uses (reflect: Reflect<T>, builder: mut ImplBuilder<Sandwich<T>>)
    {
        // A typed f32 zero without a float-literal codegen primitive.
        let sphere = builder.arg_ref("sphere")
        let point_arg = builder.arg_ref("point")
        let s1 = sphere
        let s2 = sphere
        let s8 = sphere
        let s16 = sphere
        let p1 = point_arg
        let p2 = point_arg
        let p4 = point_arg
        let p8 = point_arg
        let p16 = point_arg
        let field_index = 0
        for field in reflect.fields() {
            if field_index == 0 { s1 = builder.field_get(sphere, field) }
            if field_index == 1 { s2 = builder.field_get(sphere, field) }
            if field_index == 3 { s8 = builder.field_get(sphere, field) }
            if field_index == 4 { s16 = builder.field_get(sphere, field) }
            if field_index == 0 { p1 = builder.field_get(point_arg, field) }
            if field_index == 1 { p2 = builder.field_get(point_arg, field) }
            if field_index == 2 { p4 = builder.field_get(point_arg, field) }
            if field_index == 3 { p8 = builder.field_get(point_arg, field) }
            if field_index == 4 { p16 = builder.field_get(point_arg, field) }
            field_index = field_index + 1
        }
        let zero = builder.sub(s1, s1)
        let lane1_0 = zero
        let lane1_1 = zero
        let lane1_2 = zero
        let lane1_3 = zero
        let lane2_0 = zero
        let lane2_1 = zero
        let lane2_2 = zero
        let lane2_3 = zero
        let lane4_0 = zero
        let lane4_1 = zero
        let lane4_2 = zero
        let lane4_3 = zero
        let lane8_0 = zero
        let lane8_1 = zero
        let lane8_2 = zero
        let lane8_3 = zero
        let lane16_0 = zero
        let lane16_1 = zero
        let lane16_2 = zero
        let lane16_3 = zero
        let survivor = 0

        // Exhaustively scan the canonical semantic universe. The provider
        // range and global step budgets fail closed if this ceases to be
        // bounded; no survivor list is supplied. Each aggregate output field
        // already filters its one grade-1 blade below, so the provider uses the
        // coefficient predicate rather than spending its stricter interpreter
        // budget repeating the equivalent support lookup 80 times.
        for triple in 0..80 {
            if coefficient_keep_tag(triple) != 0 {
                let left = s1
                if raw_left_slot(triple) == 1 { left = s2 }
                if raw_left_slot(triple) == 2 { left = s8 }
                if raw_left_slot(triple) == 3 { left = s16 }

                let point = p1
                if raw_point_slot(triple) == 1 { point = p2 }
                if raw_point_slot(triple) == 2 { point = p4 }
                if raw_point_slot(triple) == 3 { point = p8 }
                if raw_point_slot(triple) == 4 { point = p16 }

                let right = s1
                if raw_right_slot(triple) == 1 { right = s2 }
                if raw_right_slot(triple) == 2 { right = s8 }
                if raw_right_slot(triple) == 3 { right = s16 }

                let product = builder.share(builder.mul(builder.mul(left, point), right))
                let term = product
                // Preserve the canonical raw80 IEEE operation order: compute
                // the full left*point*right product before combining the two
                // equal ordered orientations.
                if magnitude(triple) == 2 {
                    term = builder.add(product, product)
                }
                if triple_negative(triple) != 0 { term = builder.neg(term) }

                let output = output_blade(triple)
                if output == 1 {
                    if survivor < 8 { lane1_0 = builder.add(term, lane1_0) }
                    else if survivor < 16 { lane1_1 = builder.add(term, lane1_1) }
                    else if survivor < 24 { lane1_2 = builder.add(term, lane1_2) }
                    else { lane1_3 = builder.add(term, lane1_3) }
                }
                if output == 2 {
                    if survivor < 8 { lane2_0 = builder.add(term, lane2_0) }
                    else if survivor < 16 { lane2_1 = builder.add(term, lane2_1) }
                    else if survivor < 24 { lane2_2 = builder.add(term, lane2_2) }
                    else { lane2_3 = builder.add(term, lane2_3) }
                }
                if output == 4 {
                    if survivor < 8 { lane4_0 = builder.add(term, lane4_0) }
                    else if survivor < 16 { lane4_1 = builder.add(term, lane4_1) }
                    else if survivor < 24 { lane4_2 = builder.add(term, lane4_2) }
                    else { lane4_3 = builder.add(term, lane4_3) }
                }
                if output == 8 {
                    if survivor < 8 { lane8_0 = builder.add(term, lane8_0) }
                    else if survivor < 16 { lane8_1 = builder.add(term, lane8_1) }
                    else if survivor < 24 { lane8_2 = builder.add(term, lane8_2) }
                    else { lane8_3 = builder.add(term, lane8_3) }
                }
                if output == 16 {
                    if survivor < 8 { lane16_0 = builder.add(term, lane16_0) }
                    else if survivor < 16 { lane16_1 = builder.add(term, lane16_1) }
                    else if survivor < 24 { lane16_2 = builder.add(term, lane16_2) }
                    else { lane16_3 = builder.add(term, lane16_3) }
                }
                survivor = survivor + 1
            }
        }

        let out1 = builder.add(builder.add(lane1_3, lane1_2), builder.add(lane1_1, lane1_0))
        let out2 = builder.add(builder.add(lane2_3, lane2_2), builder.add(lane2_1, lane2_0))
        let out4 = builder.add(builder.add(lane4_3, lane4_2), builder.add(lane4_1, lane4_0))
        let out8 = builder.add(builder.add(lane8_3, lane8_2), builder.add(lane8_1, lane8_0))
        let out16 = builder.add(builder.add(lane16_3, lane16_2), builder.add(lane16_1, lane16_0))
        let image = builder.struct_init()
        let field_index = 0
        for field in reflect.fields() {
            if field_index == 0 { image = builder.with_field(image, field, out1) }
            if field_index == 1 { image = builder.with_field(image, field, out2) }
            if field_index == 2 { image = builder.with_field(image, field, out4) }
            if field_index == 3 { image = builder.with_field(image, field, out8) }
            if field_index == 4 { image = builder.with_field(image, field, out16) }
            field_index = field_index + 1
        }
        builder.emit_method("sandwich", image)
        builder.finish()
        ev
    }
}

derive Sandwich for ConformalVector using CanonicalCgaProvider



extern {
    fn __f32_from_i32(_: i32) -> f32
    fn __sqrt_f32(_: f32) -> f32
    const fn __bitcast<From, To>(_: From) -> To
}

// Semantic sparse Cl(4,1) values. Their fields are exactly the compact support
// consumed by the specialized S*P*S kernel; callers do not construct or order
// raw coefficient tuples.
pub fn cga_schedule32_vec5_de_render(
    px: i32,
    py: i32,
    cam_x: f32,
    cam_y: f32,
    zoom: f32,
    inv_cx: f32,
    inv_cy: f32,
) -> u32 {
    let fx: f32 = __f32_from_i32(px)
    let fy: f32 = __f32_from_i32(py)
    let sx: f32 = (fx - 64.0) * zoom
    let sy: f32 = (fy - 64.0) * zoom
    let rz: f32 = 1.8
    let inv_len: f32 = 1.0 / __sqrt_f32(sx * sx + sy * sy + rz * rz)
    let rdx: f32 = sx * inv_len
    let rdy: f32 = sy * inv_len
    let rdz: f32 = rz * inv_len
    let center2: f32 = inv_cx * inv_cx + inv_cy * inv_cy
    let sphere: ConformalSphere = ConformalSphere {
        e1: inv_cx,
        e2: inv_cy,
        e4: 0.0,
        e8: center2 * 0.5 - 1.0,
        e16: center2 * 0.5,
    }

    let mut t: f32 = 0.0
    let mut i: i32 = 0
    while i < 72 {
        let x: f32 = cam_x + rdx * t
        let y: f32 = cam_y + rdy * t
        let z: f32 = -4.0 + rdz * t
        let radius2: f32 = x * x + y * y + z * z
        let point: ConformalPoint = ConformalPoint {
            e1: x,
            e2: y,
            e4: z,
            e8: (radius2 - 1.0) * 0.5,
            e16: (radius2 + 1.0) * 0.5,
        }

        // All five lanes are provider-emitted straight-line arithmetic derived
        // from the same canonical 80-candidate Fe helpers as Schedule32.
        let image: ConformalVector =
            <ConformalVector as Sandwich>::sandwich(sphere, point)

        let weight: f32 = image.e16 - image.e8
        let safe_weight: f32 = if weight > -0.0004 { -0.0004 } else { weight }
        let weight_adjust: f32 = safe_weight - weight
        let qx: f32 = (image.e1 + weight_adjust * inv_cx) / safe_weight
        let qy: f32 = (image.e2 + weight_adjust * inv_cy) / safe_weight
        let qz: f32 = image.e4 / safe_weight

        let tx: f32 = qx + 0.62
        let ty: f32 = qy - 0.08
        let ring_radius: f32 = __sqrt_f32(tx * tx + ty * ty) - 0.58
        let base: f32 = __sqrt_f32(ring_radius * ring_radius + qz * qz) - 0.17
        let distance: f32 = base * -safe_weight
        t = t + distance * 0.18
        if distance < 0.0022 {
            let shade: i32 = 38 + 24 * (i >> 3)
            if qy > 0.0 {
                return __bitcast(shade + 88 * 256 + (255 - shade) * 65536 + -16777216)
            }
            return __bitcast(56 + shade * 256 + 224 * 65536 + -16777216)
        }
        i = i + 1
    }
    let sky: i32 = 7 + 11 * 256 + 25 * 65536 + -16777216
    __bitcast(sky)
}


use core::{AllocatedBrowserBytes, BrowserBytes, HostEffect, MainThread}
use core::effect_ref::alloc_bytes
use core::num::IntDowncast
use std::webgpu::{Dispatch, WebGpuBackend}

struct FrameRequest {
    generation: u32,
    cam_x: f32,
    cam_y: f32,
    zoom: f32,
    inv_cx: f32,
    inv_cy: f32,
}

struct Submitted {
    submitted: bool,
}

pub fn render(_request: own FrameRequest) -> Submitted
    uses (HostEffect, MainThread, mut Dispatch<WebGpuBackend>)
{
    Submitted { submitted: false }
}

pub fn verify(_request: own FrameRequest) -> BrowserBytes
    uses (HostEffect, MainThread, mut Dispatch<WebGpuBackend>)
{
    BrowserBytes { ptr: 0, len: 0 }
}

fn append_byte(value: u32) {
    let byte = alloc_bytes(1)
    byte.write(value.downcast_truncate())
}

fn append_frame_tail(
    first_rgba: u32,
    cam_x: f32,
    cam_y: f32,
    zoom: f32,
    inv_cx: f32,
    inv_cy: f32,
) {
    append_byte(value: first_rgba >> 8)
    append_byte(value: first_rgba >> 16)
    append_byte(value: first_rgba >> 24)

    let mut y: i32 = 0
    let mut x: i32 = 1
    while y < 128 {
        while x < 128 {
            let rgba = cga_schedule32_vec5_de_render(
                px: x,
                py: y,
                cam_x: cam_x,
                cam_y: cam_y,
                zoom: zoom,
                inv_cx: inv_cx,
                inv_cy: inv_cy,
            )
            append_byte(value: rgba)
            append_byte(value: rgba >> 8)
            append_byte(value: rgba >> 16)
            append_byte(value: rgba >> 24)
            x = x + 1
        }
        y = y + 1
        x = 0
    }
}

pub fn oracle(request: own FrameRequest) -> AllocatedBrowserBytes {
    let first_rgba = cga_schedule32_vec5_de_render(
        px: 0,
        py: 0,
        cam_x: request.cam_x,
        cam_y: request.cam_y,
        zoom: request.zoom,
        inv_cx: request.inv_cx,
        inv_cy: request.inv_cy,
    )
    let first = alloc_bytes(1)
    first.write(first_rgba.downcast_truncate())
    append_frame_tail(
        first_rgba: first_rgba,
        cam_x: request.cam_x,
        cam_y: request.cam_y,
        zoom: request.zoom,
        inv_cx: request.inv_cx,
        inv_cy: request.inv_cy,
    )
    AllocatedBrowserBytes { ptr: first, len: 65536 }
}
