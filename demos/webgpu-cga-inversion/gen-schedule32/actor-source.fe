// Hybrid CGA specialization experiment.
//
// The Fe const functions below enumerate all 80 S*P*S support triples, combine
// equal commutative sphere monomials, and remove cancellations. `Schedule<32>`
// then materializes the survivors directly as an `Add<Term<...>, ...>` type
// evaluated generically below. No runtime schedule loop, scalar polynomial, or
// external generator appears.

extern {
    fn __i32_from_f32(_: f32) -> i32
    const fn __bitcast<From, To>(_: From) -> To
}

// Semantic supports.  These are blade masks in Cl(4,1), not positions in an
// externally produced expression.
const fn sphere_blade(_ slot: usize) -> usize {
    1 << (slot + slot / 2)
}

const fn point_blade(_ slot: usize) -> usize {
    1 << slot
}

const fn left_blade(_ triple: usize) -> usize {
    sphere_blade(triple / 20)
}

const fn middle_blade(_ triple: usize) -> usize {
    point_blade((triple / 4) % 5)
}

const fn right_blade(_ triple: usize) -> usize {
    sphere_blade(triple % 4)
}

const fn popcount5(_ value: usize) -> usize {
    (value & 1) + ((value >> 1) & 1) + ((value >> 2) & 1)
        + ((value >> 3) & 1) + ((value >> 4) & 1)
}

// 0 means positive and 1 means negative.  Generator 4 (mask 16) has square
// -1; the other four generators have square +1.
const fn gp_negative(_ a: usize, _ b: usize) -> usize {
    (
        (((a >> 1) & 1) * popcount5(b & 1))
        + (((a >> 2) & 1) * popcount5(b & 3))
        + (((a >> 3) & 1) * popcount5(b & 7))
        + (((a >> 4) & 1) * popcount5(b & 15))
        + (((a >> 4) & 1) * ((b >> 4) & 1))
    ) & 1
}

const fn triple_negative(_ triple: usize) -> usize {
    let l = left_blade(triple)
    let p = middle_blade(triple)
    let r = right_blade(triple)
    gp_negative(l, p) ^ gp_negative(l ^ p, r)
}

const fn raw_left_slot(_ triple: usize) -> usize { triple / 20 }
const fn raw_point_slot(_ triple: usize) -> usize { (triple / 4) % 5 }
const fn raw_right_slot(_ triple: usize) -> usize { triple % 4 }

const fn canonical_tag(_ triple: usize) -> usize {
    let l = raw_left_slot(triple)
    let r = raw_right_slot(triple)
    let l0 = l & 1
    let l1 = (l >> 1) & 1
    let r0 = r & 1
    let r1 = (r >> 1) & 1
    let same_high = 1 - (l1 ^ r1)
    let greater = l1 * (1 - r1) + same_high * l0 * (1 - r0)
    1 - greater
}

const fn diagonal_tag(_ triple: usize) -> usize {
    let l = raw_left_slot(triple)
    let r = raw_right_slot(triple)
    (1 - ((l >> 1) ^ (r >> 1))) * (1 - ((l & 1) ^ (r & 1)))
}

const fn reverse_negative(_ triple: usize) -> usize {
    let l = left_blade(triple)
    let p = middle_blade(triple)
    let r = right_blade(triple)
    gp_negative(r, p) ^ gp_negative(r ^ p, l)
}

const fn keep_tag(_ triple: usize) -> usize {
    // Canonicalize the commutative sphere-coefficient pair, then combine the
    // two ordered orientations.  Equal signs survive; opposite signs cancel.
    // (A diagonal compares with itself and therefore survives once.)
    canonical_tag(triple) * (1 - (triple_negative(triple) ^ reverse_negative(triple)))
}

const fn magnitude(_ triple: usize) -> usize {
    // A diagonal has one ordered representative.  Every surviving
    // off-diagonal group combines two equal-sign orientations.
    2 - diagonal_tag(triple)
}

const fn output_blade(_ triple: usize) -> usize {
    left_blade(triple) ^ middle_blade(triple) ^ right_blade(triple)
}

// Derive the dense survivor index from the complete 80-triple semantic
// support.  This is deliberately a scan of `keep_tag`, not a survivor table.
const fn survivor_count() -> usize {
    let mut triple: usize = 0
    let mut count: usize = 0
    while triple < 80 {
        if keep_tag(triple) != 0 { count = count + 1 }
        triple = triple + 1
    }
    count
}

const fn survivor_triple(_ target: usize) -> usize {
    let mut triple: usize = 0
    let mut seen: usize = 0
    while triple < 80 {
        if keep_tag(triple) != 0 {
            if seen == target { return triple }
            seen = seen + 1
        }
        triple = triple + 1
    }
    80
}

struct End {}
struct Triple<const I: usize> {}
struct Cons<H, T> {}
struct Zero {}
struct Term<
    const L: i32,
    const P: i32,
    const R: i32,
    const O: i32,
    const M: i32,
    const N: i32,
> {}
struct Add<L, R> {}

recursive type fn Triples<const N: usize>() -> (*) {
    match N {
        0 => End
        _ => Cons<Triple<{N - 1}>, Triples<{N - 1}>>
    }
}

// `Triples<80>` is retained as an inspectable type-level enumeration witness.
// It is not interpreted by an associated-type fold in this experiment; the
// executable schedule is constructed directly by `Schedule<32>` from the same
// 80-triple Fe support/index functions above.
type SemanticTripleWitness = Triples<80>

static_assert(survivor_count() == 32)

// Each wrapper performs the 80-triple support scan at compile time and selects
// one canonical survivor. Blade masks are at most 31 and magnitude/sign are at
// most 2/1, so their i32 schedule representation is exact. Keeping the
// decomposition inside ordinary Fe const functions lets the recursive type
// function remain a small,
// inspectable typed-plan constructor rather than expanding a truth table.
const fn schedule_left(_ i: usize) -> i32 {
    left_blade(survivor_triple(i)).downcast_unchecked()
}
const fn schedule_middle(_ i: usize) -> i32 {
    middle_blade(survivor_triple(i)).downcast_unchecked()
}
const fn schedule_right(_ i: usize) -> i32 {
    right_blade(survivor_triple(i)).downcast_unchecked()
}
const fn schedule_output(_ i: usize) -> i32 {
    output_blade(survivor_triple(i)).downcast_unchecked()
}
const fn schedule_magnitude(_ i: usize) -> i32 {
    magnitude(survivor_triple(i)).downcast_unchecked()
}
const fn schedule_negative(_ i: usize) -> i32 {
    triple_negative(survivor_triple(i)).downcast_unchecked()
}
const fn schedule8_left(_ i: usize) -> i32 { schedule_left(8 + i) }
const fn schedule8_middle(_ i: usize) -> i32 { schedule_middle(8 + i) }
const fn schedule8_right(_ i: usize) -> i32 { schedule_right(8 + i) }
const fn schedule8_output(_ i: usize) -> i32 { schedule_output(8 + i) }
const fn schedule8_magnitude(_ i: usize) -> i32 { schedule_magnitude(8 + i) }
const fn schedule8_negative(_ i: usize) -> i32 { schedule_negative(8 + i) }
const fn schedule16_left(_ i: usize) -> i32 { schedule_left(16 + i) }
const fn schedule16_middle(_ i: usize) -> i32 { schedule_middle(16 + i) }
const fn schedule16_right(_ i: usize) -> i32 { schedule_right(16 + i) }
const fn schedule16_output(_ i: usize) -> i32 { schedule_output(16 + i) }
const fn schedule16_magnitude(_ i: usize) -> i32 { schedule_magnitude(16 + i) }
const fn schedule16_negative(_ i: usize) -> i32 { schedule_negative(16 + i) }
const fn schedule24_left(_ i: usize) -> i32 { schedule_left(24 + i) }
const fn schedule24_middle(_ i: usize) -> i32 { schedule_middle(24 + i) }
const fn schedule24_right(_ i: usize) -> i32 { schedule_right(24 + i) }
const fn schedule24_output(_ i: usize) -> i32 { schedule_output(24 + i) }
const fn schedule24_magnitude(_ i: usize) -> i32 { schedule_magnitude(24 + i) }
const fn schedule24_negative(_ i: usize) -> i32 { schedule_negative(24 + i) }

recursive type fn Schedule<const N: usize>() -> (*) {
    match N {
        0 => Zero
        _ => Add<
            Term<
                { schedule_left(N - 1) },
                { schedule_middle(N - 1) },
                { schedule_right(N - 1) },
                { schedule_output(N - 1) },
                { schedule_magnitude(N - 1) },
                { schedule_negative(N - 1) },
            >,
            Schedule<{N - 1}>,
        >
    }
}

type RawSpecializedSandwich = Schedule<32>

// The compiler-facing executable view uses the same 32 CTFE-derived terms in
// four known chunks. `O` is a forwarded type parameter, while `N` remains the
// one staged descending const accepted by recursive type functions. This
// bounds recursive evaluator type depth without introducing a term table.
recursive type fn ScheduleChunk0<const N: usize>() -> (*) {
    match N {
        0 => Zero
        _ => Add<
            Term<
                { schedule_left(N - 1) },
                { schedule_middle(N - 1) },
                { schedule_right(N - 1) },
                { schedule_output(N - 1) },
                { schedule_magnitude(N - 1) },
                { schedule_negative(N - 1) },
            >,
            ScheduleChunk0<{N - 1}>,
        >
    }
}
recursive type fn ScheduleChunk8<const N: usize>() -> (*) {
    match N {
        0 => Zero
        _ => Add<
            Term<
                { schedule8_left(N - 1) },
                { schedule8_middle(N - 1) },
                { schedule8_right(N - 1) },
                { schedule8_output(N - 1) },
                { schedule8_magnitude(N - 1) },
                { schedule8_negative(N - 1) },
            >,
            ScheduleChunk8<{N - 1}>,
        >
    }
}
recursive type fn ScheduleChunk16<const N: usize>() -> (*) {
    match N {
        0 => Zero
        _ => Add<
            Term<
                { schedule16_left(N - 1) },
                { schedule16_middle(N - 1) },
                { schedule16_right(N - 1) },
                { schedule16_output(N - 1) },
                { schedule16_magnitude(N - 1) },
                { schedule16_negative(N - 1) },
            >,
            ScheduleChunk16<{N - 1}>,
        >
    }
}
recursive type fn ScheduleChunk24<const N: usize>() -> (*) {
    match N {
        0 => Zero
        _ => Add<
            Term<
                { schedule24_left(N - 1) },
                { schedule24_middle(N - 1) },
                { schedule24_right(N - 1) },
                { schedule24_output(N - 1) },
                { schedule24_magnitude(N - 1) },
                { schedule24_negative(N - 1) },
            >,
            ScheduleChunk24<{N - 1}>,
        >
    }
}

struct NatZ {}
struct NatS<N> {}
recursive type fn Nat<const N: usize>() -> (*) {
    match N {
        0 => NatZ
        _ => NatS<Nat<{N - 1}>>
    }
}
trait PlanLength { type Out }
impl PlanLength for Zero { type Out = NatZ }
impl<
    const L: i32, const P: i32, const R: i32,
    const O: i32, const M: i32, const N: i32,
    Tail: PlanLength,
> PlanLength for Add<Term<L, P, R, O, M, N>, Tail> {
    type Out = NatS<<Tail as PlanLength>::Out>
}
fn takes_nat32(_ value: Nat<32>) {}
fn specialized_schedule_has_exactly_32_terms(
    value: <RawSpecializedSandwich as PlanLength>::Out,
) { takes_nat32(value) }
// Closed sparse products. Their runtime shape is derived from support
// cardinality by CTFE instead of being repeated as Compact4/Compact5 records.
struct Nil {}
struct Cell<T> { head: f32, tail: T }
impl Copy for Nil {}
impl<T: Copy> Copy for Cell<T> {}

recursive type fn Storage<const N: usize>() -> (*) {
    match N {
        0 => Nil
        _ => Cell<Storage<{N - 1}>>
    }
}

struct Here {}
struct Next<I> {}
struct Blade<const B: i32> {}

trait Coefficient<S> { fn read(value: S) -> f32 }
impl<T> Coefficient<Cell<T>> for Here {
    fn read(value: Cell<T>) -> f32 { value.head }
}
impl<I, T> Coefficient<Cell<T>> for Next<I>
    where I: Coefficient<T>
{
    fn read(value: Cell<T>) -> f32 {
        <I as Coefficient<T>>::read(value: value.tail)
    }
}

fn coefficient<I: Coefficient<S>, S>(value: S) -> f32 {
    <I as Coefficient<S>>::read(value: value)
}

type Sphere = Storage<4>
type Point = Storage<5>

trait SphereCoefficient { fn read(value: Sphere) -> f32 }
impl SphereCoefficient for Blade<1> {
    fn read(value: Sphere) -> f32 { coefficient<Here, Sphere>(value: value) }
}
impl SphereCoefficient for Blade<2> {
    fn read(value: Sphere) -> f32 { coefficient<Next<Here>, Sphere>(value: value) }
}
impl SphereCoefficient for Blade<8> {
    fn read(value: Sphere) -> f32 { coefficient<Next<Next<Here>>, Sphere>(value: value) }
}
impl SphereCoefficient for Blade<16> {
    fn read(value: Sphere) -> f32 {
        coefficient<Next<Next<Next<Here>>>, Sphere>(value: value)
    }
}

trait PointCoefficient { fn read(value: Point) -> f32 }
impl PointCoefficient for Blade<1> {
    fn read(value: Point) -> f32 { coefficient<Here, Point>(value: value) }
}
impl PointCoefficient for Blade<2> {
    fn read(value: Point) -> f32 { coefficient<Next<Here>, Point>(value: value) }
}
impl PointCoefficient for Blade<4> {
    fn read(value: Point) -> f32 { coefficient<Next<Next<Here>>, Point>(value: value) }
}
impl PointCoefficient for Blade<8> {
    fn read(value: Point) -> f32 {
        coefficient<Next<Next<Next<Here>>>, Point>(value: value)
    }
}
impl PointCoefficient for Blade<16> {
    fn read(value: Point) -> f32 {
        coefficient<Next<Next<Next<Next<Here>>>>, Point>(value: value)
    }
}

type SpecializedSandwich = Add<
    Add<ScheduleChunk24<8>, ScheduleChunk16<8>>,
    Add<ScheduleChunk8<8>, ScheduleChunk0<8>>,
>


// Render body composed after the canonical Schedule<32> definitions in
// cga_schedule_ctfe_specialized_render.fe. The packager emits the composition as one
// standalone Fe source; this file deliberately owns no generated term table.

extern {
    fn __f32_from_i32(_: i32) -> f32
    fn __sqrt_f32(_: f32) -> f32
}

struct Vec5 { e1: f32, e2: f32, e4: f32, e8: f32, e16: f32 }
impl Copy for Vec5 {}

// Ground the recursive sparse products once per DE sample. The typed schedule
// reads this ephemeral scalar cache through blade-specific traits; no runtime
// blade selector or repeated Storage<N>/Next<I> proof graph remains per Term.
struct Prepared {
    s1: f32, s2: f32, s8: f32, s16: f32,
    p1: f32, p2: f32, p4: f32, p8: f32, p16: f32,
}
impl Copy for Prepared {}

fn prepare(sphere: Sphere, point: Point) -> Prepared {
    Prepared {
        s1: coefficient<Here, Sphere>(value: sphere),
        s2: coefficient<Next<Here>, Sphere>(value: sphere),
        s8: coefficient<Next<Next<Here>>, Sphere>(value: sphere),
        s16: coefficient<Next<Next<Next<Here>>>, Sphere>(value: sphere),
        p1: coefficient<Here, Point>(value: point),
        p2: coefficient<Next<Here>, Point>(value: point),
        p4: coefficient<Next<Next<Here>>, Point>(value: point),
        p8: coefficient<Next<Next<Next<Here>>>, Point>(value: point),
        p16: coefficient<Next<Next<Next<Next<Here>>>>, Point>(value: point),
    }
}

trait PreparedSphereCoefficient { fn read(value: Prepared) -> f32 }
impl PreparedSphereCoefficient for Blade<1> {
    fn read(value: Prepared) -> f32 { value.s1 }
}
impl PreparedSphereCoefficient for Blade<2> {
    fn read(value: Prepared) -> f32 { value.s2 }
}
impl PreparedSphereCoefficient for Blade<8> {
    fn read(value: Prepared) -> f32 { value.s8 }
}
impl PreparedSphereCoefficient for Blade<16> {
    fn read(value: Prepared) -> f32 { value.s16 }
}

trait PreparedPointCoefficient { fn read(value: Prepared) -> f32 }
impl PreparedPointCoefficient for Blade<1> {
    fn read(value: Prepared) -> f32 { value.p1 }
}
impl PreparedPointCoefficient for Blade<2> {
    fn read(value: Prepared) -> f32 { value.p2 }
}
impl PreparedPointCoefficient for Blade<4> {
    fn read(value: Prepared) -> f32 { value.p4 }
}
impl PreparedPointCoefficient for Blade<8> {
    fn read(value: Prepared) -> f32 { value.p8 }
}
impl PreparedPointCoefficient for Blade<16> {
    fn read(value: Prepared) -> f32 { value.p16 }
}

trait Eval5 {
    fn eval5(prepared: Prepared) -> Vec5
}

#[inline(always)]
fn add5(_ a: Vec5, _ b: Vec5) -> Vec5 {
    Vec5 {
        e1: a.e1 + b.e1,
        e2: a.e2 + b.e2,
        e4: a.e4 + b.e4,
        e8: a.e8 + b.e8,
        e16: a.e16 + b.e16,
    }
}

impl Eval5 for Zero {
    #[inline(always)]
    fn eval5(prepared: Prepared) -> Vec5 {
        Vec5 { e1: 0.0, e2: 0.0, e4: 0.0, e8: 0.0, e16: 0.0 }
    }
}

impl<
    const L: i32, const P: i32, const R: i32,
    const O: i32, const M: i32, const N: i32,
> Eval5 for Term<L, P, R, O, M, N>
    where Blade<L>: PreparedSphereCoefficient,
          Blade<P>: PreparedPointCoefficient,
          Blade<R>: PreparedSphereCoefficient,
{
    #[inline(always)]
    fn eval5(prepared: Prepared) -> Vec5 {
        let product: f32 =
            <Blade<L> as PreparedSphereCoefficient>::read(value: prepared)
            * <Blade<P> as PreparedPointCoefficient>::read(value: prepared)
            * <Blade<R> as PreparedSphereCoefficient>::read(value: prepared)
        let scaled: f32 = if M == 1 { product } else { product + product }
        let signed: f32 = if N == 0 { scaled } else { -scaled }
        Vec5 {
            e1: if O == 1 { signed } else { 0.0 },
            e2: if O == 2 { signed } else { 0.0 },
            e4: if O == 4 { signed } else { 0.0 },
            e8: if O == 8 { signed } else { 0.0 },
            e16: if O == 16 { signed } else { 0.0 },
        }
    }
}

impl<L: Eval5, R: Eval5> Eval5 for Add<L, R> {
    #[inline(always)]
    fn eval5(prepared: Prepared) -> Vec5 {
        add5(
            <L as Eval5>::eval5(prepared: prepared),
            <R as Eval5>::eval5(prepared: prepared),
        )
    }
}

#[inline(always)]
fn eval_specialized(prepared: Prepared) -> Vec5 {
    // Four typed chunk roots keep compiler normalization bounded while
    // preserving the canonical Schedule32 term set per DE sample.
    add5(
        add5(
            <ScheduleChunk24<8> as Eval5>::eval5(prepared: prepared),
            <ScheduleChunk16<8> as Eval5>::eval5(prepared: prepared),
        ),
        add5(
            <ScheduleChunk8<8> as Eval5>::eval5(prepared: prepared),
            <ScheduleChunk0<8> as Eval5>::eval5(prepared: prepared),
        ),
    )
}

pub fn cga_schedule32_vec5_de_render(
    px: i32,
    py: i32,
    cam_x: f32,
    cam_y: f32,
    zoom: f32,
    inv_cx: f32,
    inv_cy: f32,
) -> u32 {
    let fx: f32 = __f32_from_i32(px)
    let fy: f32 = __f32_from_i32(py)
    let sx: f32 = (fx - 64.0) * zoom
    let sy: f32 = (fy - 64.0) * zoom
    let rz: f32 = 1.8
    let inv_len: f32 = 1.0 / __sqrt_f32(sx * sx + sy * sy + rz * rz)
    let rdx: f32 = sx * inv_len
    let rdy: f32 = sy * inv_len
    let rdz: f32 = rz * inv_len

    let mut t: f32 = 0.0
    let mut i: i32 = 0
    while i < 72 {
        let x: f32 = cam_x + rdx * t
        let y: f32 = cam_y + rdy * t
        let z: f32 = -4.0 + rdz * t
        let radius2: f32 = x * x + y * y + z * z
        let center2: f32 = inv_cx * inv_cx + inv_cy * inv_cy
        let point: Point = Cell {
            head: x,
            tail: Cell {
                head: y,
                tail: Cell {
                    head: z,
                    tail: Cell {
                        head: (radius2 - 1.0) * 0.5,
                        tail: Cell {
                            head: (radius2 + 1.0) * 0.5,
                            tail: Nil {},
                        },
                    },
                },
            },
        }
        let sphere: Sphere = Cell {
            head: inv_cx,
            tail: Cell {
                head: inv_cy,
                tail: Cell {
                    head: center2 * 0.5 - 1.0,
                    tail: Cell { head: center2 * 0.5, tail: Nil {} },
                },
            },
        }

        // FOUR_CHUNK_TYPED_EVALUATION: four depth-8 typed roots preserve the
        // canonical Schedule<32> order and are balanced into all five lanes.
        let prepared: Prepared = prepare(sphere: sphere, point: point)
        let sandwich: Vec5 = eval_specialized(prepared: prepared)
        let weight: f32 = sandwich.e16 - sandwich.e8
        let safe_weight: f32 = if weight > -0.0004 { -0.0004 } else { weight }
        let weight_adjust: f32 = safe_weight - weight
        let qx: f32 = (sandwich.e1 + weight_adjust * inv_cx) / safe_weight
        let qy: f32 = (sandwich.e2 + weight_adjust * inv_cy) / safe_weight
        let qz: f32 = sandwich.e4 / safe_weight

        let tx: f32 = qx + 0.62
        let ty: f32 = qy - 0.08
        let ring_radius: f32 = __sqrt_f32(tx * tx + ty * ty) - 0.58
        let base: f32 = __sqrt_f32(ring_radius * ring_radius + qz * qz) - 0.17
        let distance: f32 = base * -safe_weight
        t = t + distance * 0.18
        if distance < 0.0022 {
            let shade: i32 = 38 + 24 * (i >> 3)
            if qy > 0.0 {
                return __bitcast(shade + 88 * 256 + (255 - shade) * 65536 + -16777216)
            }
            return __bitcast(56 + shade * 256 + 224 * 65536 + -16777216)
        }
        i = i + 1
    }
    let sky_color: i32 = 7 + 11 * 256 + 25 * 65536 + -16777216
    __bitcast(sky_color)
}


use core::{BrowserBytes, HostEffect, MainThread, Worker}
use std::webgpu::{Dispatch, WebGpuBackend}

struct FrameRequest {
    generation: u32,
    cam_x: f32,
    cam_y: f32,
    zoom: f32,
    inv_cx: f32,
    inv_cy: f32,
}

struct Submitted {
    submitted: bool,
}

struct OraclePixelRequest {
    x: i32,
    y: i32,
    cam_x: f32,
    cam_y: f32,
    zoom: f32,
    inv_cx: f32,
    inv_cy: f32,
}

struct OraclePixelResponse {
    rgba: u32,
}

pub fn render(_request: own FrameRequest) -> Submitted
    uses (HostEffect, MainThread, mut Dispatch<WebGpuBackend>)
{
    Submitted { submitted: false }
}

pub fn verify(_request: own FrameRequest) -> BrowserBytes
    uses (HostEffect, MainThread, mut Dispatch<WebGpuBackend>)
{
    BrowserBytes { ptr: 0, len: 0 }
}

pub fn oracle(_request: own FrameRequest) -> BrowserBytes
    uses (HostEffect, Worker)
{
    BrowserBytes { ptr: 0, len: 0 }
}

pub fn oracle_pixel(request: own OraclePixelRequest) -> OraclePixelResponse {
    OraclePixelResponse {
        rgba: cga_schedule32_vec5_de_render(
            px: request.x,
            py: request.y,
            cam_x: request.cam_x,
            cam_y: request.cam_y,
            zoom: request.zoom,
            inv_cx: request.inv_cx,
            inv_cy: request.inv_cy,
        ),
    }
}
