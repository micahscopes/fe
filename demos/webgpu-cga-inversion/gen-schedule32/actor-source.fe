use sparse_clifford::{Add, Zero}
use canonical_cl41_schedule::{
    Canonical50Term,
    Canonical50TypedChunk0,
    Canonical50TypedBalancedSchedule32,
}

// BEGIN_PROVIDER_EMITTER
// The exact recursive canonical50 plan is interpreted as ordinary typed Fe.
// Monomorphization sees one Eval5 instance per retained Term<Candidate>; the
// recursive planner and candidate metadata remain compile-time-only.
struct ConformalVector {
    e1: f32,
    e2: f32,
    e4: f32,
    e8: f32,
    e16: f32,
}
impl Copy for ConformalVector {}
type ConformalSphere = ConformalVector
type ConformalPoint = ConformalVector

trait Sandwich {
    fn sandwich(_ sphere: ConformalSphere, _ point: ConformalPoint) -> ConformalVector
}

trait Eval5 {
    fn eval5(_ sphere: ConformalSphere, _ point: ConformalPoint) -> ConformalVector
}

#[inline(always)]
fn add5(_ left: ConformalVector, _ right: ConformalVector) -> ConformalVector {
    ConformalVector {
        e1: left.e1 + right.e1,
        e2: left.e2 + right.e2,
        e4: left.e4 + right.e4,
        e8: left.e8 + right.e8,
        e16: left.e16 + right.e16,
    }
}

impl Eval5 for Zero {
    #[inline(always)]
    fn eval5(_ sphere: ConformalSphere, _ point: ConformalPoint) -> ConformalVector {
        ConformalVector { e1: 0.0, e2: 0.0, e4: 0.0, e8: 0.0, e16: 0.0 }
    }
}

impl<
    const Candidate: i32,
    const Left: i32,
    const Point: i32,
    const Right: i32,
    const Output: i32,
    const Magnitude: i32,
    const Negative: i32,
> Eval5
    for Canonical50Term<Candidate, Left, Point, Right, Output, Magnitude, Negative>
{
    #[inline(always)]
    fn eval5(_ sphere: ConformalSphere, _ point: ConformalPoint) -> ConformalVector {
        let mut left = sphere.e1
        if Left == 1 { left = sphere.e2 }
        if Left == 2 { left = sphere.e8 }
        if Left == 3 { left = sphere.e16 }

        let mut point_value = point.e1
        if Point == 1 { point_value = point.e2 }
        if Point == 2 { point_value = point.e4 }
        if Point == 3 { point_value = point.e8 }
        if Point == 4 { point_value = point.e16 }

        let mut right = sphere.e1
        if Right == 1 { right = sphere.e2 }
        if Right == 2 { right = sphere.e8 }
        if Right == 3 { right = sphere.e16 }

        let product = left * point_value * right
        let mut term = product
        if Magnitude == 2 {
            term = product + right * point_value * left
        }
        if Negative != 0 { term = -term }
        ConformalVector {
            e1: if Output == 1 { term } else { 0.0 },
            e2: if Output == 2 { term } else { 0.0 },
            e4: if Output == 4 { term } else { 0.0 },
            e8: if Output == 8 { term } else { 0.0 },
            e16: if Output == 16 { term } else { 0.0 },
        }
    }
}

impl<L: Eval5, R: Eval5> Eval5 for Add<L, R> {
    #[inline(always)]
    fn eval5(_ sphere: ConformalSphere, _ point: ConformalPoint) -> ConformalVector {
        add5(
            <L as Eval5>::eval5(sphere: sphere, point: point),
            <R as Eval5>::eval5(sphere: sphere, point: point),
        )
    }
}

impl Sandwich for ConformalVector {
    #[inline(always)]
    fn sandwich(_ sphere: ConformalSphere, _ point: ConformalPoint) -> ConformalVector {
        <Canonical50TypedBalancedSchedule32 as Eval5>::eval5(
            sphere: sphere, point: point,
        )
    }
}



extern {
    fn __f32_from_i32(_: i32) -> f32
    fn __i32_from_f32(_: f32) -> i32
    fn __sqrt_f32(_: f32) -> f32
    const fn __bitcast<From, To>(_: From) -> To
}

// Evidence-only scalar view of the same reflected aggregate Sandwich used by
// the renderer. It exposes all 32 Cl(4,1) blade slots without introducing a
// second plan or provider: the five vector lanes are selected directly and
// every other grade is definitionally zero for this S*P*S specialization.
pub fn cga_schedule32_all_blades(
    output: i32,
    s1: f32,
    s2: f32,
    s8: f32,
    s16: f32,
    p1: f32,
    p2: f32,
    p4: f32,
    p8: f32,
    p16: f32,
) -> i32 {
    let image: ConformalVector =
        <ConformalVector as Sandwich>::sandwich(
            ConformalVector {
                e1: s1,
                e2: s2,
                e4: 0.0,
                e8: s8,
                e16: s16,
            },
            ConformalVector {
                e1: p1,
                e2: p2,
                e4: p4,
                e8: p8,
                e16: p16,
            },
        )
    let coefficient: f32 = if output == 1 {
        image.e1
    } else if output == 2 {
        image.e2
    } else if output == 4 {
        image.e4
    } else if output == 8 {
        image.e8
    } else if output == 16 {
        image.e16
    } else {
        0.0
    }
    __i32_from_f32(coefficient * 256.0)
}

// Semantic sparse Cl(4,1) values. Their fields are exactly the compact support
// consumed by the specialized S*P*S kernel; callers do not construct or order
// raw coefficient tuples.
pub fn cga_schedule32_vec5_de_render(
    px: i32,
    py: i32,
    cam_x: f32,
    cam_y: f32,
    zoom: f32,
    inv_cx: f32,
    inv_cy: f32,
) -> u32 {
    let fx: f32 = __f32_from_i32(px)
    let fy: f32 = __f32_from_i32(py)
    let sx: f32 = (fx - 64.0) * zoom
    let sy: f32 = (fy - 64.0) * zoom
    let rz: f32 = 1.8
    let inv_len: f32 = 1.0 / __sqrt_f32(sx * sx + sy * sy + rz * rz)
    let rdx: f32 = sx * inv_len
    let rdy: f32 = sy * inv_len
    let rdz: f32 = rz * inv_len
    let center2: f32 = inv_cx * inv_cx + inv_cy * inv_cy
    let sphere: ConformalSphere = ConformalSphere {
        e1: inv_cx,
        e2: inv_cy,
        e4: 0.0,
        e8: center2 * 0.5 - 1.0,
        e16: center2 * 0.5,
    }

    let mut t: f32 = 0.0
    let mut i: i32 = 0
    while i < 72 {
        let x: f32 = cam_x + rdx * t
        let y: f32 = cam_y + rdy * t
        let z: f32 = -4.0 + rdz * t
        let radius2: f32 = x * x + y * y + z * z
        let point: ConformalPoint = ConformalPoint {
            e1: x,
            e2: y,
            e4: z,
            e8: (radius2 - 1.0) * 0.5,
            e16: (radius2 + 1.0) * 0.5,
        }

        // All five lanes are provider-emitted straight-line arithmetic derived
        // from the same canonical 80-candidate Fe helpers as Schedule32.
        let image: ConformalVector =
            <ConformalVector as Sandwich>::sandwich(sphere, point)

        let weight: f32 = image.e16 - image.e8
        let safe_weight: f32 = if weight > -0.0004 { -0.0004 } else { weight }
        let weight_adjust: f32 = safe_weight - weight
        let qx: f32 = (image.e1 + weight_adjust * inv_cx) / safe_weight
        let qy: f32 = (image.e2 + weight_adjust * inv_cy) / safe_weight
        let qz: f32 = image.e4 / safe_weight

        let tx: f32 = qx + 0.62
        let ty: f32 = qy - 0.08
        let ring_radius: f32 = __sqrt_f32(tx * tx + ty * ty) - 0.58
        let base: f32 = __sqrt_f32(ring_radius * ring_radius + qz * qz) - 0.17
        let distance: f32 = base * -safe_weight
        t = t + distance * 0.18
        if distance < 0.0022 {
            let shade: i32 = 38 + 24 * (i >> 3)
            if qy > 0.0 {
                return __bitcast(shade + 88 * 256 + (255 - shade) * 65536 + -16777216)
            }
            return __bitcast(56 + shade * 256 + 224 * 65536 + -16777216)
        }
        i = i + 1
    }
    let sky: i32 = 7 + 11 * 256 + 25 * 65536 + -16777216
    __bitcast(sky)
}


use core::{AllocatedBrowserBytes, BrowserBytes, HostEffect, MainThread}
use core::effect_ref::alloc_bytes
use core::num::IntDowncast
use std::webgpu::{Dispatch, WebGpuBackend}

struct FrameRequest {
    generation: u32,
    cam_x: f32,
    cam_y: f32,
    zoom: f32,
    inv_cx: f32,
    inv_cy: f32,
}

struct Submitted {
    submitted: bool,
}

pub fn render(_request: own FrameRequest) -> Submitted
    uses (HostEffect, MainThread, mut Dispatch<WebGpuBackend>)
{
    Submitted { submitted: false }
}

pub fn verify(_request: own FrameRequest) -> BrowserBytes
    uses (HostEffect, MainThread, mut Dispatch<WebGpuBackend>)
{
    BrowserBytes { ptr: 0, len: 0 }
}

fn append_byte(value: u32) {
    let byte = alloc_bytes(1)
    byte.write(value.downcast_truncate())
}

fn append_frame_tail(
    first_rgba: u32,
    cam_x: f32,
    cam_y: f32,
    zoom: f32,
    inv_cx: f32,
    inv_cy: f32,
) {
    append_byte(value: first_rgba >> 8)
    append_byte(value: first_rgba >> 16)
    append_byte(value: first_rgba >> 24)

    let mut y: i32 = 0
    let mut x: i32 = 1
    while y < 128 {
        while x < 128 {
            let rgba = cga_schedule32_vec5_de_render(
                px: x,
                py: y,
                cam_x: cam_x,
                cam_y: cam_y,
                zoom: zoom,
                inv_cx: inv_cx,
                inv_cy: inv_cy,
            )
            append_byte(value: rgba)
            append_byte(value: rgba >> 8)
            append_byte(value: rgba >> 16)
            append_byte(value: rgba >> 24)
            x = x + 1
        }
        y = y + 1
        x = 0
    }
}

pub fn oracle(request: own FrameRequest) -> AllocatedBrowserBytes {
    let first_rgba = cga_schedule32_vec5_de_render(
        px: 0,
        py: 0,
        cam_x: request.cam_x,
        cam_y: request.cam_y,
        zoom: request.zoom,
        inv_cx: request.inv_cx,
        inv_cy: request.inv_cy,
    )
    let first = alloc_bytes(1)
    first.write(first_rgba.downcast_truncate())
    append_frame_tail(
        first_rgba: first_rgba,
        cam_x: request.cam_x,
        cam_y: request.cam_y,
        zoom: request.zoom,
        inv_cx: request.inv_cx,
        inv_cy: request.inv_cy,
    )
    AllocatedBrowserBytes { ptr: first, len: 65536 }
}
