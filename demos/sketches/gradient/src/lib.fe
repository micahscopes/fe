//! The smallest actor that RENDERS.
//!
//! `GradientSurface` is a shader program declared as an `actor`: its uniform
//! state is the actor's fields, its one `FragmentSurface` behavior is the
//! per-pixel stage, and `fe web build --mode render` derives the render entry
//! and mode from the actor rather than from `--entry`/`--mode` flags. This is
//! the R-A1 construct on a kernel that actually lowers to WebGPU today: pure
//! f32 arithmetic, no aggregates, no division, no bitwise, no external calls
//! (only the three scalar-cast intrinsics), so it clears every current R1
//! wasm/SPIR-V wall. The interesting demos (dec, plasma) do not yet; this one
//! is the honest "an actor you can see".
//!
//! Software rendering (lavapipe/SwiftShader) in the sandbox; no performance
//! claim, no parallelism claim (VISION 3.1).

use std::webgpu::{FragmentSurface, GpuProgram, WebGpuBackend}

extern {
    fn __f32_from_i32(_: i32) -> f32
    fn __i32_from_f32(_: f32) -> i32
}

actor GradientSurface uses (GpuProgram<WebGpuBackend>) {
    gain: f32,
    bias: f32,
    cutoff: f32,

    /// The fragment behavior: pixel coordinate in, packed RGBA8 word out. The
    /// uniform record is the actor's own fields, reached as `self.*`.
    fn shade(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        let x: f32 = __f32_from_i32(px)
        let y: f32 = __f32_from_i32(py)
        let mut value: f32 = (x + y) * self.gain + self.bias
        let mut i: i32 = 0
        while i < 3 {
            value = value * 0.5 + self.bias
            if value > self.cutoff {
                let hot: i32 = __i32_from_f32(value)
                return hot + hot * 256 + 16711680 + -16777216
            }
            i = i + 1
        }
        let cool: i32 = __i32_from_f32(value)
        cool + 65280 + cool * 65536 + -16777216
    }
}
