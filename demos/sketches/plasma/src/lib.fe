//! Interference plasma.
//!
//! `fe web` in `--mode render` hands a function two builtin inputs, the pixel
//! coordinates, followed by however many `f32` uniforms the signature declares,
//! and expects a packed RGBA8 word back. That contract is already the shape of
//! a fragment shader, so a sketch is one function and nothing else.
//!
//!     fe web build demos/sketches/plasma --entry plasma --mode render --out <dir>

use fmath::{from_i32, palette, sin, sqrt}

const RESOLUTION: f32 = 128.0

/// Three plane waves and one radial wave, summed and read through a palette.
/// `time` advances it; `zoom` and `warp` are exposed so the page can drive them.
pub fn plasma(
    px: i32, py: i32,
    time: f32,
    zoom: f32,
    warp: f32,
) -> i32 {
    // Pixel centre to [-1, 1], y up.
    let u: f32 = (from_i32(px) + 0.5) / RESOLUTION * 2.0 - 1.0
    let v: f32 = 1.0 - (from_i32(py) + 0.5) / RESOLUTION * 2.0

    let x: f32 = u * zoom
    let y: f32 = v * zoom
    let radius: f32 = sqrt(x * x + y * y)

    let mut field: f32 = sin(x + time)
    field = field + sin(y * 1.3 - time * 0.7)
    field = field + sin((x + y) * 0.8 + time * 0.3)
    field = field + sin(radius * 2.1 - time * 1.1) * warp

    // Four waves in [-1, 1] each; fold the sum back into a unit interval.
    palette(field * 0.125 + 0.5, 0.0, 0.33, 0.67)
}
