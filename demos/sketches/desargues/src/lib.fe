//! Desargues' theorem, drawn per pixel from compiled PGA-2D meet/join.
//!
//! This is the ganja.js `pga2d_desargues_theorem` exhibit, in Fe: every line
//! and every point on screen is a projective incidence computed by the
//! type-level wedge `gaplay::pga2_wedge3` (dual-gated bit-for-bit
//! against a hand-tabled cross product in crates/codegen/tests/
//! pga2d_meet_join_plan.rs). `gaplay` states the named PGA basis and
//! `Wedge<Left, Right>` expression; FCO derives support, signs, and the compact
//! result, then emits ordinary branch-free arithmetic into the shader.
//!
//! The picture: a centre of perspectivity O and a base triangle A, B, C; a
//! second triangle A'B'C' whose vertices slide along the rays O->A/B/C (so the
//! two triangles are perspective from the point O by construction). ganja's
//! idiom, transliterated:
//!   line through two points   P & Q   -> gaplay::join(P, Q)
//!   intersection of two lines  L ^ M   -> gaplay::meet(L, M)
//! Desargues' theorem: the three intersections of corresponding sides,
//!   Pa = meet(BC, B'C'),  Pb = meet(CA, C'A'),  Pc = meet(AB, A'B'),
//! are COLLINEAR -- they lie on one line, the axis of perspectivity, which is
//! `join(Pa, Pb)`. The demo draws that axis in gold and puts a gold dot at each
//! cross-point; they sit ON the axis for every value of the sweep, which is the
//! theorem being true, live.
//!
//! Controls (the interactive ctl.fe update_desargues fn): drag horizontally to
//! sweep the second triangle along the rays (the whole figure reconfigures and
//! the axis moves, but the three points stay collinear); drag vertically to
//! spin the view; wheel to zoom.
//!
//! Software rendering (lavapipe/SwiftShader) in the sandbox; no performance or
//! parallelism claim.
//!
//!     fe web build demos/sketches/desargues --out <dir>

use core::marker::Copy
use std::webgpu::{
    FragmentSurface, GpuProgram, LatestPerFrame, ResponsiveBacking,
    StandardSurfaceRecovery, SurfaceQuality, SurfaceRecovery, SurfaceScheduling,
    SurfaceTransition, WebGpuBackend,
}
use gaplay::{
    DESA_FB, DESA_FC, Line, Point, desa_a, desa_b, desa_c, desa_o, desargues_image,
    join, line_eval, meet, point_world_x, point_world_y,
}
use std::web::view::{
    ApplyParamBindings, Extent, Param, ParamBindingsProvider, Surface,
    SurfaceEvent, SurfaceState,
}
use fmath::{abs, clamp01, cos, from_i32, rgba, sin, smoothstep, sqrt}
use gallery_palette::{
    clean_white, electric_blue, evidence_gold, guide, midnight, spring_green,
    theorem_gold,
}

/// Perpendicular distance-based line coverage: 1 on the line, fading over `w`.
fn line_cover(_ l: Line, _ x: f32, _ y: f32, _ w: f32) -> f32 {
    let grad: f32 = sqrt(l.c1 * l.c1 + l.c2 * l.c2) + 0.0000001
    let dist: f32 = abs(line_eval(l, x, y)) / grad
    1.0 - smoothstep(0.0, w, dist)
}

/// Round-dot coverage at a world point, fading over radius `r`.
fn dot_cover(_ pwx: f32, _ pwy: f32, _ x: f32, _ y: f32, _ r: f32) -> f32 {
    let dx: f32 = x - pwx
    let dy: f32 = y - pwy
    let dist: f32 = sqrt(dx * dx + dy * dy)
    1.0 - smoothstep(0.0, r, dist)
}

// ---------------------------------------------------------------------------
// THE ACTOR: three uniforms (sweep, spin, zoom), one per-pixel behaviour. The
// interactive boundary is DECLARED in `view()` (web v5); `res` is bound to
// the live canvas width, replacing the baked `const RESOLUTION`.
// ---------------------------------------------------------------------------

/// The per-demo params record: field names bind, by name identity, to the
/// actor's state fields (checked at projection time).
struct DesarguesParams {
    sweep: Param,
    spin: Param,
    zoom: Param,
    res: Param,
}

struct DesarguesViewState {
    sweep: f32,
    spin: f32,
    zoom: f32,
    res: f32,
}

impl SurfaceState for DesarguesViewState {
    type Params = DesarguesParams
}

derive ApplyParamBindings for DesarguesViewState using ParamBindingsProvider

const fn desargues_params() -> DesarguesParams {
    DesarguesParams {
        sweep: Param::range(min: 0.3, max: 1.6, init: 0.62)
            .drag_x(per_px: 0.0025),
        spin: Param::angle(init: 0.0).drag_y(per_px: 0.01),
        zoom: Param::range(min: 0.8, max: 5.0, init: 2.4)
            .wheel_scale(in_factor: 0.875, out_factor: 1.125),
        res: Param::extent_x(),
    }
}

actor Desargues2d uses (
    GpuProgram<WebGpuBackend>, SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    /// Perspective sweep: slides the second triangle along the rays from O.
    sweep: f32,
    /// View rotation, in radians.
    spin: f32,
    /// Half-extent of the visible square, in world units.
    zoom: f32,
    /// Surface extent in pixels (runtime-fed; replaces `const RESOLUTION`).
    res: f32,

    /// The surface declaration: CTFE-evaluated at bundle time and projected
    /// into the manifest `surface` section. Never lowered to wasm or WGSL.
    const fn view() -> Surface<DesarguesParams> {
        Surface {
            extent: Extent::square(512),
            params: desargues_params(),
        }
    }

    /// Drag reconfigures and rotates the theorem; wheel changes view scale.
    fn navigate(self, event: own SurfaceEvent) -> DesarguesViewState
        uses (SurfaceTransition, SurfaceScheduling<LatestPerFrame>)
    {
        let current = DesarguesViewState {
            sweep: self.sweep,
            spin: self.spin,
            zoom: self.zoom,
            res: self.res,
        }
        current.apply_param_bindings(desargues_params(), event)
    }

    fn shade(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        // Pixel centre -> view coordinates, then rotate by -spin into the
        // canonical frame the geometry is authored in (so the figure appears
        // rotated by +spin without touching the algebra).
        let u: f32 = ((from_i32(px) + 0.5) / self.res * 2.0 - 1.0) * self.zoom
        let v: f32 = (1.0 - (from_i32(py) + 0.5) / self.res * 2.0) * self.zoom
        let cs: f32 = cos(self.spin)
        let sn: f32 = sin(self.spin)
        let x: f32 = cs * u + sn * v
        let y: f32 = 0.0 - sn * u + cs * v

        // The Desargues configuration, all through FCO-compiled meet/join.
        let o: Point = desa_o()
        let a: Point = desa_a()
        let b: Point = desa_b()
        let c: Point = desa_c()
        let ap: Point = desargues_image(a, self.sweep)
        let bp: Point = desargues_image(b, self.sweep * DESA_FB)
        let cp: Point = desargues_image(c, self.sweep * DESA_FC)

        // Triangle side lines (join = connecting line).
        let l_ab: Line = join(a, b)
        let l_bc: Line = join(b, c)
        let l_ca: Line = join(c, a)
        let l_apbp: Line = join(ap, bp)
        let l_bpcp: Line = join(bp, cp)
        let l_cpap: Line = join(cp, ap)

        // Perspectivity rays from O.
        let r_a: Line = join(o, a)
        let r_b: Line = join(o, b)
        let r_c: Line = join(o, c)

        // The three corresponding-side intersections (meet) and the axis of
        // perspectivity through two of them. The theorem: the third is on it.
        let pa: Point = meet(l_bc, l_bpcp)
        let pb: Point = meet(l_ca, l_cpap)
        let pc: Point = meet(l_ab, l_apbp)
        let axis: Line = join(pa, pb)

        let pw: f32 = self.zoom * 2.0 / self.res
        let thin: f32 = pw * 1.3
        let thick: f32 = pw * 2.1
        let rdot: f32 = pw * 3.4

        // The original Desargues palette is now the shared gallery vocabulary.
        let ground = midnight()
        let guide_color = guide()
        let cool = electric_blue()
        let warm = spring_green()
        let gold = theorem_gold()
        let evidence = evidence_gold()
        let white = clean_white()
        let mut red: f32 = ground.red
        let mut grn: f32 = ground.green
        let mut blu: f32 = ground.blue

        // Rays from O (faint gray).
        let rays: f32 =
            line_cover(r_a, x, y, thin) + line_cover(r_b, x, y, thin) + line_cover(r_c, x, y, thin)
        red = red + guide_color.red * rays
        grn = grn + guide_color.green * rays
        blu = blu + guide_color.blue * rays

        // Triangle 1 sides (blue).
        let t1: f32 =
            line_cover(l_ab, x, y, thin) + line_cover(l_bc, x, y, thin) + line_cover(l_ca, x, y, thin)
        red = red + cool.red * t1
        grn = grn + cool.green * t1
        blu = blu + cool.blue * t1

        // Triangle 2 sides (green).
        let t2: f32 =
            line_cover(l_apbp, x, y, thin) + line_cover(l_bpcp, x, y, thin) + line_cover(l_cpap, x, y, thin)
        red = red + warm.red * t2
        grn = grn + warm.green * t2
        blu = blu + warm.blue * t2

        // The axis of perspectivity (gold, thicker).
        let ax: f32 = line_cover(axis, x, y, thick)
        red = red + gold.red * ax
        grn = grn + gold.green * ax
        blu = blu + gold.blue * ax

        // Vertex dots (white): O, the two triangles.
        let verts: f32 =
            dot_cover(point_world_x(o), point_world_y(o), x, y, rdot)
            + dot_cover(point_world_x(a), point_world_y(a), x, y, rdot)
            + dot_cover(point_world_x(b), point_world_y(b), x, y, rdot)
            + dot_cover(point_world_x(c), point_world_y(c), x, y, rdot)
            + dot_cover(point_world_x(ap), point_world_y(ap), x, y, rdot)
            + dot_cover(point_world_x(bp), point_world_y(bp), x, y, rdot)
            + dot_cover(point_world_x(cp), point_world_y(cp), x, y, rdot)
        red = red + white.red * verts
        grn = grn + white.green * verts
        blu = blu + white.blue * verts

        // Cross-point dots (hot gold, on the axis): the theorem, made visible.
        let cross: f32 =
            dot_cover(point_world_x(pa), point_world_y(pa), x, y, rdot)
            + dot_cover(point_world_x(pb), point_world_y(pb), x, y, rdot)
            + dot_cover(point_world_x(pc), point_world_y(pc), x, y, rdot)
        red = red + evidence.red * cross
        grn = grn + evidence.green * cross
        blu = blu + evidence.blue * cross

        rgba(clamp01(red), clamp01(grn), clamp01(blu))
    }
}
