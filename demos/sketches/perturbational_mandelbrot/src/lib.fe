//! Perturbation Mandelbrot as a typed compute -> fragment graph.
//!
//! One `Fixed<8>` orbit is built per frame. Every pixel then runs only the
//! compact binary32 delta recurrence around that shared reference.

use std::webgpu::{
    ComputeSurface as ReferencePass,
    FixedDispatch as Once,
    FragmentSurface as Display,
    GpuProgram as PassGraph,
    StorageBuffer as OrbitBuffer,
    SurfaceTransition,
    Workgroup as Threads,
    WebGpuBackend,
}
use std::web::view::{Extent, Param, Surface, SurfaceEvent}
use fmath::{abs, from_i32, max, palette}
use precision::{add_f32, from_quad, sub, to_quad, two_sum}
use precision::fixed::{from_f32, from_qf_offset, mandelbrot_advance8, to_f32_quad_bits}

extern {
    const fn __bitcast<From, To>(_: From) -> To
}

const MAX_ITER_BASE: u32 = 256
const MAX_ITER_CAP: u32 = 2000
const DEPTH_PROBE_STEPS: u32 = 96
const ITER_PER_DOUBLING: u32 = 64
const PALETTE_PERIOD: f32 = 256.0
const ORBIT_SAMPLES: usize = 2003
const ORBIT_CENTER_INDEX: u32 = 2001
const ORBIT_META_INDEX: u32 = 2002
const INVALID_REFERENCE: u32 = 2143289344
const CENTER_X_MIN: f32 = -2.5
const CENTER_X_MAX: f32 = 1.0
const CENTER_Y_MIN: f32 = -1.5
const CENTER_Y_MAX: f32 = 1.5
const ZOOM_MIN: f32 = 0.000000000000000000000000001
const ZOOM_MAX: f32 = 3.0

fn zoom_step(_ zoom: f32, _ dzoom: f32) -> f32 {
    if dzoom < 0.0 {
        zoom * 0.875
    } else {
        if dzoom > 0.0 { zoom * 1.125 } else { zoom }
    }
}

fn clamp_f(_ value: f32, _ lower: f32, _ upper: f32) -> f32 {
    if value < lower {
        lower
    } else {
        if value > upper { upper } else { value }
    }
}

fn clamp_quad(
    _ w0: f32, _ w1: f32, _ w2: f32, _ w3: f32,
    _ lower: f32, _ upper: f32,
) -> (f32, f32, f32, f32) {
    if w0 < lower {
        (lower, 0.0, 0.0, 0.0)
    } else {
        if w0 > upper { (upper, 0.0, 0.0, 0.0) } else { (w0, w1, w2, w3) }
    }
}

pub struct ComplexQF32Bits {
    pub re_w0_bits: u32,
    pub re_w1_bits: u32,
    pub re_w2_bits: u32,
    pub re_w3_bits: u32,
    pub im_w0_bits: u32,
    pub im_w1_bits: u32,
    pub im_w2_bits: u32,
    pub im_w3_bits: u32,
}

fn invalid_reference(_ sample: ComplexQF32Bits) -> bool {
    sample.re_w0_bits == INVALID_REFERENCE || sample.im_w0_bits == INVALID_REFERENCE
}

fn non_finite(_ value: f32) -> bool { value - value != 0.0 }

/// Collapse an exact four-word reference plus the pixel delta without losing
/// the reference tail when `w0` and `delta` nearly cancel. The ordinary
/// `w0 + w1 + w2 + w3 + delta` ordering discards every low word before the
/// cancellation happens, which poisons both bailout and center reanchoring.
fn reference_plus_delta(
    _ w0: f32, _ w1: f32, _ w2: f32, _ w3: f32, _ delta: f32,
) -> f32 {
    let (s0, e0) = two_sum(w0, delta)
    let (s1, e1) = two_sum(s0, w1)
    let (s2, e2) = two_sum(s1, w2)
    let (s3, e3) = two_sum(s2, w3)
    s3 + (((e3 + e2) + e1) + e0)
}

/// A uniform iteration budget computed once by the reference pass. The pixel
/// pass reads the result from orbit metadata and does no depth probing.
fn iteration_limit(_ zoom: f32) -> u32 {
    let mut z: f32 = zoom
    let mut depth: u32 = 0
    let mut i: u32 = 0
    while i < DEPTH_PROBE_STEPS {
        if z < 1.0 {
            z = z * 2.0
            depth = depth + 1
        }
        i = i + 1
    }
    let scaled: u32 = MAX_ITER_BASE + depth * ITER_PER_DOUBLING
    if scaled > MAX_ITER_CAP { MAX_ITER_CAP } else { scaled }
}

struct MandelbrotParams {
    center_x_w0: Param,
    center_x_w1: Param,
    center_x_w2: Param,
    center_x_w3: Param,
    center_y_w0: Param,
    center_y_w1: Param,
    center_y_w2: Param,
    center_y_w3: Param,
    zoom: Param,
    res: Param,
}

struct MandelbrotViewState {
    center_x_w0: f32,
    center_x_w1: f32,
    center_x_w2: f32,
    center_x_w3: f32,
    center_y_w0: f32,
    center_y_w1: f32,
    center_y_w2: f32,
    center_y_w3: f32,
    zoom: f32,
    res: f32,
}

actor PerturbationalMandelbrot uses (PassGraph<WebGpuBackend>) {
    orbit: OrbitBuffer<ComplexQF32Bits, ORBIT_SAMPLES>,
    /// Most-significant word of a four-word center expansion. Fe gesture math
    /// updates this and the three hidden low words together.
    center_x_w0: f32,
    center_x_w1: f32,
    center_x_w2: f32,
    center_x_w3: f32,
    /// Most-significant word of the four-word vertical center expansion.
    center_y_w0: f32,
    center_y_w1: f32,
    center_y_w2: f32,
    center_y_w3: f32,
    zoom: f32,
    res: f32,

    const fn view() -> Surface<MandelbrotParams> {
        Surface {
            extent: Extent::square(512),
            params: MandelbrotParams {
                center_x_w0: Param::range(min: -2.5, max: 1.0, init: -0.7436438798904419),
                center_x_w1: Param::fixed(-0.0000000071467170),
                center_x_w2: Param::fixed(-0.0000000000000003),
                center_x_w3: Param::fixed(-0.00000000000000000000002),
                center_y_w0: Param::range(min: -1.5, max: 1.5, init: 0.1318259090185165),
                center_y_w1: Param::fixed(-0.0000000048132045),
                center_y_w2: Param::fixed(0.00000000000000025),
                center_y_w3: Param::fixed(0.000000000000000000000015),
                zoom: Param::log(min: 0.000000000000000000000000001, max: 3.0, init: 1.0),
                res: Param::extent_x(),
            },
        }
    }

    fn build_reference(self)
        uses (ReferencePass<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        let (cx_s, cx) = from_qf_offset<8>(
            self.center_x_w0, self.center_x_w1, self.center_x_w2, self.center_x_w3, 0.0)
        let (cy_s, cy) = from_qf_offset<8>(
            self.center_y_w0, self.center_y_w1, self.center_y_w2, self.center_y_w3, 0.0)
        let (zero_s, zero) = from_f32<8>(0.0)
        let mut zx_s: u32 = zero_s
        let mut zx = zero
        let mut zy_s: u32 = zero_s
        let mut zy = zero
        let mut valid: u32 = 1
        let mut i: u32 = 0
        let max_iter: u32 = iteration_limit(self.zoom)

        // Preserve the precise center actually used by the Fixed reference.
        // The requested four-word center can move between adjacent Fixed<8>
        // grid points at the deepest zooms; the pixel pass carries that
        // residual as part of dc instead of letting the view stick and jump.
        let (cx_w0, cx_w1, cx_w2, cx_w3) = to_f32_quad_bits<8>(cx_s, cx)
        let (cy_w0, cy_w1, cy_w2, cy_w3) = to_f32_quad_bits<8>(cy_s, cy)
        self.orbit.store(
            index: ORBIT_CENTER_INDEX,
            value: ComplexQF32Bits {
                re_w0_bits: cx_w0,
                re_w1_bits: cx_w1,
                re_w2_bits: cx_w2,
                re_w3_bits: cx_w3,
                im_w0_bits: cy_w0,
                im_w1_bits: cy_w1,
                im_w2_bits: cy_w2,
                im_w3_bits: cy_w3,
            },
        )

        self.orbit.store(
            index: ORBIT_META_INDEX,
            value: ComplexQF32Bits {
                re_w0_bits: max_iter + 1,
                re_w1_bits: max_iter,
                re_w2_bits: 0,
                re_w3_bits: 0,
                im_w0_bits: 0,
                im_w1_bits: 0,
                im_w2_bits: 0,
                im_w3_bits: 0,
            },
        )
        self.orbit.store(
            index: 0,
            value: ComplexQF32Bits {
                re_w0_bits: 0,
                re_w1_bits: 0,
                re_w2_bits: 0,
                re_w3_bits: 0,
                im_w0_bits: 0,
                im_w1_bits: 0,
                im_w2_bits: 0,
                im_w3_bits: 0,
            },
        )
        while i < max_iter {
            if valid == 1 {
                let (next_x_s, next_x, next_y_s, next_y, did_escape) =
                    mandelbrot_advance8(zx_s, zx, zy_s, zy, cx_s, cx, cy_s, cy)
                let (next_re_w0, next_re_w1, next_re_w2, next_re_w3) =
                    to_f32_quad_bits<8>(next_x_s, next_x)
                let (next_im_w0, next_im_w1, next_im_w2, next_im_w3) =
                    to_f32_quad_bits<8>(next_y_s, next_y)
                self.orbit.store(
                    index: i + 1,
                    value: ComplexQF32Bits {
                        re_w0_bits: next_re_w0,
                        re_w1_bits: next_re_w1,
                        re_w2_bits: next_re_w2,
                        re_w3_bits: next_re_w3,
                        im_w0_bits: next_im_w0,
                        im_w1_bits: next_im_w1,
                        im_w2_bits: next_im_w2,
                        im_w3_bits: next_im_w3,
                    },
                )
                if did_escape == 1 {
                    valid = 0
                    self.orbit.store(
                        index: ORBIT_META_INDEX,
                        value: ComplexQF32Bits {
                            re_w0_bits: i + 2,
                            re_w1_bits: max_iter,
                            re_w2_bits: 0,
                            re_w3_bits: 0,
                            im_w0_bits: 0,
                            im_w1_bits: 0,
                            im_w2_bits: 0,
                            im_w3_bits: 0,
                        },
                    )
                } else {
                    zx_s = next_x_s
                    zx = next_x
                    zy_s = next_y_s
                    zy = next_y
                }
            } else {
                self.orbit.store(
                    index: i + 1,
                    value: ComplexQF32Bits {
                        re_w0_bits: INVALID_REFERENCE,
                        re_w1_bits: 0,
                        re_w2_bits: 0,
                        re_w3_bits: 0,
                        im_w0_bits: INVALID_REFERENCE,
                        im_w1_bits: 0,
                        im_w2_bits: 0,
                        im_w3_bits: 0,
                    },
                )
            }
            i = i + 1
        }
    }

    fn display_reference(self, px: i32, py: i32) -> i32 uses (Display) {
        let u: f32 = (from_i32(px) + 0.5) / self.res * 2.0 - 1.0
        let v: f32 = 1.0 - (from_i32(py) + 0.5) / self.res * 2.0
        let center_reference: ComplexQF32Bits = self.orbit.load(index: ORBIT_CENTER_INDEX)
        let center_ref_re_w0: f32 = __bitcast(center_reference.re_w0_bits)
        let center_ref_re_w1: f32 = __bitcast(center_reference.re_w1_bits)
        let center_ref_re_w2: f32 = __bitcast(center_reference.re_w2_bits)
        let center_ref_re_w3: f32 = __bitcast(center_reference.re_w3_bits)
        let center_ref_im_w0: f32 = __bitcast(center_reference.im_w0_bits)
        let center_ref_im_w1: f32 = __bitcast(center_reference.im_w1_bits)
        let center_ref_im_w2: f32 = __bitcast(center_reference.im_w2_bits)
        let center_ref_im_w3: f32 = __bitcast(center_reference.im_w3_bits)
        let center_remainder_re = sub<4>(
            from_quad(
                self.center_x_w0, self.center_x_w1,
                self.center_x_w2, self.center_x_w3,
            ),
            from_quad(
                center_ref_re_w0, center_ref_re_w1,
                center_ref_re_w2, center_ref_re_w3,
            ),
        )
        let center_remainder_im = sub<4>(
            from_quad(
                self.center_y_w0, self.center_y_w1,
                self.center_y_w2, self.center_y_w3,
            ),
            from_quad(
                center_ref_im_w0, center_ref_im_w1,
                center_ref_im_w2, center_ref_im_w3,
            ),
        )
        let (dc_re_w0, dc_re_w1, dc_re_w2, dc_re_w3) = to_quad(center_remainder_re)
        let (dc_im_w0, dc_im_w1, dc_im_w2, dc_im_w3) = to_quad(center_remainder_im)
        let dc_re: f32 = reference_plus_delta(
            dc_re_w0, dc_re_w1, dc_re_w2, dc_re_w3, u * self.zoom,
        )
        let dc_im: f32 = reference_plus_delta(
            dc_im_w0, dc_im_w1, dc_im_w2, dc_im_w3, v * self.zoom,
        )
        let metadata: ComplexQF32Bits = self.orbit.load(index: ORBIT_META_INDEX)
        let valid_samples: u32 = metadata.re_w0_bits
        let max_iter: u32 = metadata.re_w1_bits
        let mut dz_re: f32 = 0.0
        let mut dz_im: f32 = 0.0
        let mut z_re: f32 = 0.0
        let mut z_im: f32 = 0.0
        let mut reference_i: u32 = 0
        let mut escaped: u32 = 0
        let mut glitched: u32 = 0
        let mut count: u32 = max_iter
        let mut escape_magnitude: f32 = 4.0
        let mut i: u32 = 0

        while i < max_iter {
            if escaped == 0 && glitched == 0 {
                if reference_i + 1 >= valid_samples {
                    reference_i = 0
                    dz_re = z_re
                    dz_im = z_im
                }
                let reference: ComplexQF32Bits = self.orbit.load(index: reference_i)
                let next_reference: ComplexQF32Bits = self.orbit.load(index: reference_i + 1)
                if invalid_reference(reference) || invalid_reference(next_reference) {
                    glitched = 1
                } else {
                    let ref_re_w0: f32 = __bitcast(reference.re_w0_bits)
                    let ref_re_w1: f32 = __bitcast(reference.re_w1_bits)
                    let ref_re_w2: f32 = __bitcast(reference.re_w2_bits)
                    let ref_re_w3: f32 = __bitcast(reference.re_w3_bits)
                    let ref_im_w0: f32 = __bitcast(reference.im_w0_bits)
                    let ref_im_w1: f32 = __bitcast(reference.im_w1_bits)
                    let ref_im_w2: f32 = __bitcast(reference.im_w2_bits)
                    let ref_im_w3: f32 = __bitcast(reference.im_w3_bits)
                    let next_ref_re_w0: f32 = __bitcast(next_reference.re_w0_bits)
                    let next_ref_re_w1: f32 = __bitcast(next_reference.re_w1_bits)
                    let next_ref_re_w2: f32 = __bitcast(next_reference.re_w2_bits)
                    let next_ref_re_w3: f32 = __bitcast(next_reference.re_w3_bits)
                    let next_ref_im_w0: f32 = __bitcast(next_reference.im_w0_bits)
                    let next_ref_im_w1: f32 = __bitcast(next_reference.im_w1_bits)
                    let next_ref_im_w2: f32 = __bitcast(next_reference.im_w2_bits)
                    let next_ref_im_w3: f32 = __bitcast(next_reference.im_w3_bits)
                    let linear_re_w0: f32 =
                        ref_re_w0 * dz_re - ref_im_w0 * dz_im
                    let linear_re_tail: f32 =
                        ref_re_w1 * dz_re - ref_im_w1 * dz_im
                        + ref_re_w2 * dz_re - ref_im_w2 * dz_im
                        + ref_re_w3 * dz_re - ref_im_w3 * dz_im
                    let linear_im_w0: f32 =
                        ref_re_w0 * dz_im + ref_im_w0 * dz_re
                    let linear_im_tail: f32 =
                        ref_re_w1 * dz_im + ref_im_w1 * dz_re
                        + ref_re_w2 * dz_im + ref_im_w2 * dz_re
                        + ref_re_w3 * dz_im + ref_im_w3 * dz_re
                    let next_dz_re: f32 =
                        2.0 * linear_re_w0 + 2.0 * linear_re_tail
                        + (dz_re * dz_re - dz_im * dz_im) + dc_re
                    let next_dz_im: f32 =
                        2.0 * linear_im_w0 + 2.0 * linear_im_tail
                        + 2.0 * dz_re * dz_im + dc_im
                    let target_re: f32 = reference_plus_delta(
                        next_ref_re_w0, next_ref_re_w1, next_ref_re_w2,
                        next_ref_re_w3, next_dz_re,
                    )
                    let target_im: f32 = reference_plus_delta(
                        next_ref_im_w0, next_ref_im_w1, next_ref_im_w2,
                        next_ref_im_w3, next_dz_im,
                    )
                    let magnitude: f32 = target_re * target_re + target_im * target_im
                    let delta_magnitude: f32 =
                        next_dz_re * next_dz_re + next_dz_im * next_dz_im
                    // Rebase whenever the absolute orbit is smaller than its
                    // current perturbation. This keeps the next delta small
                    // and is the useful cancellation condition, rather than
                    // waiting for a five-order-of-magnitude collapse.
                    let cancellation: bool = magnitude < delta_magnitude
                    let ambiguous_escape: bool =
                        magnitude > 4.0
                        && abs(magnitude - 4.0) <= 0.000004 * max(1.0, magnitude)

                    if non_finite(next_dz_re)
                        || non_finite(next_dz_im)
                        || non_finite(magnitude)
                        || ambiguous_escape
                    {
                        glitched = 1
                    } else {
                        dz_re = next_dz_re
                        dz_im = next_dz_im
                        z_re = target_re
                        z_im = target_im
                        if magnitude > 4.0 {
                            escaped = 1
                            count = i + 1
                            escape_magnitude = magnitude
                        } else {
                            if cancellation {
                                reference_i = 0
                                dz_re = z_re
                                dz_im = z_im
                            } else {
                                reference_i = reference_i + 1
                            }
                        }
                    }
                }
            }
            i = i + 1
        }

        if glitched == 1 {
            -65281
        } else {
            if escaped == 1 {
                let smooth_count: f32 = from_i32(count.downcast_truncate())
                    + 4.0 / escape_magnitude
                let t: f32 = smooth_count / PALETTE_PERIOD
                palette(t, 0.0, 0.33, 0.67)
            } else {
                -16777216
            }
        }
    }

    fn navigate(self, event: own SurfaceEvent) -> MandelbrotViewState
        uses (SurfaceTransition)
    {
        let dx: f32 = event.delta_x
        let dy: f32 = event.delta_y
        let dzoom: f32 = event.wheel_delta
        let mx: f32 = event.pointer_x
        let my: f32 = event.pointer_y
        let res: f32 = event.width
        let step: f32 = 2.0 * self.zoom / res
        let (cx0, cx1, cx2, cx3) = to_quad(add_f32<4>(
            from_quad(self.center_x_w0, self.center_x_w1, self.center_x_w2, self.center_x_w3),
            -dx * step,
        ))
        let (cy0, cy1, cy2, cy3) = to_quad(add_f32<4>(
            from_quad(self.center_y_w0, self.center_y_w1, self.center_y_w2, self.center_y_w3),
            dy * step,
        ))
        let next_zoom: f32 = clamp_f(zoom_step(self.zoom, dzoom), ZOOM_MIN, ZOOM_MAX)
        let u: f32 = (mx + 0.5) * 2.0 / res - 1.0
        let v: f32 = 1.0 - (my + 0.5) * 2.0 / res
        let (ax0, ax1, ax2, ax3) = to_quad(add_f32<4>(
            from_quad(cx0, cx1, cx2, cx3), u * (self.zoom - next_zoom),
        ))
        let (ay0, ay1, ay2, ay3) = to_quad(add_f32<4>(
            from_quad(cy0, cy1, cy2, cy3), v * (self.zoom - next_zoom),
        ))
        let (nx0, nx1, nx2, nx3) =
            clamp_quad(ax0, ax1, ax2, ax3, CENTER_X_MIN, CENTER_X_MAX)
        let (ny0, ny1, ny2, ny3) =
            clamp_quad(ay0, ay1, ay2, ay3, CENTER_Y_MIN, CENTER_Y_MAX)
        MandelbrotViewState {
            center_x_w0: nx0,
            center_x_w1: nx1,
            center_x_w2: nx2,
            center_x_w3: nx3,
            center_y_w0: ny0,
            center_y_w1: ny1,
            center_y_w2: ny2,
            center_y_w3: ny3,
            zoom: next_zoom,
            res,
        }
    }
}
