//! Mandelbrot escape-time, as an actor that RENDERS.
//!
//! The oldest fractal, now a fragment behavior. `MandelbrotSurface` maps each
//! pixel to a point `c` in the complex plane, iterates `z <- z*z + c` until it
//! escapes the disc of radius two, and reads the escape count through a palette.
//! Points that never escape are the set itself, drawn black.
//!
//! The iteration is a real loop with a nested branch, so this demo only lowers
//! now that the SPIR-V structurizer emits loops with inner conditionals. It is
//! written without early `return` from the loop, without `bool`, and without
//! `&&`: an `i32` `done` flag freezes the orbit after escape (so the count is
//! preserved and `z` never blows to NaN) and the loop runs a fixed trip count.
//!
//! DEEP ZOOM, GPU-FAITHFUL (`precision::fixed::Fixed<8>`). A float expansion
//! (df64 / `Expansion<2>`) is correct only under strict IEEE round-to-nearest,
//! which wasm/native/CPU guarantee, but WGSL explicitly licenses the GPU shader
//! compiler to REASSOCIATE and FUSE float ops (`t - (t - a)` folds to `a`),
//! with no `precise` qualifier to stop it, so the error-free transforms df64
//! depends on COLLAPSE on the actual GPU (memory:
//! gpu-df64-dead-end-use-perturbation). Integer arithmetic carries no such
//! license, so the escape orbit here runs entirely in the general, CTFE-derived
//! `precision::fixed::Fixed<L>` integer fixed-point number at `L = 8` (13-bit
//! limbs, ~2^-91 resolution): reassociation-immune and deterministic across
//! Metal/Vulkan/D3D12. `Fixed<L>` shares `field.fe`'s limb kernel with the
//! crypto `Field<p>` and is proven bit-for-bit against an independent num-bigint
//! reference (`crates/codegen/tests/precision_fixed_oracle.rs`, mul/add/sub/sqr
//! limb-for-limb + escape iteration counts, L=4 and L=8). This is the general
//! CTFE form instantiated at 8, not a bespoke fixed-point copy.
//!
//! DEEP CENTER (increment 1). The per-pixel coordinate `c` is assembled from a
//! FOUR-WORD f32 float-expansion base (`Expansion<4>` / qf128 territory,
//! ~1e-27) plus the `u*zoom`/`v*zoom` offset, all stitched into one `Fixed<8>`
//! value by the exact Fixed add (`from_qf_offset`). The two leading words are
//! the gesture-plumbing df64 pair (`center_x_hi`/`center_x_lo`,
//! `center_y_hi`/`center_y_lo`, still `update_view`-driven via `add_f32<2>`,
//! unchanged and oracle-gated); the two trailing words (`CENTER_*_DEEP2/DEEP3`)
//! are CONSTS carrying the deep low-order bits BELOW the df64 (two-f32) floor,
//! seeding a real Seahorse-Valley location to ~1e-27. Those deep bits are
//! un-representable in a two-word df64 center: dropping them shifts the view by
//! ~768 pixels at the default `zoom = 1e-16` (proven, GPU-free, in
//! `crates/codegen/tests/precision_deep_center_oracle.rs`: adjacent deep pixels
//! resolve to DISTINCT `Fixed<8>` c values, which a df64 center could not).
//!
//!     fe web build demos/sketches/mandelbrot --out <dir>
//!
//! Software rendering (lavapipe/SwiftShader) in the sandbox; no performance or
//! parallelism claim (VISION 3.1).
//!
//! Honesty register: the deep low-order bits are seeded as CONSTS, so the
//! INITIAL view is a fixed deep location; interactive pan at `zoom < ~1e-14`
//! still moves only the df64 leading pair (deep-pan needs the trailing words
//! promoted to gesture-driven fields, increment 2), and the 1e-100+ regime
//! needs perturbation (reference-orbit) rendering (out of scope). What is
//! proven here: the coordinate carried into the GPU escape holds full `Fixed<8>`
//! (~1e-27) precision, past the ~1e-11 df64 wall, and stays GPU-faithful
//! because the orbit is integer `Fixed<8>` (df64's error-free transforms
//! collapse under WGSL reassociation; memory: gpu-df64-dead-end-use-perturbation).

use std::webgpu::{FragmentSurface, GpuProgram, UpdateSurface, WebGpuBackend}
use std::web::view::{Extent, Param, Surface}
use fmath::{from_i32, palette, to_i32}
use precision::{add_f32, from_pair, to_pair}
use precision::fixed::{from_qf_offset, escape as fx_escape}

// Iteration-budget scaling: deeper zoom needs more iterations to resolve the
// boundary. `max_iter_for_zoom` grows the trip count with how far `zoom` has
// been zoomed in, capped so the loop stays bounded.
const MAX_ITER_BASE: i32 = 256
const MAX_ITER_CAP: i32 = 2000
const ITER_PER_DOUBLING: f32 = 48.0
const DEPTH_PROBE_STEPS: i32 = 40

// `update_view`'s clamps (mirrors `view()`'s declared ranges below; kept as
// named consts so the two cannot silently drift).
const CENTER_X_MIN: f32 = -2.5
const CENTER_X_MAX: f32 = 1.0
const CENTER_Y_MIN: f32 = -1.5
const CENTER_Y_MAX: f32 = 1.5
// The `Fixed<8>` floor (~2^-91 ~ 1e-27): the per-pixel coordinate is carried at
// full `Fixed<8>` width, so the zoom is no longer bounded at the old ~1e-11
// df64 wall. Held just above the resolution limit.
const ZOOM_MIN: f32 = 0.000000000000000000000000001
const ZOOM_MAX: f32 = 3.0

// The DEEP low-order center words (`w2`, `w3` of the four-word `Expansion<4>`
// base per axis), a real Seahorse-Valley location (main-cardioid / period-2
// neck) seeded BELOW the df64 (two-f32) floor so the center reaches ~1e-27. The
// leading two words are the gesture-driven `center_*_hi`/`center_*_lo` fields;
// these trailing two are consts (increment 1). `w2 ~ 1e-16` alone is already
// un-representable in a df64 center: dropping it moves the view ~768 px at the
// default `zoom = 1e-16`.
const CENTER_X_DEEP2: f32 = -0.0000000000000003
const CENTER_X_DEEP3: f32 = -0.00000000000000000000002
const CENTER_Y_DEEP2: f32 = 0.00000000000000025
const CENTER_Y_DEEP3: f32 = 0.000000000000000000000015

/// One wheel notch: `dzoom < 0` zooms IN (7/8), `dzoom > 0` zooms OUT (9/8),
/// `dzoom == 0` leaves `zoom` unchanged. Same per-notch ratios as
/// `update_view` in `mandel_view_ctl.fe` (there `scale_q -+ (scale_q>>3)`,
/// integer 7/8 and 9/8).
fn zoom_step(_ zoom: f32, _ dzoom: f32) -> f32 {
    if dzoom < 0.0 {
        zoom * 0.875
    } else {
        if dzoom > 0.0 {
            zoom * 1.125
        } else {
            zoom
        }
    }
}

fn clamp_f(_ v: f32, _ lo: f32, _ hi: f32) -> f32 {
    if v < lo {
        lo
    } else {
        if v > hi {
            hi
        } else {
            v
        }
    }
}

/// Clamp a flat `(hi, lo)` pair to a plain f32 range, comparing on the `hi`
/// part (the `lo` part is below the clamp bounds' own resolution). Landing
/// exactly on a bound drops `lo` to zero, which is correct: the clamp itself
/// is the more significant fact at that point, not the sub-ulp remainder.
/// This is representation-level, not `Expansion<2>` arithmetic (`precision`
/// has no clamp of its own), so it stays local rather than moving to the
/// general form.
fn clamp_pair(_ hi: f32, _ lo: f32, _ min_v: f32, _ max_v: f32) -> (f32, f32) {
    if hi < min_v {
        (min_v, 0.0)
    } else {
        if hi > max_v {
            (max_v, 0.0)
        } else {
            (hi, lo)
        }
    }
}

/// Deep zoom needs many more iterations to resolve the escape boundary than a
/// wide view does. There is no `log2` intrinsic, so this counts how many
/// doublings bring `zoom` up to `1.0` -- a cheap, exact-enough stand-in for
/// `-log2(zoom)` -- over a fixed, bounded trip count (`zoom` never goes below
/// `ZOOM_MIN`, about `2^-36.5`, so `DEPTH_PROBE_STEPS` doublings always
/// finish the count).
fn max_iter_for_zoom(_ zoom: f32) -> i32 {
    let mut z: f32 = zoom
    let mut depth: f32 = 0.0
    let mut i: i32 = 0
    while i < DEPTH_PROBE_STEPS {
        if z < 1.0 {
            z = z * 2.0
            depth = depth + 1.0
        }
        i = i + 1
    }
    let scaled: i32 = MAX_ITER_BASE + to_i32(depth * ITER_PER_DOUBLING)
    if scaled > MAX_ITER_CAP {
        MAX_ITER_CAP
    } else {
        scaled
    }
}

/// The per-demo params record: field names bind, by name identity, to the
/// actor's state fields (checked at projection time). `center_x_lo`/
/// `center_y_lo` are `Param::fixed` (carried in the uniform record, gesture-
/// updated, but not rendered as a slider): the LOW word of the `Expansion<2>`
/// center is not a control a person turns, it is precision the `hi` slider
/// alone can't hold.
struct MandelbrotParams {
    center_x_hi: Param,
    center_x_lo: Param,
    center_y_hi: Param,
    center_y_lo: Param,
    zoom: Param,
    res: Param,
}

actor MandelbrotSurface uses (GpuProgram<WebGpuBackend>) {
    /// Complex-plane centre, as a flat `(hi, lo)` f32 pair per axis (the
    /// `Expansion<2>` representation, kept flat here so the wasm export
    /// signature and control-manifest layout stay unchanged): `_hi` carries
    /// the visible position, `_lo` the extra ~7 digits deep zoom needs to
    /// keep the per-pixel/per-gesture step from vanishing.
    center_x_hi: f32,
    center_x_lo: f32,
    center_y_hi: f32,
    center_y_lo: f32,
    zoom: f32,
    /// Surface extent in pixels (runtime-fed; replaces `const RESOLUTION`).
    res: f32,

    /// The surface declaration: CTFE-evaluated at bundle time and projected
    /// into the manifest `surface` section. Never lowered to wasm or WGSL.
    const fn view() -> Surface<MandelbrotParams> {
        Surface {
            extent: Extent::square(512),
            params: MandelbrotParams {
                // The df64 leading pair of the deep Seahorse-Valley center
                // (`hi` visible on the slider, `lo` the next ~7 digits); the
                // trailing deep words are the `CENTER_*_DEEP2/DEEP3` consts.
                center_x_hi: Param::range(min: -2.5, max: 1.0, init: -0.7436438798904419),
                center_x_lo: Param::fixed(-0.0000000071467170),
                center_y_hi: Param::range(min: -1.5, max: 1.5, init: 0.1318259090185165),
                center_y_lo: Param::fixed(-0.0000000048132045),
                // Default to a DEEP view (~1e-16, far past the old ~1e-11 df64
                // wall) so the deep center is visible on load.
                zoom: Param::log(min: 0.000000000000000000000000001, max: 3.0, init: 0.0000000000000001),
                res: Param::extent_x(),
            },
        }
    }

    /// Pixel coordinate in, packed RGBA8 word out. The orbit runs entirely in
    /// integer `precision::fixed::Fixed<8>` (13-bit limbs, ~2^-91 resolution):
    /// reassociation-immune, so unlike the df64 float expansion it stays
    /// bit-correct through the browser's WGSL shader compiler and holds deep
    /// zoom on the actual GPU where df64's error-free transforms collapse.
    fn escape(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        // Pixel centre to [-1, 1], y up, then into the complex plane.
        let u: f32 = (from_i32(px) + 0.5) / self.res * 2.0 - 1.0
        let v: f32 = 1.0 - (from_i32(py) + 0.5) / self.res * 2.0

        // The per-pixel coordinate as a deep `Fixed<8>` value: a FOUR-WORD
        // float-expansion center (the gesture-driven df64 pair `hi`/`lo` plus
        // the two deep const words `DEEP2`/`DEEP3` below the df64 floor) plus
        // the small `u*zoom`/`v*zoom` offset, all f32 sources whose ~24 real
        // bits land at their own magnitude and are stitched by the exact Fixed
        // add (`from_qf_offset`). The center now reaches ~1e-27, past the old
        // ~1e-11 df64 wall; the ITERATION runs at full Fixed<8> width, integer
        // and GPU-faithful.
        let (cx_s, cx) = from_qf_offset<8>(
            self.center_x_hi, self.center_x_lo, CENTER_X_DEEP2, CENTER_X_DEEP3, u * self.zoom)
        let (cy_s, cy) = from_qf_offset<8>(
            self.center_y_hi, self.center_y_lo, CENTER_Y_DEEP2, CENTER_Y_DEEP3, v * self.zoom)

        let max_iter: i32 = max_iter_for_zoom(self.zoom)
        // The general integer escape loop (z <- z*z + c, strict |z|^2 > 4). It
        // returns the iteration count; a point that never escapes runs the full
        // budget, so `count == max_iter` marks the set interior.
        let count: i32 = fx_escape<8>(cx_s, cx, cy_s, cy, max_iter)

        if count < max_iter {
            // Escaped: colour by how long it survived.
            let t: f32 = from_i32(count) / from_i32(max_iter)
            palette(t, 0.0, 0.33, 0.67)
        } else {
            // Inside the set: opaque black (0xFF000000).
            -16777216
        }
    }

    /// Pan/zoom the view from one raw gesture. Fe owns ALL gesture math here
    /// (pan sensitivity, the zoom curve, the cursor anchor, and the clamps);
    /// the runtime delivers only raw pointer deltas and blits the returned
    /// values back into `(center_x_hi, center_x_lo, center_y_hi,
    /// center_y_lo, zoom)`. No JS gesture math.
    ///
    /// Same SHAPE as `update_view` in `mandel_view_ctl.fe` (the oracle-proven
    /// Q12 fixed-point pan/zoom/anchor/clamp algorithm): pan follows the
    /// pointer (the center moves opposite the drag, scaled by the CURRENT
    /// per-pixel step); one wheel notch is a fixed +-1/8 zoom; the anchor
    /// correction uses the OLD zoom minus the NEW (clamped) zoom so the point
    /// under the cursor stays put; clamps apply last. The center's pan/anchor
    /// deltas are O(zoom) quantities the same way `escape`'s per-pixel offset
    /// is, so they fold into the `Expansion<2>` center through `add_f32<2>`
    /// for the same reason: dropping them straight into an O(1) f32 center
    /// would erase them at deep zoom.
    ///
    /// `dx`/`dy`: pixel drag delta (image follows the pointer). `dzoom`: one
    /// wheel notch, < 0 in / > 0 out / 0 none. `mx`/`my`: the pointer's
    /// CURRENT position in the same pixel frame as `res` (the anchor point;
    /// unused when `dzoom == 0`, since the anchor term is then scaled by
    /// zero).
    fn update_view(self, dx: f32, dy: f32, dzoom: f32, mx: f32, my: f32)
        -> (f32, f32, f32, f32, f32)
        uses (UpdateSurface)
    {
        // pixel -> complex-plane step at the CURRENT zoom: `escape`'s own
        // u map is `u = (px + 0.5) / res * 2 - 1`, so `d(cx)/d(px) = 2 *
        // zoom / res`. `escape`'s v map is Y-FLIPPED (`v = 1 - (py+0.5)/res*2`:
        // screen row increases downward, complex y increases upward), so a
        // downward drag (dy > 0) must INCREASE center_y, not decrease it.
        let step: f32 = 2.0 * self.zoom / self.res
        let (cx0_hi, cx0_lo) = to_pair(add_f32<2>(from_pair(self.center_x_hi, self.center_x_lo), -dx * step))
        let (cy0_hi, cy0_lo) = to_pair(add_f32<2>(from_pair(self.center_y_hi, self.center_y_lo), dy * step))

        let z_c: f32 = clamp_f(zoom_step(self.zoom, dzoom), ZOOM_MIN, ZOOM_MAX)

        // The complex point under the cursor's CURRENT (mx, my), via the
        // EXACT SAME u/v map `escape` uses, times the zoom CHANGE (old minus
        // new): keeps that point fixed under the new zoom.
        let u: f32 = (mx + 0.5) * 2.0 / self.res - 1.0
        let v: f32 = 1.0 - (my + 0.5) * 2.0 / self.res
        let (cx_a_hi, cx_a_lo) = to_pair(add_f32<2>(from_pair(cx0_hi, cx0_lo), u * (self.zoom - z_c)))
        let (cy_a_hi, cy_a_lo) = to_pair(add_f32<2>(from_pair(cy0_hi, cy0_lo), v * (self.zoom - z_c)))

        let (cx_c_hi, cx_c_lo) = clamp_pair(cx_a_hi, cx_a_lo, CENTER_X_MIN, CENTER_X_MAX)
        let (cy_c_hi, cy_c_lo) = clamp_pair(cy_a_hi, cy_a_lo, CENTER_Y_MIN, CENTER_Y_MAX)
        (cx_c_hi, cx_c_lo, cy_c_hi, cy_c_lo, z_c)
    }
}
