//! Float math for sketches, written in Fe.
//!
//! The compiler recognizes these `f32` intrinsics today:
//!
//!     __f32_from_i32   __i32_from_f32   __sqrt_f32
//!     __abs_f32        __min_f32        __max_f32   __clamp_f32
//!     __floor_f32      __ceil_f32       __trunc_f32 __round_f32
//!
//! `abs`/`min`/`max`/`clamp` graduated from hand-written Fe (`if a < b {a}
//! else {b}`, branchy WGSL) to dedicated Sonatina IR ops (`Fabs`/`Fmin`/
//! `Fmax`/`Fclamp`) mapped to a native instruction on every backend (naga
//! `abs()`/`min()`/`max()`/`clamp()`, wasm `f32.abs`/`f32.min`/`f32.max` (+
//! composed clamp), cranelift `fabs`/`fmin`/`fmax` (+ composed clamp)).
//!
//! `abs`/`min`/`max`/`clamp` are now thin wrappers over `core::num`'s
//! `Abs`/`MinMax` trait methods rather than calling the `__*_f32` externs
//! directly (float-semantics type API, slice 1:
//! `/workspace/mb2/FLOAT_SEMANTICS_TYPE_API_DESIGN.md`). This ingot stays on
//! plain `f32` throughout -- exact, pinned "WebAssembly rules" semantics on
//! every backend, unchanged -- it never imports `core::num::Regular`, the
//! relaxed single-native-instruction GPU opt-in. Same surface, same
//! semantics, same generated code; only the indirection through the trait
//! changed.
//!
//! `floor`/`ceil`/`trunc`/`round` similarly graduated to `Ffloor`/`Fceil`/
//! `Ftrunc`/`Fround`: a single native instruction on every backend (naga
//! `floor()`/`ceil()`/`trunc()`/`round()`, wasm `f32.floor`/`f32.ceil`/
//! `f32.trunc`/`f32.nearest`, cranelift `floor`/`ceil`/`trunc`/`nearest`), no
//! bit-twiddling, no NaN/-0 subtlety. `floor` used to be a hand-written
//! branch (`let t = trunc(x); if t > x { t - 1.0 } else { t }`, itself built
//! on a round-trip through `__i32_from_f32`/`__f32_from_i32`); it is now
//! branch-free, which makes `fract`/`wrap_pi`/`sin` branch-free too since
//! they build on `floor`. `round` is `roundTiesToEven` (IEEE 754): all three
//! backends agree exactly (wasm `f32.nearest`, cranelift `nearest`, and naga
//! `MathFunction::Round` -> SPIR-V `GLSL.std.450 RoundEven`), so there is no
//! divergence to pin around, unlike `min`/`max`.
//!
//! See `NUMERIC_INTRINSICS_STAGING.md` at the Fe repo root.
//!
//! `__rsqrt_f32` is still declared but deliberately unrecognized
//! (`classify.rs`, with a test pinning the set): it stays an extern "until it
//! has an explicit runtime and backend lowering". `sin`/`cos` below remain
//! ordinary Fe (a hand-chosen parabola approximation): no backend has a
//! native `sin`/`cos` instruction, so there is no intrinsic to graduate to.

use core::num::Abs
use core::ops::MinMax

extern {
    fn __f32_from_i32(_: i32) -> f32
    fn __i32_from_f32(_: f32) -> i32
    fn __sqrt_f32(_: f32) -> f32
    fn __floor_f32(_: f32) -> f32
    fn __ceil_f32(_: f32) -> f32
    fn __trunc_f32(_: f32) -> f32
    fn __round_f32(_: f32) -> f32
}

pub const PI: f32 = 3.14159265
pub const TAU: f32 = 6.28318531
pub const HALF_PI: f32 = 1.57079633

// ---------------------------------------------------------------------------
// The pieces the intrinsics do not give us yet
// ---------------------------------------------------------------------------

/// The two conversions, re-exported under names that read like maths rather
/// than like intrinsics.
pub fn from_i32(_ n: i32) -> f32 {
    __f32_from_i32(n)
}

/// Truncates toward zero. See `floor` for the other rounding.
pub fn to_i32(_ x: f32) -> i32 {
    __i32_from_f32(x)
}

pub fn abs(_ x: f32) -> f32 {
    x.abs()
}

pub fn min(_ a: f32, _ b: f32) -> f32 {
    a.min(b)
}

pub fn max(_ a: f32, _ b: f32) -> f32 {
    a.max(b)
}

pub fn clamp(_ x: f32, _ lo: f32, _ hi: f32) -> f32 {
    x.clamp(lo, hi)
}

pub fn clamp01(_ x: f32) -> f32 {
    clamp(x, 0.0, 1.0)
}

/// Truncate toward zero. Naming it separates "round toward zero" from
/// "round toward negative infinity", which is the distinction `floor` turns
/// on.
pub fn trunc(_ x: f32) -> f32 {
    __trunc_f32(x)
}

/// Round toward negative infinity.
pub fn floor(_ x: f32) -> f32 {
    __floor_f32(x)
}

/// Round toward positive infinity.
pub fn ceil(_ x: f32) -> f32 {
    __ceil_f32(x)
}

/// Round to the nearest integer, ties to even (IEEE 754 `roundTiesToEven`).
pub fn round(_ x: f32) -> f32 {
    __round_f32(x)
}

pub fn fract(_ x: f32) -> f32 {
    x - floor(x)
}

pub fn sqrt(_ x: f32) -> f32 {
    __sqrt_f32(x)
}

/// Linear interpolation. `t` is not clamped, so this extrapolates on purpose.
pub fn mix(_ a: f32, _ b: f32, _ t: f32) -> f32 {
    a + (b - a) * t
}

/// Hermite smoothstep between two edges.
pub fn smoothstep(_ edge0: f32, _ edge1: f32, _ x: f32) -> f32 {
    let t: f32 = clamp01((x - edge0) / (edge1 - edge0))
    t * t * (3.0 - 2.0 * t)
}

// ---------------------------------------------------------------------------
// Periodic functions
//
// There is no libm, and that is the interesting part rather than a limitation:
// a shader's `sin` is always a polynomial someone chose, so this one chooses
// out loud. The parabolic fit refined once stays within about a thousandth over
// the whole cycle, for four multiplies and no table.
// ---------------------------------------------------------------------------

/// Fold `x` into `[-PI, PI]`, the window the fit below is valid on.
pub fn wrap_pi(_ x: f32) -> f32 {
    x - TAU * floor(x / TAU + 0.5)
}

pub fn sin(_ x: f32) -> f32 {
    let t: f32 = wrap_pi(x)
    // Parabola through the zeros at -PI, 0 and PI, matched to sin at the peaks.
    let p: f32 = 1.27323954 * t - 0.40528473 * t * abs(t)
    // One refinement pass. 0.225 is the classic fit constant.
    0.225 * (p * abs(p) - p) + p
}

pub fn cos(_ x: f32) -> f32 {
    sin(x + HALF_PI)
}

// ---------------------------------------------------------------------------
// Colour
// ---------------------------------------------------------------------------

/// Pack unit-interval channels into the RGBA8 word `--mode render` returns.
/// Alpha is always opaque, and an opaque top byte is what makes this negative
/// as a signed word, which is why the constant is written the way it is.
pub fn rgba(_ r: f32, _ g: f32, _ b: f32) -> i32 {
    let ri: i32 = __i32_from_f32(clamp01(r) * 255.0)
    let gi: i32 = __i32_from_f32(clamp01(g) * 255.0)
    let bi: i32 = __i32_from_f32(clamp01(b) * 255.0)
    ri + gi * 256 + bi * 65536 + -16777216
}

pub fn grey(_ v: f32) -> i32 {
    rgba(v, v, v)
}

/// A cosine palette: a smooth loop through colour space from three phases.
/// Much less code than a gradient table, and it reads better.
pub fn palette(_ t: f32, _ phase_r: f32, _ phase_g: f32, _ phase_b: f32) -> i32 {
    rgba(
        0.5 + 0.5 * cos(TAU * (t + phase_r)),
        0.5 + 0.5 * cos(TAU * (t + phase_g)),
        0.5 + 0.5 * cos(TAU * (t + phase_b)),
    )
}
