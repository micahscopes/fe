//! BabyBear as one parameter instance of the portable u32 word field.
//!
//! `p = 15 * 2^27 + 1`. The Montgomery inverse, `R^2`, and maximal two-adic
//! root are CTFE-derived from the modulus and generator in this file. No
//! generated table or target-specific arithmetic is present.

use super::word_field::{
    WordField,
    WordPrime31,
    WordTwoAdicPrime,
    montgomery_neg_inverse_u32,
    montgomery_r2_u32,
    montgomery_word_u32,
}
use super::field::pow_mod_u256

pub const BABY_BEAR_MODULUS: u32 = 2013265921
pub const BABY_BEAR_TWO_ADICITY: u32 = 27
pub const BABY_BEAR_GENERATOR: u32 = 31

const MODULUS_U256: u256 = BABY_BEAR_MODULUS as u256
const MONTGOMERY_NEG_INVERSE: u32 = montgomery_neg_inverse_u32(BABY_BEAR_MODULUS)
const MONTGOMERY_R2: u32 = montgomery_r2_u32(BABY_BEAR_MODULUS)
const TWO_ADIC_ROOT_PLAIN: u256 = pow_mod_u256(
    BABY_BEAR_GENERATOR as u256,
    ((BABY_BEAR_MODULUS - 1) >> BABY_BEAR_TWO_ADICITY) as u256,
    MODULUS_U256,
)
const TWO_ADIC_ROOT_MONTGOMERY: u32 =
    montgomery_word_u32(TWO_ADIC_ROOT_PLAIN, BABY_BEAR_MODULUS)

pub struct BabyBearModulus {}
pub type BabyBear = WordField<BabyBearModulus>

impl WordPrime31 for BabyBearModulus {
    fn modulus() -> u32 { BABY_BEAR_MODULUS }
    fn montgomery_neg_inverse() -> u32 { MONTGOMERY_NEG_INVERSE }
    fn r2() -> u32 { MONTGOMERY_R2 }
}

impl WordTwoAdicPrime for BabyBearModulus {
    const TWO_ADICITY: u32 = BABY_BEAR_TWO_ADICITY
    fn two_adic_root_montgomery() -> u32 { TWO_ADIC_ROOT_MONTGOMERY }
}

pub const fn baby_bear_montgomery_neg_inverse() -> u32 { MONTGOMERY_NEG_INVERSE }
pub const fn baby_bear_montgomery_r2() -> u32 { MONTGOMERY_R2 }
pub const fn baby_bear_two_adic_root_plain() -> u32 {
    TWO_ADIC_ROOT_PLAIN.downcast_truncate()
}

static_assert(BABY_BEAR_MODULUS < 2147483648)
static_assert((BABY_BEAR_MODULUS - 1) == 15 * (1 << BABY_BEAR_TWO_ADICITY))
static_assert(
    pow_mod_u256(TWO_ADIC_ROOT_PLAIN, 1 << (BABY_BEAR_TWO_ADICITY as u256), MODULUS_U256)
        == 1
)
static_assert(
    pow_mod_u256(
        TWO_ADIC_ROOT_PLAIN,
        1 << ((BABY_BEAR_TWO_ADICITY - 1) as u256),
        MODULUS_U256,
    ) == MODULUS_U256 - 1
)
