//! BN254 (alt_bn128) scalar field `Fr` as a `precision::field::Modulus<20>`
//! instance: the ONE curve instantiation of the general `Field<p>` engine
//! (`field.fe`), Rollcall precision axis P2. This is the same prime, same
//! 13-bit x 20-limb decomposition, same `mu`, as
//! `crates/codegen/tests/fixtures/spirv/field_mul_bn254_fr.fe`'s header
//! (`gen_field_mul.py`'s hand-staged output): this file supplies the
//! identical DATA (the modulus's limbs), not a different curve, so the
//! oracle test comparing `field::mul::<20, Bn254Fr>` against that fixture is
//! comparing two algorithms for the SAME function, not two different
//! functions.
//!
//!   p = 21888242871839275222246405745257275088548364400416034343698204186575808495617
//!   (254-bit prime; R = 2^260; mu = -p^-1 mod 2^13 = 8191)
//!
//! `mu` below is NOT hand-copied as an act of faith: `field::mont_mu` is a
//! real CTFE computation (2-adic Newton iteration) over `p`'s low limb, and
//! the `static_assert` proves the literal below equals what the compiler
//! independently derives from `P0` -- if either constant drifts, `fe check`
//! fails closed.

use super::field::{
    FieldWords, LimbLast, LimbMore, Limbs, Modulus, MontgomeryModulus,
    PrimeModulus, TwoAdicModulus, U32EmbeddingModulus, mont_mu,
    montgomery_words_from_u256, pow_mod_u256, LIMB_BITS,
}

pub struct Bn254Fr {}

const BN254_FR_PRIME: u256 = 21888242871839275222246405745257275088548364400416034343698204186575808495617
pub const BN254_FR_TWO_ADICITY: u32 = 28
const TWO_ADIC_ROOT_PLAIN: u256 = pow_mod_u256(
    5,
    (BN254_FR_PRIME - 1) >> (BN254_FR_TWO_ADICITY as u256),
    BN254_FR_PRIME,
)
const TWO_ADIC_ROOT_WORDS: FieldWords<20> =
    montgomery_words_from_u256<20>(TWO_ADIC_ROOT_PLAIN, BN254_FR_PRIME)

const P0: u32 = 1

impl Modulus<20> for Bn254Fr {
    fn p_limbs() -> Limbs<20> {
        LimbMore { lead: 1, tail: LimbMore { lead: 0, tail: LimbMore { lead: 1276, tail: LimbMore { lead: 1003, tail: LimbMore { lead: 5182, tail: LimbMore { lead: 6216, tail: LimbMore { lead: 1765, tail: LimbMore { lead: 2319, tail: LimbMore { lead: 5096, tail: LimbMore { lead: 2369, tail: LimbMore { lead: 5655, tail: LimbMore { lead: 770, tail: LimbMore { lead: 7016, tail: LimbMore { lead: 2082, tail: LimbMore { lead: 1761, tail: LimbMore { lead: 5125, tail: LimbMore { lead: 305, tail: LimbMore { lead: 5015, tail: LimbMore { lead: 6419, tail: LimbLast { value: 96 } } } } } } } } } } } } } } } } } } } }
    }

    fn mu() -> u32 { 8191 }
}

impl MontgomeryModulus<20> for Bn254Fr {
    fn r2_words() -> FieldWords<20> {
        [1781, 2925, 5300, 368, 7395, 1646, 1416, 6340, 8118, 6687,
         3668, 5603, 1986, 2079, 1400, 6264, 290, 5245, 84, 5]
    }
}

impl U32EmbeddingModulus<20> for Bn254Fr {}
impl PrimeModulus<20> for Bn254Fr {}

impl TwoAdicModulus<20> for Bn254Fr {
    const TWO_ADICITY: u32 = BN254_FR_TWO_ADICITY
    fn two_adic_root_words() -> FieldWords<20> { TWO_ADIC_ROOT_WORDS }
}

static_assert(mont_mu(P0, LIMB_BITS) == 8191)
static_assert(pow_mod_u256(TWO_ADIC_ROOT_PLAIN, 1 << 28, BN254_FR_PRIME) == 1)
static_assert(
    pow_mod_u256(TWO_ADIC_ROOT_PLAIN, 1 << 27, BN254_FR_PRIME)
        == BN254_FR_PRIME - 1
)
