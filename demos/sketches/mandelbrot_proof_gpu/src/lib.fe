//! First browser-executed BabyBear proof placement checkpoint.
//!
//! The compute pass derives a four-row Q12 Mandelbrot witness through the
//! production proof kernel, interprets one Conal factor vocabulary as four
//! staged 4-to-16 BabyBear coset LDEs, and commits the resulting 64 field values
//! with the production Poseidon2 sponge. It then interprets the production
//! factor-2 FRI pair denotation as eight independent WebGPU invocations over a
//! quartic BabyBear codeword assembled from those four columns. Inverse
//! butterflies, coset lifting, forward butterflies, and the FRI fold are
//! separate typed placements over disjoint lanes. Two commitments by sixteen
//! field lanes advance through one bounded workgroup kernel. Fe dispatch types
//! derive every ordered repetition count, so browser WebGPU implementations
//! never receive one crash-shaped megashader. A Fe-authored mutation mode
//! changes one LDE value after the clean root is fixed and requires both the
//! second commitment and its corresponding FRI pair to differ. The fragment
//! pass visualizes the retained folded codeword and status words.
//!
//! This is a mixed placement checkpoint. The four independent LDE columns use
//! the portable stage-grid interpretation of canonical Conal factor trees. The
//! paired commitment states are a second workgroup-map interpretation. Witness
//! generation and final comparison remain scalar passes. This is not yet a
//! shared-memory butterfly interpreter, a transcript-derived FRI challenge, an
//! authenticated FRI receipt, or a recursive proof.

use std::webgpu::{
    ComputeInvocation,
    ComputeSurface as Prove,
    FixedDispatch as Once,
    FragmentSurface as Display,
    GpuProgram as Program,
    ResponsiveBacking,
    RepeatedDispatch as Repeat,
    StandardSurfaceRecovery,
    StorageBuffer as ProofTape,
    SurfaceQuality,
    SurfaceRecovery,
    Workgroup as Threads,
    WebGpuBackend,
}
use std::conal::{BalancedBinarySchedule, Pair, RBin}
use std::web::view::{Extent, Param, Surface}
use fmath::{from_i32, to_i32}
use mandelbrot_proof_baby_bear::fold_fri_pair_value_at_power_of_two
use mandelbrot_proof_kernel::{EscapeAirWordStream, EscapesByQ12}
use canonical_words::CanonicalWords
use parallel_ntt_webgpu::{
    finish_batched_stage_grid_into,
    forward_batched_stage_grid_lane,
    inverse_batched_stage_grid_lane,
    prepare_batched_coset_extension,
    prepare_batched_stage_grid,
}
use parallel_structure::FactorTree
use poseidon_baby_bear::{
    ROUND_CONSTANT_COUNT,
    SPONGE_RATE,
    WIDTH as POSEIDON_LANES,
    Poseidon2Digest,
    Poseidon2FieldDomain,
    Poseidon2FieldPermutation,
    Poseidon2FieldSponge,
    Poseidon2ParameterStream,
    Poseidon2WorkgroupPlan,
    Poseidon2WorkgroupSchedule,
    poseidon2_workgroup_destination,
    poseidon2_round_constant_index,
    poseidon2_workgroup_lane_with_round_constant,
}
use precision::baby_bear::{BabyBear, BabyBearExt4, BABY_BEAR_MODULUS}
use region_layout::{
    Region,
    RegionIndex,
    RegionSchema,
    RegionSchemaProvider,
    cyclic_region_index,
    load_region_indexed_word,
    load_region_word,
    region_bounds,
    store_region_indexed_word,
    store_region_word,
    subregion,
}

const TRACE: usize = 4
const LDE: usize = 16
const COLUMN_COUNT: usize = 4
const TRACE_WORDS: usize = COLUMN_COUNT * TRACE
const LDE_WORDS: usize = COLUMN_COUNT * LDE
const INPUT_LANES: usize = TRACE / 2
const OUTPUT_LANES: usize = LDE / 2
const INPUT_GRID_LANES: usize = COLUMN_COUNT * INPUT_LANES
const OUTPUT_GRID_LANES: usize = COLUMN_COUNT * OUTPUT_LANES
const DIGEST_FIELDS: usize = 8
const COMMIT_STATE_WORDS: usize = 80
const STATUS_WORDS: usize = 11
const EXTENSION_WORDS: usize = 4
const FRI_PAIRS: usize = LDE / 2
const FRI_FOLD_WORDS: usize = FRI_PAIRS * EXTENSION_WORDS
const FRI_STATUS_WORDS: usize = 2 * FRI_PAIRS + 3
const PROOF_WORDS: usize = TRACE_WORDS
    + LDE_WORDS
    + 2 * DIGEST_FIELDS
    + STATUS_WORDS
    + 2 * COMMIT_STATE_WORDS
    + ROUND_CONSTANT_COUNT
    + 2 * FRI_FOLD_WORDS
    + FRI_STATUS_WORDS

struct ProofTapeRegions {
    trace: Region<ProofTapeRegions, [u32; TRACE_WORDS]>,
    lde: Region<ProofTapeRegions, [u32; LDE_WORDS]>,
    clean_root: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
    observed_root: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
    status: Region<ProofTapeRegions, [u32; STATUS_WORDS]>,
    clean_commitment: Region<ProofTapeRegions, [u32; COMMIT_STATE_WORDS]>,
    observed_commitment: Region<ProofTapeRegions, [u32; COMMIT_STATE_WORDS]>,
    parameters: Region<ProofTapeRegions, [u32; ROUND_CONSTANT_COUNT]>,
    fri_clean: Region<ProofTapeRegions, [u32; FRI_FOLD_WORDS]>,
    fri_observed: Region<ProofTapeRegions, [u32; FRI_FOLD_WORDS]>,
    fri_status: Region<ProofTapeRegions, [u32; FRI_STATUS_WORDS]>,
}
impl core::marker::Copy for ProofTapeRegions {}
derive RegionSchema for ProofTapeRegions using RegionSchemaProvider

struct TraceRegions {
    step: Region<TraceRegions, [u32; TRACE]>,
    magnitude: Region<TraceRegions, [u32; TRACE]>,
    active: Region<TraceRegions, [u32; TRACE]>,
    terminal: Region<TraceRegions, [u32; TRACE]>,
}
impl core::marker::Copy for TraceRegions {}
derive RegionSchema for TraceRegions using RegionSchemaProvider

struct StatusRegions {
    trace_valid: Region<StatusRegions, u32>,
    lde_valid: Region<StatusRegions, [u32; COLUMN_COUNT]>,
    roots_equal: Region<StatusRegions, u32>,
    mode_correct: Region<StatusRegions, u32>,
    trace_color: Region<StatusRegions, u32>,
    lde_color: Region<StatusRegions, u32>,
    root_color: Region<StatusRegions, u32>,
    mode_color: Region<StatusRegions, u32>,
}
impl core::marker::Copy for StatusRegions {}
derive RegionSchema for StatusRegions using RegionSchemaProvider

struct CommitmentRegions {
    primary: Region<CommitmentRegions, [u32; POSEIDON_LANES]>,
    secondary: Region<CommitmentRegions, [u32; POSEIDON_LANES]>,
    cursor: Region<CommitmentRegions, [u32; POSEIDON_LANES]>,
    block: Region<CommitmentRegions, [u32; POSEIDON_LANES]>,
    valid: Region<CommitmentRegions, [u32; POSEIDON_LANES]>,
}
impl core::marker::Copy for CommitmentRegions {}
derive RegionSchema for CommitmentRegions using RegionSchemaProvider

struct FriStatusRegions {
    clean_valid: Region<FriStatusRegions, [u32; FRI_PAIRS]>,
    observed_valid: Region<FriStatusRegions, [u32; FRI_PAIRS]>,
    equal: Region<FriStatusRegions, u32>,
    correct: Region<FriStatusRegions, u32>,
    color: Region<FriStatusRegions, u32>,
}
impl core::marker::Copy for FriStatusRegions {}
derive RegionSchema for FriStatusRegions using RegionSchemaProvider

const fn proof_tape_regions() -> ProofTapeRegions {
    <ProofTapeRegions as RegionSchema>::regions()
}

const fn trace_regions() -> TraceRegions {
    <TraceRegions as RegionSchema>::regions()
}

const fn status_regions() -> StatusRegions {
    <StatusRegions as RegionSchema>::regions()
}

const fn commitment_regions() -> CommitmentRegions {
    <CommitmentRegions as RegionSchema>::regions()
}

const fn fri_status_regions() -> FriStatusRegions {
    <FriStatusRegions as RegionSchema>::regions()
}

#[inline(always)]
fn proof_load<T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ tape: ProofTape<u32, STORAGE_WORDS>,
    _ region: Region<ProofTapeRegions, T>,
    _ index: u32,
) -> u32
where
    STORAGE_WORDS > 0,
{
    load_region_word(tape, region, index).value
}

#[inline(always)]
fn proof_store<T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ tape: ProofTape<u32, STORAGE_WORDS>,
    _ region: Region<ProofTapeRegions, T>,
    _ index: u32,
    _ value: u32,
) -> bool
where
    STORAGE_WORDS > 0,
{
    store_region_word(tape, region, index, value)
}

#[inline(always)]
fn proof_load_indexed<T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ tape: ProofTape<u32, STORAGE_WORDS>,
    _ region: Region<ProofTapeRegions, T>,
    _ index: RegionIndex<T>,
) -> u32
where
    STORAGE_WORDS > 0,
{
    load_region_indexed_word(tape, region, index)
}

#[inline(always)]
fn proof_store_indexed<T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ tape: ProofTape<u32, STORAGE_WORDS>,
    _ region: Region<ProofTapeRegions, T>,
    _ index: RegionIndex<T>,
    _ value: u32,
)
where
    STORAGE_WORDS > 0,
{
    store_region_indexed_word(tape, region, index, value)
}

type ProofLdeColumns = RBin<Pair, 2>
type ProofLdeInputPlan = RBin<Pair, 2>
type ProofLdeOutputPlan = RBin<Pair, 4>
type ProofFriPairs = RBin<Pair, 3>
type ProofFriVariants = RBin<Pair, 1>
const LDE_TASKS: usize = <ProofLdeColumns as BalancedBinarySchedule>::LEAVES
const INPUT_STAGES: usize = <ProofLdeInputPlan as FactorTree>::FACTORS
const OUTPUT_STAGES: usize = <ProofLdeOutputPlan as FactorTree>::FACTORS
const FRI_PAIR_LANES: usize =
    <ProofFriPairs as BalancedBinarySchedule>::LEAVES
const FRI_VARIANT_LANES: usize =
    <ProofFriVariants as BalancedBinarySchedule>::LEAVES
const FRI_WORKGROUP_LANES: usize = FRI_PAIR_LANES * FRI_VARIANT_LANES
static_assert(LDE_TASKS == COLUMN_COUNT)
static_assert(<ProofLdeInputPlan as FactorTree>::POINTS == TRACE)
static_assert(<ProofLdeOutputPlan as FactorTree>::POINTS == LDE)
static_assert(INPUT_STAGES == 2)
static_assert(OUTPUT_STAGES == 4)
static_assert(INPUT_GRID_LANES == 8)
static_assert(OUTPUT_GRID_LANES == 32)
static_assert(FRI_PAIR_LANES == FRI_PAIRS)
static_assert(FRI_VARIANT_LANES == 2)
static_assert(FRI_WORKGROUP_LANES == 16)
static_assert(<ProofTapeRegions as RegionSchema>::WORDS == PROOF_WORDS.downcast_truncate())
static_assert(<TraceRegions as RegionSchema>::WORDS == TRACE_WORDS.downcast_truncate())
static_assert(<StatusRegions as RegionSchema>::WORDS == STATUS_WORDS.downcast_truncate())
static_assert(
    <CommitmentRegions as RegionSchema>::WORDS
        == COMMIT_STATE_WORDS.downcast_truncate()
)
static_assert(
    <FriStatusRegions as RegionSchema>::WORDS
        == FRI_STATUS_WORDS.downcast_truncate()
)

type CommitmentDependencies = RBin<Pair, 1>
const COMMITMENT_LANES: usize =
    <CommitmentDependencies as BalancedBinarySchedule>::LEAVES
const COMMITMENT_FIELD_LANES: usize =
    <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::LANES
const COMMITMENT_WORKGROUP_LANES: usize =
    COMMITMENT_LANES * COMMITMENT_FIELD_LANES
const COMMITMENT_MESSAGE_FIELDS: usize = LDE_WORDS + 2
const COMMITMENT_PERMUTATIONS: usize =
    (COMMITMENT_MESSAGE_FIELDS + SPONGE_RATE - 1) / SPONGE_RATE
const COMMITMENT_STEPS_PER_PERMUTATION: usize =
    <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::STEPS
const COMMITMENT_SCHEDULE_STEPS: usize =
    COMMITMENT_PERMUTATIONS * COMMITMENT_STEPS_PER_PERMUTATION
const FIRST_BLOCK_FIELDS: usize = SPONGE_RATE - 2
const COMPLETE_DATA_BLOCKS: usize = (LDE_WORDS - FIRST_BLOCK_FIELDS) / SPONGE_RATE
const FINAL_FULL_BLOCK: usize = COMPLETE_DATA_BLOCKS
const FINAL_PARTIAL_BLOCK: usize = COMMITMENT_PERMUTATIONS - 1
const DONE_BLOCK: usize = COMMITMENT_PERMUTATIONS
const TAMPER_LDE_FIELD: usize = 17
const TAMPER_PRECEDING_BLOCK: usize =
    (TAMPER_LDE_FIELD - FIRST_BLOCK_FIELDS) / SPONGE_RATE
const TAMPER_NEXT_BLOCK_FIELD: usize =
    (TAMPER_LDE_FIELD - FIRST_BLOCK_FIELDS) % SPONGE_RATE
static_assert(COMMITMENT_LANES == 2)
static_assert(COMMITMENT_FIELD_LANES == 16)
static_assert(COMMITMENT_WORKGROUP_LANES == 32)
static_assert(COMMITMENT_PERMUTATIONS == 9)
static_assert(COMMITMENT_STEPS_PER_PERMUTATION == 44)
static_assert(COMMITMENT_SCHEDULE_STEPS == 396)
static_assert(FIRST_BLOCK_FIELDS == 6)
static_assert(SPONGE_RATE == 8)
static_assert(TAMPER_PRECEDING_BLOCK == 1)
static_assert(TAMPER_NEXT_BLOCK_FIELD == 3)

struct MandelbrotGpuLdeV1 {}
impl Poseidon2FieldDomain for MandelbrotGpuLdeV1 {
    const TAG: u32 = 1296516172
}

struct ProofParams { tamper: Param, res: Param }

const fn proof_params() -> ProofParams {
    ProofParams { tamper: Param::range(min: 0.0, max: 1.0, init: 0.0), res: Param::extent_x() }
}

fn packed_rgba(_ red: u32, _ green: u32, _ blue: u32) -> i32 {
    (4278190080 | (blue << 16) | (green << 8) | red).downcast_truncate()
}

fn status_word(_ ok: bool, _ tampered: bool) -> u32 {
    if !ok {
        packed_rgba(236, 92, 112).downcast_truncate()
    } else {
        if tampered {
            packed_rgba(255, 176, 222).downcast_truncate()
        } else {
            packed_rgba(87, 117, 226).downcast_truncate()
        }
    }
}

#[inline(always)]
fn load_lde_fields<const N: usize>(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; LDE_WORDS]>,
) -> [BabyBear; N]
    where N <= 2147483648
{
    let zero = BabyBear::zero()
    let mut fields = [zero; N]
    let count = fields.len()
    let mut index: usize = 0
    while index < count {
        fields[index] = BabyBear::from_u32(proof_load(
            tape,
            region,
            index.downcast_truncate(),
        ))
        index = index + 1
    }
    fields
}

#[inline(always)]
fn load_commitment_buffer(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ state: Region<ProofTapeRegions, [u32; COMMIT_STATE_WORDS]>,
    _ buffer: Region<CommitmentRegions, [u32; POSEIDON_LANES]>,
) -> [u32; POSEIDON_LANES] {
    let region = subregion(state, buffer)
    let mut lanes = [0; 16]
    let mut lane: usize = 0
    while lane < POSEIDON_LANES {
        let index: RegionIndex<[u32; POSEIDON_LANES]> =
            cyclic_region_index(lane.downcast_truncate())
        lanes[lane] = proof_load_indexed(tape, region, index)
        lane = lane + 1
    }
    lanes
}

#[inline(always)]
fn store_initial_commitment(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ state: Region<ProofTapeRegions, [u32; COMMIT_STATE_WORDS]>,
    _ permutation: ref Poseidon2FieldPermutation,
) {
    let layout = commitment_regions()
    let primary = subregion(state, layout.primary)
    let secondary = subregion(state, layout.secondary)
    let cursor = subregion(state, layout.cursor)
    let block = subregion(state, layout.block)
    let valid = subregion(state, layout.valid)
    let mut lane: usize = 0
    while lane < POSEIDON_LANES {
        let lane_word: u32 = lane.downcast_truncate()
        let index: RegionIndex<[u32; POSEIDON_LANES]> =
            cyclic_region_index(lane_word)
        proof_store_indexed(tape, primary, index, permutation.lane_word(lane: lane_word))
        proof_store_indexed(tape, secondary, index, 0)
        proof_store_indexed(tape, cursor, index, 0)
        proof_store_indexed(tape, block, index, 0)
        proof_store_indexed(
            tape,
            valid,
            index,
            if permutation.is_valid() { 1 } else { 0 },
        )
        lane = lane + 1
    }
}

#[inline(always)]
fn commitment_state_valid(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ state: Region<ProofTapeRegions, [u32; COMMIT_STATE_WORDS]>,
) -> bool {
    let layout = commitment_regions()
    let cursor = subregion(state, layout.cursor)
    let block = subregion(state, layout.block)
    let valid = subregion(state, layout.valid)
    let mut lane: usize = 0
    while lane < POSEIDON_LANES {
        let lane_word: u32 = lane.downcast_truncate()
        let index: RegionIndex<[u32; POSEIDON_LANES]> =
            cyclic_region_index(lane_word)
        if proof_load_indexed(tape, cursor, index) != 0 {
            return false
        }
        if proof_load_indexed(tape, block, index)
            != DONE_BLOCK.downcast_truncate()
        {
            return false
        }
        if proof_load_indexed(tape, valid, index) != 1 {
            return false
        }
        lane = lane + 1
    }
    true
}

#[inline(always)]
fn load_digest(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
) -> Poseidon2Digest {
    let mut words = [0; DIGEST_FIELDS]
    let mut field: usize = 0
    while field < DIGEST_FIELDS {
        words[field] = proof_load(tape, region, field.downcast_truncate())
        field = field + 1
    }
    Poseidon2Digest::from_u32s(words)
}

#[inline(always)]
fn store_fri_evaluation(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; FRI_FOLD_WORDS]>,
    _ pair: u32,
    _ evaluation: BabyBearExt4,
) {
    let base = pair * EXTENSION_WORDS.downcast_truncate()
    proof_store(tape, region, base, evaluation.coefficient_0().to_u32())
    proof_store(tape, region, base + 1, evaluation.coefficient_1().to_u32())
    proof_store(tape, region, base + 2, evaluation.coefficient_2().to_u32())
    proof_store(tape, region, base + 3, evaluation.coefficient_3().to_u32())
}

actor MandelbrotProofGpuCheckpoint uses (
    Program<WebGpuBackend>, SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    proof: ProofTape<u32, PROOF_WORDS>,
    lde_inverse_values: ProofTape<u32, TRACE_WORDS>,
    lde_inverse_progress: ProofTape<u32, INPUT_GRID_LANES>,
    lde_values: ProofTape<u32, LDE_WORDS>,
    lde_progress: ProofTape<u32, OUTPUT_GRID_LANES>,
    lde_coset_valid: ProofTape<u32, COLUMN_COUNT>,
    tamper: f32,
    res: f32,

    const fn view() -> Surface<ProofParams> {
        Surface {
            extent: Extent::square(512),
            params: proof_params(),
        }
    }

    fn derive_witness(self) uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let regions = proof_tape_regions()
        let trace_layout = trace_regions()
        let trace_step = subregion(regions.trace, trace_layout.step)
        let trace_magnitude = subregion(regions.trace, trace_layout.magnitude)
        let trace_active = subregion(regions.trace, trace_layout.active)
        let trace_terminal = subregion(regions.trace, trace_layout.terminal)
        let trace_valid_region = subregion(
            regions.status,
            status_regions().trace_valid,
        )

        // c = 0.75 + 0i escapes on row three, giving an exact four-row
        // power-of-two trace. This first fixed-size GPU checkpoint spells out
        // the four stream positions so the call-free SPIR-V legality pass can
        // inline the production recurrence. No witness row enters from the
        // host and no recurrence is duplicated here.
        let claim = EscapesByQ12::new(3072, 0, 4)
        let mut stream = EscapeAirWordStream::new(claim)

        let row0 = stream.current_proof_row()
        proof_store(self.proof, trace_step, 0, row0.air.step)
        proof_store(self.proof, trace_magnitude, 0, row0.air.magnitude)
        proof_store(self.proof, trace_active, 0, row0.active)
        proof_store(self.proof, trace_terminal, 0, row0.terminal)

        stream.advance()
        let row1 = stream.current_proof_row()
        proof_store(self.proof, trace_step, 1, row1.air.step)
        proof_store(self.proof, trace_magnitude, 1, row1.air.magnitude)
        proof_store(self.proof, trace_active, 1, row1.active)
        proof_store(self.proof, trace_terminal, 1, row1.terminal)

        stream.advance()
        let row2 = stream.current_proof_row()
        proof_store(self.proof, trace_step, 2, row2.air.step)
        proof_store(self.proof, trace_magnitude, 2, row2.air.magnitude)
        proof_store(self.proof, trace_active, 2, row2.active)
        proof_store(self.proof, trace_terminal, 2, row2.terminal)

        stream.advance()
        let row3 = stream.current_proof_row()
        proof_store(self.proof, trace_step, 3, row3.air.step)
        proof_store(self.proof, trace_magnitude, 3, row3.air.magnitude)
        proof_store(self.proof, trace_active, 3, row3.active)
        proof_store(self.proof, trace_terminal, 3, row3.terminal)

        let trace_valid = stream.is_valid()
            && stream.is_terminal()
        proof_store(
            self.proof,
            trace_valid_region,
            0,
            if trace_valid { 1 } else { 0 },
        )

        // Derive the canonical Grain parameter stream once on the GPU. The
        // repeated proof schedule reads this typed storage region, so no round
        // invocation materializes the full CTFE aggregate in its shader.
        let mut parameters = Poseidon2ParameterStream::begin()
        let mut parameter: usize = 0
        while parameter < ROUND_CONSTANT_COUNT {
            proof_store(
                self.proof,
                regions.parameters,
                parameter.downcast_truncate(),
                parameters.next(),
            )
            parameter = parameter + 1
        }
    }

    fn prepare_lde_inverse(self, invocation: ComputeInvocation)
        uses (Prove<Threads<INPUT_GRID_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        let trace_start = region_bounds(proof_tape_regions().trace).start
        prepare_batched_stage_grid<
            COLUMN_COUNT,
            TRACE,
            INPUT_LANES,
            PROOF_WORDS,
            TRACE_WORDS,
            INPUT_GRID_LANES,
        >(
            self.proof,
            trace_start,
            self.lde_inverse_values,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn advance_lde_inverse(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<INPUT_GRID_LANES, 1, 1>,
                Repeat<1, 1, 1, INPUT_STAGES>,
            >
        )
    {
        inverse_batched_stage_grid_lane<
            COLUMN_COUNT,
            TRACE,
            INPUT_LANES,
            TRACE_WORDS,
            INPUT_GRID_LANES,
            BabyBear,
            ProofLdeInputPlan,
        >(
            self.lde_inverse_values,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn prepare_lde_forward(self, invocation: ComputeInvocation)
        uses (Prove<Threads<OUTPUT_GRID_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        prepare_batched_coset_extension<
            COLUMN_COUNT,
            TRACE,
            LDE,
            INPUT_LANES,
            OUTPUT_LANES,
            TRACE_WORDS,
            INPUT_GRID_LANES,
            LDE_WORDS,
            OUTPUT_GRID_LANES,
            COLUMN_COUNT,
            BabyBear,
            ProofLdeInputPlan,
            ProofLdeOutputPlan,
        >(
            self.lde_inverse_values,
            self.lde_inverse_progress,
            self.lde_values,
            self.lde_progress,
            self.lde_coset_valid,
            BabyBear::from_u32(7),
            invocation,
        )
    }

    fn advance_lde_forward(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<OUTPUT_GRID_LANES, 1, 1>,
                Repeat<1, 1, 1, OUTPUT_STAGES>,
            >
        )
    {
        forward_batched_stage_grid_lane<
            COLUMN_COUNT,
            LDE,
            OUTPUT_LANES,
            LDE_WORDS,
            OUTPUT_GRID_LANES,
            BabyBear,
            ProofLdeOutputPlan,
        >(
            self.lde_values,
            self.lde_progress,
            invocation,
        )
    }

    fn finish_lde(self, invocation: ComputeInvocation)
        uses (Prove<Threads<OUTPUT_GRID_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        let regions = proof_tape_regions()
        let lde_start = region_bounds(regions.lde).start
        let lde_valid = subregion(regions.status, status_regions().lde_valid)
        let finish = finish_batched_stage_grid_into<
            COLUMN_COUNT,
            LDE,
            OUTPUT_LANES,
            LDE_WORDS,
            OUTPUT_GRID_LANES,
            COLUMN_COUNT,
            PROOF_WORDS,
            ProofLdeOutputPlan,
        >(
            self.lde_values,
            self.lde_progress,
            self.lde_coset_valid,
            self.proof,
            lde_start,
            invocation,
        )
        if finish.active && finish.lane == 0 {
            proof_store(
                self.proof,
                lde_valid,
                finish.batch,
                if finish.valid { 1 } else { 0 },
            )
        }
    }

    fn initialize_commitments(self) uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let regions = proof_tape_regions()
        // The static assertions above tie these concrete array types to the
        // sponge-derived rate while Fe const-alias generic arguments mature.
        let fields = load_lde_fields<6>(tape: self.proof, region: regions.lde)
        let sponge = Poseidon2FieldSponge::begin<MandelbrotGpuLdeV1>(
            expected: LDE_WORDS.downcast_truncate(),
        )
        let permutation = sponge.begin_permutation<6>(fields: ref fields)
        store_initial_commitment(
            tape: self.proof,
            state: regions.clean_commitment,
            permutation: ref permutation,
        )
        store_initial_commitment(
            tape: self.proof,
            state: regions.observed_commitment,
            permutation: ref permutation,
        )
    }

    fn advance_commitment_rounds(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<COMMITMENT_WORKGROUP_LANES, 1, 1>,
                Repeat<1, 1, 1, COMMITMENT_SCHEDULE_STEPS>,
            >
        )
    {
        let regions = proof_tape_regions()
        let state_layout = commitment_regions()
        let poseidon_lanes: u32 = POSEIDON_LANES.downcast_truncate()
        let commitment_lane = invocation.local.x / poseidon_lanes
        let field_lane = invocation.local.x % poseidon_lanes
        let field_index: RegionIndex<[u32; POSEIDON_LANES]> =
            cyclic_region_index(field_lane)
        let observed = commitment_lane == 1
        let state = if observed {
            regions.observed_commitment
        } else {
            regions.clean_commitment
        }
        let primary_region = subregion(state, state_layout.primary)
        let secondary_region = subregion(state, state_layout.secondary)
        let cursor_region = subregion(state, state_layout.cursor)
        let block_region = subregion(state, state_layout.block)
        let valid_region = subregion(state, state_layout.valid)
        let cursor = proof_load_indexed(self.proof, cursor_region, field_index)
        let block = proof_load_indexed(self.proof, block_region, field_index)
        let mut valid = proof_load_indexed(self.proof, valid_region, field_index)
        let primary = load_commitment_buffer(
            tape: self.proof,
            state: state,
            buffer: state_layout.primary,
        )
        let secondary = load_commitment_buffer(
            tape: self.proof,
            state: state,
            buffer: state_layout.secondary,
        )
        let mut checked: usize = 0
        while checked < POSEIDON_LANES {
            if primary[checked] >= BABY_BEAR_MODULUS { valid = 0 }
            if secondary[checked] >= BABY_BEAR_MODULUS { valid = 0 }
            checked = checked + 1
        }

        let transition =
            <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
        if cursor < transition {
            let destination = poseidon2_workgroup_destination(cursor)
            let output = if destination == 0 {
                primary_region
            } else {
                secondary_region
            }
            let mut round_constant: u32 = 0
            if cursor != 0 && ((cursor - 1) & 1) == 0 {
                let phase = (cursor - 1) / 2
                let index = poseidon2_round_constant_index(phase, field_lane)
                round_constant = proof_load(self.proof, regions.parameters, index)
            }
            let value = if valid == 1 {
                poseidon2_workgroup_lane_with_round_constant(
                    ref primary,
                    ref secondary,
                    cursor,
                    field_lane,
                    round_constant,
                )
            } else {
                0
            }
            proof_store_indexed(self.proof, output, field_index, value)
            proof_store_indexed(self.proof, cursor_region, field_index, cursor + 1)
            proof_store_indexed(self.proof, block_region, field_index, block)
            proof_store_indexed(self.proof, valid_region, field_index, valid)
        } else if cursor == transition && block < FINAL_FULL_BLOCK.downcast_truncate() {
            let first_block_fields: u32 = FIRST_BLOCK_FIELDS.downcast_truncate()
            let sponge_rate: u32 = SPONGE_RATE.downcast_truncate()
            let start = first_block_fields + block * sponge_rate
            let mut value = secondary[field_lane as usize]
            if field_lane < sponge_rate {
                value = BabyBear::from_u32(proof_load(
                    self.proof,
                    regions.lde,
                    start + field_lane,
                )).to_montgomery_word()
            }
            if observed && self.tamper >= 0.5
                && block == TAMPER_PRECEDING_BLOCK.downcast_truncate()
                && field_lane == TAMPER_NEXT_BLOCK_FIELD.downcast_truncate()
            {
                value = (BabyBear::from_montgomery_word(value) + BabyBear::one())
                    .to_montgomery_word()
            }
            proof_store_indexed(
                self.proof,
                primary_region,
                field_index,
                if valid == 1 { value } else { 0 },
            )
            proof_store_indexed(self.proof, cursor_region, field_index, 0)
            proof_store_indexed(self.proof, block_region, field_index, block + 1)
            proof_store_indexed(self.proof, valid_region, field_index, valid)
        } else if cursor == transition && block == FINAL_FULL_BLOCK.downcast_truncate() {
            let mut value = secondary[field_lane as usize]
            if field_lane < 2 {
                let final_field_start: u32 =
                    (LDE_WORDS - 2).downcast_truncate()
                value = BabyBear::from_u32(proof_load(
                    self.proof,
                    regions.lde,
                    final_field_start + field_lane,
                )).to_montgomery_word()
            }
            proof_store_indexed(
                self.proof,
                primary_region,
                field_index,
                if valid == 1 { value } else { 0 },
            )
            proof_store_indexed(self.proof, cursor_region, field_index, 0)
            proof_store_indexed(
                self.proof,
                block_region,
                field_index,
                FINAL_PARTIAL_BLOCK.downcast_truncate(),
            )
            proof_store_indexed(self.proof, valid_region, field_index, valid)
        } else if cursor == transition && block == FINAL_PARTIAL_BLOCK.downcast_truncate() {
            if field_lane < DIGEST_FIELDS.downcast_truncate() {
                let root = if observed {
                    regions.observed_root
                } else {
                    regions.clean_root
                }
                proof_store(
                    self.proof,
                    root,
                    field_lane,
                    BabyBear::from_montgomery_word(
                        secondary[field_lane as usize]
                    ).to_u32(),
                )
            }
            proof_store_indexed(
                self.proof,
                primary_region,
                field_index,
                secondary[field_lane as usize],
            )
            proof_store_indexed(self.proof, cursor_region, field_index, 0)
            proof_store_indexed(
                self.proof,
                block_region,
                field_index,
                if valid == 1 {
                    DONE_BLOCK.downcast_truncate()
                } else {
                    0
                },
            )
            proof_store_indexed(self.proof, valid_region, field_index, valid)
        } else {
            proof_store_indexed(self.proof, cursor_region, field_index, 0)
            proof_store_indexed(self.proof, block_region, field_index, 0)
            proof_store_indexed(self.proof, valid_region, field_index, 0)
        }
    }

    fn finalize_commitments(self) uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let regions = proof_tape_regions()
        let status_layout = status_regions()
        let clean_root = load_digest(tape: self.proof, region: regions.clean_root)
        let observed_root = load_digest(tape: self.proof, region: regions.observed_root)
        let tampered = self.tamper >= 0.5
        let roots_equal = clean_root.equals(observed_root)
        let trace_valid = stored_flag(
            self.proof,
            subregion(regions.status, status_layout.trace_valid),
        )
        let lde_valid = all_lde_columns_valid(
            self.proof,
            subregion(regions.status, status_layout.lde_valid),
        )
        let commitments_valid = commitment_state_valid(
            tape: self.proof,
            state: regions.clean_commitment,
        ) && commitment_state_valid(
            tape: self.proof,
            state: regions.observed_commitment,
        )
        let root_nonzero = commitments_valid
            && !clean_root.equals(Poseidon2Digest::zero())
        let mode_correct = trace_valid && lde_valid && commitments_valid && (
            if tampered { !roots_equal } else { roots_equal }
        )

        proof_store(
            self.proof,
            subregion(regions.status, status_layout.roots_equal),
            0,
            if roots_equal { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.mode_correct),
            0,
            if mode_correct { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.trace_color),
            0,
            status_word(trace_valid, false),
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.lde_color),
            0,
            status_word(lde_valid, false),
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.root_color),
            0,
            status_word(root_nonzero, false),
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.mode_color),
            0,
            status_word(mode_correct, tampered),
        )
    }

    fn fold_fri_pairs(self, invocation: ComputeInvocation)
        uses (Prove<Threads<FRI_WORKGROUP_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        let regions = proof_tape_regions()
        let fri_layout = fri_status_regions()
        let pairs: u32 = FRI_PAIRS.downcast_truncate()
        let lane = invocation.local.x
        let observed = lane >= pairs
        let pair = lane % pairs
        let negative_index = pair + pairs
        let lde_words: u32 = LDE.downcast_truncate()
        let positive = BabyBearExt4::from_coordinate_words(
            proof_load(self.proof, regions.lde, pair),
            proof_load(self.proof, regions.lde, pair + lde_words),
            proof_load(self.proof, regions.lde, pair + lde_words + lde_words),
            proof_load(
                self.proof,
                regions.lde,
                pair + lde_words + lde_words + lde_words,
            ),
        )
        let negative = BabyBearExt4::from_coordinate_words(
            proof_load(self.proof, regions.lde, negative_index),
            proof_load(self.proof, regions.lde, negative_index + lde_words),
            proof_load(
                self.proof,
                regions.lde,
                negative_index + lde_words + lde_words,
            ),
            proof_load(
                self.proof,
                regions.lde,
                negative_index + lde_words + lde_words + lde_words,
            ),
        )
        let changed_coefficient = if observed
            && self.tamper >= 0.5
            && pair == 1
        {
            positive.coefficient_1() + BabyBear::one()
        } else {
            positive.coefficient_1()
        }
        let observed_positive = BabyBearExt4::from_coordinate_fields(
            positive.coefficient_0(),
            changed_coefficient,
            positive.coefficient_2(),
            positive.coefficient_3(),
        )
        let challenge = BabyBearExt4::from_coordinate_words(
            proof_load(self.proof, regions.clean_root, 0),
            proof_load(self.proof, regions.clean_root, 1),
            proof_load(self.proof, regions.clean_root, 2),
            proof_load(self.proof, regions.clean_root, 3),
        )
        let shift = BabyBear::from_u32(7)
        let folded = fold_fri_pair_value_at_power_of_two<16>(
            observed_positive,
            negative,
            challenge,
            shift,
            pair,
        )
        let destination = if observed {
            regions.fri_observed
        } else {
            regions.fri_clean
        }
        let validity = if observed {
            subregion(regions.fri_status, fri_layout.observed_valid)
        } else {
            subregion(regions.fri_status, fri_layout.clean_valid)
        }
        store_fri_evaluation(
            self.proof,
            destination,
            pair,
            folded,
        )
        proof_store(
            self.proof,
            validity,
            pair,
            if !shift.is_zero() && pair < pairs { 1 } else { 0 },
        )
    }

    fn finalize_fri_fold(self) uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let regions = proof_tape_regions()
        let status_layout = status_regions()
        let fri_layout = fri_status_regions()
        let clean_valid = all_fri_pairs_valid(
            self.proof,
            subregion(regions.fri_status, fri_layout.clean_valid),
        )
        let observed_valid = all_fri_pairs_valid(
            self.proof,
            subregion(regions.fri_status, fri_layout.observed_valid),
        )
        let equal = fri_outputs_equal(
            self.proof,
            regions.fri_clean,
            regions.fri_observed,
        )
        let tampered = self.tamper >= 0.5
        let fri_correct = clean_valid && observed_valid && (
            if tampered { !equal } else { equal }
        )
        let previous_correct = stored_flag(
            self.proof,
            subregion(regions.status, status_layout.mode_correct),
        )
        let overall = previous_correct && fri_correct

        proof_store(
            self.proof,
            subregion(regions.fri_status, fri_layout.equal),
            0,
            if equal { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.fri_status, fri_layout.correct),
            0,
            if fri_correct { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.fri_status, fri_layout.color),
            0,
            status_word(fri_correct, tampered),
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.mode_correct),
            0,
            if overall { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.mode_color),
            0,
            status_word(overall, tampered),
        )
    }

    fn display(self, px: i32, py: i32) -> i32 uses (Display) {
        let regions = proof_tape_regions()
        let status_layout = status_regions()
        let fri_layout = fri_status_regions()
        let u = from_i32(px) / self.res
        let v = from_i32(py) / self.res
        let tampered = self.tamper >= 0.5

        if v < 0.18 {
            if u < 0.2 {
                return proof_load(
                    self.proof,
                    subregion(regions.status, status_layout.trace_color),
                    0,
                ).downcast_truncate()
            }
            if u < 0.4 {
                return proof_load(
                    self.proof,
                    subregion(regions.status, status_layout.lde_color),
                    0,
                ).downcast_truncate()
            }
            if u < 0.6 {
                return proof_load(
                    self.proof,
                    subregion(regions.status, status_layout.root_color),
                    0,
                ).downcast_truncate()
            }
            if u < 0.8 {
                return proof_load(
                    self.proof,
                    subregion(regions.fri_status, fri_layout.color),
                    0,
                ).downcast_truncate()
            }
            return proof_load(
                self.proof,
                subregion(regions.status, status_layout.mode_color),
                0,
            ).downcast_truncate()
        }
        if v > 0.82 {
            return proof_load(
                self.proof,
                subregion(regions.status, status_layout.mode_color),
                0,
            ).downcast_truncate()
        }

        let sample_i = to_i32(u * 32.0).downcast_unchecked()
        let folded = if tampered {
            regions.fri_observed
        } else {
            regions.fri_clean
        }
        let sample = proof_load(self.proof, folded, sample_i)
        let red = 54 + (sample & 127)
        let green = 42 + ((sample >> 8) & 95)
        let blue = 96 + ((sample >> 16) & 127)
        let stripe = if u + v > 1.0 { 18 } else { 0 }
        let reject_glow = if tampered { 26 } else { 0 }
        packed_rgba(red + reject_glow, green + stripe, blue)
    }
}

fn all_lde_columns_valid(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; COLUMN_COUNT]>,
) -> bool {
    proof_load(tape, region, 0) == 1
        && proof_load(tape, region, 1) == 1
        && proof_load(tape, region, 2) == 1
        && proof_load(tape, region, 3) == 1
}

fn all_fri_pairs_valid(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; FRI_PAIRS]>,
) -> bool {
    let mut pair: usize = 0
    while pair < FRI_PAIRS {
        if proof_load(tape, region, pair.downcast_truncate()) != 1 {
            return false
        }
        pair = pair + 1
    }
    true
}

fn fri_outputs_equal(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ left: Region<ProofTapeRegions, [u32; FRI_FOLD_WORDS]>,
    _ right: Region<ProofTapeRegions, [u32; FRI_FOLD_WORDS]>,
) -> bool {
    let mut word: usize = 0
    while word < FRI_FOLD_WORDS {
        let index: u32 = word.downcast_truncate()
        if proof_load(tape, left, index) != proof_load(tape, right, index) {
            return false
        }
        word = word + 1
    }
    true
}

fn stored_flag(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, u32>,
) -> bool {
    let word: i32 = proof_load(tape, region, 0).downcast_truncate()
    word == 1
}
