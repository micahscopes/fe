const TRACE: usize = 4
const LDE: usize = 16
const COLUMN_COUNT: usize = 4
const TRACE_WORDS: usize = COLUMN_COUNT * TRACE
const LDE_WORDS: usize = COLUMN_COUNT * LDE
const INPUT_LANES: usize = TRACE / 2
const OUTPUT_LANES: usize = LDE / 2
const INPUT_GRID_LANES: usize = COLUMN_COUNT * INPUT_LANES
const OUTPUT_GRID_LANES: usize = COLUMN_COUNT * OUTPUT_LANES
const DIGEST_FIELDS: usize = 8
const COMMIT_STATE_WORDS: usize = 80
const STATUS_WORDS: usize = 11
const EXTENSION_WORDS: usize = 4
const FRI_ROUNDS: usize = 4
const FRI_VARIANTS: usize = 2
const FRI_MAX_OUTPUT: usize = LDE / 2
const FRI_EVALUATIONS: usize = 15
const FRI_EVALUATION_WORDS: usize = FRI_EVALUATIONS * EXTENSION_WORDS
const FRI_CHALLENGE_WORDS: usize =
    FRI_VARIANTS * FRI_ROUNDS * EXTENSION_WORDS
const FRI_ROOT_WORDS: usize = FRI_VARIANTS * FRI_ROUNDS * DIGEST_FIELDS
const FRI_TRANSCRIPTS_PER_VARIANT: usize = FRI_ROUNDS + 1
const FRI_TRANSCRIPT_WORDS: usize =
    FRI_VARIANTS * FRI_TRANSCRIPTS_PER_VARIANT * DIGEST_FIELDS
const FRI_VALID_ROUNDS: usize = FRI_VARIANTS * FRI_ROUNDS
const FRI_VALID_TRANSCRIPTS: usize =
    FRI_VARIANTS * FRI_TRANSCRIPTS_PER_VARIANT
const FRI_STATUS_WORDS: usize =
    FRI_VALID_ROUNDS + FRI_VALID_ROUNDS + FRI_VALID_TRANSCRIPTS
        + FRI_VALID_ROUNDS + 3
const PROOF_WORDS: usize = TRACE_WORDS
    + LDE_WORDS
    + 2 * DIGEST_FIELDS
    + STATUS_WORDS
    + 2 * COMMIT_STATE_WORDS
    + ROUND_CONSTANT_COUNT
    + 2 * FRI_EVALUATION_WORDS
    + FRI_CHALLENGE_WORDS
    + FRI_ROOT_WORDS
    + FRI_TRANSCRIPT_WORDS
    + FRI_STATUS_WORDS

struct ProofTapeRegions {
    trace: Region<ProofTapeRegions, [u32; TRACE_WORDS]>,
    lde: Region<ProofTapeRegions, [u32; LDE_WORDS]>,
    clean_root: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
    observed_root: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
    status: Region<ProofTapeRegions, [u32; STATUS_WORDS]>,
    clean_commitment: Region<ProofTapeRegions, [u32; COMMIT_STATE_WORDS]>,
    observed_commitment: Region<ProofTapeRegions, [u32; COMMIT_STATE_WORDS]>,
    parameters: Region<ProofTapeRegions, [u32; ROUND_CONSTANT_COUNT]>,
    fri_clean: Region<ProofTapeRegions, [u32; FRI_EVALUATION_WORDS]>,
    fri_observed: Region<ProofTapeRegions, [u32; FRI_EVALUATION_WORDS]>,
    fri_challenges: Region<ProofTapeRegions, [u32; FRI_CHALLENGE_WORDS]>,
    fri_roots: Region<ProofTapeRegions, [u32; FRI_ROOT_WORDS]>,
    fri_transcripts: Region<ProofTapeRegions, [u32; FRI_TRANSCRIPT_WORDS]>,
    fri_status: Region<ProofTapeRegions, [u32; FRI_STATUS_WORDS]>,
}
impl core::marker::Copy for ProofTapeRegions {}
derive RegionSchema for ProofTapeRegions using RegionSchemaProvider

