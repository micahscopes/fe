#[inline(always)]
fn proof_load<T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ tape: ProofTape<u32, STORAGE_WORDS>,
    _ region: Region<ProofTapeRegions, T>,
    _ index: u32,
) -> u32
where
    STORAGE_WORDS > 0,
{
    load_region_word(tape, region, index).value
}

#[inline(always)]
fn proof_store<T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ tape: ProofTape<u32, STORAGE_WORDS>,
    _ region: Region<ProofTapeRegions, T>,
    _ index: u32,
    _ value: u32,
) -> bool
where
    STORAGE_WORDS > 0,
{
    store_region_word(tape, region, index, value)
}

#[inline(always)]
fn proof_load_indexed<T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ tape: ProofTape<u32, STORAGE_WORDS>,
    _ region: Region<ProofTapeRegions, T>,
    _ index: RegionIndex<T>,
) -> u32
where
    STORAGE_WORDS > 0,
{
    load_region_indexed_word(tape, region, index)
}

#[inline(always)]
fn proof_store_indexed<T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ tape: ProofTape<u32, STORAGE_WORDS>,
    _ region: Region<ProofTapeRegions, T>,
    _ index: RegionIndex<T>,
    _ value: u32,
)
where
    STORAGE_WORDS > 0,
{
    store_region_indexed_word(tape, region, index, value)
}

type ProofLdeColumns = RBin<Pair, 2>
type ProofLdeInputPlan = RBin<Pair, 2>
type ProofLdeOutputPlan = RBin<Pair, 4>
type ProofFriSchedule = FriSchedule<1, 4>
type ProofFriLeafPairs = RBin<Pair, 3>
type ProofFriVariants = RBin<Pair, 1>
const LDE_TASKS: usize = <ProofLdeColumns as BalancedBinarySchedule>::LEAVES
const INPUT_STAGES: usize = <ProofLdeInputPlan as FactorTree>::FACTORS
const OUTPUT_STAGES: usize = <ProofLdeOutputPlan as FactorTree>::FACTORS
const FRI_MAX_PAIR_LANES: usize =
    <ProofFriLeafPairs as BalancedBinarySchedule>::LEAVES
const FRI_VARIANT_LANES: usize =
    <ProofFriVariants as BalancedBinarySchedule>::LEAVES
const FRI_WORKGROUP_LANES: usize =
    FRI_MAX_PAIR_LANES * FRI_VARIANT_LANES * POSEIDON_LANES
const FRI_MAX_HASH_STATES: usize = FRI_MAX_PAIR_LANES * FRI_VARIANT_LANES
const FRI_HASH_BUFFERS: usize = 2
const FRI_HASH_STATE_WORDS: usize =
    FRI_MAX_HASH_STATES * FRI_HASH_BUFFERS * POSEIDON_LANES
const FRI_HASH_VALID_WORDS: usize = FRI_MAX_HASH_STATES
const FRI_HASH_TAIL_WORDS: usize = FRI_VARIANTS * 10
const FRI_TREE_NODES_PER_VARIANT: usize = 2 * FRI_MAX_OUTPUT - 1
const FRI_TREE_WORDS: usize =
    FRI_VARIANTS * FRI_TREE_NODES_PER_VARIANT * DIGEST_FIELDS
const FRI_TREE_VALID_WORDS: usize =
    FRI_VARIANTS * FRI_TREE_NODES_PER_VARIANT
const FRI_PROGRESS_WORDS: usize = FRI_ROUNDS * FRI_WORKGROUP_LANES
const FRI_SCRATCH_WORDS: usize = FRI_HASH_STATE_WORDS
    + FRI_HASH_VALID_WORDS
    + FRI_HASH_TAIL_WORDS
    + FRI_TREE_WORDS
    + FRI_TREE_VALID_WORDS
    + FRI_PROGRESS_WORDS

struct FriScratchRegions {
    hash_states: Region<FriScratchRegions, [u32; FRI_HASH_STATE_WORDS]>,
    hash_valid: Region<FriScratchRegions, [u32; FRI_HASH_VALID_WORDS]>,
    hash_tails: Region<FriScratchRegions, [u32; FRI_HASH_TAIL_WORDS]>,
    tree: Region<FriScratchRegions, [u32; FRI_TREE_WORDS]>,
    tree_valid: Region<FriScratchRegions, [u32; FRI_TREE_VALID_WORDS]>,
    progress: Region<FriScratchRegions, [u32; FRI_PROGRESS_WORDS]>,
}
impl core::marker::Copy for FriScratchRegions {}
derive RegionSchema for FriScratchRegions using RegionSchemaProvider

const fn fri_scratch_regions() -> FriScratchRegions {
    <FriScratchRegions as RegionSchema>::regions()
}

const FRI_HASH_STATES_START: u32 =
    region_bounds(fri_scratch_regions().hash_states).start
const FRI_HASH_VALID_START: u32 =
    region_bounds(fri_scratch_regions().hash_valid).start
const FRI_HASH_TAILS_START: u32 =
    region_bounds(fri_scratch_regions().hash_tails).start
const FRI_TREE_START: u32 = region_bounds(fri_scratch_regions().tree).start
const FRI_TREE_VALID_START: u32 =
    region_bounds(fri_scratch_regions().tree_valid).start
const FRI_PROGRESS_START: u32 =
    region_bounds(fri_scratch_regions().progress).start

#[inline(always)]
fn fri_scratch_load(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ start: u32,
    _ index: u32,
) -> u32 {
    scratch.load(index: start + index)
}

#[inline(always)]
fn fri_scratch_store(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ start: u32,
    _ index: u32,
    _ value: u32,
) -> bool {
    scratch.store(index: start + index, value: value)
    true
}

const fn proof_fri_metadata() -> FriScheduleMetadata {
    <ProofFriSchedule as FriScheduleShape>::fri_schedule_metadata()
}

const HASH_STAGE_STEPS: usize =
    <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::STEPS
const FRI_CHALLENGE_PLACEMENT_STEPS: usize = 1 + 2 * HASH_STAGE_STEPS
const FRI_LEAF_PLACEMENT_STEPS: usize = 1 + HASH_STAGE_STEPS
const FRI_BINDING_PLACEMENT_STEPS: usize = 1 + 3 * HASH_STAGE_STEPS

const fn fri_round_schedule_steps(_ tree_depth: usize) -> usize {
    FRI_CHALLENGE_PLACEMENT_STEPS
        + 1
        + FRI_LEAF_PLACEMENT_STEPS
        + tree_depth * FRI_LEAF_PLACEMENT_STEPS
        + FRI_BINDING_PLACEMENT_STEPS
}

const fn runtime_fri_round_schedule_steps(_ tree_depth: u32) -> u32 {
    let challenge: u32 = FRI_CHALLENGE_PLACEMENT_STEPS.downcast_truncate()
    let leaf: u32 = FRI_LEAF_PLACEMENT_STEPS.downcast_truncate()
    let binding: u32 = FRI_BINDING_PLACEMENT_STEPS.downcast_truncate()
    challenge + 1 + leaf + tree_depth * leaf + binding
}

const FRI_ROUND_1_STEPS: usize = fri_round_schedule_steps(3)
const FRI_ROUND_2_STEPS: usize = fri_round_schedule_steps(2)
const FRI_ROUND_3_STEPS: usize = fri_round_schedule_steps(1)
const FRI_ROUND_4_STEPS: usize = fri_round_schedule_steps(0)
static_assert(runtime_fri_round_schedule_steps(3) == FRI_ROUND_1_STEPS.downcast_truncate())
static_assert(runtime_fri_round_schedule_steps(2) == FRI_ROUND_2_STEPS.downcast_truncate())
static_assert(runtime_fri_round_schedule_steps(1) == FRI_ROUND_3_STEPS.downcast_truncate())
static_assert(runtime_fri_round_schedule_steps(0) == FRI_ROUND_4_STEPS.downcast_truncate())
static_assert(LDE_TASKS == COLUMN_COUNT)
static_assert(<ProofLdeInputPlan as FactorTree>::POINTS == TRACE)
static_assert(<ProofLdeOutputPlan as FactorTree>::POINTS == LDE)
static_assert(INPUT_STAGES == 2)
static_assert(OUTPUT_STAGES == 4)
static_assert(INPUT_GRID_LANES == 8)
static_assert(OUTPUT_GRID_LANES == 32)
static_assert(proof_fri_metadata().rounds == FRI_ROUNDS.downcast_truncate())
static_assert(proof_fri_metadata().first_round == 1)
static_assert(proof_fri_metadata().next_round == 5)
static_assert(proof_fri_metadata().input_log == 4)
static_assert(
    proof_fri_metadata().folded_evaluations
        == FRI_EVALUATIONS.downcast_truncate()
)
static_assert(FRI_MAX_PAIR_LANES == FRI_MAX_OUTPUT)
static_assert(FRI_VARIANT_LANES == FRI_VARIANTS)
static_assert(FRI_WORKGROUP_LANES == 256)
static_assert(FRI_MAX_HASH_STATES == 16)
static_assert(FRI_HASH_STATE_WORDS == 512)
static_assert(FRI_TREE_NODES_PER_VARIANT == 15)
static_assert(FRI_TREE_WORDS == 240)
static_assert(FRI_PROGRESS_WORDS == 1024)
static_assert(
    <FriScratchRegions as RegionSchema>::WORDS
        == FRI_SCRATCH_WORDS.downcast_truncate()
)
static_assert(HASH_STAGE_STEPS == 44)
static_assert(FRI_ROUND_1_STEPS == 403)
static_assert(FRI_ROUND_2_STEPS == 358)
static_assert(FRI_ROUND_3_STEPS == 313)
static_assert(FRI_ROUND_4_STEPS == 268)
static_assert(<ProofTapeRegions as RegionSchema>::WORDS == PROOF_WORDS.downcast_truncate())
static_assert(<TraceRegions as RegionSchema>::WORDS == TRACE_WORDS.downcast_truncate())
static_assert(<StatusRegions as RegionSchema>::WORDS == STATUS_WORDS.downcast_truncate())
static_assert(
    <CommitmentRegions as RegionSchema>::WORDS
        == COMMIT_STATE_WORDS.downcast_truncate()
)
static_assert(
    <FriStatusRegions as RegionSchema>::WORDS
        == FRI_STATUS_WORDS.downcast_truncate()
)

type CommitmentDependencies = RBin<Pair, 1>
const COMMITMENT_LANES: usize =
    <CommitmentDependencies as BalancedBinarySchedule>::LEAVES
const COMMITMENT_FIELD_LANES: usize =
    <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::LANES
const COMMITMENT_WORKGROUP_LANES: usize =
    COMMITMENT_LANES * COMMITMENT_FIELD_LANES
const COMMITMENT_MESSAGE_FIELDS: usize = LDE_WORDS + 2
const COMMITMENT_PERMUTATIONS: usize =
    (COMMITMENT_MESSAGE_FIELDS + SPONGE_RATE - 1) / SPONGE_RATE
const COMMITMENT_STEPS_PER_PERMUTATION: usize =
    <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::STEPS
const COMMITMENT_SCHEDULE_STEPS: usize =
    COMMITMENT_PERMUTATIONS * COMMITMENT_STEPS_PER_PERMUTATION
const FIRST_BLOCK_FIELDS: usize = SPONGE_RATE - 2
const COMPLETE_DATA_BLOCKS: usize = (LDE_WORDS - FIRST_BLOCK_FIELDS) / SPONGE_RATE
const FINAL_FULL_BLOCK: usize = COMPLETE_DATA_BLOCKS
const FINAL_PARTIAL_BLOCK: usize = COMMITMENT_PERMUTATIONS - 1
const DONE_BLOCK: usize = COMMITMENT_PERMUTATIONS
const TAMPER_LDE_FIELD: usize = 17
const TAMPER_PRECEDING_BLOCK: usize =
    (TAMPER_LDE_FIELD - FIRST_BLOCK_FIELDS) / SPONGE_RATE
const TAMPER_NEXT_BLOCK_FIELD: usize =
    (TAMPER_LDE_FIELD - FIRST_BLOCK_FIELDS) % SPONGE_RATE
static_assert(COMMITMENT_LANES == 2)
static_assert(COMMITMENT_FIELD_LANES == 16)
static_assert(COMMITMENT_WORKGROUP_LANES == 32)
static_assert(COMMITMENT_PERMUTATIONS == 9)
static_assert(COMMITMENT_STEPS_PER_PERMUTATION == 44)
static_assert(COMMITMENT_SCHEDULE_STEPS == 396)
static_assert(FIRST_BLOCK_FIELDS == 6)
static_assert(SPONGE_RATE == 8)
static_assert(TAMPER_PRECEDING_BLOCK == 1)
static_assert(TAMPER_NEXT_BLOCK_FIELD == 3)

const fn protocol_tag(_ label: String<4>) -> u32 {
    let bytes = label.as_bytes()
    ((bytes[0] as u32) << 24)
        | ((bytes[1] as u32) << 16)
        | ((bytes[2] as u32) << 8)
        | (bytes[3] as u32)
}

struct MandelbrotGpuLdeV1 {}
impl Poseidon2FieldDomain for MandelbrotGpuLdeV1 {
    const TAG: u32 = protocol_tag("MGDL")
}

struct ProofParams { tamper: Param, res: Param }

const fn proof_params() -> ProofParams {
    ProofParams { tamper: Param::range(min: 0.0, max: 1.0, init: 0.0), res: Param::extent_x() }
}

fn packed_rgba(_ red: u32, _ green: u32, _ blue: u32) -> i32 {
    (4278190080 | (blue << 16) | (green << 8) | red).downcast_truncate()
}

fn status_word(_ ok: bool, _ tampered: bool) -> u32 {
    if !ok {
        packed_rgba(236, 92, 112).downcast_truncate()
    } else {
        if tampered {
            packed_rgba(255, 176, 222).downcast_truncate()
        } else {
            packed_rgba(87, 117, 226).downcast_truncate()
        }
    }
}

#[inline(always)]
fn load_lde_fields<const N: usize>(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; LDE_WORDS]>,
) -> [BabyBear; N]
    where N <= 2147483648
{
    let zero = BabyBear::zero()
    let mut fields = [zero; N]
    let count = fields.len()
    let mut index: usize = 0
    while index < count {
        fields[index] = BabyBear::from_u32(proof_load(
            tape,
            region,
            index.downcast_truncate(),
        ))
        index = index + 1
    }
    fields
}

#[inline(always)]
fn load_commitment_buffer(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ state: Region<ProofTapeRegions, [u32; COMMIT_STATE_WORDS]>,
    _ buffer: Region<CommitmentRegions, [u32; POSEIDON_LANES]>,
) -> [u32; POSEIDON_LANES] {
    let region = subregion(state, buffer)
    let mut lanes = [0; 16]
    let mut lane: usize = 0
    while lane < POSEIDON_LANES {
        let index: RegionIndex<[u32; POSEIDON_LANES]> =
            cyclic_region_index(lane.downcast_truncate())
        lanes[lane] = proof_load_indexed(tape, region, index)
        lane = lane + 1
    }
    lanes
}

#[inline(always)]
fn store_initial_commitment(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ state: Region<ProofTapeRegions, [u32; COMMIT_STATE_WORDS]>,
    _ permutation: ref Poseidon2FieldPermutation,
) {
    let layout = commitment_regions()
    let primary = subregion(state, layout.primary)
    let secondary = subregion(state, layout.secondary)
    let cursor = subregion(state, layout.cursor)
    let block = subregion(state, layout.block)
    let valid = subregion(state, layout.valid)
    let mut lane: usize = 0
    while lane < POSEIDON_LANES {
        let lane_word: u32 = lane.downcast_truncate()
        let index: RegionIndex<[u32; POSEIDON_LANES]> =
            cyclic_region_index(lane_word)
        proof_store_indexed(tape, primary, index, permutation.lane_word(lane: lane_word))
        proof_store_indexed(tape, secondary, index, 0)
        proof_store_indexed(tape, cursor, index, 0)
        proof_store_indexed(tape, block, index, 0)
        proof_store_indexed(
            tape,
            valid,
            index,
            if permutation.is_valid() { 1 } else { 0 },
        )
        lane = lane + 1
    }
}

#[inline(always)]
fn commitment_state_valid(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ state: Region<ProofTapeRegions, [u32; COMMIT_STATE_WORDS]>,
) -> bool {
    let layout = commitment_regions()
    let cursor = subregion(state, layout.cursor)
    let block = subregion(state, layout.block)
    let valid = subregion(state, layout.valid)
    let mut result: u32 = 1
    let mut lane: usize = 0
    while lane < POSEIDON_LANES {
        let lane_word: u32 = lane.downcast_truncate()
        let index: RegionIndex<[u32; POSEIDON_LANES]> =
            cyclic_region_index(lane_word)
        if proof_load_indexed(tape, cursor, index) != 0 {
            result = 0
        }
        if proof_load_indexed(tape, block, index)
            != DONE_BLOCK.downcast_truncate()
        {
            result = 0
        }
        if proof_load_indexed(tape, valid, index) != 1 {
            result = 0
        }
        lane = lane + 1
    }
    result == 1
}

#[inline(always)]
fn load_digest(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
) -> Poseidon2Digest {
    let mut words = [0; DIGEST_FIELDS]
    let mut field: usize = 0
    while field < DIGEST_FIELDS {
        words[field] = proof_load(
            tape,
            region,
            field.downcast_truncate(),
        )
        field = field + 1
    }
    Poseidon2Digest::from_u32s(words)
}

#[inline(always)]
fn load_fri_root_digest(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ root_index: u32,
) -> Poseidon2Digest {
    let region = proof_tape_regions().fri_roots
    let base = root_index * DIGEST_FIELDS.downcast_truncate()
    let mut words = [0; DIGEST_FIELDS]
    let mut field: usize = 0
    while field < DIGEST_FIELDS {
        words[field] = proof_load(
            tape,
            region,
            base + field.downcast_truncate(),
        )
        field = field + 1
    }
    Poseidon2Digest::from_u32s(words)
}

#[inline(always)]
fn store_fri_root_digest(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ root_index: u32,
    _ digest: Poseidon2Digest,
) {
    let region = proof_tape_regions().fri_roots
    let base = root_index * DIGEST_FIELDS.downcast_truncate()
    let mut field: u32 = 0
    while field < DIGEST_FIELDS.downcast_truncate() {
        proof_store(
            tape,
            region,
            base + field,
            digest.field(index: field).to_u32(),
        )
        field = field + 1
    }
}

#[inline(always)]
fn load_fri_transcript_digest(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ transcript_index: u32,
) -> Poseidon2Digest {
    let region = proof_tape_regions().fri_transcripts
    let base = transcript_index * DIGEST_FIELDS.downcast_truncate()
    let mut words = [0; DIGEST_FIELDS]
    let mut field: usize = 0
    while field < DIGEST_FIELDS {
        words[field] = proof_load(
            tape,
            region,
            base + field.downcast_truncate(),
        )
        field = field + 1
    }
    Poseidon2Digest::from_u32s(words)
}

#[inline(always)]
fn store_fri_transcript_digest(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ transcript_index: u32,
    _ digest: Poseidon2Digest,
) {
    let region = proof_tape_regions().fri_transcripts
    let base = transcript_index * DIGEST_FIELDS.downcast_truncate()
    let mut field: u32 = 0
    while field < DIGEST_FIELDS.downcast_truncate() {
        proof_store(
            tape,
            region,
            base + field,
            digest.field(index: field).to_u32(),
        )
        field = field + 1
    }
}

#[inline(always)]
fn store_fri_evaluation(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; FRI_EVALUATION_WORDS]>,
    _ evaluation_index: u32,
    _ evaluation: BabyBearExt4,
) {
    let base = evaluation_index * EXTENSION_WORDS.downcast_truncate()
    proof_store(tape, region, base, evaluation.coefficient_0().to_u32())
    proof_store(tape, region, base + 1, evaluation.coefficient_1().to_u32())
    proof_store(tape, region, base + 2, evaluation.coefficient_2().to_u32())
    proof_store(tape, region, base + 3, evaluation.coefficient_3().to_u32())
}

#[inline(always)]
fn load_fri_evaluation(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; FRI_EVALUATION_WORDS]>,
    _ evaluation_index: u32,
) -> BabyBearExt4 {
    let base = evaluation_index * EXTENSION_WORDS.downcast_truncate()
    BabyBearExt4::from_coordinate_words(
        proof_load(tape, region, base),
        proof_load(tape, region, base + 1),
        proof_load(tape, region, base + 2),
        proof_load(tape, region, base + 3),
    )
}

#[inline(always)]
fn hash_buffer_start(_ state: u32, _ secondary: bool) -> u32 {
    let state_words: u32 = (FRI_HASH_BUFFERS * POSEIDON_LANES).downcast_truncate()
    let buffer_words: u32 = POSEIDON_LANES.downcast_truncate()
    state * state_words + if secondary { buffer_words } else { 0 }
}

#[inline(always)]
fn load_hash_buffer(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ state: u32,
    _ secondary: bool,
) -> [u32; POSEIDON_LANES] {
    let mut words = [0; POSEIDON_LANES]
    let start = hash_buffer_start(state, secondary)
    let mut lane: usize = 0
    while lane < POSEIDON_LANES {
        words[lane] = fri_scratch_load(
            scratch,
            FRI_HASH_STATES_START,
            start + lane.downcast_truncate(),
        )
        lane = lane + 1
    }
    words
}

#[inline(always)]
fn initialize_hash_lane(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ state: u32,
    _ field_lane: u32,
    _ permutation: ref Poseidon2FieldPermutation,
    _ input_valid: bool,
) {
    if state >= FRI_MAX_HASH_STATES.downcast_truncate()
        || field_lane >= POSEIDON_LANES.downcast_truncate()
    {
        return
    }
    fri_scratch_store(
        scratch,
        FRI_HASH_STATES_START,
        hash_buffer_start(state, false) + field_lane,
        permutation.lane_word(lane: field_lane),
    )
    fri_scratch_store(
        scratch,
        FRI_HASH_STATES_START,
        hash_buffer_start(state, true) + field_lane,
        0,
    )
    if field_lane == 0 {
        fri_scratch_store(
            scratch,
            FRI_HASH_VALID_START,
            state,
            if input_valid && permutation.is_valid() { 1 } else { 0 },
        )
    }
}

#[inline(always)]
fn advance_hash_lane(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ state: u32,
    _ field_lane: u32,
    _ step: u32,
) {
    let transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    let mut state_valid = fri_scratch_load(
        scratch,
        FRI_HASH_VALID_START,
        state,
    ) == 1
    let primary = load_hash_buffer(scratch, state, false)
    let secondary = load_hash_buffer(scratch, state, true)
    let mut checked: usize = 0
    while checked < POSEIDON_LANES {
        if primary[checked] >= BABY_BEAR_MODULUS { state_valid = false }
        if secondary[checked] >= BABY_BEAR_MODULUS { state_valid = false }
        checked = checked + 1
    }
    if step >= transition { state_valid = false }
    let mut round_constant: u32 = 0
    if step != 0 && ((step - 1) & 1) == 0 {
        let phase = (step - 1) / 2
        let index = poseidon2_round_constant_index(phase, field_lane)
        round_constant = proof_load(
            proof,
            proof_tape_regions().parameters,
            index,
        )
    }
    let value = if state_valid {
        poseidon2_workgroup_lane_with_round_constant(
            ref primary,
            ref secondary,
            step,
            field_lane,
            round_constant,
        )
    } else {
        0
    }
    let destination = poseidon2_workgroup_destination(step)
    fri_scratch_store(
        scratch,
        FRI_HASH_STATES_START,
        hash_buffer_start(state, destination == 1) + field_lane,
        value,
    )
    if field_lane == 0 {
        fri_scratch_store(
            scratch,
            FRI_HASH_VALID_START,
            state,
            if state_valid { 1 } else { 0 },
        )
    }
}

#[inline(always)]
fn hash_digest(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ state: u32,
) -> Poseidon2Digest {
    let output = load_hash_buffer(scratch, state, true)
    let mut words = [0; DIGEST_FIELDS]
    let mut field: usize = 0
    while field < DIGEST_FIELDS {
        words[field] = BabyBear::from_montgomery_word(output[field]).to_u32()
        field = field + 1
    }
    Poseidon2Digest::from_u32s(words)
}

#[inline(always)]
fn store_tree_digest(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ node: u32,
    _ digest: Poseidon2Digest,
) {
    let base = node * DIGEST_FIELDS.downcast_truncate()
    let mut field: u32 = 0
    while field < DIGEST_FIELDS.downcast_truncate() {
        fri_scratch_store(
            scratch,
            FRI_TREE_START,
            base + field,
            digest.field(index: field).to_u32(),
        )
        field = field + 1
    }
}

#[inline(always)]
fn load_tree_digest(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ node: u32,
) -> Poseidon2Digest {
    let base = node * DIGEST_FIELDS.downcast_truncate()
    let mut words = [0; DIGEST_FIELDS]
    let mut field: usize = 0
    while field < DIGEST_FIELDS {
        words[field] = fri_scratch_load(
            scratch,
            FRI_TREE_START,
            base + field.downcast_truncate(),
        )
        field = field + 1
    }
    Poseidon2Digest::from_u32s(words)
}

#[inline(always)]
fn tree_node(_ variant: u32, _ node: u32) -> u32 {
    variant * FRI_TREE_NODES_PER_VARIANT.downcast_truncate() + node
}

#[inline(always)]
fn tree_level_offset(_ output_width: u32, _ level: u32) -> u32 {
    let mut offset: u32 = 0
    let mut width = output_width
    let mut current: u32 = 0
    while current < level {
        offset = offset + width
        width = width / 2
        current = current + 1
    }
    offset
}

#[inline(always)]
fn fri_round_value_index(_ variant: u32, _ round: u32) -> u32 {
    variant * FRI_ROUNDS.downcast_truncate() + round
}

#[inline(always)]
fn fri_transcript_value_index(_ variant: u32, _ transcript: u32) -> u32 {
    variant * FRI_TRANSCRIPTS_PER_VARIANT.downcast_truncate() + transcript
}

#[inline(always)]
fn fri_shift(_ round_index: u32) -> BabyBear {
    let mut shift = BabyBear::from_u32(7)
    let mut index: u32 = 0
    while index < round_index {
        shift = shift * shift
        index = index + 1
    }
    shift
}

#[inline(always)]
fn advance_fri_round<
    const ROUND_INDEX: usize,
    const INPUT_WIDTH: usize,
    const OUTPUT_WIDTH: usize,
    const TREE_DEPTH: usize,
    const SCHEDULE_STEPS: usize,
>(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ tamper: f32,
    _ invocation: ComputeInvocation,
)
where
    { ROUND_INDEX < FRI_ROUNDS },
    { INPUT_WIDTH > 0 },
    { INPUT_WIDTH > 1 },
    { OUTPUT_WIDTH > 0 },
    { INPUT_WIDTH == 2 * OUTPUT_WIDTH },
    { (INPUT_WIDTH & (INPUT_WIDTH - 1)) == 0 },
    { SCHEDULE_STEPS == fri_round_schedule_steps(TREE_DEPTH) }
{
    let regions = proof_tape_regions()
    let status = fri_status_regions()
    let challenge_valid_region = subregion(
        regions.fri_status,
        status.challenge_valid,
    )
    let root_valid_region = subregion(regions.fri_status, status.root_valid)
    let transcript_valid_region = subregion(
        regions.fri_status,
        status.transcript_valid,
    )
    let round_valid_region = subregion(regions.fri_status, status.round_valid)
    let lane = invocation.local.x
    let lane_count: u32 = FRI_WORKGROUP_LANES.downcast_truncate()
    if lane >= lane_count { return }
    let round_index: u32 = ROUND_INDEX.downcast_truncate()
    let progress_index = round_index * lane_count + lane
    let step = fri_scratch_load(
        scratch,
        FRI_PROGRESS_START,
        progress_index,
    )
    if step >= SCHEDULE_STEPS.downcast_truncate() { return }

    let placement =
        <ProofFriSchedule as FriSchedulePlacement>::fri_round_placement(
            round_index,
        )
    let output_width: u32 = OUTPUT_WIDTH.downcast_truncate()
    let input_width: u32 = INPUT_WIDTH.downcast_truncate()
    let tree_depth: u32 = TREE_DEPTH.downcast_truncate()
    let variant_count: u32 = FRI_VARIANTS.downcast_truncate()
    let expected_tree_depth: u32 = if output_width > 1 {
        placement.pair_depth + 1
    } else {
        0
    }
    let schedule_valid = placement.valid
        && placement.index == round_index
        && placement.round == round_index + 1
        && placement.input_width == input_width
        && placement.output_width == output_width
        && placement.output_offset + output_width
            <= FRI_EVALUATIONS.downcast_truncate()
        && expected_tree_depth == tree_depth

    let hash_stage_steps: u32 = HASH_STAGE_STEPS.downcast_truncate()
    let hash_transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    let challenge_end: u32 = FRI_CHALLENGE_PLACEMENT_STEPS.downcast_truncate()
    let fold_step = challenge_end
    let leaf_start = fold_step + 1
    let tree_start = leaf_start + FRI_LEAF_PLACEMENT_STEPS.downcast_truncate()
    let binding_start = tree_start
        + tree_depth
            * FRI_LEAF_PLACEMENT_STEPS.downcast_truncate()

    if step == 0 {
        if lane < (FRI_VARIANTS * POSEIDON_LANES).downcast_truncate() {
            let state = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            let transcript_index = fri_transcript_value_index(
                state,
                round_index,
            )
            let transcript = load_fri_transcript_digest(
                proof,
                transcript_index,
            )
            let placed = begin_digest_squeeze_placement_tag(
                fri_fold_domain_tag(placement.round),
                transcript,
            )
            let input_valid = schedule_valid && proof_load(
                proof,
                transcript_valid_region,
                transcript_index,
            ) == 1
            initialize_hash_lane(
                scratch,
                state,
                field_lane,
                ref placed.permutation,
                input_valid,
            )
            if field_lane < 2 {
                fri_scratch_store(
                    scratch,
                    FRI_HASH_TAILS_START,
                    state * 10 + field_lane,
                    placed.remaining[field_lane as usize].to_u32(),
                )
            }
        }
    } else if step < challenge_end {
        let relative = step - 1
        let block = relative / hash_stage_steps
        let hash_step = relative % hash_stage_steps
        if lane < (FRI_VARIANTS * POSEIDON_LANES).downcast_truncate() {
            let state = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            if hash_step < hash_transition {
                advance_hash_lane(
                    proof,
                    scratch,
                    state,
                    field_lane,
                    hash_step,
                )
            } else if block == 0 {
                let output = load_hash_buffer(
                    scratch,
                    state,
                    true,
                )
                let tail = [
                    BabyBear::from_u32(fri_scratch_load(
                        scratch,
                        FRI_HASH_TAILS_START,
                        state * 10,
                    )),
                    BabyBear::from_u32(fri_scratch_load(
                        scratch,
                        FRI_HASH_TAILS_START,
                        state * 10 + 1,
                    )),
                ]
                let sponge = Poseidon2FieldSponge::restore(
                    lanes: output,
                    rate: 0,
                    expected: DIGEST_FIELDS.downcast_truncate(),
                    written: 6,
                )
                let permutation = sponge.begin_final_permutation<2>(
                    fields: ref tail,
                )
                initialize_hash_lane(
                    scratch,
                    state,
                    field_lane,
                    ref permutation,
                    fri_scratch_load(
                        scratch,
                        FRI_HASH_VALID_START,
                        state,
                    ) == 1,
                )
            } else {
                if field_lane < EXTENSION_WORDS.downcast_truncate() {
                    let digest = hash_digest(scratch, state)
                    let challenge_base = fri_round_value_index(
                        state,
                        round_index,
                    ) * EXTENSION_WORDS.downcast_truncate()
                    proof_store(
                        proof,
                        regions.fri_challenges,
                        challenge_base + field_lane,
                        digest.field(index: field_lane).to_u32(),
                    )
                }
                if field_lane == 0 {
                    proof_store(
                        proof,
                        challenge_valid_region,
                        fri_round_value_index(state, round_index),
                        fri_scratch_load(
                            scratch,
                            FRI_HASH_VALID_START,
                            state,
                        ),
                    )
                }
            }
        }
    } else if step == fold_step {
        if lane < (FRI_VARIANTS * OUTPUT_WIDTH).downcast_truncate() {
            let variant = lane / output_width
            let pair = lane % output_width
            let mut positive = BabyBearExt4::zero()
            let mut negative = BabyBearExt4::zero()
            let destination = if variant == 0 {
                regions.fri_clean
            } else {
                regions.fri_observed
            }
            if ROUND_INDEX == 0 {
                let lde_words: u32 = LDE.downcast_truncate()
                positive = BabyBearExt4::from_coordinate_words(
                    proof_load(proof, regions.lde, pair),
                    proof_load(proof, regions.lde, pair + lde_words),
                    proof_load(proof, regions.lde, pair + 2 * lde_words),
                    proof_load(proof, regions.lde, pair + 3 * lde_words),
                )
                negative = BabyBearExt4::from_coordinate_words(
                    proof_load(proof, regions.lde, pair + output_width),
                    proof_load(
                        proof,
                        regions.lde,
                        pair + output_width + lde_words,
                    ),
                    proof_load(
                        proof,
                        regions.lde,
                        pair + output_width + 2 * lde_words,
                    ),
                    proof_load(
                        proof,
                        regions.lde,
                        pair + output_width + 3 * lde_words,
                    ),
                )
                if variant == 1 && tamper >= 0.5 && pair == 1 {
                    positive = BabyBearExt4::from_coordinate_fields(
                        positive.coefficient_0(),
                        positive.coefficient_1() + BabyBear::one(),
                        positive.coefficient_2(),
                        positive.coefficient_3(),
                    )
                }
            } else {
                let previous = placement.output_offset - placement.input_width
                positive = load_fri_evaluation(
                    proof,
                    destination,
                    previous + pair,
                )
                negative = load_fri_evaluation(
                    proof,
                    destination,
                    previous + pair + output_width,
                )
            }
            let challenge_base = fri_round_value_index(
                variant,
                round_index,
            ) * EXTENSION_WORDS.downcast_truncate()
            let challenge = BabyBearExt4::from_coordinate_words(
                proof_load(proof, regions.fri_challenges, challenge_base),
                proof_load(proof, regions.fri_challenges, challenge_base + 1),
                proof_load(proof, regions.fri_challenges, challenge_base + 2),
                proof_load(proof, regions.fri_challenges, challenge_base + 3),
            )
            let value_valid = schedule_valid && proof_load(
                proof,
                challenge_valid_region,
                fri_round_value_index(variant, round_index),
            ) == 1
            let folded = if value_valid {
                let root = BabyBear::two_adic_root(placement.input_log)
                fold_fri_pair_value_at_point(
                    positive,
                    negative,
                    challenge,
                    fri_shift(round_index) * root.pow_u32(pair),
                )
            } else {
                BabyBearExt4::zero()
            }
            store_fri_evaluation(
                proof,
                destination,
                placement.output_offset + pair,
                folded,
            )
        }
    } else if step == leaf_start {
        if lane < (FRI_VARIANTS * OUTPUT_WIDTH * POSEIDON_LANES)
            .downcast_truncate()
        {
            let state = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            let variant = state / output_width
            let pair = state % output_width
            let source = if variant == 0 {
                regions.fri_clean
            } else {
                regions.fri_observed
            }
            let evaluation = load_fri_evaluation(
                proof,
                source,
                placement.output_offset + pair,
            )
            let permutation = begin_ext4_commitment_placement_tag(
                fri_layer_row_domain_tag(placement.round),
                evaluation,
            )
            let input_valid = schedule_valid && proof_load(
                proof,
                challenge_valid_region,
                fri_round_value_index(variant, round_index),
            ) == 1
            initialize_hash_lane(
                scratch,
                state,
                field_lane,
                ref permutation,
                input_valid,
            )
        }
    } else if step < tree_start {
        let hash_step = step - leaf_start - 1
        if lane < (FRI_VARIANTS * OUTPUT_WIDTH * POSEIDON_LANES)
            .downcast_truncate()
        {
            let state = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            let variant = state / output_width
            let pair = state % output_width
            if hash_step < hash_transition {
                advance_hash_lane(
                    proof,
                    scratch,
                    state,
                    field_lane,
                    hash_step,
                )
            } else if field_lane == 0 {
                let node = tree_node(variant, pair)
                let digest = hash_digest(scratch, state)
                store_tree_digest(scratch, node, digest)
                fri_scratch_store(
                    scratch,
                    FRI_TREE_VALID_START,
                    node,
                    fri_scratch_load(
                        scratch,
                        FRI_HASH_VALID_START,
                        state,
                    ),
                )
                if TREE_DEPTH == 0 {
                    store_fri_root_digest(
                        proof,
                        fri_round_value_index(variant, round_index),
                        digest,
                    )
                    proof_store(
                        proof,
                        root_valid_region,
                        fri_round_value_index(variant, round_index),
                        fri_scratch_load(
                            scratch,
                            FRI_HASH_VALID_START,
                            state,
                        ),
                    )
                }
            }
        }
    } else if step < binding_start {
        let relative = step - tree_start
        let level = relative / FRI_LEAF_PLACEMENT_STEPS.downcast_truncate()
        let level_step = relative % FRI_LEAF_PLACEMENT_STEPS.downcast_truncate()
        let child_width = output_width >> level
        let parent_width = child_width / 2
        let child_offset = tree_level_offset(output_width, level)
        let parent_offset = child_offset + child_width
        if lane < variant_count
            * parent_width * POSEIDON_LANES.downcast_truncate()
        {
            let state = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            let variant = state / parent_width
            let parent = state % parent_width
            let left_node = tree_node(variant, child_offset + 2 * parent)
            let right_node = left_node + 1
            if level_step == 0 {
                let permutation = begin_compression_placement(
                    load_tree_digest(scratch, left_node),
                    load_tree_digest(scratch, right_node),
                )
                initialize_hash_lane(
                    scratch,
                    state,
                    field_lane,
                    ref permutation,
                    fri_scratch_load(
                        scratch,
                        FRI_TREE_VALID_START,
                        left_node,
                    ) == 1 && fri_scratch_load(
                        scratch,
                        FRI_TREE_VALID_START,
                        right_node,
                    ) == 1,
                )
            } else {
                let hash_step = level_step - 1
                if hash_step < hash_transition {
                    advance_hash_lane(
                        proof,
                        scratch,
                        state,
                        field_lane,
                        hash_step,
                    )
                } else if field_lane == 0 {
                    let node = tree_node(variant, parent_offset + parent)
                    let digest = hash_digest(scratch, state)
                    store_tree_digest(scratch, node, digest)
                    fri_scratch_store(
                        scratch,
                        FRI_TREE_VALID_START,
                        node,
                        fri_scratch_load(
                            scratch,
                            FRI_HASH_VALID_START,
                            state,
                        ),
                    )
                    if level + 1 == tree_depth {
                        store_fri_root_digest(
                            proof,
                            fri_round_value_index(variant, round_index),
                            digest,
                        )
                        proof_store(
                            proof,
                            root_valid_region,
                            fri_round_value_index(variant, round_index),
                            fri_scratch_load(
                                scratch,
                                FRI_HASH_VALID_START,
                                state,
                            ),
                        )
                    }
                }
            }
        }
    } else {
        let relative = step - binding_start
        if lane < (FRI_VARIANTS * POSEIDON_LANES).downcast_truncate() {
            let state = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            if relative == 0 {
                let transcript_index = fri_transcript_value_index(
                    state,
                    round_index,
                )
                let transcript = load_fri_transcript_digest(
                    proof,
                    transcript_index,
                )
                let root = load_fri_root_digest(
                    proof,
                    fri_round_value_index(state, round_index),
                )
                let placed = begin_binding_placement_tag(
                    fri_layer_transcript_domain_tag(placement.round),
                    transcript,
                    root,
                )
                initialize_hash_lane(
                    scratch,
                    state,
                    field_lane,
                    ref placed.permutation,
                    schedule_valid
                        && proof_load(
                            proof,
                            transcript_valid_region,
                            transcript_index,
                        ) == 1
                        && proof_load(
                            proof,
                            root_valid_region,
                            fri_round_value_index(state, round_index),
                        ) == 1,
                )
                if field_lane < 10 {
                    fri_scratch_store(
                        scratch,
                        FRI_HASH_TAILS_START,
                        state * 10 + field_lane,
                        placed.remaining[field_lane as usize].to_u32(),
                    )
                }
            } else {
                let block_relative = relative - 1
                let block = block_relative / hash_stage_steps
                let hash_step = block_relative % hash_stage_steps
                if hash_step < hash_transition {
                    advance_hash_lane(
                        proof,
                        scratch,
                        state,
                        field_lane,
                        hash_step,
                    )
                } else if block == 0 {
                    let output = load_hash_buffer(scratch, state, true)
                    let mut fields = [BabyBear::zero(); 8]
                    let mut index: usize = 0
                    while index < 8 {
                        fields[index] = BabyBear::from_u32(fri_scratch_load(
                            scratch,
                            FRI_HASH_TAILS_START,
                            state * 10 + index.downcast_truncate(),
                        ))
                        index = index + 1
                    }
                    let sponge = Poseidon2FieldSponge::restore(
                        output,
                        0,
                        (2 * DIGEST_FIELDS).downcast_truncate(),
                        6,
                    )
                    let permutation = sponge.begin_permutation<8>(ref fields)
                    initialize_hash_lane(
                        scratch,
                        state,
                        field_lane,
                        ref permutation,
                        fri_scratch_load(
                            scratch,
                            FRI_HASH_VALID_START,
                            state,
                        ) == 1,
                    )
                } else if block == 1 {
                    let output = load_hash_buffer(scratch, state, true)
                    let fields = [
                        BabyBear::from_u32(fri_scratch_load(
                            scratch,
                            FRI_HASH_TAILS_START,
                            state * 10 + 8,
                        )),
                        BabyBear::from_u32(fri_scratch_load(
                            scratch,
                            FRI_HASH_TAILS_START,
                            state * 10 + 9,
                        )),
                    ]
                    let sponge = Poseidon2FieldSponge::restore(
                        output,
                        0,
                        (2 * DIGEST_FIELDS).downcast_truncate(),
                        14,
                    )
                    let permutation = sponge.begin_final_permutation<2>(ref fields)
                    initialize_hash_lane(
                        scratch,
                        state,
                        field_lane,
                        ref permutation,
                        fri_scratch_load(
                            scratch,
                            FRI_HASH_VALID_START,
                            state,
                        ) == 1,
                    )
                } else if field_lane == 0 {
                    let digest = hash_digest(scratch, state)
                    let next_transcript = fri_transcript_value_index(
                        state,
                        round_index + 1,
                    )
                    store_fri_transcript_digest(
                        proof,
                        next_transcript,
                        digest,
                    )
                    let valid = fri_scratch_load(
                        scratch,
                        FRI_HASH_VALID_START,
                        state,
                    )
                    proof_store(
                        proof,
                        transcript_valid_region,
                        next_transcript,
                        valid,
                    )
                    proof_store(
                        proof,
                        round_valid_region,
                        fri_round_value_index(state, round_index),
                        valid,
                    )
                }
            }
        }
    }
    fri_scratch_store(
        scratch,
        FRI_PROGRESS_START,
        progress_index,
        step + 1,
    )
}

actor MandelbrotProofGpuCheckpoint uses (
    Program<WebGpuBackend>, SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    proof: ProofTape<u32, PROOF_WORDS>,
    lde_inverse_values: ProofTape<u32, TRACE_WORDS>,
    lde_inverse_progress: ProofTape<u32, INPUT_GRID_LANES>,
    lde_values: ProofTape<u32, LDE_WORDS>,
    lde_progress: ProofTape<u32, OUTPUT_GRID_LANES>,
    fri_scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    tamper: f32,
    res: f32,

    const fn view() -> Surface<ProofParams> {
        Surface {
            extent: Extent::square(512),
            params: proof_params(),
        }
    }

    fn derive_witness(self) uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let regions = proof_tape_regions()
        let trace_layout = trace_regions()
        let trace_step = subregion(regions.trace, trace_layout.step)
        let trace_magnitude = subregion(regions.trace, trace_layout.magnitude)
        let trace_active = subregion(regions.trace, trace_layout.active)
        let trace_terminal = subregion(regions.trace, trace_layout.terminal)
        let trace_valid_region = subregion(
            regions.status,
            status_regions().trace_valid,
        )

        // c = 0.75 + 0i escapes on row three, giving an exact four-row
        // power-of-two trace. This first fixed-size GPU checkpoint spells out
        // the four stream positions so the call-free SPIR-V legality pass can
        // inline the production recurrence. No witness row enters from the
        // host and no recurrence is duplicated here.
        let mut stream = EscapeAirWordStream::new(3072, 0, 4)

        let row0 = stream.current_proof_words()
        proof_store(self.proof, trace_step, 0, row0.0)
        proof_store(self.proof, trace_magnitude, 0, row0.1)
        proof_store(self.proof, trace_active, 0, row0.2)
        proof_store(self.proof, trace_terminal, 0, row0.3)

        stream.advance()
        let row1 = stream.current_proof_words()
        proof_store(self.proof, trace_step, 1, row1.0)
        proof_store(self.proof, trace_magnitude, 1, row1.1)
        proof_store(self.proof, trace_active, 1, row1.2)
        proof_store(self.proof, trace_terminal, 1, row1.3)

        stream.advance()
        let row2 = stream.current_proof_words()
        proof_store(self.proof, trace_step, 2, row2.0)
        proof_store(self.proof, trace_magnitude, 2, row2.1)
        proof_store(self.proof, trace_active, 2, row2.2)
        proof_store(self.proof, trace_terminal, 2, row2.3)

        stream.advance()
        let row3 = stream.current_proof_words()
        proof_store(self.proof, trace_step, 3, row3.0)
        proof_store(self.proof, trace_magnitude, 3, row3.1)
        proof_store(self.proof, trace_active, 3, row3.2)
        proof_store(self.proof, trace_terminal, 3, row3.3)

        let trace_valid = stream.is_valid()
            && stream.is_terminal()
        proof_store(
            self.proof,
            trace_valid_region,
            0,
            if trace_valid { 1 } else { 0 },
        )

        // Derive the canonical Grain parameter stream once on the GPU. The
        // repeated proof schedule reads this typed storage region, so no round
        // invocation materializes the full CTFE aggregate in its shader.
        let mut parameters = Poseidon2ParameterStream::begin()
        let mut parameter: usize = 0
        while parameter < ROUND_CONSTANT_COUNT {
            proof_store(
                self.proof,
                regions.parameters,
                parameter.downcast_truncate(),
                parameters.next(),
            )
            parameter = parameter + 1
        }
    }

    fn prepare_lde_inverse(self, invocation: ComputeInvocation)
        uses (Prove<Threads<INPUT_GRID_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        let trace_start = region_bounds(proof_tape_regions().trace).start
        prepare_batched_stage_grid<
            COLUMN_COUNT,
            TRACE,
            INPUT_LANES,
            PROOF_WORDS,
            TRACE_WORDS,
            INPUT_GRID_LANES,
        >(
            self.proof,
            trace_start,
            self.lde_inverse_values,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn advance_lde_inverse(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<INPUT_GRID_LANES, 1, 1>,
                Repeat<1, 1, 1, INPUT_STAGES>,
            >
        )
    {
        inverse_batched_stage_grid_lane<
            COLUMN_COUNT,
            TRACE,
            INPUT_LANES,
            TRACE_WORDS,
            INPUT_GRID_LANES,
            BabyBear,
            ProofLdeInputPlan,
        >(
            self.lde_inverse_values,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn prepare_lde_forward(self, invocation: ComputeInvocation)
        uses (Prove<Threads<OUTPUT_GRID_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        let prepared = prepare_batched_coset_extension<
            COLUMN_COUNT,
            TRACE,
            LDE,
            INPUT_LANES,
            OUTPUT_LANES,
            TRACE_WORDS,
            INPUT_GRID_LANES,
            LDE_WORDS,
            OUTPUT_GRID_LANES,
            BabyBear,
            ProofLdeInputPlan,
            ProofLdeOutputPlan,
        >(
            self.lde_inverse_values,
            self.lde_inverse_progress,
            self.lde_values,
            self.lde_progress,
            BabyBear::from_u32(7),
            invocation,
        )
        if prepared.active && prepared.lane == 0 {
            proof_store(
                self.proof,
                subregion(
                    proof_tape_regions().status,
                    status_regions().lde_valid,
                ),
                prepared.batch,
                if prepared.valid { 1 } else { 0 },
            )
        }
    }

    fn advance_lde_forward(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<OUTPUT_GRID_LANES, 1, 1>,
                Repeat<1, 1, 1, OUTPUT_STAGES>,
            >
        )
    {
        forward_batched_stage_grid_lane<
            COLUMN_COUNT,
            LDE,
            OUTPUT_LANES,
            LDE_WORDS,
            OUTPUT_GRID_LANES,
            BabyBear,
            ProofLdeOutputPlan,
        >(
            self.lde_values,
            self.lde_progress,
            invocation,
        )
    }

    fn finish_lde(self, invocation: ComputeInvocation)
        uses (Prove<Threads<OUTPUT_GRID_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        let regions = proof_tape_regions()
        let lde_start = region_bounds(regions.lde).start
        let lde_valid = subregion(regions.status, status_regions().lde_valid)
        let finish = finish_batched_stage_grid_into<
            COLUMN_COUNT,
            LDE,
            OUTPUT_LANES,
            LDE_WORDS,
            OUTPUT_GRID_LANES,
            PROOF_WORDS,
            ProofLdeOutputPlan,
        >(
            self.lde_values,
            self.lde_progress,
            self.proof,
            lde_start,
            invocation,
        )
        if finish.active && finish.lane == 0 {
            let prepared = proof_load(
                self.proof,
                lde_valid,
                finish.batch,
            ) == 1
            proof_store(
                self.proof,
                lde_valid,
                finish.batch,
                if prepared && finish.valid { 1 } else { 0 },
            )
        }
    }

    fn initialize_commitments(self) uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let regions = proof_tape_regions()
        // The static assertions above tie these concrete array types to the
        // sponge-derived rate while Fe const-alias generic arguments mature.
        let fields = load_lde_fields<6>(tape: self.proof, region: regions.lde)
        let sponge = Poseidon2FieldSponge::begin<MandelbrotGpuLdeV1>(
            expected: LDE_WORDS.downcast_truncate(),
        )
        let permutation = sponge.begin_permutation<6>(fields: ref fields)
        store_initial_commitment(
            tape: self.proof,
            state: regions.clean_commitment,
            permutation: ref permutation,
        )
        store_initial_commitment(
            tape: self.proof,
            state: regions.observed_commitment,
            permutation: ref permutation,
        )
    }

    fn advance_commitment_rounds(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<COMMITMENT_WORKGROUP_LANES, 1, 1>,
                Repeat<1, 1, 1, COMMITMENT_SCHEDULE_STEPS>,
            >
        )
    {
        let regions = proof_tape_regions()
        let state_layout = commitment_regions()
        let poseidon_lanes: u32 = POSEIDON_LANES.downcast_truncate()
        let commitment_lane = invocation.local.x / poseidon_lanes
        let field_lane = invocation.local.x % poseidon_lanes
        let field_index: RegionIndex<[u32; POSEIDON_LANES]> =
            cyclic_region_index(field_lane)
        let observed = commitment_lane == 1
        let state = if observed {
            regions.observed_commitment
        } else {
            regions.clean_commitment
        }
        let primary_region = subregion(state, state_layout.primary)
        let secondary_region = subregion(state, state_layout.secondary)
        let cursor_region = subregion(state, state_layout.cursor)
        let block_region = subregion(state, state_layout.block)
        let valid_region = subregion(state, state_layout.valid)
        let cursor = proof_load_indexed(self.proof, cursor_region, field_index)
        let block = proof_load_indexed(self.proof, block_region, field_index)
        let mut valid = proof_load_indexed(self.proof, valid_region, field_index)
        let primary = load_commitment_buffer(
            tape: self.proof,
            state: state,
            buffer: state_layout.primary,
        )
        let secondary = load_commitment_buffer(
            tape: self.proof,
            state: state,
            buffer: state_layout.secondary,
        )
        let mut checked: usize = 0
        while checked < POSEIDON_LANES {
            if primary[checked] >= BABY_BEAR_MODULUS { valid = 0 }
            if secondary[checked] >= BABY_BEAR_MODULUS { valid = 0 }
            checked = checked + 1
        }

        let transition =
            <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
        if cursor < transition {
            let destination = poseidon2_workgroup_destination(cursor)
            let output = if destination == 0 {
                primary_region
            } else {
                secondary_region
            }
            let mut round_constant: u32 = 0
            if cursor != 0 && ((cursor - 1) & 1) == 0 {
                let phase = (cursor - 1) / 2
                let index = poseidon2_round_constant_index(phase, field_lane)
                round_constant = proof_load(self.proof, regions.parameters, index)
            }
            let value = if valid == 1 {
                poseidon2_workgroup_lane_with_round_constant(
                    ref primary,
                    ref secondary,
                    cursor,
                    field_lane,
                    round_constant,
                )
            } else {
                0
            }
            proof_store_indexed(self.proof, output, field_index, value)
            proof_store_indexed(self.proof, cursor_region, field_index, cursor + 1)
            proof_store_indexed(self.proof, block_region, field_index, block)
            proof_store_indexed(self.proof, valid_region, field_index, valid)
        } else if cursor == transition && block < FINAL_FULL_BLOCK.downcast_truncate() {
            let first_block_fields: u32 = FIRST_BLOCK_FIELDS.downcast_truncate()
            let sponge_rate: u32 = SPONGE_RATE.downcast_truncate()
            let start = first_block_fields + block * sponge_rate
            let mut value = secondary[field_lane as usize]
            if field_lane < sponge_rate {
                value = BabyBear::from_u32(proof_load(
                    self.proof,
                    regions.lde,
                    start + field_lane,
                )).to_montgomery_word()
            }
            if observed && self.tamper >= 0.5
                && block == TAMPER_PRECEDING_BLOCK.downcast_truncate()
                && field_lane == TAMPER_NEXT_BLOCK_FIELD.downcast_truncate()
            {
                value = (BabyBear::from_montgomery_word(value) + BabyBear::one())
                    .to_montgomery_word()
            }
            proof_store_indexed(
                self.proof,
                primary_region,
                field_index,
                if valid == 1 { value } else { 0 },
            )
            proof_store_indexed(self.proof, cursor_region, field_index, 0)
            proof_store_indexed(self.proof, block_region, field_index, block + 1)
            proof_store_indexed(self.proof, valid_region, field_index, valid)
        } else if cursor == transition && block == FINAL_FULL_BLOCK.downcast_truncate() {
            let mut value = secondary[field_lane as usize]
            if field_lane < 2 {
                let final_field_start: u32 =
                    (LDE_WORDS - 2).downcast_truncate()
                value = BabyBear::from_u32(proof_load(
                    self.proof,
                    regions.lde,
                    final_field_start + field_lane,
                )).to_montgomery_word()
            }
            proof_store_indexed(
                self.proof,
                primary_region,
                field_index,
                if valid == 1 { value } else { 0 },
            )
            proof_store_indexed(self.proof, cursor_region, field_index, 0)
            proof_store_indexed(
                self.proof,
                block_region,
                field_index,
                FINAL_PARTIAL_BLOCK.downcast_truncate(),
            )
            proof_store_indexed(self.proof, valid_region, field_index, valid)
        } else if cursor == transition && block == FINAL_PARTIAL_BLOCK.downcast_truncate() {
            if field_lane < DIGEST_FIELDS.downcast_truncate() {
                let root = if observed {
                    regions.observed_root
                } else {
                    regions.clean_root
                }
                proof_store(
                    self.proof,
                    root,
                    field_lane,
                    BabyBear::from_montgomery_word(
                        secondary[field_lane as usize]
                    ).to_u32(),
                )
            }
            proof_store_indexed(
                self.proof,
                primary_region,
                field_index,
                secondary[field_lane as usize],
            )
            proof_store_indexed(self.proof, cursor_region, field_index, 0)
            proof_store_indexed(
                self.proof,
                block_region,
                field_index,
                if valid == 1 {
                    DONE_BLOCK.downcast_truncate()
                } else {
                    0
                },
            )
            proof_store_indexed(self.proof, valid_region, field_index, valid)
        } else {
            proof_store_indexed(self.proof, cursor_region, field_index, 0)
            proof_store_indexed(self.proof, block_region, field_index, 0)
            proof_store_indexed(self.proof, valid_region, field_index, 0)
        }
    }

    fn finalize_commitments(self) uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let regions = proof_tape_regions()
        let status_layout = status_regions()
        let clean_root = load_digest(tape: self.proof, region: regions.clean_root)
        let observed_root = load_digest(tape: self.proof, region: regions.observed_root)
        let tampered = self.tamper >= 0.5
        let roots_equal = clean_root.equals(observed_root)
        let trace_valid = stored_flag(
            self.proof,
            subregion(regions.status, status_layout.trace_valid),
        )
        let lde_valid = all_lde_columns_valid(
            self.proof,
            subregion(regions.status, status_layout.lde_valid),
        )
        let commitments_valid = commitment_state_valid(
            tape: self.proof,
            state: regions.clean_commitment,
        ) && commitment_state_valid(
            tape: self.proof,
            state: regions.observed_commitment,
        )
        let root_nonzero = commitments_valid
            && !clean_root.equals(Poseidon2Digest::zero())
        let mode_correct = trace_valid && lde_valid && commitments_valid && (
            if tampered { !roots_equal } else { roots_equal }
        )

        proof_store(
            self.proof,
            subregion(regions.status, status_layout.roots_equal),
            0,
            if roots_equal { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.mode_correct),
            0,
            if mode_correct { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.trace_color),
            0,
            status_word(trace_valid, false),
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.lde_color),
            0,
            status_word(lde_valid, false),
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.root_color),
            0,
            status_word(root_nonzero, false),
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.mode_color),
            0,
            status_word(mode_correct, tampered),
        )
    }

    fn initialize_fri_schedule(self, invocation: ComputeInvocation)
        uses (Prove<Threads<FRI_WORKGROUP_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        let regions = proof_tape_regions()
        let status = fri_status_regions()
        let lane = invocation.local.x
        let lane_count: u32 = FRI_WORKGROUP_LANES.downcast_truncate()
        let mut round: u32 = 0
        while round < FRI_ROUNDS.downcast_truncate() {
            fri_scratch_store(
                self.fri_scratch,
                FRI_PROGRESS_START,
                round * lane_count + lane,
                0,
            )
            round = round + 1
        }
        if lane < DIGEST_FIELDS.downcast_truncate() {
            let value = proof_load(self.proof, regions.clean_root, lane)
            let mut variant: u32 = 0
            while variant < FRI_VARIANTS.downcast_truncate() {
                proof_store(
                    self.proof,
                    regions.fri_transcripts,
                    fri_transcript_value_index(variant, 0)
                        * DIGEST_FIELDS.downcast_truncate() + lane,
                    value,
                )
                variant = variant + 1
            }
        }
        if lane < FRI_VARIANTS.downcast_truncate() {
            let initial_valid = commitment_state_valid(
                tape: self.proof,
                state: regions.clean_commitment,
            ) && proof_fri_metadata().rounds
                == FRI_ROUNDS.downcast_truncate()
            proof_store(
                self.proof,
                subregion(regions.fri_status, status.transcript_valid),
                fri_transcript_value_index(lane, 0),
                if initial_valid { 1 } else { 0 },
            )
        }
    }

    fn advance_fri_round_1(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<FRI_WORKGROUP_LANES, 1, 1>,
                Repeat<1, 1, 1, FRI_ROUND_1_STEPS>,
            >
        )
    {
        advance_fri_round<0, 16, 8, 3, FRI_ROUND_1_STEPS>(
            self.proof,
            self.fri_scratch,
            self.tamper,
            invocation,
        )
    }

    fn advance_fri_round_2(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<FRI_WORKGROUP_LANES, 1, 1>,
                Repeat<1, 1, 1, FRI_ROUND_2_STEPS>,
            >
        )
    {
        advance_fri_round<1, 8, 4, 2, FRI_ROUND_2_STEPS>(
            self.proof,
            self.fri_scratch,
            self.tamper,
            invocation,
        )
    }

    fn advance_fri_round_3(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<FRI_WORKGROUP_LANES, 1, 1>,
                Repeat<1, 1, 1, FRI_ROUND_3_STEPS>,
            >
        )
    {
        advance_fri_round<2, 4, 2, 1, FRI_ROUND_3_STEPS>(
            self.proof,
            self.fri_scratch,
            self.tamper,
            invocation,
        )
    }

    fn advance_fri_round_4(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<FRI_WORKGROUP_LANES, 1, 1>,
                Repeat<1, 1, 1, FRI_ROUND_4_STEPS>,
            >
        )
    {
        advance_fri_round<3, 2, 1, 0, FRI_ROUND_4_STEPS>(
            self.proof,
            self.fri_scratch,
            self.tamper,
            invocation,
        )
    }

    fn finalize_fri_schedule(self)
        uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        let regions = proof_tape_regions()
        let status_layout = status_regions()
        let fri_layout = fri_status_regions()
        let valid = all_fri_schedule_valid(
            self.proof,
            subregion(regions.fri_status, fri_layout.challenge_valid),
            subregion(regions.fri_status, fri_layout.root_valid),
            subregion(regions.fri_status, fri_layout.transcript_valid),
            subregion(regions.fri_status, fri_layout.round_valid),
        ) && all_fri_progress_valid(self.fri_scratch)
        let equal = fri_outputs_equal(
            self.proof,
            regions.fri_clean,
            regions.fri_observed,
        )
        let tampered = self.tamper >= 0.5
        let fri_correct = valid && if tampered { !equal } else { equal }
        let previous_correct = stored_flag(
            self.proof,
            subregion(regions.status, status_layout.mode_correct),
        )
        let overall = previous_correct && fri_correct

        proof_store(
            self.proof,
            subregion(regions.fri_status, fri_layout.equal),
            0,
            if equal { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.fri_status, fri_layout.correct),
            0,
            if fri_correct { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.fri_status, fri_layout.color),
            0,
            status_word(fri_correct, tampered),
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.mode_correct),
            0,
            if overall { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.mode_color),
            0,
            status_word(overall, tampered),
        )
    }


    fn display(self, px: i32, py: i32) -> i32 uses (Display) {
        let regions = proof_tape_regions()
        let status_layout = status_regions()
        let fri_layout = fri_status_regions()
        let u = from_i32(px) / self.res
        let v = from_i32(py) / self.res
        let tampered = self.tamper >= 0.5

        if v < 0.18 {
            if u < 0.2 {
                return proof_load(
                    self.proof,
                    subregion(regions.status, status_layout.trace_color),
                    0,
                ).downcast_truncate()
            }
            if u < 0.4 {
                return proof_load(
                    self.proof,
                    subregion(regions.status, status_layout.lde_color),
                    0,
                ).downcast_truncate()
            }
            if u < 0.6 {
                return proof_load(
                    self.proof,
                    subregion(regions.status, status_layout.root_color),
                    0,
                ).downcast_truncate()
            }
            if u < 0.8 {
                return proof_load(
                    self.proof,
                    subregion(regions.fri_status, fri_layout.color),
                    0,
                ).downcast_truncate()
            }
            return proof_load(
                self.proof,
                subregion(regions.status, status_layout.mode_color),
                0,
            ).downcast_truncate()
        }
        if v > 0.82 {
            return proof_load(
                self.proof,
                subregion(regions.status, status_layout.mode_color),
                0,
            ).downcast_truncate()
        }

        let fri_evaluation_words: i32 =
            FRI_EVALUATION_WORDS.downcast_truncate()
        let sample_i = to_i32(
            u * from_i32(fri_evaluation_words),
        ).downcast_unchecked()
        let folded = if tampered {
            regions.fri_observed
        } else {
            regions.fri_clean
        }
        let sample = proof_load(self.proof, folded, sample_i)
        let red = 54 + (sample & 127)
        let green = 42 + ((sample >> 8) & 95)
        let blue = 96 + ((sample >> 16) & 127)
        let stripe = if u + v > 1.0 { 18 } else { 0 }
        let reject_glow = if tampered { 26 } else { 0 }
        packed_rgba(red + reject_glow, green + stripe, blue)
    }
}

fn all_lde_columns_valid(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; COLUMN_COUNT]>,
) -> bool {
    proof_load(tape, region, 0) == 1
        && proof_load(tape, region, 1) == 1
        && proof_load(tape, region, 2) == 1
        && proof_load(tape, region, 3) == 1
}

fn all_fri_schedule_valid(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ challenges: Region<ProofTapeRegions, [u32; FRI_VALID_ROUNDS]>,
    _ roots: Region<ProofTapeRegions, [u32; FRI_VALID_ROUNDS]>,
    _ transcripts: Region<ProofTapeRegions, [u32; FRI_VALID_TRANSCRIPTS]>,
    _ rounds: Region<ProofTapeRegions, [u32; FRI_VALID_ROUNDS]>,
) -> bool {
    let mut valid = true
    let mut index: usize = 0
    while index < FRI_VALID_ROUNDS {
        let word: u32 = index.downcast_truncate()
        valid = valid
            && proof_load(tape, challenges, word) == 1
            && proof_load(tape, roots, word) == 1
            && proof_load(tape, rounds, word) == 1
        index = index + 1
    }
    index = 0
    while index < FRI_VALID_TRANSCRIPTS {
        valid = valid
            && proof_load(tape, transcripts, index.downcast_truncate()) == 1
        index = index + 1
    }
    valid
}

fn all_fri_progress_valid(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
) -> bool {
    let rounds: u32 = FRI_ROUNDS.downcast_truncate()
    let lanes: u32 = FRI_WORKGROUP_LANES.downcast_truncate()
    let mut valid = true
    let mut round: u32 = 0
    while round < rounds {
        let expected = runtime_fri_round_schedule_steps(rounds - round - 1)
        let base = round * lanes
        let mut lane: u32 = 0
        while lane < lanes {
            valid = valid && fri_scratch_load(
                scratch,
                FRI_PROGRESS_START,
                base + lane,
            ) == expected
            lane = lane + 1
        }
        round = round + 1
    }
    valid
}

fn fri_outputs_equal(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ left: Region<ProofTapeRegions, [u32; FRI_EVALUATION_WORDS]>,
    _ right: Region<ProofTapeRegions, [u32; FRI_EVALUATION_WORDS]>,
) -> bool {
    let mut equal = true
    let mut word: usize = 0
    while word < FRI_EVALUATION_WORDS {
        let index: u32 = word.downcast_truncate()
        equal = equal
            && proof_load(tape, left, index)
                == proof_load(tape, right, index)
        word = word + 1
    }
    equal
}

fn stored_flag(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, u32>,
) -> bool {
    let word: i32 = proof_load(tape, region, 0).downcast_truncate()
    word == 1
}
