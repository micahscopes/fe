    fn evaluate_production_air_local_step(self, invocation: ComputeInvocation)
        uses (Prove<Threads<LDE, 1, 1>, Once<1, 1, 1>>)
    {
        let evaluation = invocation.local.x
        if evaluation < LDE.downcast_truncate() {
            let regions = proof_tape_regions()
            let challenge = load_composition_challenge(self.proof)
            let source = GpuAirLdeSource {
                values: self.lde_values,
                row: evaluation,
            }
            let row = GpuAirLdeRow {}
            let fold0 = begin_constraint_fold<BabyBearExt4>(challenge)
            let fold78 = fold_local_step_constraints<
                BabyBearExt4,
                GpuAirLdeSource,
                GpuAirLdeRow,
            >(fold0, source, ref row)
            store_composition_fold(self.fri_scratch, evaluation, fold78)
            let challenge_valid = proof_load(
                self.proof,
                regions.composition_valid,
                0,
            ) == 1
            fri_scratch_store(
                self.fri_scratch,
                COMPOSITION_FOLD_VALID_START,
                evaluation,
                if challenge_valid { 1 } else { 0 },
            )
        }
    }

