const fn proof_tape_regions() -> ProofTapeRegions {
    <ProofTapeRegions as RegionSchema>::regions()
}

const fn trace_regions() -> TraceRegions {
    <TraceRegions as RegionSchema>::regions()
}

const fn status_regions() -> StatusRegions {
    <StatusRegions as RegionSchema>::regions()
}

const fn commitment_regions() -> CommitmentRegions {
    <CommitmentRegions as RegionSchema>::regions()
}

const fn fri_status_regions() -> FriStatusRegions {
    <FriStatusRegions as RegionSchema>::regions()
}

const fn fri_query_status_regions() -> FriQueryStatusRegions {
    <FriQueryStatusRegions as RegionSchema>::regions()
}

#[inline(always)]
fn proof_load<T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ tape: ProofTape<u32, STORAGE_WORDS>,
    _ region: Region<ProofTapeRegions, T>,
    _ index: u32,
) -> u32
where
    STORAGE_WORDS > 0,
{
    load_region_word(tape, region, index).value
}

#[inline(always)]
fn proof_store<T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ tape: ProofTape<u32, STORAGE_WORDS>,
    _ region: Region<ProofTapeRegions, T>,
    _ index: u32,
    _ value: u32,
) -> bool
where
    STORAGE_WORDS > 0,
{
    store_region_word(tape, region, index, value)
}

#[inline(always)]
fn proof_load_indexed<T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ tape: ProofTape<u32, STORAGE_WORDS>,
    _ region: Region<ProofTapeRegions, T>,
    _ index: RegionIndex<T>,
) -> u32
where
    STORAGE_WORDS > 0,
{
    load_region_indexed_word(tape, region, index)
}

#[inline(always)]
fn proof_store_indexed<T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ tape: ProofTape<u32, STORAGE_WORDS>,
    _ region: Region<ProofTapeRegions, T>,
    _ index: RegionIndex<T>,
    _ value: u32,
)
where
    STORAGE_WORDS > 0,
{
    store_region_indexed_word(tape, region, index, value)
}

type ProofLdeInputPlan = RBin<Pair, 2>
type ProofLdeOutputPlan = RBin<Pair, 4>
type ProofFriSchedule = FriSchedule<1, 4>
const FRI_QUERY_IDENTITY: u32 = 1
type ProofFriQueryPlan = FriQueryPlan<FRI_QUERY_IDENTITY, 1>
type ProofFriLeafPairs = RBin<Pair, 3>
type ProofFriVariants = RBin<Pair, 1>
const INPUT_STAGES: usize = <ProofLdeInputPlan as FactorTree>::FACTORS
const OUTPUT_STAGES: usize = <ProofLdeOutputPlan as FactorTree>::FACTORS
const FRI_MAX_PAIR_LANES: usize =
    <ProofFriLeafPairs as BalancedBinarySchedule>::LEAVES
const FRI_VARIANT_LANES: usize =
    <ProofFriVariants as BalancedBinarySchedule>::LEAVES
const FRI_WORKGROUP_LANES: usize =
    FRI_MAX_PAIR_LANES * FRI_VARIANT_LANES * POSEIDON_LANES
const FRI_MAX_HASH_STATES: usize = FRI_MAX_PAIR_LANES * FRI_VARIANT_LANES
const FRI_HASH_BUFFERS: usize = 2
const FRI_HASH_STATE_WORDS: usize =
    FRI_MAX_HASH_STATES * FRI_HASH_BUFFERS * POSEIDON_LANES
const FRI_HASH_VALID_WORDS: usize = FRI_MAX_HASH_STATES
const FRI_HASH_TAIL_WORDS: usize = FRI_VARIANTS * 10
// Fe proves this concrete storage capacity against the schedule-derived
// metadata below. Keeping the array length concrete avoids repeatedly
// normalizing the recursive schedule inside every storage specialization.
// The complete 16-leaf AIR trees require 31 nodes per branded tree. The FRI
// schedule reuses the same scratch after AIR commitment and occupies only the
// first 26 nodes of either stride.
const FRI_TREE_NODES_PER_VARIANT: usize = 31
const FRI_TREE_WORDS: usize =
    FRI_VARIANTS * FRI_TREE_NODES_PER_VARIANT * DIGEST_FIELDS
const FRI_TREE_VALID_WORDS: usize =
    FRI_VARIANTS * FRI_TREE_NODES_PER_VARIANT
const FRI_PROGRESS_WORDS: usize = FRI_ROUNDS * FRI_WORKGROUP_LANES
const FRI_QUERY_PROGRESS_WORDS: usize = FRI_WORKGROUP_LANES
const FRI_QUERY_COPY_WORDS: usize =
    FRI_QUERY_EVALUATION_WORDS + FRI_QUERY_SIBLING_WORDS
const COMPOSITION_FOLD_WORDS_PER_ROW: usize = 2 * EXTENSION_WORDS
const COMPOSITION_FOLD_WORDS: usize = LDE * COMPOSITION_FOLD_WORDS_PER_ROW
const COMPOSITION_FAMILY_WORDS: usize = LDE * EXTENSION_WORDS
const COMPOSITION_FOLD_VALID_WORDS: usize = LDE
const FRI_SCRATCH_WORDS: usize = FRI_HASH_STATE_WORDS
    + FRI_HASH_VALID_WORDS
    + FRI_HASH_TAIL_WORDS
    + FRI_TREE_WORDS
    + FRI_TREE_VALID_WORDS
    + FRI_PROGRESS_WORDS
    + FRI_QUERY_PROGRESS_WORDS
    + FRI_QUERY_COPY_WORDS
    + COMPOSITION_FOLD_WORDS
    + 3 * COMPOSITION_FAMILY_WORDS
    + COMPOSITION_FOLD_VALID_WORDS

struct FriScratchRegions {
    hash_states: Region<FriScratchRegions, [u32; FRI_HASH_STATE_WORDS]>,
    hash_valid: Region<FriScratchRegions, [u32; FRI_HASH_VALID_WORDS]>,
    hash_tails: Region<FriScratchRegions, [u32; FRI_HASH_TAIL_WORDS]>,
    tree: Region<FriScratchRegions, [u32; FRI_TREE_WORDS]>,
    tree_valid: Region<FriScratchRegions, [u32; FRI_TREE_VALID_WORDS]>,
    progress: Region<FriScratchRegions, [u32; FRI_PROGRESS_WORDS]>,
    query_progress: Region<FriScratchRegions, [u32; FRI_QUERY_PROGRESS_WORDS]>,
    query_copy_valid: Region<FriScratchRegions, [u32; FRI_QUERY_COPY_WORDS]>,
    composition_fold: Region<FriScratchRegions, [u32; COMPOSITION_FOLD_WORDS]>,
    composition_all_rows: Region<
        FriScratchRegions,
        [u32; COMPOSITION_FAMILY_WORDS],
    >,
    composition_pair_rows: Region<
        FriScratchRegions,
        [u32; COMPOSITION_FAMILY_WORDS],
    >,
    composition_first_row: Region<
        FriScratchRegions,
        [u32; COMPOSITION_FAMILY_WORDS],
    >,
    composition_fold_valid: Region<
        FriScratchRegions,
        [u32; COMPOSITION_FOLD_VALID_WORDS],
    >,
}
impl core::marker::Copy for FriScratchRegions {}
derive RegionSchema for FriScratchRegions using RegionSchemaProvider

