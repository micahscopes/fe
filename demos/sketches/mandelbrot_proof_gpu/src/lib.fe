#[inline(always)]
fn store_fri_evaluation(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; FRI_EVALUATION_WORDS]>,
    _ evaluation_index: u32,
    _ evaluation: BabyBearExt4,
) {
    let base = evaluation_index * EXTENSION_WORDS.downcast_truncate()
    proof_store(tape, region, base, evaluation.coefficient_0().to_u32())
    proof_store(tape, region, base + 1, evaluation.coefficient_1().to_u32())
    proof_store(tape, region, base + 2, evaluation.coefficient_2().to_u32())
    proof_store(tape, region, base + 3, evaluation.coefficient_3().to_u32())
}

#[inline(always)]
fn load_fri_evaluation(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; FRI_EVALUATION_WORDS]>,
    _ evaluation_index: u32,
) -> BabyBearExt4 {
    let base = evaluation_index * EXTENSION_WORDS.downcast_truncate()
    BabyBearExt4::from_coordinate_words(
        proof_load(tape, region, base),
        proof_load(tape, region, base + 1),
        proof_load(tape, region, base + 2),
        proof_load(tape, region, base + 3),
    )
}

#[inline(always)]
fn store_composition_value(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ evaluation: u32,
    _ value: BabyBearExt4,
) {
    let region = proof_tape_regions().composition_values
    let base = evaluation * EXTENSION_WORDS.downcast_truncate()
    proof_store(tape, region, base, value.coefficient_0().to_u32())
    proof_store(tape, region, base + 1, value.coefficient_1().to_u32())
    proof_store(tape, region, base + 2, value.coefficient_2().to_u32())
    proof_store(tape, region, base + 3, value.coefficient_3().to_u32())
}

#[inline(always)]
fn load_composition_value(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ evaluation: u32,
) -> BabyBearExt4 {
    let region = proof_tape_regions().composition_values
    let base = evaluation * EXTENSION_WORDS.downcast_truncate()
    BabyBearExt4::from_coordinate_words(
        proof_load(tape, region, base),
        proof_load(tape, region, base + 1),
        proof_load(tape, region, base + 2),
        proof_load(tape, region, base + 3),
    )
}

#[inline(always)]
fn load_composition_challenge(
    _ tape: ProofTape<u32, PROOF_WORDS>,
) -> BabyBearExt4 {
    let region = proof_tape_regions().composition_challenge
    BabyBearExt4::from_coordinate_words(
        proof_load(tape, region, 0),
        proof_load(tape, region, 1),
        proof_load(tape, region, 2),
        proof_load(tape, region, 3),
    )
}

#[inline(always)]
fn store_composition_fold<const ABSORBED: usize>(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ row: u32,
    _ checkpoint: ConstraintFoldCheckpoint<BabyBearExt4, ABSORBED>,
) {
    let power = constraint_fold_power<BabyBearExt4, ABSORBED>(checkpoint)
    let value = constraint_fold_value<BabyBearExt4, ABSORBED>(checkpoint)
    let base = row * COMPOSITION_FOLD_WORDS_PER_ROW.downcast_truncate()
    fri_scratch_store(scratch, COMPOSITION_FOLD_START, base, power.coefficient_0().to_u32())
    fri_scratch_store(scratch, COMPOSITION_FOLD_START, base + 1, power.coefficient_1().to_u32())
    fri_scratch_store(scratch, COMPOSITION_FOLD_START, base + 2, power.coefficient_2().to_u32())
    fri_scratch_store(scratch, COMPOSITION_FOLD_START, base + 3, power.coefficient_3().to_u32())
    fri_scratch_store(scratch, COMPOSITION_FOLD_START, base + 4, value.coefficient_0().to_u32())
    fri_scratch_store(scratch, COMPOSITION_FOLD_START, base + 5, value.coefficient_1().to_u32())
    fri_scratch_store(scratch, COMPOSITION_FOLD_START, base + 6, value.coefficient_2().to_u32())
    fri_scratch_store(scratch, COMPOSITION_FOLD_START, base + 7, value.coefficient_3().to_u32())
}

#[inline(always)]
fn load_composition_fold<const ABSORBED: usize>(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ challenge: BabyBearExt4,
    _ row: u32,
) -> ConstraintFoldCheckpoint<BabyBearExt4, ABSORBED> {
    let base = row * COMPOSITION_FOLD_WORDS_PER_ROW.downcast_truncate()
    let power = BabyBearExt4::from_coordinate_words(
        fri_scratch_load(scratch, COMPOSITION_FOLD_START, base),
        fri_scratch_load(scratch, COMPOSITION_FOLD_START, base + 1),
        fri_scratch_load(scratch, COMPOSITION_FOLD_START, base + 2),
        fri_scratch_load(scratch, COMPOSITION_FOLD_START, base + 3),
    )
    let value = BabyBearExt4::from_coordinate_words(
        fri_scratch_load(scratch, COMPOSITION_FOLD_START, base + 4),
        fri_scratch_load(scratch, COMPOSITION_FOLD_START, base + 5),
        fri_scratch_load(scratch, COMPOSITION_FOLD_START, base + 6),
        fri_scratch_load(scratch, COMPOSITION_FOLD_START, base + 7),
    )
    restore_constraint_fold<BabyBearExt4, ABSORBED>(challenge, power, value)
}

#[inline(always)]
fn store_composition_family(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ start: u32,
    _ row: u32,
    _ value: BabyBearExt4,
) {
    let base = row * EXTENSION_WORDS.downcast_truncate()
    fri_scratch_store(scratch, start, base, value.coefficient_0().to_u32())
    fri_scratch_store(scratch, start, base + 1, value.coefficient_1().to_u32())
    fri_scratch_store(scratch, start, base + 2, value.coefficient_2().to_u32())
    fri_scratch_store(scratch, start, base + 3, value.coefficient_3().to_u32())
}

#[inline(always)]
fn load_composition_family(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ start: u32,
    _ row: u32,
) -> BabyBearExt4 {
    let base = row * EXTENSION_WORDS.downcast_truncate()
    BabyBearExt4::from_coordinate_words(
        fri_scratch_load(scratch, start, base),
        fri_scratch_load(scratch, start, base + 1),
        fri_scratch_load(scratch, start, base + 2),
        fri_scratch_load(scratch, start, base + 3),
    )
}

#[inline(always)]
fn composition_fold_is_valid(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ row: u32,
) -> bool {
    fri_scratch_load(scratch, COMPOSITION_FOLD_VALID_START, row) == 1
}

#[inline(always)]
fn hash_buffer_start(_ state: u32, _ secondary: bool) -> u32 {
    let state_words: u32 = (FRI_HASH_BUFFERS * POSEIDON_LANES).downcast_truncate()
    let buffer_words: u32 = POSEIDON_LANES.downcast_truncate()
    state * state_words + if secondary { buffer_words } else { 0 }
}

#[inline(always)]
fn load_hash_buffer(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ state: u32,
    _ secondary: bool,
) -> [u32; POSEIDON_LANES] {
    let mut words = [0; POSEIDON_LANES]
    let start = hash_buffer_start(state, secondary)
    let mut lane: usize = 0
    while lane < POSEIDON_LANES {
        words[lane] = fri_scratch_load(
            scratch,
            FRI_HASH_STATES_START,
            start + lane.downcast_truncate(),
        )
        lane = lane + 1
    }
    words
}

#[inline(always)]
fn initialize_hash_lane(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ state: u32,
    _ field_lane: u32,
    _ permutation: ref Poseidon2FieldPermutation,
    _ input_valid: bool,
) {
    if state >= FRI_MAX_HASH_STATES.downcast_truncate()
        || field_lane >= POSEIDON_LANES.downcast_truncate()
    {
        return
    }
    fri_scratch_store(
        scratch,
        FRI_HASH_STATES_START,
        hash_buffer_start(state, false) + field_lane,
        permutation.lane_word(lane: field_lane),
    )
    fri_scratch_store(
        scratch,
        FRI_HASH_STATES_START,
        hash_buffer_start(state, true) + field_lane,
        0,
    )
    if field_lane == 0 {
        fri_scratch_store(
            scratch,
            FRI_HASH_VALID_START,
            state,
            if input_valid && permutation.is_valid() { 1 } else { 0 },
        )
    }
}

#[inline(always)]
fn advance_hash_lane(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ state: u32,
    _ field_lane: u32,
    _ step: u32,
) {
    let transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    let mut state_valid = fri_scratch_load(
        scratch,
        FRI_HASH_VALID_START,
        state,
    ) == 1
    let primary = load_hash_buffer(scratch, state, false)
    let secondary = load_hash_buffer(scratch, state, true)
    let mut checked: usize = 0
    while checked < POSEIDON_LANES {
        if primary[checked] >= BABY_BEAR_MODULUS { state_valid = false }
        if secondary[checked] >= BABY_BEAR_MODULUS { state_valid = false }
        checked = checked + 1
    }
    if step >= transition { state_valid = false }
    let mut round_constant: u32 = 0
    if step != 0 && ((step - 1) & 1) == 0 {
        let phase = (step - 1) / 2
        let index = poseidon2_round_constant_index(phase, field_lane)
        round_constant = proof_load(
            proof,
            proof_tape_regions().parameters,
            index,
        )
    }
    let value = if state_valid {
        poseidon2_workgroup_lane_with_round_constant(
            ref primary,
            ref secondary,
            step,
            field_lane,
            round_constant,
        )
    } else {
        0
    }
    let destination = poseidon2_workgroup_destination(step)
    fri_scratch_store(
        scratch,
        FRI_HASH_STATES_START,
        hash_buffer_start(state, destination == 1) + field_lane,
        value,
    )
    if field_lane == 0 {
        fri_scratch_store(
            scratch,
            FRI_HASH_VALID_START,
            state,
            if state_valid { 1 } else { 0 },
        )
    }
}

#[inline(always)]
fn hash_digest(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ state: u32,
) -> Poseidon2Digest {
    let output = load_hash_buffer(scratch, state, true)
    let mut words = [0; DIGEST_FIELDS]
    let mut field: usize = 0
    while field < DIGEST_FIELDS {
        words[field] = BabyBear::from_montgomery_word(output[field]).to_u32()
        field = field + 1
    }
    Poseidon2Digest::from_u32s(words)
}

#[inline(always)]
fn store_tree_digest(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ node: u32,
    _ digest: Poseidon2Digest,
) {
    let base = node * DIGEST_FIELDS.downcast_truncate()
    let mut field: u32 = 0
    while field < DIGEST_FIELDS.downcast_truncate() {
        fri_scratch_store(
            scratch,
            FRI_TREE_START,
            base + field,
            digest.field(index: field).to_u32(),
        )
        field = field + 1
    }
}

#[inline(always)]
fn load_tree_digest(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ node: u32,
) -> Poseidon2Digest {
    let base = node * DIGEST_FIELDS.downcast_truncate()
    let mut words = [0; DIGEST_FIELDS]
    let mut field: usize = 0
    while field < DIGEST_FIELDS {
        words[field] = fri_scratch_load(
            scratch,
            FRI_TREE_START,
            base + field.downcast_truncate(),
        )
        field = field + 1
    }
    Poseidon2Digest::from_u32s(words)
}

#[inline(always)]
fn tree_node(_ variant: u32, _ tree_offset: u32, _ node: u32) -> u32 {
    variant * FRI_TREE_NODES_PER_VARIANT.downcast_truncate()
        + tree_offset + node
}

#[inline(always)]
fn tree_level_offset(_ output_width: u32, _ level: u32) -> u32 {
    let mut offset: u32 = 0
    let mut width = output_width
    let mut current: u32 = 0
    while current < level {
        offset = offset + width
        width = width / 2
        current = current + 1
    }
    offset
}

#[inline(always)]
fn air_lde_field(
    _ values: ProofTape<u32, AIR_LDE_WORDS>,
    _ row: u32,
    _ column: u32,
) -> BabyBear {
    BabyBear::from_u32(values.load(
        index: column * LDE.downcast_truncate() + row,
    ))
}

/// Physical source for one authenticated production AIR position. The shared
/// AIR owns the constraint equations; this placement owns the browser LDE
/// resource and runtime row coordinate. Keeping the coordinate in the source
/// lets the semantic current/next row views remain zero-sized type witnesses.
struct GpuAirLdeSource {
    values: ProofTape<u32, AIR_LDE_WORDS>,
    row: u32,
}

impl core::marker::Copy for GpuAirLdeSource {}

struct GpuAirLdeRow {}
impl core::marker::Copy for GpuAirLdeRow {}

struct GpuAirLdeNextRow {}
impl core::marker::Copy for GpuAirLdeNextRow {}

#[inline(always)]
fn gpu_air_lde_main(
    _ source: GpuAirLdeSource,
    _ row: u32,
    _ column: usize,
) -> BabyBearExt4 {
    if column >= MAIN_COLUMN_COUNT { return BabyBearExt4::zero() }
    let column_index: u32 = column.downcast_truncate()
    let lde_width: u32 = LDE.downcast_truncate()
    BabyBearExt4::from_base(BabyBear::from_u32(source.values.load(
        index: column_index * lde_width + row,
    )))
}

#[inline(always)]
fn gpu_air_lde_auxiliary(
    _ source: GpuAirLdeSource,
    _ row: u32,
    _ column: usize,
) -> BabyBearExt4 {
    if column >= AUXILIARY_ROW_BITS { return BabyBearExt4::zero() }
    let column_index: u32 = (MAIN_COLUMN_COUNT + column).downcast_truncate()
    let lde_width: u32 = LDE.downcast_truncate()
    BabyBearExt4::from_base(BabyBear::from_u32(source.values.load(
        index: column_index * lde_width + row,
    )))
}

impl AirColumnView<
    BabyBearExt4,
    GpuAirLdeSource,
> for GpuAirLdeRow {
    fn main(
        ref self,
        _ source: GpuAirLdeSource,
        _ column: usize,
    ) -> BabyBearExt4 {
        gpu_air_lde_main(source, source.row, column)
    }

    fn auxiliary(
        ref self,
        _ source: GpuAirLdeSource,
        _ column: usize,
    ) -> BabyBearExt4 {
        gpu_air_lde_auxiliary(source, source.row, column)
    }
}

impl AirColumnView<
    BabyBearExt4,
    GpuAirLdeSource,
> for GpuAirLdeNextRow {
    fn main(
        ref self,
        _ source: GpuAirLdeSource,
        _ column: usize,
    ) -> BabyBearExt4 {
        let row = (source.row + (LDE / TRACE).downcast_truncate())
            % LDE.downcast_truncate()
        gpu_air_lde_main(source, row, column)
    }

    fn auxiliary(
        ref self,
        _ source: GpuAirLdeSource,
        _ column: usize,
    ) -> BabyBearExt4 {
        let row = (source.row + (LDE / TRACE).downcast_truncate())
            % LDE.downcast_truncate()
        gpu_air_lde_auxiliary(source, row, column)
    }
}

/// Fold the selector-dependent pair-row family from the exact 653-constraint
/// boundary. The constraint program remains shared with scalar interpreters.
#[inline(always)]
fn fold_production_pair_rows(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ values: ProofTape<u32, AIR_LDE_WORDS>,
    _ checkpoint: ConstraintFoldCheckpoint<BabyBearExt4, 653>,
    _ evaluation: u32,
) -> PairRowsConstraintCheckpoint<BabyBearExt4> {
    let regions = proof_tape_regions()
    let sign_re = BabyBearExt4::from_base(BabyBear::from_u32(proof_load(
        proof,
        regions.canonical_public,
        0,
    )))
    let magnitude_re = BabyBearExt4::from_base(BabyBear::from_u32(proof_load(
        proof,
        regions.canonical_public,
        1,
    )))
    let sign_im = BabyBearExt4::from_base(BabyBear::from_u32(proof_load(
        proof,
        regions.canonical_public,
        2,
    )))
    let magnitude_im = BabyBearExt4::from_base(BabyBear::from_u32(proof_load(
        proof,
        regions.canonical_public,
        3,
    )))
    let source = GpuAirLdeSource {
        values: values,
        row: evaluation,
    }
    let row = GpuAirLdeRow {}
    let next = GpuAirLdeNextRow {}
    fold_pair_rows_constraints<
        BabyBearExt4,
        GpuAirLdeSource,
        GpuAirLdeRow,
        GpuAirLdeNextRow,
    >(
        checkpoint,
        source,
        signed_air_value<BabyBearExt4>(sign_re, magnitude_re),
        signed_air_value<BabyBearExt4>(sign_im, magnitude_im),
        ref row,
        ref next,
    )
}

#[inline(always)]
fn fold_production_first_row(
    _ values: ProofTape<u32, AIR_LDE_WORDS>,
    _ checkpoint: PairRowsConstraintCheckpoint<BabyBearExt4>,
    _ evaluation: u32,
) -> FirstRowConstraintCheckpoint<BabyBearExt4> {
    let source = GpuAirLdeSource { values: values, row: evaluation }
    let row = GpuAirLdeRow {}
    fold_first_row_constraints<
        BabyBearExt4,
        GpuAirLdeSource,
        GpuAirLdeRow,
    >(checkpoint, source, ref row)
}

#[inline(always)]
fn fold_production_last_row(
    _ values: ProofTape<u32, AIR_LDE_WORDS>,
    _ checkpoint: FirstRowConstraintCheckpoint<BabyBearExt4>,
    _ evaluation: u32,
) -> ConstraintNumeratorCheckpoint<BabyBearExt4> {
    let source = GpuAirLdeSource { values: values, row: evaluation }
    let row = GpuAirLdeRow {}
    fold_last_row_constraints<
        BabyBearExt4,
        GpuAirLdeSource,
        GpuAirLdeRow,
    >(checkpoint, source, ref row)
}

#[inline(always)]
fn project_production_composition_value(
    _ checkpoint: ConstraintNumeratorCheckpoint<BabyBearExt4>,
    _ evaluation: u32,
) -> CompositionValue<BabyBearExt4> {
    let point = BabyBear::from_u32(7)
        * BabyBear::two_adic_root(4).pow_u32(evaluation)
    composition_value<BabyBearExt4, TRACE>(
        BabyBearExt4::from_base(point),
        constraint_numerators_from_checkpoint(checkpoint),
    )
}

#[inline(always)]
fn air_lde_range_is_canonical(
    _ values: ProofTape<u32, AIR_LDE_WORDS>,
    _ row: u32,
    _ column: u32,
    _ count: u32,
) -> bool
{
    let mut valid = true
    let mut index: u32 = 0
    while index < count {
        let word = values.load(
            index: (column + index) * LDE.downcast_truncate() + row,
        )
        if word >= BABY_BEAR_MODULUS { valid = false }
        index = index + 1
    }
    valid
}

#[inline(always)]
fn initialize_air_lde_row_commitments(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ values: ProofTape<u32, AIR_LDE_WORDS>,
    _ auxiliary: bool,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= AIR_ROW_HASH_LANES.downcast_truncate() { return }
    let field_lane = lane % POSEIDON_LANES.downcast_truncate()
    let row = lane / POSEIDON_LANES.downcast_truncate()
    let column = if auxiliary {
        MAIN_COLUMN_COUNT.downcast_truncate()
    } else {
        0
    }
    let fields = [
        air_lde_field(values, row, column),
        air_lde_field(values, row, column + 1),
        air_lde_field(values, row, column + 2),
        air_lde_field(values, row, column + 3),
        air_lde_field(values, row, column + 4),
        air_lde_field(values, row, column + 5),
    ]
    let expected = if auxiliary {
        AUXILIARY_ROW_BITS.downcast_truncate()
    } else {
        MAIN_COLUMN_COUNT.downcast_truncate()
    }
    let tag = if auxiliary {
        auxiliary_lde_row_domain_tag()
    } else {
        main_lde_row_domain_tag()
    }
    let permutation = Poseidon2FieldSponge::begin_tag(tag, expected)
        .begin_permutation<6>(ref fields)
    initialize_hash_lane(
        scratch,
        row,
        field_lane,
        ref permutation,
        air_lde_range_is_canonical(values, row, column, 6),
    )
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, 0)
}

#[inline(always)]
fn advance_main_lde_row_commitments(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ values: ProofTape<u32, AIR_LDE_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= AIR_ROW_HASH_LANES.downcast_truncate() { return }
    let field_lane = lane % POSEIDON_LANES.downcast_truncate()
    let row = lane / POSEIDON_LANES.downcast_truncate()
    let step = fri_scratch_load(scratch, FRI_PROGRESS_START, lane)
    if step >= MAIN_LDE_ROW_SCHEDULE_STEPS.downcast_truncate() { return }
    let block = step / HASH_STAGE_STEPS.downcast_truncate()
    let hash_step = step % HASH_STAGE_STEPS.downcast_truncate()
    let transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    if hash_step < transition {
        advance_hash_lane(proof, scratch, row, field_lane, hash_step)
    } else if block == 0 {
        let fields = [
            air_lde_field(values, row, 6),
            air_lde_field(values, row, 7),
            air_lde_field(values, row, 8),
            air_lde_field(values, row, 9),
            air_lde_field(values, row, 10),
            air_lde_field(values, row, 11),
            air_lde_field(values, row, 12),
            air_lde_field(values, row, 13),
        ]
        let sponge = Poseidon2FieldSponge::restore(
            load_hash_buffer(scratch, row, true),
            0,
            MAIN_COLUMN_COUNT.downcast_truncate(),
            6,
        )
        let permutation = sponge.begin_permutation<8>(ref fields)
        initialize_hash_lane(
            scratch,
            row,
            field_lane,
            ref permutation,
            fri_scratch_load(scratch, FRI_HASH_VALID_START, row) == 1
                && air_lde_range_is_canonical(values, row, 6, 8),
        )
    } else if block == 1 {
        let fields = [
            air_lde_field(values, row, 14),
            air_lde_field(values, row, 15),
            air_lde_field(values, row, 16),
        ]
        let sponge = Poseidon2FieldSponge::restore(
            load_hash_buffer(scratch, row, true),
            0,
            MAIN_COLUMN_COUNT.downcast_truncate(),
            14,
        )
        let permutation = sponge.begin_final_permutation<3>(ref fields)
        initialize_hash_lane(
            scratch,
            row,
            field_lane,
            ref permutation,
            fri_scratch_load(scratch, FRI_HASH_VALID_START, row) == 1
                && air_lde_range_is_canonical(values, row, 14, 3),
        )
    } else if field_lane == 0 {
        store_tree_digest(scratch, tree_node(0, 0, row), hash_digest(scratch, row))
        fri_scratch_store(
            scratch,
            FRI_TREE_VALID_START,
            tree_node(0, 0, row),
            fri_scratch_load(scratch, FRI_HASH_VALID_START, row),
        )
    }
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, step + 1)
}

#[inline(always)]
fn advance_auxiliary_lde_row_commitments(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ values: ProofTape<u32, AIR_LDE_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= AIR_ROW_HASH_LANES.downcast_truncate() { return }
    let field_lane = lane % POSEIDON_LANES.downcast_truncate()
    let row = lane / POSEIDON_LANES.downcast_truncate()
    let step = fri_scratch_load(scratch, FRI_PROGRESS_START, lane)
    if step >= AUXILIARY_LDE_ROW_SCHEDULE_STEPS.downcast_truncate() { return }
    let block = step / HASH_STAGE_STEPS.downcast_truncate()
    let hash_step = step % HASH_STAGE_STEPS.downcast_truncate()
    let transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    if hash_step < transition {
        advance_hash_lane(proof, scratch, row, field_lane, hash_step)
    } else if block < 50 {
        let start = 6 + block * SPONGE_RATE.downcast_truncate()
        let auxiliary_start: u32 = MAIN_COLUMN_COUNT.downcast_truncate()
        let column = auxiliary_start + start
        let fields = [
            air_lde_field(values, row, column),
            air_lde_field(values, row, column + 1),
            air_lde_field(values, row, column + 2),
            air_lde_field(values, row, column + 3),
            air_lde_field(values, row, column + 4),
            air_lde_field(values, row, column + 5),
            air_lde_field(values, row, column + 6),
            air_lde_field(values, row, column + 7),
        ]
        let sponge = Poseidon2FieldSponge::restore(
            load_hash_buffer(scratch, row, true),
            0,
            AUXILIARY_ROW_BITS.downcast_truncate(),
            start,
        )
        let permutation = sponge.begin_permutation<8>(ref fields)
        initialize_hash_lane(
            scratch,
            row,
            field_lane,
            ref permutation,
            fri_scratch_load(scratch, FRI_HASH_VALID_START, row) == 1
                && air_lde_range_is_canonical(values, row, column, 8),
        )
    } else if block == 50 {
        let column = (MAIN_COLUMN_COUNT + 406).downcast_truncate()
        let fields = [
            air_lde_field(values, row, column),
            air_lde_field(values, row, column + 1),
            air_lde_field(values, row, column + 2),
            air_lde_field(values, row, column + 3),
            air_lde_field(values, row, column + 4),
        ]
        let sponge = Poseidon2FieldSponge::restore(
            load_hash_buffer(scratch, row, true),
            0,
            AUXILIARY_ROW_BITS.downcast_truncate(),
            406,
        )
        let permutation = sponge.begin_final_permutation<5>(ref fields)
        initialize_hash_lane(
            scratch,
            row,
            field_lane,
            ref permutation,
            fri_scratch_load(scratch, FRI_HASH_VALID_START, row) == 1
                && air_lde_range_is_canonical(values, row, column, 5),
        )
    } else if field_lane == 0 {
        store_tree_digest(scratch, tree_node(1, 0, row), hash_digest(scratch, row))
        fri_scratch_store(
            scratch,
            FRI_TREE_VALID_START,
            tree_node(1, 0, row),
            fri_scratch_load(scratch, FRI_HASH_VALID_START, row),
        )
    }
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, step + 1)
}

#[inline(always)]
fn advance_air_lde_trees(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= AIR_ROW_HASH_LANES.downcast_truncate() { return }
    let step = fri_scratch_load(scratch, FRI_PROGRESS_START, lane)
    if step >= AIR_LDE_TREE_SCHEDULE_STEPS.downcast_truncate() { return }
    let level = step / AIR_LDE_TREE_LEVEL_STEPS.downcast_truncate()
    let level_step = step % AIR_LDE_TREE_LEVEL_STEPS.downcast_truncate()
    let lde_width: u32 = LDE.downcast_truncate()
    let child_width = lde_width >> level
    let parent_width = child_width / 2
    let active_lanes = 2 * parent_width * POSEIDON_LANES.downcast_truncate()
    if lane < active_lanes {
        let state = lane / POSEIDON_LANES.downcast_truncate()
        let field_lane = lane % POSEIDON_LANES.downcast_truncate()
        let tree = state / parent_width
        let parent = state % parent_width
        let child_offset = tree_level_offset(LDE.downcast_truncate(), level)
        let parent_offset = child_offset + child_width
        let left = tree_node(tree, 0, child_offset + 2 * parent)
        let right = left + 1
        if level_step == 0 {
            let permutation = begin_compression_placement(
                load_tree_digest(scratch, left),
                load_tree_digest(scratch, right),
            )
            initialize_hash_lane(
                scratch,
                state,
                field_lane,
                ref permutation,
                fri_scratch_load(scratch, FRI_TREE_VALID_START, left) == 1
                    && fri_scratch_load(scratch, FRI_TREE_VALID_START, right) == 1,
            )
        } else {
            let hash_step = level_step - 1
            let transition =
                <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
            if hash_step < transition {
                advance_hash_lane(proof, scratch, state, field_lane, hash_step)
            } else if field_lane == 0 {
                let node = tree_node(tree, 0, parent_offset + parent)
                let digest = hash_digest(scratch, state)
                let valid = fri_scratch_load(scratch, FRI_HASH_VALID_START, state)
                store_tree_digest(scratch, node, digest)
                fri_scratch_store(scratch, FRI_TREE_VALID_START, node, valid)
                if level + 1 == AIR_LDE_TREE_LEVELS.downcast_truncate() {
                    let regions = proof_tape_regions()
                    if tree == 0 {
                        store_digest(proof, regions.main_lde_root, digest)
                    } else {
                        store_digest(proof, regions.auxiliary_lde_root, digest)
                    }
                    proof_store(proof, regions.air_lde_root_valid, tree, valid)
                }
            }
        }
    }
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, step + 1)
}

#[inline(always)]
fn packed_trace_word(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ state: u32,
    _ field: u32,
) -> u32 {
    let regions = proof_tape_regions()
    if state < TRACE.downcast_truncate() {
        proof_load(
            proof,
            regions.packed_main_trace,
            state * ROW_FIELDS.downcast_truncate() + field,
        )
    } else if state < (2 * TRACE).downcast_truncate() {
        proof_load(
            proof,
            regions.packed_auxiliary_trace,
            (state - TRACE.downcast_truncate())
                * AUXILIARY_FIELDS.downcast_truncate() + field,
        )
    } else {
        proof_load(proof, regions.packed_public, field)
    }
}

#[inline(always)]
fn packed_trace_range_is_canonical(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ state: u32,
    _ start: u32,
    _ count: u32,
) -> bool {
    let mut valid = true
    let mut field: u32 = 0
    while field < count {
        if packed_trace_word(proof, state, start + field) >= BABY_BEAR_MODULUS {
            valid = false
        }
        field = field + 1
    }
    valid
}

#[inline(always)]
fn initialize_trace_commitments(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= TRACE_HASH_LANES.downcast_truncate() { return }
    let state = lane / POSEIDON_LANES.downcast_truncate()
    let field_lane = lane % POSEIDON_LANES.downcast_truncate()
    if state < TRACE.downcast_truncate() {
        let fields = [
            BabyBear::from_u32(packed_trace_word(proof, state, 0)),
            BabyBear::from_u32(packed_trace_word(proof, state, 1)),
            BabyBear::from_u32(packed_trace_word(proof, state, 2)),
            BabyBear::from_u32(packed_trace_word(proof, state, 3)),
            BabyBear::from_u32(packed_trace_word(proof, state, 4)),
            BabyBear::from_u32(packed_trace_word(proof, state, 5)),
        ]
        let permutation = Poseidon2FieldSponge::begin_prefixed_tag(
            row_domain_tag(),
            210,
            ROW_FIELDS.downcast_truncate(),
        ).begin_permutation<6>(ref fields)
        initialize_hash_lane(
            scratch,
            state,
            field_lane,
            ref permutation,
            packed_trace_range_is_canonical(proof, state, 0, 6),
        )
    } else if state < (2 * TRACE).downcast_truncate() {
        let fields = [
            BabyBear::from_u32(packed_trace_word(proof, state, 0)),
            BabyBear::from_u32(packed_trace_word(proof, state, 1)),
            BabyBear::from_u32(packed_trace_word(proof, state, 2)),
            BabyBear::from_u32(packed_trace_word(proof, state, 3)),
            BabyBear::from_u32(packed_trace_word(proof, state, 4)),
            BabyBear::from_u32(packed_trace_word(proof, state, 5)),
        ]
        let permutation = Poseidon2FieldSponge::begin_prefixed_tag(
            auxiliary_domain_tag(),
            AUXILIARY_ROW_BITS.downcast_truncate(),
            AUXILIARY_FIELDS.downcast_truncate(),
        ).begin_permutation<6>(ref fields)
        initialize_hash_lane(
            scratch,
            state,
            field_lane,
            ref permutation,
            packed_trace_range_is_canonical(proof, state, 0, 6),
        )
    } else {
        let fields = [
            BabyBear::from_u32(packed_trace_word(proof, state, 0)),
            BabyBear::from_u32(packed_trace_word(proof, state, 1)),
            BabyBear::from_u32(packed_trace_word(proof, state, 2)),
            BabyBear::from_u32(packed_trace_word(proof, state, 3)),
        ]
        let permutation = Poseidon2FieldSponge::begin_prefixed_tag(
            public_domain_tag(),
            114,
            PUBLIC_FIELDS.downcast_truncate(),
        ).begin_final_permutation<4>(ref fields)
        initialize_hash_lane(
            scratch,
            state,
            field_lane,
            ref permutation,
            packed_trace_range_is_canonical(proof, state, 0, 4),
        )
    }
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, 0)
}

#[inline(always)]
fn advance_trace_commitments(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= TRACE_HASH_LANES.downcast_truncate() { return }
    let state = lane / POSEIDON_LANES.downcast_truncate()
    let field_lane = lane % POSEIDON_LANES.downcast_truncate()
    let step = fri_scratch_load(scratch, FRI_PROGRESS_START, lane)
    if step >= TRACE_COMMITMENT_SCHEDULE_STEPS.downcast_truncate() { return }
    let block = step / HASH_STAGE_STEPS.downcast_truncate()
    let hash_step = step % HASH_STAGE_STEPS.downcast_truncate()
    let transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    if block == 0 && hash_step < transition {
        advance_hash_lane(proof, scratch, state, field_lane, hash_step)
    } else if block == 0 {
        if state < TRACE.downcast_truncate() {
            let fields = [BabyBear::from_u32(packed_trace_word(proof, state, 6))]
            let sponge = Poseidon2FieldSponge::restore(
                load_hash_buffer(scratch, state, true),
                0,
                ROW_FIELDS.downcast_truncate(),
                6,
            )
            let permutation = sponge.begin_final_permutation<1>(ref fields)
            initialize_hash_lane(
                scratch,
                state,
                field_lane,
                ref permutation,
                fri_scratch_load(scratch, FRI_HASH_VALID_START, state) == 1
                    && packed_trace_range_is_canonical(proof, state, 6, 1),
            )
        } else if state < (2 * TRACE).downcast_truncate() {
            let fields = [
                BabyBear::from_u32(packed_trace_word(proof, state, 6)),
                BabyBear::from_u32(packed_trace_word(proof, state, 7)),
                BabyBear::from_u32(packed_trace_word(proof, state, 8)),
                BabyBear::from_u32(packed_trace_word(proof, state, 9)),
                BabyBear::from_u32(packed_trace_word(proof, state, 10)),
                BabyBear::from_u32(packed_trace_word(proof, state, 11)),
                BabyBear::from_u32(packed_trace_word(proof, state, 12)),
                BabyBear::from_u32(packed_trace_word(proof, state, 13)),
            ]
            let sponge = Poseidon2FieldSponge::restore(
                load_hash_buffer(scratch, state, true),
                0,
                AUXILIARY_FIELDS.downcast_truncate(),
                6,
            )
            let permutation = sponge.begin_permutation<8>(ref fields)
            initialize_hash_lane(
                scratch,
                state,
                field_lane,
                ref permutation,
                fri_scratch_load(scratch, FRI_HASH_VALID_START, state) == 1
                    && packed_trace_range_is_canonical(proof, state, 6, 8),
            )
        } else if field_lane == 0 {
            let digest = hash_digest(scratch, state)
            store_digest(proof, proof_tape_regions().public_digest, digest)
            proof_store(
                proof,
                proof_tape_regions().production_trace_digest_valid,
                2,
                fri_scratch_load(scratch, FRI_HASH_VALID_START, state),
            )
        }
    } else if state < (2 * TRACE).downcast_truncate() {
        if hash_step < transition {
            advance_hash_lane(proof, scratch, state, field_lane, hash_step)
        } else if field_lane == 0 {
            let tree = if state < TRACE.downcast_truncate() { 0 } else { 1 }
            let row = state % TRACE.downcast_truncate()
            let node = tree_node(tree, 0, row)
            store_tree_digest(scratch, node, hash_digest(scratch, state))
            fri_scratch_store(
                scratch,
                FRI_TREE_VALID_START,
                node,
                fri_scratch_load(scratch, FRI_HASH_VALID_START, state),
            )
        }
    }
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, step + 1)
}

#[inline(always)]
fn advance_trace_trees(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= AIR_ROW_HASH_LANES.downcast_truncate() { return }
    let step = fri_scratch_load(scratch, FRI_PROGRESS_START, lane)
    if step >= TRACE_TREE_SCHEDULE_STEPS.downcast_truncate() { return }
    let level = step / AIR_LDE_TREE_LEVEL_STEPS.downcast_truncate()
    let level_step = step % AIR_LDE_TREE_LEVEL_STEPS.downcast_truncate()
    let trace_width: u32 = TRACE.downcast_truncate()
    let child_width = trace_width >> level
    let parent_width = child_width / 2
    let active_lanes = 2 * parent_width * POSEIDON_LANES.downcast_truncate()
    if lane < active_lanes {
        let state = lane / POSEIDON_LANES.downcast_truncate()
        let field_lane = lane % POSEIDON_LANES.downcast_truncate()
        let tree = state / parent_width
        let parent = state % parent_width
        let child_offset = tree_level_offset(trace_width, level)
        let parent_offset = child_offset + child_width
        let left = tree_node(tree, 0, child_offset + 2 * parent)
        let right = left + 1
        if level_step == 0 {
            let permutation = begin_compression_placement(
                load_tree_digest(scratch, left),
                load_tree_digest(scratch, right),
            )
            initialize_hash_lane(
                scratch,
                state,
                field_lane,
                ref permutation,
                fri_scratch_load(scratch, FRI_TREE_VALID_START, left) == 1
                    && fri_scratch_load(scratch, FRI_TREE_VALID_START, right) == 1,
            )
        } else {
            let hash_step = level_step - 1
            let transition =
                <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
            if hash_step < transition {
                advance_hash_lane(proof, scratch, state, field_lane, hash_step)
            } else if field_lane == 0 {
                let node = tree_node(tree, 0, parent_offset + parent)
                let digest = hash_digest(scratch, state)
                let valid = fri_scratch_load(scratch, FRI_HASH_VALID_START, state)
                store_tree_digest(scratch, node, digest)
                fri_scratch_store(scratch, FRI_TREE_VALID_START, node, valid)
                if level + 1 == TRACE_TREE_LEVELS.downcast_truncate() {
                    let regions = proof_tape_regions()
                    if tree == 0 {
                        store_digest(proof, regions.main_trace_root, digest)
                    } else {
                        store_digest(proof, regions.auxiliary_trace_root, digest)
                    }
                    proof_store(
                        proof,
                        regions.production_trace_digest_valid,
                        tree,
                        valid,
                    )
                }
            }
        }
    }
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, step + 1)
}

#[inline(always)]
fn advance_air_transcript(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= POSEIDON_LANES.downcast_truncate() { return }
    let step = fri_scratch_load(scratch, FRI_PROGRESS_START, lane)
    if step >= AIR_TRANSCRIPT_SCHEDULE_STEPS.downcast_truncate() { return }
    let binding = step / AIR_TRANSCRIPT_BINDING_STEPS.downcast_truncate()
    let relative = step % AIR_TRANSCRIPT_BINDING_STEPS.downcast_truncate()
    let regions = proof_tape_regions()
    if relative == 0 {
        let left = if binding == 0 {
            load_digest(proof, regions.public_digest)
        } else {
            load_digest(proof, regions.air_transcript)
        }
        let right = if binding == 0 {
            load_digest(proof, regions.main_trace_root)
        } else if binding == 1 {
            load_digest(proof, regions.auxiliary_trace_root)
        } else if binding == 2 {
            load_digest(proof, regions.main_lde_root)
        } else {
            load_digest(proof, regions.auxiliary_lde_root)
        }
        let tag = if binding == 0 {
            statement_domain_tag()
        } else if binding == 1 {
            proof_transcript_domain_tag()
        } else if binding == 2 {
            main_lde_transcript_domain_tag()
        } else {
            auxiliary_lde_transcript_domain_tag()
        }
        let input_valid = if binding == 0 {
            proof_load(proof, regions.production_trace_digest_valid, 2) == 1
                && proof_load(proof, regions.production_trace_digest_valid, 0) == 1
        } else if binding == 1 {
            proof_load(proof, regions.air_transcript_valid, 0) == 1
                && proof_load(proof, regions.production_trace_digest_valid, 1) == 1
        } else if binding == 2 {
            proof_load(proof, regions.air_transcript_valid, 0) == 1
                && proof_load(proof, regions.air_lde_root_valid, 0) == 1
        } else {
            proof_load(proof, regions.air_transcript_valid, 0) == 1
                && proof_load(proof, regions.air_lde_root_valid, 1) == 1
        }
        let placed = begin_binding_placement_tag(tag, left, right)
        initialize_hash_lane(
            scratch,
            0,
            lane,
            ref placed.permutation,
            input_valid,
        )
        if lane < 10 {
            fri_scratch_store(
                scratch,
                FRI_HASH_TAILS_START,
                lane,
                placed.remaining[lane as usize].to_u32(),
            )
        }
    } else {
        let block_relative = relative - 1
        let block = block_relative / HASH_STAGE_STEPS.downcast_truncate()
        let hash_step = block_relative % HASH_STAGE_STEPS.downcast_truncate()
        let transition =
            <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
        if hash_step < transition {
            advance_hash_lane(proof, scratch, 0, lane, hash_step)
        } else if block == 0 {
            let output = load_hash_buffer(scratch, 0, true)
            let mut fields = [BabyBear::zero(); 8]
            let mut field: usize = 0
            while field < 8 {
                fields[field] = BabyBear::from_u32(fri_scratch_load(
                    scratch,
                    FRI_HASH_TAILS_START,
                    field.downcast_truncate(),
                ))
                field = field + 1
            }
            let permutation = Poseidon2FieldSponge::restore(output, 0, 16, 6)
                .begin_permutation<8>(ref fields)
            initialize_hash_lane(
                scratch,
                0,
                lane,
                ref permutation,
                fri_scratch_load(scratch, FRI_HASH_VALID_START, 0) == 1,
            )
        } else if block == 1 {
            let output = load_hash_buffer(scratch, 0, true)
            let fields = [
                BabyBear::from_u32(fri_scratch_load(
                    scratch,
                    FRI_HASH_TAILS_START,
                    8,
                )),
                BabyBear::from_u32(fri_scratch_load(
                    scratch,
                    FRI_HASH_TAILS_START,
                    9,
                )),
            ]
            let permutation = Poseidon2FieldSponge::restore(output, 0, 16, 14)
                .begin_final_permutation<2>(ref fields)
            initialize_hash_lane(
                scratch,
                0,
                lane,
                ref permutation,
                fri_scratch_load(scratch, FRI_HASH_VALID_START, 0) == 1,
            )
        } else if lane == 0 {
            store_digest(proof, regions.air_transcript, hash_digest(scratch, 0))
            proof_store(
                proof,
                regions.air_transcript_valid,
                0,
                fri_scratch_load(scratch, FRI_HASH_VALID_START, 0),
            )
        }
    }
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, step + 1)
}

/// Workgroup interpretation of `composition_challenge`. The scalar transcript
/// and this staged placement share the nominal `BC01` domain and exact digest
/// message; only the physical permutation schedule differs.
#[inline(always)]
fn advance_composition_challenge_placement(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= POSEIDON_LANES.downcast_truncate() { return }
    let step = fri_scratch_load(scratch, FRI_PROGRESS_START, lane)
    if step >= COMPOSITION_CHALLENGE_SCHEDULE_STEPS.downcast_truncate() { return }
    let regions = proof_tape_regions()
    if step == 0 {
        let placed = begin_digest_squeeze_placement_tag(
            composition_challenge_domain_tag(),
            load_digest(proof, regions.air_transcript),
        )
        initialize_hash_lane(
            scratch,
            0,
            lane,
            ref placed.permutation,
            proof_load(proof, regions.air_transcript_valid, 0) == 1,
        )
        if lane < 2 {
            fri_scratch_store(
                scratch,
                FRI_HASH_TAILS_START,
                lane,
                placed.remaining[lane as usize].to_u32(),
            )
        }
    } else {
        let relative = step - 1
        let block = relative / HASH_STAGE_STEPS.downcast_truncate()
        let hash_step = relative % HASH_STAGE_STEPS.downcast_truncate()
        let transition =
            <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
        if hash_step < transition {
            advance_hash_lane(proof, scratch, 0, lane, hash_step)
        } else if block == 0 {
            let fields = [
                BabyBear::from_u32(fri_scratch_load(
                    scratch,
                    FRI_HASH_TAILS_START,
                    0,
                )),
                BabyBear::from_u32(fri_scratch_load(
                    scratch,
                    FRI_HASH_TAILS_START,
                    1,
                )),
            ]
            let permutation = Poseidon2FieldSponge::restore(
                load_hash_buffer(scratch, 0, true),
                0,
                DIGEST_FIELDS.downcast_truncate(),
                6,
            ).begin_final_permutation<2>(ref fields)
            initialize_hash_lane(
                scratch,
                0,
                lane,
                ref permutation,
                fri_scratch_load(scratch, FRI_HASH_VALID_START, 0) == 1,
            )
        } else {
            if lane < EXTENSION_WORDS.downcast_truncate() {
                proof_store(
                    proof,
                    regions.composition_challenge,
                    lane,
                    hash_digest(scratch, 0).field(index: lane).to_u32(),
                )
            }
            if lane == 0 {
                proof_store(
                    proof,
                    regions.composition_valid,
                    0,
                    fri_scratch_load(scratch, FRI_HASH_VALID_START, 0),
                )
            }
        }
    }
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, step + 1)
}

#[inline(always)]
fn initialize_composition_leaf_commitments(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= AIR_ROW_HASH_LANES.downcast_truncate() { return }
    let row = lane / POSEIDON_LANES.downcast_truncate()
    let field_lane = lane % POSEIDON_LANES.downcast_truncate()
    let permutation = begin_ext4_commitment_placement_tag(
        composition_row_domain_tag(),
        load_composition_value(proof, row),
    )
    initialize_hash_lane(
        scratch,
        row,
        field_lane,
        ref permutation,
        proof_load(
            proof,
            proof_tape_regions().composition_value_valid,
            row,
        ) == 1,
    )
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, 0)
}

#[inline(always)]
fn advance_composition_leaf_commitments(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= AIR_ROW_HASH_LANES.downcast_truncate() { return }
    let row = lane / POSEIDON_LANES.downcast_truncate()
    let field_lane = lane % POSEIDON_LANES.downcast_truncate()
    let step = fri_scratch_load(scratch, FRI_PROGRESS_START, lane)
    if step >= COMPOSITION_LEAF_SCHEDULE_STEPS.downcast_truncate() { return }
    let transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    if step < transition {
        advance_hash_lane(proof, scratch, row, field_lane, step)
    } else if field_lane == 0 {
        let node = tree_node(0, 0, row)
        store_tree_digest(scratch, node, hash_digest(scratch, row))
        fri_scratch_store(
            scratch,
            FRI_TREE_VALID_START,
            node,
            fri_scratch_load(scratch, FRI_HASH_VALID_START, row),
        )
    }
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, step + 1)
}

#[inline(always)]
fn advance_composition_tree_placement(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= AIR_ROW_HASH_LANES.downcast_truncate() { return }
    let step = fri_scratch_load(scratch, FRI_PROGRESS_START, lane)
    if step >= COMPOSITION_TREE_SCHEDULE_STEPS.downcast_truncate() { return }
    let level = step / AIR_LDE_TREE_LEVEL_STEPS.downcast_truncate()
    let level_step = step % AIR_LDE_TREE_LEVEL_STEPS.downcast_truncate()
    let lde_width: u32 = LDE.downcast_truncate()
    let child_width = lde_width >> level
    let parent_width = child_width / 2
    let active_lanes = parent_width * POSEIDON_LANES.downcast_truncate()
    if lane < active_lanes {
        let parent = lane / POSEIDON_LANES.downcast_truncate()
        let field_lane = lane % POSEIDON_LANES.downcast_truncate()
        let child_offset = tree_level_offset(LDE.downcast_truncate(), level)
        let parent_offset = child_offset + child_width
        let left = tree_node(0, 0, child_offset + 2 * parent)
        let right = left + 1
        if level_step == 0 {
            let permutation = begin_compression_placement(
                load_tree_digest(scratch, left),
                load_tree_digest(scratch, right),
            )
            initialize_hash_lane(
                scratch,
                parent,
                field_lane,
                ref permutation,
                fri_scratch_load(scratch, FRI_TREE_VALID_START, left) == 1
                    && fri_scratch_load(scratch, FRI_TREE_VALID_START, right) == 1,
            )
        } else {
            let hash_step = level_step - 1
            let transition =
                <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
            if hash_step < transition {
                advance_hash_lane(proof, scratch, parent, field_lane, hash_step)
            } else if field_lane == 0 {
                let node = tree_node(0, 0, parent_offset + parent)
                let digest = hash_digest(scratch, parent)
                let valid = fri_scratch_load(
                    scratch,
                    FRI_HASH_VALID_START,
                    parent,
                )
                store_tree_digest(scratch, node, digest)
                fri_scratch_store(scratch, FRI_TREE_VALID_START, node, valid)
                if level + 1 == AIR_LDE_TREE_LEVELS.downcast_truncate() {
                    store_digest(
                        proof,
                        proof_tape_regions().composition_root,
                        digest,
                    )
                    proof_store(
                        proof,
                        proof_tape_regions().composition_valid,
                        1,
                        valid,
                    )
                }
            }
        }
    }
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, step + 1)
}

#[inline(always)]
fn advance_composition_transcript_placement(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let lane = invocation.local.x
    if lane >= POSEIDON_LANES.downcast_truncate() { return }
    let step = fri_scratch_load(scratch, FRI_PROGRESS_START, lane)
    if step >= COMPOSITION_TRANSCRIPT_SCHEDULE_STEPS.downcast_truncate() { return }
    let regions = proof_tape_regions()
    if step == 0 {
        let placed = begin_binding_placement_tag(
            composition_transcript_domain_tag(),
            load_digest(proof, regions.air_transcript),
            load_digest(proof, regions.composition_root),
        )
        initialize_hash_lane(
            scratch,
            0,
            lane,
            ref placed.permutation,
            proof_load(proof, regions.air_transcript_valid, 0) == 1
                && proof_load(proof, regions.composition_valid, 1) == 1,
        )
        if lane < 10 {
            fri_scratch_store(
                scratch,
                FRI_HASH_TAILS_START,
                lane,
                placed.remaining[lane as usize].to_u32(),
            )
        }
    } else {
        let relative = step - 1
        let block = relative / HASH_STAGE_STEPS.downcast_truncate()
        let hash_step = relative % HASH_STAGE_STEPS.downcast_truncate()
        let transition =
            <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
        if hash_step < transition {
            advance_hash_lane(proof, scratch, 0, lane, hash_step)
        } else if block == 0 {
            let mut fields = [BabyBear::zero(); 8]
            let mut field: usize = 0
            while field < 8 {
                fields[field] = BabyBear::from_u32(fri_scratch_load(
                    scratch,
                    FRI_HASH_TAILS_START,
                    field.downcast_truncate(),
                ))
                field = field + 1
            }
            let permutation = Poseidon2FieldSponge::restore(
                load_hash_buffer(scratch, 0, true),
                0,
                16,
                6,
            ).begin_permutation<8>(ref fields)
            initialize_hash_lane(
                scratch,
                0,
                lane,
                ref permutation,
                fri_scratch_load(scratch, FRI_HASH_VALID_START, 0) == 1,
            )
        } else if block == 1 {
            let fields = [
                BabyBear::from_u32(fri_scratch_load(
                    scratch,
                    FRI_HASH_TAILS_START,
                    8,
                )),
                BabyBear::from_u32(fri_scratch_load(
                    scratch,
                    FRI_HASH_TAILS_START,
                    9,
                )),
            ]
            let permutation = Poseidon2FieldSponge::restore(
                load_hash_buffer(scratch, 0, true),
                0,
                16,
                14,
            ).begin_final_permutation<2>(ref fields)
            initialize_hash_lane(
                scratch,
                0,
                lane,
                ref permutation,
                fri_scratch_load(scratch, FRI_HASH_VALID_START, 0) == 1,
            )
        } else if lane == 0 {
            store_digest(
                proof,
                regions.composition_transcript,
                hash_digest(scratch, 0),
            )
            proof_store(
                proof,
                regions.composition_valid,
                2,
                fri_scratch_load(scratch, FRI_HASH_VALID_START, 0),
            )
        }
    }
    fri_scratch_store(scratch, FRI_PROGRESS_START, lane, step + 1)
}

#[inline(always)]
fn fri_round_value_index(_ variant: u32, _ round: u32) -> u32 {
    variant * FRI_ROUNDS.downcast_truncate() + round
}

#[inline(always)]
fn fri_transcript_value_index(_ variant: u32, _ transcript: u32) -> u32 {
    variant * FRI_TRANSCRIPTS_PER_VARIANT.downcast_truncate() + transcript
}

#[inline(always)]
fn fri_shift(_ round_index: u32) -> BabyBear {
    let mut shift = BabyBear::from_u32(7)
    let mut index: u32 = 0
    while index < round_index {
        shift = shift * shift
        index = index + 1
    }
    shift
}

#[inline(always)]
fn advance_fri_round<
    const ROUND_INDEX: usize,
    const INPUT_WIDTH: usize,
    const OUTPUT_WIDTH: usize,
    const TREE_DEPTH: usize,
    const SCHEDULE_STEPS: usize,
>(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ tamper: f32,
    _ invocation: ComputeInvocation,
)
where
    { ROUND_INDEX < FRI_ROUNDS },
    { INPUT_WIDTH > 0 },
    { INPUT_WIDTH > 1 },
    { OUTPUT_WIDTH > 0 },
    { INPUT_WIDTH == 2 * OUTPUT_WIDTH },
    { (INPUT_WIDTH & (INPUT_WIDTH - 1)) == 0 },
    { SCHEDULE_STEPS == fri_round_schedule_steps(TREE_DEPTH) }
{
    let regions = proof_tape_regions()
    let status = fri_status_regions()
    let challenge_valid_region = subregion(
        regions.fri_status,
        status.challenge_valid,
    )
    let root_valid_region = subregion(regions.fri_status, status.root_valid)
    let transcript_valid_region = subregion(
        regions.fri_status,
        status.transcript_valid,
    )
    let round_valid_region = subregion(regions.fri_status, status.round_valid)
    let lane = invocation.local.x
    let lane_count: u32 = FRI_WORKGROUP_LANES.downcast_truncate()
    if lane >= lane_count { return }
    let round_index: u32 = ROUND_INDEX.downcast_truncate()
    let progress_index = round_index * lane_count + lane
    let step = fri_scratch_load(
        scratch,
        FRI_PROGRESS_START,
        progress_index,
    )
    if step >= SCHEDULE_STEPS.downcast_truncate() { return }

    let placement =
        <ProofFriSchedule as FriSchedulePlacement>::fri_round_placement(
            round_index,
        )
    let output_width: u32 = OUTPUT_WIDTH.downcast_truncate()
    let input_width: u32 = INPUT_WIDTH.downcast_truncate()
    let tree_depth: u32 = TREE_DEPTH.downcast_truncate()
    let variant_count: u32 = FRI_VARIANTS.downcast_truncate()
    let expected_tree_depth: u32 = if output_width > 1 {
        placement.pair_depth + 1
    } else {
        0
    }
    let schedule_valid = placement.valid
        && placement.index == round_index
        && placement.round == round_index + 1
        && placement.input_width == input_width
        && placement.output_width == output_width
        && placement.output_offset + output_width
            <= FRI_EVALUATIONS.downcast_truncate()
        && placement.tree_nodes == 2 * output_width - 1
        && placement.tree_offset + placement.tree_nodes
            <= proof_fri_metadata().layer_tree_nodes
        && expected_tree_depth == tree_depth

    let hash_stage_steps: u32 = HASH_STAGE_STEPS.downcast_truncate()
    let hash_transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    let challenge_end: u32 = FRI_CHALLENGE_PLACEMENT_STEPS.downcast_truncate()
    let fold_step = challenge_end
    let leaf_start = fold_step + 1
    let tree_start = leaf_start + FRI_LEAF_PLACEMENT_STEPS.downcast_truncate()
    let binding_start = tree_start
        + tree_depth
            * FRI_LEAF_PLACEMENT_STEPS.downcast_truncate()

    if step == 0 {
        if lane < (FRI_VARIANTS * POSEIDON_LANES).downcast_truncate() {
            let state = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            let transcript_index = fri_transcript_value_index(
                state,
                round_index,
            )
            let transcript = load_fri_transcript_digest(
                proof,
                transcript_index,
            )
            let placed = begin_digest_squeeze_placement_tag(
                fri_fold_domain_tag(placement.round),
                transcript,
            )
            let input_valid = schedule_valid && proof_load(
                proof,
                transcript_valid_region,
                transcript_index,
            ) == 1
            initialize_hash_lane(
                scratch,
                state,
                field_lane,
                ref placed.permutation,
                input_valid,
            )
            if field_lane < 2 {
                fri_scratch_store(
                    scratch,
                    FRI_HASH_TAILS_START,
                    state * 10 + field_lane,
                    placed.remaining[field_lane as usize].to_u32(),
                )
            }
        }
    } else if step < challenge_end {
        let relative = step - 1
        let block = relative / hash_stage_steps
        let hash_step = relative % hash_stage_steps
        if lane < (FRI_VARIANTS * POSEIDON_LANES).downcast_truncate() {
            let state = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            if hash_step < hash_transition {
                advance_hash_lane(
                    proof,
                    scratch,
                    state,
                    field_lane,
                    hash_step,
                )
            } else if block == 0 {
                let output = load_hash_buffer(
                    scratch,
                    state,
                    true,
                )
                let tail = [
                    BabyBear::from_u32(fri_scratch_load(
                        scratch,
                        FRI_HASH_TAILS_START,
                        state * 10,
                    )),
                    BabyBear::from_u32(fri_scratch_load(
                        scratch,
                        FRI_HASH_TAILS_START,
                        state * 10 + 1,
                    )),
                ]
                let sponge = Poseidon2FieldSponge::restore(
                    lanes: output,
                    rate: 0,
                    expected: DIGEST_FIELDS.downcast_truncate(),
                    written: 6,
                )
                let permutation = sponge.begin_final_permutation<2>(
                    fields: ref tail,
                )
                initialize_hash_lane(
                    scratch,
                    state,
                    field_lane,
                    ref permutation,
                    fri_scratch_load(
                        scratch,
                        FRI_HASH_VALID_START,
                        state,
                    ) == 1,
                )
            } else {
                if field_lane < EXTENSION_WORDS.downcast_truncate() {
                    let digest = hash_digest(scratch, state)
                    let challenge_base = fri_round_value_index(
                        state,
                        round_index,
                    ) * EXTENSION_WORDS.downcast_truncate()
                    proof_store(
                        proof,
                        regions.fri_challenges,
                        challenge_base + field_lane,
                        digest.field(index: field_lane).to_u32(),
                    )
                }
                if field_lane == 0 {
                    proof_store(
                        proof,
                        challenge_valid_region,
                        fri_round_value_index(state, round_index),
                        fri_scratch_load(
                            scratch,
                            FRI_HASH_VALID_START,
                            state,
                        ),
                    )
                }
            }
        }
    } else if step == fold_step {
        if lane < (FRI_VARIANTS * OUTPUT_WIDTH).downcast_truncate() {
            let variant = lane / output_width
            let pair = lane % output_width
            let mut positive = BabyBearExt4::zero()
            let mut negative = BabyBearExt4::zero()
            let destination = if variant == 0 {
                regions.fri_clean
            } else {
                regions.fri_observed
            }
            if ROUND_INDEX == 0 {
                positive = load_composition_value(proof, pair)
                negative = load_composition_value(
                    proof,
                    pair + output_width,
                )
                if variant == 1 && tamper >= 0.5 && pair == 1 {
                    positive = BabyBearExt4::from_coordinate_fields(
                        positive.coefficient_0(),
                        positive.coefficient_1() + BabyBear::one(),
                        positive.coefficient_2(),
                        positive.coefficient_3(),
                    )
                }
            } else {
                let previous = placement.output_offset - placement.input_width
                positive = load_fri_evaluation(
                    proof,
                    destination,
                    previous + pair,
                )
                negative = load_fri_evaluation(
                    proof,
                    destination,
                    previous + pair + output_width,
                )
            }
            let challenge_base = fri_round_value_index(
                variant,
                round_index,
            ) * EXTENSION_WORDS.downcast_truncate()
            let challenge = BabyBearExt4::from_coordinate_words(
                proof_load(proof, regions.fri_challenges, challenge_base),
                proof_load(proof, regions.fri_challenges, challenge_base + 1),
                proof_load(proof, regions.fri_challenges, challenge_base + 2),
                proof_load(proof, regions.fri_challenges, challenge_base + 3),
            )
            let value_valid = schedule_valid && proof_load(
                proof,
                challenge_valid_region,
                fri_round_value_index(variant, round_index),
            ) == 1
            let folded = if value_valid {
                let root = BabyBear::two_adic_root(placement.input_log)
                fold_fri_pair_value_at_point(
                    positive,
                    negative,
                    challenge,
                    fri_shift(round_index) * root.pow_u32(pair),
                )
            } else {
                BabyBearExt4::zero()
            }
            store_fri_evaluation(
                proof,
                destination,
                placement.output_offset + pair,
                folded,
            )
        }
    } else if step == leaf_start {
        if lane < (FRI_VARIANTS * OUTPUT_WIDTH * POSEIDON_LANES)
            .downcast_truncate()
        {
            let state = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            let variant = state / output_width
            let pair = state % output_width
            let source = if variant == 0 {
                regions.fri_clean
            } else {
                regions.fri_observed
            }
            let evaluation = load_fri_evaluation(
                proof,
                source,
                placement.output_offset + pair,
            )
            let permutation = begin_ext4_commitment_placement_tag(
                fri_layer_row_domain_tag(placement.round),
                evaluation,
            )
            let input_valid = schedule_valid && proof_load(
                proof,
                challenge_valid_region,
                fri_round_value_index(variant, round_index),
            ) == 1
            initialize_hash_lane(
                scratch,
                state,
                field_lane,
                ref permutation,
                input_valid,
            )
        }
    } else if step < tree_start {
        let hash_step = step - leaf_start - 1
        if lane < (FRI_VARIANTS * OUTPUT_WIDTH * POSEIDON_LANES)
            .downcast_truncate()
        {
            let state = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            let variant = state / output_width
            let pair = state % output_width
            if hash_step < hash_transition {
                advance_hash_lane(
                    proof,
                    scratch,
                    state,
                    field_lane,
                    hash_step,
                )
            } else if field_lane == 0 {
                let node = tree_node(variant, placement.tree_offset, pair)
                let digest = hash_digest(scratch, state)
                store_tree_digest(scratch, node, digest)
                fri_scratch_store(
                    scratch,
                    FRI_TREE_VALID_START,
                    node,
                    fri_scratch_load(
                        scratch,
                        FRI_HASH_VALID_START,
                        state,
                    ),
                )
                if TREE_DEPTH == 0 {
                    store_fri_root_digest(
                        proof,
                        fri_round_value_index(variant, round_index),
                        digest,
                    )
                    proof_store(
                        proof,
                        root_valid_region,
                        fri_round_value_index(variant, round_index),
                        fri_scratch_load(
                            scratch,
                            FRI_HASH_VALID_START,
                            state,
                        ),
                    )
                }
            }
        }
    } else if step < binding_start {
        let relative = step - tree_start
        let level = relative / FRI_LEAF_PLACEMENT_STEPS.downcast_truncate()
        let level_step = relative % FRI_LEAF_PLACEMENT_STEPS.downcast_truncate()
        let child_width = output_width >> level
        let parent_width = child_width / 2
        let child_offset = tree_level_offset(output_width, level)
        let parent_offset = child_offset + child_width
        if lane < variant_count
            * parent_width * POSEIDON_LANES.downcast_truncate()
        {
            let state = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            let variant = state / parent_width
            let parent = state % parent_width
            let left_node = tree_node(
                variant,
                placement.tree_offset,
                child_offset + 2 * parent,
            )
            let right_node = left_node + 1
            if level_step == 0 {
                let permutation = begin_compression_placement(
                    load_tree_digest(scratch, left_node),
                    load_tree_digest(scratch, right_node),
                )
                initialize_hash_lane(
                    scratch,
                    state,
                    field_lane,
                    ref permutation,
                    fri_scratch_load(
                        scratch,
                        FRI_TREE_VALID_START,
                        left_node,
                    ) == 1 && fri_scratch_load(
                        scratch,
                        FRI_TREE_VALID_START,
                        right_node,
                    ) == 1,
                )
            } else {
                let hash_step = level_step - 1
                if hash_step < hash_transition {
                    advance_hash_lane(
                        proof,
                        scratch,
                        state,
                        field_lane,
                        hash_step,
                    )
                } else if field_lane == 0 {
                    let node = tree_node(
                        variant,
                        placement.tree_offset,
                        parent_offset + parent,
                    )
                    let digest = hash_digest(scratch, state)
                    store_tree_digest(scratch, node, digest)
                    fri_scratch_store(
                        scratch,
                        FRI_TREE_VALID_START,
                        node,
                        fri_scratch_load(
                            scratch,
                            FRI_HASH_VALID_START,
                            state,
                        ),
                    )
                    if level + 1 == tree_depth {
                        store_fri_root_digest(
                            proof,
                            fri_round_value_index(variant, round_index),
                            digest,
                        )
                        proof_store(
                            proof,
                            root_valid_region,
                            fri_round_value_index(variant, round_index),
                            fri_scratch_load(
                                scratch,
                                FRI_HASH_VALID_START,
                                state,
                            ),
                        )
                    }
                }
            }
        }
    } else {
        let relative = step - binding_start
        if lane < (FRI_VARIANTS * POSEIDON_LANES).downcast_truncate() {
            let state = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            if relative == 0 {
                let transcript_index = fri_transcript_value_index(
                    state,
                    round_index,
                )
                let transcript = load_fri_transcript_digest(
                    proof,
                    transcript_index,
                )
                let root = load_fri_root_digest(
                    proof,
                    fri_round_value_index(state, round_index),
                )
                let placed = begin_binding_placement_tag(
                    fri_layer_transcript_domain_tag(placement.round),
                    transcript,
                    root,
                )
                initialize_hash_lane(
                    scratch,
                    state,
                    field_lane,
                    ref placed.permutation,
                    schedule_valid
                        && proof_load(
                            proof,
                            transcript_valid_region,
                            transcript_index,
                        ) == 1
                        && proof_load(
                            proof,
                            root_valid_region,
                            fri_round_value_index(state, round_index),
                        ) == 1,
                )
                if field_lane < 10 {
                    fri_scratch_store(
                        scratch,
                        FRI_HASH_TAILS_START,
                        state * 10 + field_lane,
                        placed.remaining[field_lane as usize].to_u32(),
                    )
                }
            } else {
                let block_relative = relative - 1
                let block = block_relative / hash_stage_steps
                let hash_step = block_relative % hash_stage_steps
                if hash_step < hash_transition {
                    advance_hash_lane(
                        proof,
                        scratch,
                        state,
                        field_lane,
                        hash_step,
                    )
                } else if block == 0 {
                    let output = load_hash_buffer(scratch, state, true)
                    let mut fields = [BabyBear::zero(); 8]
                    let mut index: usize = 0
                    while index < 8 {
                        fields[index] = BabyBear::from_u32(fri_scratch_load(
                            scratch,
                            FRI_HASH_TAILS_START,
                            state * 10 + index.downcast_truncate(),
                        ))
                        index = index + 1
                    }
                    let sponge = Poseidon2FieldSponge::restore(
                        output,
                        0,
                        (2 * DIGEST_FIELDS).downcast_truncate(),
                        6,
                    )
                    let permutation = sponge.begin_permutation<8>(ref fields)
                    initialize_hash_lane(
                        scratch,
                        state,
                        field_lane,
                        ref permutation,
                        fri_scratch_load(
                            scratch,
                            FRI_HASH_VALID_START,
                            state,
                        ) == 1,
                    )
                } else if block == 1 {
                    let output = load_hash_buffer(scratch, state, true)
                    let fields = [
                        BabyBear::from_u32(fri_scratch_load(
                            scratch,
                            FRI_HASH_TAILS_START,
                            state * 10 + 8,
                        )),
                        BabyBear::from_u32(fri_scratch_load(
                            scratch,
                            FRI_HASH_TAILS_START,
                            state * 10 + 9,
                        )),
                    ]
                    let sponge = Poseidon2FieldSponge::restore(
                        output,
                        0,
                        (2 * DIGEST_FIELDS).downcast_truncate(),
                        14,
                    )
                    let permutation = sponge.begin_final_permutation<2>(ref fields)
                    initialize_hash_lane(
                        scratch,
                        state,
                        field_lane,
                        ref permutation,
                        fri_scratch_load(
                            scratch,
                            FRI_HASH_VALID_START,
                            state,
                        ) == 1,
                    )
                } else if field_lane == 0 {
                    let digest = hash_digest(scratch, state)
                    let next_transcript = fri_transcript_value_index(
                        state,
                        round_index + 1,
                    )
                    store_fri_transcript_digest(
                        proof,
                        next_transcript,
                        digest,
                    )
                    let valid = fri_scratch_load(
                        scratch,
                        FRI_HASH_VALID_START,
                        state,
                    )
                    proof_store(
                        proof,
                        transcript_valid_region,
                        next_transcript,
                        valid,
                    )
                    proof_store(
                        proof,
                        round_valid_region,
                        fri_round_value_index(state, round_index),
                        valid,
                    )
                }
            }
        }
    }
    fri_scratch_store(
        scratch,
        FRI_PROGRESS_START,
        progress_index,
        step + 1,
    )
}

#[inline(always)]
fn advance_fri_query_sample(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ invocation: ComputeInvocation,
) {
    let regions = proof_tape_regions()
    let fri_status = fri_status_regions()
    let query_status = fri_query_status_regions()
    let lane = invocation.local.x
    let lane_count: u32 = FRI_WORKGROUP_LANES.downcast_truncate()
    if lane >= lane_count { return }
    let step = fri_scratch_load(
        scratch,
        FRI_QUERY_PROGRESS_START,
        lane,
    )
    if step >= FRI_QUERY_PLACEMENT_STEPS.downcast_truncate() { return }

    let hash_stage_steps: u32 = HASH_STAGE_STEPS.downcast_truncate()
    let hash_transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    // Static assertions above bind these concrete shader capacities to the
    // recursive query plan once. Re-normalizing that plan in every invocation
    // needlessly multiplies compiler work.
    let query_identity = FRI_QUERY_IDENTITY
    let schedule_valid = query_identity < BABY_BEAR_MODULUS
        && FRI_QUERY_EVALUATIONS == 7
        && FRI_QUERY_PATH_SIBLINGS == 6

    if step == 0 {
        if lane < (FRI_VARIANTS * POSEIDON_LANES).downcast_truncate() {
            let variant = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            let transcript_index = fri_transcript_value_index(
                variant,
                FRI_ROUNDS.downcast_truncate(),
            )
            let transcript = load_fri_transcript_digest(
                proof,
                transcript_index,
            )
            let placed = begin_indexed_digest_squeeze_placement_tag(
                fri_query_domain_tag(),
                transcript,
                query_identity,
            )
            let input_valid = schedule_valid && proof_load(
                proof,
                subregion(regions.fri_status, fri_status.transcript_valid),
                transcript_index,
            ) == 1
            initialize_hash_lane(
                scratch,
                variant,
                field_lane,
                ref placed.permutation,
                input_valid,
            )
            if field_lane < 3 {
                fri_scratch_store(
                    scratch,
                    FRI_HASH_TAILS_START,
                    variant * 10 + field_lane,
                    placed.remaining[field_lane as usize].to_u32(),
                )
            }
        }
    } else {
        let relative = step - 1
        let block = relative / hash_stage_steps
        let hash_step = relative % hash_stage_steps
        if lane < (FRI_VARIANTS * POSEIDON_LANES).downcast_truncate() {
            let variant = lane / POSEIDON_LANES.downcast_truncate()
            let field_lane = lane % POSEIDON_LANES.downcast_truncate()
            if hash_step < hash_transition {
                advance_hash_lane(
                    proof,
                    scratch,
                    variant,
                    field_lane,
                    hash_step,
                )
            } else if block == 0 {
                let output = load_hash_buffer(scratch, variant, true)
                let tail = [
                    BabyBear::from_u32(fri_scratch_load(
                        scratch,
                        FRI_HASH_TAILS_START,
                        variant * 10,
                    )),
                    BabyBear::from_u32(fri_scratch_load(
                        scratch,
                        FRI_HASH_TAILS_START,
                        variant * 10 + 1,
                    )),
                    BabyBear::from_u32(fri_scratch_load(
                        scratch,
                        FRI_HASH_TAILS_START,
                        variant * 10 + 2,
                    )),
                ]
                let sponge = Poseidon2FieldSponge::restore(
                    lanes: output,
                    rate: 0,
                    expected: 9,
                    written: 6,
                )
                let permutation = sponge.begin_final_permutation<3>(
                    fields: ref tail,
                )
                initialize_hash_lane(
                    scratch,
                    variant,
                    field_lane,
                    ref permutation,
                    fri_scratch_load(
                        scratch,
                        FRI_HASH_VALID_START,
                        variant,
                    ) == 1,
                )
            } else if field_lane == 0 {
                let digest = hash_digest(scratch, variant)
                let valid = fri_scratch_load(
                    scratch,
                    FRI_HASH_VALID_START,
                    variant,
                ) == 1
                proof_store(
                    proof,
                    regions.fri_query_indices,
                    variant,
                    digest.field(index: 0).to_u32()
                        & (FRI_MAX_OUTPUT - 1).downcast_truncate(),
                )
                proof_store(
                    proof,
                    subregion(regions.fri_query_status, query_status.index_valid),
                    variant,
                    if valid { 1 } else { 0 },
                )
            }
        }
    }
    fri_scratch_store(
        scratch,
        FRI_QUERY_PROGRESS_START,
        lane,
        step + 1,
    )
}

// Retain four readable projections from the production main AIR matrix as a
// diagnostic commitment and mutation rail. The protocol FRI input is the full
// composition codeword above; these columns no longer carry proof semantics.
const AIR_STEP_COLUMN: usize = 0
const AIR_MAGNITUDE_COLUMN: usize = 7
const AIR_ACTIVE_COLUMN: usize = 15
const AIR_TERMINAL_COLUMN: usize = 16

#[inline(always)]
fn compact_lde_column(_ air_column: u32) -> u32 {
    if air_column == AIR_STEP_COLUMN.downcast_truncate() {
        0
    } else if air_column == AIR_MAGNITUDE_COLUMN.downcast_truncate() {
        1
    } else if air_column == AIR_ACTIVE_COLUMN.downcast_truncate() {
        2
    } else if air_column == AIR_TERMINAL_COLUMN.downcast_truncate() {
        3
    } else {
        COLUMN_COUNT.downcast_truncate()
    }
}

/// Store one canonical production AIR row in column-major transform order.
/// Main words and the 411 auxiliary words are both interpreted from the same
/// nominal `EncodedProofRow`; no host witness or copied offset table enters the
/// GPU resource boundary.
#[inline(always)]
fn store_air_trace_row(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ trace: Region<ProofTapeRegions, [u32; AIR_TRACE_WORDS]>,
    _ row_index: u32,
    _ row: EncodedProofRow,
) {
    let trace_rows: u32 = TRACE.downcast_truncate()
    let mut column: usize = 0
    while column < MAIN_COLUMN_COUNT {
        let column_word: u32 = column.downcast_truncate()
        proof_store(
            proof,
            trace,
            column_word * trace_rows + row_index,
            encoded_proof_row_word(row, column),
        )
        column = column + 1
    }

    column = 0
    while column < AUXILIARY_ROW_BITS {
        let column_word: u32 =
            (MAIN_COLUMN_COUNT + column).downcast_truncate()
        proof_store(
            proof,
            trace,
            column_word * trace_rows + row_index,
            encoded_auxiliary_row_bit_direct(row.air, column),
        )
        column = column + 1
    }
}

/// Materialize the shared injective BabyBear packing for one production row.
/// Hash placement consumes these fields later, so the witness pass does not
/// duplicate any sponge or transcript policy.
#[inline(always)]
fn store_packed_trace_row(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ row_index: u32,
    _ row: EncodedProofRow,
) -> bool {
    let regions = proof_tape_regions()
    let mut field: u32 = 0
    while field < ROW_FIELDS.downcast_truncate() {
        proof_store(
            proof,
            regions.packed_main_trace,
            row_index * ROW_FIELDS.downcast_truncate() + field,
            encoded_row_field_direct(row, field),
        )
        field = field + 1
    }
    field = 0
    while field < AUXILIARY_FIELDS.downcast_truncate() {
        proof_store(
            proof,
            regions.packed_auxiliary_trace,
            row_index * AUXILIARY_FIELDS.downcast_truncate() + field,
            encoded_auxiliary_field_direct(row, field),
        )
        field = field + 1
    }
    encoded_row_fields_are_valid(row)
        && encoded_auxiliary_fields_are_valid(row)
}

#[inline(always)]
fn store_packed_public(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ public: EscapesByQ12Public,
) -> bool {
    let regions = proof_tape_regions()
    let mut word: usize = 0
    while word < ESCAPES_BY_Q12_PUBLIC_WORDS {
        proof_store(
            proof,
            regions.canonical_public,
            word.downcast_truncate(),
            escapes_by_q12_public_word(public, word),
        )
        word = word + 1
    }
    let mut field: u32 = 0
    while field < PUBLIC_FIELDS.downcast_truncate() {
        proof_store(
            proof,
            regions.packed_public,
            field,
            encoded_public_field_direct(public, field),
        )
        field = field + 1
    }
    encoded_public_fields_are_valid(public)
}

actor MandelbrotProofGpuCheckpoint uses (
    Program<WebGpuBackend>, SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    proof: ProofTape<u32, PROOF_WORDS>,
    lde_inverse_values: ProofTape<u32, AIR_TRACE_WORDS>,
    lde_inverse_progress: ProofTape<u32, INPUT_GRID_LANES>,
    lde_values: ProofTape<u32, AIR_LDE_WORDS>,
    lde_progress: ProofTape<u32, OUTPUT_GRID_LANES>,
    fri_scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    tamper: f32,
    res: f32,

    const fn view() -> Surface<ProofParams> {
        Surface {
            extent: Extent::square(512),
            params: proof_params(),
        }
    }

    fn derive_witness(self) uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let regions = proof_tape_regions()
        let trace_layout = trace_regions()
        let trace_step = subregion(regions.trace, trace_layout.step)
        let trace_magnitude = subregion(regions.trace, trace_layout.magnitude)
        let trace_active = subregion(regions.trace, trace_layout.active)
        let trace_terminal = subregion(regions.trace, trace_layout.terminal)
        let trace_valid_region = subregion(
            regions.status,
            status_regions().trace_valid,
        )
        let air_trace = regions.air_trace

        // c = 0.75 + 0i escapes on row three, giving an exact four-row
        // power-of-two trace. The ordinary production kernel derives every
        // main and auxiliary word. No witness row enters from the host.
        let claim = EscapesByQ12::new(3072, 0, 4)
        let mut stream = EscapeTraceStream::new(claim)

        let row0 = encode_proof_row(stream.current_proof_row())
        store_air_trace_row(self.proof, air_trace, 0, row0)
        let packed0 = store_packed_trace_row(self.proof, 0, row0)
        proof_store(self.proof, trace_step, 0, encoded_proof_row_word(row0, AIR_STEP_COLUMN))
        proof_store(self.proof, trace_magnitude, 0, encoded_proof_row_word(row0, AIR_MAGNITUDE_COLUMN))
        proof_store(self.proof, trace_active, 0, encoded_proof_row_word(row0, AIR_ACTIVE_COLUMN))
        proof_store(self.proof, trace_terminal, 0, encoded_proof_row_word(row0, AIR_TERMINAL_COLUMN))

        stream.advance()
        let row1 = encode_proof_row(stream.current_proof_row())
        store_air_trace_row(self.proof, air_trace, 1, row1)
        let packed1 = store_packed_trace_row(self.proof, 1, row1)
        proof_store(self.proof, trace_step, 1, encoded_proof_row_word(row1, AIR_STEP_COLUMN))
        proof_store(self.proof, trace_magnitude, 1, encoded_proof_row_word(row1, AIR_MAGNITUDE_COLUMN))
        proof_store(self.proof, trace_active, 1, encoded_proof_row_word(row1, AIR_ACTIVE_COLUMN))
        proof_store(self.proof, trace_terminal, 1, encoded_proof_row_word(row1, AIR_TERMINAL_COLUMN))

        stream.advance()
        let row2 = encode_proof_row(stream.current_proof_row())
        store_air_trace_row(self.proof, air_trace, 2, row2)
        let packed2 = store_packed_trace_row(self.proof, 2, row2)
        proof_store(self.proof, trace_step, 2, encoded_proof_row_word(row2, AIR_STEP_COLUMN))
        proof_store(self.proof, trace_magnitude, 2, encoded_proof_row_word(row2, AIR_MAGNITUDE_COLUMN))
        proof_store(self.proof, trace_active, 2, encoded_proof_row_word(row2, AIR_ACTIVE_COLUMN))
        proof_store(self.proof, trace_terminal, 2, encoded_proof_row_word(row2, AIR_TERMINAL_COLUMN))

        stream.advance()
        let row3 = encode_proof_row(stream.current_proof_row())
        store_air_trace_row(self.proof, air_trace, 3, row3)
        let packed3 = store_packed_trace_row(self.proof, 3, row3)
        proof_store(self.proof, trace_step, 3, encoded_proof_row_word(row3, AIR_STEP_COLUMN))
        proof_store(self.proof, trace_magnitude, 3, encoded_proof_row_word(row3, AIR_MAGNITUDE_COLUMN))
        proof_store(self.proof, trace_active, 3, encoded_proof_row_word(row3, AIR_ACTIVE_COLUMN))
        proof_store(self.proof, trace_terminal, 3, encoded_proof_row_word(row3, AIR_TERMINAL_COLUMN))

        let public = EscapesByQ12Public {
            c_re: encode_signed_word(claim.c.re),
            c_im: encode_signed_word(claim.c.im),
            bound: claim.bound,
            terminal_step: row3.air.step,
            trace_length: row3.air.step + 1,
            padded_length: TRACE.downcast_truncate(),
        }
        let public_valid = store_packed_public(self.proof, public)
        let trace_valid = stream.is_valid() && row3.terminal == 1
            && packed0 && packed1 && packed2 && packed3 && public_valid
        proof_store(
            self.proof,
            trace_valid_region,
            0,
            if trace_valid { 1 } else { 0 },
        )

        // Derive the canonical Grain parameter stream once on the GPU. The
        // repeated proof schedule reads this typed storage region, so no round
        // invocation materializes the full CTFE aggregate in its shader.
        let mut parameters = Poseidon2ParameterStream::begin()
        let mut parameter: usize = 0
        while parameter < ROUND_CONSTANT_COUNT {
            proof_store(
                self.proof,
                regions.parameters,
                parameter.downcast_truncate(),
                parameters.next(),
            )
            parameter = parameter + 1
        }
    }

    fn prepare_lde_inverse(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<GPU_WORKGROUP_LANES, 1, 1>,
                Once<INPUT_DISPATCH_X, 1, 1>,
            >
        )
    {
        let trace_start = region_bounds(proof_tape_regions().air_trace).start
        prepare_batched_stage_grid<
            AIR_COLUMN_COUNT,
            TRACE,
            INPUT_LANES,
            PROOF_WORDS,
            AIR_TRACE_WORDS,
            INPUT_GRID_LANES,
        >(
            self.proof,
            trace_start,
            self.lde_inverse_values,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn advance_lde_inverse(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<GPU_WORKGROUP_LANES, 1, 1>,
                Repeat<INPUT_DISPATCH_X, 1, 1, INPUT_STAGES>,
            >
        )
    {
        inverse_batched_stage_grid_lane<
            AIR_COLUMN_COUNT,
            TRACE,
            INPUT_LANES,
            AIR_TRACE_WORDS,
            INPUT_GRID_LANES,
            BabyBear,
            ProofLdeInputPlan,
        >(
            self.lde_inverse_values,
            self.lde_inverse_progress,
            invocation,
        )
    }

    fn prepare_lde_forward(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<GPU_WORKGROUP_LANES, 1, 1>,
                Once<OUTPUT_DISPATCH_X, 1, 1>,
            >
        )
    {
        let prepared = prepare_batched_coset_extension<
            AIR_COLUMN_COUNT,
            TRACE,
            LDE,
            INPUT_LANES,
            OUTPUT_LANES,
            AIR_TRACE_WORDS,
            INPUT_GRID_LANES,
            AIR_LDE_WORDS,
            OUTPUT_GRID_LANES,
            BabyBear,
            ProofLdeInputPlan,
            ProofLdeOutputPlan,
        >(
            self.lde_inverse_values,
            self.lde_inverse_progress,
            self.lde_values,
            self.lde_progress,
            BabyBear::from_u32(7),
            invocation,
        )
        if prepared.active && prepared.lane == 0 {
            proof_store(
                self.proof,
                proof_tape_regions().air_lde_valid,
                prepared.batch,
                if prepared.valid { 1 } else { 0 },
            )
        }
    }

    fn advance_lde_forward(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<GPU_WORKGROUP_LANES, 1, 1>,
                Repeat<OUTPUT_DISPATCH_X, 1, 1, OUTPUT_STAGES>,
            >
        )
    {
        forward_batched_stage_grid_lane<
            AIR_COLUMN_COUNT,
            LDE,
            OUTPUT_LANES,
            AIR_LDE_WORDS,
            OUTPUT_GRID_LANES,
            BabyBear,
            ProofLdeOutputPlan,
        >(
            self.lde_values,
            self.lde_progress,
            invocation,
        )
    }

    fn finish_lde(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<GPU_WORKGROUP_LANES, 1, 1>,
                Once<OUTPUT_DISPATCH_X, 1, 1>,
            >
        )
    {
        let regions = proof_tape_regions()
        let lde_start = region_bounds(regions.lde).start
        let lde_valid = subregion(regions.status, status_regions().lde_valid)
        let finish = finish_batched_stage_grid<
            AIR_COLUMN_COUNT,
            LDE,
            OUTPUT_LANES,
            AIR_LDE_WORDS,
            OUTPUT_GRID_LANES,
            ProofLdeOutputPlan,
        >(
            self.lde_progress,
            invocation,
        )
        if finish.active && finish.lane == 0 {
            let prepared = proof_load(
                self.proof,
                regions.air_lde_valid,
                finish.batch,
            ) == 1
            proof_store(
                self.proof,
                regions.air_lde_valid,
                finish.batch,
                if prepared && finish.valid { 1 } else { 0 },
            )
        }
        if finish.active {
            let compact_column = compact_lde_column(finish.batch)
            if compact_column < COLUMN_COUNT.downcast_truncate() {
                let lde_points: u32 = LDE.downcast_truncate()
                let lde_lanes: u32 = OUTPUT_LANES.downcast_truncate()
                let source = finish.batch * lde_points + finish.lane
                let destination = lde_start + compact_column * lde_points
                    + finish.lane
                self.proof.store(
                    index: destination,
                    value: self.lde_values.load(index: source),
                )
                self.proof.store(
                    index: destination + lde_lanes,
                    value: self.lde_values.load(index: source + lde_lanes),
                )
                if finish.lane == 0 {
                    proof_store(
                        self.proof,
                        lde_valid,
                        compact_column,
                        proof_load(
                            self.proof,
                            regions.air_lde_valid,
                            finish.batch,
                        ),
                    )
                }
            }
        }
    }

    fn initialize_main_lde_commitments(self, invocation: ComputeInvocation)
        uses (Prove<Threads<AIR_ROW_HASH_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        initialize_air_lde_row_commitments(
            self.proof,
            self.fri_scratch,
            self.lde_values,
            false,
            invocation,
        )
    }

    fn advance_main_lde_commitments(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<AIR_ROW_HASH_LANES, 1, 1>,
                Repeat<1, 1, 1, MAIN_LDE_ROW_SCHEDULE_STEPS>,
            >
        )
    {
        advance_main_lde_row_commitments(
            self.proof,
            self.fri_scratch,
            self.lde_values,
            invocation,
        )
    }

    fn initialize_auxiliary_lde_commitments(self, invocation: ComputeInvocation)
        uses (Prove<Threads<AIR_ROW_HASH_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        initialize_air_lde_row_commitments(
            self.proof,
            self.fri_scratch,
            self.lde_values,
            true,
            invocation,
        )
    }

    fn advance_auxiliary_lde_commitments(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<AIR_ROW_HASH_LANES, 1, 1>,
                Repeat<1, 1, 1, AUXILIARY_LDE_ROW_SCHEDULE_STEPS>,
            >
        )
    {
        advance_auxiliary_lde_row_commitments(
            self.proof,
            self.fri_scratch,
            self.lde_values,
            invocation,
        )
    }

    fn initialize_air_lde_trees(self, invocation: ComputeInvocation)
        uses (Prove<Threads<AIR_ROW_HASH_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        let lane = invocation.local.x
        if lane < AIR_ROW_HASH_LANES.downcast_truncate() {
