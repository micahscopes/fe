    fn project_production_air_composition(self, invocation: ComputeInvocation)
        uses (Prove<Threads<LDE, 1, 1>, Once<1, 1, 1>>)
    {
        let evaluation = invocation.local.x
        if evaluation < LDE.downcast_truncate() {
            let challenge = load_composition_challenge(self.proof)
            let fold708 = load_composition_fold<708>(
                self.fri_scratch, challenge, evaluation,
            )
            let checkpoint = restore_constraint_numerator_checkpoint(
                fold708,
                load_composition_family(
                    self.fri_scratch,
                    COMPOSITION_ALL_ROWS_START,
                    evaluation,
                ),
                load_composition_family(
                    self.fri_scratch,
                    COMPOSITION_PAIR_ROWS_START,
                    evaluation,
                ),
                load_composition_family(
                    self.fri_scratch,
                    COMPOSITION_FIRST_ROW_START,
                    evaluation,
                ),
            )
            let composed = project_production_composition_value(
                checkpoint,
                evaluation,
            )
            store_composition_value(self.proof, evaluation, composed.value)
            proof_store(
                self.proof,
                proof_tape_regions().composition_value_valid,
                evaluation,
                if composed.valid && composition_fold_is_valid(
                    self.fri_scratch,
                    evaluation,
                ) { 1 } else { 0 },
            )
        }
    }

