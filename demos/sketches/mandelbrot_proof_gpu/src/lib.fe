const TRACE: usize = 4
const LDE: usize = 16
const COLUMN_COUNT: usize = 4
const TRACE_WORDS: usize = COLUMN_COUNT * TRACE
const LDE_WORDS: usize = COLUMN_COUNT * LDE
const MAIN_COLUMN_COUNT: usize = 17
const AIR_COLUMN_COUNT: usize = MAIN_COLUMN_COUNT + AUXILIARY_ROW_BITS
const AIR_TRACE_WORDS: usize = AIR_COLUMN_COUNT * TRACE
const AIR_LDE_WORDS: usize = AIR_COLUMN_COUNT * LDE
const INPUT_LANES: usize = TRACE / 2
const OUTPUT_LANES: usize = LDE / 2
const INPUT_GRID_LANES: usize = AIR_COLUMN_COUNT * INPUT_LANES
const OUTPUT_GRID_LANES: usize = AIR_COLUMN_COUNT * OUTPUT_LANES
const GPU_WORKGROUP_LANES: usize = 256
const INPUT_DISPATCH_X: usize =
    (INPUT_GRID_LANES + GPU_WORKGROUP_LANES - 1) / GPU_WORKGROUP_LANES
const OUTPUT_DISPATCH_X: usize =
    (OUTPUT_GRID_LANES + GPU_WORKGROUP_LANES - 1) / GPU_WORKGROUP_LANES
const DIGEST_FIELDS: usize = 8
const COMMIT_STATE_WORDS: usize = 80
const STATUS_WORDS: usize = 11
const EXTENSION_WORDS: usize = 4
const FRI_ROUNDS: usize = 4
const FRI_VARIANTS: usize = 2
const FRI_MAX_OUTPUT: usize = LDE / 2
const FRI_EVALUATIONS: usize = 15
const FRI_EVALUATION_WORDS: usize = FRI_EVALUATIONS * EXTENSION_WORDS
const FRI_CHALLENGE_WORDS: usize =
    FRI_VARIANTS * FRI_ROUNDS * EXTENSION_WORDS
const FRI_ROOT_WORDS: usize = FRI_VARIANTS * FRI_ROUNDS * DIGEST_FIELDS
const FRI_TRANSCRIPTS_PER_VARIANT: usize = FRI_ROUNDS + 1
const FRI_TRANSCRIPT_WORDS: usize =
    FRI_VARIANTS * FRI_TRANSCRIPTS_PER_VARIANT * DIGEST_FIELDS
const FRI_VALID_ROUNDS: usize = FRI_VARIANTS * FRI_ROUNDS
const FRI_VALID_TRANSCRIPTS: usize =
    FRI_VARIANTS * FRI_TRANSCRIPTS_PER_VARIANT
const FRI_STATUS_WORDS: usize =
    FRI_VALID_ROUNDS + FRI_VALID_ROUNDS + FRI_VALID_TRANSCRIPTS
        + FRI_VALID_ROUNDS + 3
const FRI_QUERY_EVALUATIONS: usize = 7
const FRI_QUERY_PATH_SIBLINGS: usize = 6
const FRI_QUERY_INDEX_WORDS: usize = FRI_VARIANTS
const FRI_QUERY_EVALUATION_WORDS: usize =
    FRI_VARIANTS * FRI_QUERY_EVALUATIONS * EXTENSION_WORDS
const FRI_QUERY_SIBLING_WORDS: usize =
    FRI_VARIANTS * FRI_QUERY_PATH_SIBLINGS * DIGEST_FIELDS
const FRI_QUERY_STATUS_WORDS: usize = 2 * FRI_VARIANTS + 3
const AIR_LDE_ROOT_WORDS: usize = 2 * DIGEST_FIELDS
const AIR_LDE_ROOT_VALID_WORDS: usize = 2
const PACKED_MAIN_TRACE_FIELDS: usize = TRACE * ROW_FIELDS
const PACKED_AUXILIARY_TRACE_FIELDS: usize = TRACE * AUXILIARY_FIELDS
const PACKED_PUBLIC_FIELDS: usize = PUBLIC_FIELDS
const PRODUCTION_TRACE_DIGEST_WORDS: usize = 3 * DIGEST_FIELDS
const PRODUCTION_TRACE_DIGEST_VALID_WORDS: usize = 3
const AIR_TRANSCRIPT_WORDS: usize = DIGEST_FIELDS
const AIR_TRANSCRIPT_VALID_WORDS: usize = 1
const CANONICAL_PUBLIC_WORDS: usize = ESCAPES_BY_Q12_PUBLIC_WORDS
const COMPOSITION_CHALLENGE_WORDS: usize = EXTENSION_WORDS
const COMPOSITION_VALUE_WORDS: usize = LDE * EXTENSION_WORDS
const COMPOSITION_ROOT_WORDS: usize = DIGEST_FIELDS
const COMPOSITION_TRANSCRIPT_WORDS: usize = DIGEST_FIELDS
const COMPOSITION_VALUE_VALID_WORDS: usize = LDE
const COMPOSITION_VALID_WORDS: usize = 3
const PROOF_WORDS: usize = TRACE_WORDS
    + LDE_WORDS
    + 2 * DIGEST_FIELDS
    + STATUS_WORDS
    + 2 * COMMIT_STATE_WORDS
    + ROUND_CONSTANT_COUNT
    + 2 * FRI_EVALUATION_WORDS
    + FRI_CHALLENGE_WORDS
    + FRI_ROOT_WORDS
    + FRI_TRANSCRIPT_WORDS
    + FRI_STATUS_WORDS
    + FRI_QUERY_INDEX_WORDS
    + FRI_QUERY_EVALUATION_WORDS
    + FRI_QUERY_SIBLING_WORDS
    + FRI_QUERY_STATUS_WORDS
    + AIR_TRACE_WORDS
    + AIR_COLUMN_COUNT
    + AIR_LDE_ROOT_WORDS
    + AIR_LDE_ROOT_VALID_WORDS
    + PACKED_MAIN_TRACE_FIELDS
    + PACKED_AUXILIARY_TRACE_FIELDS
    + PACKED_PUBLIC_FIELDS
    + PRODUCTION_TRACE_DIGEST_WORDS
    + PRODUCTION_TRACE_DIGEST_VALID_WORDS
    + AIR_TRANSCRIPT_WORDS
    + AIR_TRANSCRIPT_VALID_WORDS
    + CANONICAL_PUBLIC_WORDS
    + COMPOSITION_CHALLENGE_WORDS
    + COMPOSITION_VALUE_WORDS
    + COMPOSITION_ROOT_WORDS
    + COMPOSITION_TRANSCRIPT_WORDS
    + COMPOSITION_VALUE_VALID_WORDS
    + COMPOSITION_VALID_WORDS

struct ProofTapeRegions {
    trace: Region<ProofTapeRegions, [u32; TRACE_WORDS]>,
    lde: Region<ProofTapeRegions, [u32; LDE_WORDS]>,
    clean_root: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
    observed_root: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
    status: Region<ProofTapeRegions, [u32; STATUS_WORDS]>,
    clean_commitment: Region<ProofTapeRegions, [u32; COMMIT_STATE_WORDS]>,
    observed_commitment: Region<ProofTapeRegions, [u32; COMMIT_STATE_WORDS]>,
    parameters: Region<ProofTapeRegions, [u32; ROUND_CONSTANT_COUNT]>,
    fri_clean: Region<ProofTapeRegions, [u32; FRI_EVALUATION_WORDS]>,
    fri_observed: Region<ProofTapeRegions, [u32; FRI_EVALUATION_WORDS]>,
    fri_challenges: Region<ProofTapeRegions, [u32; FRI_CHALLENGE_WORDS]>,
    fri_roots: Region<ProofTapeRegions, [u32; FRI_ROOT_WORDS]>,
    fri_transcripts: Region<ProofTapeRegions, [u32; FRI_TRANSCRIPT_WORDS]>,
    fri_status: Region<ProofTapeRegions, [u32; FRI_STATUS_WORDS]>,
    fri_query_indices: Region<ProofTapeRegions, [u32; FRI_QUERY_INDEX_WORDS]>,
    fri_query_evaluations: Region<ProofTapeRegions, [u32; FRI_QUERY_EVALUATION_WORDS]>,
    fri_query_siblings: Region<ProofTapeRegions, [u32; FRI_QUERY_SIBLING_WORDS]>,
    fri_query_status: Region<ProofTapeRegions, [u32; FRI_QUERY_STATUS_WORDS]>,
    air_trace: Region<ProofTapeRegions, [u32; AIR_TRACE_WORDS]>,
    air_lde_valid: Region<ProofTapeRegions, [u32; AIR_COLUMN_COUNT]>,
    main_lde_root: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
    auxiliary_lde_root: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
    air_lde_root_valid: Region<ProofTapeRegions, [u32; AIR_LDE_ROOT_VALID_WORDS]>,
    packed_main_trace: Region<ProofTapeRegions, [u32; PACKED_MAIN_TRACE_FIELDS]>,
    packed_auxiliary_trace: Region<ProofTapeRegions, [u32; PACKED_AUXILIARY_TRACE_FIELDS]>,
    packed_public: Region<ProofTapeRegions, [u32; PACKED_PUBLIC_FIELDS]>,
    main_trace_root: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
    auxiliary_trace_root: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
    public_digest: Region<ProofTapeRegions, [u32; DIGEST_FIELDS]>,
    production_trace_digest_valid: Region<
        ProofTapeRegions,
        [u32; PRODUCTION_TRACE_DIGEST_VALID_WORDS],
    >,
    air_transcript: Region<ProofTapeRegions, [u32; AIR_TRANSCRIPT_WORDS]>,
    air_transcript_valid: Region<ProofTapeRegions, [u32; AIR_TRANSCRIPT_VALID_WORDS]>,
    canonical_public: Region<ProofTapeRegions, [u32; CANONICAL_PUBLIC_WORDS]>,
    composition_challenge: Region<ProofTapeRegions, [u32; COMPOSITION_CHALLENGE_WORDS]>,
    composition_values: Region<ProofTapeRegions, [u32; COMPOSITION_VALUE_WORDS]>,
    composition_root: Region<ProofTapeRegions, [u32; COMPOSITION_ROOT_WORDS]>,
    composition_transcript: Region<ProofTapeRegions, [u32; COMPOSITION_TRANSCRIPT_WORDS]>,
    composition_value_valid: Region<
        ProofTapeRegions,
        [u32; COMPOSITION_VALUE_VALID_WORDS],
    >,
    composition_valid: Region<ProofTapeRegions, [u32; COMPOSITION_VALID_WORDS]>,
}
impl core::marker::Copy for ProofTapeRegions {}
derive RegionSchema for ProofTapeRegions using RegionSchemaProvider

