#[inline(always)]
fn fri_scratch_load(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ start: u32,
    _ index: u32,
) -> u32 {
    scratch.load(index: start + index)
}

#[inline(always)]
fn fri_scratch_store(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ start: u32,
    _ index: u32,
    _ value: u32,
) {
    scratch.store(index: start + index, value: value)
}

