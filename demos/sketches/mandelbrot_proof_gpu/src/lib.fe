    fn initialize_commitments(self) uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let regions = proof_tape_regions()
        // The static assertions above tie these concrete array types to the
        // sponge-derived rate while Fe const-alias generic arguments mature.
        let fields = load_lde_fields<6>(tape: self.proof, region: regions.lde)
        let sponge = Poseidon2FieldSponge::begin<MandelbrotGpuLdeV1>(
            expected: LDE_WORDS.downcast_truncate(),
        )
        let permutation = sponge.begin_permutation<6>(fields: ref fields)
        store_initial_commitment(
            tape: self.proof,
            state: regions.clean_commitment,
            permutation: ref permutation,
        )
        store_initial_commitment(
            tape: self.proof,
            state: regions.observed_commitment,
            permutation: ref permutation,
        )
    }

    fn advance_commitment_rounds(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<COMMITMENT_WORKGROUP_LANES, 1, 1>,
                Repeat<1, 1, 1, COMMITMENT_SCHEDULE_STEPS>,
            >
        )
    {
        let regions = proof_tape_regions()
        let state_layout = commitment_regions()
        let poseidon_lanes: u32 = POSEIDON_LANES.downcast_truncate()
        let commitment_lane = invocation.local.x / poseidon_lanes
        let field_lane = invocation.local.x % poseidon_lanes
        let field_index: RegionIndex<[u32; POSEIDON_LANES]> =
            cyclic_region_index(field_lane)
        let observed = commitment_lane == 1
        let state = if observed {
            regions.observed_commitment
        } else {
            regions.clean_commitment
        }
        let primary_region = subregion(state, state_layout.primary)
        let secondary_region = subregion(state, state_layout.secondary)
        let cursor_region = subregion(state, state_layout.cursor)
        let block_region = subregion(state, state_layout.block)
        let valid_region = subregion(state, state_layout.valid)
        let cursor = proof_load_indexed(self.proof, cursor_region, field_index)
        let block = proof_load_indexed(self.proof, block_region, field_index)
        let mut valid = proof_load_indexed(self.proof, valid_region, field_index)
        let primary = load_commitment_buffer(
            tape: self.proof,
            state: state,
            buffer: state_layout.primary,
        )
        let secondary = load_commitment_buffer(
            tape: self.proof,
            state: state,
            buffer: state_layout.secondary,
        )
        let mut checked: usize = 0
        while checked < POSEIDON_LANES {
            if primary[checked] >= BABY_BEAR_MODULUS { valid = 0 }
            if secondary[checked] >= BABY_BEAR_MODULUS { valid = 0 }
            checked = checked + 1
        }

        let transition =
            <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
        if cursor < transition {
            let destination = poseidon2_workgroup_destination(cursor)
            let output = if destination == 0 {
                primary_region
            } else {
                secondary_region
            }
            let mut round_constant: u32 = 0
            if cursor != 0 && ((cursor - 1) & 1) == 0 {
                let phase = (cursor - 1) / 2
                let index = poseidon2_round_constant_index(phase, field_lane)
                round_constant = proof_load(self.proof, regions.parameters, index)
            }
            let value = if valid == 1 {
                poseidon2_workgroup_lane_with_round_constant(
                    ref primary,
                    ref secondary,
                    cursor,
                    field_lane,
                    round_constant,
                )
            } else {
                0
            }
            proof_store_indexed(self.proof, output, field_index, value)
            proof_store_indexed(self.proof, cursor_region, field_index, cursor + 1)
            proof_store_indexed(self.proof, block_region, field_index, block)
            proof_store_indexed(self.proof, valid_region, field_index, valid)
        } else if cursor == transition && block < FINAL_FULL_BLOCK.downcast_truncate() {
            let first_block_fields: u32 = FIRST_BLOCK_FIELDS.downcast_truncate()
            let sponge_rate: u32 = SPONGE_RATE.downcast_truncate()
            let start = first_block_fields + block * sponge_rate
            let mut value = secondary[field_lane as usize]
            if field_lane < sponge_rate {
                value = BabyBear::from_u32(proof_load(
                    self.proof,
                    regions.lde,
                    start + field_lane,
                )).to_montgomery_word()
            }
            if observed && self.tamper >= 0.5
                && block == TAMPER_PRECEDING_BLOCK.downcast_truncate()
                && field_lane == TAMPER_NEXT_BLOCK_FIELD.downcast_truncate()
            {
                value = (BabyBear::from_montgomery_word(value) + BabyBear::one())
                    .to_montgomery_word()
            }
            proof_store_indexed(
                self.proof,
                primary_region,
                field_index,
                if valid == 1 { value } else { 0 },
            )
            proof_store_indexed(self.proof, cursor_region, field_index, 0)
            proof_store_indexed(self.proof, block_region, field_index, block + 1)
            proof_store_indexed(self.proof, valid_region, field_index, valid)
        } else if cursor == transition && block == FINAL_FULL_BLOCK.downcast_truncate() {
            let mut value = secondary[field_lane as usize]
            if field_lane < 2 {
                let final_field_start: u32 =
                    (LDE_WORDS - 2).downcast_truncate()
                value = BabyBear::from_u32(proof_load(
                    self.proof,
                    regions.lde,
                    final_field_start + field_lane,
                )).to_montgomery_word()
            }
            proof_store_indexed(
                self.proof,
                primary_region,
                field_index,
                if valid == 1 { value } else { 0 },
            )
            proof_store_indexed(self.proof, cursor_region, field_index, 0)
            proof_store_indexed(
                self.proof,
                block_region,
                field_index,
                FINAL_PARTIAL_BLOCK.downcast_truncate(),
            )
            proof_store_indexed(self.proof, valid_region, field_index, valid)
        } else if cursor == transition && block == FINAL_PARTIAL_BLOCK.downcast_truncate() {
            if field_lane < DIGEST_FIELDS.downcast_truncate() {
                let root = if observed {
                    regions.observed_root
                } else {
                    regions.clean_root
                }
                proof_store(
                    self.proof,
                    root,
                    field_lane,
                    BabyBear::from_montgomery_word(
                        secondary[field_lane as usize]
                    ).to_u32(),
                )
            }
            proof_store_indexed(
                self.proof,
                primary_region,
                field_index,
                secondary[field_lane as usize],
            )
            proof_store_indexed(self.proof, cursor_region, field_index, 0)
            proof_store_indexed(
                self.proof,
                block_region,
                field_index,
                if valid == 1 {
                    DONE_BLOCK.downcast_truncate()
                } else {
                    0
                },
            )
            proof_store_indexed(self.proof, valid_region, field_index, valid)
        } else {
            proof_store_indexed(self.proof, cursor_region, field_index, 0)
            proof_store_indexed(self.proof, block_region, field_index, 0)
            proof_store_indexed(self.proof, valid_region, field_index, 0)
        }
    }

    fn finalize_commitments(self) uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let regions = proof_tape_regions()
        let status_layout = status_regions()
        let clean_root = load_digest(tape: self.proof, region: regions.clean_root)
        let observed_root = load_digest(tape: self.proof, region: regions.observed_root)
        let main_lde_root = load_digest(
            tape: self.proof,
            region: regions.main_lde_root,
        )
        let auxiliary_lde_root = load_digest(
            tape: self.proof,
            region: regions.auxiliary_lde_root,
        )
        let main_trace_root = load_digest(
            tape: self.proof,
            region: regions.main_trace_root,
        )
        let auxiliary_trace_root = load_digest(
            tape: self.proof,
            region: regions.auxiliary_trace_root,
        )
        let public_digest = load_digest(
            tape: self.proof,
            region: regions.public_digest,
        )
        let air_transcript = load_digest(
            tape: self.proof,
            region: regions.air_transcript,
        )
        let composition_root = load_digest(
            tape: self.proof,
            region: regions.composition_root,
        )
        let composition_transcript = load_digest(
            tape: self.proof,
            region: regions.composition_transcript,
        )
        let tampered = self.tamper >= 0.5
        let roots_equal = clean_root.equals(observed_root)
        let trace_valid = stored_flag(
            self.proof,
            subregion(regions.status, status_layout.trace_valid),
        )
        let lde_valid = all_lde_columns_valid(
            self.proof,
            subregion(regions.status, status_layout.lde_valid),
        ) && all_air_lde_columns_valid(
            self.proof,
            regions.air_lde_valid,
        )
        let commitments_valid = commitment_state_valid(
            tape: self.proof,
            state: regions.clean_commitment,
        ) && commitment_state_valid(
            tape: self.proof,
            state: regions.observed_commitment,
        )
        let air_roots_valid = proof_load(
            self.proof,
            regions.air_lde_root_valid,
            0,
        ) == 1 && proof_load(
            self.proof,
            regions.air_lde_root_valid,
            1,
        ) == 1 && !main_lde_root.equals(Poseidon2Digest::zero())
            && !auxiliary_lde_root.equals(Poseidon2Digest::zero())
        let production_trace_valid = proof_load(
            self.proof,
            regions.production_trace_digest_valid,
            0,
        ) == 1 && proof_load(
            self.proof,
            regions.production_trace_digest_valid,
            1,
        ) == 1 && proof_load(
            self.proof,
            regions.production_trace_digest_valid,
            2,
        ) == 1 && !main_trace_root.equals(Poseidon2Digest::zero())
            && !auxiliary_trace_root.equals(Poseidon2Digest::zero())
            && !public_digest.equals(Poseidon2Digest::zero())
        let production_transcript_valid = proof_load(
            self.proof,
            regions.air_transcript_valid,
            0,
        ) == 1 && !air_transcript.equals(Poseidon2Digest::zero())
        let composition_valid = proof_load(
            self.proof,
            regions.composition_valid,
            0,
        ) == 1 && proof_load(
            self.proof,
            regions.composition_valid,
            1,
        ) == 1 && proof_load(
            self.proof,
            regions.composition_valid,
            2,
        ) == 1 && all_composition_values_valid(
            self.proof,
            regions.composition_value_valid,
        ) && !composition_root.equals(Poseidon2Digest::zero())
            && !composition_transcript.equals(Poseidon2Digest::zero())
        let root_nonzero = commitments_valid && air_roots_valid
            && production_trace_valid && production_transcript_valid
            && composition_valid
            && !clean_root.equals(Poseidon2Digest::zero())
        let mode_correct = trace_valid && lde_valid && commitments_valid
            && air_roots_valid && production_trace_valid
            && production_transcript_valid && composition_valid && (
            if tampered { !roots_equal } else { roots_equal }
        )

        proof_store(
            self.proof,
            subregion(regions.status, status_layout.roots_equal),
            0,
            if roots_equal { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.mode_correct),
            0,
            if mode_correct { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.trace_color),
            0,
            status_word(trace_valid, false),
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.lde_color),
            0,
            status_word(lde_valid, false),
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.root_color),
            0,
            status_word(root_nonzero, false),
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.mode_color),
            0,
            status_word(mode_correct, tampered),
        )
    }

    fn initialize_fri_schedule(self, invocation: ComputeInvocation)
        uses (Prove<Threads<FRI_WORKGROUP_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        let regions = proof_tape_regions()
        let status = fri_status_regions()
        let lane = invocation.local.x
        let lane_count: u32 = FRI_WORKGROUP_LANES.downcast_truncate()
        let mut round: u32 = 0
        while round < FRI_ROUNDS.downcast_truncate() {
            fri_scratch_store(
                self.fri_scratch,
                FRI_PROGRESS_START,
                round * lane_count + lane,
                0,
            )
            round = round + 1
        }
        fri_scratch_store(
            self.fri_scratch,
            FRI_QUERY_PROGRESS_START,
            lane,
            0,
        )
        if lane < DIGEST_FIELDS.downcast_truncate() {
            let value = proof_load(
                self.proof,
                regions.composition_transcript,
                lane,
            )
            let mut variant: u32 = 0
            while variant < FRI_VARIANTS.downcast_truncate() {
                proof_store(
                    self.proof,
                    regions.fri_transcripts,
                    fri_transcript_value_index(variant, 0)
                        * DIGEST_FIELDS.downcast_truncate() + lane,
                    value,
                )
                variant = variant + 1
            }
        }
        if lane < FRI_VARIANTS.downcast_truncate() {
            let initial_valid = proof_load(
                self.proof,
                regions.composition_valid,
                2,
            ) == 1 && proof_fri_metadata().rounds
                == FRI_ROUNDS.downcast_truncate()
            proof_store(
                self.proof,
                subregion(regions.fri_status, status.transcript_valid),
                fri_transcript_value_index(lane, 0),
                if initial_valid { 1 } else { 0 },
            )
        }
    }

    fn advance_fri_round_1(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<FRI_WORKGROUP_LANES, 1, 1>,
                Repeat<1, 1, 1, FRI_ROUND_1_STEPS>,
            >
        )
    {
        advance_fri_round<0, 16, 8, 3, FRI_ROUND_1_STEPS>(
            self.proof,
            self.fri_scratch,
            self.tamper,
            invocation,
        )
    }

    fn advance_fri_round_2(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<FRI_WORKGROUP_LANES, 1, 1>,
                Repeat<1, 1, 1, FRI_ROUND_2_STEPS>,
            >
        )
    {
        advance_fri_round<1, 8, 4, 2, FRI_ROUND_2_STEPS>(
            self.proof,
            self.fri_scratch,
            self.tamper,
            invocation,
        )
    }

    fn advance_fri_round_3(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<FRI_WORKGROUP_LANES, 1, 1>,
                Repeat<1, 1, 1, FRI_ROUND_3_STEPS>,
            >
        )
    {
        advance_fri_round<2, 4, 2, 1, FRI_ROUND_3_STEPS>(
            self.proof,
            self.fri_scratch,
            self.tamper,
            invocation,
        )
    }

    fn advance_fri_round_4(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<FRI_WORKGROUP_LANES, 1, 1>,
                Repeat<1, 1, 1, FRI_ROUND_4_STEPS>,
            >
        )
    {
        advance_fri_round<3, 2, 1, 0, FRI_ROUND_4_STEPS>(
            self.proof,
            self.fri_scratch,
            self.tamper,
            invocation,
        )
    }

    fn sample_fri_query(self, invocation: ComputeInvocation)
        uses (
            Prove<
                Threads<FRI_WORKGROUP_LANES, 1, 1>,
                Repeat<1, 1, 1, FRI_QUERY_PLACEMENT_STEPS>,
            >
        )
    {
        advance_fri_query_sample(
            self.proof,
            self.fri_scratch,
            invocation,
        )
    }

    fn extract_fri_query(self, invocation: ComputeInvocation)
        uses (Prove<Threads<FRI_WORKGROUP_LANES, 1, 1>, Once<1, 1, 1>>)
    {
        let regions = proof_tape_regions()
        let lane = invocation.local.x
        let evaluation_words: u32 =
            FRI_QUERY_EVALUATION_WORDS.downcast_truncate()
        let sibling_words: u32 = FRI_QUERY_SIBLING_WORDS.downcast_truncate()
        if lane < evaluation_words {
            let placements = proof_fri_round_placements()
            let words_per_variant: u32 =
                (FRI_QUERY_EVALUATIONS * EXTENSION_WORDS).downcast_truncate()
            let variant = lane / words_per_variant
            let local = lane % words_per_variant
            let opening = local / EXTENSION_WORDS.downcast_truncate()
            let coefficient = local % EXTENSION_WORDS.downcast_truncate()
            let query = proof_load(
                self.proof,
                regions.fri_query_indices,
                variant,
            )
            let placement = fri_query_evaluation_from_four_rounds(
                ref placements,
                opening,
                query,
            )
            let source = if variant == 0 {
                regions.fri_clean
            } else {
                regions.fri_observed
            }
            let placement_valid = placement.valid
                && (placement.evaluation_index
                    < FRI_EVALUATIONS.downcast_truncate())
            let value = if placement_valid {
                proof_load(
                    self.proof,
                    source,
                    placement.evaluation_index
                        * EXTENSION_WORDS.downcast_truncate() + coefficient,
                )
            } else {
                0
            }
            proof_store(
                self.proof,
                regions.fri_query_evaluations,
                lane,
                value,
            )
            fri_scratch_store(
                self.fri_scratch,
                FRI_QUERY_COPY_VALID_START,
                lane,
                if placement_valid && value < BABY_BEAR_MODULUS { 1 } else { 0 },
            )
        } else if lane < evaluation_words + sibling_words {
            let placements = proof_fri_round_placements()
            let sibling_lane = lane - evaluation_words
            let words_per_variant: u32 =
                (FRI_QUERY_PATH_SIBLINGS * DIGEST_FIELDS).downcast_truncate()
            let variant = sibling_lane / words_per_variant
            let local = sibling_lane % words_per_variant
            let sibling = local / DIGEST_FIELDS.downcast_truncate()
            let field = local % DIGEST_FIELDS.downcast_truncate()
            let query = proof_load(
                self.proof,
                regions.fri_query_indices,
                variant,
            )
            let placement = fri_query_sibling_from_four_rounds(
                ref placements,
                sibling,
                query,
            )
            let node = tree_node(variant, 0, placement.tree_node)
            let placement_valid = placement.valid
                && (placement.tree_node
                    < FRI_TREE_NODES_PER_VARIANT.downcast_truncate())
                && fri_scratch_load(
                    self.fri_scratch,
                    FRI_TREE_VALID_START,
                    node,
                ) == 1
            let value = if placement_valid {
                fri_scratch_load(
                    self.fri_scratch,
                    FRI_TREE_START,
                    node * DIGEST_FIELDS.downcast_truncate() + field,
                )
            } else {
                0
            }
            proof_store(
                self.proof,
                regions.fri_query_siblings,
                sibling_lane,
                value,
            )
            fri_scratch_store(
                self.fri_scratch,
                FRI_QUERY_COPY_VALID_START,
                lane,
                if placement_valid && value < BABY_BEAR_MODULUS { 1 } else { 0 },
            )
        }
    }

    fn finalize_fri_schedule(self)
        uses (Prove<Threads<1, 1, 1>, Once<1, 1, 1>>)
    {
        let regions = proof_tape_regions()
        let status_layout = status_regions()
        let fri_layout = fri_status_regions()
        let query_layout = fri_query_status_regions()
        let valid = all_fri_schedule_valid(
            self.proof,
            subregion(regions.fri_status, fri_layout.challenge_valid),
            subregion(regions.fri_status, fri_layout.root_valid),
            subregion(regions.fri_status, fri_layout.transcript_valid),
            subregion(regions.fri_status, fri_layout.round_valid),
        ) && all_fri_progress_valid(self.fri_scratch)
            && all_fri_tree_nodes_valid(self.fri_scratch)
        let equal = fri_outputs_equal(
            self.proof,
            regions.fri_clean,
            regions.fri_observed,
        )
        let tampered = self.tamper >= 0.5
        let fri_correct = valid && if tampered { !equal } else { equal }
        let clean_query_valid = fri_query_opening_valid(
            self.proof,
            self.fri_scratch,
            0,
        )
        let observed_query_valid = fri_query_opening_valid(
            self.proof,
            self.fri_scratch,
            1,
        )
        let query_equal = fri_query_receipts_equal(self.proof)
        let query_valid = all_fri_query_progress_valid(self.fri_scratch)
            && clean_query_valid && observed_query_valid
        let query_correct = query_valid && if tampered {
            !query_equal
        } else {
            query_equal
        }
        let previous_correct = stored_flag(
            self.proof,
            subregion(regions.status, status_layout.mode_correct),
        )
        let overall = previous_correct && fri_correct && query_correct

        proof_store(
            self.proof,
            subregion(regions.fri_status, fri_layout.equal),
            0,
            if equal { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.fri_status, fri_layout.correct),
            0,
            if fri_correct { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.fri_status, fri_layout.color),
            0,
            status_word(fri_correct, tampered),
        )
        proof_store(
            self.proof,
            subregion(regions.fri_query_status, query_layout.opening_valid),
            0,
            if clean_query_valid { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.fri_query_status, query_layout.opening_valid),
            1,
            if observed_query_valid { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.fri_query_status, query_layout.equal),
            0,
            if query_equal { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.fri_query_status, query_layout.correct),
            0,
            if query_correct { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.fri_query_status, query_layout.color),
            0,
            status_word(query_correct, tampered),
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.mode_correct),
            0,
            if overall { 1 } else { 0 },
        )
        proof_store(
            self.proof,
            subregion(regions.status, status_layout.mode_color),
            0,
            status_word(overall, tampered),
        )
    }


    fn display(self, px: i32, py: i32) -> i32 uses (Display) {
        let regions = proof_tape_regions()
        let status_layout = status_regions()
        let fri_layout = fri_status_regions()
        let u = from_i32(px) / self.res
        let v = from_i32(py) / self.res
        let tampered = self.tamper >= 0.5

        if v < 0.18 {
            if u < 0.2 {
                return proof_load(
                    self.proof,
                    subregion(regions.status, status_layout.trace_color),
                    0,
                ).downcast_truncate()
            }
            if u < 0.4 {
                return proof_load(
                    self.proof,
                    subregion(regions.status, status_layout.lde_color),
                    0,
                ).downcast_truncate()
            }
            if u < 0.6 {
                return proof_load(
                    self.proof,
                    subregion(regions.status, status_layout.root_color),
                    0,
                ).downcast_truncate()
            }
            if u < 0.8 {
                return proof_load(
                    self.proof,
                    subregion(regions.fri_status, fri_layout.color),
                    0,
                ).downcast_truncate()
            }
            return proof_load(
                self.proof,
                subregion(regions.status, status_layout.mode_color),
                0,
            ).downcast_truncate()
        }
        if v > 0.82 {
            return proof_load(
                self.proof,
                subregion(regions.status, status_layout.mode_color),
                0,
            ).downcast_truncate()
        }

        let fri_evaluation_words: i32 =
            FRI_EVALUATION_WORDS.downcast_truncate()
        let sample_i = to_i32(
            u * from_i32(fri_evaluation_words),
        ).downcast_unchecked()
        let folded = if tampered {
            regions.fri_observed
        } else {
            regions.fri_clean
        }
        let sample = proof_load(self.proof, folded, sample_i)
        let red = 54 + (sample & 127)
        let green = 42 + ((sample >> 8) & 95)
        let blue = 96 + ((sample >> 16) & 127)
        let stripe = if u + v > 1.0 { 18 } else { 0 }
        let reject_glow = if tampered { 26 } else { 0 }
        packed_rgba(red + reject_glow, green + stripe, blue)
    }
}

fn all_lde_columns_valid(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, [u32; COLUMN_COUNT]>,
) -> bool {
    proof_load(tape, region, 0) == 1
        && proof_load(tape, region, 1) == 1
        && proof_load(tape, region, 2) == 1
        && proof_load(tape, region, 3) == 1
}

fn all_air_lde_columns_valid(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ status: Region<ProofTapeRegions, [u32; AIR_COLUMN_COUNT]>,
) -> bool {
    let mut valid: u32 = 1
    let mut column: u32 = 0
    while column < AIR_COLUMN_COUNT.downcast_truncate() {
        if proof_load(proof, status, column) != 1 {
            valid = 0
        }
        column = column + 1
    }
    valid == 1
}

fn all_composition_values_valid(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ status: Region<ProofTapeRegions, [u32; COMPOSITION_VALUE_VALID_WORDS]>,
) -> bool {
    let mut valid: u32 = 1
    let mut evaluation: u32 = 0
    while evaluation < LDE.downcast_truncate() {
        if proof_load(proof, status, evaluation) != 1 {
            valid = 0
        }
        evaluation = evaluation + 1
    }
    valid == 1
}

// Receipt validation is deliberately constant-work. Consume every public
// receipt word and combine explicit 0/1 masks rather than short-circuiting a
// boolean fold when an earlier word is invalid.
fn validation_word(_ value: bool) -> u32 {
    if value { 1 } else { 0 }
}

fn all_fri_schedule_valid(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ challenges: Region<ProofTapeRegions, [u32; FRI_VALID_ROUNDS]>,
    _ roots: Region<ProofTapeRegions, [u32; FRI_VALID_ROUNDS]>,
    _ transcripts: Region<ProofTapeRegions, [u32; FRI_VALID_TRANSCRIPTS]>,
    _ rounds: Region<ProofTapeRegions, [u32; FRI_VALID_ROUNDS]>,
) -> bool {
    let mut valid: u32 = 1
    let mut index: usize = 0
    while index < FRI_VALID_ROUNDS {
        let word: u32 = index.downcast_truncate()
        valid = valid & validation_word(proof_load(tape, challenges, word) == 1)
        valid = valid & validation_word(proof_load(tape, roots, word) == 1)
        valid = valid & validation_word(proof_load(tape, rounds, word) == 1)
        index = index + 1
    }
    index = 0
    while index < FRI_VALID_TRANSCRIPTS {
        valid = valid & validation_word(
            proof_load(tape, transcripts, index.downcast_truncate()) == 1,
        )
        index = index + 1
    }
    valid == 1
}

fn all_fri_progress_valid(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
) -> bool {
    let rounds: u32 = FRI_ROUNDS.downcast_truncate()
    let lanes: u32 = FRI_WORKGROUP_LANES.downcast_truncate()
    let mut valid: u32 = 1
    let mut round: u32 = 0
    while round < rounds {
        let expected = runtime_fri_round_schedule_steps(rounds - round - 1)
        let base = round * lanes
        let mut lane: u32 = 0
        while lane < lanes {
            valid = valid & validation_word(
                fri_scratch_load(scratch, FRI_PROGRESS_START, base + lane)
                    == expected,
            )
            lane = lane + 1
        }
        round = round + 1
    }
    valid == 1
}

fn all_fri_tree_nodes_valid(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
) -> bool {
    let nodes: u32 = (FRI_VARIANTS * FRI_TREE_NODES_PER_VARIANT)
        .downcast_truncate()
    let mut valid: u32 = 1
    let mut node: u32 = 0
    while node < nodes {
        valid = valid & validation_word(
            fri_scratch_load(scratch, FRI_TREE_VALID_START, node) == 1,
        )
        node = node + 1
    }
    valid == 1
}

fn all_fri_query_progress_valid(
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
) -> bool {
    let mut valid: u32 = 1
    let mut lane: u32 = 0
    while lane < FRI_QUERY_PROGRESS_WORDS.downcast_truncate() {
        valid = valid & validation_word(
            fri_scratch_load(scratch, FRI_QUERY_PROGRESS_START, lane)
                == FRI_QUERY_PLACEMENT_STEPS.downcast_truncate(),
        )
        lane = lane + 1
    }
    valid == 1
}

fn fri_query_opening_valid(
    _ proof: ProofTape<u32, PROOF_WORDS>,
    _ scratch: ProofTape<u32, FRI_SCRATCH_WORDS>,
    _ variant: u32,
) -> bool {
    let regions = proof_tape_regions()
    let query_status = fri_query_status_regions()
    let variants: u32 = FRI_VARIANTS.downcast_truncate()
    let safe_variant = if variant < variants { variant } else { 0 }
    let mut valid = validation_word(variant < variants)
    valid = valid & validation_word(
        proof_load(
            proof,
            subregion(regions.fri_query_status, query_status.index_valid),
            safe_variant,
        ) == 1,
    )
    let query = proof_load(proof, regions.fri_query_indices, safe_variant)
    valid = valid & validation_word(query < FRI_MAX_OUTPUT.downcast_truncate())
    let evaluation_words: u32 =
        (FRI_QUERY_EVALUATIONS * EXTENSION_WORDS).downcast_truncate()
    let evaluation_base = safe_variant * evaluation_words
    let mut word: u32 = 0
    while word < evaluation_words {
        valid = valid & validation_word(
            fri_scratch_load(
                scratch,
                FRI_QUERY_COPY_VALID_START,
                evaluation_base + word,
            ) == 1,
        )
        word = word + 1
    }
    let sibling_words: u32 =
        (FRI_QUERY_PATH_SIBLINGS * DIGEST_FIELDS).downcast_truncate()
    let evaluation_total: u32 =
        FRI_QUERY_EVALUATION_WORDS.downcast_truncate()
    let sibling_base = evaluation_total + safe_variant * sibling_words
    word = 0
    while word < sibling_words {
        valid = valid & validation_word(
            fri_scratch_load(
                scratch,
                FRI_QUERY_COPY_VALID_START,
                sibling_base + word,
            ) == 1,
        )
        word = word + 1
    }
    valid == 1
}

fn fri_query_receipts_equal(
    _ proof: ProofTape<u32, PROOF_WORDS>,
) -> bool {
    let regions = proof_tape_regions()
    let mut equal = validation_word(
        proof_load(proof, regions.fri_query_indices, 0)
            == proof_load(proof, regions.fri_query_indices, 1),
    )
    let evaluation_words: u32 =
        (FRI_QUERY_EVALUATIONS * EXTENSION_WORDS).downcast_truncate()
    let mut word: u32 = 0
    while word < evaluation_words {
        equal = equal & validation_word(
            proof_load(proof, regions.fri_query_evaluations, word)
                == proof_load(
                proof,
                regions.fri_query_evaluations,
                evaluation_words + word,
            ),
        )
        word = word + 1
    }
    let sibling_words: u32 =
        (FRI_QUERY_PATH_SIBLINGS * DIGEST_FIELDS).downcast_truncate()
    word = 0
    while word < sibling_words {
        equal = equal & validation_word(
            proof_load(proof, regions.fri_query_siblings, word)
                == proof_load(
                proof,
                regions.fri_query_siblings,
                sibling_words + word,
            ),
        )
        word = word + 1
    }
    equal == 1
}

fn fri_outputs_equal(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ left: Region<ProofTapeRegions, [u32; FRI_EVALUATION_WORDS]>,
    _ right: Region<ProofTapeRegions, [u32; FRI_EVALUATION_WORDS]>,
) -> bool {
    let mut equal: u32 = 1
    let mut word: usize = 0
    while word < FRI_EVALUATION_WORDS {
        let index: u32 = word.downcast_truncate()
        equal = equal & validation_word(
            proof_load(tape, left, index) == proof_load(tape, right, index),
        )
        word = word + 1
    }
    equal == 1
}

fn stored_flag(
    _ tape: ProofTape<u32, PROOF_WORDS>,
    _ region: Region<ProofTapeRegions, u32>,
) -> bool {
    let word: i32 = proof_load(tape, region, 0).downcast_truncate()
    word == 1
}
