const HASH_STAGE_STEPS: usize =
    <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::STEPS
const AIR_ROW_HASH_STATES: usize = LDE
const AIR_ROW_HASH_LANES: usize = AIR_ROW_HASH_STATES * POSEIDON_LANES
const MAIN_LDE_ROW_PERMUTATIONS: usize =
    fixed_length_sponge_permutations(MAIN_COLUMN_COUNT)
const AUXILIARY_LDE_ROW_PERMUTATIONS: usize =
    fixed_length_sponge_permutations(AUXILIARY_ROW_BITS)
const MAIN_LDE_ROW_SCHEDULE_STEPS: usize =
    MAIN_LDE_ROW_PERMUTATIONS * HASH_STAGE_STEPS
const AUXILIARY_LDE_ROW_SCHEDULE_STEPS: usize =
    AUXILIARY_LDE_ROW_PERMUTATIONS * HASH_STAGE_STEPS
const AIR_LDE_TREE_LEVELS: usize = 4
const AIR_LDE_TREE_LEVEL_STEPS: usize = 1 + HASH_STAGE_STEPS
const AIR_LDE_TREE_SCHEDULE_STEPS: usize =
    AIR_LDE_TREE_LEVELS * AIR_LDE_TREE_LEVEL_STEPS
const TRACE_HASH_STATES: usize = 2 * TRACE + 1
const TRACE_HASH_LANES: usize = TRACE_HASH_STATES * POSEIDON_LANES
const TRACE_COMMITMENT_PERMUTATIONS: usize = 2
const TRACE_COMMITMENT_SCHEDULE_STEPS: usize =
    TRACE_COMMITMENT_PERMUTATIONS * HASH_STAGE_STEPS
const TRACE_TREE_LEVELS: usize = 2
const TRACE_TREE_SCHEDULE_STEPS: usize =
    TRACE_TREE_LEVELS * AIR_LDE_TREE_LEVEL_STEPS
const AIR_TRANSCRIPT_BINDINGS: usize = 4
const AIR_TRANSCRIPT_BINDING_STEPS: usize = 1 + 3 * HASH_STAGE_STEPS
const AIR_TRANSCRIPT_SCHEDULE_STEPS: usize =
    AIR_TRANSCRIPT_BINDINGS * AIR_TRANSCRIPT_BINDING_STEPS
const FRI_CHALLENGE_PLACEMENT_STEPS: usize = 1 + 2 * HASH_STAGE_STEPS
const COMPOSITION_CHALLENGE_SCHEDULE_STEPS: usize =
    FRI_CHALLENGE_PLACEMENT_STEPS
const COMPOSITION_LEAF_SCHEDULE_STEPS: usize = HASH_STAGE_STEPS
const COMPOSITION_TREE_SCHEDULE_STEPS: usize = AIR_LDE_TREE_SCHEDULE_STEPS
const COMPOSITION_TRANSCRIPT_SCHEDULE_STEPS: usize =
    AIR_TRANSCRIPT_BINDING_STEPS
const FRI_LEAF_PLACEMENT_STEPS: usize = 1 + HASH_STAGE_STEPS
const FRI_BINDING_PLACEMENT_STEPS: usize = 1 + 3 * HASH_STAGE_STEPS
const FRI_QUERY_PLACEMENT_STEPS: usize = 1 + 2 * HASH_STAGE_STEPS

const fn fri_round_schedule_steps(_ tree_depth: usize) -> usize {
    FRI_CHALLENGE_PLACEMENT_STEPS
        + 1
        + FRI_LEAF_PLACEMENT_STEPS
        + tree_depth * FRI_LEAF_PLACEMENT_STEPS
        + FRI_BINDING_PLACEMENT_STEPS
}

const fn runtime_fri_round_schedule_steps(_ tree_depth: u32) -> u32 {
    let challenge: u32 = FRI_CHALLENGE_PLACEMENT_STEPS.downcast_truncate()
    let leaf: u32 = FRI_LEAF_PLACEMENT_STEPS.downcast_truncate()
    let binding: u32 = FRI_BINDING_PLACEMENT_STEPS.downcast_truncate()
    challenge + 1 + leaf + tree_depth * leaf + binding
}

