//! Nine points decide a quadric. Sometimes they abstain.
//!
//! This ingot is the non-rendering QCGA model behind the canonical
//! `qcga_pencil_de` actor: named algebra, point embedding, linear solve,
//! control-point editing, camera policy, and one shared material are ordinary
//! Fe. The browser knows none of those concepts.
//!
//! The algebraic statement is compact. `QcgaBasis` declares three positive
//! generators and six nominal null pairs. Point and dual-quadric coefficient
//! records declare their sparse supports by field name. One
//! `CompileNamedVectorDotF32<PointCoefficients,
//! QcgaDualQuadricCoefficients, QcgaMetric>` expands incidence into
//! straight-line arithmetic; no generator IDs, masks, sign table, or
//! demo-local compiler appears here.
//!
//! Because point/quadric incidence is linear in the ten dual-quadric
//! coefficients, “quadrics through nine points” is exactly the nullspace of a
//! 9 x 10 incidence matrix. The solver constructs every matrix entry with that
//! same generated incidence evaluator. Nine generic points give rank nine and
//! one projective quadric. The chosen nine points lie on the intersection of a
//! sphere and cone, impose only eight independent conditions, and leave a
//! two-dimensional nullspace: a projective pencil containing cylinders,
//! spheres, cones, plane pairs, and hyperboloids. Move one point off the curve
//! and the freedom closes. No nonlinear fitting or separate polynomial table
//! is involved.
//!
//! The sole shipped GPU view is the iterative fragment-surface DE actor in
//! `qcga_pencil_de`. The radial projection code retained below is a historical
//! zero-import CPU/Wasm oracle for geometry and topology; it is deliberately
//! not an actor, gallery tile, or alternate renderer. Its names and comments
//! say “oracle” wherever that distinction matters.
//!
//! No parallel-execution claim is made: FCO removes runtime algebra structure
//! and exposes straight-line work inside one invocation, but it does not spawn
//! GPU lanes. Browser GPU availability remains an external execution fact.

use core::marker::Copy
use core::AllocatedBrowserBytes
use core::effect_ref::alloc_bytes
use core::num::IntDowncast
use std::webgpu::{
    ClipPosition,
    RasterVertex,
}
use std::web::view::{
    ApplyParamBindings,
    Extent,
    Param,
    ParamBindingsProvider,
    Surface,
    SurfaceEvent,
    SurfaceState,
}
use ga_expr::{
    BasisMetric, CompileNamedVectorDotF32, EvaluateVectorScalarF32,
    Null, Positive, Prime,
}
use fmath::{
    PI, TAU, Vec3, abs, clamp01, cos, dot3, from_i32, max, min,
    mix, normalize3, rgba, sin, sqrt, vec3,
}
use gallery_palette::{
    clean_white, electric_blue, evidence_gold, spring_green, theorem_gold,
}

extern {
    const fn __bitcast<From, To>(_: From) -> To
}

// ---------------------------------------------------------------------------
// Named structural QCGA incidence.
//
// The metric and expression below are ordinary Fe type data consumed by the
// shared `ga_expr` named-vector-dot provider. The basis and two coefficient
// record types are the complete authoring surface; FCO derives dimension,
// support alignment, pair routing, signs, and balanced scalar arithmetic.
// ---------------------------------------------------------------------------

struct Pair1 {}
struct Pair2 {}
struct Pair3 {}
struct Pair4 {}
struct Pair5 {}
struct Pair6 {}
struct QcgaBasis {
    e1: Positive, e2: Positive, e3: Positive,
    eo1: Null<Pair1>, eo2: Null<Pair2>, eo3: Null<Pair3>,
    eo4: Null<Pair4>, eo5: Null<Pair5>, eo6: Null<Pair6>,
    ei1: Prime<Pair1>, ei2: Prime<Pair2>, ei3: Prime<Pair3>,
    ei4: Prime<Pair4>, ei5: Prime<Pair5>, ei6: Prime<Pair6>,
}
type QcgaMetric = BasisMetric<QcgaBasis>

// Field presence states sparse support. Field order need not match basis order;
// the provider aligns each coefficient to the basis by reflected field name.
struct QcgaPointCoefficients {
    e1: f32, e2: f32, e3: f32,
    eo1: f32, eo2: f32, eo3: f32,
    ei1: f32, ei2: f32, ei3: f32, ei4: f32, ei5: f32, ei6: f32,
}
struct QcgaDualQuadricCoefficients {
    e1: f32, e2: f32, e3: f32,
    eo1: f32, eo2: f32, eo3: f32, eo4: f32, eo5: f32, eo6: f32,
    ei1: f32, ei2: f32, ei3: f32,
}
struct SparseIncidenceOperands {
    point: QcgaPointCoefficients,
    quadric: QcgaDualQuadricCoefficients,
}

derive EvaluateVectorScalarF32 for SparseIncidenceOperands using CompileNamedVectorDotF32<
    QcgaPointCoefficients, QcgaDualQuadricCoefficients, QcgaMetric,
>

fn embed_qcga_point(x: f32, y: f32, z: f32) -> QcgaPointCoefficients {
    let half: f32 = 0.5
    QcgaPointCoefficients {
        e1: x, e2: y, e3: z,
        eo1: 1.0, eo2: 1.0, eo3: 1.0,
        ei1: x * x * half, ei2: y * y * half, ei3: z * z * half,
        ei4: x * y, ei5: x * z, ei6: y * z,
    }
}

fn embed_qcga_dual_quadric(
    a: f32, b: f32, c: f32, d: f32, e: f32,
    f: f32, g: f32, h: f32, i: f32, j: f32,
) -> QcgaDualQuadricCoefficients {
    let negative_j_third: f32 = 0.0 - j / 3.0
    QcgaDualQuadricCoefficients {
        e1: g, e2: h, e3: i,
        eo1: -2.0 * a, eo2: -2.0 * b, eo3: -2.0 * c,
        eo4: -d, eo5: -e, eo6: -f,
        ei1: negative_j_third, ei2: negative_j_third, ei3: negative_j_third,
    }
}

pub fn qcga3d_incidence(
    x: f32, y: f32, z: f32,
    a: f32, b: f32, c: f32, d: f32, e: f32,
    f: f32, g: f32, h: f32, i: f32, j: f32,
) -> f32 {
    <SparseIncidenceOperands as EvaluateVectorScalarF32>::scalar(SparseIncidenceOperands {
        point: embed_qcga_point(x, y, z),
        quadric: embed_qcga_dual_quadric(a, b, c, d, e, f, g, h, i, j),
    })
}

// ---------------------------------------------------------------------------
// Dual quadrics as values.
// ---------------------------------------------------------------------------

/// The ten coefficients of a dual quadric, in the demo-wide canonical order:
/// a x^2 + b y^2 + c z^2 + d xy + e xz + f yz + g x + h y + i z + j.
pub struct Quadric {
    pub a: f32, pub b: f32, pub c: f32, pub d: f32, pub e: f32,
    pub f: f32, pub g: f32, pub h: f32, pub i: f32, pub j: f32,
}
impl Copy for Quadric {}

/// Point/quadric incidence through the FCO-generated named-basis dot product.
/// Every use of "does this point lie on this surface" in this ingot flows
/// through here; there is no second polynomial evaluation path to drift from.
pub fn eval_quadric(_ q: Quadric, _ x: f32, _ y: f32, _ z: f32) -> f32 {
    qcga3d_incidence(
        x: x, y: y, z: z,
        a: q.a, b: q.b, c: q.c, d: q.d, e: q.e,
        f: q.f, g: q.g, h: q.h, i: q.i, j: q.j,
    )
}

// ---------------------------------------------------------------------------
// Mesh, camera, and shading constants. All template geometry is derived from
// the vertex index; there is no vertex buffer to bake and no mesh asset.
// ---------------------------------------------------------------------------

pub const ROWS: u32 = 24
pub const COLS: u32 = 48
/// Six vertices (two triangles) per grid quad, one full direction sphere per
/// sheet.
pub const SHEET_VERTS: u32 = ROWS * COLS * 6
/// Sheet 0 takes the nearer positive root along each direction, sheet 1 the
/// farther one, so closed surfaces (which show one positive root per
/// direction from an interior centre) collapse sheet 1 instead of
/// double-covering.
pub const VERTEX_COUNT: u32 = 2 * SHEET_VERTS
/// Six screen-facing vertices for each of the nine editable constraints.
pub const CONTROL_VERTEX_COUNT: u32 = 9 * 6
/// Size of the retained historical projection oracle: analytic surface plus
/// control markers. The live gallery renderer is the distance estimator.
pub const ORACLE_SCENE_VERTEX_COUNT: u32 = VERTEX_COUNT + CONTROL_VERTEX_COUNT
pub const PENCIL_RESOLUTION: f32 = 512.0

static_assert(SHEET_VERTS == 6912)
static_assert(VERTEX_COUNT == 13824)
static_assert(ORACLE_SCENE_VERTEX_COUNT == 13878)

/// Roots below this parameter are treated as the centre itself, not a hit.
pub const T_MIN: f32 = 0.001
/// Truncation radius for unbounded members (hyperboloids, planes): the drawn
/// surface is honestly a clip of the infinite one, and the copy says so.
pub const T_MAX: f32 = 12.0

const NEAR: f32 = 0.25
const FAR: f32 = 64.0
const FOCAL: f32 = 1.6

// Fixed world-space light direction, approximately unit length.
const LX: f32 = 0.37
const LY: f32 = 0.82
const LZ: f32 = 0.44

// ---------------------------------------------------------------------------
// The actor's state records and the typed behavior handoff.
// ---------------------------------------------------------------------------

/// The nine dragged control points, the actor's primary owned state.
pub struct ControlPoints {
    pub p0x: f32, pub p0y: f32, pub p0z: f32,
    pub p1x: f32, pub p1y: f32, pub p1z: f32,
    pub p2x: f32, pub p2y: f32, pub p2z: f32,
    pub p3x: f32, pub p3y: f32, pub p3z: f32,
    pub p4x: f32, pub p4y: f32, pub p4z: f32,
    pub p5x: f32, pub p5y: f32, pub p5z: f32,
    pub p6x: f32, pub p6y: f32, pub p6z: f32,
    pub p7x: f32, pub p7y: f32, pub p7z: f32,
    pub p8x: f32, pub p8y: f32, pub p8z: f32,
}
impl Copy for ControlPoints {}

/// One world-space constraint point. The public/oracle wire format stays flat,
/// while interaction code uses this nominal value instead of coordinating
/// three unrelated scalars.
pub struct ControlPoint {
    pub x: f32,
    pub y: f32,
    pub z: f32,
}
impl Copy for ControlPoint {}

/// Closed identity of the actively dragged constraint. There are no browser
/// IDs or magic sentinels: the compiler derives the Wasm tag and validates it
/// at the resident state boundary.
pub enum PickedControl {
    None,
    P0,
    P1,
    P2,
    P3,
    P4,
    P5,
    P6,
    P7,
    P8,
}
impl Copy for PickedControl {}

pub fn control_point(_ points: ControlPoints, _ picked: PickedControl) -> ControlPoint {
    match picked {
        PickedControl::P0 => ControlPoint { x: points.p0x, y: points.p0y, z: points.p0z },
        PickedControl::P1 => ControlPoint { x: points.p1x, y: points.p1y, z: points.p1z },
        PickedControl::P2 => ControlPoint { x: points.p2x, y: points.p2y, z: points.p2z },
        PickedControl::P3 => ControlPoint { x: points.p3x, y: points.p3y, z: points.p3z },
        PickedControl::P4 => ControlPoint { x: points.p4x, y: points.p4y, z: points.p4z },
        PickedControl::P5 => ControlPoint { x: points.p5x, y: points.p5y, z: points.p5z },
        PickedControl::P6 => ControlPoint { x: points.p6x, y: points.p6y, z: points.p6z },
        PickedControl::P7 => ControlPoint { x: points.p7x, y: points.p7y, z: points.p7z },
        PickedControl::P8 => ControlPoint { x: points.p8x, y: points.p8y, z: points.p8z },
        PickedControl::None => ControlPoint { x: 0.0, y: 0.0, z: 0.0 },
    }
}

/// The historical projection oracle uses its generated vertex index directly;
/// the browser-facing selection lane retains its closed `PickedControl` type.
pub fn control_point_at_index(_ points: ControlPoints, _ index: u32) -> ControlPoint {
    if index == 0 { return ControlPoint { x: points.p0x, y: points.p0y, z: points.p0z } }
    if index == 1 { return ControlPoint { x: points.p1x, y: points.p1y, z: points.p1z } }
    if index == 2 { return ControlPoint { x: points.p2x, y: points.p2y, z: points.p2z } }
    if index == 3 { return ControlPoint { x: points.p3x, y: points.p3y, z: points.p3z } }
    if index == 4 { return ControlPoint { x: points.p4x, y: points.p4y, z: points.p4z } }
    if index == 5 { return ControlPoint { x: points.p5x, y: points.p5y, z: points.p5z } }
    if index == 6 { return ControlPoint { x: points.p6x, y: points.p6y, z: points.p6z } }
    if index == 7 { return ControlPoint { x: points.p7x, y: points.p7y, z: points.p7z } }
    ControlPoint { x: points.p8x, y: points.p8y, z: points.p8z }
}

fn control_points_array(_ points: ControlPoints) -> [f32; 27] {
    [
        points.p0x, points.p0y, points.p0z,
        points.p1x, points.p1y, points.p1z,
        points.p2x, points.p2y, points.p2z,
        points.p3x, points.p3y, points.p3z,
        points.p4x, points.p4y, points.p4z,
        points.p5x, points.p5y, points.p5z,
        points.p6x, points.p6y, points.p6z,
        points.p7x, points.p7y, points.p7z,
        points.p8x, points.p8y, points.p8z,
    ]
}

fn control_points_from_request(_ request: SolveRequest) -> ControlPoints {
    ControlPoints {
        p0x: request.p0x, p0y: request.p0y, p0z: request.p0z,
        p1x: request.p1x, p1y: request.p1y, p1z: request.p1z,
        p2x: request.p2x, p2y: request.p2y, p2z: request.p2z,
        p3x: request.p3x, p3y: request.p3y, p3z: request.p3z,
        p4x: request.p4x, p4y: request.p4y, p4z: request.p4z,
        p5x: request.p5x, p5y: request.p5y, p5z: request.p5z,
        p6x: request.p6x, p6y: request.p6y, p6z: request.p6z,
        p7x: request.p7x, p7y: request.p7y, p7z: request.p7z,
        p8x: request.p8x, p8y: request.p8y, p8z: request.p8z,
    }
}

/// The small interactive view of the solved frame. FCO derives its
/// field-complete browser transition; neither source nor host maintains
/// numeric control IDs.
pub struct PencilControls {
    /// Pencil parameter. The blend weights are cos(PI*lambda), sin(PI*lambda),
    /// so [0,1] sweeps the full projective pencil line and returns to the
    /// starting surface (with flipped sign, the same quadric).
    pub lambda: f32,
    pub yaw: f32,
    pub pitch: f32,
    pub dist: f32,
}
impl Copy for PencilControls {}

/// Immutable result of the incidence solve. Navigation replaces only the
/// sibling `PencilControls` value, so the ownership split prevents view input
/// from accidentally rewriting the certified pencil basis.
pub struct PencilBasis {
    pub generation: u32,
    /// Projection centre: the centroid of the nine constraint points.
    pub cx: f32,
    pub cy: f32,
    pub cz: f32,
    /// 1.0 when the solver found rank <= 8 (the pencil is unlocked), else 0.0.
    /// This is algebraic evidence exposed to the renderer, not a hue switch.
    pub pencil_free: f32,
    pub a0: f32, pub b0: f32, pub c0: f32, pub d0: f32, pub e0: f32,
    pub f0: f32, pub g0: f32, pub h0: f32, pub i0: f32, pub j0: f32,
    pub a1: f32, pub b1: f32, pub c1: f32, pub d1: f32, pub e1: f32,
    pub f1: f32, pub g1: f32, pub h1: f32, pub i1: f32, pub j1: f32,
}
impl Copy for PencilBasis {}

/// The Fe-owned state shared by the live distance estimator and the retained
/// projection oracle. Its two nominal subrecords keep mutable presentation
/// state distinct from the solved mathematical certificate.
pub struct PencilFrame {
    pub view: PencilControls,
    pub basis: PencilBasis,
}
impl Copy for PencilFrame {}

pub struct PencilParams {
    pub lambda: Param,
    pub yaw: Param,
    pub pitch: Param,
    pub dist: Param,
}

impl SurfaceState for PencilControls {
    type Params = PencilParams
}

derive ApplyParamBindings for PencilControls using ParamBindingsProvider

pub const fn pencil_params() -> PencilParams {
    PencilParams {
        lambda: Param::unit(init: 0.15),
        yaw: Param::angle(init: 0.6).drag_x(per_px: 0.008),
        pitch: Param::range(min: -1.45, max: 1.45, init: 0.35)
            .drag_y(per_px: 0.008),
        dist: Param::log(min: 1.5, max: 12.0, init: 4.0)
            .wheel_scale(in_factor: 0.88, out_factor: 1.14),
    }
}

/// The canonical distance-estimator surface declaration.
pub const fn pencil_view() -> Surface<PencilParams> {
    Surface {
        extent: Extent::square(512),
        params: pencil_params(),
    }
}

/// The current pencil member. The blend happens on COEFFICIENTS, which is the
/// same thing as blending incidence values only because the QCGA contraction
/// is linear in the dual quadric; the acceptance test checks that equality
/// rather than assuming it.
pub fn pencil_member(_ frame: PencilFrame) -> Quadric {
    let th: f32 = PI * frame.view.lambda
    let w0: f32 = cos(th)
    let w1: f32 = sin(th)
    Quadric {
        a: w0 * frame.basis.a0 + w1 * frame.basis.a1,
        b: w0 * frame.basis.b0 + w1 * frame.basis.b1,
        c: w0 * frame.basis.c0 + w1 * frame.basis.c1,
        d: w0 * frame.basis.d0 + w1 * frame.basis.d1,
        e: w0 * frame.basis.e0 + w1 * frame.basis.e1,
        f: w0 * frame.basis.f0 + w1 * frame.basis.f1,
        g: w0 * frame.basis.g0 + w1 * frame.basis.g1,
        h: w0 * frame.basis.h0 + w1 * frame.basis.h1,
        i: w0 * frame.basis.i0 + w1 * frame.basis.i1,
        j: w0 * frame.basis.j0 + w1 * frame.basis.j1,
    }
}

/// Historical nominal payload between the projection and material oracles.
/// It remains useful as an independent regression lane; the live distance
/// estimator computes its own hit and normal instead of interpolating this.
pub struct SurfaceVarying {
    pub nx: f32,
    pub ny: f32,
    pub nz: f32,
    /// Approaches 1 as the radial discriminant approaches zero: the tear line
    /// along the asymptotic cone announces itself.
    pub glow: f32,
    /// 0.0 for the near sheet, 1.0 for the far sheet.
    pub sheet: f32,
    /// 1.0 when this sample failed its own incidence receipt (beyond the f32
    /// cancellation budget at its distance). The oracle material makes the
    /// failure visible; acceptance tests require honest frames to remain zero.
    pub accuse: f32,
    /// 1.0 for a screen-facing editable constraint marker, 0.0 for the
    /// analytic surface. This remains a typed varying, not a second pipeline.
    pub marker: f32,
}
impl Copy for SurfaceVarying {}

/// Full radial-projection evidence for the independent verification lanes.
/// `SurfaceVarying` is the smaller historical material payload projected from
/// it.
pub struct SurfaceSample {
    pub x: f32,
    pub y: f32,
    pub z: f32,
    pub w: f32,
    pub nx: f32,
    pub ny: f32,
    pub nz: f32,
    pub glow: f32,
    pub sheet: f32,
    pub accuse: f32,
    /// Radial hit parameter, -1.0 on a miss.
    pub t: f32,
    /// World-space hit point (all zero on a miss).
    pub hx: f32,
    pub hy: f32,
    pub hz: f32,
    /// This sample's own generated incidence receipt against the current
    /// pencil member. Near zero on every honest hit.
    pub residual: f32,
    /// Discriminant of the radial quadratic; approaches zero at the tear.
    pub disc: f32,
    pub missed: u32,
}
impl Copy for SurfaceSample {}

fn miss_sample(_ sheet: f32, _ disc: f32) -> SurfaceSample {
    // z = 2, w = 1 lies outside 0 <= z <= w, so the rasterizer clips the
    // vertex; a torn triangle is dropped rather than smoothed over.
    SurfaceSample {
        x: 0.0, y: 0.0, z: 2.0, w: 1.0,
        nx: 0.0, ny: 0.0, nz: 0.0,
        glow: 0.0, sheet, accuse: 0.0,
        t: -1.0, hx: 0.0, hy: 0.0, hz: 0.0,
        residual: 0.0, disc, missed: 1,
    }
}

pub struct ProjectedPoint {
    pub position: ClipPosition,
    /// Positive camera-space depth, used by both screen picking and inverse
    /// camera-plane dragging.
    pub depth: f32,
}
impl Copy for ProjectedPoint {}

/// One camera projection construction shared by analytic vertices, marker
/// vertices, hit testing, and inverse drag scaling.
pub fn project_point(_ point: ControlPoint, _ frame: PencilFrame) -> ProjectedPoint {
    let wx: f32 = point.x - frame.basis.cx
    let wy: f32 = point.y - frame.basis.cy
    let wz: f32 = point.z - frame.basis.cz
    let cyaw: f32 = cos(frame.view.yaw)
    let syaw: f32 = sin(frame.view.yaw)
    let cpit: f32 = cos(frame.view.pitch)
    let spit: f32 = sin(frame.view.pitch)
    let rx: f32 = cyaw * wx + syaw * wz
    let rz0: f32 = cyaw * wz - syaw * wx
    let ry: f32 = cpit * wy - spit * rz0
    let rz: f32 = spit * wy + cpit * rz0
    let depth: f32 = rz + frame.view.dist
    ProjectedPoint {
        position: ClipPosition {
            x: rx * FOCAL,
            y: ry * FOCAL,
            z: (depth * FAR - FAR * NEAR) / (FAR - NEAR),
            w: depth,
        },
        depth: depth,
    }
}

/// A world-space ray exactly inverse to `project_point`'s orbit camera. Both
/// QCGA views therefore share one camera model rather than keeping a raster
/// matrix and a visually similar raymarch camera in sync by convention.
pub struct PencilRay {
    pub origin: Vec3,
    pub direction: Vec3,
}
impl Copy for PencilRay {}

pub fn pencil_ray(_ frame: PencilFrame, _ u: f32, _ v: f32) -> PencilRay {
    let cyaw: f32 = cos(frame.view.yaw)
    let syaw: f32 = sin(frame.view.yaw)
    let cpit: f32 = cos(frame.view.pitch)
    let spit: f32 = sin(frame.view.pitch)

    // Camera-space origin (0, 0, -dist), transformed back to world space.
    let origin: Vec3 = vec3(
        frame.basis.cx + syaw * cpit * frame.view.dist,
        frame.basis.cy - spit * frame.view.dist,
        frame.basis.cz - cyaw * cpit * frame.view.dist,
    )

    // Camera-space ray (u / focal, v / focal, 1), inverse pitch then yaw.
    let rx: f32 = u / FOCAL
    let ry: f32 = v / FOCAL
    let rz: f32 = 1.0
    let wy: f32 = cpit * ry + spit * rz
    let rz0: f32 = 0.0 - spit * ry + cpit * rz
    let wx: f32 = cyaw * rx - syaw * rz0
    let wz: f32 = syaw * rx + cyaw * rz0
    PencilRay {
        origin: origin,
        direction: normalize3(vec3(wx, wy, wz)),
    }
}

/// Historical per-vertex QCGA projection onto the current pencil member.
///
/// Per vertex: decode the template direction from the vertex index; three
/// generated incidences determine the exact quadratic q(c + t d) along the
/// radial line; the stable root pair picks this sheet's parameter; six more
/// incidences give the exact surface normal (central differences are exact on
/// a quadric); one final incidence is the emitted point's own receipt. FCO
/// erases the named-basis dot products to ordinary scalar arithmetic.
fn sample_vertex(_ vid: u32, _ frame: PencilFrame) -> SurfaceSample {
    let sheet: u32 = vid / SHEET_VERTS
    let sheet_f: f32 = from_i32(sheet.downcast_truncate())
    let rem: u32 = vid % SHEET_VERTS
    let quad: u32 = rem / 6
    let corner: u32 = rem % 6
    let band: u32 = quad / COLS
    let col: u32 = quad % COLS

    // Quad corners: triangle 0 is (0,0) (1,0) (0,1), triangle 1 is
    // (0,1) (1,0) (1,1).
    let mut dr: u32 = 0
    let mut dc: u32 = 0
    if corner == 1 { dr = 1 }
    if corner == 2 { dc = 1 }
    if corner == 3 { dc = 1 }
    if corner == 4 { dr = 1 }
    if corner == 5 {
        dr = 1
        dc = 1
    }

    // Template unit direction from the (band, col) lattice. The longitude seam
    // closes only to the accuracy of the polynomial sin/cos in fmath; that
    // hairline is a property of the arithmetic and is left visible.
    let theta: f32 =
        PI * from_i32((band + dr).downcast_truncate())
            / from_i32(ROWS.downcast_truncate())
    let phi: f32 =
        TAU * from_i32((col + dc).downcast_truncate())
            / from_i32(COLS.downcast_truncate())
    let st: f32 = sin(theta)
    let dx: f32 = st * cos(phi)
    let dy: f32 = cos(theta)
    let dz: f32 = st * sin(phi)

    // The radial constraint: q(c + t d) is EXACTLY alpha t^2 + beta t + qc,
    // and three generated incidence evaluations pin all three coefficients.
    let q: Quadric = pencil_member(frame)
    let qc: f32 = eval_quadric(q, frame.basis.cx, frame.basis.cy, frame.basis.cz)
    let qp: f32 = eval_quadric(q, frame.basis.cx + dx, frame.basis.cy + dy, frame.basis.cz + dz)
    let qm: f32 = eval_quadric(q, frame.basis.cx - dx, frame.basis.cy - dy, frame.basis.cz - dz)
    let alpha: f32 = (qp + qm) * 0.5 - qc
    let beta: f32 = (qp - qm) * 0.5

    let mut hit: u32 = 0
    let mut t_near: f32 = -1.0
    let mut t_far: f32 = -1.0
    let mut disc: f32 = 0.0
    if abs(alpha) < 0.0000001 {
        // Degenerate member (planes and near-planes): the constraint is linear
        // along the ray.
        if abs(beta) >= 0.0000001 {
            let t_lin: f32 = -qc / beta
            if t_lin > T_MIN {
                hit = 1
                t_near = t_lin
                t_far = t_lin
            }
        }
    } else {
        disc = beta * beta - 4.0 * alpha * qc
        if disc >= 0.0 {
            let root: f32 = sqrt(disc)
            let signed_root: f32 = if beta < 0.0 { -root } else { root }
            let qroot: f32 = -0.5 * (beta + signed_root)
            let mut ta: f32 = 0.0
            let mut tb: f32 = 0.0
            if abs(qroot) >= 0.0000001 {
                ta = qroot / alpha
                tb = qc / qroot
            }
            let lo: f32 = min(ta, tb)
            let hi: f32 = max(ta, tb)
            if hi > T_MIN {
                hit = 1
                t_far = hi
                t_near = if lo > T_MIN { lo } else { hi }
            }
        }
    }

    let mut t: f32 = t_near
    if sheet == 1 {
        // The far sheet exists only where the constraint supplies a second
        // visible root.
        t = if t_far > t_near { t_far } else { -1.0 }
    }
    if hit == 0 { t = -1.0 }
    if t > T_MAX { t = -1.0 }
    if t <= 0.0 { return miss_sample(sheet_f, disc) }

    let hx: f32 = frame.basis.cx + dx * t
    let hy: f32 = frame.basis.cy + dy * t
    let hz: f32 = frame.basis.cz + dz * t

    // The emitted point's own incidence receipt, through the same generated
    // dot product the solver used to build the constraint matrix.
    let residual: f32 = eval_quadric(q, hx, hy, hz)
    let accuse: f32 =
        if abs(residual) > 0.004 * (1.0 + t * t) { 1.0 } else { 0.0 }

    // Exact gradient: central differences with h = 1 are exact for a degree-2
    // polynomial, so six contractions give the true surface normal.
    let gx: f32 = (eval_quadric(q, hx + 1.0, hy, hz) - eval_quadric(q, hx - 1.0, hy, hz)) * 0.5
    let gy: f32 = (eval_quadric(q, hx, hy + 1.0, hz) - eval_quadric(q, hx, hy - 1.0, hz)) * 0.5
    let gz: f32 = (eval_quadric(q, hx, hy, hz + 1.0) - eval_quadric(q, hx, hy, hz - 1.0)) * 0.5
    let glen: f32 = sqrt(gx * gx + gy * gy + gz * gz)
    let ginv: f32 = if glen > 0.0000001 { 1.0 / glen } else { 0.0 }

    let disc_scale: f32 = beta * beta + 4.0 * abs(alpha * qc) + 0.000001
    let glow: f32 = clamp01(1.0 - (disc / disc_scale) * 5.0)

    let projected: ProjectedPoint = project_point(
        ControlPoint { x: hx, y: hy, z: hz },
        frame,
    )
    if projected.depth < NEAR { return miss_sample(sheet_f, disc) }

    SurfaceSample {
        x: projected.position.x,
        y: projected.position.y,
        z: projected.position.z,
        w: projected.position.w,
        nx: gx * ginv,
        ny: gy * ginv,
        nz: gz * ginv,
        glow,
        sheet: sheet_f,
        accuse,
        t, hx, hy, hz, residual, disc,
        missed: 0,
    }
}

// ---------------------------------------------------------------------------
// HISTORICAL CPU/WASM RADIAL-PROJECTION ORACLE.
//
// The live gallery surface is the distance estimator in `qcga_pencil_de`.
// This ordinary Fe value retains the earlier radial mesh construction only as
// independent semantic evidence for solver, projection, and material tests.
// ---------------------------------------------------------------------------

pub struct RadialProjectionOracle {
    /// Primary state: the nine dragged points.
    pub points: ControlPoints,
    /// Solved frame sampled by the projection and material oracle methods.
    pub frame: PencilFrame,
    /// Rank of the incidence system at the last resolve.
    pub rank: u32,
    /// Worst incidence receipt of the published basis at the last resolve.
    pub residual: f32,
}
impl Copy for RadialProjectionOracle {}

impl RadialProjectionOracle {
    /// Boot the oracle in the quirky state: nine points on the sphere-cone
    /// intersection curve, already resolved (rank 8, pencil unlocked).
    pub fn spawn() -> RadialProjectionOracle {
        let initial = defaults(request: DefaultsRequest { generation: 0 })
        let mut oracle = RadialProjectionOracle {
            points: ControlPoints {
                p0x: initial.p0x, p0y: initial.p0y, p0z: initial.p0z,
                p1x: initial.p1x, p1y: initial.p1y, p1z: initial.p1z,
                p2x: initial.p2x, p2y: initial.p2y, p2z: initial.p2z,
                p3x: initial.p3x, p3y: initial.p3y, p3z: initial.p3z,
                p4x: initial.p4x, p4y: initial.p4y, p4z: initial.p4z,
                p5x: initial.p5x, p5y: initial.p5y, p5z: initial.p5z,
                p6x: initial.p6x, p6y: initial.p6y, p6z: initial.p6z,
                p7x: initial.p7x, p7y: initial.p7y, p7z: initial.p7z,
                p8x: initial.p8x, p8y: initial.p8y, p8z: initial.p8z,
            },
            frame: PencilFrame {
                view: PencilControls {
                    lambda: 0.15,
                    yaw: 0.6, pitch: 0.35, dist: 4.0,
                },
                basis: PencilBasis {
                    generation: 0,
                    cx: 0.0, cy: 0.0, cz: 0.0,
                    pencil_free: 0.0,
                    a0: 0.0, b0: 0.0, c0: 0.0, d0: 0.0, e0: 0.0,
                    f0: 0.0, g0: 0.0, h0: 0.0, i0: 0.0, j0: 0.0,
                    a1: 0.0, b1: 0.0, c1: 0.0, d1: 0.0, e1: 0.0,
                    f1: 0.0, g1: 0.0, h1: 0.0, i1: 0.0, j1: 0.0,
                },
            },
            rank: 0,
            residual: 0.0,
        }
        oracle.resolve()
        oracle
    }

    /// Move one control point. The oracle immediately re-solves so it
    /// is never displayed in a state its own constraints do not certify.
    pub fn drag(mut self, _ index: u32, _ x: f32, _ y: f32, _ z: f32) {
        if index == 0 {
            self.points.p0x = x
            self.points.p0y = y
            self.points.p0z = z
        }
        if index == 1 {
            self.points.p1x = x
            self.points.p1y = y
            self.points.p1z = z
        }
        if index == 2 {
            self.points.p2x = x
            self.points.p2y = y
            self.points.p2z = z
        }
        if index == 3 {
            self.points.p3x = x
            self.points.p3y = y
            self.points.p3z = z
        }
        if index == 4 {
            self.points.p4x = x
            self.points.p4y = y
            self.points.p4z = z
        }
        if index == 5 {
            self.points.p5x = x
            self.points.p5y = y
            self.points.p5z = z
        }
        if index == 6 {
            self.points.p6x = x
            self.points.p6y = y
            self.points.p6z = z
        }
        if index == 7 {
            self.points.p7x = x
            self.points.p7y = y
            self.points.p7z = z
        }
        if index == 8 {
            self.points.p8x = x
            self.points.p8y = y
            self.points.p8z = z
        }
        self.resolve()
    }

    /// Message: sweep the pencil. Pure view state; no re-solve needed, and
    /// when rank == 9 the basis is degenerate so the sweep honestly does
    /// nothing.
    pub fn set_lambda(mut self, _ value: f32) {
        self.frame.view.lambda = value
    }

    /// Message: orbit the camera.
    pub fn orbit(mut self, _ yaw: f32, _ pitch: f32, _ dist: f32) {
        self.frame.view.yaw = yaw
        self.frame.view.pitch = pitch
        self.frame.view.dist = dist
    }

    /// Internal behavior: rebuild the derived state from the control points
    /// through the linear QCGA incidence solve.
    pub fn resolve(mut self) {
        let pts: [f32; 27] = [
            self.points.p0x, self.points.p0y, self.points.p0z,
            self.points.p1x, self.points.p1y, self.points.p1z,
            self.points.p2x, self.points.p2y, self.points.p2z,
            self.points.p3x, self.points.p3y, self.points.p3z,
            self.points.p4x, self.points.p4y, self.points.p4z,
            self.points.p5x, self.points.p5y, self.points.p5z,
            self.points.p6x, self.points.p6y, self.points.p6z,
            self.points.p7x, self.points.p7y, self.points.p7z,
            self.points.p8x, self.points.p8y, self.points.p8z,
        ]
        let solved: SolvedState = solve_points(pts)
        let sol: PencilSolution = solved.sol
        let q0: [f32; 10] = sol.q0
        let q1: [f32; 10] = sol.q1
        self.rank = sol.rank
        self.residual = sol.residual
        self.frame.basis.cx = solved.cx
        self.frame.basis.cy = solved.cy
        self.frame.basis.cz = solved.cz
        self.frame.basis.pencil_free = if sol.rank <= 8 { 1.0 } else { 0.0 }
        self.frame.basis.a0 = q0[0]
        self.frame.basis.b0 = q0[1]
        self.frame.basis.c0 = q0[2]
        self.frame.basis.d0 = q0[3]
        self.frame.basis.e0 = q0[4]
        self.frame.basis.f0 = q0[5]
        self.frame.basis.g0 = q0[6]
        self.frame.basis.h0 = q0[7]
        self.frame.basis.i0 = q0[8]
        self.frame.basis.j0 = q0[9]
        self.frame.basis.a1 = q1[0]
        self.frame.basis.b1 = q1[1]
        self.frame.basis.c1 = q1[2]
        self.frame.basis.d1 = q1[3]
        self.frame.basis.e1 = q1[4]
        self.frame.basis.f1 = q1[5]
        self.frame.basis.g1 = q1[6]
        self.frame.basis.h1 = q1[7]
        self.frame.basis.i1 = q1[8]
        self.frame.basis.j1 = q1[9]
    }

    /// Project one vertex of the retained radial construction.
    pub fn vertex(self, _ vid: u32) -> RasterVertex<SurfaceVarying> {
        oracle_vertex(vid, self.frame)
    }

    /// Material sample for a projected payload; the algebra stays in the
    /// projection and the shared Fe material stays directly testable.
    pub fn material(self, _ v: SurfaceVarying) -> u32 {
        shade_varying(v, self.frame)
    }
}

// ---------------------------------------------------------------------------
// Retained radial projection construction for CPU/Wasm verification lanes.
// ---------------------------------------------------------------------------

fn oracle_vertex(_ vid: u32, _ frame: PencilFrame) -> RasterVertex<SurfaceVarying> {
    let s: SurfaceSample = sample_vertex(vid, frame)
    RasterVertex {
        position: ClipPosition { x: s.x, y: s.y, z: s.z, w: s.w },
        varying: SurfaceVarying {
            nx: s.nx, ny: s.ny, nz: s.nz,
            glow: s.glow, sheet: s.sheet, accuse: s.accuse, marker: 0.0,
        },
    }
}

fn picked_from_index(_ index: u32) -> PickedControl {
    if index == 0 { return PickedControl::P0 }
    if index == 1 { return PickedControl::P1 }
    if index == 2 { return PickedControl::P2 }
    if index == 3 { return PickedControl::P3 }
    if index == 4 { return PickedControl::P4 }
    if index == 5 { return PickedControl::P5 }
    if index == 6 { return PickedControl::P6 }
    if index == 7 { return PickedControl::P7 }
    PickedControl::P8
}

fn control_marker_vertex(
    _ vid: u32,
    _ points: ControlPoints,
    _ frame: PencilFrame,
) -> RasterVertex<SurfaceVarying> {
    let local: u32 = vid - VERTEX_COUNT
    let point_index: u32 = local / 6
    let corner: u32 = local % 6
    let projected: ProjectedPoint = project_point(control_point_at_index(points, point_index), frame)
    let mut sx: f32 = -0.018
    let mut sy: f32 = -0.018
    if corner == 1 { sx = 0.018 }
    if corner == 2 { sy = 0.018 }
    if corner == 3 { sy = 0.018 }
    if corner == 4 { sx = 0.018 }
    if corner == 5 {
        sx = 0.018
        sy = 0.018
    }
    let w: f32 = projected.position.w
    RasterVertex {
        position: ClipPosition {
            x: projected.position.x + sx * w,
            y: projected.position.y + sy * w,
            z: projected.position.z - 0.001 * w,
            w: w,
        },
        varying: SurfaceVarying {
            nx: 0.0, ny: 0.0, nz: 1.0,
            glow: from_i32(point_index.downcast_truncate()) / 8.0,
            sheet: 0.0, accuse: 0.0, marker: 1.0,
        },
    }
}

fn oracle_scene_vertex(
    _ vid: u32,
    _ points: ControlPoints,
    _ frame: PencilFrame,
) -> RasterVertex<SurfaceVarying> {
    if vid < VERTEX_COUNT { oracle_vertex(vid, frame) }
    else { control_marker_vertex(vid, points, frame) }
}

/// Stable Fe material shared by the live DE renderer and retained oracle.
/// `view` points from camera toward the surface. Signed normal components do
/// not determine the base colour: a projective quadric may reverse its
/// representative without changing its zero set, and its material must not
/// flash to a complementary palette when that happens.
pub fn pencil_material(
    _ normal: Vec3,
    _ view: Vec3,
    _ frame: PencilFrame,
    _ glow: f32,
    _ sheet: f32,
) -> Vec3 {
    let normal: Vec3 = normalize3(normal)
    let view: Vec3 = normalize3(view)
    let lit: f32 = 0.80 + 0.20 * abs(dot3(normal, vec3(LX, LY, LZ)))
    let facing: f32 = abs(dot3(normal, view))
    let tangent: f32 = 1.0 - facing
    let sheen: f32 = tangent * tangent * 0.16
    let sheet: f32 = clamp01(sheet)
    let glow: f32 = clamp01(glow)
    // Rank/pencil freedom is algebraic evidence, not a material coordinate.
    // Dragging one point commonly changes rank 8 -> 9; coupling hue to that
    // discrete fact made the whole surface jump from orange to purple.
    // Absolute normal components retain orientation-tracking colour while
    // remaining invariant under the projective reversal n -> -n. The surface
    // moves between the shared electric blue and spring green; gold is
    // reserved for grazing sheen and interaction evidence.
    let cool = electric_blue()
    let warm = spring_green()
    let gold = theorem_gold()
    let white = clean_white()
    let chroma: f32 = clamp01(0.18 + 0.68 * abs(normal.y) + 0.14 * sheet)
    let base_r: f32 = mix(cool.red, warm.red, chroma)
    let base_g: f32 = mix(cool.green, warm.green, chroma)
    let base_b: f32 = mix(cool.blue, warm.blue, chroma)
    vec3(
        lit * base_r + glow * white.red * 0.20 + sheen * gold.red,
        lit * base_g + glow * white.green * 0.20 + sheen * gold.green,
        lit * base_b + glow * white.blue * 0.20 + sheen * gold.blue,
    )
}

fn shade_varying(_ v: SurfaceVarying, _ frame: PencilFrame) -> u32 {
    if v.marker > 0.5 {
        let phase: f32 = clamp01(v.glow)
        let gold = theorem_gold()
        let white = clean_white()
        return __bitcast(rgba(
            mix(gold.red, white.red, phase),
            mix(gold.green, white.green, phase),
            mix(gold.blue, white.blue, phase),
        ))
    }
    let color: Vec3 = pencil_material(
        vec3(v.nx, v.ny, v.nz),
        pencil_ray(frame, 0.0, 0.0).direction,
        frame,
        v.glow,
        v.sheet,
    )
    let mut red: f32 = color.x
    let mut grn: f32 = color.y
    let mut blu: f32 = color.z
    if v.accuse > 0.5 {
        let evidence = evidence_gold()
        red = evidence.red
        grn = evidence.green
        blu = evidence.blue
    }
    __bitcast(rgba(red, grn, blu))
}

pub fn solved_basis(_ points: ControlPoints, _ generation: u32) -> PencilBasis {
    let solved: SolvedState = solve_points(control_points_array(points))
    let sol: PencilSolution = solved.sol
    let q0: [f32; 10] = sol.q0
    let q1: [f32; 10] = sol.q1
    PencilBasis {
        generation: generation,
        cx: solved.cx, cy: solved.cy, cz: solved.cz,
        pencil_free: if sol.rank <= 8 { 1.0 } else { 0.0 },
        a0: q0[0], b0: q0[1], c0: q0[2], d0: q0[3], e0: q0[4],
        f0: q0[5], g0: q0[6], h0: q0[7], i0: q0[8], j0: q0[9],
        a1: q1[0], b1: q1[1], c1: q1[2], d1: q1[3], e1: q1[4],
        f1: q1[5], g1: q1[6], h1: q1[7], i1: q1[8], j1: q1[9],
    }
}

pub fn pick_control_at(
    _ points: ControlPoints,
    _ frame: PencilFrame,
    _ pointer_x: f32,
    _ pointer_y: f32,
    _ width: f32,
    _ height: f32,
) -> PickedControl {
    let mut best: PickedControl = PickedControl::None
    let mut best_distance: f32 = 14.0 * 14.0
    let mut index: u32 = 0
    while index < 9 {
        let candidate: PickedControl = picked_from_index(index)
        let projected: ProjectedPoint = project_point(control_point(points, candidate), frame)
        if projected.depth > NEAR {
            let ndc_x: f32 = projected.position.x / projected.position.w
            let ndc_y: f32 = projected.position.y / projected.position.w
            let screen_x: f32 = (ndc_x * 0.5 + 0.5) * width
            let screen_y: f32 = (0.5 - ndc_y * 0.5) * height
            let dx: f32 = screen_x - pointer_x
            let dy: f32 = screen_y - pointer_y
            let distance: f32 = dx * dx + dy * dy
            if distance < best_distance {
                best = candidate
                best_distance = distance
            }
        }
        index = index + 1
    }
    best
}

pub fn drag_control_by(
    _ points: ControlPoints,
    _ picked: PickedControl,
    _ frame: PencilFrame,
    _ delta_x: f32,
    _ delta_y: f32,
    _ event_width: f32,
    _ event_height: f32,
) -> ControlPoints {
    let point: ControlPoint = control_point(points, picked)
    let projected: ProjectedPoint = project_point(point, frame)
    let width: f32 = max(event_width, 1.0)
    let height: f32 = max(event_height, 1.0)
    let drx: f32 = delta_x * 2.0 * projected.depth / (width * FOCAL)
    let dry: f32 = 0.0 - delta_y * 2.0 * projected.depth / (height * FOCAL)
    let cyaw: f32 = cos(frame.view.yaw)
    let syaw: f32 = sin(frame.view.yaw)
    let cpit: f32 = cos(frame.view.pitch)
    let spit: f32 = sin(frame.view.pitch)
    let moved: ControlPoint = ControlPoint {
        x: point.x + cyaw * drx + syaw * spit * dry,
        y: point.y + cpit * dry,
        z: point.z + syaw * drx - cyaw * spit * dry,
    }
    // Fe value semantics give the edit an independent owned snapshot. The
    // compiler lowers this whole aggregate copy for both native and Wasm; the
    // application does not spell or transport its flattened representation.
    let mut next: ControlPoints = points
    match picked {
        PickedControl::P0 => { next.p0x = moved.x
            next.p0y = moved.y
            next.p0z = moved.z }
        PickedControl::P1 => { next.p1x = moved.x
            next.p1y = moved.y
            next.p1z = moved.z }
        PickedControl::P2 => { next.p2x = moved.x
            next.p2y = moved.y
            next.p2z = moved.z }
        PickedControl::P3 => { next.p3x = moved.x
            next.p3y = moved.y
            next.p3z = moved.z }
        PickedControl::P4 => { next.p4x = moved.x
            next.p4y = moved.y
            next.p4z = moved.z }
        PickedControl::P5 => { next.p5x = moved.x
            next.p5y = moved.y
            next.p5z = moved.z }
        PickedControl::P6 => { next.p6x = moved.x
            next.p6y = moved.y
            next.p6z = moved.z }
        PickedControl::P7 => { next.p7x = moved.x
            next.p7y = moved.y
            next.p7z = moved.z }
        PickedControl::P8 => { next.p8x = moved.x
            next.p8y = moved.y
            next.p8z = moved.z }
        PickedControl::None => {}
    }
    next
}

/// One reusable application state shared by every QCGA pencil view. Actor
/// declarations stay tiny: initialize this value, transition this value, then
/// choose a rendering interpretation.
pub struct PencilSceneState {
    pub frame: PencilFrame,
    pub points: ControlPoints,
    pub picked: PickedControl,
}
impl Copy for PencilSceneState {}

pub fn initial_pencil_scene() -> PencilSceneState {
    let initial: SolveRequest = defaults(request: DefaultsRequest { generation: 0 })
    let points: ControlPoints = control_points_from_request(initial)
    PencilSceneState {
        frame: PencilFrame {
            view: PencilControls {
                lambda: 0.15,
                yaw: 0.6,
                pitch: 0.35,
                dist: 4.0,
            },
            basis: solved_basis(points, 0),
        },
        points: points,
        picked: PickedControl::None,
    }
}

pub fn transition_pencil_scene(
    _ state: PencilSceneState,
    _ event: own SurfaceEvent,
) -> PencilSceneState {
    if event.is_pointer_down() {
        return PencilSceneState {
            frame: state.frame,
            points: state.points,
            picked: pick_control_at(
                state.points, state.frame, event.pointer_x, event.pointer_y,
                event.width, event.height,
            ),
        }
    }
    if event.is_pointer_move() {
        match state.picked {
            PickedControl::None => {
                return PencilSceneState {
                    frame: PencilFrame {
                        view: state.frame.view.apply_param_bindings(
                            pencil_params(), event,
                        ),
                        basis: state.frame.basis,
                    },
                    points: state.points,
                    picked: PickedControl::None,
                }
            }
            _ => {
                let points: ControlPoints = drag_control_by(
                    state.points, state.picked, state.frame,
                    event.delta_x, event.delta_y, event.width, event.height,
                )
                return PencilSceneState {
                    frame: PencilFrame {
                        view: state.frame.view,
                        basis: solved_basis(
                            points, state.frame.basis.generation + 1,
                        ),
                    },
                    points: points,
                    picked: state.picked,
                }
            }
        }
    }
    if event.is_pointer_up() {
        return PencilSceneState {
            frame: state.frame,
            points: state.points,
            picked: PickedControl::None,
        }
    }
    PencilSceneState {
        frame: PencilFrame {
            view: state.frame.view.apply_param_bindings(pencil_params(), event),
            basis: state.frame.basis,
        },
        points: state.points,
        picked: state.picked,
    }
}

// ---------------------------------------------------------------------------
// The solver: nine points to a pencil, entirely through linear incidence.
// ---------------------------------------------------------------------------

/// One entry of the 9 x 10 incidence matrix: the generated QCGA incidence of
/// the embedded point against the k-th basis dual quadric. The linear system
/// is the incidence operator by construction; there is no separately derived
/// Veronese table to drift from it.
fn incidence_row_entry(_ x: f32, _ y: f32, _ z: f32, _ k: usize) -> f32 {
    let mut unit: [f32; 10] = [0.0; 10]
    unit[k] = 1.0
    qcga3d_incidence(
        x: x, y: y, z: z,
        a: unit[0], b: unit[1], c: unit[2], d: unit[3], e: unit[4],
        f: unit[5], g: unit[6], h: unit[7], i: unit[8], j: unit[9],
    )
}

pub struct PencilSolution {
    pub rank: u32,
    pub residual: f32,
    pub q0: [f32; 10],
    pub q1: [f32; 10],
}

/// Gauss-Jordan elimination with partial pivoting on the 9 x 10 incidence
/// matrix, then the first two nullspace basis vectors. rank == 9 means the
/// nine points genuinely decide the quadric and `q1` degenerates to `q0`;
/// rank <= 8 means the points abstain and `q0`, `q1` span (the first plane
/// of) the surviving pencil.
pub fn solve_pencil(_ pts: [f32; 27]) -> PencilSolution {
    let mut m: [f32; 90] = [0.0; 90]
    let mut r: usize = 0
    while r < 9 {
        let x: f32 = pts[r * 3]
        let y: f32 = pts[r * 3 + 1]
        let z: f32 = pts[r * 3 + 2]
        let mut c: usize = 0
        while c < 10 {
            m[r * 10 + c] = incidence_row_entry(x, y, z, c)
            c = c + 1
        }
        r = r + 1
    }

    // Relative rank tolerance from the matrix scale.
    let mut mat_scale: f32 = 0.0
    let mut k: usize = 0
    while k < 90 {
        mat_scale = max(mat_scale, abs(m[k]))
        k = k + 1
    }
    let tol: f32 = mat_scale * 0.0001 + 0.000000001

    let mut pivot_col_of_row: [usize; 9] = [10; 9]
    let mut col_is_pivot: [u32; 10] = [0; 10]
    let mut rank: usize = 0
    let mut col: usize = 0
    while col < 10 {
        if rank < 9 {
            let mut best_row: usize = rank
            let mut best_abs: f32 = 0.0
            let mut rr: usize = rank
            while rr < 9 {
                let a: f32 = abs(m[rr * 10 + col])
                if a > best_abs {
                    best_abs = a
                    best_row = rr
                }
                rr = rr + 1
            }
            if best_abs > tol {
                let mut cc: usize = 0
                while cc < 10 {
                    let tmp: f32 = m[rank * 10 + cc]
                    m[rank * 10 + cc] = m[best_row * 10 + cc]
                    m[best_row * 10 + cc] = tmp
                    cc = cc + 1
                }
                let inv: f32 = 1.0 / m[rank * 10 + col]
                cc = 0
                while cc < 10 {
                    m[rank * 10 + cc] = m[rank * 10 + cc] * inv
                    cc = cc + 1
                }
                let mut er: usize = 0
                while er < 9 {
                    if er != rank {
                        let factor: f32 = m[er * 10 + col]
                        let mut ec: usize = 0
                        while ec < 10 {
                            m[er * 10 + ec] = m[er * 10 + ec] - factor * m[rank * 10 + ec]
                            ec = ec + 1
                        }
                    }
                    er = er + 1
                }
                pivot_col_of_row[rank] = col
                col_is_pivot[col] = 1
                rank = rank + 1
            }
        }
        col = col + 1
    }

    // Nullspace basis vectors from the free columns, first two retained.
    let mut q0: [f32; 10] = [0.0; 10]
    let mut q1: [f32; 10] = [0.0; 10]
    let mut found: usize = 0
    let mut fc: usize = 0
    while fc < 10 {
        if col_is_pivot[fc] == 0 {
            if found < 2 {
                let mut v: [f32; 10] = [0.0; 10]
                v[fc] = 1.0
                let mut pr: usize = 0
                while pr < rank {
                    let pc: usize = pivot_col_of_row[pr]
                    v[pc] = 0.0 - m[pr * 10 + fc]
                    pr = pr + 1
                }
                if found == 0 { q0 = v } else { q1 = v }
            }
            found = found + 1
        }
        fc = fc + 1
    }

    // Orthonormalize the pencil plane so the lambda sweep is well conditioned.
    // All vector algebra below stays element-level on the two mut locals; no
    // whole-array temporaries change hands.
    let mut n0sq: f32 = 0.0
    let mut k0: usize = 0
    while k0 < 10 {
        n0sq = n0sq + q0[k0] * q0[k0]
        k0 = k0 + 1
    }
    let n0: f32 = sqrt(n0sq)
    if n0 > 0.0000001 {
        let inv0: f32 = 1.0 / n0
        let mut k1: usize = 0
        while k1 < 10 {
            q0[k1] = q0[k1] * inv0
            k1 = k1 + 1
        }
    }
    // Deterministic sign: the largest-magnitude coefficient points positive,
    // so the pencil basis does not flip between drags.
    let mut lead: usize = 0
    let mut lead_abs: f32 = 0.0
    let mut k2: usize = 0
    while k2 < 10 {
        let a0: f32 = abs(q0[k2])
        if a0 > lead_abs {
            lead_abs = a0
            lead = k2
        }
        k2 = k2 + 1
    }
    if q0[lead] < 0.0 {
        let mut k3: usize = 0
        while k3 < 10 {
            q0[k3] = 0.0 - q0[k3]
            k3 = k3 + 1
        }
    }
    if rank >= 9 {
        let mut k4: usize = 0
        while k4 < 10 {
            q1[k4] = q0[k4]
            k4 = k4 + 1
        }
    } else {
        let mut proj: f32 = 0.0
        let mut k5: usize = 0
        while k5 < 10 {
            proj = proj + q0[k5] * q1[k5]
            k5 = k5 + 1
        }
        let mut n1sq: f32 = 0.0
        let mut k6: usize = 0
        while k6 < 10 {
            q1[k6] = q1[k6] - proj * q0[k6]
            n1sq = n1sq + q1[k6] * q1[k6]
            k6 = k6 + 1
        }
        let n1: f32 = sqrt(n1sq)
        if n1 > 0.0000001 {
            let inv1: f32 = 1.0 / n1
            let mut k7: usize = 0
            while k7 < 10 {
                q1[k7] = q1[k7] * inv1
                k7 = k7 + 1
            }
            let mut lead1: usize = 0
            let mut lead1_abs: f32 = 0.0
            let mut k8: usize = 0
            while k8 < 10 {
                let a1: f32 = abs(q1[k8])
                if a1 > lead1_abs {
                    lead1_abs = a1
                    lead1 = k8
                }
                k8 = k8 + 1
            }
            if q1[lead1] < 0.0 {
                let mut k9: usize = 0
                while k9 < 10 {
                    q1[k9] = 0.0 - q1[k9]
                    k9 = k9 + 1
                }
            }
        } else {
            let mut ka: usize = 0
            while ka < 10 {
                q1[ka] = q0[ka]
                ka = ka + 1
            }
        }
    }

    // The receipt: the worst incidence of the returned surfaces over all nine
    // points, measured by the same generated incidence used everywhere else.
    let qa: Quadric = Quadric {
        a: q0[0], b: q0[1], c: q0[2], d: q0[3], e: q0[4],
        f: q0[5], g: q0[6], h: q0[7], i: q0[8], j: q0[9],
    }
    let qb: Quadric = Quadric {
        a: q1[0], b: q1[1], c: q1[2], d: q1[3], e: q1[4],
        f: q1[5], g: q1[6], h: q1[7], i: q1[8], j: q1[9],
    }
    let mut residual: f32 = 0.0
    let mut pr2: usize = 0
    while pr2 < 9 {
        let x: f32 = pts[pr2 * 3]
        let y: f32 = pts[pr2 * 3 + 1]
        let z: f32 = pts[pr2 * 3 + 2]
        residual = max(residual, abs(eval_quadric(qa, x, y, z)))
        residual = max(residual, abs(eval_quadric(qb, x, y, z)))
        pr2 = pr2 + 1
    }

    PencilSolution { rank: rank.downcast_truncate(), residual, q0, q1 }
}

/// Centroid plus pencil solution: the full derivation `resolve` and the
/// `solve` lane share.
pub struct SolvedState {
    pub cx: f32,
    pub cy: f32,
    pub cz: f32,
    pub sol: PencilSolution,
}

pub fn solve_points(_ pts: [f32; 27]) -> SolvedState {
    let mut sx: f32 = 0.0
    let mut sy: f32 = 0.0
    let mut sz: f32 = 0.0
    let mut pi: usize = 0
    while pi < 9 {
        sx = sx + pts[pi * 3]
        sy = sy + pts[pi * 3 + 1]
        sz = sz + pts[pi * 3 + 2]
        pi = pi + 1
    }
    let ninth: f32 = 1.0 / 9.0
    let cx: f32 = sx * ninth
    let cy: f32 = sy * ninth
    let cz: f32 = sz * ninth
    let sol: PencilSolution = solve_pencil(pts)
    SolvedState { cx, cy, cz, sol }
}

// ---------------------------------------------------------------------------
// Canonical Wasm lanes: the domain message surface, flattened.
//
// Today's canonical lanes are stateless free functions, so each message must
// carry the full state it needs and the actor state round-trips through the
// host between messages. `defaults` and `solve` are the domain transitions;
// `probe` and `mesh_oracle` retain independent evidence for the former radial
// projection. The flattening is a recorded tooling gap, not a design choice.
// ---------------------------------------------------------------------------

pub struct DefaultsRequest {
    pub generation: u32,
}

pub struct SolveRequest {
    pub generation: u32,
    pub p0x: f32, pub p0y: f32, pub p0z: f32,
    pub p1x: f32, pub p1y: f32, pub p1z: f32,
    pub p2x: f32, pub p2y: f32, pub p2z: f32,
    pub p3x: f32, pub p3y: f32, pub p3z: f32,
    pub p4x: f32, pub p4y: f32, pub p4z: f32,
    pub p5x: f32, pub p5y: f32, pub p5z: f32,
    pub p6x: f32, pub p6y: f32, pub p6z: f32,
    pub p7x: f32, pub p7y: f32, pub p7z: f32,
    pub p8x: f32, pub p8y: f32, pub p8z: f32,
}
impl Copy for SolveRequest {}

pub struct SolveResponse {
    pub generation: u32,
    /// Rank of the incidence system. 9 = the points decide one quadric,
    /// 8 = a full pencil survives, lower = the points are even further from
    /// general position (the response still carries the first two basis
    /// surfaces and reports the honest rank).
    pub rank: u32,
    /// Worst generated incidence of the returned basis surfaces over all nine
    /// points.
    pub residual: f32,
    pub cx: f32,
    pub cy: f32,
    pub cz: f32,
    pub a0: f32, pub b0: f32, pub c0: f32, pub d0: f32, pub e0: f32,
    pub f0: f32, pub g0: f32, pub h0: f32, pub i0: f32, pub j0: f32,
    pub a1: f32, pub b1: f32, pub c1: f32, pub d1: f32, pub e1: f32,
    pub f1: f32, pub g1: f32, pub h1: f32, pub i1: f32, pub j1: f32,
}
impl Copy for SolveResponse {}

/// The initial nine points: five on the upper circle and four on the lower
/// circle of (unit sphere) intersect (cone z^2 = x^2 + y^2), both circles of
/// radius 1/sqrt(2) at z = +-1/sqrt(2). Nine points, yet rank 8: the whole
/// pencil alpha(x^2 + y^2 - 1/2) + beta(z^2 - 1/2) survives, so the demo
/// OPENS in the quirky state. Published as a lane so the page's initial state
/// is computed, not baked.
pub fn defaults(request: own DefaultsRequest) -> SolveRequest {
    SolveRequest {
        generation: request.generation,
        p0x: 0.70710678, p0y: 0.0, p0z: 0.70710678,
        p1x: 0.21850801, p1y: 0.67249851, p1z: 0.70710678,
        p2x: -0.57206140, p2y: 0.41562694, p2z: 0.70710678,
        p3x: -0.57206140, p3y: -0.41562694, p3z: 0.70710678,
        p4x: 0.21850801, p4y: -0.67249851, p4z: 0.70710678,
        p5x: 0.69636424, p5y: 0.12278780, p5z: -0.70710678,
        p6x: -0.12278780, p6y: 0.69636424, p6z: -0.70710678,
        p7x: -0.69636424, p7y: -0.12278780, p7z: -0.70710678,
        p8x: 0.12278780, p8y: -0.69636424, p8z: -0.70710678,
    }
}

/// The constraint solve: nine dragged points to a pencil basis, one call.
/// This is the flattened form of the actor's Drag/resolve arm.
pub fn solve(request: own SolveRequest) -> SolveResponse {
    let pts: [f32; 27] = [
        request.p0x, request.p0y, request.p0z,
        request.p1x, request.p1y, request.p1z,
        request.p2x, request.p2y, request.p2z,
        request.p3x, request.p3y, request.p3z,
        request.p4x, request.p4y, request.p4z,
        request.p5x, request.p5y, request.p5z,
        request.p6x, request.p6y, request.p6z,
        request.p7x, request.p7y, request.p7z,
        request.p8x, request.p8y, request.p8z,
    ]
    let solved: SolvedState = solve_points(pts)
    let sol: PencilSolution = solved.sol
    let q0: [f32; 10] = sol.q0
    let q1: [f32; 10] = sol.q1

    SolveResponse {
        generation: request.generation,
        rank: sol.rank,
        residual: sol.residual,
        cx: solved.cx, cy: solved.cy, cz: solved.cz,
        a0: q0[0], b0: q0[1], c0: q0[2], d0: q0[3], e0: q0[4],
        f0: q0[5], g0: q0[6], h0: q0[7], i0: q0[8], j0: q0[9],
        a1: q1[0], b1: q1[1], c1: q1[2], d1: q1[3], e1: q1[4],
        f1: q1[5], g1: q1[6], h1: q1[7], i1: q1[8], j1: q1[9],
    }
}

/// Rehydrate the radial oracle from its wire-form state slice. Its existence
/// makes the current stateless lane boundary visible; a resident Fe component
/// can retain the frame directly.
fn oracle_from_frame(_ frame: PencilFrame) -> RadialProjectionOracle {
    RadialProjectionOracle {
        points: ControlPoints {
            p0x: 0.0, p0y: 0.0, p0z: 0.0,
            p1x: 0.0, p1y: 0.0, p1z: 0.0,
            p2x: 0.0, p2y: 0.0, p2z: 0.0,
            p3x: 0.0, p3y: 0.0, p3z: 0.0,
            p4x: 0.0, p4y: 0.0, p4z: 0.0,
            p5x: 0.0, p5y: 0.0, p5z: 0.0,
            p6x: 0.0, p6y: 0.0, p6z: 0.0,
            p7x: 0.0, p7y: 0.0, p7z: 0.0,
            p8x: 0.0, p8y: 0.0, p8z: 0.0,
        },
        frame,
        rank: if frame.basis.pencil_free > 0.5 { 8 } else { 9 },
        residual: 0.0,
    }
}

pub struct VertexProbe {
    pub generation: u32,
    pub vid: u32,
    pub lambda: f32,
    pub yaw: f32,
    pub pitch: f32,
    pub dist: f32,
    pub cx: f32,
    pub cy: f32,
    pub cz: f32,
    pub pencil_free: f32,
    pub a0: f32, pub b0: f32, pub c0: f32, pub d0: f32, pub e0: f32,
    pub f0: f32, pub g0: f32, pub h0: f32, pub i0: f32, pub j0: f32,
    pub a1: f32, pub b1: f32, pub c1: f32, pub d1: f32, pub e1: f32,
    pub f1: f32, pub g1: f32, pub h1: f32, pub i1: f32, pub j1: f32,
}

pub struct ProbeResponse {
    pub generation: u32,
    pub x: f32,
    pub y: f32,
    pub z: f32,
    pub w: f32,
    pub nx: f32,
    pub ny: f32,
    pub nz: f32,
    pub glow: f32,
    pub sheet: f32,
    pub accuse: f32,
    /// Material-oracle color for this vertex's own un-interpolated payload.
    pub rgba: u32,
    pub t: f32,
    pub hx: f32,
    pub hy: f32,
    pub hz: f32,
    pub residual: f32,
    pub disc: f32,
    pub missed: u32,
}

/// Single-vertex verification lane for the historical radial projection. It
/// returns full hit evidence plus the material evaluated at that sample; the
/// live DE renderer is tested separately by ray oracles.
pub fn probe(request: own VertexProbe) -> ProbeResponse {
    let oracle: RadialProjectionOracle = oracle_from_frame(PencilFrame {
        view: PencilControls {
            lambda: request.lambda,
            yaw: request.yaw,
            pitch: request.pitch,
            dist: request.dist,
        },
        basis: PencilBasis {
            generation: request.generation,
            cx: request.cx, cy: request.cy, cz: request.cz,
            pencil_free: request.pencil_free,
            a0: request.a0, b0: request.b0, c0: request.c0, d0: request.d0, e0: request.e0,
            f0: request.f0, g0: request.g0, h0: request.h0, i0: request.i0, j0: request.j0,
            a1: request.a1, b1: request.b1, c1: request.c1, d1: request.d1, e1: request.e1,
            f1: request.f1, g1: request.g1, h1: request.h1, i1: request.i1, j1: request.j1,
        },
    })
    let s: SurfaceSample = sample_vertex(request.vid, oracle.frame)
    let v: SurfaceVarying = SurfaceVarying {
        nx: s.nx, ny: s.ny, nz: s.nz,
        glow: s.glow, sheet: s.sheet, accuse: s.accuse, marker: 0.0,
    }
    let color: u32 = oracle.material(v)
    ProbeResponse {
        generation: request.generation,
        x: s.x, y: s.y, z: s.z, w: s.w,
        nx: s.nx, ny: s.ny, nz: s.nz,
        glow: s.glow, sheet: s.sheet, accuse: s.accuse,
        rgba: color,
        t: s.t,
        hx: s.hx, hy: s.hy, hz: s.hz,
        residual: s.residual,
        disc: s.disc,
        missed: s.missed,
    }
}

fn append_byte(_ value: u32) {
    let byte = alloc_bytes(1)
    byte.write(value.downcast_truncate())
}

fn append_word_tail(_ word: u32) {
    append_byte(word >> 8)
    append_byte(word >> 16)
    append_byte(word >> 24)
}

fn append_word(_ word: u32) {
    append_byte(word)
    append_word_tail(word)
}

fn append_clip_and_color(_ vertex: RasterVertex<SurfaceVarying>, _ color: u32) {
    let xw: u32 = __bitcast(vertex.position.x)
    let yw: u32 = __bitcast(vertex.position.y)
    let zw: u32 = __bitcast(vertex.position.z)
    let ww: u32 = __bitcast(vertex.position.w)
    append_word(xw)
    append_word(yw)
    append_word(zw)
    append_word(ww)
    append_word(color)
}

/// Complete historical radial-oracle stream: clip position plus material at
/// each un-interpolated analytic vertex. The 20-byte records (4 x f32 LE plus
/// RGBA8 as one LE u32) remain a deterministic regression artifact; they are
/// not the live gallery renderer and make no claim about between-vertex color.
pub fn mesh_oracle(request: own PencilFrame) -> AllocatedBrowserBytes {
    let oracle: RadialProjectionOracle = oracle_from_frame(request)
    let first_v: RasterVertex<SurfaceVarying> = oracle.vertex(0)
    let first_color: u32 = oracle.material(first_v.varying)
    let first_word: u32 = __bitcast(first_v.position.x)
    let head = alloc_bytes(1)
    head.write(first_word.downcast_truncate())
    append_word_tail(first_word)
    let yw: u32 = __bitcast(first_v.position.y)
    let zw: u32 = __bitcast(first_v.position.z)
    let ww: u32 = __bitcast(first_v.position.w)
    append_word(yw)
    append_word(zw)
    append_word(ww)
    append_word(first_color)
    let mut vid: u32 = 1
    while vid < VERTEX_COUNT {
        let v: RasterVertex<SurfaceVarying> = oracle.vertex(vid)
        let color: u32 = oracle.material(v.varying)
        append_clip_and_color(v, color)
        vid = vid + 1
    }
    AllocatedBrowserBytes { ptr: head, len: VERTEX_COUNT * 20 }
}
