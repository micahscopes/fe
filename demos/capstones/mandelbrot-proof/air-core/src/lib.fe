#[inline(always)]
fn absorb_residuals<F: Radix2Field, const N: usize>(
    _ fold: own ConstraintFold<F>,
    _ residuals: [F; N],
) -> ConstraintFold<F> {
    let mut fold = fold
    let mut index: usize = 0
    while index < N {
        fold = fold.absorb(residuals[index])
        index = index + 1
    }
    fold
}

#[inline(always)]
fn absorb_range_columns<
    F: Radix2Field,
    const N: usize,
    Source: Copy,
    V: AirColumnView<F, Source>,
>(
    _ fold: own ConstraintFold<F>,
    _ value: F,
    _ source: Source,
    _ view: ref V,
    _ start: usize,
) -> ConstraintFold<F> {
    let mut fold = fold
    let mut reconstructed = zero<F>()
    let mut weight = one<F>()
    let mut previous_any = zero<F>()
    let mut index: usize = 0
    while index < N {
        let bit = view.auxiliary(source, start + index)
        let any = view.auxiliary(source, start + N + index)
        fold = fold.absorb(bit_residual(bit))
        fold = fold.absorb(bit_residual(any))
        fold = fold.absorb(add(sub(sub(any, previous_any), bit), mul(previous_any, bit)))
        reconstructed = add(reconstructed, mul(bit, weight))
        weight = add(weight, weight)
        previous_any = any
        index = index + 1
    }
    fold.absorb(sub(value, reconstructed))
}

#[inline(always)]
fn absorb_signed_range_columns<
    F: Radix2Field,
    const N: usize,
    Source: Copy,
    V: AirColumnView<F, Source>,
>(
    _ fold: own ConstraintFold<F>,
    _ sign: F,
    _ magnitude: F,
    _ source: Source,
    _ view: ref V,
    _ start: usize,
) -> ConstraintFold<F> {
    let mut fold = fold.absorb(bit_residual(sign))
    fold = absorb_range_columns<F, N, Source, V>(fold, magnitude, source, view, start)
    let nonzero = view.auxiliary(source, start + 2 * N - 1)
    fold.absorb(mul(sign, sub(one<F>(), nonzero)))
}

#[inline(always)]
fn absorb_terminal_range_columns<
    F: Radix2Field,
    Source: Copy,
    V: AirColumnView<F, Source>,
>(
    _ fold: own ConstraintFold<F>,
    _ magnitude: F,
    _ terminal: F,
    _ source: Source,
    _ view: ref V,
    _ magnitude_start: usize,
    _ terminal_start: usize,
) -> ConstraintFold<F> {
    let mut fold = absorb_range_columns<F, 31, Source, V>(
        fold, magnitude, source, view, magnitude_start,
    )
    fold = fold.absorb(bit_residual(terminal))
    let mut previous = zero<F>()
    let mut index: usize = 0
    while index < 5 {
        let bit = view.auxiliary(source, magnitude_start + index + 26)
        let any = view.auxiliary(source, terminal_start + index)
        fold = fold.absorb(bit_residual(any))
        fold = fold.absorb(add(sub(sub(any, previous), bit), mul(previous, bit)))
        previous = any
        index = index + 1
    }
    fold.absorb(sub(terminal, previous))
}

/// Begin the canonical fold before any AIR residual has been absorbed.
#[inline(always)]
pub fn begin_constraint_fold<F: Radix2Field>(
    _ challenge: F,
) -> ConstraintFoldCheckpoint<F, 0> {
    checkpoint_from_fold<F, 0>(ConstraintFold<F>::new(challenge))
}

/// Absorb the 14 local/state residuals and the 64 step-range residuals.
#[inline(always)]
pub fn fold_local_step_constraints<
    F: Radix2Field,
    Source: Copy,
    Row: AirColumnView<F, Source>,
>(
    _ checkpoint: ConstraintFoldCheckpoint<F, 0>,
    _ source: Source,
    _ row_view: ref Row,
) -> ConstraintFoldCheckpoint<F, 78> {
    let row = row_from_view<F, Source, Row>(source, row_view)
    let mut fold = fold_from_checkpoint<F, 0>(checkpoint)
    fold = absorb_residuals<F, 9>(fold, local_residuals(row))
    fold = absorb_residuals<F, 5>(fold, row_state_residuals(row))
    fold = absorb_range_columns<F, 21, Source, Row>(
        fold, row.step, source, row_view, 0,
    )
    checkpoint_from_fold<F, 78>(fold)
}

/// Absorb both signed orbit-coordinate range witnesses.
#[inline(always)]
pub fn fold_orbit_coordinate_constraints<
    F: Radix2Field,
    Source: Copy,
    Row: AirColumnView<F, Source>,
>(
    _ checkpoint: ConstraintFoldCheckpoint<F, 78>,
    _ source: Source,
    _ row_view: ref Row,
) -> ConstraintFoldCheckpoint<F, 174> {
    let mut fold = fold_from_checkpoint<F, 78>(checkpoint)
    fold = absorb_signed_range_columns<F, 15, Source, Row>(
        fold,
        row_view.main(source, 1),
        row_view.main(source, 2),
        source,
        row_view,
        42,
    )
    fold = absorb_signed_range_columns<F, 15, Source, Row>(
        fold,
        row_view.main(source, 3),
        row_view.main(source, 4),
        source,
        row_view,
        72,
    )
    checkpoint_from_fold<F, 174>(fold)
}

/// Absorb the 30-bit real-square range witness.
#[inline(always)]
pub fn fold_real_square_constraints<
    F: Radix2Field,
    Source: Copy,
    Row: AirColumnView<F, Source>,
>(
    _ checkpoint: ConstraintFoldCheckpoint<F, 174>,
    _ source: Source,
    _ row_view: ref Row,
) -> ConstraintFoldCheckpoint<F, 265> {
    let fold = absorb_range_columns<F, 30, Source, Row>(
        fold_from_checkpoint<F, 174>(checkpoint),
        row_view.main(source, 5),
        source,
        row_view,
        102,
    )
    checkpoint_from_fold<F, 265>(fold)
}

/// Absorb the 30-bit imaginary-square range witness.
#[inline(always)]
pub fn fold_imaginary_square_constraints<
    F: Radix2Field,
    Source: Copy,
    Row: AirColumnView<F, Source>,
>(
    _ checkpoint: ConstraintFoldCheckpoint<F, 265>,
    _ source: Source,
    _ row_view: ref Row,
) -> ConstraintFoldCheckpoint<F, 356> {
    let fold = absorb_range_columns<F, 30, Source, Row>(
        fold_from_checkpoint<F, 265>(checkpoint),
        row_view.main(source, 6),
        source,
        row_view,
        162,
    )
    checkpoint_from_fold<F, 356>(fold)
}

/// Absorb the signed real quotient and its unsigned remainder ranges.
#[inline(always)]
pub fn fold_real_quotient_constraints<
    F: Radix2Field,
    Source: Copy,
    Row: AirColumnView<F, Source>,
>(
    _ checkpoint: ConstraintFoldCheckpoint<F, 356>,
    _ source: Source,
    _ row_view: ref Row,
) -> ConstraintFoldCheckpoint<F, 450> {
    let mut fold = fold_from_checkpoint<F, 356>(checkpoint)
    fold = absorb_signed_range_columns<F, 18, Source, Row>(
        fold,
        row_view.main(source, 8),
        row_view.main(source, 9),
        source,
        row_view,
        284,
    )
    fold = absorb_range_columns<F, 12, Source, Row>(
        fold,
        row_view.main(source, 10),
        source,
        row_view,
        320,
    )
    checkpoint_from_fold<F, 450>(fold)
}

/// Absorb the signed imaginary quotient and its unsigned remainder ranges.
#[inline(always)]
pub fn fold_imaginary_quotient_constraints<
    F: Radix2Field,
    Source: Copy,
    Row: AirColumnView<F, Source>,
>(
    _ checkpoint: ConstraintFoldCheckpoint<F, 450>,
    _ source: Source,
    _ row_view: ref Row,
) -> ConstraintFoldCheckpoint<F, 547> {
    let mut fold = fold_from_checkpoint<F, 450>(checkpoint)
    fold = absorb_signed_range_columns<F, 19, Source, Row>(
        fold,
        row_view.main(source, 11),
        row_view.main(source, 12),
        source,
        row_view,
        344,
    )
    fold = absorb_range_columns<F, 12, Source, Row>(
        fold,
        row_view.main(source, 13),
        source,
        row_view,
        382,
    )
    checkpoint_from_fold<F, 547>(fold)
}

/// Absorb the 31-bit magnitude witness and its terminal-threshold chain.
#[inline(always)]
pub fn fold_magnitude_terminal_constraints<
    F: Radix2Field,
    Source: Copy,
    Row: AirColumnView<F, Source>,
>(
    _ checkpoint: ConstraintFoldCheckpoint<F, 547>,
    _ source: Source,
    _ row_view: ref Row,
) -> ConstraintFoldCheckpoint<F, 653> {
    let fold = absorb_terminal_range_columns<F, Source, Row>(
        fold_from_checkpoint<F, 547>(checkpoint),
        row_view.main(source, 7),
        row_view.main(source, 14),
        source,
        row_view,
        222,
        406,
    )
    checkpoint_from_fold<F, 653>(fold)
}

/// Fold the pair-row family from the exact all-rows checkpoint. Challenge
/// powers continue while this family's numerator starts from zero.
#[inline(always)]
pub fn fold_pair_rows_constraints<
    F: Radix2Field,
    Source: Copy,
    Row: AirColumnView<F, Source>,
    Next: AirColumnView<F, Source>,
>(
    _ checkpoint: ConstraintFoldCheckpoint<F, 653>,
    _ source: Source,
    _ c_re: SignedAirValue<F>,
    _ c_im: SignedAirValue<F>,
    _ row_view: ref Row,
    _ next_view: ref Next,
) -> PairRowsConstraintCheckpoint<F> {
    let row = row_from_view<F, Source, Row>(source, row_view)
    let next = row_from_view<F, Source, Next>(source, next_view)
    let one = one<F>()
    let continue_selector = mul(row.active, sub(one, row.terminal))
    let freeze_selector = add(row.terminal, sub(one, row.active))
    let mut fold = fold_from_checkpoint<F, 653>(checkpoint)
    let all_rows = fold.value

    fold = fold.next_family()
    fold = absorb_residuals<F, 5>(fold, row_state_residuals(row))
    fold = absorb_residuals<F, 5>(fold, row_state_residuals(next))
    fold = fold.absorb(mul(continue_selector, sub(next.active, one)))
    fold = fold.absorb(mul(freeze_selector, next.active))
    fold = fold.absorb(mul(freeze_selector, next.terminal))
    let row_words = air_words(row)
    let next_words = air_words(next)
    let mut column: usize = 0
    while column < 15 {
        fold = fold.absorb(mul(freeze_selector, sub(next_words[column], row_words[column])))
        column = column + 1
    }
    let transition = transition_residuals(c_re, c_im, row, next)
    column = 0
    while column < 9 {
        fold = fold.absorb(mul(continue_selector, transition[column]))
        column = column + 1
    }
    PairRowsConstraintCheckpoint<F> {
        fold: checkpoint_from_fold<F, 690>(fold),
        all_rows: all_rows,
    }
}

/// Fold the first-row family without rebuilding the preceding pair-row work.
#[inline(always)]
pub fn fold_first_row_constraints<
    F: Radix2Field,
    Source: Copy,
    Row: AirColumnView<F, Source>,
>(
    _ checkpoint: PairRowsConstraintCheckpoint<F>,
    _ source: Source,
    _ row_view: ref Row,
) -> FirstRowConstraintCheckpoint<F> {
    let row = row_from_view<F, Source, Row>(source, row_view)
    let one = one<F>()
    let pair_rows = checkpoint.fold.value
    let mut fold = fold_from_checkpoint<F, 690>(checkpoint.fold).next_family()
    fold = absorb_residuals<F, 5>(fold, row_state_residuals(row))
    fold = fold.absorb(sub(row.active, one))
    fold = fold.absorb(row.terminal)
    fold = fold.absorb(row.step)
    fold = fold.absorb(row.zr.sign)
    fold = fold.absorb(row.zr.magnitude)
    fold = fold.absorb(row.zi.sign)
    fold = fold.absorb(row.zi.magnitude)
    FirstRowConstraintCheckpoint<F> {
        fold: checkpoint_from_fold<F, 702>(fold),
        all_rows: checkpoint.all_rows,
        pair_rows: pair_rows,
    }
}

/// Fold the last-row family and retain the four nominal numerator families.
#[inline(always)]
pub fn fold_last_row_constraints<
    F: Radix2Field,
    Source: Copy,
    Row: AirColumnView<F, Source>,
>(
    _ checkpoint: FirstRowConstraintCheckpoint<F>,
    _ source: Source,
    _ row_view: ref Row,
) -> ConstraintNumeratorCheckpoint<F> {
    let row = row_from_view<F, Source, Row>(source, row_view)
    let one = one<F>()
    let first_row = checkpoint.fold.value
    let mut fold = fold_from_checkpoint<F, 702>(checkpoint.fold).next_family()
    fold = absorb_residuals<F, 5>(fold, row_state_residuals(row))
    fold = fold.absorb(mul(row.active, sub(one, row.terminal)))
    ConstraintNumeratorCheckpoint<F> {
        fold: checkpoint_from_fold<F, 708>(fold),
        all_rows: checkpoint.all_rows,
        pair_rows: checkpoint.pair_rows,
        first_row: first_row,
    }
}

/// Project the completed typed fold boundary into the four semantic numerator
/// families consumed by the shared zerofier calculation.
#[inline(always)]
pub fn constraint_numerators_from_checkpoint<F: Radix2Field>(
    _ checkpoint: ConstraintNumeratorCheckpoint<F>,
) -> ConstraintNumerators<F> {
    ConstraintNumerators<F> {
        all_rows: checkpoint.all_rows,
        pair_rows: checkpoint.pair_rows,
        first_row: checkpoint.first_row,
        last_row: checkpoint.fold.value,
    }
}

/// Complete the pair, first-row, and last-row families from the exact
/// all-rows checkpoint. This scalar facade composes the same typed boundaries
/// used by staged placement interpreters.
#[inline(always)]
pub fn finish_constraint_numerators<
    F: Radix2Field,
    Source: Copy,
    Row: AirColumnView<F, Source>,
    Next: AirColumnView<F, Source>,
>(
    _ checkpoint: ConstraintFoldCheckpoint<F, 653>,
    _ source: Source,
    _ c_re: SignedAirValue<F>,
    _ c_im: SignedAirValue<F>,
    _ row_view: ref Row,
    _ next_view: ref Next,
) -> ConstraintNumerators<F> {
    let pair_rows = fold_pair_rows_constraints<F, Source, Row, Next>(
        checkpoint, source, c_re, c_im, row_view, next_view,
    )
    let first_row = fold_first_row_constraints<F, Source, Row>(
        pair_rows, source, row_view,
    )
    constraint_numerators_from_checkpoint(
        fold_last_row_constraints<F, Source, Row>(first_row, source, row_view),
    )
}

/// Fold all 708 constraints with consecutive powers of one transcript-derived
/// challenge. The four outputs remain separate because their zerofiers differ.
pub fn constraint_numerators<
    F: Radix2Field,
    Source: Copy,
    Row: AirColumnView<F, Source>,
    Next: AirColumnView<F, Source>,
>(
    _ source: Source,
    _ challenge: F,
    _ c_re: SignedAirValue<F>,
    _ c_im: SignedAirValue<F>,
    _ row_view: ref Row,
    _ next_view: ref Next,
) -> ConstraintNumerators<F> {
    let fold0 = begin_constraint_fold<F>(challenge)
    let fold78 = fold_local_step_constraints<F, Source, Row>(
        fold0, source, row_view,
    )
    let fold174 = fold_orbit_coordinate_constraints<F, Source, Row>(
        fold78, source, row_view,
    )
    let fold265 = fold_real_square_constraints<F, Source, Row>(
        fold174, source, row_view,
    )
    let fold356 = fold_imaginary_square_constraints<F, Source, Row>(
        fold265, source, row_view,
    )
    let fold450 = fold_real_quotient_constraints<F, Source, Row>(
        fold356, source, row_view,
    )
    let fold547 = fold_imaginary_quotient_constraints<F, Source, Row>(
        fold450, source, row_view,
    )
    let fold653 = fold_magnitude_terminal_constraints<F, Source, Row>(
        fold547, source, row_view,
    )
    finish_constraint_numerators<F, Source, Row, Next>(
        fold653, source, c_re, c_im, row_view, next_view,
    )
}

/// Divide the four AIR numerator families by their trace-domain zerofiers.
///
/// The trace size is a type-level parameter so the same denotation serves the
/// four-row protocol checkpoint and later recursive leaf chunks. A backend may
/// schedule its field operations differently, but it does not receive a
/// second composition formula.
pub fn composition_value<F: Radix2Field, const N: usize>(
    _ point: F,
    _ numerators: ConstraintNumerators<F>,
) -> CompositionValue<F>
where N > 0, N > 1, { (N & (N - 1)) == 0 },
{
    let one = one<F>()
    let last_trace_point = F::radix2_root(radix2_log<N>()).radix2_inverse_or_zero()
    let trace_zerofier = sub(point.radix2_pow(N.downcast_truncate()), one)
    let first_zerofier = sub(point, one)
    let last_zerofier = sub(point, last_trace_point)
    if trace_zerofier.radix2_is_zero()
        || first_zerofier.radix2_is_zero()
        || last_zerofier.radix2_is_zero() {
        return invalid_composition_value<F>()
    }
    let trace_inverse = trace_zerofier.radix2_inverse_or_zero()
    CompositionValue<F> {
        valid: true,
        value: add(
            add(
                mul(numerators.all_rows, trace_inverse),
                mul(mul(numerators.pair_rows, last_zerofier), trace_inverse),
            ),
            add(
                mul(numerators.first_row, first_zerofier.radix2_inverse_or_zero()),
                mul(numerators.last_row, last_zerofier.radix2_inverse_or_zero()),
            ),
        ),
    }
}

/// Derive the four LDE positions needed to check one transition constraint at
/// transcript-selected `x` and `-x`.
pub fn radix2_query_geometry<const TRACE: usize, const LDE: usize>(
    _ query_index: u32,
) -> Radix2QueryGeometry
where
    TRACE > 1,
    LDE > TRACE,
    { (TRACE & (TRACE - 1)) == 0 },
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
{
    let lde: u32 = LDE.downcast_truncate()
    let half: u32 = (LDE / 2).downcast_truncate()
    let stride: u32 = (LDE / TRACE).downcast_truncate()
    if query_index >= half {
        return invalid_query_geometry()
    }
    let next = (query_index + stride) % lde
    let negative = query_index + half
    Radix2QueryGeometry {
        valid: true,
        evaluation: query_index,
        next_evaluation: next,
        negative_evaluation: negative,
        negative_next_evaluation: (negative + stride) % lde,
        local_index: query_index % stride,
    }
}
