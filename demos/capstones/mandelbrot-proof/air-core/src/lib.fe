//! Field-generic interpretation of the bounded Mandelbrot AIR.
//!
//! A column view supplies main and auxiliary values in an arbitrary radix-2
//! field. One constraint fold then serves BN254, BabyBear's quartic challenge
//! field, scalar Wasm, and the eventual WebGPU schedule. The authored AIR has
//! no field-specific column IDs, challenge tables, or backend branch.

use core::marker::Copy
pub use fri_structure::{
    FriQueryPlan,
    FriQueryPlanDone,
    FriQueryPlanMetadata,
    FriQueryPlanSample,
    FriQueryPlanShape,
    FriQueryRangePlan,
    FriSchedule,
    FriScheduleDone,
    FriScheduleFold,
    FriScheduleMetadata,
    FriSchedulePlacement,
    FriScheduleShape,
    fri_multi_leaf_capacity,
    fri_multi_sibling_capacity,
    fri_query_range_identity,
}
use precision::polynomial::{Radix2Field, radix2_log}

/// A zero-sized placement for rows which carry their column values inline.
/// Keeping this nominal avoids a backend-flavoured dummy word at scalar call
/// sites while letting resource-backed placements supply a real typed source.
pub struct InlineAirColumns {}
impl Copy for InlineAirColumns {}

pub const INLINE_AIR_COLUMNS: InlineAirColumns = InlineAirColumns {}

/// A semantic position in the canonical 17 main and 411 auxiliary columns.
///
/// Prover views may interpolate directly from semantic trace rows. Verifier
/// views may read authenticated LDE rows. `Source` selects the physical
/// placement independently: inline values, typed memory, or a GPU resource.
/// Every placement is interpreted by the same constraint function below.
pub trait AirColumnView<F: Radix2Field, Source: Copy>: Copy {
    fn main(ref self, _ source: Source, _ column: usize) -> F
    fn auxiliary(ref self, _ source: Source, _ column: usize) -> F
}

pub struct SignedAirValue<F: Radix2Field> {
    pub sign: F,
    pub magnitude: F,
    pub value: F,
}
impl<F: Radix2Field> Copy for SignedAirValue<F> {}

pub struct ConstraintNumerators<F: Radix2Field> {
    pub all_rows: F,
    pub pair_rows: F,
    pub first_row: F,
    pub last_row: F,
}
impl<F: Radix2Field> Copy for ConstraintNumerators<F> {}

pub struct CompositionValue<F: Radix2Field> {
    pub valid: bool,
    pub value: F,
}
impl<F: Radix2Field> Copy for CompositionValue<F> {}

/// Runtime positions derived from one compile-time radix-two STARK domain.
/// The query itself is transcript-selected, while trace size, LDE size, row
/// stride, and negation offset specialize away through const generics.
pub struct Radix2QueryGeometry {
    pub valid: bool,
    pub evaluation: u32,
    pub next_evaluation: u32,
    pub negative_evaluation: u32,
    pub negative_next_evaluation: u32,
    pub local_index: u32,
}
impl Copy for Radix2QueryGeometry {}

struct AirRow<F: Radix2Field> {
    active: F,
    terminal: F,
    step: F,
    zr: SignedAirValue<F>,
    zi: SignedAirValue<F>,
    rr: F,
    ii: F,
    magnitude: F,
    q_re: SignedAirValue<F>,
    r_re: F,
    q_im: SignedAirValue<F>,
    r_im: F,
    air_terminal: F,
}
impl<F: Radix2Field> Copy for AirRow<F> {}

fn zero<F: Radix2Field>() -> F { F::radix2_zero() }
fn one<F: Radix2Field>() -> F { F::radix2_root(0) }
fn add<F: Radix2Field>(_ left: F, _ right: F) -> F { left.radix2_add(right) }
fn sub<F: Radix2Field>(_ left: F, _ right: F) -> F { left.radix2_sub(right) }
fn mul<F: Radix2Field>(_ left: F, _ right: F) -> F { left.radix2_mul(right) }

fn invalid_composition_value<F: Radix2Field>() -> CompositionValue<F> {
    CompositionValue<F> { valid: false, value: zero<F>() }
}

fn invalid_query_geometry() -> Radix2QueryGeometry {
    Radix2QueryGeometry {
        valid: false,
        evaluation: 0,
        next_evaluation: 0,
        negative_evaluation: 0,
        negative_next_evaluation: 0,
        local_index: 0,
    }
}

fn natural<F: Radix2Field>(_ value: u32) -> F {
    let mut result = zero<F>()
    let mut place = one<F>()
    let mut value = value
    while value != 0 {
        if (value & 1) == 1 { result = add(result, place) }
        place = add(place, place)
        value = value >> 1
    }
    result
}

pub fn signed_air_value<F: Radix2Field>(
    _ sign: F,
    _ magnitude: F,
) -> SignedAirValue<F> {
    let value = sub(magnitude, mul(mul(sign, magnitude), natural<F>(2)))
    SignedAirValue<F> { sign: sign, magnitude: magnitude, value: value }
}

fn bit_residual<F: Radix2Field>(_ word: F) -> F {
    mul(word, sub(word, one<F>()))
}

fn row_from_view<
    F: Radix2Field,
    Source: Copy,
    V: AirColumnView<F, Source>,
>(
    _ source: Source,
    _ view: ref V,
) -> AirRow<F> {
    AirRow<F> {
        active: view.main(source, 15),
        terminal: view.main(source, 16),
        step: view.main(source, 0),
        zr: signed_air_value<F>(view.main(source, 1), view.main(source, 2)),
        zi: signed_air_value<F>(view.main(source, 3), view.main(source, 4)),
        rr: view.main(source, 5),
        ii: view.main(source, 6),
        magnitude: view.main(source, 7),
        q_re: signed_air_value<F>(view.main(source, 8), view.main(source, 9)),
        r_re: view.main(source, 10),
        q_im: signed_air_value<F>(view.main(source, 11), view.main(source, 12)),
        r_im: view.main(source, 13),
        air_terminal: view.main(source, 14),
    }
}

fn air_words<F: Radix2Field>(_ row: AirRow<F>) -> [F; 15] {
    [
        row.step,
        row.zr.sign,
        row.zr.magnitude,
        row.zi.sign,
        row.zi.magnitude,
        row.rr,
        row.ii,
        row.magnitude,
        row.q_re.sign,
        row.q_re.magnitude,
        row.r_re,
        row.q_im.sign,
        row.q_im.magnitude,
        row.r_im,
        row.air_terminal,
    ]
}

fn local_residuals<F: Radix2Field>(_ row: AirRow<F>) -> [F; 9] {
    let scale = natural<F>(4096)
    [
        bit_residual(row.zr.sign),
        bit_residual(row.zi.sign),
        bit_residual(row.q_re.sign),
        bit_residual(row.q_im.sign),
        sub(row.rr, mul(row.zr.value, row.zr.value)),
        sub(row.ii, mul(row.zi.value, row.zi.value)),
        sub(sub(row.magnitude, row.rr), row.ii),
        sub(sub(sub(row.rr, row.ii), mul(scale, row.q_re.value)), row.r_re),
        sub(
            sub(mul(natural<F>(2), mul(row.zr.value, row.zi.value)), mul(scale, row.q_im.value)),
            row.r_im,
        ),
    ]
}

fn row_state_residuals<F: Radix2Field>(_ row: AirRow<F>) -> [F; 5] {
    let one = one<F>()
    [
        bit_residual(row.active),
        bit_residual(row.terminal),
        bit_residual(row.air_terminal),
        sub(row.terminal, mul(row.active, row.air_terminal)),
        mul(sub(one, row.active), sub(row.air_terminal, one)),
    ]
}

fn transition_residuals<F: Radix2Field>(
    _ c_re: SignedAirValue<F>,
    _ c_im: SignedAirValue<F>,
    _ row: AirRow<F>,
    _ next: AirRow<F>,
) -> [F; 9] {
    [
        bit_residual(c_re.sign),
        bit_residual(c_im.sign),
        bit_residual(row.q_re.sign),
        bit_residual(row.q_im.sign),
        bit_residual(next.zr.sign),
        bit_residual(next.zi.sign),
        sub(sub(next.step, row.step), one<F>()),
        sub(sub(next.zr.value, row.q_re.value), c_re.value),
        sub(sub(next.zi.value, row.q_im.value), c_im.value),
    ]
}

struct ConstraintFold<F: Radix2Field> { challenge: F, power: F, value: F }
impl<F: Radix2Field> Copy for ConstraintFold<F> {}

/// A serializable boundary in the canonical 708-constraint fold.
///
/// `ABSORBED` brands the exact semantic position. Placement interpreters may
/// persist `power` and `value` between dispatches, but cannot feed a checkpoint
/// to the wrong successor without a type error. The challenge is restored from
/// the same transcript-owned value at every physical boundary.
pub struct ConstraintFoldCheckpoint<F: Radix2Field, const ABSORBED: usize> {
    challenge: F,
    power: F,
    value: F,
}
impl<F: Radix2Field, const ABSORBED: usize> Copy
    for ConstraintFoldCheckpoint<F, ABSORBED> {}

/// Boundary after the ordered pair-row constraint family. `all_rows` is
/// retained because it has a distinct zerofier from the new fold value.
pub struct PairRowsConstraintCheckpoint<F: Radix2Field> {
    fold: ConstraintFoldCheckpoint<F, 690>,
    all_rows: F,
}
impl<F: Radix2Field> Copy for PairRowsConstraintCheckpoint<F> {}

/// Boundary after the ordered first-row constraint family. Earlier family
/// numerators remain nominal fields instead of anonymous placement slots.
pub struct FirstRowConstraintCheckpoint<F: Radix2Field> {
    fold: ConstraintFoldCheckpoint<F, 702>,
    all_rows: F,
    pair_rows: F,
}
impl<F: Radix2Field> Copy for FirstRowConstraintCheckpoint<F> {}

/// Boundary after all 708 constraints. The final fold value is the last-row
/// numerator; the other families are retained for zerofier projection.
pub struct ConstraintNumeratorCheckpoint<F: Radix2Field> {
    fold: ConstraintFoldCheckpoint<F, 708>,
    all_rows: F,
    pair_rows: F,
    first_row: F,
}
impl<F: Radix2Field> Copy for ConstraintNumeratorCheckpoint<F> {}

impl<F: Radix2Field> ConstraintFold<F> {
    #[inline(always)]
    fn new(_ challenge: F) -> Self {
        Self { challenge: challenge, power: one<F>(), value: zero<F>() }
    }

    #[inline(always)]
    fn absorb(self, _ residual: F) -> Self {
        Self {
            challenge: self.challenge,
            power: mul(self.power, self.challenge),
            value: add(self.value, mul(self.power, residual)),
        }
    }

    #[inline(always)]
    fn next_family(self) -> Self {
        Self {
            challenge: self.challenge,
            power: self.power,
            value: zero<F>(),
        }
    }
}

#[inline(always)]
fn checkpoint_from_fold<F: Radix2Field, const ABSORBED: usize>(
    _ fold: ConstraintFold<F>,
) -> ConstraintFoldCheckpoint<F, ABSORBED> {
    ConstraintFoldCheckpoint<F, ABSORBED> {
        challenge: fold.challenge,
        power: fold.power,
        value: fold.value,
    }
}

#[inline(always)]
fn fold_from_checkpoint<F: Radix2Field, const ABSORBED: usize>(
    _ checkpoint: ConstraintFoldCheckpoint<F, ABSORBED>,
) -> ConstraintFold<F> {
    ConstraintFold<F> {
        challenge: checkpoint.challenge,
        power: checkpoint.power,
        value: checkpoint.value,
    }
}

/// Rebuild a typed placement checkpoint from authenticated scratch words.
/// The caller supplies the transcript-owned challenge rather than persisting
/// a second mutable copy of it.
#[inline(always)]
pub fn restore_constraint_fold<F: Radix2Field, const ABSORBED: usize>(
    _ challenge: F,
    _ power: F,
    _ value: F,
) -> ConstraintFoldCheckpoint<F, ABSORBED> {
    ConstraintFoldCheckpoint<F, ABSORBED> {
        challenge: challenge,
        power: power,
        value: value,
    }
}

#[inline(always)]
pub fn constraint_fold_power<F: Radix2Field, const ABSORBED: usize>(
    _ checkpoint: ConstraintFoldCheckpoint<F, ABSORBED>,
) -> F {
    checkpoint.power
}

#[inline(always)]
pub fn constraint_fold_value<F: Radix2Field, const ABSORBED: usize>(
    _ checkpoint: ConstraintFoldCheckpoint<F, ABSORBED>,
) -> F {
    checkpoint.value
}

