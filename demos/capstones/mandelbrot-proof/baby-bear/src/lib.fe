    pub main: LdeMultiOpening<
        MainRole,
        [BabyBear; MAIN_LDE_ROW_FIELDS],
        AIR_MAX_LEAVES,
        AIR_MAX_SIBLINGS,
    >,
    pub auxiliary: LdeMultiOpening<
