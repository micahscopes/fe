/// Value-level terminal produced by interpreting `FriQueryPlanDone`.
pub struct FriQueryIndicesDone<const NEXT_QUERY: u32> {}
impl<const NEXT_QUERY: u32> core::marker::Copy for FriQueryIndicesDone<NEXT_QUERY> {}

/// One typed sampled index followed by the remaining query-plan result.
pub struct FriQueryIndicesSample<const QUERY: u32, Tail> {
    pub current: FriQueryIndex<QUERY>,
    pub tail: Tail,
}
impl<const QUERY: u32, Tail: core::marker::Copy> core::marker::Copy
    for FriQueryIndicesSample<QUERY, Tail> {}

/// Fixed-capacity pair-leaf requests derived from a typed query sample list.
/// Duplicates are retained here and normalized once by `MerkleMultiPath`.
pub struct FriQueryLeafRequests<const MAX_REQUESTS: usize> {
    pub valid: bool,
    pub count: u32,
    pub indices: [u32; MAX_REQUESTS],
}
impl<const MAX_REQUESTS: usize> core::marker::Copy
    for FriQueryLeafRequests<MAX_REQUESTS> {}

/// Four AIR LDE row positions per typed Fiat-Shamir sample. Duplicates remain
/// explicit until the canonical sparse Merkle opener normalizes them.
pub struct AirLdeLeafRequests<const MAX_REQUESTS: usize> {
    pub valid: bool,
    pub count: u32,
    pub indices: [u32; MAX_REQUESTS],
}
impl<const MAX_REQUESTS: usize> core::marker::Copy
    for AirLdeLeafRequests<MAX_REQUESTS> {}

/// Derive the value carrier for a field-neutral query plan.
pub trait BabyBearFriQueryPlanShape {
    type Samples
}

impl<const NEXT_QUERY: u32> BabyBearFriQueryPlanShape for FriQueryPlanDone<NEXT_QUERY> {
    type Samples = FriQueryIndicesDone<NEXT_QUERY>
}

impl<const QUERY: u32, Tail: BabyBearFriQueryPlanShape> BabyBearFriQueryPlanShape
    for FriQueryPlanSample<QUERY, Tail>
{
    type Samples = FriQueryIndicesSample<
        QUERY,
        <Tail as BabyBearFriQueryPlanShape>::Samples,
    >
}

/// Interpret the field-neutral query plan into independently domain-separated
/// BabyBear indices. `Samples` is an ordinary type parameter because Fe does
/// not yet normalize an associated result in every generic method comparison.
/// The plan, not handwritten call sites, still owns the complete query list.
pub trait BabyBearFriQueryPlan<const ROUND: u32, const HALF: usize, Samples>:
    BabyBearFriQueryPlanShape
{
    fn invalid_fri_query_samples() -> Samples
    fn sample_fri_queries(
        _ transcript: FriLayerTranscriptDigest<ROUND>,
    ) -> (bool, Samples)
}

impl<
    const ROUND: u32,
    const HALF: usize,
    const NEXT_QUERY: u32,
> BabyBearFriQueryPlan<ROUND, HALF, FriQueryIndicesDone<NEXT_QUERY>>
    for FriQueryPlanDone<NEXT_QUERY>
where
    { ROUND > 0 },
    { ROUND < 100 },
    HALF > 0,
    { (HALF & (HALF - 1)) == 0 },
    { HALF <= 134217728 },
{
    fn invalid_fri_query_samples() -> FriQueryIndicesDone<NEXT_QUERY> {
        FriQueryIndicesDone<NEXT_QUERY> {}
    }

    fn sample_fri_queries(
        _ transcript: FriLayerTranscriptDigest<ROUND>,
    ) -> (bool, FriQueryIndicesDone<NEXT_QUERY>) {
        (transcript.valid, FriQueryIndicesDone<NEXT_QUERY> {})
    }
}

impl<
    const ROUND: u32,
    const HALF: usize,
    const QUERY: u32,
    Tail,
    TailSamples,
> BabyBearFriQueryPlan<
    ROUND,
    HALF,
    FriQueryIndicesSample<QUERY, TailSamples>,
> for FriQueryPlanSample<QUERY, Tail>
where
    { ROUND > 0 },
    { ROUND < 100 },
    { QUERY > 0 },
    { QUERY < BABY_BEAR_MODULUS },
    HALF > 0,
    { (HALF & (HALF - 1)) == 0 },
    { HALF <= 134217728 },
    Tail: BabyBearFriQueryPlan<ROUND, HALF, TailSamples>,
    TailSamples: core::marker::Copy,
{
    fn invalid_fri_query_samples() -> FriQueryIndicesSample<QUERY, TailSamples> {
        FriQueryIndicesSample {
            current: FriQueryIndex<QUERY> { valid: false, value: 0 },
            tail: <Tail as BabyBearFriQueryPlan<
                ROUND,
                HALF,
                TailSamples,
            >>::invalid_fri_query_samples(),
        }
    }

    fn sample_fri_queries(
        _ transcript: FriLayerTranscriptDigest<ROUND>,
    ) -> (
        bool,
        FriQueryIndicesSample<QUERY, TailSamples>,
    ) {
        if !transcript.valid {
            return (
                false,
                FriQueryIndicesSample {
                    current: FriQueryIndex<QUERY> { valid: false, value: 0 },
                    tail: <Tail as BabyBearFriQueryPlan<
                        ROUND,
                        HALF,
                        TailSamples,
                    >>::invalid_fri_query_samples(),
                },
            )
        }
        let current = fri_query_index_power_of_two<QUERY, HALF>(
            fri_query_challenge<ROUND, QUERY>(transcript),
        )
        let tail = <Tail as BabyBearFriQueryPlan<ROUND, HALF, TailSamples>>::sample_fri_queries(
            transcript,
        )
        if !current.valid || !tail.0 {
            return (
                false,
                FriQueryIndicesSample {
                    current: FriQueryIndex<QUERY> { valid: false, value: 0 },
                    tail: <Tail as BabyBearFriQueryPlan<
                        ROUND,
                        HALF,
                        TailSamples,
                    >>::invalid_fri_query_samples(),
                },
            )
        }
        (
            true,
            FriQueryIndicesSample {
                current: current,
                tail: tail.1,
            },
        )
    }
}

pub type CheckpointFriQueryPlan4 = FriQueryPlan<1, 4>
pub type CheckpointFriQuerySamples4 =
    <CheckpointFriQueryPlan4 as BabyBearFriQueryPlanShape>::Samples

/// Interpret typed query samples into the two leaves needed at one binary FRI
/// layer. Applying the same plan at successively smaller `HALF` values derives
/// every round's local pair positions without mutating the original samples.
pub trait BabyBearFriPairRequests<
    const HALF: usize,
    const MAX_REQUESTS: usize,
    Samples,
>: BabyBearFriQueryPlanShape {
    fn fri_pair_requests(_ samples: Samples) -> FriQueryLeafRequests<MAX_REQUESTS>
}

impl<
    const HALF: usize,
    const MAX_REQUESTS: usize,
    const NEXT_QUERY: u32,
> BabyBearFriPairRequests<HALF, MAX_REQUESTS, FriQueryIndicesDone<NEXT_QUERY>>
    for FriQueryPlanDone<NEXT_QUERY>
where
    HALF > 0,
    { (HALF & (HALF - 1)) == 0 },
{
    fn fri_pair_requests(
        _ samples: FriQueryIndicesDone<NEXT_QUERY>,
    ) -> FriQueryLeafRequests<MAX_REQUESTS> {
        FriQueryLeafRequests {
            valid: true,
            count: 0,
            indices: [0; MAX_REQUESTS],
        }
    }
}

impl<
    const HALF: usize,
    const MAX_REQUESTS: usize,
    const QUERY: u32,
    Tail,
    TailSamples,
> BabyBearFriPairRequests<
    HALF,
    MAX_REQUESTS,
    FriQueryIndicesSample<QUERY, TailSamples>,
> for FriQueryPlanSample<QUERY, Tail>
where
    HALF > 0,
    { (HALF & (HALF - 1)) == 0 },
    Tail: BabyBearFriPairRequests<HALF, MAX_REQUESTS, TailSamples>,
    TailSamples: core::marker::Copy,
{
    fn fri_pair_requests(
        _ samples: FriQueryIndicesSample<QUERY, TailSamples>,
    ) -> FriQueryLeafRequests<MAX_REQUESTS> {
        if !samples.current.valid {
            return FriQueryLeafRequests {
                valid: false,
                count: 0,
                indices: [0; MAX_REQUESTS],
            }
        }
        let tail = <Tail as BabyBearFriPairRequests<
            HALF,
            MAX_REQUESTS,
            TailSamples,
        >>::fri_pair_requests(samples.tail)
        let tail_count: usize = tail.count as usize
        if !tail.valid || tail_count + 2 > MAX_REQUESTS {
            return FriQueryLeafRequests {
                valid: false,
                count: 0,
                indices: [0; MAX_REQUESTS],
            }
        }
        let half: u32 = HALF.downcast_truncate()
        let local = samples.current.value & (half - 1)
        let mut indices = [0; MAX_REQUESTS]
        indices[0] = local
        indices[1] = local + half
        let mut cursor: usize = 0
        while cursor < tail_count {
            indices[cursor + 2] = tail.indices[cursor]
            cursor = cursor + 1
        }
        FriQueryLeafRequests {
            valid: true,
            count: tail.count + 2,
            indices: indices,
        }
    }
}

/// Interpret each typed Fiat-Shamir sample into the current, next, negative,
/// and negative-next AIR LDE positions required by the shared constraint body.
pub trait BabyBearAirLdeRequests<
    const TRACE: usize,
    const LDE: usize,
    const MAX_REQUESTS: usize,
    Samples,
>: BabyBearFriQueryPlanShape {
    fn air_lde_requests(_ samples: Samples) -> AirLdeLeafRequests<MAX_REQUESTS>
}

impl<
    const TRACE: usize,
    const LDE: usize,
    const MAX_REQUESTS: usize,
    const NEXT_QUERY: u32,
> BabyBearAirLdeRequests<
    TRACE,
    LDE,
    MAX_REQUESTS,
    FriQueryIndicesDone<NEXT_QUERY>,
> for FriQueryPlanDone<NEXT_QUERY>
where
    TRACE > 1,
    LDE > 1,
    LDE > TRACE,
    { (TRACE & (TRACE - 1)) == 0 },
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
{
    fn air_lde_requests(
        _ samples: FriQueryIndicesDone<NEXT_QUERY>,
    ) -> AirLdeLeafRequests<MAX_REQUESTS> {
        AirLdeLeafRequests { valid: true, count: 0, indices: [0; MAX_REQUESTS] }
    }
}

impl<
    const TRACE: usize,
    const LDE: usize,
    const MAX_REQUESTS: usize,
    const QUERY: u32,
    Tail,
    TailSamples: core::marker::Copy,
> BabyBearAirLdeRequests<
    TRACE,
    LDE,
    MAX_REQUESTS,
    FriQueryIndicesSample<QUERY, TailSamples>,
> for FriQueryPlanSample<QUERY, Tail>
where
    TRACE > 1,
    LDE > 1,
    LDE > TRACE,
    { (TRACE & (TRACE - 1)) == 0 },
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
    Tail: BabyBearAirLdeRequests<TRACE, LDE, MAX_REQUESTS, TailSamples>,
{
    fn air_lde_requests(
        _ samples: FriQueryIndicesSample<QUERY, TailSamples>,
    ) -> AirLdeLeafRequests<MAX_REQUESTS> {
        let geometry = radix2_query_geometry<TRACE, LDE>(samples.current.value)
        let tail = <Tail as BabyBearAirLdeRequests<
            TRACE,
            LDE,
            MAX_REQUESTS,
            TailSamples,
        >>::air_lde_requests(samples.tail)
        let tail_count: usize = tail.count as usize
        if !samples.current.valid || !geometry.valid || !tail.valid
            || tail_count + 4 > MAX_REQUESTS {
            return AirLdeLeafRequests {
                valid: false,
                count: 0,
                indices: [0; MAX_REQUESTS],
            }
        }
        let mut indices = [0; MAX_REQUESTS]
        indices[0] = geometry.evaluation
        indices[1] = geometry.next_evaluation
        indices[2] = geometry.negative_evaluation
        indices[3] = geometry.negative_next_evaluation
        let mut cursor: usize = 0
        while cursor < tail_count {
            indices[cursor + 4] = tail.indices[cursor]
            cursor = cursor + 1
        }
        AirLdeLeafRequests {
            valid: true,
            count: tail.count + 4,
            indices: indices,
        }
    }
}

pub struct FriLayerDigest<const ROUND: u32> { pub valid: bool, pub value: Poseidon2Digest }
impl<const ROUND: u32> core::marker::Copy for FriLayerDigest<ROUND> {}
derive CanonicalWords for FriLayerDigest<ROUND> using CanonicalWordsProvider

