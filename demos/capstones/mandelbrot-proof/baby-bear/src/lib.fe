pub fn bind_main_lde(
    _ transcript: own ProofTranscriptDigest,
    _ main: own MainLdeDigest,
) -> MainLdeTranscriptDigest {
    if !transcript.valid || !main.valid {
        return MainLdeTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    MainLdeTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotMainLdeTranscriptBabyBearV1>(
            transcript.value,
            main.value,
        ),
    }
}

pub fn bind_auxiliary_lde(
    _ transcript: own MainLdeTranscriptDigest,
    _ auxiliary: own AuxiliaryLdeDigest,
) -> AirLdeTranscriptDigest {
    if !transcript.valid || !auxiliary.valid {
        return AirLdeTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    AirLdeTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotAuxiliaryLdeTranscriptBabyBearV1>(
            transcript.value,
            auxiliary.value,
        ),
    }
}

pub fn bind_composition(
    _ transcript: own AirLdeTranscriptDigest,
    _ composition: own CompositionDigest,
) -> CompositionTranscriptDigest {
    if !transcript.valid || !composition.valid {
        return CompositionTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    CompositionTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotCompositionTranscriptBabyBearV1>(
            transcript.value,
            composition.value,
        ),
    }
}

pub fn fri_fold_challenge(
    _ transcript: own CompositionTranscriptDigest,
) -> FriFoldChallenge<1> {
    if !transcript.valid {
        return FriFoldChallenge<1> { valid: false, value: BabyBearExt4::zero() }
    }
    FriFoldChallenge<1> {
        valid: true,
        value: squeeze_ext4<MandelbrotFriFoldBabyBear<1>>(transcript.value),
    }
}

pub fn next_fri_fold_challenge<const PREVIOUS: u32, const ROUND: u32>(
    _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
) -> FriFoldChallenge<ROUND>
where { PREVIOUS > 0 }, { ROUND == PREVIOUS + 1 }, { ROUND < 100 }
{
    if !transcript.valid {
        return FriFoldChallenge<ROUND> { valid: false, value: BabyBearExt4::zero() }
    }
    FriFoldChallenge<ROUND> {
        valid: true,
        value: squeeze_ext4<MandelbrotFriFoldBabyBear<ROUND>>(transcript.value),
    }
}

pub fn fri_layer_row_commitment<const ROUND: u32>(
    _ value: BabyBearExt4,
) -> FriLayerDigest<ROUND>
where { ROUND > 0 }, { ROUND < 100 }
{
    FriLayerDigest<ROUND> {
        valid: true,
        value: commit_ext4_fields<MandelbrotFriLayerRowBabyBear<ROUND>, 1>([value]),
    }
}

pub fn fri_layer_root_power_of_two<const ROUND: u32, const N: usize>(
    _ leaves: own [FriLayerDigest<ROUND>; N],
) -> FriLayerDigest<ROUND>
where { ROUND > 0 }, { ROUND < 100 }, N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return FriLayerDigest<ROUND> { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    FriLayerDigest<ROUND> { valid: root.valid, value: root.value }
}

pub fn bind_first_fri_layer(
    _ transcript: own CompositionTranscriptDigest,
    _ layer: own FriLayerDigest<1>,
) -> FriLayerTranscriptDigest<1> {
    if !transcript.valid || !layer.valid {
        return FriLayerTranscriptDigest<1> { valid: false, value: Poseidon2Digest::zero() }
    }
    FriLayerTranscriptDigest<1> {
        valid: true,
        value: poseidon_bind<MandelbrotFriLayerTranscriptBabyBear<1>>(
            transcript.value,
            layer.value,
        ),
    }
}

pub fn bind_next_fri_layer<const PREVIOUS: u32, const ROUND: u32>(
    _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
    _ layer: own FriLayerDigest<ROUND>,
) -> FriLayerTranscriptDigest<ROUND>
where { PREVIOUS > 0 }, { ROUND == PREVIOUS + 1 }, { ROUND < 100 }
{
    if !transcript.valid || !layer.valid {
        return FriLayerTranscriptDigest<ROUND> { valid: false, value: Poseidon2Digest::zero() }
    }
    FriLayerTranscriptDigest<ROUND> {
        valid: true,
        value: poseidon_bind<MandelbrotFriLayerTranscriptBabyBear<ROUND>>(
            transcript.value,
            layer.value,
        ),
    }
}
