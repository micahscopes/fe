pub type BabyBearAirMultiOpenings<
    const AIR_MAX_LEAVES: usize,
    const AIR_MAX_SIBLINGS: usize,
> = AirMultiOpenings<
    MainLdeTreeRole,
    AuxiliaryLdeTreeRole,
    AIR_MAX_LEAVES,
