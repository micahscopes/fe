    LDE <= 2147483648,
    { (TRACE & (TRACE - 1)) == 0 },
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
    REQUESTS > 0,
    MAX_LEAVES > 0,
    Plan: BabyBearAirLdeRequests<TRACE, LDE, REQUESTS, Samples>,
{
    let requests = <Plan as BabyBearAirLdeRequests<
        TRACE,
        LDE,
        REQUESTS,
        Samples,
    >>::air_lde_requests(samples)
    if !requests.valid || requests.count != REQUESTS.downcast_truncate() {
        reset_auxiliary_lde_multi_opening<MAX_LEAVES, MAX_SIBLINGS>(mut opening)
        return false
    }
    write_auxiliary_lde_multi_opening_power_of_two<
        LDE,
        REQUESTS,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(ref rows, requests.indices, mut opening)
}

pub fn verify_main_lde_multi_opening<
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ opening: ref MainLdeMultiOpening<MAX_LEAVES, MAX_SIBLINGS>,
    _ root: own MainLdeDigest,
) -> bool
where
    N > 1,
    N <= MAX_PADDED_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
    MAX_LEAVES > 0,
{
    if !opening.valid || !root.valid { return false }
    let count: usize = opening.path.leaf_count as usize
    if count == 0 || count > MAX_LEAVES { return false }
    let mut leaves = [Poseidon2Digest::zero(); MAX_LEAVES]
    let mut cursor: usize = 0
    while cursor < count {
        leaves[cursor] = main_lde_row_commitment(opening.values[cursor]).value
        cursor = cursor + 1
    }
    while cursor < MAX_LEAVES {
        let mut column: usize = 0
        while column < MAIN_LDE_ROW_FIELDS {
            if !opening.values[cursor][column].is_zero() { return false }
            column = column + 1
        }
        cursor = cursor + 1
    }
    multi_verify<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(root.value, leaves, opening.path)
}

pub fn verify_auxiliary_lde_multi_opening<
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ opening: ref AuxiliaryLdeMultiOpening<MAX_LEAVES, MAX_SIBLINGS>,
    _ root: own AuxiliaryLdeDigest,
) -> bool
where
    N > 1,
    N <= MAX_PADDED_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
    MAX_LEAVES > 0,
{
    if !opening.valid || !root.valid { return false }
    let count: usize = opening.path.leaf_count as usize
    if count == 0 || count > MAX_LEAVES { return false }
    let mut leaves = [Poseidon2Digest::zero(); MAX_LEAVES]
    let mut cursor: usize = 0
    while cursor < count {
        leaves[cursor] = auxiliary_lde_row_commitment(opening.values[cursor]).value
        cursor = cursor + 1
    }
    while cursor < MAX_LEAVES {
        let mut column: usize = 0
        while column < AUXILIARY_ROW_BITS {
            if !opening.values[cursor][column].is_zero() { return false }
            column = column + 1
        }
        cursor = cursor + 1
    }
    multi_verify<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(root.value, leaves, opening.path)
}

fn sparse_air_lde_row<
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ main: ref MainLdeMultiOpening<MAX_LEAVES, MAX_SIBLINGS>,
    _ auxiliary: ref AuxiliaryLdeMultiOpening<MAX_LEAVES, MAX_SIBLINGS>,
    _ index: u32,
) -> (bool, AirLdeRow)
where MAX_LEAVES > 0
{
    if !main.valid || !main.path.valid || !auxiliary.valid || !auxiliary.path.valid {
        return (false, ZERO_AIR_LDE_ROW)
    }
    let main_count: usize = main.path.leaf_count as usize
    let auxiliary_count: usize = auxiliary.path.leaf_count as usize
    if main_count == 0 || main_count > MAX_LEAVES
        || auxiliary_count == 0 || auxiliary_count > MAX_LEAVES {
        return (false, ZERO_AIR_LDE_ROW)
    }
    let mut main_position: usize = MAX_LEAVES
    let mut cursor: usize = 0
    while cursor < main_count {
        if main.path.leaf_indices[cursor] == index { main_position = cursor }
        cursor = cursor + 1
    }
    let mut auxiliary_position: usize = MAX_LEAVES
    cursor = 0
    while cursor < auxiliary_count {
        if auxiliary.path.leaf_indices[cursor] == index { auxiliary_position = cursor }
        cursor = cursor + 1
    }
    if main_position == MAX_LEAVES || auxiliary_position == MAX_LEAVES {
        return (false, ZERO_AIR_LDE_ROW)
    }
    (
        true,
        AirLdeRow {
            main: main.values[main_position],
            auxiliary: auxiliary.values[auxiliary_position],
        },
    )
}

/// Recompute every transcript-selected AIR composition pair from the shared
/// sparse main and auxiliary openings. Authentication is deliberately kept in
/// the outer verifier so each Merkle path is checked exactly once.
fn verify_checkpoint4_sparse_air_compositions16(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ challenge: CompositionChallenge,
    _ shift: BabyBear,
    _ queries: FriQueryBuffer<4>,
    _ receipt: ref Checkpoint4BabyBearReceipt16,
) -> bool {
    if !challenge.valid || shift.is_zero() || !queries.valid || queries.count != 4 {
        return false
    }
    let mut cursor: usize = 0
    while cursor < 4 {
        let geometry = radix2_query_geometry<4, 16>(queries.indices[cursor])
        if !geometry.valid { return false }
        let current = sparse_air_lde_row(
            ref receipt.air.main,
            ref receipt.air.auxiliary,
            geometry.evaluation,
        )
        let next = sparse_air_lde_row(
            ref receipt.air.main,
            ref receipt.air.auxiliary,
            geometry.next_evaluation,
        )
        let negative = sparse_air_lde_row(
            ref receipt.air.main,
            ref receipt.air.auxiliary,
            geometry.negative_evaluation,
        )
        let negative_next = sparse_air_lde_row(
            ref receipt.air.main,
            ref receipt.air.auxiliary,
            geometry.negative_next_evaluation,
        )
        if !current.0 || !next.0 || !negative.0 || !negative_next.0 {
            return false
        }
        let positive_value = evaluate_composition_opened<4, 16>(
            c_re_q12,
            c_im_q12,
            challenge,
            shift,
            geometry.evaluation,
            ref current.1,
            ref next.1,
        )
        let negative_value = evaluate_composition_opened<4, 16>(
            c_re_q12,
            c_im_q12,
            challenge,
            shift,
            geometry.negative_evaluation,
            ref negative.1,
            ref negative_next.1,
        )
        let opened_positive = receipt.fri.composition.sparse_value(
            geometry.evaluation,
        )
        let opened_negative = receipt.fri.composition.sparse_value(
            geometry.negative_evaluation,
        )
        if !positive_value.valid || !negative_value.valid
            || !opened_positive.valid || !opened_negative.valid
            || !positive_value.value.equals(opened_positive.value)
            || !negative_value.value.equals(opened_negative.value) {
            return false
        }
        cursor = cursor + 1
    }
    true
}

fn invalid_lde_quartet_path<Role, const DEPTH: usize>() -> LdeQuartetPath<Role, DEPTH> {
    LdeQuartetPath<Role, DEPTH> {
        valid: false,
        index: 0,
        first_siblings: [Poseidon2Digest::zero(); DEPTH],
        second_siblings: [Poseidon2Digest::zero(); DEPTH],
        third_siblings: [Poseidon2Digest::zero(); DEPTH],
        fourth_siblings: [Poseidon2Digest::zero(); DEPTH],
    }
}

pub fn main_lde_quartet_path_power_of_two<
    const N: usize,
    const QUARTER: usize,
    const DEPTH: usize,
>(
    _ leaves: own [MainLdeDigest; N],
    _ index: u32,
) -> MainLdeQuartetPath<DEPTH>
where
    N > 3,
    N <= MAX_PADDED_TRACE_LENGTH,
    QUARTER > 0,
    { QUARTER + QUARTER + QUARTER + QUARTER == N },
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        if !leaves[cursor].valid {
            return invalid_lde_quartet_path<MainLdeTreeRole, DEPTH>()
        }
        raw[cursor] = leaves[cursor].value
        cursor = cursor + 1
    }
    let path = quartet_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        QUARTER,
        DEPTH,
    >(raw, index)
    LdeQuartetPath<MainLdeTreeRole, DEPTH> {
        valid: path.valid,
        index: path.index,
        first_siblings: path.first_siblings,
        second_siblings: path.second_siblings,
        third_siblings: path.third_siblings,
        fourth_siblings: path.fourth_siblings,
    }
}

pub fn auxiliary_lde_quartet_path_power_of_two<
    const N: usize,
    const QUARTER: usize,
    const DEPTH: usize,
>(
    _ leaves: own [AuxiliaryLdeDigest; N],
    _ index: u32,
) -> AuxiliaryLdeQuartetPath<DEPTH>
where
    N > 3,
    N <= MAX_PADDED_TRACE_LENGTH,
    QUARTER > 0,
    { QUARTER + QUARTER + QUARTER + QUARTER == N },
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        if !leaves[cursor].valid {
            return invalid_lde_quartet_path<AuxiliaryLdeTreeRole, DEPTH>()
        }
        raw[cursor] = leaves[cursor].value
        cursor = cursor + 1
    }
    let path = quartet_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        QUARTER,
        DEPTH,
    >(raw, index)
    LdeQuartetPath<AuxiliaryLdeTreeRole, DEPTH> {
        valid: path.valid,
        index: path.index,
        first_siblings: path.first_siblings,
        second_siblings: path.second_siblings,
        third_siblings: path.third_siblings,
        fourth_siblings: path.fourth_siblings,
    }
}

pub fn verify_main_lde_quartet_path<const DEPTH: usize>(
    _ first: own MainLdeDigest,
    _ second: own MainLdeDigest,
    _ third: own MainLdeDigest,
    _ fourth: own MainLdeDigest,
    _ path: own MainLdeQuartetPath<DEPTH>,
    _ root: own MainLdeDigest,
) -> bool {
    if !first.valid || !second.valid || !third.valid || !fourth.valid
        || !path.valid || !root.valid {
        return false
    }
    quartet_verify<Poseidon2Digest, DigestNodeHasher, DEPTH>(
        root.value,
        first.value,
        second.value,
        third.value,
        fourth.value,
        MerkleQuartetPath<Poseidon2Digest, DEPTH> {
            valid: path.valid,
            index: path.index,
            first_siblings: path.first_siblings,
            second_siblings: path.second_siblings,
            third_siblings: path.third_siblings,
            fourth_siblings: path.fourth_siblings,
        },
    )
}

pub fn verify_auxiliary_lde_quartet_path<const DEPTH: usize>(
    _ first: own AuxiliaryLdeDigest,
    _ second: own AuxiliaryLdeDigest,
    _ third: own AuxiliaryLdeDigest,
    _ fourth: own AuxiliaryLdeDigest,
    _ path: own AuxiliaryLdeQuartetPath<DEPTH>,
    _ root: own AuxiliaryLdeDigest,
) -> bool {
    if !first.valid || !second.valid || !third.valid || !fourth.valid
        || !path.valid || !root.valid {
        return false
    }
    quartet_verify<Poseidon2Digest, DigestNodeHasher, DEPTH>(
        root.value,
        first.value,
        second.value,
        third.value,
        fourth.value,
        MerkleQuartetPath<Poseidon2Digest, DEPTH> {
            valid: path.valid,
            index: path.index,
            first_siblings: path.first_siblings,
            second_siblings: path.second_siblings,
            third_siblings: path.third_siblings,
            fourth_siblings: path.fourth_siblings,
        },
    )
}

fn lde_point<const LDE: usize>(
    _ evaluation: u32,
    _ shift: BabyBear,
) -> CompositionValue<BabyBear>
where LDE > 0, LDE > 1, { (LDE & (LDE - 1)) == 0 },
{
    let one = BabyBear::one()
    let lde: u32 = LDE.downcast_truncate()
    if evaluation >= lde || shift.is_zero() || (shift.pow_u32(lde) - one).is_zero() {
        return CompositionValue<BabyBear> { valid: false, value: BabyBear::zero() }
    }
    CompositionValue<BabyBear> {
        valid: true,
        value: shift * BabyBear::two_adic_root(radix2_log<LDE>()).pow_u32(evaluation),
    }
}

/// Recompute one BabyBear composition value from authenticated current and
/// next LDE rows. The base-field opening is embedded into the quartic field at
/// the shared AIR boundary; no BabyBear-specific constraint body exists.
pub fn evaluate_composition_opened<const TRACE: usize, const LDE: usize>(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ challenge: CompositionChallenge,
    _ shift: BabyBear,
    _ evaluation: u32,
    _ row: ref AirLdeRow,
    _ next: ref AirLdeRow,
) -> CompositionValue<BabyBearExt4>
where
    TRACE > 0,
    TRACE > 1,
    LDE > 0,
    LDE > 1,
    LDE > TRACE,
    { (TRACE & (TRACE - 1)) == 0 },
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
{
    let point = lde_point<LDE>(evaluation, shift)
    if !challenge.valid || !point.valid {
        return CompositionValue<BabyBearExt4> {
            valid: false,
            value: BabyBearExt4::zero(),
        }
    }
    let c_re = encode_signed_word(c_re_q12)
    let c_im = encode_signed_word(c_im_q12)
    let numerators = constraint_numerators<BabyBearExt4, AirLdeRow, AirLdeRow>(
        challenge.value,
        signed_air_value<BabyBearExt4>(
            BabyBearExt4::from_base(BabyBear::from_u32(c_re.sign)),
            BabyBearExt4::from_base(BabyBear::from_u32(c_re.magnitude)),
        ),
        signed_air_value<BabyBearExt4>(
            BabyBearExt4::from_base(BabyBear::from_u32(c_im.sign)),
            BabyBearExt4::from_base(BabyBear::from_u32(c_im.magnitude)),
        ),
        row,
        next,
    )
    composition_value<BabyBearExt4, TRACE>(BabyBearExt4::from_base(point.value), numerators)
}

/// Authenticate the four base-field LDE rows selected by one FRI query, then
/// bind shared-AIR recomputation at `x` and `-x` to the opened composition
/// pair. This is the verifier seam between the typed LDE quartet and FRI
/// receipt; it retains neither complete tree nor complete codeword.
pub fn verify_checkpoint4_air_lde_composition_query<
    const TRACE: usize,
    const LDE: usize,
    const QUARTER: usize,
    const DEPTH: usize,
>(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ challenge: CompositionChallenge,
    _ shift: BabyBear,
    _ query_index: u32,
    _ opening: ref Checkpoint4AirLdeOpening<DEPTH>,
    _ main_root: MainLdeDigest,
    _ auxiliary_root: AuxiliaryLdeDigest,
    _ positive_composition: BabyBearExt4,
    _ negative_composition: BabyBearExt4,
) -> bool
where
    TRACE > 0,
    TRACE > 1,
    LDE > 0,
    LDE > 1,
    LDE > TRACE,
    QUARTER > 0,
    { (TRACE & (TRACE - 1)) == 0 },
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
    { TRACE == 4 },
    { QUARTER + QUARTER + QUARTER + QUARTER == LDE },
{
    let geometry = radix2_query_geometry<TRACE, LDE>(query_index)
    if !challenge.valid || !opening.valid || !geometry.valid {
        return false
    }
    if opening.main_path.index != geometry.local_index
        || opening.auxiliary_path.index != geometry.local_index {
        return false
    }

    let first_main = main_lde_row_commitment(opening.rows[0].main)
    let second_main = main_lde_row_commitment(opening.rows[1].main)
    let third_main = main_lde_row_commitment(opening.rows[2].main)
    let fourth_main = main_lde_row_commitment(opening.rows[3].main)
    let first_auxiliary = auxiliary_lde_row_commitment(opening.rows[0].auxiliary)
    let second_auxiliary = auxiliary_lde_row_commitment(opening.rows[1].auxiliary)
    let third_auxiliary = auxiliary_lde_row_commitment(opening.rows[2].auxiliary)
    let fourth_auxiliary = auxiliary_lde_row_commitment(opening.rows[3].auxiliary)
    if !verify_main_lde_quartet_path<DEPTH>(
            first_main,
            second_main,
            third_main,
            fourth_main,
            opening.main_path,
            main_root,
        )
        || !verify_auxiliary_lde_quartet_path<DEPTH>(
            first_auxiliary,
            second_auxiliary,
            third_auxiliary,
            fourth_auxiliary,
            opening.auxiliary_path,
            auxiliary_root,
        ) {
        return false
    }

    let quarter: u32 = QUARTER.downcast_truncate()
    let positive_quarter: usize = (geometry.evaluation / quarter) as usize
    let positive_next_quarter: usize = (geometry.next_evaluation / quarter) as usize
    let negative_quarter: usize = (geometry.negative_evaluation / quarter) as usize
    let negative_next_quarter: usize = (geometry.negative_next_evaluation / quarter) as usize
    let positive = evaluate_composition_opened<TRACE, LDE>(
        c_re_q12,
        c_im_q12,
        challenge,
        shift,
        geometry.evaluation,
        ref opening.rows[positive_quarter],
        ref opening.rows[positive_next_quarter],
    )
    let negative = evaluate_composition_opened<TRACE, LDE>(
        c_re_q12,
        c_im_q12,
        challenge,
        shift,
        geometry.negative_evaluation,
        ref opening.rows[negative_quarter],
        ref opening.rows[negative_next_quarter],
    )
    positive.valid
        && negative.valid
        && (positive.value - positive_composition).is_zero()
        && (negative.value - negative_composition).is_zero()
}

pub fn composition_root_power_of_two<const N: usize>(
    _ leaves: own [CompositionDigest; N],
) -> CompositionDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return CompositionDigest { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    CompositionDigest { valid: root.valid, value: root.value }
}

pub fn composition_pair_path_power_of_two<
    const N: usize,
    const HALF: usize,
    const DEPTH: usize,
>(
    _ evaluations: own [BabyBearExt4; N],
    _ index: u32,
) -> CompositionPairPath<DEPTH>
where
    N > 1,
    N <= MAX_PADDED_TRACE_LENGTH,
    HALF > 0,
    { HALF + HALF == N },
{
    let mut leaves = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        leaves[cursor] = composition_row_commitment(evaluations[cursor]).value
        cursor = cursor + 1
    }
    let raw = pair_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        HALF,
        DEPTH,
    >(leaves, index)
    CompositionPairPath<DEPTH> {
        valid: raw.valid,
        index: raw.index,
        positive_siblings: raw.positive_siblings,
        negative_siblings: raw.negative_siblings,
    }
}

pub fn verify_composition_pair_path<const DEPTH: usize>(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ path: own CompositionPairPath<DEPTH>,
    _ root: own CompositionDigest,
) -> bool {
    if !root.valid || !path.valid { return false }
    pair_verify<Poseidon2Digest, DigestNodeHasher, DEPTH>(
        root.value,
        composition_row_commitment(positive).value,
        composition_row_commitment(negative).value,
        MerklePairPath<Poseidon2Digest, DEPTH> {
            valid: path.valid,
            index: path.index,
            positive_siblings: path.positive_siblings,
            negative_siblings: path.negative_siblings,
        },
    )
}

fn invalid_digest_multi_path<
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>() -> MerkleMultiPath<Poseidon2Digest, MAX_LEAVES, MAX_SIBLINGS> {
    MerkleMultiPath {
        valid: false,
        leaf_count: 0,
        leaf_indices: [0; MAX_LEAVES],
        sibling_count: 0,
        siblings: [Poseidon2Digest::zero(); MAX_SIBLINGS],
    }
}

/// Construct the canonical empty composition opening required before bounded
/// decoding or caller-owned proof materialization.
pub fn empty_composition_multi_opening<
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>() -> CompositionMultiOpening<MAX_LEAVES, MAX_SIBLINGS> {
    LdeMultiOpening {
        valid: false,
        values: [BabyBearExt4::zero(); MAX_LEAVES],
        path: invalid_digest_multi_path<MAX_LEAVES, MAX_SIBLINGS>(),
    }
}

pub fn composition_multi_opening_power_of_two<
    const N: usize,
    const REQUESTS: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ evaluations: own [BabyBearExt4; N],
    _ requested: own [u32; REQUESTS],
) -> CompositionMultiOpening<MAX_LEAVES, MAX_SIBLINGS>
where
    N > 1,
    N <= MAX_PADDED_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
    REQUESTS > 0,
    MAX_LEAVES > 0,
{
    let mut leaves = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        leaves[cursor] = composition_row_commitment(evaluations[cursor]).value
        cursor = cursor + 1
    }
    let path = multi_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        REQUESTS,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(leaves, requested)
    if !path.valid {
        return empty_composition_multi_opening<MAX_LEAVES, MAX_SIBLINGS>()
    }
    let mut values = [BabyBearExt4::zero(); MAX_LEAVES]
    cursor = 0
    while cursor < (path.leaf_count as usize) {
        values[cursor] = evaluations[path.leaf_indices[cursor] as usize]
        cursor = cursor + 1
    }
    LdeMultiOpening { valid: true, values: values, path: path }
}

pub fn verify_composition_multi_opening<
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ opening: own CompositionMultiOpening<MAX_LEAVES, MAX_SIBLINGS>,
    _ root: own CompositionDigest,
) -> bool
where
    N > 1,
    N <= MAX_PADDED_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
    MAX_LEAVES > 0,
{
    if !opening.valid || !root.valid { return false }
    let leaf_count: usize = opening.path.leaf_count as usize
    if leaf_count == 0 || leaf_count > MAX_LEAVES { return false }
    let mut leaves = [Poseidon2Digest::zero(); MAX_LEAVES]
    let mut cursor: usize = 0
    while cursor < leaf_count {
        leaves[cursor] = composition_row_commitment(opening.values[cursor]).value
        cursor = cursor + 1
    }
    while cursor < MAX_LEAVES {
        if !opening.values[cursor].is_zero() { return false }
        cursor = cursor + 1
    }
    multi_verify<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(root.value, leaves, opening.path)
}

/// Compose the query-plan and Merkle interpreters without exposing an
/// intermediate host-authored index list.
pub fn composition_multi_query_opening_power_of_two<
    Plan,
    Samples: core::marker::Copy,
    const N: usize,
    const HALF: usize,
    const REQUESTS: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ evaluations: own [BabyBearExt4; N],
    _ samples: Samples,
) -> CompositionMultiOpening<MAX_LEAVES, MAX_SIBLINGS>
where
    Plan: BabyBearFriPairRequests<HALF, REQUESTS, Samples>,
    N > 1,
    N <= MAX_PADDED_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
    HALF > 0,
    { HALF + HALF == N },
    REQUESTS > 0,
    MAX_LEAVES > 0,
{
    let requests = <Plan as BabyBearFriPairRequests<
        HALF,
        REQUESTS,
        Samples,
    >>::fri_pair_requests(samples)
    if !requests.valid || requests.count != REQUESTS.downcast_truncate() {
        return empty_composition_multi_opening<MAX_LEAVES, MAX_SIBLINGS>()
    }
    composition_multi_opening_power_of_two<
        N,
        REQUESTS,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(evaluations, requests.indices)
}

pub fn bind_main_lde(
    _ transcript: own ProofTranscriptDigest,
    _ main: own MainLdeDigest,
) -> MainLdeTranscriptDigest {
    if !transcript.valid || !main.valid {
        return MainLdeTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    MainLdeTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotMainLdeTranscriptBabyBearV1>(
            transcript.value,
            main.value,
        ),
    }
}

pub fn bind_auxiliary_lde(
    _ transcript: own MainLdeTranscriptDigest,
    _ auxiliary: own AuxiliaryLdeDigest,
) -> AirLdeTranscriptDigest {
    if !transcript.valid || !auxiliary.valid {
        return AirLdeTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    AirLdeTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotAuxiliaryLdeTranscriptBabyBearV1>(
            transcript.value,
            auxiliary.value,
        ),
    }
}

pub fn fri_fold_challenge(
    _ transcript: own CompositionTranscriptDigest,
) -> FriFoldChallenge<1> {
    if !transcript.valid {
        return FriFoldChallenge<1> { valid: false, value: BabyBearExt4::zero() }
    }
    FriFoldChallenge<1> {
        valid: true,
        value: squeeze_ext4<MandelbrotFriFoldBabyBear<1>>(transcript.value),
    }
}

pub fn next_fri_fold_challenge<const PREVIOUS: u32, const ROUND: u32>(
    _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
) -> FriFoldChallenge<ROUND>
where { PREVIOUS > 0 }, { ROUND == PREVIOUS + 1 }, { ROUND < 100 }
{
    if !transcript.valid {
        return FriFoldChallenge<ROUND> { valid: false, value: BabyBearExt4::zero() }
    }
    FriFoldChallenge<ROUND> {
        valid: true,
        value: squeeze_ext4<MandelbrotFriFoldBabyBear<ROUND>>(transcript.value),
    }
}

pub fn fri_query_challenge<const ROUND: u32, const QUERY: u32>(
    _ transcript: own FriLayerTranscriptDigest<ROUND>,
) -> FriQueryChallenge<QUERY>
where { ROUND > 0 }, { ROUND < 100 }, { QUERY > 0 }, { QUERY < BABY_BEAR_MODULUS }
{
    if !transcript.valid {
        return FriQueryChallenge<QUERY> { valid: false, value: BabyBear::zero() }
    }
    FriQueryChallenge<QUERY> {
        valid: true,
        value: squeeze_ext4_indexed<MandelbrotFriQueryBabyBearV2>(
            transcript.value,
            QUERY,
        ).coefficient(0),
    }
}

pub fn fri_query_index_power_of_two<const QUERY: u32, const HALF: usize>(
    _ challenge: own FriQueryChallenge<QUERY>,
) -> FriQueryIndex<QUERY>
where { QUERY > 0 }, { QUERY < BABY_BEAR_MODULUS }, HALF > 0, { (HALF & (HALF - 1)) == 0 }, { HALF <= 134217728 }
{
    if !challenge.valid {
        return FriQueryIndex<QUERY> { valid: false, value: 0 }
    }
    let half: u32 = HALF.downcast_truncate()
    FriQueryIndex<QUERY> {
        valid: true,
        value: challenge.value.to_u32() & (half - 1),
    }
}

pub fn fri_layer_row_commitment<const ROUND: u32>(
    _ value: BabyBearExt4,
) -> FriLayerDigest<ROUND>
where { ROUND > 0 }, { ROUND < 100 }
{
    FriLayerDigest<ROUND> {
        valid: true,
        value: commit_ext4_fields<MandelbrotFriLayerRowBabyBear<ROUND>, 1>([value]),
    }
}

pub fn fri_layer_root_power_of_two<const ROUND: u32, const N: usize>(
    _ leaves: own [FriLayerDigest<ROUND>; N],
) -> FriLayerDigest<ROUND>
where { ROUND > 0 }, { ROUND < 100 }, N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return FriLayerDigest<ROUND> { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    FriLayerDigest<ROUND> { valid: root.valid, value: root.value }
}

pub fn fri_layer_pair_path_power_of_two<
    const ROUND: u32,
    const N: usize,
    const HALF: usize,
    const DEPTH: usize,
>(
    _ evaluations: own [BabyBearExt4; N],
    _ index: u32,
) -> FriLayerPairPath<ROUND, DEPTH>
where
    { ROUND > 0 },
    { ROUND < 100 },
    N > 1,
    N <= MAX_PADDED_TRACE_LENGTH,
    HALF > 0,
    { HALF + HALF == N },
{
    let mut leaves = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        leaves[cursor] = fri_layer_row_commitment<ROUND>(evaluations[cursor]).value
        cursor = cursor + 1
    }
    let raw = pair_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        HALF,
        DEPTH,
    >(leaves, index)
    FriLayerPairPath<ROUND, DEPTH> {
        valid: raw.valid,
        index: raw.index,
        positive_siblings: raw.positive_siblings,
        negative_siblings: raw.negative_siblings,
    }
}

pub fn verify_fri_layer_pair_path<const ROUND: u32, const DEPTH: usize>(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ path: own FriLayerPairPath<ROUND, DEPTH>,
    _ root: own FriLayerDigest<ROUND>,
) -> bool
where { ROUND > 0 }, { ROUND < 100 }
{
    if !root.valid || !path.valid { return false }
    pair_verify<Poseidon2Digest, DigestNodeHasher, DEPTH>(
        root.value,
        fri_layer_row_commitment<ROUND>(positive).value,
        fri_layer_row_commitment<ROUND>(negative).value,
        MerklePairPath<Poseidon2Digest, DEPTH> {
            valid: path.valid,
            index: path.index,
            positive_siblings: path.positive_siblings,
            negative_siblings: path.negative_siblings,
        },
    )
}

fn invalid_fri_layer_multi_opening<
