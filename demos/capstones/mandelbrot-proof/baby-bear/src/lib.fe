//! BabyBear interpretation of the field-independent Mandelbrot schemas.
//!
//! Main rows, public statements, and Fe-derived auxiliary columns all flow
//! through the same exact-length 30-bit field encoder. Their 210, 114, and
//! 411 bits occupy 7, 4, and 14 BabyBear payload lanes respectively. The
//! largest value is absorbed by one typed, fixed-length Poseidon2 sponge.

use mandelbrot_proof_kernel::{
    AUXILIARY_ROW_BITS,
    ENCODED_PROOF_ROW_WIDTHS,
    ESCAPES_BY_Q12_PUBLIC_WIDTHS,
    ESCAPES_BY_Q12_PUBLIC_WORDS,
    MAX_PADDED_TRACE_LENGTH,
    EncodedProofRow,
    EscapesByQ12Public,
    derive_ranged_air_row,
    encode_signed_word,
    encoded_proof_row_words,
    encoded_ranged_auxiliary_row_bit,
    escapes_by_q12_public_words,
}
use mandelbrot_proof_air_core::{
    AirColumnView,
    CompositionValue,
    FriSchedule,
    FriScheduleDone,
    FriScheduleFold,
    composition_value,
    constraint_numerators,
    radix2_query_geometry,
    signed_air_value,
}
use merkle_core::{
    MerklePairPath,
    MerkleQuartetPath,
    MerkleRoot,
    TwoToOneHasher,
    complete_frontier_root,
    empty_frontier,
    pair_path_from_leaves,
    pair_verify,
    push_frontier,
    quartet_path_from_leaves,
    quartet_verify,
}
use poseidon_baby_bear::{
    PackedCommitment,
    Poseidon2Digest,
    Poseidon2Domain,
    Poseidon2FieldDomain,
    bind as poseidon_bind,
    commit_ext4_fields,
    commit_fields,
    commit_packed,
    compress as poseidon_compress,
    squeeze_ext4,
}
use precision::baby_bear::{BabyBear, BabyBearExt4, BabyBearModulus}
use precision::word_field_encoding::{PackedFieldBits, pack_bounded_words}
use precision::polynomial::radix2_log

pub const ROW_FIELDS: usize = 7
pub const PUBLIC_FIELDS: usize = 4
pub const AUXILIARY_FIELDS: usize = 14
pub const MAIN_LDE_ROW_FIELDS: usize = 17
const TRACE_FRONTIER_LEVELS: usize = 22

const fn protocol_tag(_ label: String<4>) -> u32 {
    let bytes = label.as_bytes()
    ((bytes[0] as u32) << 24)
        | ((bytes[1] as u32) << 16)
        | ((bytes[2] as u32) << 8)
        | (bytes[3] as u32)
}

const fn protocol_round_tag(_ prefix: String<2>, _ round: u32) -> u32 {
    let bytes = prefix.as_bytes()
    let tens = round / 10
    let ones = round - tens * 10
    ((bytes[0] as u32) << 24)
        | ((bytes[1] as u32) << 16)
        | ((48 + tens) << 8)
        | (48 + ones)
}

