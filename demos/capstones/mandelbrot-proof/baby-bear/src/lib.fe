    pub valid: bool,
}
impl<const NEXT_ROUND: u32> core::marker::Copy for FriMultiChallengeDone<NEXT_ROUND> {}

pub trait BabyBearFriMultiChallengeShape {
    type Challenges
}

impl<const NEXT_ROUND: u32> BabyBearFriMultiChallengeShape
    for FriScheduleDone<NEXT_ROUND> {
    type Challenges = FriMultiChallengeDone<NEXT_ROUND>
}

impl<
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    Tail: BabyBearFriMultiChallengeShape,
> BabyBearFriMultiChallengeShape for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    Tail,
> {
    type Challenges = FriMultiChallengeFold<
        ROUND,
        <Tail as BabyBearFriMultiChallengeShape>::Challenges,
    >
}

/// Derive a shared multi-query receipt carrier from the field-neutral fold
/// schedule and a protocol-selected query count.
pub trait BabyBearFriMultiQueryShape<const QUERY_COUNT: usize> {
    type Query
}

impl<
    const QUERY_COUNT: usize,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
> BabyBearFriMultiQueryShape<QUERY_COUNT> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleDone<NEXT_ROUND>,
>
where
    QUERY_COUNT > 0,
    { ROUND > 0 },
    { NEXT_ROUND == ROUND + 1 },
    { INPUT_LOG == 1 },
    { OUTPUT == 1 },
    { PAIR_WIDTH == 0 },
    { PAIR_DEPTH == 0 },
{
    type Query = FriMultiQueryEnd<ROUND>
}

impl<
    const QUERY_COUNT: usize,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    Rest,
> BabyBearFriMultiQueryShape<QUERY_COUNT> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    QUERY_COUNT > 0,
    { ROUND > 0 },
    { INPUT_LOG > 1 },
    { OUTPUT > 1 },
    { PAIR_WIDTH + PAIR_WIDTH == OUTPUT },
    { PAIR_DEPTH + 2 == INPUT_LOG },
    { NEXT_ROUND == ROUND + 1 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriMultiQueryShape<QUERY_COUNT>,
{
    type Query = FriMultiQueryFold<
        ROUND,
        {QUERY_COUNT + QUERY_COUNT},
        {fri_multi_sibling_capacity(PAIR_DEPTH, QUERY_COUNT)},
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriMultiQueryShape<QUERY_COUNT>>::Query,
    >
}

/// Open one shared multipath per committed layer from a complete FRI proof.
/// Sampling occurs only at the structurally discovered terminal transcript.
pub trait BabyBearFriMultiQueryLayers<
    const QUERY_COUNT: usize,
    const QUERY_HALF: usize,
    const REQUESTS: usize,
    Plan,
    Samples,
    Complete,
    Layers,
> {
    fn invalid_fri_multi_query_layers() -> Layers
    fn sample_fri_multi_queries(_ complete: ref Complete) -> (bool, Samples)
    fn open_fri_multi_query_layers(
        _ complete: own Complete,
        _ samples: Samples,
    ) -> (bool, Layers)
}

impl<
    const QUERY_COUNT: usize,
    const QUERY_HALF: usize,
    const REQUESTS: usize,
    Plan,
    Samples: core::marker::Copy,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
> BabyBearFriMultiQueryLayers<
    QUERY_COUNT,
    QUERY_HALF,
    REQUESTS,
    Plan,
    Samples,
    FriProofFold<ROUND, OUTPUT, FriProofEnd<NEXT_ROUND>>,
    FriMultiQueryEnd<ROUND>,
> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleDone<NEXT_ROUND>,
>
where
    QUERY_COUNT > 0,
    { QUERY_COUNT + QUERY_COUNT > 0 },
    REQUESTS > 0,
    { REQUESTS == QUERY_COUNT + QUERY_COUNT },
    { ROUND > 0 },
    { ROUND < 100 },
    { NEXT_ROUND == ROUND + 1 },
    { INPUT_LOG == 1 },
    { OUTPUT == 1 },
    { PAIR_WIDTH == 0 },
    { PAIR_DEPTH == 0 },
    QUERY_HALF > 0,
    { (QUERY_HALF & (QUERY_HALF - 1)) == 0 },
    { QUERY_HALF <= 134217728 },
    Plan: BabyBearFriQueryPlan<ROUND, QUERY_HALF, Samples>,
{
    fn invalid_fri_multi_query_layers() -> FriMultiQueryEnd<ROUND> {
        FriMultiQueryEnd {
            valid: false,
            root: FriLayerDigest { valid: false, value: Poseidon2Digest::zero() },
            evaluation: BabyBearExt4::zero(),
        }
    }

    fn sample_fri_multi_queries(
        _ complete: ref FriProofFold<ROUND, OUTPUT, FriProofEnd<NEXT_ROUND>>,
    ) -> (bool, Samples) {
        if !complete.valid || !complete.layer.valid || !complete.layer.transcript.valid {
            return (
                false,
                <Plan as BabyBearFriQueryPlan<
                    ROUND,
                    QUERY_HALF,
                    Samples,
                >>::invalid_fri_query_samples(),
            )
        }
        <Plan as BabyBearFriQueryPlan<ROUND, QUERY_HALF, Samples>>::sample_fri_queries(
            complete.layer.transcript,
        )
    }

    fn open_fri_multi_query_layers(
        _ complete: own FriProofFold<ROUND, OUTPUT, FriProofEnd<NEXT_ROUND>>,
        _ samples: Samples,
    ) -> (bool, FriMultiQueryEnd<ROUND>) {
        if !complete.valid || !complete.layer.valid || !complete.layer.root.valid {
            return (
                false,
                <Self as BabyBearFriMultiQueryLayers<
                    QUERY_COUNT,
                    QUERY_HALF,
                    REQUESTS,
                    Plan,
                    Samples,
                    FriProofFold<ROUND, OUTPUT, FriProofEnd<NEXT_ROUND>>,
                    FriMultiQueryEnd<ROUND>,
                >>::invalid_fri_multi_query_layers(),
            )
        }
        (
            true,
            FriMultiQueryEnd {
                valid: true,
                root: complete.layer.root,
                evaluation: complete.layer.evaluations[0],
            },
        )
    }
}

impl<
    const QUERY_COUNT: usize,
    const QUERY_HALF: usize,
    const REQUESTS: usize,
    Plan,
    Samples: core::marker::Copy,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
    Rest,
    TailComplete,
    TailLayers: core::marker::Copy,
> BabyBearFriMultiQueryLayers<
    QUERY_COUNT,
    QUERY_HALF,
    REQUESTS,
    Plan,
    Samples,
    FriProofFold<ROUND, OUTPUT, TailComplete>,
    FriMultiQueryFold<
        ROUND,
        MAX_LEAVES,
        MAX_SIBLINGS,
        TailLayers,
    >,
> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    QUERY_COUNT > 0,
    { QUERY_COUNT + QUERY_COUNT > 0 },
    { MAX_LEAVES == QUERY_COUNT + QUERY_COUNT },
    { MAX_SIBLINGS == fri_multi_sibling_capacity(PAIR_DEPTH, QUERY_COUNT) },
    MAX_LEAVES > 0,
    REQUESTS > 0,
    { REQUESTS == QUERY_COUNT + QUERY_COUNT },
    { ROUND > 0 },
    { ROUND < 100 },
    { INPUT_LOG > 1 },
    OUTPUT > 1,
    OUTPUT <= MAX_PADDED_TRACE_LENGTH,
    OUTPUT <= 2147483648,
    { (OUTPUT & (OUTPUT - 1)) == 0 },
    PAIR_WIDTH > 0,
    { PAIR_WIDTH + PAIR_WIDTH == OUTPUT },
    { PAIR_DEPTH + 2 == INPUT_LOG },
    { NEXT_ROUND == ROUND + 1 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    Plan: BabyBearFriPairRequests<PAIR_WIDTH, REQUESTS, Samples>,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriMultiQueryLayers<
        QUERY_COUNT,
        QUERY_HALF,
        REQUESTS,
        Plan,
        Samples,
        TailComplete,
        TailLayers,
    >,
{
    fn invalid_fri_multi_query_layers() -> FriMultiQueryFold<
        ROUND,
        MAX_LEAVES,
        MAX_SIBLINGS,
        TailLayers,
    > {
        FriMultiQueryFold {
            valid: false,
            root: FriLayerDigest { valid: false, value: Poseidon2Digest::zero() },
            opening: invalid_fri_layer_multi_opening<
                ROUND,
                MAX_LEAVES,
                MAX_SIBLINGS,
            >(),
            tail: <FriScheduleFold<
                NEXT_ROUND,
                NEXT_INPUT_LOG,
                NEXT_OUTPUT,
                NEXT_PAIR_WIDTH,
                NEXT_PAIR_DEPTH,
                Rest,
            > as BabyBearFriMultiQueryLayers<
                QUERY_COUNT,
                QUERY_HALF,
                REQUESTS,
                Plan,
                Samples,
                TailComplete,
                TailLayers,
            >>::invalid_fri_multi_query_layers(),
        }
    }

    fn sample_fri_multi_queries(
        _ complete: ref FriProofFold<ROUND, OUTPUT, TailComplete>,
    ) -> (bool, Samples) {
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriMultiQueryLayers<
            QUERY_COUNT,
            QUERY_HALF,
            REQUESTS,
            Plan,
            Samples,
            TailComplete,
            TailLayers,
        >>::sample_fri_multi_queries(ref complete.tail)
    }

    fn open_fri_multi_query_layers(
        _ complete: own FriProofFold<ROUND, OUTPUT, TailComplete>,
        _ samples: Samples,
    ) -> (
        bool,
        FriMultiQueryFold<
            ROUND,
            MAX_LEAVES,
            MAX_SIBLINGS,
            TailLayers,
        >,
    ) {
        if !complete.valid || !complete.layer.valid || !complete.layer.root.valid {
            return (
                false,
                <Self as BabyBearFriMultiQueryLayers<
                    QUERY_COUNT,
                    QUERY_HALF,
                    REQUESTS,
                    Plan,
                    Samples,
                    FriProofFold<ROUND, OUTPUT, TailComplete>,
                    FriMultiQueryFold<
                        ROUND,
                        MAX_LEAVES,
                        MAX_SIBLINGS,
                        TailLayers,
                    >,
                >>::invalid_fri_multi_query_layers(),
            )
        }
        let requests = <Plan as BabyBearFriPairRequests<
            PAIR_WIDTH,
            REQUESTS,
            Samples,
        >>::fri_pair_requests(samples)
        if !requests.valid || requests.count != REQUESTS.downcast_truncate() {
            return (
                false,
                <Self as BabyBearFriMultiQueryLayers<
                    QUERY_COUNT,
                    QUERY_HALF,
                    REQUESTS,
                    Plan,
                    Samples,
                    FriProofFold<ROUND, OUTPUT, TailComplete>,
                    FriMultiQueryFold<ROUND, MAX_LEAVES, MAX_SIBLINGS, TailLayers>,
                >>::invalid_fri_multi_query_layers(),
            )
        }
        let opening = fri_layer_multi_opening_power_of_two<
            ROUND,
            OUTPUT,
            REQUESTS,
            MAX_LEAVES,
            MAX_SIBLINGS,
        >(complete.layer.evaluations, requests.indices)
        let tail = <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriMultiQueryLayers<
            QUERY_COUNT,
            QUERY_HALF,
            REQUESTS,
            Plan,
            Samples,
            TailComplete,
            TailLayers,
        >>::open_fri_multi_query_layers(complete.tail, samples)
        if !opening.valid || !tail.0 {
            return (
                false,
                <Self as BabyBearFriMultiQueryLayers<
                    QUERY_COUNT,
                    QUERY_HALF,
                    REQUESTS,
                    Plan,
                    Samples,
                    FriProofFold<ROUND, OUTPUT, TailComplete>,
                    FriMultiQueryFold<
                        ROUND,
                        MAX_LEAVES,
                        MAX_SIBLINGS,
                        TailLayers,
                    >,
                >>::invalid_fri_multi_query_layers(),
            )
        }
        (
            true,
            FriMultiQueryFold {
                valid: true,
                root: complete.layer.root,
                opening: opening,
                tail: tail.1,
            },
        )
    }
}

/// Authenticate every committed tail layer once, reconstruct the transcript,
/// and sample the query plan only after the terminal root has been bound.
pub trait BabyBearFriMultiAuthenticateTail<
    const PREVIOUS: u32,
    const QUERY_HALF: usize,
    Plan,
    Samples,
    Layers,
    Challenges,
> {
    fn authenticate_fri_multi_tail(
        _ transcript: FriLayerTranscriptDigest<PREVIOUS>,
        _ layers: Layers,
    ) -> (bool, Samples, Challenges)
}

impl<
    const PREVIOUS: u32,
    const QUERY_HALF: usize,
    Plan,
    Samples: core::marker::Copy,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
> BabyBearFriMultiAuthenticateTail<
    PREVIOUS,
    QUERY_HALF,
    Plan,
    Samples,
    FriMultiQueryEnd<ROUND>,
    FriMultiChallengeFold<ROUND, FriMultiChallengeDone<NEXT_ROUND>>,
> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleDone<NEXT_ROUND>,
>
where
    { PREVIOUS > 0 },
    { ROUND == PREVIOUS + 1 },
    { ROUND > 0 },
    { ROUND < 100 },
    { NEXT_ROUND == ROUND + 1 },
    { INPUT_LOG == 1 },
    { OUTPUT == 1 },
    { PAIR_WIDTH == 0 },
    { PAIR_DEPTH == 0 },
    QUERY_HALF > 0,
    { (QUERY_HALF & (QUERY_HALF - 1)) == 0 },
    { QUERY_HALF <= 134217728 },
    Plan: BabyBearFriQueryPlan<ROUND, QUERY_HALF, Samples>,
{
    fn authenticate_fri_multi_tail(
        _ transcript: FriLayerTranscriptDigest<PREVIOUS>,
        _ layers: FriMultiQueryEnd<ROUND>,
    ) -> (
        bool,
        Samples,
        FriMultiChallengeFold<ROUND, FriMultiChallengeDone<NEXT_ROUND>>,
    ) {
        let challenge = next_fri_fold_challenge<PREVIOUS, ROUND>(transcript)
        let leaf = fri_layer_row_commitment<ROUND>(layers.evaluation)
        let final_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, layers.root)
        let sampled = <Plan as BabyBearFriQueryPlan<
            ROUND,
            QUERY_HALF,
            Samples,
        >>::sample_fri_queries(final_transcript)
        let valid = layers.valid && layers.root.valid && challenge.valid
            && leaf.valid && leaf.value.equals(layers.root.value)
            && final_transcript.valid && sampled.0
        (
            valid,
            sampled.1,
            FriMultiChallengeFold {
                valid: valid,
                challenge: challenge,
                tail: FriMultiChallengeDone { valid: valid },
            },
        )
    }
}

impl<
    const PREVIOUS: u32,
    const QUERY_HALF: usize,
    Plan,
    Samples: core::marker::Copy,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
    Rest,
    TailLayers: core::marker::Copy,
    TailChallenges: core::marker::Copy,
> BabyBearFriMultiAuthenticateTail<
    PREVIOUS,
    QUERY_HALF,
    Plan,
    Samples,
    FriMultiQueryFold<ROUND, MAX_LEAVES, MAX_SIBLINGS, TailLayers>,
    FriMultiChallengeFold<ROUND, TailChallenges>,
> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    { PREVIOUS > 0 },
    { ROUND == PREVIOUS + 1 },
    { ROUND > 0 },
    { ROUND < 100 },
    { INPUT_LOG > 1 },
    OUTPUT > 0,
    OUTPUT > 1,
    OUTPUT <= MAX_PADDED_TRACE_LENGTH,
    OUTPUT <= 2147483648,
    { (OUTPUT & (OUTPUT - 1)) == 0 },
    MAX_LEAVES > 0,
    { NEXT_ROUND == ROUND + 1 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    Plan: BabyBearFriPairRequests<PAIR_WIDTH, MAX_LEAVES, Samples>,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriMultiAuthenticateTail<
        ROUND,
        QUERY_HALF,
        Plan,
        Samples,
        TailLayers,
        TailChallenges,
    >,
{
    fn authenticate_fri_multi_tail(
        _ transcript: FriLayerTranscriptDigest<PREVIOUS>,
        _ layers: FriMultiQueryFold<ROUND, MAX_LEAVES, MAX_SIBLINGS, TailLayers>,
    ) -> (
        bool,
        Samples,
        FriMultiChallengeFold<ROUND, TailChallenges>,
    ) {
        let challenge = next_fri_fold_challenge<PREVIOUS, ROUND>(transcript)
        let authenticated = verify_fri_layer_multi_opening<
            ROUND,
            OUTPUT,
            MAX_LEAVES,
            MAX_SIBLINGS,
        >(layers.opening, layers.root)
        let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, layers.root)
        let tail = <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriMultiAuthenticateTail<
            ROUND,
            QUERY_HALF,
            Plan,
            Samples,
            TailLayers,
            TailChallenges,
        >>::authenticate_fri_multi_tail(next_transcript, layers.tail)
        let requests = <Plan as BabyBearFriPairRequests<
            PAIR_WIDTH,
            MAX_LEAVES,
            Samples,
        >>::fri_pair_requests(tail.1)
        let exact = requests.valid
            && requests.count == MAX_LEAVES.downcast_truncate()
            && multi_path_matches_requests<
                Poseidon2Digest,
                OUTPUT,
                MAX_LEAVES,
                MAX_LEAVES,
                MAX_SIBLINGS,
            >(ref layers.opening.path, requests.indices)
        let valid = layers.valid && challenge.valid && authenticated
            && next_transcript.valid && tail.0 && exact
        (
            valid,
            tail.1,
            FriMultiChallengeFold {
                valid: valid,
                challenge: challenge,
                tail: tail.2,
            },
        )
    }
}

pub trait BabyBearFriMultiAuthenticateFirst<
    const QUERY_HALF: usize,
    Plan,
    Samples,
    Layers,
    Challenges,
> {
    fn authenticate_fri_multi_first(
        _ transcript: CompositionTranscriptDigest,
        _ layers: Layers,
    ) -> (bool, Samples, Challenges)
}

impl<
    const QUERY_HALF: usize,
    Plan,
    Samples: core::marker::Copy,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
    Rest,
    TailLayers: core::marker::Copy,
    TailChallenges: core::marker::Copy,
> BabyBearFriMultiAuthenticateFirst<
    QUERY_HALF,
    Plan,
    Samples,
    FriMultiQueryFold<1, MAX_LEAVES, MAX_SIBLINGS, TailLayers>,
    FriMultiChallengeFold<1, TailChallenges>,
> for FriScheduleFold<
    1,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    { INPUT_LOG > 1 },
    OUTPUT > 0,
    OUTPUT > 1,
    OUTPUT <= MAX_PADDED_TRACE_LENGTH,
    OUTPUT <= 2147483648,
    { (OUTPUT & (OUTPUT - 1)) == 0 },
    MAX_LEAVES > 0,
    { NEXT_ROUND == 2 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    Plan: BabyBearFriPairRequests<PAIR_WIDTH, MAX_LEAVES, Samples>,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriMultiAuthenticateTail<
        1,
        QUERY_HALF,
        Plan,
        Samples,
        TailLayers,
        TailChallenges,
    >,
{
    fn authenticate_fri_multi_first(
        _ transcript: CompositionTranscriptDigest,
        _ layers: FriMultiQueryFold<1, MAX_LEAVES, MAX_SIBLINGS, TailLayers>,
    ) -> (
        bool,
        Samples,
        FriMultiChallengeFold<1, TailChallenges>,
    ) {
        let challenge = fri_fold_challenge(transcript)
        let authenticated = verify_fri_layer_multi_opening<
            1,
            OUTPUT,
            MAX_LEAVES,
            MAX_SIBLINGS,
        >(layers.opening, layers.root)
        let next_transcript = bind_first_fri_layer(transcript, layers.root)
        let tail = <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriMultiAuthenticateTail<
            1,
            QUERY_HALF,
            Plan,
            Samples,
            TailLayers,
            TailChallenges,
        >>::authenticate_fri_multi_tail(next_transcript, layers.tail)
        let requests = <Plan as BabyBearFriPairRequests<
            PAIR_WIDTH,
            MAX_LEAVES,
            Samples,
        >>::fri_pair_requests(tail.1)
        let exact = requests.valid
            && requests.count == MAX_LEAVES.downcast_truncate()
            && multi_path_matches_requests<
                Poseidon2Digest,
                OUTPUT,
                MAX_LEAVES,
                MAX_LEAVES,
                MAX_SIBLINGS,
            >(ref layers.opening.path, requests.indices)
        let valid = layers.valid && challenge.valid && authenticated
            && next_transcript.valid && tail.0 && exact
        (
            valid,
            tail.1,
            FriMultiChallengeFold {
                valid: valid,
                challenge: challenge,
                tail: tail.2,
            },
        )
    }
}

/// Interpret a field-neutral FRI schedule into its compact authenticated query
/// carrier. The schedule tail distinguishes a pair-opening node from the
/// one-evaluation terminal, so no runtime round tag or manually enumerated
/// layer list is needed.
pub trait BabyBearFriQueryShape {
    type Query
    fn invalid_fri_query() -> Self::Query
}

impl<
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
> BabyBearFriQueryShape for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleDone<NEXT_ROUND>,
>
where
    { ROUND > 0 },
    { NEXT_ROUND == ROUND + 1 },
    { INPUT_LOG == 1 },
    { OUTPUT == 1 },
    { PAIR_WIDTH == 0 },
    { PAIR_DEPTH == 0 },
{
    type Query = FriQueryEnd<ROUND>

    fn invalid_fri_query() -> FriQueryEnd<ROUND> {
        FriQueryEnd {
            valid: false,
            root: FriLayerDigest { valid: false, value: Poseidon2Digest::zero() },
            evaluation: BabyBearExt4::zero(),
        }
    }
}

impl<
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    Rest,
> BabyBearFriQueryShape for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    { ROUND > 0 },
    { INPUT_LOG > 1 },
    { OUTPUT > 1 },
    { PAIR_WIDTH + PAIR_WIDTH == OUTPUT },
    { PAIR_DEPTH + 2 == INPUT_LOG },
    { NEXT_ROUND == ROUND + 1 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriQueryShape,
{
    type Query = FriQueryFold<
        ROUND,
        PAIR_DEPTH,
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        >
            as BabyBearFriQueryShape>::Query,
    >

    fn invalid_fri_query() -> FriQueryFold<
        ROUND,
        PAIR_DEPTH,
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        >
            as BabyBearFriQueryShape>::Query,
    > {
        FriQueryFold {
            valid: false,
            root: FriLayerDigest { valid: false, value: Poseidon2Digest::zero() },
            pair: invalid_fri_query_pair<ROUND, PAIR_DEPTH>(),
            tail: <FriScheduleFold<
                NEXT_ROUND,
                NEXT_INPUT_LOG,
                NEXT_OUTPUT,
                NEXT_PAIR_WIDTH,
                NEXT_PAIR_DEPTH,
                Rest,
            >
                as BabyBearFriQueryShape>::invalid_fri_query(),
        }
    }
}

/// Open a transcript-selected compact query from a complete codeword proof.
/// `Complete` and `Query` are two interpretations of the same schedule. The
/// terminal implementation samples Fiat-Shamir from the final typed
/// transcript; every recursive implementation opens one schedule-derived pair
/// and delegates to its tail.
pub trait BabyBearFriQueryLayers<const QUERY_HALF: usize, Complete>: BabyBearFriQueryShape {
    fn sample_fri_query(_ complete: Complete) -> FriQueryIndex<1>
    fn open_fri_query_layers(
        _ complete: own Complete,
        _ index: u32,
    ) -> (bool, <Self as BabyBearFriQueryShape>::Query)
}

impl<
    const QUERY_HALF: usize,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
> BabyBearFriQueryLayers<QUERY_HALF, FriProofFold<ROUND, OUTPUT, FriProofEnd<NEXT_ROUND>>>
    for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleDone<NEXT_ROUND>,
>
where
    { ROUND > 0 },
    { ROUND < 100 },
    { NEXT_ROUND == ROUND + 1 },
    { INPUT_LOG == 1 },
    { OUTPUT == 1 },
    { PAIR_WIDTH == 0 },
    { PAIR_DEPTH == 0 },
    QUERY_HALF > 0,
    { (QUERY_HALF & (QUERY_HALF - 1)) == 0 },
    { QUERY_HALF <= 134217728 },
{
    fn sample_fri_query(
        _ complete: FriProofFold<ROUND, OUTPUT, FriProofEnd<NEXT_ROUND>>,
    ) -> FriQueryIndex<1> {
        let challenge = fri_query_challenge<ROUND, 1>(complete.layer.transcript)
        fri_query_index_power_of_two<1, QUERY_HALF>(challenge)
    }

    fn open_fri_query_layers(
        _ complete: own FriProofFold<ROUND, OUTPUT, FriProofEnd<NEXT_ROUND>>,
        _ index: u32,
    ) -> (bool, FriQueryEnd<ROUND>) {
        if !complete.valid
            || !complete.layer.valid
            || !complete.layer.root.valid
            || !complete.layer.transcript.valid
            || index != 0 {
            return (false, <Self as BabyBearFriQueryShape>::invalid_fri_query())
        }
        (
            true,
            FriQueryEnd {
                valid: true,
                root: complete.layer.root,
                evaluation: complete.layer.evaluations[0],
            },
        )
    }
}

impl<
    const QUERY_HALF: usize,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    Rest,
    TailComplete,
> BabyBearFriQueryLayers<
    QUERY_HALF,
    FriProofFold<ROUND, OUTPUT, TailComplete>,
> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    { ROUND > 0 },
    { ROUND < 100 },
    { INPUT_LOG > 1 },
    OUTPUT > 1,
    OUTPUT <= MAX_PADDED_TRACE_LENGTH,
    PAIR_WIDTH > 0,
    { PAIR_WIDTH + PAIR_WIDTH == OUTPUT },
    { PAIR_DEPTH + 2 == INPUT_LOG },
    { NEXT_ROUND == ROUND + 1 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriQueryLayers<QUERY_HALF, TailComplete>,
{
    fn sample_fri_query(
        _ complete: FriProofFold<ROUND, OUTPUT, TailComplete>,
    ) -> FriQueryIndex<1> {
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriQueryLayers<QUERY_HALF, TailComplete>>::sample_fri_query(complete.tail)
    }

    fn open_fri_query_layers(
        _ complete: own FriProofFold<ROUND, OUTPUT, TailComplete>,
        _ index: u32,
    ) -> (
        bool,
        FriQueryFold<
            ROUND,
            PAIR_DEPTH,
            <FriScheduleFold<
                NEXT_ROUND,
                NEXT_INPUT_LOG,
                NEXT_OUTPUT,
                NEXT_PAIR_WIDTH,
                NEXT_PAIR_DEPTH,
                Rest,
            > as BabyBearFriQueryShape>::Query,
        >,
    ) {
        let half: u32 = PAIR_WIDTH.downcast_truncate()
        let output: u32 = OUTPUT.downcast_truncate()
        if !complete.valid
            || !complete.layer.valid
            || !complete.layer.root.valid
            || !complete.layer.transcript.valid
            || index >= output {
            return (false, <Self as BabyBearFriQueryShape>::invalid_fri_query())
        }
        let pair_index = index & (half - 1)
        let path = fri_layer_pair_path_power_of_two<
            ROUND,
            OUTPUT,
            PAIR_WIDTH,
            PAIR_DEPTH,
        >(complete.layer.evaluations, pair_index)
        if !path.valid {
            return (false, <Self as BabyBearFriQueryShape>::invalid_fri_query())
        }
        let position: usize = pair_index as usize
        let tail = <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriQueryLayers<QUERY_HALF, TailComplete>>::open_fri_query_layers(
            complete.tail,
            pair_index,
        )
        if !tail.0 {
            return (false, <Self as BabyBearFriQueryShape>::invalid_fri_query())
        }
        (
            true,
            FriQueryFold {
                valid: true,
                root: complete.layer.root,
                pair: FriQueryPair {
                    positive: complete.layer.evaluations[position],
                    negative: complete.layer.evaluations[position + PAIR_WIDTH],
                    path: path,
                },
                tail: tail.1,
            },
        )
    }
}

/// One authenticated transcript-selected query through a 16-to-1 FRI chain.
/// The earlier AIR layer supplies `AirLdeTranscriptDigest`; this receipt does
/// not retain the full composition or folded codewords.
pub struct FriCommitmentQuery<const COMPOSITION_DEPTH: usize, Layers> {
    pub valid: bool,
    pub composition_root: CompositionDigest,
    pub query_index: u32,
    pub composition: CompositionQueryPair<COMPOSITION_DEPTH>,
    pub layers: Layers,
}
impl<const COMPOSITION_DEPTH: usize, Layers: core::marker::Copy> core::marker::Copy
    for FriCommitmentQuery<COMPOSITION_DEPTH, Layers> {}

const fn fri_composition_query_depth(_ input_log: usize) -> usize {
    if input_log == 0 { 0 } else { input_log - 1 }
}

pub type CheckpointFriQueryLayers16 =
    <FriSchedule<1, 4> as BabyBearFriQueryShape>::Query
pub type FriCommitmentQuery16 =
    FriCommitmentQuery<{fri_composition_query_depth(4)}, CheckpointFriQueryLayers16>

/// One composition multipath and one shared multipath for each nonterminal
/// FRI layer. The nested FRI carrier is derived from `FriSchedule`; no round
/// list or query-number list is duplicated in the receipt schema.
pub struct FriMultiCommitmentQuery<
    const COMPOSITION_MAX_LEAVES: usize,
    const COMPOSITION_MAX_SIBLINGS: usize,
    Layers,
> {
    pub valid: bool,
    pub composition_root: CompositionDigest,
    pub composition: CompositionMultiOpening<
        COMPOSITION_MAX_LEAVES,
        COMPOSITION_MAX_SIBLINGS,
    >,
    pub layers: Layers,
}
impl<
    const COMPOSITION_MAX_LEAVES: usize,
    const COMPOSITION_MAX_SIBLINGS: usize,
    Layers: core::marker::Copy,
> core::marker::Copy for FriMultiCommitmentQuery<
    COMPOSITION_MAX_LEAVES,
    COMPOSITION_MAX_SIBLINGS,
    Layers,
> {}
derive CanonicalWordStream for FriMultiCommitmentQuery<
    COMPOSITION_MAX_LEAVES,
    COMPOSITION_MAX_SIBLINGS,
    Layers,
> using CanonicalWordStreamProvider

pub type CheckpointFriMultiQueryLayers16 =
    <FriSchedule<1, 4> as BabyBearFriMultiQueryShape<4>>::Query
pub type CheckpointFriMultiChallenges16 =
    <FriSchedule<1, 4> as BabyBearFriMultiChallengeShape>::Challenges
pub type FriMultiCommitmentQuery16 = FriMultiCommitmentQuery<
    {4 + 4},
    {fri_multi_sibling_capacity(fri_composition_query_depth(4), 4)},
    CheckpointFriMultiQueryLayers16,
>

pub struct AirMultiOpenings<
    MainRole,
