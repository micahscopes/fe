//! BabyBear interpretation of the field-independent Mandelbrot schemas.
//!
//! Main rows, public statements, and Fe-derived auxiliary columns all flow
//! through the same exact-length 30-bit field encoder. Their 210, 114, and
//! 411 bits occupy 7, 4, and 14 BabyBear payload lanes respectively. The
//! largest value therefore still fits one typed width-16 Poseidon2 call.

use mandelbrot_proof_kernel::{
    AUXILIARY_ROW_BITS,
    ENCODED_PROOF_ROW_WIDTHS,
    ESCAPES_BY_Q12_PUBLIC_WIDTHS,
    ESCAPES_BY_Q12_PUBLIC_WORDS,
    MAX_PADDED_TRACE_LENGTH,
    EncodedProofRow,
    EscapesByQ12Public,
    derive_ranged_air_row,
    encoded_proof_row_words,
    encoded_ranged_auxiliary_row_bit,
    escapes_by_q12_public_words,
}
use merkle_core::{
    TwoToOneHasher,
    complete_frontier_root,
    empty_frontier,
    push_frontier,
}
use poseidon_baby_bear::{
    PackedCommitment,
    Poseidon2Domain,
    Poseidon2FieldDomain,
    commit_packed,
    compress as poseidon_compress,
    squeeze_ext4,
}
use precision::baby_bear::{BabyBear, BabyBearExt4, BabyBearModulus}
use precision::word_field_encoding::{PackedFieldBits, pack_bounded_words}

pub const ROW_FIELDS: usize = 7
pub const PUBLIC_FIELDS: usize = 4
pub const AUXILIARY_FIELDS: usize = 14
const TRACE_FRONTIER_LEVELS: usize = 22

const fn protocol_tag(_ label: String<4>) -> u32 {
    let bytes = label.as_bytes()
    ((bytes[0] as u32) << 24)
        | ((bytes[1] as u32) << 16)
        | ((bytes[2] as u32) << 8)
        | (bytes[3] as u32)
}

struct MandelbrotRowBabyBearV1 {}
struct MandelbrotPublicBabyBearV1 {}
struct MandelbrotAuxiliaryBabyBearV1 {}
struct MandelbrotRowNodeBabyBearV1 {}
struct MandelbrotAuxiliaryNodeBabyBearV1 {}
struct MandelbrotStatementBabyBearV1 {}
struct MandelbrotProofTranscriptBabyBearV1 {}
struct MandelbrotCompositionChallengeBabyBearV1 {}

impl Poseidon2Domain for MandelbrotRowBabyBearV1 {
    const TAG: u32 = protocol_tag("BR01")
}

impl Poseidon2Domain for MandelbrotPublicBabyBearV1 {
    const TAG: u32 = protocol_tag("BP01")
}

impl Poseidon2Domain for MandelbrotAuxiliaryBabyBearV1 {
    const TAG: u32 = protocol_tag("BA01")
}

impl Poseidon2FieldDomain for MandelbrotRowNodeBabyBearV1 {
    const TAG: u32 = protocol_tag("BN01")
}

impl Poseidon2FieldDomain for MandelbrotAuxiliaryNodeBabyBearV1 {
    const TAG: u32 = protocol_tag("BX01")
}

impl Poseidon2FieldDomain for MandelbrotStatementBabyBearV1 {
    const TAG: u32 = protocol_tag("BS01")
}

impl Poseidon2FieldDomain for MandelbrotProofTranscriptBabyBearV1 {
    const TAG: u32 = protocol_tag("BT01")
}

impl Poseidon2FieldDomain for MandelbrotCompositionChallengeBabyBearV1 {
    const TAG: u32 = protocol_tag("BC01")
}

pub struct RowDigest { pub valid: bool, pub value: BabyBear }
impl core::marker::Copy for RowDigest {}

pub struct PublicDigest { pub valid: bool, pub value: BabyBear }
impl core::marker::Copy for PublicDigest {}

pub struct AuxiliaryDigest { pub valid: bool, pub value: BabyBear }
impl core::marker::Copy for AuxiliaryDigest {}

pub struct StatementDigest { pub valid: bool, pub value: BabyBear }
impl core::marker::Copy for StatementDigest {}

pub struct ProofTranscriptDigest { pub valid: bool, pub value: BabyBear }
impl core::marker::Copy for ProofTranscriptDigest {}

pub struct CompositionChallenge { pub valid: bool, pub value: BabyBearExt4 }
impl core::marker::Copy for CompositionChallenge {}

struct RowNodeHasher {}
impl TwoToOneHasher<BabyBear> for RowNodeHasher {
    fn zero() -> BabyBear { BabyBear::zero() }
    fn equal(_ left: BabyBear, _ right: BabyBear) -> bool { left.equals(right) }
    fn hash2(_ left: BabyBear, _ right: BabyBear) -> BabyBear {
        poseidon_compress<MandelbrotRowNodeBabyBearV1>(left, right)
    }
}

struct AuxiliaryNodeHasher {}
impl TwoToOneHasher<BabyBear> for AuxiliaryNodeHasher {
    fn zero() -> BabyBear { BabyBear::zero() }
    fn equal(_ left: BabyBear, _ right: BabyBear) -> bool { left.equals(right) }
    fn hash2(_ left: BabyBear, _ right: BabyBear) -> BabyBear {
        poseidon_compress<MandelbrotAuxiliaryNodeBabyBearV1>(left, right)
    }
}

pub fn encoded_row_fields(
    _ row: own EncodedProofRow,
) -> PackedFieldBits<BabyBearModulus, ROW_FIELDS> {
    pack_bounded_words<BabyBearModulus, 17, ROW_FIELDS>(
        encoded_proof_row_words(row),
        ENCODED_PROOF_ROW_WIDTHS,
    )
}

pub fn encoded_public_fields(
    _ public: own EscapesByQ12Public,
) -> PackedFieldBits<BabyBearModulus, PUBLIC_FIELDS> {
    pack_bounded_words<BabyBearModulus, ESCAPES_BY_Q12_PUBLIC_WORDS, PUBLIC_FIELDS>(
        escapes_by_q12_public_words(public),
        ESCAPES_BY_Q12_PUBLIC_WIDTHS,
    )
}

pub fn encoded_auxiliary_fields(
    _ row: own EncodedProofRow,
) -> PackedFieldBits<BabyBearModulus, AUXILIARY_FIELDS> {
    let main = encoded_row_fields(row)
    if !main.is_valid() {
        return PackedFieldBits<BabyBearModulus, AUXILIARY_FIELDS>::empty().require(false)
    }
    let ranged = derive_ranged_air_row(row.air)
    let mut packed = PackedFieldBits<BabyBearModulus, AUXILIARY_FIELDS>::empty()
    let mut index: usize = 0
    while index < AUXILIARY_ROW_BITS {
        packed = packed.append(encoded_ranged_auxiliary_row_bit(ranged, index), 1)
        index = index + 1
    }
    packed
}

fn row_digest(_ digest: PackedCommitment) -> RowDigest {
    RowDigest { valid: digest.is_valid(), value: digest.field() }
}

fn public_digest(_ digest: PackedCommitment) -> PublicDigest {
    PublicDigest { valid: digest.is_valid(), value: digest.field() }
}

fn auxiliary_digest(_ digest: PackedCommitment) -> AuxiliaryDigest {
    AuxiliaryDigest { valid: digest.is_valid(), value: digest.field() }
}

pub fn row_commitment(_ row: own EncodedProofRow) -> RowDigest {
    row_digest(commit_packed<MandelbrotRowBabyBearV1, ROW_FIELDS>(
        encoded_row_fields(row),
    ))
}

pub fn public_commitment(_ public: own EscapesByQ12Public) -> PublicDigest {
    public_digest(commit_packed<MandelbrotPublicBabyBearV1, PUBLIC_FIELDS>(
        encoded_public_fields(public),
    ))
}

pub fn auxiliary_commitment(_ row: own EncodedProofRow) -> AuxiliaryDigest {
    auxiliary_digest(commit_packed<MandelbrotAuxiliaryBabyBearV1, AUXILIARY_FIELDS>(
        encoded_auxiliary_fields(row),
    ))
}

/// Commit a complete power-of-two main trace through the reusable zk-kit
/// Merkle shape. Invalid leaf encodings fail closed before entering the tree.
pub fn trace_root_power_of_two<const N: usize>(
    _ leaves: own [RowDigest; N],
) -> RowDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut frontier = empty_frontier<BabyBear, RowNodeHasher, TRACE_FRONTIER_LEVELS>()
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return RowDigest { valid: false, value: BabyBear::zero() }
        }
        frontier = push_frontier<BabyBear, RowNodeHasher, TRACE_FRONTIER_LEVELS>(
            frontier,
            leaves[index].value,
        )
        index = index + 1
    }
    let root = complete_frontier_root<BabyBear, RowNodeHasher, TRACE_FRONTIER_LEVELS>(frontier)
    RowDigest { valid: root.valid, value: root.value }
}

/// Commit a complete power-of-two auxiliary trace with its own nominal node
/// domain while sharing the exact same field-generic tree algorithm.
pub fn auxiliary_root_power_of_two<const N: usize>(
    _ leaves: own [AuxiliaryDigest; N],
) -> AuxiliaryDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut frontier = empty_frontier<BabyBear, AuxiliaryNodeHasher, TRACE_FRONTIER_LEVELS>()
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return AuxiliaryDigest { valid: false, value: BabyBear::zero() }
        }
        frontier = push_frontier<BabyBear, AuxiliaryNodeHasher, TRACE_FRONTIER_LEVELS>(
            frontier,
            leaves[index].value,
        )
        index = index + 1
    }
    let root = complete_frontier_root<BabyBear, AuxiliaryNodeHasher, TRACE_FRONTIER_LEVELS>(frontier)
    AuxiliaryDigest { valid: root.valid, value: root.value }
}

/// Bind the public claim and trace root as typed field elements.
pub fn bind_statement(
    _ public: own PublicDigest,
    _ trace: own RowDigest,
) -> StatementDigest {
    if !public.valid || !trace.valid {
        return StatementDigest { valid: false, value: BabyBear::zero() }
    }
    StatementDigest {
        valid: true,
        value: poseidon_compress<MandelbrotStatementBabyBearV1>(public.value, trace.value),
    }
}

/// Bind the auxiliary trace root into the proof transcript.
pub fn bind_auxiliary_trace(
    _ statement: own StatementDigest,
    _ auxiliary: own AuxiliaryDigest,
) -> ProofTranscriptDigest {
    if !statement.valid || !auxiliary.valid {
        return ProofTranscriptDigest { valid: false, value: BabyBear::zero() }
    }
    ProofTranscriptDigest {
        valid: true,
        value: poseidon_compress<MandelbrotProofTranscriptBabyBearV1>(
            statement.value,
            auxiliary.value,
        ),
    }
}

/// Derive a soundness challenge in the quartic extension field rather than
/// silently treating the u32-native base field as the challenge field.
pub fn composition_challenge(
    _ transcript: own ProofTranscriptDigest,
) -> CompositionChallenge {
    if !transcript.valid {
        return CompositionChallenge { valid: false, value: BabyBearExt4::zero() }
    }
    CompositionChallenge {
        valid: true,
        value: squeeze_ext4<MandelbrotCompositionChallengeBabyBearV1>(
            transcript.value,
            BabyBear::zero(),
        ),
    }
}
