    pub valid: bool,
    pub value: Poseidon2Digest,
}
impl<const ROUND: u32> core::marker::Copy for FriLayerTranscriptDigest<ROUND> {}

pub struct FriFoldEvaluations<const N: usize> {
    pub valid: bool,
    pub evaluations: [BabyBearExt4; N],
}
impl<const N: usize> core::marker::Copy for FriFoldEvaluations<N> {}

/// One committed output layer in a schedule-derived FRI proof. Every fold has
/// the same carrier shape, including the final one-element layer.
pub struct FriCommittedLayer<const ROUND: u32, const N: usize> {
    pub valid: bool,
    pub evaluations: [BabyBearExt4; N],
    pub root: FriLayerDigest<ROUND>,
    pub transcript: FriLayerTranscriptDigest<ROUND>,
}
impl<const ROUND: u32, const N: usize> core::marker::Copy for FriCommittedLayer<ROUND, N> {}

/// The value-level terminal corresponding to `FriScheduleDone`.
pub struct FriProofEnd<const NEXT_ROUND: u32> {}
impl<const NEXT_ROUND: u32> core::marker::Copy for FriProofEnd<NEXT_ROUND> {}

/// One value-level fold corresponding to `FriScheduleFold`. `Tail` is the
/// recursively interpreted remainder of the same field-neutral schedule.
pub struct FriProofFold<const ROUND: u32, const N: usize, Tail> {
    pub valid: bool,
    pub layer: FriCommittedLayer<ROUND, N>,
    pub tail: Tail,
}
impl<const ROUND: u32, const N: usize, Tail: core::marker::Copy> core::marker::Copy
    for FriProofFold<ROUND, N, Tail> {}

/// Continue a FRI fold after the previous layer has been committed. The
/// schedule tail decides whether to derive another challenge and fold, or stop
/// immediately at `FriScheduleDone`, so the final layer never performs an
/// unused transcript squeeze.
pub trait BabyBearFriTail<const PREVIOUS: u32, const INPUT: usize> {
    type Proof
    fn invalid_fri_tail() -> Self::Proof
    fn fold_fri_tail(
        _ evaluations: own [BabyBearExt4; INPUT],
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ shift: BabyBear,
    ) -> (bool, Self::Proof)
}

impl<
    const PREVIOUS: u32,
    const INPUT: usize,
    const NEXT_ROUND: u32,
> BabyBearFriTail<PREVIOUS, INPUT> for FriScheduleDone<NEXT_ROUND>
where { NEXT_ROUND == PREVIOUS + 1 }, { INPUT == 1 }
{
    type Proof = FriProofEnd<NEXT_ROUND>

    fn invalid_fri_tail() -> FriProofEnd<NEXT_ROUND> {
        FriProofEnd<NEXT_ROUND> {}
    }

    fn fold_fri_tail(
        _ evaluations: own [BabyBearExt4; INPUT],
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ shift: BabyBear,
    ) -> (bool, FriProofEnd<NEXT_ROUND>) {
        if !transcript.valid || shift.is_zero() {
            return (false, <Self as BabyBearFriTail<PREVIOUS, INPUT>>::invalid_fri_tail())
        }
        (true, FriProofEnd<NEXT_ROUND> {})
    }
}

impl<
    const PREVIOUS: u32,
    const INPUT: usize,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    Tail: BabyBearFriTail<ROUND, OUTPUT>,
> BabyBearFriTail<PREVIOUS, INPUT> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    Tail,
>
where
    { PREVIOUS > 0 },
    { ROUND == PREVIOUS + 1 },
    { ROUND > 0 },
    { ROUND < 100 },
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { INPUT == OUTPUT + OUTPUT },
    OUTPUT > 0,
    OUTPUT <= MAX_PADDED_TRACE_LENGTH,
    { (OUTPUT & (OUTPUT - 1)) == 0 },
{
    type Proof = FriProofFold<
        ROUND,
        OUTPUT,
        <Tail as BabyBearFriTail<ROUND, OUTPUT>>::Proof,
    >

    fn invalid_fri_tail() -> FriProofFold<
        ROUND,
        OUTPUT,
        <Tail as BabyBearFriTail<ROUND, OUTPUT>>::Proof,
    > {
        FriProofFold<
            ROUND,
            OUTPUT,
            <Tail as BabyBearFriTail<ROUND, OUTPUT>>::Proof,
        > {
            valid: false,
            layer: FriCommittedLayer {
                valid: false,
                evaluations: [BabyBearExt4::zero(); OUTPUT],
                root: FriLayerDigest {
                    valid: false,
                    value: Poseidon2Digest::zero(),
                },
                transcript: FriLayerTranscriptDigest {
                    valid: false,
                    value: Poseidon2Digest::zero(),
                },
            },
            tail: <Tail as BabyBearFriTail<ROUND, OUTPUT>>::invalid_fri_tail(),
        }
    }

    fn fold_fri_tail(
        _ evaluations: own [BabyBearExt4; INPUT],
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ shift: BabyBear,
    ) -> (
        bool,
        FriProofFold<
            ROUND,
            OUTPUT,
            <Tail as BabyBearFriTail<ROUND, OUTPUT>>::Proof,
        >,
    ) {
        let challenge = next_fri_fold_challenge<PREVIOUS, ROUND>(transcript)
        if !challenge.valid || shift.is_zero() {
            return (false, <Self as BabyBearFriTail<PREVIOUS, INPUT>>::invalid_fri_tail())
        }
        let folded = fold_fri_evaluations<INPUT, OUTPUT>(
            evaluations,
            challenge.value,
            shift,
        )
        if !folded.valid {
            return (false, <Self as BabyBearFriTail<PREVIOUS, INPUT>>::invalid_fri_tail())
        }
        let root = commit_fri_layer<ROUND, OUTPUT>(folded.evaluations)
        let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, root)
        if !root.valid || !next_transcript.valid {
            return (false, <Self as BabyBearFriTail<PREVIOUS, INPUT>>::invalid_fri_tail())
        }
        let tail = <Tail as BabyBearFriTail<ROUND, OUTPUT>>::fold_fri_tail(
            folded.evaluations,
            next_transcript,
            shift.square(),
        )
        if !tail.0 {
            return (false, <Self as BabyBearFriTail<PREVIOUS, INPUT>>::invalid_fri_tail())
        }
        (
            true,
            FriProofFold<
                ROUND,
                OUTPUT,
                <Tail as BabyBearFriTail<ROUND, OUTPUT>>::Proof,
            > {
                valid: true,
                layer: FriCommittedLayer {
                    valid: true,
                    evaluations: folded.evaluations,
                    root: root,
                    transcript: next_transcript,
                },
                tail: tail.1,
            },
        )
    }
}

/// Interpret the first schedule node from the AIR composition transcript. All
/// later nodes use `BabyBearFriTail`, so this is the only protocol-specific
/// distinction between the initial FRI challenge and subsequent challenges.
pub trait BabyBearFriFirst<const INPUT: usize> {
    type Proof
    fn invalid_fri_first() -> Self::Proof
    fn fold_fri_first(
        _ evaluations: own [BabyBearExt4; INPUT],
        _ transcript: own CompositionTranscriptDigest,
        _ shift: BabyBear,
    ) -> (bool, Self::Proof)
}

impl<
    const INPUT: usize,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    Tail: BabyBearFriTail<1, OUTPUT>,
> BabyBearFriFirst<INPUT> for FriScheduleFold<
    1,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    Tail,
>
where
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { INPUT == OUTPUT + OUTPUT },
    OUTPUT > 0,
    OUTPUT <= MAX_PADDED_TRACE_LENGTH,
    { (OUTPUT & (OUTPUT - 1)) == 0 },
{
    type Proof = FriProofFold<
        1,
        OUTPUT,
        <Tail as BabyBearFriTail<1, OUTPUT>>::Proof,
    >

    fn invalid_fri_first() -> FriProofFold<
        1,
        OUTPUT,
        <Tail as BabyBearFriTail<1, OUTPUT>>::Proof,
    > {
        FriProofFold<
            1,
            OUTPUT,
            <Tail as BabyBearFriTail<1, OUTPUT>>::Proof,
        > {
            valid: false,
            layer: FriCommittedLayer {
                valid: false,
                evaluations: [BabyBearExt4::zero(); OUTPUT],
                root: FriLayerDigest {
                    valid: false,
                    value: Poseidon2Digest::zero(),
                },
                transcript: FriLayerTranscriptDigest {
                    valid: false,
                    value: Poseidon2Digest::zero(),
                },
            },
            tail: <Tail as BabyBearFriTail<1, OUTPUT>>::invalid_fri_tail(),
        }
    }

    fn fold_fri_first(
        _ evaluations: own [BabyBearExt4; INPUT],
        _ transcript: own CompositionTranscriptDigest,
        _ shift: BabyBear,
    ) -> (
        bool,
        FriProofFold<
            1,
            OUTPUT,
            <Tail as BabyBearFriTail<1, OUTPUT>>::Proof,
        >,
    ) {
        let challenge = fri_fold_challenge(transcript)
        if !challenge.valid || shift.is_zero() {
            return (false, <Self as BabyBearFriFirst<INPUT>>::invalid_fri_first())
        }
        let folded = fold_fri_evaluations<INPUT, OUTPUT>(
            evaluations,
            challenge.value,
            shift,
        )
        if !folded.valid {
            return (false, <Self as BabyBearFriFirst<INPUT>>::invalid_fri_first())
        }
        let root = commit_fri_layer<1, OUTPUT>(folded.evaluations)
        let next_transcript = bind_first_fri_layer(transcript, root)
        if !root.valid || !next_transcript.valid {
            return (false, <Self as BabyBearFriFirst<INPUT>>::invalid_fri_first())
        }
        let tail = <Tail as BabyBearFriTail<1, OUTPUT>>::fold_fri_tail(
            folded.evaluations,
            next_transcript,
            shift.square(),
        )
        if !tail.0 {
            return (false, <Self as BabyBearFriFirst<INPUT>>::invalid_fri_first())
        }
        (
            true,
            FriProofFold<
                1,
                OUTPUT,
                <Tail as BabyBearFriTail<1, OUTPUT>>::Proof,
            > {
                valid: true,
                layer: FriCommittedLayer {
                    valid: true,
                    evaluations: folded.evaluations,
                    root: root,
                    transcript: next_transcript,
                },
                tail: tail.1,
            },
        )
    }
}

pub fn fold_fri_schedule<
    const INPUT: usize,
    S: BabyBearFriFirst<INPUT>,
>(
    _ evaluations: own [BabyBearExt4; INPUT],
    _ transcript: own CompositionTranscriptDigest,
    _ shift: BabyBear,
) -> <S as BabyBearFriFirst<INPUT>>::Proof {
    <S as BabyBearFriFirst<INPUT>>::fold_fri_first(
        evaluations,
        transcript,
        shift,
    ).1
}

/// The existing 16-point complete-codeword gate is an explicit protocol
/// checkpoint. Its nested storage is nevertheless derived from `FriSchedule`.
pub type CheckpointFriProof16 =
    <FriSchedule<1, 4> as BabyBearFriFirst<16>>::Proof

pub struct CompositionPairPath<const DEPTH: usize> {
    pub valid: bool,
    pub index: u32,
    pub positive_siblings: [Poseidon2Digest; DEPTH],
    pub negative_siblings: [Poseidon2Digest; DEPTH],
}
impl<const DEPTH: usize> core::marker::Copy for CompositionPairPath<DEPTH> {}

/// A role-branded authentication path for one common local position in each
/// quarter of an AIR LDE tree. `Role` is compile-time-only: it distinguishes
/// main and auxiliary paths without duplicating their runtime representation
/// or the field-generic `merkle_core` interpreter.
pub struct LdeQuartetPath<Role, const DEPTH: usize> {
    pub valid: bool,
    pub index: u32,
    pub first_siblings: [Poseidon2Digest; DEPTH],
    pub second_siblings: [Poseidon2Digest; DEPTH],
    pub third_siblings: [Poseidon2Digest; DEPTH],
    pub fourth_siblings: [Poseidon2Digest; DEPTH],
}
impl<Role, const DEPTH: usize> core::marker::Copy for LdeQuartetPath<Role, DEPTH> {}

pub struct MainLdeTreeRole {}
pub struct AuxiliaryLdeTreeRole {}
pub type MainLdeQuartetPath<const DEPTH: usize> = LdeQuartetPath<MainLdeTreeRole, DEPTH>
pub type AuxiliaryLdeQuartetPath<const DEPTH: usize> =
    LdeQuartetPath<AuxiliaryLdeTreeRole, DEPTH>

/// Canonical sparse opening for one role-branded base-field LDE tree.
pub struct LdeMultiOpening<
    Role,
    Value,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> {
    pub valid: bool,
    pub values: [Value; MAX_LEAVES],
    pub path: MerkleMultiPath<Poseidon2Digest, MAX_LEAVES, MAX_SIBLINGS>,
}
impl<
    Role,
    Value: core::marker::Copy,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> core::marker::Copy for LdeMultiOpening<Role, Value, MAX_LEAVES, MAX_SIBLINGS> {}

/// Every sparse tree role shares one canonical variable-size carrier. The
/// path is encoded first so decoding learns the leaf count before consuming
/// the matching value prefix. `Role` remains compile-time-only.
impl<
    Role,
    Value: core::marker::Copy + CanonicalWordStream,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> CanonicalWordStream for LdeMultiOpening<
    Role,
    Value,
    MAX_LEAVES,
    MAX_SIBLINGS,
> {
    fn word_count(ref self) -> u32 {
        if self.path.leaf_count > MAX_LEAVES.downcast_truncate() { return 0 }
        self.valid.word_count()
            + self.path.word_count()
            + canonical_prefix_word_count(ref self.values, self.path.leaf_count)
    }

    fn encode_stream<W: WordSink>(ref self, _ writer: W) -> W {
        if self.path.leaf_count > MAX_LEAVES.downcast_truncate() {
            return writer.reject()
        }
        let writer = self.valid.encode_stream(writer)
        let writer = self.path.encode_stream(writer)
        encode_canonical_prefix(ref self.values, self.path.leaf_count, writer)
    }

    fn decode_stream<R: WordSource>(mut self, _ reader: R) -> R {
        let reader = self.valid.decode_stream(reader)
        let reader = self.path.decode_stream(reader)
        if self.path.leaf_count > MAX_LEAVES.downcast_truncate() {
            self.valid = false
            return reader.reject()
        }
        decode_canonical_prefix(mut self.values, self.path.leaf_count, reader)
    }
}

pub type MainLdeMultiOpening<
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> = LdeMultiOpening<
    MainLdeTreeRole,
    [BabyBear; MAIN_LDE_ROW_FIELDS],
    MAX_LEAVES,
    MAX_SIBLINGS,
>
pub type AuxiliaryLdeMultiOpening<
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> = LdeMultiOpening<
    AuxiliaryLdeTreeRole,
    [BabyBear; AUXILIARY_ROW_BITS],
    MAX_LEAVES,
    MAX_SIBLINGS,
>

/// One authenticated verifier row. Main and auxiliary values remain in the
/// u32-native base field; the shared AIR view embeds them into the quartic
/// challenge field only while recomputing the composition value.
pub struct AirLdeRow {
    pub main: [BabyBear; MAIN_LDE_ROW_FIELDS],
    pub auxiliary: [BabyBear; AUXILIARY_ROW_BITS],
}
impl core::marker::Copy for AirLdeRow {}

/// Prover-side base-field codewords derived from one canonical trace. Keeping
/// main and auxiliary columns separate preserves their commitment domains and
/// lets sparse receipt openers borrow either matrix directly.
pub struct BabyBearAirLdeCodeword<const N: usize> {
    pub valid: bool,
    pub main: [[BabyBear; MAIN_LDE_ROW_FIELDS]; N],
    pub auxiliary: [[BabyBear; AUXILIARY_ROW_BITS]; N],
}
impl<const N: usize> core::marker::Copy for BabyBearAirLdeCodeword<N> {}

pub const EMPTY_CHECKPOINT4_AIR_LDE_CODEWORD16: BabyBearAirLdeCodeword<16> =
    BabyBearAirLdeCodeword {
        valid: false,
        main: [[BabyBear::zero(); MAIN_LDE_ROW_FIELDS]; 16],
        auxiliary: [[BabyBear::zero(); AUXILIARY_ROW_BITS]; 16],
    }

impl AirColumnView<BabyBearExt4> for AirLdeRow {
    fn main(ref self, _ column: usize) -> BabyBearExt4 {
        BabyBearExt4::from_base(self.main[column])
    }

    fn auxiliary(ref self, _ column: usize) -> BabyBearExt4 {
        BabyBearExt4::from_base(self.auxiliary[column])
    }
}

/// The four-row trace checkpoint opens one common local position in every LDE
/// quarter. `radix2_query_geometry<4, LDE>` derives which quarters represent
/// current, next, negative, and negative-next rows for a transcript query.
pub struct Checkpoint4AirLdeOpening<const DEPTH: usize> {
    pub valid: bool,
    pub rows: [AirLdeRow; 4],
    pub main_path: MainLdeQuartetPath<DEPTH>,
    pub auxiliary_path: AuxiliaryLdeQuartetPath<DEPTH>,
}
impl<const DEPTH: usize> core::marker::Copy for Checkpoint4AirLdeOpening<DEPTH> {}

pub const ZERO_AIR_LDE_ROW: AirLdeRow = AirLdeRow {
    main: [BabyBear::zero(); MAIN_LDE_ROW_FIELDS],
    auxiliary: [BabyBear::zero(); AUXILIARY_ROW_BITS],
}

/// Interpret the shared radix-2 LDE plan once per canonical AIR column. The
/// transform, twiddle derivation, and coset validation remain field-generic;
/// this function only supplies the checkpoint's nominal column vocabulary.
pub fn write_checkpoint4_air_lde_codeword16(
    _ rows: ref [EncodedProofRow; 4],
    _ shift: BabyBear,
    _ output: mut BabyBearAirLdeCodeword<16>,
) -> bool {
    output.valid = false
    output.main = [[BabyBear::zero(); MAIN_LDE_ROW_FIELDS]; 16]
    output.auxiliary = [[BabyBear::zero(); AUXILIARY_ROW_BITS]; 16]

    let mut column: usize = 0
    while column < MAIN_LDE_ROW_FIELDS {
        let mut base = [BabyBear::zero(); 4]
        let mut row: usize = 0
        while row < 4 {
            base[row] = BabyBear::from_u32(encoded_proof_row_words(rows[row])[column])
            row = row + 1
        }
        let extended = radix2_word_coset_lde<4, 16, BabyBearModulus>(base, shift)
        if !extended.valid { return false }
        let mut evaluation: usize = 0
        while evaluation < 16 {
            output.main[evaluation][column] = extended.evaluations[evaluation]
            evaluation = evaluation + 1
        }
        column = column + 1
    }

    column = 0
    while column < AUXILIARY_ROW_BITS {
        let mut base = [BabyBear::zero(); 4]
        let mut row: usize = 0
        while row < 4 {
            base[row] = BabyBear::from_u32(
                encoded_auxiliary_row_bit(rows[row].air, column),
            )
            row = row + 1
        }
        let extended = radix2_word_coset_lde<4, 16, BabyBearModulus>(base, shift)
        if !extended.valid { return false }
        let mut evaluation: usize = 0
        while evaluation < 16 {
            output.auxiliary[evaluation][column] = extended.evaluations[evaluation]
            evaluation = evaluation + 1
        }
        column = column + 1
    }
    output.valid = true
    true
}

/// Production checkpoint entry: the LDE consumes only the typed Mandelbrot
/// claim. No host-authored witness row can cross this boundary.
pub fn write_checkpoint4_air_lde_from_claim16(
    _ claim: EscapesByQ12,
    _ shift: BabyBear,
    _ output: mut BabyBearAirLdeCodeword<16>,
) -> bool {
    let trace = encoded_proof_trace_exact<4>(claim)
    if !trace.valid {
        output.valid = false
        output.main = [[BabyBear::zero(); MAIN_LDE_ROW_FIELDS]; 16]
        output.auxiliary = [[BabyBear::zero(); AUXILIARY_ROW_BITS]; 16]
        return false
    }
    write_checkpoint4_air_lde_codeword16(ref trace.rows, shift, mut output)
}

