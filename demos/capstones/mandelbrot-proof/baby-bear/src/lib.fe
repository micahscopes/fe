    const ROUND: u32,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
    Tail,
> {
    pub valid: bool,
    pub root: FriLayerDigest<ROUND>,
    pub opening: FriLayerMultiOpening<ROUND, MAX_LEAVES, MAX_SIBLINGS>,
    pub tail: Tail,
}
impl<
    const ROUND: u32,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
    Tail: core::marker::Copy,
> core::marker::Copy for FriMultiQueryFold<ROUND, MAX_LEAVES, MAX_SIBLINGS, Tail> {}
derive CanonicalWordStream for FriMultiQueryFold<
    ROUND,
    MAX_LEAVES,
    MAX_SIBLINGS,
    Tail,
> using CanonicalWordStreamProvider

/// The one-evaluation terminal is shared by every query and needs no path.
