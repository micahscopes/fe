/// One reusable FRI binary fold over the quartic BabyBear challenge field.
/// Evaluations at `x` and `-x` become one evaluation at `x^2`.
pub fn fold_fri_evaluations<const N: usize, const OUT: usize>(
    _ evaluations: own [BabyBearExt4; N],
    _ challenge: BabyBearExt4,
    _ shift: BabyBear,
) -> FriFoldEvaluations<OUT>
where N > 0, N > 1, { (N & (N - 1)) == 0 }, OUT > 0, { OUT + OUT == N }
{
    if shift.is_zero() {
        return FriFoldEvaluations<OUT> {
            valid: false,
            evaluations: [BabyBearExt4::zero(); OUT],
        }
    }
    let inverse_two = BabyBearExt4::from_base(BabyBear::from_u32(2)).inverse_or_zero()
    let root = BabyBear::two_adic_root(radix2_log<N>())
    let mut point = shift
    let mut folded = [BabyBearExt4::zero(); OUT]
    let mut index: usize = 0
    while index < OUT {
        let positive = evaluations[index]
        let negative = evaluations[index + OUT]
        let even = (positive + negative) * inverse_two
        let odd = (positive - negative)
            * inverse_two
            * BabyBearExt4::from_base(point.inverse_or_zero())
        folded[index] = even + challenge * odd
        point = point * root
        index = index + 1
    }
    FriFoldEvaluations<OUT> { valid: true, evaluations: folded }
}

fn invalid_composition_query_pair<const DEPTH: usize>() -> CompositionQueryPair<DEPTH> {
    CompositionQueryPair<DEPTH> {
        positive: BabyBearExt4::zero(),
        negative: BabyBearExt4::zero(),
        path: CompositionPairPath<DEPTH> {
            valid: false,
            index: 0,
            positive_siblings: [Poseidon2Digest::zero(); DEPTH],
            negative_siblings: [Poseidon2Digest::zero(); DEPTH],
        },
    }
}

fn invalid_fri_query_pair<const ROUND: u32, const DEPTH: usize>() -> FriQueryPair<
    ROUND,
    DEPTH,
> {
    FriQueryPair<ROUND, DEPTH> {
        positive: BabyBearExt4::zero(),
        negative: BabyBearExt4::zero(),
        path: FriLayerPairPath<ROUND, DEPTH> {
            valid: false,
            index: 0,
            positive_siblings: [Poseidon2Digest::zero(); DEPTH],
            negative_siblings: [Poseidon2Digest::zero(); DEPTH],
        },
    }
}

fn invalid_fri_query16() -> FriCommitmentQuery16 {
    FriCommitmentQuery16 {
        valid: false,
        composition_root: CompositionDigest { valid: false, value: Poseidon2Digest::zero() },
        query_index: 0,
        composition: invalid_composition_query_pair<3>(),
        layers: <FriSchedule<1, 4> as BabyBearFriQueryShape>::invalid_fri_query(),
    }
}

fn invalid_fri_multi_query16() -> FriMultiCommitmentQuery16 {
    FriMultiCommitmentQuery16 {
        valid: false,
        composition_root: CompositionDigest {
            valid: false,
            value: Poseidon2Digest::zero(),
        },
        composition: empty_composition_multi_opening<
            {4 + 4},
            {fri_multi_sibling_capacity(fri_composition_query_depth(4), 4)},
        >(),
        layers: <FriSchedule<1, 4> as BabyBearFriMultiQueryLayers<
            4,
            8,
            8,
            CheckpointFriQueryPlan4,
            CheckpointFriQuerySamples4,
            CheckpointFriProof16,
            CheckpointFriMultiQueryLayers16,
        >>::invalid_fri_multi_query_layers(),
    }
}

/// Construct the canonical empty value required before bounded decoding.
pub fn empty_checkpoint4_baby_bear_receipt16() -> Checkpoint4BabyBearReceipt16 {
    BabyBearAirFriReceipt {
        valid: false,
        main_root: MainLdeDigest {
            valid: false,
            value: Poseidon2Digest::zero(),
        },
        auxiliary_root: AuxiliaryLdeDigest {
            valid: false,
            value: Poseidon2Digest::zero(),
        },
        air: AirMultiOpenings {
            main: LdeMultiOpening {
                valid: false,
                values: [[BabyBear::zero(); MAIN_LDE_ROW_FIELDS];
                    {air_lde_request_capacity(4)}],
                path: invalid_digest_multi_path<
                    {air_lde_request_capacity(4)},
                    {air_lde_sibling_capacity(4)},
                >(),
            },
            auxiliary: LdeMultiOpening {
                valid: false,
                values: [[BabyBear::zero(); AUXILIARY_ROW_BITS];
                    {air_lde_request_capacity(4)}],
                path: invalid_digest_multi_path<
                    {air_lde_request_capacity(4)},
                    {air_lde_sibling_capacity(4)},
                >(),
            },
        },
        fri: invalid_fri_multi_query16(),
    }
}

/// Reset a caller-owned checkpoint carrier without exposing its storage
/// layout to the browser host.
pub fn clear_checkpoint4_baby_bear_receipt16(
    _ receipt: mut Checkpoint4BabyBearReceipt16,
) {
    receipt = empty_checkpoint4_baby_bear_receipt16()
}

/// Encode only the counted sparse prefixes of one checkpoint receipt into
/// browser linear memory. The schema and field order come from Fe types and
/// their FCO-derived canonical stream implementations.
pub fn encode_checkpoint4_baby_bear_receipt16(
    _ receipt: ref Checkpoint4BabyBearReceipt16,
) -> BrowserBytes {
    let words = canonical_word_stream_count(receipt)
    if words == 0 { return BrowserBytes { ptr: 0, len: 0 } }
    encode_canonical_word_stream(
        receipt,
        BrowserWordWriter::allocate(words),
    ).finish()
}

/// Decode a canonical checkpoint receipt from browser linear memory. The
/// bounded reader rejects truncation, trailing data, invalid booleans,
/// over-capacity sparse counts, and non-canonical field representatives.
pub fn decode_checkpoint4_baby_bear_receipt16(
    _ bytes: BrowserBytes,
    _ receipt: mut Checkpoint4BabyBearReceipt16,
) -> bool {
    clear_checkpoint4_baby_bear_receipt16(mut receipt)
    let reader = receipt.decode_stream(BrowserWordReader::new(bytes))
    reader.complete()
}

fn commit_fri_layer<const ROUND: u32, const N: usize>(
    _ evaluations: own [BabyBearExt4; N],
) -> FriLayerDigest<ROUND>
where
    { ROUND > 0 },
    { ROUND < 100 },
    N > 0,
    N <= MAX_PADDED_TRACE_LENGTH,
    { (N & (N - 1)) == 0 },
{
    let mut leaves = [FriLayerDigest<ROUND> {
        valid: false,
        value: Poseidon2Digest::zero(),
    }; N]
    let mut index: usize = 0
    while index < N {
        leaves[index] = fri_layer_row_commitment<ROUND>(evaluations[index])
        index = index + 1
    }
    fri_layer_root_power_of_two<ROUND, N>(leaves)
}

/// Materialize the current authenticated 16-to-1 checkpoint in the
/// schedule-derived carrier. Every next challenge is squeezed only after the
/// preceding folded layer has been committed. Both its type and term-level
/// traversal are interpretations of `FriSchedule<1, 4>`.
pub fn fold_checkpoint_fri16(
    _ evaluations: own [BabyBearExt4; 16],
    _ transcript: own CompositionTranscriptDigest,
    _ shift: BabyBear,
) -> CheckpointFriProof16 {
    fold_fri_schedule<16, FriSchedule<1, 4>>(evaluations, transcript, shift)
}

/// Open four transcript-derived queries with one canonical sparse Merkle path
/// per commitment layer. Both recursive layer traversal and query sampling are
/// interpretations of the field-neutral schedule and query plan.
pub fn open_fri_multi_commitment_query16(
    _ evaluations: own [BabyBearExt4; 16],
    _ air_transcript: own AirLdeTranscriptDigest,
    _ shift: BabyBear,
) -> FriMultiCommitmentQuery16 {
    if !air_transcript.valid || shift.is_zero() {
        return invalid_fri_multi_query16()
    }

    let mut composition_leaves = [CompositionDigest {
        valid: false,
        value: Poseidon2Digest::zero(),
    }; 16]
    let mut cursor: usize = 0
    while cursor < 16 {
        composition_leaves[cursor] = composition_row_commitment(evaluations[cursor])
        cursor = cursor + 1
    }
    let composition_root = composition_root_power_of_two<16>(composition_leaves)
    let composition_transcript = bind_composition(air_transcript, composition_root)
    let complete = fold_checkpoint_fri16(evaluations, composition_transcript, shift)
    if !composition_root.valid || !composition_transcript.valid || !complete.valid {
        return invalid_fri_multi_query16()
    }

    let sampled = <FriSchedule<1, 4> as BabyBearFriMultiQueryLayers<
        4,
        8,
        8,
        CheckpointFriQueryPlan4,
        CheckpointFriQuerySamples4,
        CheckpointFriProof16,
        CheckpointFriMultiQueryLayers16,
    >>::sample_fri_multi_queries(ref complete)
    if !sampled.0 { return invalid_fri_multi_query16() }

    let composition = composition_multi_query_opening_power_of_two<
        CheckpointFriQueryPlan4,
        CheckpointFriQuerySamples4,
        16,
        8,
        8,
        {4 + 4},
        {fri_multi_sibling_capacity(fri_composition_query_depth(4), 4)},
    >(evaluations, sampled.1)
    let layers = <FriSchedule<1, 4> as BabyBearFriMultiQueryLayers<
        4,
        8,
        8,
        CheckpointFriQueryPlan4,
        CheckpointFriQuerySamples4,
        CheckpointFriProof16,
        CheckpointFriMultiQueryLayers16,
    >>::open_fri_multi_query_layers(complete, sampled.1)
    if !composition.valid || !layers.0 {
        return invalid_fri_multi_query16()
    }
    FriMultiCommitmentQuery16 {
        valid: true,
        composition_root: composition_root,
        composition: composition,
        layers: layers.1,
    }
}

pub fn open_fri_commitment_query16(
    _ evaluations: own [BabyBearExt4; 16],
    _ air_transcript: own AirLdeTranscriptDigest,
    _ shift: BabyBear,
) -> FriCommitmentQuery16 {
    if !air_transcript.valid || shift.is_zero() {
        return invalid_fri_query16()
    }

    let mut composition_leaves = [CompositionDigest {
        valid: false,
        value: Poseidon2Digest::zero(),
    }; 16]
    let mut cursor: usize = 0
    while cursor < 16 {
        composition_leaves[cursor] = composition_row_commitment(evaluations[cursor])
        cursor = cursor + 1
    }
    let composition_root = composition_root_power_of_two<16>(composition_leaves)
    let composition_transcript = bind_composition(air_transcript, composition_root)
    let complete = fold_checkpoint_fri16(evaluations, composition_transcript, shift)
    if !composition_root.valid || !composition_transcript.valid || !complete.valid {
        return invalid_fri_query16()
    }
    let query = <FriSchedule<1, 4>
        as BabyBearFriQueryLayers<8, CheckpointFriProof16>>::sample_fri_query(complete)
    if !query.valid { return invalid_fri_query16() }

    let composition_path = composition_pair_path_power_of_two<16, 8, 3>(
        evaluations,
        query.value,
    )
    let layers = <FriSchedule<1, 4>
        as BabyBearFriQueryLayers<8, CheckpointFriProof16>>::open_fri_query_layers(
        complete,
        query.value,
    )
    if !composition_path.valid || !layers.0 {
        return invalid_fri_query16()
    }

    let composition_index: usize = query.value as usize
    FriCommitmentQuery16 {
        valid: true,
        composition_root: composition_root,
        query_index: query.value,
        composition: CompositionQueryPair<3> {
            positive: evaluations[composition_index],
            negative: evaluations[composition_index + 8],
            path: composition_path,
        },
        layers: layers.1,
    }
}

fn fold_fri_pair_at<const N: usize>(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ challenge: BabyBearExt4,
    _ shift: BabyBear,
    _ index: u32,
) -> FriFoldEvaluations<1>
where N > 0, N > 1, { (N & (N - 1)) == 0 }
{
    let point = shift * BabyBear::two_adic_root(radix2_log<N>()).pow_u32(index)
    fold_fri_evaluations<2, 1>([positive, negative], challenge, point)
}

/// Check one sampled query across every FRI fold using only lookups into
/// already-authenticated sparse openings.
pub trait BabyBearFriMultiFoldCheck<
    const INPUT: usize,
    Input,
    Layers,
    Challenges,
> {
    fn verify_fri_multi_fold(
        _ input: Input,
        _ layers: Layers,
        _ challenges: Challenges,
        _ query: u32,
        _ shift: BabyBear,
    ) -> bool
}

impl<
    const INPUT: usize,
    Input: Ext4SparseOpening,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
> BabyBearFriMultiFoldCheck<
    INPUT,
    Input,
    FriMultiQueryEnd<ROUND>,
    FriMultiChallengeFold<ROUND, FriMultiChallengeDone<NEXT_ROUND>>,
> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleDone<NEXT_ROUND>,
>
where
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { ROUND > 0 },
    { ROUND < 100 },
    { NEXT_ROUND == ROUND + 1 },
    { INPUT_LOG == 1 },
    { OUTPUT == 1 },
    { PAIR_WIDTH == 0 },
    { PAIR_DEPTH == 0 },
{
    fn verify_fri_multi_fold(
        _ input: Input,
        _ layers: FriMultiQueryEnd<ROUND>,
        _ challenges: FriMultiChallengeFold<ROUND, FriMultiChallengeDone<NEXT_ROUND>>,
        _ query: u32,
        _ shift: BabyBear,
    ) -> bool {
        let output: u32 = OUTPUT.downcast_truncate()
        let index = query & (output - 1)
        let positive = input.sparse_value(index)
        let negative = input.sparse_value(index + output)
        if shift.is_zero() || !positive.valid || !negative.valid
            || !layers.valid || !challenges.valid || !challenges.challenge.valid
            || !challenges.tail.valid {
            return false
        }
        let folded = fold_fri_pair_at<INPUT>(
            positive.value,
            negative.value,
            challenges.challenge.value,
            shift,
            index,
        )
        folded.valid && folded.evaluations[0].equals(layers.evaluation)
    }
}

impl<
    const INPUT: usize,
    Input: Ext4SparseOpening,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
    Rest,
    TailLayers: core::marker::Copy,
    TailChallenges: core::marker::Copy,
> BabyBearFriMultiFoldCheck<
    INPUT,
    Input,
    FriMultiQueryFold<ROUND, MAX_LEAVES, MAX_SIBLINGS, TailLayers>,
    FriMultiChallengeFold<ROUND, TailChallenges>,
> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { ROUND > 0 },
    { ROUND < 100 },
    { INPUT_LOG > 1 },
    OUTPUT > 1,
    { (OUTPUT & (OUTPUT - 1)) == 0 },
    { PAIR_WIDTH + PAIR_WIDTH == OUTPUT },
    { PAIR_DEPTH + 2 == INPUT_LOG },
    { NEXT_ROUND == ROUND + 1 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriMultiFoldCheck<
        OUTPUT,
        FriLayerMultiOpening<ROUND, MAX_LEAVES, MAX_SIBLINGS>,
        TailLayers,
        TailChallenges,
    >,
{
    fn verify_fri_multi_fold(
        _ input: Input,
        _ layers: FriMultiQueryFold<ROUND, MAX_LEAVES, MAX_SIBLINGS, TailLayers>,
        _ challenges: FriMultiChallengeFold<ROUND, TailChallenges>,
        _ query: u32,
        _ shift: BabyBear,
    ) -> bool {
        let output: u32 = OUTPUT.downcast_truncate()
        let index = query & (output - 1)
        let positive = input.sparse_value(index)
        let negative = input.sparse_value(index + output)
        let actual = layers.opening.sparse_value(index)
        if shift.is_zero() || !positive.valid || !negative.valid || !actual.valid
            || !layers.valid || !challenges.valid || !challenges.challenge.valid {
            return false
        }
        let folded = fold_fri_pair_at<INPUT>(
            positive.value,
            negative.value,
            challenges.challenge.value,
            shift,
            index,
        )
        if !folded.valid || !folded.evaluations[0].equals(actual.value) {
            return false
        }
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriMultiFoldCheck<
            OUTPUT,
            FriLayerMultiOpening<ROUND, MAX_LEAVES, MAX_SIBLINGS>,
            TailLayers,
            TailChallenges,
        >>::verify_fri_multi_fold(
            layers.opening,
            layers.tail,
            challenges.tail,
            query,
            shift.square(),
        )
    }
}

/// Runtime buffer produced by interpreting the typed query plan once. The
/// subsequent loop reuses one schedule-specialized fold checker for every
/// query instead of specializing the complete fold chain per plan node.
pub struct FriQueryBuffer<const MAX_QUERIES: usize> {
    pub valid: bool,
    pub count: u32,
    pub indices: [u32; MAX_QUERIES],
}
impl<const MAX_QUERIES: usize> core::marker::Copy for FriQueryBuffer<MAX_QUERIES> {}

pub trait BabyBearFriQueryBuffer<
    const MAX_QUERIES: usize,
    Samples,
> {
    fn fri_query_buffer(_ samples: Samples) -> FriQueryBuffer<MAX_QUERIES>
}

impl<
    const MAX_QUERIES: usize,
    const NEXT_QUERY: u32,
> BabyBearFriQueryBuffer<MAX_QUERIES, FriQueryIndicesDone<NEXT_QUERY>>
    for FriQueryPlanDone<NEXT_QUERY> {
    fn fri_query_buffer(
        _ samples: FriQueryIndicesDone<NEXT_QUERY>,
    ) -> FriQueryBuffer<MAX_QUERIES> {
        FriQueryBuffer { valid: true, count: 0, indices: [0; MAX_QUERIES] }
    }
}

impl<
    const MAX_QUERIES: usize,
    const QUERY: u32,
    Tail,
    TailSamples: core::marker::Copy,
> BabyBearFriQueryBuffer<
    MAX_QUERIES,
    FriQueryIndicesSample<QUERY, TailSamples>,
> for FriQueryPlanSample<QUERY, Tail>
where Tail: BabyBearFriQueryBuffer<MAX_QUERIES, TailSamples>
{
    fn fri_query_buffer(
        _ samples: FriQueryIndicesSample<QUERY, TailSamples>,
    ) -> FriQueryBuffer<MAX_QUERIES> {
        let tail = <Tail as BabyBearFriQueryBuffer<
            MAX_QUERIES,
            TailSamples,
        >>::fri_query_buffer(samples.tail)
        let tail_count: usize = tail.count as usize
        if !samples.current.valid || !tail.valid || tail_count + 1 > MAX_QUERIES {
            return FriQueryBuffer { valid: false, count: 0, indices: [0; MAX_QUERIES] }
        }
        let mut indices = [0; MAX_QUERIES]
        indices[0] = samples.current.value
        let mut cursor: usize = 0
        while cursor < tail_count {
            indices[cursor + 1] = tail.indices[cursor]
            cursor = cursor + 1
        }
        FriQueryBuffer {
            valid: true,
            count: tail.count + 1,
            indices: indices,
        }
    }
}

/// Result of the once-per-layer authentication pass for the concrete toy
/// checkpoint. Samples remain typed by `FriQueryPlan`; the fixed buffer is
/// only the runtime loop interpretation of that same plan.
pub struct CheckpointFriMultiAuthentication16 {
    pub valid: bool,
    pub samples: CheckpointFriQuerySamples4,
    pub queries: FriQueryBuffer<4>,
    pub challenges: CheckpointFriMultiChallenges16,
}
impl core::marker::Copy for CheckpointFriMultiAuthentication16 {}

pub fn authenticate_fri_multi_commitment_query16(
    _ air_transcript: AirLdeTranscriptDigest,
    _ proof: ref FriMultiCommitmentQuery16,
) -> CheckpointFriMultiAuthentication16 {
    let composition_authenticated = air_transcript.valid && proof.valid
        && proof.composition_root.valid
        && verify_composition_multi_opening<16, 8, 24>(
            proof.composition,
            proof.composition_root,
        )
    let composition_transcript = bind_composition(
        air_transcript,
        proof.composition_root,
    )
    let authenticated = <FriSchedule<1, 4> as BabyBearFriMultiAuthenticateFirst<
        8,
        CheckpointFriQueryPlan4,
        CheckpointFriQuerySamples4,
        CheckpointFriMultiQueryLayers16,
        CheckpointFriMultiChallenges16,
    >>::authenticate_fri_multi_first(composition_transcript, proof.layers)
    let queries = <CheckpointFriQueryPlan4 as BabyBearFriQueryBuffer<
        4,
        CheckpointFriQuerySamples4,
    >>::fri_query_buffer(authenticated.1)
    CheckpointFriMultiAuthentication16 {
        valid: composition_authenticated && composition_transcript.valid
            && authenticated.0 && queries.valid && queries.count == 4,
        samples: authenticated.1,
        queries: queries,
        challenges: authenticated.2,
    }
}

fn verify_authenticated_fri_multi_folds16(
    _ shift: BabyBear,
    _ proof: ref FriMultiCommitmentQuery16,
    _ authenticated: CheckpointFriMultiAuthentication16,
) -> bool {
    if shift.is_zero() || !authenticated.valid { return false }
    let mut cursor: usize = 0
    while cursor < 4 {
        if !<FriSchedule<1, 4> as BabyBearFriMultiFoldCheck<
            16,
            CompositionMultiOpening<8, 24>,
            CheckpointFriMultiQueryLayers16,
            CheckpointFriMultiChallenges16,
        >>::verify_fri_multi_fold(
            proof.composition,
            proof.layers,
            authenticated.challenges,
            authenticated.queries.indices[cursor],
            shift,
        ) {
            return false
        }
        cursor = cursor + 1
    }
    true
}

/// Verify and replay every layer after the first FRI commitment. The query
/// carrier type is supplied explicitly so method arguments remain ordinary
/// types while the schedule still selects the only valid implementation.
pub trait BabyBearFriQueryVerifyTail<
    const PREVIOUS: u32,
    const INPUT: usize,
    const QUERY_HALF: usize,
    Layers,
> {
    fn sample_fri_query_tail(
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ layers: Layers,
    ) -> FriQueryIndex<1>
    fn verify_fri_query_tail(
        _ positive: BabyBearExt4,
        _ negative: BabyBearExt4,
        _ index: u32,
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ shift: BabyBear,
        _ layers: own Layers,
    ) -> bool
}

impl<
    const PREVIOUS: u32,
    const INPUT: usize,
    const QUERY_HALF: usize,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
> BabyBearFriQueryVerifyTail<PREVIOUS, INPUT, QUERY_HALF, FriQueryEnd<ROUND>>
    for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleDone<NEXT_ROUND>,
>
where
    { PREVIOUS > 0 },
    { ROUND == PREVIOUS + 1 },
    { ROUND < 100 },
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { INPUT_LOG == 1 },
    { OUTPUT == 1 },
    { PAIR_WIDTH == 0 },
    { PAIR_DEPTH == 0 },
    { NEXT_ROUND == ROUND + 1 },
    QUERY_HALF > 0,
    { (QUERY_HALF & (QUERY_HALF - 1)) == 0 },
    { QUERY_HALF <= 134217728 },
{
    fn sample_fri_query_tail(
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ layers: FriQueryEnd<ROUND>,
    ) -> FriQueryIndex<1> {
        if !layers.valid || !layers.root.valid {
            return FriQueryIndex<1> { valid: false, value: 0 }
        }
        let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, layers.root)
        let challenge = fri_query_challenge<ROUND, 1>(next_transcript)
        fri_query_index_power_of_two<1, QUERY_HALF>(challenge)
    }

    fn verify_fri_query_tail(
        _ positive: BabyBearExt4,
        _ negative: BabyBearExt4,
        _ index: u32,
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ shift: BabyBear,
        _ layers: own FriQueryEnd<ROUND>,
    ) -> bool {
        if !transcript.valid
            || shift.is_zero()
            || !layers.valid
            || !layers.root.valid
            || index != 0 {
            return false
        }
        let challenge = next_fri_fold_challenge<PREVIOUS, ROUND>(transcript)
        let folded = fold_fri_pair_at<INPUT>(positive, negative, challenge.value, shift, index)
        let commitment = fri_layer_row_commitment<ROUND>(layers.evaluation)
        let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, layers.root)
        challenge.valid
            && folded.valid
            && commitment.valid
            && next_transcript.valid
            && folded.evaluations[0].equals(layers.evaluation)
            && commitment.value.equals(layers.root.value)
    }
}

impl<
    const PREVIOUS: u32,
    const INPUT: usize,
    const QUERY_HALF: usize,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    Rest,
    TailLayers,
> BabyBearFriQueryVerifyTail<
    PREVIOUS,
    INPUT,
    QUERY_HALF,
    FriQueryFold<ROUND, PAIR_DEPTH, TailLayers>,
> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    { PREVIOUS > 0 },
    { ROUND == PREVIOUS + 1 },
    { ROUND < 100 },
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { INPUT_LOG > 1 },
    OUTPUT > 1,
    PAIR_WIDTH > 0,
    { PAIR_WIDTH + PAIR_WIDTH == OUTPUT },
    { PAIR_DEPTH + 2 == INPUT_LOG },
    { NEXT_ROUND == ROUND + 1 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriQueryVerifyTail<ROUND, OUTPUT, QUERY_HALF, TailLayers>,
{
    fn sample_fri_query_tail(
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ layers: FriQueryFold<ROUND, PAIR_DEPTH, TailLayers>,
    ) -> FriQueryIndex<1> {
        if !layers.valid || !layers.root.valid {
            return FriQueryIndex<1> { valid: false, value: 0 }
        }
        let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, layers.root)
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriQueryVerifyTail<
            ROUND,
            OUTPUT,
            QUERY_HALF,
            TailLayers,
        >>::sample_fri_query_tail(next_transcript, layers.tail)
    }

    fn verify_fri_query_tail(
        _ positive: BabyBearExt4,
        _ negative: BabyBearExt4,
        _ index: u32,
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ shift: BabyBear,
        _ layers: own FriQueryFold<ROUND, PAIR_DEPTH, TailLayers>,
    ) -> bool {
        let output: u32 = OUTPUT.downcast_truncate()
        let pair_width: u32 = PAIR_WIDTH.downcast_truncate()
        if !transcript.valid
            || shift.is_zero()
            || !layers.valid
            || !layers.root.valid
            || index >= output {
            return false
        }
        let pair_index = index & (pair_width - 1)
        if layers.pair.path.index != pair_index
            || !verify_fri_layer_pair_path<ROUND, PAIR_DEPTH>(
                layers.pair.positive,
                layers.pair.negative,
                layers.pair.path,
                layers.root,
            ) {
            return false
        }
        let challenge = next_fri_fold_challenge<PREVIOUS, ROUND>(transcript)
        let folded = fold_fri_pair_at<INPUT>(positive, negative, challenge.value, shift, index)
        let expected = if index < pair_width {
            layers.pair.positive
        } else {
            layers.pair.negative
        }
        let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, layers.root)
        if !challenge.valid
            || !folded.valid
            || !next_transcript.valid
            || !folded.evaluations[0].equals(expected) {
            return false
        }
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriQueryVerifyTail<
            ROUND,
            OUTPUT,
            QUERY_HALF,
            TailLayers,
        >>::verify_fri_query_tail(
            layers.pair.positive,
            layers.pair.negative,
            pair_index,
            next_transcript,
            shift.square(),
            layers.tail,
        )
    }
}

/// Verify the first schedule node against the composition pair, then delegate
/// the remaining round chain to `BabyBearFriQueryVerifyTail`.
pub trait BabyBearFriQueryVerifyFirst<
    const INPUT: usize,
    const QUERY_HALF: usize,
    const COMPOSITION_DEPTH: usize,
    Layers,
> {
    fn sample_fri_query_from_composition(
        _ transcript: own CompositionTranscriptDigest,
        _ layers: Layers,
    ) -> FriQueryIndex<1>
    fn verify_fri_query_from_composition(
        _ composition: own CompositionQueryPair<COMPOSITION_DEPTH>,
        _ index: u32,
        _ transcript: own CompositionTranscriptDigest,
        _ shift: BabyBear,
        _ layers: own Layers,
    ) -> bool
}

impl<
    const INPUT: usize,
    const QUERY_HALF: usize,
    const COMPOSITION_DEPTH: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
> BabyBearFriQueryVerifyFirst<INPUT, QUERY_HALF, COMPOSITION_DEPTH, FriQueryEnd<1>>
    for FriScheduleFold<1, 1, OUTPUT, PAIR_WIDTH, PAIR_DEPTH, FriScheduleDone<NEXT_ROUND>>
where
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { OUTPUT == 1 },
    { PAIR_WIDTH == 0 },
    { PAIR_DEPTH == 0 },
    { NEXT_ROUND == 2 },
    QUERY_HALF > 0,
    { (QUERY_HALF & (QUERY_HALF - 1)) == 0 },
    { QUERY_HALF <= 134217728 },
{
    fn sample_fri_query_from_composition(
        _ transcript: own CompositionTranscriptDigest,
        _ layers: FriQueryEnd<1>,
    ) -> FriQueryIndex<1> {
        if !layers.valid || !layers.root.valid {
            return FriQueryIndex<1> { valid: false, value: 0 }
        }
        let first_transcript = bind_first_fri_layer(transcript, layers.root)
        let challenge = fri_query_challenge<1, 1>(first_transcript)
        fri_query_index_power_of_two<1, QUERY_HALF>(challenge)
    }

    fn verify_fri_query_from_composition(
        _ composition: own CompositionQueryPair<COMPOSITION_DEPTH>,
        _ index: u32,
        _ transcript: own CompositionTranscriptDigest,
        _ shift: BabyBear,
        _ layers: own FriQueryEnd<1>,
    ) -> bool {
        if !transcript.valid
            || shift.is_zero()
            || !layers.valid
            || !layers.root.valid
            || index != 0 {
            return false
        }
        let challenge = fri_fold_challenge(transcript)
        let folded = fold_fri_pair_at<INPUT>(
            composition.positive,
            composition.negative,
            challenge.value,
            shift,
            index,
        )
        let commitment = fri_layer_row_commitment<1>(layers.evaluation)
        let first_transcript = bind_first_fri_layer(transcript, layers.root)
        challenge.valid
            && folded.valid
            && commitment.valid
            && first_transcript.valid
            && folded.evaluations[0].equals(layers.evaluation)
            && commitment.value.equals(layers.root.value)
    }
}

impl<
    const INPUT: usize,
    const QUERY_HALF: usize,
    const COMPOSITION_DEPTH: usize,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    Rest,
    TailLayers,
> BabyBearFriQueryVerifyFirst<
    INPUT,
    QUERY_HALF,
    COMPOSITION_DEPTH,
    FriQueryFold<1, PAIR_DEPTH, TailLayers>,
> for FriScheduleFold<
    1,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { INPUT_LOG > 1 },
    OUTPUT > 1,
    PAIR_WIDTH > 0,
    { PAIR_WIDTH + PAIR_WIDTH == OUTPUT },
    { PAIR_DEPTH + 2 == INPUT_LOG },
    { NEXT_ROUND == 2 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriQueryVerifyTail<1, OUTPUT, QUERY_HALF, TailLayers>,
{
    fn sample_fri_query_from_composition(
        _ transcript: own CompositionTranscriptDigest,
        _ layers: FriQueryFold<1, PAIR_DEPTH, TailLayers>,
    ) -> FriQueryIndex<1> {
        if !layers.valid || !layers.root.valid {
            return FriQueryIndex<1> { valid: false, value: 0 }
        }
        let first_transcript = bind_first_fri_layer(transcript, layers.root)
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriQueryVerifyTail<
            1,
            OUTPUT,
            QUERY_HALF,
            TailLayers,
        >>::sample_fri_query_tail(first_transcript, layers.tail)
    }

    fn verify_fri_query_from_composition(
        _ composition: own CompositionQueryPair<COMPOSITION_DEPTH>,
        _ index: u32,
        _ transcript: own CompositionTranscriptDigest,
        _ shift: BabyBear,
        _ layers: own FriQueryFold<1, PAIR_DEPTH, TailLayers>,
    ) -> bool {
        let output: u32 = OUTPUT.downcast_truncate()
        let pair_width: u32 = PAIR_WIDTH.downcast_truncate()
        if !transcript.valid
            || shift.is_zero()
            || !layers.valid
            || !layers.root.valid
            || index >= output {
            return false
        }
        let pair_index = index & (pair_width - 1)
        if layers.pair.path.index != pair_index
            || !verify_fri_layer_pair_path<1, PAIR_DEPTH>(
                layers.pair.positive,
                layers.pair.negative,
                layers.pair.path,
                layers.root,
            ) {
            return false
        }
        let challenge = fri_fold_challenge(transcript)
        let folded = fold_fri_pair_at<INPUT>(
            composition.positive,
            composition.negative,
            challenge.value,
            shift,
            index,
        )
        let expected = if index < pair_width {
            layers.pair.positive
        } else {
            layers.pair.negative
        }
        let first_transcript = bind_first_fri_layer(transcript, layers.root)
        if !challenge.valid
            || !folded.valid
            || !first_transcript.valid
            || !folded.evaluations[0].equals(expected) {
            return false
        }
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriQueryVerifyTail<
            1,
            OUTPUT,
            QUERY_HALF,
            TailLayers,
        >>::verify_fri_query_tail(
            layers.pair.positive,
            layers.pair.negative,
            pair_index,
            first_transcript,
            shift.square(),
            layers.tail,
        )
    }
}

pub fn verify_fri_commitment_query16(
    _ air_transcript: own AirLdeTranscriptDigest,
    _ shift: BabyBear,
    _ proof: own FriCommitmentQuery16,
) -> bool {
    if !air_transcript.valid
        || shift.is_zero()
        || !proof.valid
        || !proof.composition_root.valid {
        return false
    }

    let composition_transcript = bind_composition(air_transcript, proof.composition_root)
    let query = <FriSchedule<1, 4> as BabyBearFriQueryVerifyFirst<
        16,
        8,
        3,
        CheckpointFriQueryLayers16,
    >>::sample_fri_query_from_composition(composition_transcript, proof.layers)
    if !composition_transcript.valid
        || !query.valid
        || proof.query_index != query.value
        || proof.composition.path.index != query.value
        || !verify_composition_pair_path<3>(
            proof.composition.positive,
            proof.composition.negative,
            proof.composition.path,
            proof.composition_root,
        ) {
        return false
    }
    <FriSchedule<1, 4> as BabyBearFriQueryVerifyFirst<
        16,
        8,
        3,
        CheckpointFriQueryLayers16,
    >>::verify_fri_query_from_composition(
        proof.composition,
        query.value,
        composition_transcript,
        shift,
        proof.layers,
    )
}

/// Verify four Fiat-Shamir queries while authenticating each committed layer
/// once. The fold schedule and query plan are the only round and query lists.
pub fn verify_fri_multi_commitment_query16(
    _ air_transcript: own AirLdeTranscriptDigest,
    _ shift: BabyBear,
    _ proof: own FriMultiCommitmentQuery16,
) -> bool {
    let authenticated = authenticate_fri_multi_commitment_query16(
        air_transcript,
        ref proof,
    )
    verify_authenticated_fri_multi_folds16(shift, ref proof, authenticated)
}

/// Authenticate both sparse AIR trees, recompute every selected composition
/// pair through the shared 708-constraint body, then verify the
/// schedule-derived FRI carrier. The large receipt crosses no function
/// boundary by value, which keeps its Fe-authored representation
/// backend-portable.
pub fn verify_checkpoint4_baby_bear_receipt16(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ proof_transcript: ProofTranscriptDigest,
    _ shift: BabyBear,
    _ receipt: ref Checkpoint4BabyBearReceipt16,
) -> bool {
    if !receipt.valid || shift.is_zero() || !proof_transcript.valid
        || !receipt.main_root.valid || !receipt.auxiliary_root.valid
        || !verify_main_lde_multi_opening<
            16,
            {air_lde_request_capacity(4)},
            {air_lde_sibling_capacity(4)},
        >(ref receipt.air.main, receipt.main_root)
        || !verify_auxiliary_lde_multi_opening<
            16,
            {air_lde_request_capacity(4)},
            {air_lde_sibling_capacity(4)},
        >(ref receipt.air.auxiliary, receipt.auxiliary_root) {
        return false
    }
    let main_transcript = bind_main_lde(proof_transcript, receipt.main_root)
    let air_transcript = bind_auxiliary_lde(
        main_transcript,
        receipt.auxiliary_root,
    )
    let authenticated = authenticate_fri_multi_commitment_query16(
        air_transcript,
        ref receipt.fri,
    )
    let challenge = composition_challenge(air_transcript)
    authenticated.valid && challenge.valid
        && verify_checkpoint4_sparse_air_compositions16(
            c_re_q12,
            c_im_q12,
            challenge,
            shift,
            authenticated.queries,
            ref receipt,
        )
        && verify_authenticated_fri_multi_folds16(
            shift,
            ref receipt.fri,
            authenticated,
        )
}
