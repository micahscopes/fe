//! BabyBear interpretation of the field-independent Mandelbrot schemas.
//!
//! Main rows, public statements, and Fe-derived auxiliary columns all flow
//! through the same exact-length 30-bit field encoder. Their 210, 114, and
//! 411 bits occupy 7, 4, and 14 BabyBear payload lanes respectively. The
//! largest value is absorbed by one typed, fixed-length Poseidon2 sponge.

use mandelbrot_proof_kernel::{
    AUXILIARY_ROW_BITS,
    ENCODED_PROOF_ROW_WIDTHS,
    ESCAPES_BY_Q12_PUBLIC_WIDTHS,
    ESCAPES_BY_Q12_PUBLIC_WORDS,
    MAX_PADDED_TRACE_LENGTH,
    EncodedProofRow,
    EscapesByQ12Public,
    derive_ranged_air_row,
    encoded_proof_row_words,
    encoded_ranged_auxiliary_row_bit,
    escapes_by_q12_public_words,
}
use merkle_core::{
    MerkleRoot,
    TwoToOneHasher,
    complete_frontier_root,
    empty_frontier,
    push_frontier,
}
use poseidon_baby_bear::{
    PackedCommitment,
    Poseidon2Digest,
    Poseidon2Domain,
    Poseidon2FieldDomain,
    bind as poseidon_bind,
    commit_ext4_fields,
    commit_fields,
    commit_packed,
    compress as poseidon_compress,
    squeeze_ext4,
}
use precision::baby_bear::{BabyBear, BabyBearExt4, BabyBearModulus}
use precision::word_field_encoding::{PackedFieldBits, pack_bounded_words}
use precision::polynomial::radix2_log

pub const ROW_FIELDS: usize = 7
pub const PUBLIC_FIELDS: usize = 4
pub const AUXILIARY_FIELDS: usize = 14
pub const MAIN_LDE_ROW_FIELDS: usize = 17
const TRACE_FRONTIER_LEVELS: usize = 22

const fn protocol_tag(_ label: String<4>) -> u32 {
    let bytes = label.as_bytes()
    ((bytes[0] as u32) << 24)
        | ((bytes[1] as u32) << 16)
        | ((bytes[2] as u32) << 8)
        | (bytes[3] as u32)
}

const fn protocol_round_tag(_ prefix: String<2>, _ round: u32) -> u32 {
    let bytes = prefix.as_bytes()
    let tens = round / 10
    let ones = round - tens * 10
    ((bytes[0] as u32) << 24)
        | ((bytes[1] as u32) << 16)
        | ((48 + tens) << 8)
        | (48 + ones)
}

struct MandelbrotRowBabyBearV1 {}
struct MandelbrotPublicBabyBearV1 {}
struct MandelbrotAuxiliaryBabyBearV1 {}
struct MandelbrotStatementBabyBearV1 {}
struct MandelbrotProofTranscriptBabyBearV1 {}
struct MandelbrotCompositionChallengeBabyBearV1 {}
struct MandelbrotMainLdeRowBabyBearV1 {}
struct MandelbrotAuxiliaryLdeRowBabyBearV1 {}
struct MandelbrotCompositionRowBabyBearV1 {}
struct MandelbrotMainLdeTranscriptBabyBearV1 {}
struct MandelbrotAuxiliaryLdeTranscriptBabyBearV1 {}
struct MandelbrotCompositionTranscriptBabyBearV1 {}
struct MandelbrotFriFoldBabyBear<const ROUND: u32> {}
struct MandelbrotFriLayerRowBabyBear<const ROUND: u32> {}
struct MandelbrotFriLayerTranscriptBabyBear<const ROUND: u32> {}

impl Poseidon2Domain for MandelbrotRowBabyBearV1 {
    const TAG: u32 = protocol_tag("BR01")
}

impl Poseidon2Domain for MandelbrotPublicBabyBearV1 {
    const TAG: u32 = protocol_tag("BP01")
}

impl Poseidon2Domain for MandelbrotAuxiliaryBabyBearV1 {
    const TAG: u32 = protocol_tag("BA01")
}

impl Poseidon2FieldDomain for MandelbrotStatementBabyBearV1 {
    const TAG: u32 = protocol_tag("BS01")
}

impl Poseidon2FieldDomain for MandelbrotProofTranscriptBabyBearV1 {
    const TAG: u32 = protocol_tag("BT01")
}

impl Poseidon2FieldDomain for MandelbrotCompositionChallengeBabyBearV1 {
    const TAG: u32 = protocol_tag("BC01")
}

impl Poseidon2FieldDomain for MandelbrotMainLdeRowBabyBearV1 {
    const TAG: u32 = protocol_tag("BL01")
}

impl Poseidon2FieldDomain for MandelbrotAuxiliaryLdeRowBabyBearV1 {
    const TAG: u32 = protocol_tag("BY01")
}

impl Poseidon2FieldDomain for MandelbrotCompositionRowBabyBearV1 {
    const TAG: u32 = protocol_tag("BC02")
}

impl Poseidon2FieldDomain for MandelbrotMainLdeTranscriptBabyBearV1 {
    const TAG: u32 = protocol_tag("BL02")
}

impl Poseidon2FieldDomain for MandelbrotAuxiliaryLdeTranscriptBabyBearV1 {
    const TAG: u32 = protocol_tag("BY02")
}

impl Poseidon2FieldDomain for MandelbrotCompositionTranscriptBabyBearV1 {
    const TAG: u32 = protocol_tag("BC03")
}

impl<const ROUND: u32> Poseidon2FieldDomain for MandelbrotFriFoldBabyBear<ROUND> {
    const TAG: u32 = protocol_round_tag("FC", ROUND)
}

impl<const ROUND: u32> Poseidon2FieldDomain for MandelbrotFriLayerRowBabyBear<ROUND> {
    const TAG: u32 = protocol_round_tag("FR", ROUND)
}

impl<const ROUND: u32> Poseidon2FieldDomain for MandelbrotFriLayerTranscriptBabyBear<ROUND> {
    const TAG: u32 = protocol_round_tag("FT", ROUND)
}

