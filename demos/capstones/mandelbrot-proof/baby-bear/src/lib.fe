    AuxiliaryLdeDigest {
        valid: true,
        value: commit_fields<MandelbrotAuxiliaryLdeRowBabyBearV1, AUXILIARY_ROW_BITS>(values),
    }
}

pub fn composition_row_commitment(_ value: BabyBearExt4) -> CompositionDigest {
    CompositionDigest {
        valid: true,
        value: commit_ext4_fields<MandelbrotCompositionRowBabyBearV1, 1>([value]),
    }
}

pub fn main_lde_root_power_of_two<const N: usize>(
    _ leaves: own [MainLdeDigest; N],
) -> MainLdeDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return MainLdeDigest { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    MainLdeDigest { valid: root.valid, value: root.value }
}

pub fn auxiliary_lde_root_power_of_two<const N: usize>(
    _ leaves: own [AuxiliaryLdeDigest; N],
) -> AuxiliaryLdeDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return AuxiliaryLdeDigest { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    AuxiliaryLdeDigest { valid: root.valid, value: root.value }
}

fn invalid_lde_quartet_path<Role, const DEPTH: usize>() -> LdeQuartetPath<Role, DEPTH> {
    LdeQuartetPath<Role, DEPTH> {
        valid: false,
        index: 0,
        first_siblings: [Poseidon2Digest::zero(); DEPTH],
        second_siblings: [Poseidon2Digest::zero(); DEPTH],
        third_siblings: [Poseidon2Digest::zero(); DEPTH],
        fourth_siblings: [Poseidon2Digest::zero(); DEPTH],
    }
}

pub fn main_lde_quartet_path_power_of_two<
    const N: usize,
    const QUARTER: usize,
    const DEPTH: usize,
>(
    _ leaves: own [MainLdeDigest; N],
    _ index: u32,
) -> MainLdeQuartetPath<DEPTH>
where
    N > 3,
    N <= MAX_PADDED_TRACE_LENGTH,
    QUARTER > 0,
    { QUARTER + QUARTER + QUARTER + QUARTER == N },
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        if !leaves[cursor].valid {
            return invalid_lde_quartet_path<MainLdeTreeRole, DEPTH>()
        }
        raw[cursor] = leaves[cursor].value
        cursor = cursor + 1
    }
    let path = quartet_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        QUARTER,
        DEPTH,
    >(raw, index)
    LdeQuartetPath<MainLdeTreeRole, DEPTH> {
        valid: path.valid,
        index: path.index,
        first_siblings: path.first_siblings,
        second_siblings: path.second_siblings,
        third_siblings: path.third_siblings,
        fourth_siblings: path.fourth_siblings,
    }
}

pub fn auxiliary_lde_quartet_path_power_of_two<
    const N: usize,
    const QUARTER: usize,
    const DEPTH: usize,
>(
    _ leaves: own [AuxiliaryLdeDigest; N],
    _ index: u32,
) -> AuxiliaryLdeQuartetPath<DEPTH>
where
    N > 3,
    N <= MAX_PADDED_TRACE_LENGTH,
    QUARTER > 0,
    { QUARTER + QUARTER + QUARTER + QUARTER == N },
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        if !leaves[cursor].valid {
            return invalid_lde_quartet_path<AuxiliaryLdeTreeRole, DEPTH>()
        }
        raw[cursor] = leaves[cursor].value
        cursor = cursor + 1
    }
    let path = quartet_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        QUARTER,
        DEPTH,
    >(raw, index)
    LdeQuartetPath<AuxiliaryLdeTreeRole, DEPTH> {
        valid: path.valid,
        index: path.index,
        first_siblings: path.first_siblings,
        second_siblings: path.second_siblings,
        third_siblings: path.third_siblings,
        fourth_siblings: path.fourth_siblings,
    }
}

pub fn verify_main_lde_quartet_path<const DEPTH: usize>(
    _ first: own MainLdeDigest,
    _ second: own MainLdeDigest,
    _ third: own MainLdeDigest,
    _ fourth: own MainLdeDigest,
    _ path: own MainLdeQuartetPath<DEPTH>,
    _ root: own MainLdeDigest,
) -> bool {
    if !first.valid || !second.valid || !third.valid || !fourth.valid
        || !path.valid || !root.valid {
        return false
    }
    quartet_verify<Poseidon2Digest, DigestNodeHasher, DEPTH>(
        root.value,
        first.value,
        second.value,
        third.value,
        fourth.value,
        MerkleQuartetPath<Poseidon2Digest, DEPTH> {
            valid: path.valid,
            index: path.index,
            first_siblings: path.first_siblings,
            second_siblings: path.second_siblings,
            third_siblings: path.third_siblings,
            fourth_siblings: path.fourth_siblings,
        },
    )
}

pub fn verify_auxiliary_lde_quartet_path<const DEPTH: usize>(
    _ first: own AuxiliaryLdeDigest,
    _ second: own AuxiliaryLdeDigest,
    _ third: own AuxiliaryLdeDigest,
    _ fourth: own AuxiliaryLdeDigest,
    _ path: own AuxiliaryLdeQuartetPath<DEPTH>,
    _ root: own AuxiliaryLdeDigest,
) -> bool {
    if !first.valid || !second.valid || !third.valid || !fourth.valid
        || !path.valid || !root.valid {
        return false
    }
    quartet_verify<Poseidon2Digest, DigestNodeHasher, DEPTH>(
        root.value,
        first.value,
        second.value,
        third.value,
        fourth.value,
        MerkleQuartetPath<Poseidon2Digest, DEPTH> {
            valid: path.valid,
            index: path.index,
            first_siblings: path.first_siblings,
            second_siblings: path.second_siblings,
            third_siblings: path.third_siblings,
            fourth_siblings: path.fourth_siblings,
        },
    )
}

pub fn composition_root_power_of_two<const N: usize>(
    _ leaves: own [CompositionDigest; N],
) -> CompositionDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return CompositionDigest { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    CompositionDigest { valid: root.valid, value: root.value }
}

pub fn composition_pair_path_power_of_two<
    const N: usize,
    const HALF: usize,
    const DEPTH: usize,
>(
    _ evaluations: own [BabyBearExt4; N],
    _ index: u32,
) -> CompositionPairPath<DEPTH>
where
    N > 1,
    N <= MAX_PADDED_TRACE_LENGTH,
    HALF > 0,
    { HALF + HALF == N },
{
    let mut leaves = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        leaves[cursor] = composition_row_commitment(evaluations[cursor]).value
        cursor = cursor + 1
    }
    let raw = pair_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        HALF,
        DEPTH,
    >(leaves, index)
    CompositionPairPath<DEPTH> {
        valid: raw.valid,
        index: raw.index,
        positive_siblings: raw.positive_siblings,
        negative_siblings: raw.negative_siblings,
    }
}

pub fn verify_composition_pair_path<const DEPTH: usize>(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ path: own CompositionPairPath<DEPTH>,
    _ root: own CompositionDigest,
) -> bool {
    if !root.valid || !path.valid { return false }
    pair_verify<Poseidon2Digest, DigestNodeHasher, DEPTH>(
        root.value,
        composition_row_commitment(positive).value,
        composition_row_commitment(negative).value,
        MerklePairPath<Poseidon2Digest, DEPTH> {
            valid: path.valid,
            index: path.index,
            positive_siblings: path.positive_siblings,
            negative_siblings: path.negative_siblings,
        },
    )
}

pub fn bind_main_lde(
    _ transcript: own ProofTranscriptDigest,
    _ main: own MainLdeDigest,
) -> MainLdeTranscriptDigest {
    if !transcript.valid || !main.valid {
        return MainLdeTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    MainLdeTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotMainLdeTranscriptBabyBearV1>(
            transcript.value,
            main.value,
        ),
    }
}

pub fn bind_auxiliary_lde(
    _ transcript: own MainLdeTranscriptDigest,
    _ auxiliary: own AuxiliaryLdeDigest,
) -> AirLdeTranscriptDigest {
    if !transcript.valid || !auxiliary.valid {
        return AirLdeTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    AirLdeTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotAuxiliaryLdeTranscriptBabyBearV1>(
            transcript.value,
            auxiliary.value,
        ),
    }
}

pub fn bind_composition(
    _ transcript: own AirLdeTranscriptDigest,
    _ composition: own CompositionDigest,
) -> CompositionTranscriptDigest {
    if !transcript.valid || !composition.valid {
        return CompositionTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    CompositionTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotCompositionTranscriptBabyBearV1>(
            transcript.value,
            composition.value,
        ),
    }
}

pub fn fri_fold_challenge(
    _ transcript: own CompositionTranscriptDigest,
) -> FriFoldChallenge<1> {
    if !transcript.valid {
        return FriFoldChallenge<1> { valid: false, value: BabyBearExt4::zero() }
    }
    FriFoldChallenge<1> {
        valid: true,
        value: squeeze_ext4<MandelbrotFriFoldBabyBear<1>>(transcript.value),
    }
}

pub fn next_fri_fold_challenge<const PREVIOUS: u32, const ROUND: u32>(
    _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
) -> FriFoldChallenge<ROUND>
where { PREVIOUS > 0 }, { ROUND == PREVIOUS + 1 }, { ROUND < 100 }
{
    if !transcript.valid {
        return FriFoldChallenge<ROUND> { valid: false, value: BabyBearExt4::zero() }
    }
    FriFoldChallenge<ROUND> {
        valid: true,
        value: squeeze_ext4<MandelbrotFriFoldBabyBear<ROUND>>(transcript.value),
    }
}

pub fn fri_query_challenge<const ROUND: u32, const QUERY: u32>(
    _ transcript: own FriLayerTranscriptDigest<ROUND>,
) -> FriQueryChallenge<QUERY>
where { ROUND > 0 }, { ROUND < 100 }, { QUERY > 0 }, { QUERY < 100 }
{
    if !transcript.valid {
        return FriQueryChallenge<QUERY> { valid: false, value: BabyBear::zero() }
    }
    FriQueryChallenge<QUERY> {
        valid: true,
        value: squeeze_ext4<MandelbrotFriQueryBabyBear<QUERY>>(
            transcript.value,
        ).coefficient(0),
    }
}

pub fn fri_query_index_power_of_two<const QUERY: u32, const HALF: usize>(
    _ challenge: own FriQueryChallenge<QUERY>,
) -> FriQueryIndex<QUERY>
where { QUERY > 0 }, { QUERY < 100 }, HALF > 0, { (HALF & (HALF - 1)) == 0 }, { HALF <= 134217728 }
{
    if !challenge.valid {
        return FriQueryIndex<QUERY> { valid: false, value: 0 }
    }
    let half: u32 = HALF.downcast_truncate()
    FriQueryIndex<QUERY> {
        valid: true,
        value: challenge.value.to_u32() & (half - 1),
    }
}

pub fn fri_layer_row_commitment<const ROUND: u32>(
    _ value: BabyBearExt4,
) -> FriLayerDigest<ROUND>
where { ROUND > 0 }, { ROUND < 100 }
{
    FriLayerDigest<ROUND> {
        valid: true,
        value: commit_ext4_fields<MandelbrotFriLayerRowBabyBear<ROUND>, 1>([value]),
    }
}

pub fn fri_layer_root_power_of_two<const ROUND: u32, const N: usize>(
    _ leaves: own [FriLayerDigest<ROUND>; N],
) -> FriLayerDigest<ROUND>
where { ROUND > 0 }, { ROUND < 100 }, N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return FriLayerDigest<ROUND> { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    FriLayerDigest<ROUND> { valid: root.valid, value: root.value }
}

pub fn fri_layer_pair_path_power_of_two<
    const ROUND: u32,
    const N: usize,
    const HALF: usize,
    const DEPTH: usize,
>(
    _ evaluations: own [BabyBearExt4; N],
    _ index: u32,
) -> FriLayerPairPath<ROUND, DEPTH>
where
    { ROUND > 0 },
    { ROUND < 100 },
    N > 1,
    N <= MAX_PADDED_TRACE_LENGTH,
    HALF > 0,
    { HALF + HALF == N },
{
    let mut leaves = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        leaves[cursor] = fri_layer_row_commitment<ROUND>(evaluations[cursor]).value
        cursor = cursor + 1
    }
    let raw = pair_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        HALF,
        DEPTH,
    >(leaves, index)
    FriLayerPairPath<ROUND, DEPTH> {
        valid: raw.valid,
        index: raw.index,
        positive_siblings: raw.positive_siblings,
        negative_siblings: raw.negative_siblings,
    }
}

pub fn verify_fri_layer_pair_path<const ROUND: u32, const DEPTH: usize>(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ path: own FriLayerPairPath<ROUND, DEPTH>,
    _ root: own FriLayerDigest<ROUND>,
) -> bool
where { ROUND > 0 }, { ROUND < 100 }
{
    if !root.valid || !path.valid { return false }
    pair_verify<Poseidon2Digest, DigestNodeHasher, DEPTH>(
        root.value,
        fri_layer_row_commitment<ROUND>(positive).value,
        fri_layer_row_commitment<ROUND>(negative).value,
        MerklePairPath<Poseidon2Digest, DEPTH> {
            valid: path.valid,
            index: path.index,
            positive_siblings: path.positive_siblings,
            negative_siblings: path.negative_siblings,
        },
    )
}

pub fn bind_first_fri_layer(
    _ transcript: own CompositionTranscriptDigest,
    _ layer: own FriLayerDigest<1>,
) -> FriLayerTranscriptDigest<1> {
    if !transcript.valid || !layer.valid {
        return FriLayerTranscriptDigest<1> { valid: false, value: Poseidon2Digest::zero() }
    }
    FriLayerTranscriptDigest<1> {
        valid: true,
        value: poseidon_bind<MandelbrotFriLayerTranscriptBabyBear<1>>(
            transcript.value,
            layer.value,
        ),
    }
}

pub fn bind_next_fri_layer<const PREVIOUS: u32, const ROUND: u32>(
    _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
    _ layer: own FriLayerDigest<ROUND>,
) -> FriLayerTranscriptDigest<ROUND>
where { PREVIOUS > 0 }, { ROUND == PREVIOUS + 1 }, { ROUND < 100 }
{
    if !transcript.valid || !layer.valid {
        return FriLayerTranscriptDigest<ROUND> { valid: false, value: Poseidon2Digest::zero() }
    }
    FriLayerTranscriptDigest<ROUND> {
        valid: true,
        value: poseidon_bind<MandelbrotFriLayerTranscriptBabyBear<ROUND>>(
            transcript.value,
            layer.value,
        ),
    }
}

/// One reusable FRI binary fold over the quartic BabyBear challenge field.
/// Evaluations at `x` and `-x` become one evaluation at `x^2`.
pub fn fold_fri_evaluations<const N: usize, const OUT: usize>(
    _ evaluations: own [BabyBearExt4; N],
    _ challenge: BabyBearExt4,
    _ shift: BabyBear,
) -> FriFoldEvaluations<OUT>
where N > 0, N > 1, { (N & (N - 1)) == 0 }, OUT > 0, { OUT + OUT == N }
{
    if shift.is_zero() {
        return FriFoldEvaluations<OUT> {
            valid: false,
            evaluations: [BabyBearExt4::zero(); OUT],
        }
    }
    let inverse_two = BabyBearExt4::from_base(BabyBear::from_u32(2)).inverse_or_zero()
    let root = BabyBear::two_adic_root(radix2_log<N>())
    let mut point = shift
    let mut folded = [BabyBearExt4::zero(); OUT]
    let mut index: usize = 0
    while index < OUT {
        let positive = evaluations[index]
        let negative = evaluations[index + OUT]
        let even = (positive + negative) * inverse_two
        let odd = (positive - negative)
            * inverse_two
            * BabyBearExt4::from_base(point.inverse_or_zero())
        folded[index] = even + challenge * odd
        point = point * root
        index = index + 1
    }
    FriFoldEvaluations<OUT> { valid: true, evaluations: folded }
}

fn invalid_fri_round<const ROUND: u32, const N: usize, const NEXT: u32>() -> FriRound<
    ROUND,
    N,
    NEXT,
> {
    FriRound<ROUND, N, NEXT> {
        valid: false,
        evaluations: [BabyBearExt4::zero(); N],
        root: FriLayerDigest<ROUND> { valid: false, value: Poseidon2Digest::zero() },
        transcript: FriLayerTranscriptDigest<ROUND> {
            valid: false,
            value: Poseidon2Digest::zero(),
        },
        next_challenge: FriFoldChallenge<NEXT> {
            valid: false,
            value: BabyBearExt4::zero(),
        },
    }
}

fn invalid_fri_final<const ROUND: u32>() -> FriFinalRound<ROUND> {
    FriFinalRound<ROUND> {
        valid: false,
        evaluation: BabyBearExt4::zero(),
        root: FriLayerDigest<ROUND> { valid: false, value: Poseidon2Digest::zero() },
        transcript: FriLayerTranscriptDigest<ROUND> {
            valid: false,
            value: Poseidon2Digest::zero(),
        },
    }
}

fn invalid_fri_complete16() -> FriProofComplete16 {
    FriProofComplete16 {
        valid: false,
        first: invalid_fri_round<1, 8, 2>(),
        second: invalid_fri_round<2, 4, 3>(),
        third: invalid_fri_round<3, 2, 4>(),
        final_round: invalid_fri_final<4>(),
    }
}

fn invalid_composition_query_pair<const DEPTH: usize>() -> CompositionQueryPair<DEPTH> {
    CompositionQueryPair<DEPTH> {
        positive: BabyBearExt4::zero(),
        negative: BabyBearExt4::zero(),
        path: CompositionPairPath<DEPTH> {
            valid: false,
            index: 0,
            positive_siblings: [Poseidon2Digest::zero(); DEPTH],
            negative_siblings: [Poseidon2Digest::zero(); DEPTH],
        },
    }
}

fn invalid_fri_query_pair<const ROUND: u32, const DEPTH: usize>() -> FriQueryPair<
    ROUND,
    DEPTH,
> {
    FriQueryPair<ROUND, DEPTH> {
        positive: BabyBearExt4::zero(),
        negative: BabyBearExt4::zero(),
        path: FriLayerPairPath<ROUND, DEPTH> {
            valid: false,
            index: 0,
            positive_siblings: [Poseidon2Digest::zero(); DEPTH],
            negative_siblings: [Poseidon2Digest::zero(); DEPTH],
        },
    }
}

fn invalid_fri_query16() -> FriCommitmentQuery16 {
    FriCommitmentQuery16 {
        valid: false,
        composition_root: CompositionDigest { valid: false, value: Poseidon2Digest::zero() },
        first_root: FriLayerDigest<1> { valid: false, value: Poseidon2Digest::zero() },
        second_root: FriLayerDigest<2> { valid: false, value: Poseidon2Digest::zero() },
        third_root: FriLayerDigest<3> { valid: false, value: Poseidon2Digest::zero() },
        final_root: FriLayerDigest<4> { valid: false, value: Poseidon2Digest::zero() },
        query_index: 0,
        composition: invalid_composition_query_pair<3>(),
        first: invalid_fri_query_pair<1, 2>(),
        second: invalid_fri_query_pair<2, 1>(),
        third: invalid_fri_query_pair<3, 0>(),
        final_evaluation: BabyBearExt4::zero(),
    }
}

fn commit_fri_layer<const ROUND: u32, const N: usize>(
    _ evaluations: own [BabyBearExt4; N],
) -> FriLayerDigest<ROUND>
where
    { ROUND > 0 },
    { ROUND < 100 },
    N > 0,
    N <= MAX_PADDED_TRACE_LENGTH,
    { (N & (N - 1)) == 0 },
{
    let mut leaves = [FriLayerDigest<ROUND> {
        valid: false,
        value: Poseidon2Digest::zero(),
    }; N]
    let mut index: usize = 0
    while index < N {
        leaves[index] = fri_layer_row_commitment<ROUND>(evaluations[index])
        index = index + 1
    }
    fri_layer_root_power_of_two<ROUND, N>(leaves)
}

pub fn fold_first_fri_round16(
    _ evaluations: own [BabyBearExt4; 16],
    _ transcript: own CompositionTranscriptDigest,
    _ shift: BabyBear,
) -> FriRound<1, 8, 2> {
    let challenge = fri_fold_challenge(transcript)
    if !challenge.valid {
        return invalid_fri_round<1, 8, 2>()
    }
    let folded = fold_fri_evaluations<16, 8>(evaluations, challenge.value, shift)
    if !folded.valid {
        return invalid_fri_round<1, 8, 2>()
    }
    let root = commit_fri_layer<1, 8>(folded.evaluations)
    let next_transcript = bind_first_fri_layer(transcript, root)
    let next_challenge = next_fri_fold_challenge<1, 2>(next_transcript)
    if !root.valid || !next_transcript.valid || !next_challenge.valid {
        return invalid_fri_round<1, 8, 2>()
    }
    FriRound<1, 8, 2> {
        valid: true,
        evaluations: folded.evaluations,
        root: root,
        transcript: next_transcript,
        next_challenge: next_challenge,
    }
}

pub fn fold_next_fri_round<
    const PREVIOUS: u32,
    const ROUND: u32,
    const N: usize,
    const OUT: usize,
    const NEXT: u32,
>(
    _ evaluations: own [BabyBearExt4; N],
    _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
    _ challenge: own FriFoldChallenge<ROUND>,
    _ shift: BabyBear,
) -> FriRound<ROUND, OUT, NEXT>
where
    { PREVIOUS > 0 },
    { ROUND == PREVIOUS + 1 },
    { ROUND < 100 },
    { NEXT == ROUND + 1 },
    { NEXT < 100 },
    N > 0,
    N > 1,
    { (N & (N - 1)) == 0 },
    OUT > 0,
    OUT <= MAX_PADDED_TRACE_LENGTH,
    { (OUT & (OUT - 1)) == 0 },
    { OUT + OUT == N },
{
    if !transcript.valid || !challenge.valid {
        return invalid_fri_round<ROUND, OUT, NEXT>()
    }
    let folded = fold_fri_evaluations<N, OUT>(evaluations, challenge.value, shift)
    if !folded.valid {
        return invalid_fri_round<ROUND, OUT, NEXT>()
    }
    let root = commit_fri_layer<ROUND, OUT>(folded.evaluations)
    let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, root)
    let next_challenge = next_fri_fold_challenge<ROUND, NEXT>(next_transcript)
    if !root.valid || !next_transcript.valid || !next_challenge.valid {
        return invalid_fri_round<ROUND, OUT, NEXT>()
    }
    FriRound<ROUND, OUT, NEXT> {
        valid: true,
        evaluations: folded.evaluations,
        root: root,
        transcript: next_transcript,
        next_challenge: next_challenge,
    }
}

pub fn fold_final_fri_round<const PREVIOUS: u32, const ROUND: u32>(
    _ evaluations: own [BabyBearExt4; 2],
    _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
    _ challenge: own FriFoldChallenge<ROUND>,
    _ shift: BabyBear,
) -> FriFinalRound<ROUND>
where { PREVIOUS > 0 }, { ROUND == PREVIOUS + 1 }, { ROUND < 100 }
{
    if !transcript.valid || !challenge.valid {
        return invalid_fri_final<ROUND>()
    }
    let folded = fold_fri_evaluations<2, 1>(evaluations, challenge.value, shift)
    if !folded.valid {
        return invalid_fri_final<ROUND>()
    }
    let root = fri_layer_row_commitment<ROUND>(folded.evaluations[0])
    let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, root)
    if !root.valid || !next_transcript.valid {
        return invalid_fri_final<ROUND>()
    }
    FriFinalRound<ROUND> {
        valid: true,
        evaluation: folded.evaluations[0],
        root: root,
        transcript: next_transcript,
    }
}

/// Materialize an authenticated 16-to-1 FRI chain. Every next challenge is
/// squeezed only after the preceding folded layer has been committed.
pub fn fold_all_fri16(
    _ evaluations: own [BabyBearExt4; 16],
    _ transcript: own CompositionTranscriptDigest,
    _ shift: BabyBear,
) -> FriProofComplete16 {
    let first = fold_first_fri_round16(evaluations, transcript, shift)
    if !first.valid { return invalid_fri_complete16() }

    let shift2 = shift.square()
    let second = fold_next_fri_round<1, 2, 8, 4, 3>(
        first.evaluations,
        first.transcript,
        first.next_challenge,
        shift2,
    )
    if !second.valid { return invalid_fri_complete16() }

    let shift3 = shift2.square()
    let third = fold_next_fri_round<2, 3, 4, 2, 4>(
        second.evaluations,
        second.transcript,
        second.next_challenge,
        shift3,
    )
    if !third.valid { return invalid_fri_complete16() }

    let final_round = fold_final_fri_round<3, 4>(
        third.evaluations,
        third.transcript,
        third.next_challenge,
        shift3.square(),
    )
    if !final_round.valid { return invalid_fri_complete16() }

    FriProofComplete16 {
        valid: true,
        first: first,
        second: second,
        third: third,
        final_round: final_round,
    }
}

pub fn open_fri_commitment_query16(
    _ evaluations: own [BabyBearExt4; 16],
    _ air_transcript: own AirLdeTranscriptDigest,
    _ shift: BabyBear,
) -> FriCommitmentQuery16 {
    if !air_transcript.valid || shift.is_zero() {
        return invalid_fri_query16()
    }

    let mut composition_leaves = [CompositionDigest {
        valid: false,
        value: Poseidon2Digest::zero(),
    }; 16]
    let mut cursor: usize = 0
    while cursor < 16 {
        composition_leaves[cursor] = composition_row_commitment(evaluations[cursor])
        cursor = cursor + 1
    }
    let composition_root = composition_root_power_of_two<16>(composition_leaves)
    let composition_transcript = bind_composition(air_transcript, composition_root)
    let complete = fold_all_fri16(evaluations, composition_transcript, shift)
    if !composition_root.valid || !composition_transcript.valid || !complete.valid {
        return invalid_fri_query16()
    }

    let query_challenge = fri_query_challenge<4, 1>(complete.final_round.transcript)
    let query = fri_query_index_power_of_two<1, 8>(query_challenge)
    if !query.valid { return invalid_fri_query16() }
    let first_index = query.value & 3
    let second_index = first_index & 1

    let composition_path = composition_pair_path_power_of_two<16, 8, 3>(
        evaluations,
        query.value,
    )
    let first_path = fri_layer_pair_path_power_of_two<1, 8, 4, 2>(
        complete.first.evaluations,
        first_index,
    )
    let second_path = fri_layer_pair_path_power_of_two<2, 4, 2, 1>(
        complete.second.evaluations,
        second_index,
    )
    let third_path = fri_layer_pair_path_power_of_two<3, 2, 1, 0>(
        complete.third.evaluations,
        0,
    )
    if !composition_path.valid
        || !first_path.valid
        || !second_path.valid
        || !third_path.valid {
        return invalid_fri_query16()
    }

    let composition_index: usize = query.value as usize
    let first_position: usize = first_index as usize
    let second_position: usize = second_index as usize
    FriCommitmentQuery16 {
        valid: true,
        composition_root: composition_root,
        first_root: complete.first.root,
        second_root: complete.second.root,
        third_root: complete.third.root,
        final_root: complete.final_round.root,
        query_index: query.value,
        composition: CompositionQueryPair<3> {
            positive: evaluations[composition_index],
            negative: evaluations[composition_index + 8],
            path: composition_path,
        },
        first: FriQueryPair<1, 2> {
            positive: complete.first.evaluations[first_position],
            negative: complete.first.evaluations[first_position + 4],
            path: first_path,
        },
        second: FriQueryPair<2, 1> {
            positive: complete.second.evaluations[second_position],
            negative: complete.second.evaluations[second_position + 2],
            path: second_path,
        },
        third: FriQueryPair<3, 0> {
            positive: complete.third.evaluations[0],
            negative: complete.third.evaluations[1],
            path: third_path,
        },
        final_evaluation: complete.final_round.evaluation,
    }
}

fn fold_fri_pair_at<const N: usize>(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ challenge: BabyBearExt4,
    _ shift: BabyBear,
    _ index: u32,
) -> FriFoldEvaluations<1>
where N > 0, N > 1, { (N & (N - 1)) == 0 }
{
    let point = shift * BabyBear::two_adic_root(radix2_log<N>()).pow_u32(index)
    fold_fri_evaluations<2, 1>([positive, negative], challenge, point)
}

pub fn verify_fri_commitment_query16(
    _ air_transcript: own AirLdeTranscriptDigest,
    _ shift: BabyBear,
    _ proof: own FriCommitmentQuery16,
) -> bool {
    if !air_transcript.valid
        || shift.is_zero()
        || !proof.valid
        || !proof.composition_root.valid
        || !proof.first_root.valid
        || !proof.second_root.valid
        || !proof.third_root.valid
        || !proof.final_root.valid {
        return false
    }

    let composition_transcript = bind_composition(air_transcript, proof.composition_root)
    let first_challenge = fri_fold_challenge(composition_transcript)
    let first_transcript = bind_first_fri_layer(composition_transcript, proof.first_root)
    let second_challenge = next_fri_fold_challenge<1, 2>(first_transcript)
    let second_transcript = bind_next_fri_layer<1, 2>(first_transcript, proof.second_root)
    let third_challenge = next_fri_fold_challenge<2, 3>(second_transcript)
    let third_transcript = bind_next_fri_layer<2, 3>(second_transcript, proof.third_root)
    let fourth_challenge = next_fri_fold_challenge<3, 4>(third_transcript)
    let fourth_transcript = bind_next_fri_layer<3, 4>(third_transcript, proof.final_root)
    let query_challenge = fri_query_challenge<4, 1>(fourth_transcript)
    let query = fri_query_index_power_of_two<1, 8>(query_challenge)
    if !composition_transcript.valid
        || !first_challenge.valid
        || !first_transcript.valid
        || !second_challenge.valid
        || !second_transcript.valid
        || !third_challenge.valid
        || !third_transcript.valid
        || !fourth_challenge.valid
        || !fourth_transcript.valid
        || !query.valid {
        return false
    }
    let first_index = query.value & 3
    let second_index = first_index & 1
    if proof.query_index != query.value
        || proof.composition.path.index != query.value
        || proof.first.path.index != first_index
        || proof.second.path.index != second_index
        || proof.third.path.index != 0 {
        return false
    }

    if !verify_composition_pair_path<3>(
            proof.composition.positive,
            proof.composition.negative,
            proof.composition.path,
            proof.composition_root,
        )
        || !verify_fri_layer_pair_path<1, 2>(
            proof.first.positive,
            proof.first.negative,
            proof.first.path,
            proof.first_root,
        )
        || !verify_fri_layer_pair_path<2, 1>(
            proof.second.positive,
            proof.second.negative,
            proof.second.path,
            proof.second_root,
        )
        || !verify_fri_layer_pair_path<3, 0>(
            proof.third.positive,
            proof.third.negative,
            proof.third.path,
            proof.third_root,
        ) {
        return false
    }
    let final_commitment = fri_layer_row_commitment<4>(proof.final_evaluation)
    if !final_commitment.value.equals(proof.final_root.value) {
        return false
    }

    let first_fold = fold_fri_pair_at<16>(
        proof.composition.positive,
        proof.composition.negative,
        first_challenge.value,
        shift,
        query.value,
    )
    let expected_first = if query.value < 4 {
        proof.first.positive
    } else {
        proof.first.negative
    }
    if !first_fold.valid || !first_fold.evaluations[0].equals(expected_first) {
        return false
    }

    let shift2 = shift.square()
    let second_fold = fold_fri_pair_at<8>(
        proof.first.positive,
        proof.first.negative,
        second_challenge.value,
        shift2,
        first_index,
    )
    let expected_second = if first_index < 2 {
        proof.second.positive
    } else {
        proof.second.negative
    }
    if !second_fold.valid || !second_fold.evaluations[0].equals(expected_second) {
        return false
    }

    let shift3 = shift2.square()
    let third_fold = fold_fri_pair_at<4>(
        proof.second.positive,
        proof.second.negative,
        third_challenge.value,
        shift3,
        second_index,
    )
    let expected_third = if second_index == 0 {
        proof.third.positive
    } else {
        proof.third.negative
    }
    if !third_fold.valid || !third_fold.evaluations[0].equals(expected_third) {
        return false
    }

    let final_fold = fold_fri_pair_at<2>(
        proof.third.positive,
        proof.third.negative,
        fourth_challenge.value,
        shift3.square(),
        0,
    )
    final_fold.valid && final_fold.evaluations[0].equals(proof.final_evaluation)
}
