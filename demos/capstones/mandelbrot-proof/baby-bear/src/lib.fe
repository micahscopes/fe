/// One committed output layer in a schedule-derived FRI proof. Every fold has
/// the same carrier shape, including the final one-element layer.
pub struct FriCommittedLayer<const ROUND: u32, const N: usize> {
    pub valid: bool,
    pub evaluations: [BabyBearExt4; N],
    pub root: FriLayerDigest<ROUND>,
    pub transcript: FriLayerTranscriptDigest<ROUND>,
}
impl<const ROUND: u32, const N: usize> core::marker::Copy for FriCommittedLayer<ROUND, N> {}

/// The value-level terminal corresponding to `FriScheduleDone`.
pub struct FriProofEnd<const NEXT_ROUND: u32> {}
impl<const NEXT_ROUND: u32> core::marker::Copy for FriProofEnd<NEXT_ROUND> {}

/// One value-level fold corresponding to `FriScheduleFold`. `Tail` is the
/// recursively interpreted remainder of the same field-neutral schedule.
pub struct FriProofFold<const ROUND: u32, const N: usize, Tail> {
    pub valid: bool,
    pub layer: FriCommittedLayer<ROUND, N>,
    pub tail: Tail,
}
impl<const ROUND: u32, const N: usize, Tail: core::marker::Copy> core::marker::Copy
    for FriProofFold<ROUND, N, Tail> {}

/// Continue a FRI fold after the previous layer has been committed. The
/// schedule tail decides whether to derive another challenge and fold, or stop
/// immediately at `FriScheduleDone`, so the final layer never performs an
/// unused transcript squeeze.
pub trait BabyBearFriTail<const PREVIOUS: u32, const INPUT: usize> {
    type Proof
    fn invalid_fri_tail() -> Self::Proof
    fn fold_fri_tail(
        _ evaluations: own [BabyBearExt4; INPUT],
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ shift: BabyBear,
    ) -> (bool, Self::Proof)
}

impl<
    const PREVIOUS: u32,
    const INPUT: usize,
    const NEXT_ROUND: u32,
> BabyBearFriTail<PREVIOUS, INPUT> for FriScheduleDone<NEXT_ROUND>
where { NEXT_ROUND == PREVIOUS + 1 }, { INPUT == 1 }
{
    type Proof = FriProofEnd<NEXT_ROUND>

    fn invalid_fri_tail() -> FriProofEnd<NEXT_ROUND> {
        FriProofEnd<NEXT_ROUND> {}
    }

    fn fold_fri_tail(
        _ evaluations: own [BabyBearExt4; INPUT],
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ shift: BabyBear,
    ) -> (bool, FriProofEnd<NEXT_ROUND>) {
        if !transcript.valid || shift.is_zero() {
            return (false, <Self as BabyBearFriTail<PREVIOUS, INPUT>>::invalid_fri_tail())
        }
        (true, FriProofEnd<NEXT_ROUND> {})
    }
}

impl<
    const PREVIOUS: u32,
    const INPUT: usize,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    Tail: BabyBearFriTail<ROUND, OUTPUT>,
> BabyBearFriTail<PREVIOUS, INPUT> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    Tail,
>
where
    { PREVIOUS > 0 },
    { ROUND == PREVIOUS + 1 },
    { ROUND > 0 },
    { ROUND < 100 },
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { INPUT == OUTPUT + OUTPUT },
    OUTPUT > 0,
    OUTPUT <= MAX_PADDED_TRACE_LENGTH,
    { (OUTPUT & (OUTPUT - 1)) == 0 },
{
    type Proof = FriProofFold<
        ROUND,
        OUTPUT,
        <Tail as BabyBearFriTail<ROUND, OUTPUT>>::Proof,
    >

    fn invalid_fri_tail() -> FriProofFold<
        ROUND,
        OUTPUT,
        <Tail as BabyBearFriTail<ROUND, OUTPUT>>::Proof,
    > {
        FriProofFold<
            ROUND,
            OUTPUT,
            <Tail as BabyBearFriTail<ROUND, OUTPUT>>::Proof,
        > {
            valid: false,
            layer: FriCommittedLayer {
                valid: false,
                evaluations: [BabyBearExt4::zero(); OUTPUT],
                root: FriLayerDigest {
                    valid: false,
                    value: Poseidon2Digest::zero(),
                },
                transcript: FriLayerTranscriptDigest {
                    valid: false,
                    value: Poseidon2Digest::zero(),
                },
            },
            tail: <Tail as BabyBearFriTail<ROUND, OUTPUT>>::invalid_fri_tail(),
        }
    }

    fn fold_fri_tail(
        _ evaluations: own [BabyBearExt4; INPUT],
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ shift: BabyBear,
    ) -> (
        bool,
        FriProofFold<
            ROUND,
            OUTPUT,
            <Tail as BabyBearFriTail<ROUND, OUTPUT>>::Proof,
        >,
    ) {
        let challenge = next_fri_fold_challenge<PREVIOUS, ROUND>(transcript)
        if !challenge.valid || shift.is_zero() {
            return (false, <Self as BabyBearFriTail<PREVIOUS, INPUT>>::invalid_fri_tail())
        }
        let folded = fold_fri_evaluations<INPUT, OUTPUT>(
            evaluations,
            challenge.value,
            shift,
        )
        if !folded.valid {
            return (false, <Self as BabyBearFriTail<PREVIOUS, INPUT>>::invalid_fri_tail())
        }
        let root = commit_fri_layer<ROUND, OUTPUT>(folded.evaluations)
        let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, root)
        if !root.valid || !next_transcript.valid {
            return (false, <Self as BabyBearFriTail<PREVIOUS, INPUT>>::invalid_fri_tail())
        }
        let tail = <Tail as BabyBearFriTail<ROUND, OUTPUT>>::fold_fri_tail(
            folded.evaluations,
            next_transcript,
            shift.square(),
        )
        if !tail.0 {
            return (false, <Self as BabyBearFriTail<PREVIOUS, INPUT>>::invalid_fri_tail())
        }
        (
            true,
            FriProofFold<
                ROUND,
                OUTPUT,
                <Tail as BabyBearFriTail<ROUND, OUTPUT>>::Proof,
            > {
                valid: true,
                layer: FriCommittedLayer {
                    valid: true,
                    evaluations: folded.evaluations,
                    root: root,
                    transcript: next_transcript,
                },
                tail: tail.1,
            },
        )
    }
}

/// Interpret the first schedule node from the AIR composition transcript. All
/// later nodes use `BabyBearFriTail`, so this is the only protocol-specific
/// distinction between the initial FRI challenge and subsequent challenges.
pub trait BabyBearFriFirst<const INPUT: usize> {
    type Proof
    fn invalid_fri_first() -> Self::Proof
    fn fold_fri_first(
        _ evaluations: own [BabyBearExt4; INPUT],
        _ transcript: own CompositionTranscriptDigest,
        _ shift: BabyBear,
    ) -> (bool, Self::Proof)
}

impl<
    const INPUT: usize,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    Tail: BabyBearFriTail<1, OUTPUT>,
> BabyBearFriFirst<INPUT> for FriScheduleFold<
    1,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    Tail,
>
where
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { INPUT == OUTPUT + OUTPUT },
    OUTPUT > 0,
    OUTPUT <= MAX_PADDED_TRACE_LENGTH,
    { (OUTPUT & (OUTPUT - 1)) == 0 },
{
    type Proof = FriProofFold<
        1,
        OUTPUT,
        <Tail as BabyBearFriTail<1, OUTPUT>>::Proof,
    >

    fn invalid_fri_first() -> FriProofFold<
        1,
        OUTPUT,
        <Tail as BabyBearFriTail<1, OUTPUT>>::Proof,
    > {
        FriProofFold<
            1,
            OUTPUT,
            <Tail as BabyBearFriTail<1, OUTPUT>>::Proof,
        > {
            valid: false,
            layer: FriCommittedLayer {
                valid: false,
                evaluations: [BabyBearExt4::zero(); OUTPUT],
                root: FriLayerDigest {
                    valid: false,
                    value: Poseidon2Digest::zero(),
                },
                transcript: FriLayerTranscriptDigest {
                    valid: false,
                    value: Poseidon2Digest::zero(),
                },
            },
            tail: <Tail as BabyBearFriTail<1, OUTPUT>>::invalid_fri_tail(),
        }
    }

    fn fold_fri_first(
        _ evaluations: own [BabyBearExt4; INPUT],
        _ transcript: own CompositionTranscriptDigest,
        _ shift: BabyBear,
    ) -> (
        bool,
        FriProofFold<
            1,
            OUTPUT,
            <Tail as BabyBearFriTail<1, OUTPUT>>::Proof,
        >,
    ) {
        let challenge = fri_fold_challenge(transcript)
        if !challenge.valid || shift.is_zero() {
            return (false, <Self as BabyBearFriFirst<INPUT>>::invalid_fri_first())
        }
        let folded = fold_fri_evaluations<INPUT, OUTPUT>(
            evaluations,
            challenge.value,
            shift,
        )
        if !folded.valid {
            return (false, <Self as BabyBearFriFirst<INPUT>>::invalid_fri_first())
        }
        let root = commit_fri_layer<1, OUTPUT>(folded.evaluations)
        let next_transcript = bind_first_fri_layer(transcript, root)
        if !root.valid || !next_transcript.valid {
            return (false, <Self as BabyBearFriFirst<INPUT>>::invalid_fri_first())
        }
        let tail = <Tail as BabyBearFriTail<1, OUTPUT>>::fold_fri_tail(
            folded.evaluations,
            next_transcript,
            shift.square(),
        )
        if !tail.0 {
            return (false, <Self as BabyBearFriFirst<INPUT>>::invalid_fri_first())
        }
        (
            true,
            FriProofFold<
                1,
                OUTPUT,
                <Tail as BabyBearFriTail<1, OUTPUT>>::Proof,
            > {
                valid: true,
                layer: FriCommittedLayer {
                    valid: true,
                    evaluations: folded.evaluations,
                    root: root,
                    transcript: next_transcript,
                },
                tail: tail.1,
            },
        )
    }
}

pub fn fold_fri_schedule<
    const INPUT: usize,
    S: BabyBearFriFirst<INPUT>,
>(
    _ evaluations: own [BabyBearExt4; INPUT],
    _ transcript: own CompositionTranscriptDigest,
    _ shift: BabyBear,
) -> <S as BabyBearFriFirst<INPUT>>::Proof {
    <S as BabyBearFriFirst<INPUT>>::fold_fri_first(
        evaluations,
        transcript,
        shift,
    ).1
}

/// The existing 16-point complete-codeword gate is an explicit protocol
/// checkpoint. Its nested storage is nevertheless derived from `FriSchedule`.
pub type CheckpointFriProof16 =
    <FriSchedule<1, 4> as BabyBearFriFirst<16>>::Proof

pub struct CompositionPairPath<const DEPTH: usize> {
    pub valid: bool,
    pub index: u32,
    pub positive_siblings: [Poseidon2Digest; DEPTH],
    pub negative_siblings: [Poseidon2Digest; DEPTH],
}
impl<const DEPTH: usize> core::marker::Copy for CompositionPairPath<DEPTH> {}

/// A role-branded authentication path for one common local position in each
/// quarter of an AIR LDE tree. `Role` is compile-time-only: it distinguishes
/// main and auxiliary paths without duplicating their runtime representation
/// or the field-generic `merkle_core` interpreter.
pub struct LdeQuartetPath<Role, const DEPTH: usize> {
    pub valid: bool,
    pub index: u32,
    pub first_siblings: [Poseidon2Digest; DEPTH],
    pub second_siblings: [Poseidon2Digest; DEPTH],
    pub third_siblings: [Poseidon2Digest; DEPTH],
    pub fourth_siblings: [Poseidon2Digest; DEPTH],
}
impl<Role, const DEPTH: usize> core::marker::Copy for LdeQuartetPath<Role, DEPTH> {}

pub struct MainLdeTreeRole {}
pub struct AuxiliaryLdeTreeRole {}
pub type MainLdeQuartetPath<const DEPTH: usize> = LdeQuartetPath<MainLdeTreeRole, DEPTH>
pub type AuxiliaryLdeQuartetPath<const DEPTH: usize> =
    LdeQuartetPath<AuxiliaryLdeTreeRole, DEPTH>

/// One authenticated verifier row. Main and auxiliary values remain in the
/// u32-native base field; the shared AIR view embeds them into the quartic
/// challenge field only while recomputing the composition value.
pub struct AirLdeRow {
    pub main: [BabyBear; MAIN_LDE_ROW_FIELDS],
    pub auxiliary: [BabyBear; AUXILIARY_ROW_BITS],
}
impl core::marker::Copy for AirLdeRow {}

impl AirColumnView<BabyBearExt4> for AirLdeRow {
    fn main(ref self, _ column: usize) -> BabyBearExt4 {
        BabyBearExt4::from_base(self.main[column])
    }

    fn auxiliary(ref self, _ column: usize) -> BabyBearExt4 {
        BabyBearExt4::from_base(self.auxiliary[column])
    }
}

/// The four-row trace checkpoint opens one common local position in every LDE
/// quarter. `radix2_query_geometry<4, LDE>` derives which quarters represent
/// current, next, negative, and negative-next rows for a transcript query.
pub struct Checkpoint4AirLdeOpening<const DEPTH: usize> {
    pub valid: bool,
    pub rows: [AirLdeRow; 4],
    pub main_path: MainLdeQuartetPath<DEPTH>,
    pub auxiliary_path: AuxiliaryLdeQuartetPath<DEPTH>,
}
impl<const DEPTH: usize> core::marker::Copy for Checkpoint4AirLdeOpening<DEPTH> {}

pub const ZERO_AIR_LDE_ROW: AirLdeRow = AirLdeRow {
    main: [BabyBear::zero(); MAIN_LDE_ROW_FIELDS],
    auxiliary: [BabyBear::zero(); AUXILIARY_ROW_BITS],
}

pub struct FriLayerPairPath<const ROUND: u32, const DEPTH: usize> {
    pub valid: bool,
    pub index: u32,
    pub positive_siblings: [Poseidon2Digest; DEPTH],
    pub negative_siblings: [Poseidon2Digest; DEPTH],
}
impl<const ROUND: u32, const DEPTH: usize> core::marker::Copy for FriLayerPairPath<ROUND, DEPTH> {}

pub struct CompositionQueryPair<const DEPTH: usize> {
    pub positive: BabyBearExt4,
    pub negative: BabyBearExt4,
    pub path: CompositionPairPath<DEPTH>,
}
impl<const DEPTH: usize> core::marker::Copy for CompositionQueryPair<DEPTH> {}

pub struct FriQueryPair<const ROUND: u32, const DEPTH: usize> {
    pub positive: BabyBearExt4,
    pub negative: BabyBearExt4,
    pub path: FriLayerPairPath<ROUND, DEPTH>,
}
impl<const ROUND: u32, const DEPTH: usize> core::marker::Copy for FriQueryPair<ROUND, DEPTH> {}

/// One compact authenticated pair for a nonterminal schedule layer. `Tail`
/// carries the query interpretation of the remaining schedule.
pub struct FriQueryFold<const ROUND: u32, const DEPTH: usize, Tail> {
    pub valid: bool,
    pub root: FriLayerDigest<ROUND>,
    pub pair: FriQueryPair<ROUND, DEPTH>,
    pub tail: Tail,
}
impl<const ROUND: u32, const DEPTH: usize, Tail: core::marker::Copy> core::marker::Copy
    for FriQueryFold<ROUND, DEPTH, Tail> {}

/// The one-evaluation terminal layer needs no authentication siblings: its row
/// commitment is the layer root.
pub struct FriQueryEnd<const ROUND: u32> {
    pub valid: bool,
    pub root: FriLayerDigest<ROUND>,
    pub evaluation: BabyBearExt4,
}
impl<const ROUND: u32> core::marker::Copy for FriQueryEnd<ROUND> {}

/// Interpret a field-neutral FRI schedule into its compact authenticated query
/// carrier. The schedule tail distinguishes a pair-opening node from the
/// one-evaluation terminal, so no runtime round tag or manually enumerated
/// layer list is needed.
pub trait BabyBearFriQueryShape {
    type Query
    fn invalid_fri_query() -> Self::Query
}

impl<
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
> BabyBearFriQueryShape for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleDone<NEXT_ROUND>,
>
where
    { ROUND > 0 },
    { NEXT_ROUND == ROUND + 1 },
    { INPUT_LOG == 1 },
    { OUTPUT == 1 },
    { PAIR_WIDTH == 0 },
    { PAIR_DEPTH == 0 },
{
    type Query = FriQueryEnd<ROUND>

    fn invalid_fri_query() -> FriQueryEnd<ROUND> {
        FriQueryEnd {
            valid: false,
            root: FriLayerDigest { valid: false, value: Poseidon2Digest::zero() },
            evaluation: BabyBearExt4::zero(),
        }
    }
}

impl<
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    Rest,
> BabyBearFriQueryShape for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    { ROUND > 0 },
    { INPUT_LOG > 1 },
    { OUTPUT > 1 },
    { PAIR_WIDTH + PAIR_WIDTH == OUTPUT },
    { PAIR_DEPTH + 2 == INPUT_LOG },
    { NEXT_ROUND == ROUND + 1 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriQueryShape,
{
    type Query = FriQueryFold<
        ROUND,
        PAIR_DEPTH,
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        >
            as BabyBearFriQueryShape>::Query,
    >

    fn invalid_fri_query() -> FriQueryFold<
        ROUND,
        PAIR_DEPTH,
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        >
            as BabyBearFriQueryShape>::Query,
    > {
        FriQueryFold {
            valid: false,
            root: FriLayerDigest { valid: false, value: Poseidon2Digest::zero() },
            pair: invalid_fri_query_pair<ROUND, PAIR_DEPTH>(),
            tail: <FriScheduleFold<
                NEXT_ROUND,
                NEXT_INPUT_LOG,
                NEXT_OUTPUT,
                NEXT_PAIR_WIDTH,
                NEXT_PAIR_DEPTH,
                Rest,
            >
                as BabyBearFriQueryShape>::invalid_fri_query(),
        }
    }
}

/// Open a transcript-selected compact query from a complete codeword proof.
/// `Complete` and `Query` are two interpretations of the same schedule. The
/// terminal implementation samples Fiat-Shamir from the final typed
/// transcript; every recursive implementation opens one schedule-derived pair
/// and delegates to its tail.
pub trait BabyBearFriQueryLayers<const QUERY_HALF: usize, Complete>: BabyBearFriQueryShape {
    fn sample_fri_query(_ complete: Complete) -> FriQueryIndex<1>
    fn open_fri_query_layers(
        _ complete: own Complete,
        _ index: u32,
    ) -> (bool, <Self as BabyBearFriQueryShape>::Query)
}

impl<
    const QUERY_HALF: usize,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
> BabyBearFriQueryLayers<QUERY_HALF, FriProofFold<ROUND, OUTPUT, FriProofEnd<NEXT_ROUND>>>
    for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleDone<NEXT_ROUND>,
>
where
    { ROUND > 0 },
    { ROUND < 100 },
    { NEXT_ROUND == ROUND + 1 },
    { INPUT_LOG == 1 },
    { OUTPUT == 1 },
    { PAIR_WIDTH == 0 },
    { PAIR_DEPTH == 0 },
    QUERY_HALF > 0,
    { (QUERY_HALF & (QUERY_HALF - 1)) == 0 },
    { QUERY_HALF <= 134217728 },
{
    fn sample_fri_query(
        _ complete: FriProofFold<ROUND, OUTPUT, FriProofEnd<NEXT_ROUND>>,
    ) -> FriQueryIndex<1> {
        let challenge = fri_query_challenge<ROUND, 1>(complete.layer.transcript)
        fri_query_index_power_of_two<1, QUERY_HALF>(challenge)
    }

    fn open_fri_query_layers(
        _ complete: own FriProofFold<ROUND, OUTPUT, FriProofEnd<NEXT_ROUND>>,
        _ index: u32,
    ) -> (bool, FriQueryEnd<ROUND>) {
        if !complete.valid
            || !complete.layer.valid
            || !complete.layer.root.valid
            || !complete.layer.transcript.valid
            || index != 0 {
            return (false, <Self as BabyBearFriQueryShape>::invalid_fri_query())
        }
        (
            true,
            FriQueryEnd {
                valid: true,
                root: complete.layer.root,
                evaluation: complete.layer.evaluations[0],
            },
        )
    }
}

impl<
    const QUERY_HALF: usize,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    Rest,
    TailComplete,
> BabyBearFriQueryLayers<
    QUERY_HALF,
    FriProofFold<ROUND, OUTPUT, TailComplete>,
> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    { ROUND > 0 },
    { ROUND < 100 },
    { INPUT_LOG > 1 },
    OUTPUT > 1,
    OUTPUT <= MAX_PADDED_TRACE_LENGTH,
    PAIR_WIDTH > 0,
    { PAIR_WIDTH + PAIR_WIDTH == OUTPUT },
    { PAIR_DEPTH + 2 == INPUT_LOG },
    { NEXT_ROUND == ROUND + 1 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriQueryLayers<QUERY_HALF, TailComplete>,
{
    fn sample_fri_query(
        _ complete: FriProofFold<ROUND, OUTPUT, TailComplete>,
    ) -> FriQueryIndex<1> {
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriQueryLayers<QUERY_HALF, TailComplete>>::sample_fri_query(complete.tail)
    }

    fn open_fri_query_layers(
        _ complete: own FriProofFold<ROUND, OUTPUT, TailComplete>,
        _ index: u32,
    ) -> (
        bool,
        FriQueryFold<
            ROUND,
            PAIR_DEPTH,
            <FriScheduleFold<
                NEXT_ROUND,
                NEXT_INPUT_LOG,
                NEXT_OUTPUT,
                NEXT_PAIR_WIDTH,
                NEXT_PAIR_DEPTH,
                Rest,
            > as BabyBearFriQueryShape>::Query,
        >,
    ) {
        let half: u32 = PAIR_WIDTH.downcast_truncate()
        let output: u32 = OUTPUT.downcast_truncate()
        if !complete.valid
            || !complete.layer.valid
            || !complete.layer.root.valid
            || !complete.layer.transcript.valid
            || index >= output {
            return (false, <Self as BabyBearFriQueryShape>::invalid_fri_query())
        }
        let pair_index = index & (half - 1)
        let path = fri_layer_pair_path_power_of_two<
            ROUND,
            OUTPUT,
            PAIR_WIDTH,
            PAIR_DEPTH,
        >(complete.layer.evaluations, pair_index)
        if !path.valid {
            return (false, <Self as BabyBearFriQueryShape>::invalid_fri_query())
        }
        let position: usize = pair_index as usize
        let tail = <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriQueryLayers<QUERY_HALF, TailComplete>>::open_fri_query_layers(
            complete.tail,
            pair_index,
        )
        if !tail.0 {
            return (false, <Self as BabyBearFriQueryShape>::invalid_fri_query())
        }
        (
            true,
            FriQueryFold {
                valid: true,
                root: complete.layer.root,
                pair: FriQueryPair {
                    positive: complete.layer.evaluations[position],
                    negative: complete.layer.evaluations[position + PAIR_WIDTH],
                    path: path,
                },
                tail: tail.1,
            },
        )
    }
}

/// One authenticated transcript-selected query through a 16-to-1 FRI chain.
/// The earlier AIR layer supplies `AirLdeTranscriptDigest`; this receipt does
/// not retain the full composition or folded codewords.
pub struct FriCommitmentQuery<const COMPOSITION_DEPTH: usize, Layers> {
    pub valid: bool,
    pub composition_root: CompositionDigest,
    pub query_index: u32,
    pub composition: CompositionQueryPair<COMPOSITION_DEPTH>,
    pub layers: Layers,
}
impl<const COMPOSITION_DEPTH: usize, Layers: core::marker::Copy> core::marker::Copy
    for FriCommitmentQuery<COMPOSITION_DEPTH, Layers> {}

const fn fri_composition_query_depth(_ input_log: usize) -> usize {
    if input_log == 0 { 0 } else { input_log - 1 }
}

pub type CheckpointFriQueryLayers16 =
    <FriSchedule<1, 4> as BabyBearFriQueryShape>::Query
pub type FriCommitmentQuery16 =
    FriCommitmentQuery<{fri_composition_query_depth(4)}, CheckpointFriQueryLayers16>

struct DigestNodeHasher {}
impl TwoToOneHasher<Poseidon2Digest> for DigestNodeHasher {
    fn zero() -> Poseidon2Digest { Poseidon2Digest::zero() }
    fn equal(_ left: Poseidon2Digest, _ right: Poseidon2Digest) -> bool { left.equals(right) }
    fn hash2(_ left: Poseidon2Digest, _ right: Poseidon2Digest) -> Poseidon2Digest {
        poseidon_compress(left, right)
    }
}

pub fn encoded_row_fields(
    _ row: own EncodedProofRow,
) -> PackedFieldBits<BabyBearModulus, ROW_FIELDS> {
    pack_bounded_words<BabyBearModulus, 17, ROW_FIELDS>(
        encoded_proof_row_words(row),
        ENCODED_PROOF_ROW_WIDTHS,
    )
}

pub fn encoded_public_fields(
    _ public: own EscapesByQ12Public,
) -> PackedFieldBits<BabyBearModulus, PUBLIC_FIELDS> {
    pack_bounded_words<BabyBearModulus, ESCAPES_BY_Q12_PUBLIC_WORDS, PUBLIC_FIELDS>(
        escapes_by_q12_public_words(public),
        ESCAPES_BY_Q12_PUBLIC_WIDTHS,
    )
}

pub fn encoded_auxiliary_fields(
    _ row: own EncodedProofRow,
) -> PackedFieldBits<BabyBearModulus, AUXILIARY_FIELDS> {
    let main = encoded_row_fields(row)
    if !main.is_valid() {
        return PackedFieldBits<BabyBearModulus, AUXILIARY_FIELDS>::empty().require(false)
    }
    let ranged = derive_ranged_air_row(row.air)
    let mut packed = PackedFieldBits<BabyBearModulus, AUXILIARY_FIELDS>::empty()
    let mut index: usize = 0
    while index < AUXILIARY_ROW_BITS {
        packed = packed.append(encoded_ranged_auxiliary_row_bit(ranged, index), 1)
        index = index + 1
    }
    packed
}

fn row_digest(_ digest: PackedCommitment) -> RowDigest {
    RowDigest { valid: digest.is_valid(), value: digest.digest() }
}

fn public_digest(_ digest: PackedCommitment) -> PublicDigest {
    PublicDigest { valid: digest.is_valid(), value: digest.digest() }
}

fn auxiliary_digest(_ digest: PackedCommitment) -> AuxiliaryDigest {
    AuxiliaryDigest { valid: digest.is_valid(), value: digest.digest() }
}

pub fn row_commitment(_ row: own EncodedProofRow) -> RowDigest {
    row_digest(commit_packed<MandelbrotRowBabyBearV1, ROW_FIELDS>(
        encoded_row_fields(row),
    ))
}

pub fn public_commitment(_ public: own EscapesByQ12Public) -> PublicDigest {
    public_digest(commit_packed<MandelbrotPublicBabyBearV1, PUBLIC_FIELDS>(
        encoded_public_fields(public),
    ))
}

pub fn auxiliary_commitment(_ row: own EncodedProofRow) -> AuxiliaryDigest {
    auxiliary_digest(commit_packed<MandelbrotAuxiliaryBabyBearV1, AUXILIARY_FIELDS>(
        encoded_auxiliary_fields(row),
    ))
}

fn digest_root_power_of_two<const N: usize>(
    _ leaves: own [Poseidon2Digest; N],
) -> MerkleRoot<Poseidon2Digest>
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut frontier = empty_frontier<Poseidon2Digest, DigestNodeHasher, TRACE_FRONTIER_LEVELS>()
    let mut index: usize = 0
    while index < N {
        frontier = push_frontier<Poseidon2Digest, DigestNodeHasher, TRACE_FRONTIER_LEVELS>(
            frontier,
            leaves[index],
        )
        index = index + 1
    }
    complete_frontier_root<Poseidon2Digest, DigestNodeHasher, TRACE_FRONTIER_LEVELS>(frontier)
}

/// Commit a complete power-of-two main trace through the reusable zk-kit
/// Merkle shape. Invalid leaf encodings fail closed before entering the tree.
pub fn trace_root_power_of_two<const N: usize>(
    _ leaves: own [RowDigest; N],
) -> RowDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return RowDigest { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    RowDigest { valid: root.valid, value: root.value }
}

/// Commit a complete power-of-two auxiliary trace while sharing the exact
/// same field-generic tree algorithm.
pub fn auxiliary_root_power_of_two<const N: usize>(
    _ leaves: own [AuxiliaryDigest; N],
) -> AuxiliaryDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return AuxiliaryDigest { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    AuxiliaryDigest { valid: root.valid, value: root.value }
}

/// Bind the public claim and trace root as typed field elements.
pub fn bind_statement(
    _ public: own PublicDigest,
    _ trace: own RowDigest,
) -> StatementDigest {
    if !public.valid || !trace.valid {
        return StatementDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    StatementDigest {
        valid: true,
        value: poseidon_bind<MandelbrotStatementBabyBearV1>(public.value, trace.value),
    }
}

/// Bind the auxiliary trace root into the proof transcript.
pub fn bind_auxiliary_trace(
    _ statement: own StatementDigest,
    _ auxiliary: own AuxiliaryDigest,
) -> ProofTranscriptDigest {
    if !statement.valid || !auxiliary.valid {
        return ProofTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    ProofTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotProofTranscriptBabyBearV1>(
            statement.value,
            auxiliary.value,
        ),
    }
}

/// Derive a soundness challenge in the quartic extension field rather than
/// silently treating the u32-native base field as the challenge field.
pub fn composition_challenge(
    _ transcript: own AirLdeTranscriptDigest,
) -> CompositionChallenge {
    if !transcript.valid {
        return CompositionChallenge { valid: false, value: BabyBearExt4::zero() }
    }
    CompositionChallenge {
        valid: true,
        value: squeeze_ext4<MandelbrotCompositionChallengeBabyBearV1>(
            transcript.value,
        ),
    }
}

pub fn main_lde_row_commitment(
    _ values: own [BabyBear; MAIN_LDE_ROW_FIELDS],
) -> MainLdeDigest {
    MainLdeDigest {
        valid: true,
        value: commit_fields<MandelbrotMainLdeRowBabyBearV1, MAIN_LDE_ROW_FIELDS>(values),
    }
}

pub fn auxiliary_lde_row_commitment(
    _ values: own [BabyBear; AUXILIARY_ROW_BITS],
) -> AuxiliaryLdeDigest {
    AuxiliaryLdeDigest {
        valid: true,
        value: commit_fields<MandelbrotAuxiliaryLdeRowBabyBearV1, AUXILIARY_ROW_BITS>(values),
    }
}

pub fn composition_row_commitment(_ value: BabyBearExt4) -> CompositionDigest {
    CompositionDigest {
        valid: true,
        value: commit_ext4_fields<MandelbrotCompositionRowBabyBearV1, 1>([value]),
    }
}

pub fn main_lde_root_power_of_two<const N: usize>(
    _ leaves: own [MainLdeDigest; N],
) -> MainLdeDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return MainLdeDigest { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    MainLdeDigest { valid: root.valid, value: root.value }
}

pub fn auxiliary_lde_root_power_of_two<const N: usize>(
    _ leaves: own [AuxiliaryLdeDigest; N],
) -> AuxiliaryLdeDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return AuxiliaryLdeDigest { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    AuxiliaryLdeDigest { valid: root.valid, value: root.value }
}

fn invalid_lde_quartet_path<Role, const DEPTH: usize>() -> LdeQuartetPath<Role, DEPTH> {
    LdeQuartetPath<Role, DEPTH> {
        valid: false,
        index: 0,
        first_siblings: [Poseidon2Digest::zero(); DEPTH],
        second_siblings: [Poseidon2Digest::zero(); DEPTH],
        third_siblings: [Poseidon2Digest::zero(); DEPTH],
        fourth_siblings: [Poseidon2Digest::zero(); DEPTH],
    }
}

pub fn main_lde_quartet_path_power_of_two<
    const N: usize,
    const QUARTER: usize,
    const DEPTH: usize,
>(
    _ leaves: own [MainLdeDigest; N],
    _ index: u32,
) -> MainLdeQuartetPath<DEPTH>
where
    N > 3,
    N <= MAX_PADDED_TRACE_LENGTH,
    QUARTER > 0,
    { QUARTER + QUARTER + QUARTER + QUARTER == N },
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        if !leaves[cursor].valid {
            return invalid_lde_quartet_path<MainLdeTreeRole, DEPTH>()
        }
        raw[cursor] = leaves[cursor].value
        cursor = cursor + 1
    }
    let path = quartet_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        QUARTER,
        DEPTH,
    >(raw, index)
    LdeQuartetPath<MainLdeTreeRole, DEPTH> {
        valid: path.valid,
        index: path.index,
        first_siblings: path.first_siblings,
        second_siblings: path.second_siblings,
        third_siblings: path.third_siblings,
        fourth_siblings: path.fourth_siblings,
    }
}

pub fn auxiliary_lde_quartet_path_power_of_two<
    const N: usize,
    const QUARTER: usize,
    const DEPTH: usize,
>(
    _ leaves: own [AuxiliaryLdeDigest; N],
    _ index: u32,
) -> AuxiliaryLdeQuartetPath<DEPTH>
where
    N > 3,
    N <= MAX_PADDED_TRACE_LENGTH,
    QUARTER > 0,
    { QUARTER + QUARTER + QUARTER + QUARTER == N },
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        if !leaves[cursor].valid {
            return invalid_lde_quartet_path<AuxiliaryLdeTreeRole, DEPTH>()
        }
        raw[cursor] = leaves[cursor].value
        cursor = cursor + 1
    }
    let path = quartet_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        QUARTER,
        DEPTH,
    >(raw, index)
    LdeQuartetPath<AuxiliaryLdeTreeRole, DEPTH> {
        valid: path.valid,
        index: path.index,
        first_siblings: path.first_siblings,
        second_siblings: path.second_siblings,
        third_siblings: path.third_siblings,
        fourth_siblings: path.fourth_siblings,
    }
}

pub fn verify_main_lde_quartet_path<const DEPTH: usize>(
    _ first: own MainLdeDigest,
    _ second: own MainLdeDigest,
    _ third: own MainLdeDigest,
    _ fourth: own MainLdeDigest,
    _ path: own MainLdeQuartetPath<DEPTH>,
    _ root: own MainLdeDigest,
) -> bool {
    if !first.valid || !second.valid || !third.valid || !fourth.valid
        || !path.valid || !root.valid {
        return false
    }
    quartet_verify<Poseidon2Digest, DigestNodeHasher, DEPTH>(
        root.value,
        first.value,
        second.value,
        third.value,
        fourth.value,
        MerkleQuartetPath<Poseidon2Digest, DEPTH> {
            valid: path.valid,
            index: path.index,
            first_siblings: path.first_siblings,
            second_siblings: path.second_siblings,
            third_siblings: path.third_siblings,
            fourth_siblings: path.fourth_siblings,
        },
    )
}

pub fn verify_auxiliary_lde_quartet_path<const DEPTH: usize>(
    _ first: own AuxiliaryLdeDigest,
    _ second: own AuxiliaryLdeDigest,
    _ third: own AuxiliaryLdeDigest,
    _ fourth: own AuxiliaryLdeDigest,
    _ path: own AuxiliaryLdeQuartetPath<DEPTH>,
    _ root: own AuxiliaryLdeDigest,
) -> bool {
    if !first.valid || !second.valid || !third.valid || !fourth.valid
        || !path.valid || !root.valid {
        return false
    }
    quartet_verify<Poseidon2Digest, DigestNodeHasher, DEPTH>(
        root.value,
        first.value,
        second.value,
        third.value,
        fourth.value,
        MerkleQuartetPath<Poseidon2Digest, DEPTH> {
            valid: path.valid,
            index: path.index,
            first_siblings: path.first_siblings,
            second_siblings: path.second_siblings,
            third_siblings: path.third_siblings,
            fourth_siblings: path.fourth_siblings,
        },
    )
}

fn lde_point<const LDE: usize>(
    _ evaluation: u32,
    _ shift: BabyBear,
) -> CompositionValue<BabyBear>
where LDE > 1, { (LDE & (LDE - 1)) == 0 },
{
    let one = BabyBear::one()
    let lde: u32 = LDE.downcast_truncate()
    if evaluation >= lde || shift.is_zero() || (shift.pow_u32(lde) - one).is_zero() {
        return CompositionValue<BabyBear> { valid: false, value: BabyBear::zero() }
    }
    CompositionValue<BabyBear> {
        valid: true,
        value: shift * BabyBear::two_adic_root(radix2_log<LDE>()).pow_u32(evaluation),
    }
}

/// Recompute one BabyBear composition value from authenticated current and
/// next LDE rows. The base-field opening is embedded into the quartic field at
/// the shared AIR boundary; no BabyBear-specific constraint body exists.
pub fn evaluate_composition_opened<const TRACE: usize, const LDE: usize>(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ challenge: CompositionChallenge,
    _ shift: BabyBear,
    _ evaluation: u32,
    _ row: ref AirLdeRow,
    _ next: ref AirLdeRow,
) -> CompositionValue<BabyBearExt4>
where
    TRACE > 1,
    LDE > TRACE,
    { (TRACE & (TRACE - 1)) == 0 },
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
{
    let point = lde_point<LDE>(evaluation, shift)
    if !challenge.valid || !point.valid {
        return CompositionValue<BabyBearExt4> {
            valid: false,
            value: BabyBearExt4::zero(),
        }
    }
    let c_re = encode_signed_word(c_re_q12)
    let c_im = encode_signed_word(c_im_q12)
    let numerators = constraint_numerators<BabyBearExt4, AirLdeRow, AirLdeRow>(
        challenge.value,
        signed_air_value<BabyBearExt4>(
            BabyBearExt4::from_base(BabyBear::from_u32(c_re.sign)),
            BabyBearExt4::from_base(BabyBear::from_u32(c_re.magnitude)),
        ),
        signed_air_value<BabyBearExt4>(
            BabyBearExt4::from_base(BabyBear::from_u32(c_im.sign)),
            BabyBearExt4::from_base(BabyBear::from_u32(c_im.magnitude)),
        ),
        row,
        next,
    )
    composition_value<BabyBearExt4, TRACE>(BabyBearExt4::from_base(point.value), numerators)
}

/// Authenticate the four base-field LDE rows selected by one FRI query, then
/// bind shared-AIR recomputation at `x` and `-x` to the opened composition
/// pair. This is the verifier seam between the typed LDE quartet and FRI
/// receipt; it retains neither complete tree nor complete codeword.
pub fn verify_checkpoint4_air_lde_composition_query<
    const LDE: usize,
    const QUARTER: usize,
    const DEPTH: usize,
>(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ challenge: CompositionChallenge,
    _ shift: BabyBear,
    _ query_index: u32,
    _ opening: ref Checkpoint4AirLdeOpening<DEPTH>,
    _ main_root: MainLdeDigest,
    _ auxiliary_root: AuxiliaryLdeDigest,
    _ positive_composition: BabyBearExt4,
    _ negative_composition: BabyBearExt4,
) -> bool
where
    LDE > 4,
    QUARTER > 0,
    { (LDE & (LDE - 1)) == 0 },
    { QUARTER + QUARTER + QUARTER + QUARTER == LDE },
{
    let geometry = radix2_query_geometry<4, LDE>(query_index)
    if !challenge.valid || !opening.valid || !geometry.valid {
        return false
    }
    if opening.main_path.index != geometry.local_index
        || opening.auxiliary_path.index != geometry.local_index {
        return false
    }

    let first_main = main_lde_row_commitment(opening.rows[0].main)
    let second_main = main_lde_row_commitment(opening.rows[1].main)
    let third_main = main_lde_row_commitment(opening.rows[2].main)
    let fourth_main = main_lde_row_commitment(opening.rows[3].main)
    let first_auxiliary = auxiliary_lde_row_commitment(opening.rows[0].auxiliary)
    let second_auxiliary = auxiliary_lde_row_commitment(opening.rows[1].auxiliary)
    let third_auxiliary = auxiliary_lde_row_commitment(opening.rows[2].auxiliary)
    let fourth_auxiliary = auxiliary_lde_row_commitment(opening.rows[3].auxiliary)
    if !verify_main_lde_quartet_path<DEPTH>(
            first_main,
            second_main,
            third_main,
            fourth_main,
            opening.main_path,
            main_root,
        )
        || !verify_auxiliary_lde_quartet_path<DEPTH>(
            first_auxiliary,
            second_auxiliary,
            third_auxiliary,
            fourth_auxiliary,
            opening.auxiliary_path,
            auxiliary_root,
        ) {
        return false
    }

    let quarter: u32 = QUARTER.downcast_truncate()
    let positive_quarter: usize = (geometry.evaluation / quarter) as usize
    let positive_next_quarter: usize = (geometry.next_evaluation / quarter) as usize
    let negative_quarter: usize = (geometry.negative_evaluation / quarter) as usize
    let negative_next_quarter: usize = (geometry.negative_next_evaluation / quarter) as usize
    let positive = evaluate_composition_opened<4, LDE>(
        c_re_q12,
        c_im_q12,
        challenge,
        shift,
        geometry.evaluation,
        ref opening.rows[positive_quarter],
        ref opening.rows[positive_next_quarter],
    )
    let negative = evaluate_composition_opened<4, LDE>(
        c_re_q12,
        c_im_q12,
        challenge,
        shift,
        geometry.negative_evaluation,
        ref opening.rows[negative_quarter],
        ref opening.rows[negative_next_quarter],
    )
    positive.valid
        && negative.valid
        && (positive.value - positive_composition).is_zero()
        && (negative.value - negative_composition).is_zero()
}

pub fn composition_root_power_of_two<const N: usize>(
    _ leaves: own [CompositionDigest; N],
) -> CompositionDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return CompositionDigest { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    CompositionDigest { valid: root.valid, value: root.value }
}

pub fn composition_pair_path_power_of_two<
    const N: usize,
    const HALF: usize,
    const DEPTH: usize,
>(
    _ evaluations: own [BabyBearExt4; N],
    _ index: u32,
) -> CompositionPairPath<DEPTH>
where
    N > 1,
    N <= MAX_PADDED_TRACE_LENGTH,
    HALF > 0,
    { HALF + HALF == N },
{
    let mut leaves = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        leaves[cursor] = composition_row_commitment(evaluations[cursor]).value
        cursor = cursor + 1
    }
    let raw = pair_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        HALF,
        DEPTH,
    >(leaves, index)
    CompositionPairPath<DEPTH> {
        valid: raw.valid,
        index: raw.index,
        positive_siblings: raw.positive_siblings,
        negative_siblings: raw.negative_siblings,
    }
}

pub fn verify_composition_pair_path<const DEPTH: usize>(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ path: own CompositionPairPath<DEPTH>,
    _ root: own CompositionDigest,
) -> bool {
    if !root.valid || !path.valid { return false }
    pair_verify<Poseidon2Digest, DigestNodeHasher, DEPTH>(
        root.value,
        composition_row_commitment(positive).value,
        composition_row_commitment(negative).value,
        MerklePairPath<Poseidon2Digest, DEPTH> {
            valid: path.valid,
            index: path.index,
            positive_siblings: path.positive_siblings,
            negative_siblings: path.negative_siblings,
        },
    )
}

pub fn bind_main_lde(
    _ transcript: own ProofTranscriptDigest,
    _ main: own MainLdeDigest,
) -> MainLdeTranscriptDigest {
    if !transcript.valid || !main.valid {
        return MainLdeTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    MainLdeTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotMainLdeTranscriptBabyBearV1>(
            transcript.value,
            main.value,
        ),
    }
}

pub fn bind_auxiliary_lde(
    _ transcript: own MainLdeTranscriptDigest,
    _ auxiliary: own AuxiliaryLdeDigest,
) -> AirLdeTranscriptDigest {
    if !transcript.valid || !auxiliary.valid {
        return AirLdeTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    AirLdeTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotAuxiliaryLdeTranscriptBabyBearV1>(
            transcript.value,
            auxiliary.value,
        ),
    }
}

pub fn bind_composition(
    _ transcript: own AirLdeTranscriptDigest,
    _ composition: own CompositionDigest,
) -> CompositionTranscriptDigest {
    if !transcript.valid || !composition.valid {
        return CompositionTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    CompositionTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotCompositionTranscriptBabyBearV1>(
            transcript.value,
            composition.value,
        ),
    }
}

pub fn fri_fold_challenge(
    _ transcript: own CompositionTranscriptDigest,
) -> FriFoldChallenge<1> {
    if !transcript.valid {
        return FriFoldChallenge<1> { valid: false, value: BabyBearExt4::zero() }
    }
    FriFoldChallenge<1> {
        valid: true,
        value: squeeze_ext4<MandelbrotFriFoldBabyBear<1>>(transcript.value),
    }
}

pub fn next_fri_fold_challenge<const PREVIOUS: u32, const ROUND: u32>(
    _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
) -> FriFoldChallenge<ROUND>
where { PREVIOUS > 0 }, { ROUND == PREVIOUS + 1 }, { ROUND < 100 }
{
    if !transcript.valid {
        return FriFoldChallenge<ROUND> { valid: false, value: BabyBearExt4::zero() }
    }
    FriFoldChallenge<ROUND> {
        valid: true,
        value: squeeze_ext4<MandelbrotFriFoldBabyBear<ROUND>>(transcript.value),
    }
}

pub fn fri_query_challenge<const ROUND: u32, const QUERY: u32>(
    _ transcript: own FriLayerTranscriptDigest<ROUND>,
) -> FriQueryChallenge<QUERY>
where { ROUND > 0 }, { ROUND < 100 }, { QUERY > 0 }, { QUERY < 100 }
{
    if !transcript.valid {
        return FriQueryChallenge<QUERY> { valid: false, value: BabyBear::zero() }
    }
    FriQueryChallenge<QUERY> {
        valid: true,
        value: squeeze_ext4<MandelbrotFriQueryBabyBear<QUERY>>(
            transcript.value,
        ).coefficient(0),
    }
}

pub fn fri_query_index_power_of_two<const QUERY: u32, const HALF: usize>(
    _ challenge: own FriQueryChallenge<QUERY>,
) -> FriQueryIndex<QUERY>
where { QUERY > 0 }, { QUERY < 100 }, HALF > 0, { (HALF & (HALF - 1)) == 0 }, { HALF <= 134217728 }
{
    if !challenge.valid {
        return FriQueryIndex<QUERY> { valid: false, value: 0 }
    }
    let half: u32 = HALF.downcast_truncate()
    FriQueryIndex<QUERY> {
        valid: true,
        value: challenge.value.to_u32() & (half - 1),
    }
}

pub fn fri_layer_row_commitment<const ROUND: u32>(
    _ value: BabyBearExt4,
) -> FriLayerDigest<ROUND>
where { ROUND > 0 }, { ROUND < 100 }
{
    FriLayerDigest<ROUND> {
        valid: true,
        value: commit_ext4_fields<MandelbrotFriLayerRowBabyBear<ROUND>, 1>([value]),
    }
}

pub fn fri_layer_root_power_of_two<const ROUND: u32, const N: usize>(
    _ leaves: own [FriLayerDigest<ROUND>; N],
) -> FriLayerDigest<ROUND>
where { ROUND > 0 }, { ROUND < 100 }, N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return FriLayerDigest<ROUND> { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    FriLayerDigest<ROUND> { valid: root.valid, value: root.value }
}

pub fn fri_layer_pair_path_power_of_two<
    const ROUND: u32,
    const N: usize,
    const HALF: usize,
    const DEPTH: usize,
>(
    _ evaluations: own [BabyBearExt4; N],
    _ index: u32,
) -> FriLayerPairPath<ROUND, DEPTH>
where
    { ROUND > 0 },
    { ROUND < 100 },
    N > 1,
    N <= MAX_PADDED_TRACE_LENGTH,
    HALF > 0,
    { HALF + HALF == N },
{
    let mut leaves = [Poseidon2Digest::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        leaves[cursor] = fri_layer_row_commitment<ROUND>(evaluations[cursor]).value
        cursor = cursor + 1
    }
    let raw = pair_path_from_leaves<
        Poseidon2Digest,
        DigestNodeHasher,
        N,
        HALF,
        DEPTH,
    >(leaves, index)
    FriLayerPairPath<ROUND, DEPTH> {
        valid: raw.valid,
        index: raw.index,
        positive_siblings: raw.positive_siblings,
        negative_siblings: raw.negative_siblings,
    }
}

pub fn verify_fri_layer_pair_path<const ROUND: u32, const DEPTH: usize>(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ path: own FriLayerPairPath<ROUND, DEPTH>,
    _ root: own FriLayerDigest<ROUND>,
) -> bool
where { ROUND > 0 }, { ROUND < 100 }
{
    if !root.valid || !path.valid { return false }
    pair_verify<Poseidon2Digest, DigestNodeHasher, DEPTH>(
        root.value,
        fri_layer_row_commitment<ROUND>(positive).value,
        fri_layer_row_commitment<ROUND>(negative).value,
        MerklePairPath<Poseidon2Digest, DEPTH> {
            valid: path.valid,
            index: path.index,
            positive_siblings: path.positive_siblings,
            negative_siblings: path.negative_siblings,
        },
    )
}

pub fn bind_first_fri_layer(
    _ transcript: own CompositionTranscriptDigest,
    _ layer: own FriLayerDigest<1>,
) -> FriLayerTranscriptDigest<1> {
    if !transcript.valid || !layer.valid {
        return FriLayerTranscriptDigest<1> { valid: false, value: Poseidon2Digest::zero() }
    }
    FriLayerTranscriptDigest<1> {
        valid: true,
        value: poseidon_bind<MandelbrotFriLayerTranscriptBabyBear<1>>(
            transcript.value,
            layer.value,
        ),
    }
}

pub fn bind_next_fri_layer<const PREVIOUS: u32, const ROUND: u32>(
    _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
    _ layer: own FriLayerDigest<ROUND>,
) -> FriLayerTranscriptDigest<ROUND>
where { PREVIOUS > 0 }, { ROUND == PREVIOUS + 1 }, { ROUND < 100 }
{
    if !transcript.valid || !layer.valid {
        return FriLayerTranscriptDigest<ROUND> { valid: false, value: Poseidon2Digest::zero() }
    }
    FriLayerTranscriptDigest<ROUND> {
        valid: true,
        value: poseidon_bind<MandelbrotFriLayerTranscriptBabyBear<ROUND>>(
            transcript.value,
            layer.value,
        ),
    }
}

/// One reusable FRI binary fold over the quartic BabyBear challenge field.
/// Evaluations at `x` and `-x` become one evaluation at `x^2`.
pub fn fold_fri_evaluations<const N: usize, const OUT: usize>(
    _ evaluations: own [BabyBearExt4; N],
    _ challenge: BabyBearExt4,
    _ shift: BabyBear,
) -> FriFoldEvaluations<OUT>
where N > 0, N > 1, { (N & (N - 1)) == 0 }, OUT > 0, { OUT + OUT == N }
{
    if shift.is_zero() {
        return FriFoldEvaluations<OUT> {
            valid: false,
            evaluations: [BabyBearExt4::zero(); OUT],
        }
    }
    let inverse_two = BabyBearExt4::from_base(BabyBear::from_u32(2)).inverse_or_zero()
    let root = BabyBear::two_adic_root(radix2_log<N>())
    let mut point = shift
    let mut folded = [BabyBearExt4::zero(); OUT]
    let mut index: usize = 0
    while index < OUT {
        let positive = evaluations[index]
        let negative = evaluations[index + OUT]
        let even = (positive + negative) * inverse_two
        let odd = (positive - negative)
            * inverse_two
            * BabyBearExt4::from_base(point.inverse_or_zero())
        folded[index] = even + challenge * odd
        point = point * root
        index = index + 1
    }
    FriFoldEvaluations<OUT> { valid: true, evaluations: folded }
}

fn invalid_composition_query_pair<const DEPTH: usize>() -> CompositionQueryPair<DEPTH> {
    CompositionQueryPair<DEPTH> {
        positive: BabyBearExt4::zero(),
        negative: BabyBearExt4::zero(),
        path: CompositionPairPath<DEPTH> {
            valid: false,
            index: 0,
            positive_siblings: [Poseidon2Digest::zero(); DEPTH],
            negative_siblings: [Poseidon2Digest::zero(); DEPTH],
        },
    }
}

fn invalid_fri_query_pair<const ROUND: u32, const DEPTH: usize>() -> FriQueryPair<
    ROUND,
    DEPTH,
> {
    FriQueryPair<ROUND, DEPTH> {
        positive: BabyBearExt4::zero(),
        negative: BabyBearExt4::zero(),
        path: FriLayerPairPath<ROUND, DEPTH> {
            valid: false,
            index: 0,
            positive_siblings: [Poseidon2Digest::zero(); DEPTH],
            negative_siblings: [Poseidon2Digest::zero(); DEPTH],
        },
    }
}

fn invalid_fri_query16() -> FriCommitmentQuery16 {
    FriCommitmentQuery16 {
        valid: false,
        composition_root: CompositionDigest { valid: false, value: Poseidon2Digest::zero() },
        query_index: 0,
        composition: invalid_composition_query_pair<3>(),
        layers: <FriSchedule<1, 4> as BabyBearFriQueryShape>::invalid_fri_query(),
    }
}

fn commit_fri_layer<const ROUND: u32, const N: usize>(
    _ evaluations: own [BabyBearExt4; N],
) -> FriLayerDigest<ROUND>
where
    { ROUND > 0 },
    { ROUND < 100 },
    N > 0,
    N <= MAX_PADDED_TRACE_LENGTH,
    { (N & (N - 1)) == 0 },
{
    let mut leaves = [FriLayerDigest<ROUND> {
        valid: false,
        value: Poseidon2Digest::zero(),
    }; N]
    let mut index: usize = 0
    while index < N {
        leaves[index] = fri_layer_row_commitment<ROUND>(evaluations[index])
        index = index + 1
    }
    fri_layer_root_power_of_two<ROUND, N>(leaves)
}

/// Materialize the current authenticated 16-to-1 checkpoint in the
/// schedule-derived carrier. Every next challenge is squeezed only after the
/// preceding folded layer has been committed. Both its type and term-level
/// traversal are interpretations of `FriSchedule<1, 4>`.
pub fn fold_checkpoint_fri16(
    _ evaluations: own [BabyBearExt4; 16],
    _ transcript: own CompositionTranscriptDigest,
    _ shift: BabyBear,
) -> CheckpointFriProof16 {
    fold_fri_schedule<16, FriSchedule<1, 4>>(evaluations, transcript, shift)
}

pub fn open_fri_commitment_query16(
    _ evaluations: own [BabyBearExt4; 16],
    _ air_transcript: own AirLdeTranscriptDigest,
    _ shift: BabyBear,
) -> FriCommitmentQuery16 {
    if !air_transcript.valid || shift.is_zero() {
        return invalid_fri_query16()
    }

    let mut composition_leaves = [CompositionDigest {
        valid: false,
        value: Poseidon2Digest::zero(),
    }; 16]
    let mut cursor: usize = 0
    while cursor < 16 {
        composition_leaves[cursor] = composition_row_commitment(evaluations[cursor])
        cursor = cursor + 1
    }
    let composition_root = composition_root_power_of_two<16>(composition_leaves)
    let composition_transcript = bind_composition(air_transcript, composition_root)
    let complete = fold_checkpoint_fri16(evaluations, composition_transcript, shift)
    if !composition_root.valid || !composition_transcript.valid || !complete.valid {
        return invalid_fri_query16()
    }
    let query = <FriSchedule<1, 4>
        as BabyBearFriQueryLayers<8, CheckpointFriProof16>>::sample_fri_query(complete)
    if !query.valid { return invalid_fri_query16() }

    let composition_path = composition_pair_path_power_of_two<16, 8, 3>(
        evaluations,
        query.value,
    )
    let layers = <FriSchedule<1, 4>
        as BabyBearFriQueryLayers<8, CheckpointFriProof16>>::open_fri_query_layers(
        complete,
        query.value,
    )
    if !composition_path.valid || !layers.0 {
        return invalid_fri_query16()
    }

    let composition_index: usize = query.value as usize
    FriCommitmentQuery16 {
        valid: true,
        composition_root: composition_root,
        query_index: query.value,
        composition: CompositionQueryPair<3> {
            positive: evaluations[composition_index],
            negative: evaluations[composition_index + 8],
            path: composition_path,
        },
        layers: layers.1,
    }
}

fn fold_fri_pair_at<const N: usize>(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ challenge: BabyBearExt4,
    _ shift: BabyBear,
    _ index: u32,
) -> FriFoldEvaluations<1>
where N > 0, N > 1, { (N & (N - 1)) == 0 }
{
    let point = shift * BabyBear::two_adic_root(radix2_log<N>()).pow_u32(index)
    fold_fri_evaluations<2, 1>([positive, negative], challenge, point)
}

/// Verify and replay every layer after the first FRI commitment. The query
/// carrier type is supplied explicitly so method arguments remain ordinary
/// types while the schedule still selects the only valid implementation.
pub trait BabyBearFriQueryVerifyTail<
    const PREVIOUS: u32,
    const INPUT: usize,
    const QUERY_HALF: usize,
    Layers,
> {
    fn sample_fri_query_tail(
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ layers: Layers,
    ) -> FriQueryIndex<1>
    fn verify_fri_query_tail(
        _ positive: BabyBearExt4,
        _ negative: BabyBearExt4,
        _ index: u32,
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ shift: BabyBear,
        _ layers: own Layers,
    ) -> bool
}

impl<
    const PREVIOUS: u32,
    const INPUT: usize,
    const QUERY_HALF: usize,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
> BabyBearFriQueryVerifyTail<PREVIOUS, INPUT, QUERY_HALF, FriQueryEnd<ROUND>>
    for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleDone<NEXT_ROUND>,
>
where
    { PREVIOUS > 0 },
    { ROUND == PREVIOUS + 1 },
    { ROUND < 100 },
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { INPUT_LOG == 1 },
    { OUTPUT == 1 },
    { PAIR_WIDTH == 0 },
    { PAIR_DEPTH == 0 },
    { NEXT_ROUND == ROUND + 1 },
    QUERY_HALF > 0,
    { (QUERY_HALF & (QUERY_HALF - 1)) == 0 },
    { QUERY_HALF <= 134217728 },
{
    fn sample_fri_query_tail(
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ layers: FriQueryEnd<ROUND>,
    ) -> FriQueryIndex<1> {
        if !layers.valid || !layers.root.valid {
            return FriQueryIndex<1> { valid: false, value: 0 }
        }
        let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, layers.root)
        let challenge = fri_query_challenge<ROUND, 1>(next_transcript)
        fri_query_index_power_of_two<1, QUERY_HALF>(challenge)
    }

    fn verify_fri_query_tail(
        _ positive: BabyBearExt4,
        _ negative: BabyBearExt4,
        _ index: u32,
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ shift: BabyBear,
        _ layers: own FriQueryEnd<ROUND>,
    ) -> bool {
        if !transcript.valid
            || shift.is_zero()
            || !layers.valid
            || !layers.root.valid
            || index != 0 {
            return false
        }
        let challenge = next_fri_fold_challenge<PREVIOUS, ROUND>(transcript)
        let folded = fold_fri_pair_at<INPUT>(positive, negative, challenge.value, shift, index)
        let commitment = fri_layer_row_commitment<ROUND>(layers.evaluation)
        let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, layers.root)
        challenge.valid
            && folded.valid
            && commitment.valid
            && next_transcript.valid
            && folded.evaluations[0].equals(layers.evaluation)
            && commitment.value.equals(layers.root.value)
    }
}

impl<
    const PREVIOUS: u32,
    const INPUT: usize,
    const QUERY_HALF: usize,
    const ROUND: u32,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    Rest,
    TailLayers,
> BabyBearFriQueryVerifyTail<
    PREVIOUS,
    INPUT,
    QUERY_HALF,
    FriQueryFold<ROUND, PAIR_DEPTH, TailLayers>,
> for FriScheduleFold<
    ROUND,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    { PREVIOUS > 0 },
    { ROUND == PREVIOUS + 1 },
    { ROUND < 100 },
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { INPUT_LOG > 1 },
    OUTPUT > 1,
    PAIR_WIDTH > 0,
    { PAIR_WIDTH + PAIR_WIDTH == OUTPUT },
    { PAIR_DEPTH + 2 == INPUT_LOG },
    { NEXT_ROUND == ROUND + 1 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriQueryVerifyTail<ROUND, OUTPUT, QUERY_HALF, TailLayers>,
{
    fn sample_fri_query_tail(
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ layers: FriQueryFold<ROUND, PAIR_DEPTH, TailLayers>,
    ) -> FriQueryIndex<1> {
        if !layers.valid || !layers.root.valid {
            return FriQueryIndex<1> { valid: false, value: 0 }
        }
        let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, layers.root)
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriQueryVerifyTail<
            ROUND,
            OUTPUT,
            QUERY_HALF,
            TailLayers,
        >>::sample_fri_query_tail(next_transcript, layers.tail)
    }

    fn verify_fri_query_tail(
        _ positive: BabyBearExt4,
        _ negative: BabyBearExt4,
        _ index: u32,
        _ transcript: own FriLayerTranscriptDigest<PREVIOUS>,
        _ shift: BabyBear,
        _ layers: own FriQueryFold<ROUND, PAIR_DEPTH, TailLayers>,
    ) -> bool {
        let output: u32 = OUTPUT.downcast_truncate()
        let pair_width: u32 = PAIR_WIDTH.downcast_truncate()
        if !transcript.valid
            || shift.is_zero()
            || !layers.valid
            || !layers.root.valid
            || index >= output {
            return false
        }
        let pair_index = index & (pair_width - 1)
        if layers.pair.path.index != pair_index
            || !verify_fri_layer_pair_path<ROUND, PAIR_DEPTH>(
                layers.pair.positive,
                layers.pair.negative,
                layers.pair.path,
                layers.root,
            ) {
            return false
        }
        let challenge = next_fri_fold_challenge<PREVIOUS, ROUND>(transcript)
        let folded = fold_fri_pair_at<INPUT>(positive, negative, challenge.value, shift, index)
        let expected = if index < pair_width {
            layers.pair.positive
        } else {
            layers.pair.negative
        }
        let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, layers.root)
        if !challenge.valid
            || !folded.valid
            || !next_transcript.valid
            || !folded.evaluations[0].equals(expected) {
            return false
        }
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriQueryVerifyTail<
            ROUND,
            OUTPUT,
            QUERY_HALF,
            TailLayers,
        >>::verify_fri_query_tail(
            layers.pair.positive,
            layers.pair.negative,
            pair_index,
            next_transcript,
            shift.square(),
            layers.tail,
        )
    }
}

/// Verify the first schedule node against the composition pair, then delegate
/// the remaining round chain to `BabyBearFriQueryVerifyTail`.
pub trait BabyBearFriQueryVerifyFirst<
    const INPUT: usize,
    const QUERY_HALF: usize,
    const COMPOSITION_DEPTH: usize,
    Layers,
> {
    fn sample_fri_query_from_composition(
        _ transcript: own CompositionTranscriptDigest,
        _ layers: Layers,
    ) -> FriQueryIndex<1>
    fn verify_fri_query_from_composition(
        _ composition: own CompositionQueryPair<COMPOSITION_DEPTH>,
        _ index: u32,
        _ transcript: own CompositionTranscriptDigest,
        _ shift: BabyBear,
        _ layers: own Layers,
    ) -> bool
}

impl<
    const INPUT: usize,
    const QUERY_HALF: usize,
    const COMPOSITION_DEPTH: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
> BabyBearFriQueryVerifyFirst<INPUT, QUERY_HALF, COMPOSITION_DEPTH, FriQueryEnd<1>>
    for FriScheduleFold<1, 1, OUTPUT, PAIR_WIDTH, PAIR_DEPTH, FriScheduleDone<NEXT_ROUND>>
where
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { OUTPUT == 1 },
    { PAIR_WIDTH == 0 },
    { PAIR_DEPTH == 0 },
    { NEXT_ROUND == 2 },
    QUERY_HALF > 0,
    { (QUERY_HALF & (QUERY_HALF - 1)) == 0 },
    { QUERY_HALF <= 134217728 },
{
    fn sample_fri_query_from_composition(
        _ transcript: own CompositionTranscriptDigest,
        _ layers: FriQueryEnd<1>,
    ) -> FriQueryIndex<1> {
        if !layers.valid || !layers.root.valid {
            return FriQueryIndex<1> { valid: false, value: 0 }
        }
        let first_transcript = bind_first_fri_layer(transcript, layers.root)
        let challenge = fri_query_challenge<1, 1>(first_transcript)
        fri_query_index_power_of_two<1, QUERY_HALF>(challenge)
    }

    fn verify_fri_query_from_composition(
        _ composition: own CompositionQueryPair<COMPOSITION_DEPTH>,
        _ index: u32,
        _ transcript: own CompositionTranscriptDigest,
        _ shift: BabyBear,
        _ layers: own FriQueryEnd<1>,
    ) -> bool {
        if !transcript.valid
            || shift.is_zero()
            || !layers.valid
            || !layers.root.valid
            || index != 0 {
            return false
        }
        let challenge = fri_fold_challenge(transcript)
        let folded = fold_fri_pair_at<INPUT>(
            composition.positive,
            composition.negative,
            challenge.value,
            shift,
            index,
        )
        let commitment = fri_layer_row_commitment<1>(layers.evaluation)
        let first_transcript = bind_first_fri_layer(transcript, layers.root)
        challenge.valid
            && folded.valid
            && commitment.valid
            && first_transcript.valid
            && folded.evaluations[0].equals(layers.evaluation)
            && commitment.value.equals(layers.root.value)
    }
}

impl<
    const INPUT: usize,
    const QUERY_HALF: usize,
    const COMPOSITION_DEPTH: usize,
    const INPUT_LOG: usize,
    const OUTPUT: usize,
    const PAIR_WIDTH: usize,
    const PAIR_DEPTH: usize,
    const NEXT_ROUND: u32,
    const NEXT_INPUT_LOG: usize,
    const NEXT_OUTPUT: usize,
    const NEXT_PAIR_WIDTH: usize,
    const NEXT_PAIR_DEPTH: usize,
    Rest,
    TailLayers,
> BabyBearFriQueryVerifyFirst<
    INPUT,
    QUERY_HALF,
    COMPOSITION_DEPTH,
    FriQueryFold<1, PAIR_DEPTH, TailLayers>,
> for FriScheduleFold<
    1,
    INPUT_LOG,
    OUTPUT,
    PAIR_WIDTH,
    PAIR_DEPTH,
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >,
>
where
    INPUT > 0,
    INPUT > 1,
    { (INPUT & (INPUT - 1)) == 0 },
    { OUTPUT + OUTPUT == INPUT },
    { INPUT_LOG > 1 },
    OUTPUT > 1,
    PAIR_WIDTH > 0,
    { PAIR_WIDTH + PAIR_WIDTH == OUTPUT },
    { PAIR_DEPTH + 2 == INPUT_LOG },
    { NEXT_ROUND == 2 },
    { NEXT_INPUT_LOG + 1 == INPUT_LOG },
    { NEXT_OUTPUT + NEXT_OUTPUT == OUTPUT },
    FriScheduleFold<
        NEXT_ROUND,
        NEXT_INPUT_LOG,
        NEXT_OUTPUT,
        NEXT_PAIR_WIDTH,
        NEXT_PAIR_DEPTH,
        Rest,
    >: BabyBearFriQueryVerifyTail<1, OUTPUT, QUERY_HALF, TailLayers>,
{
    fn sample_fri_query_from_composition(
        _ transcript: own CompositionTranscriptDigest,
        _ layers: FriQueryFold<1, PAIR_DEPTH, TailLayers>,
    ) -> FriQueryIndex<1> {
        if !layers.valid || !layers.root.valid {
            return FriQueryIndex<1> { valid: false, value: 0 }
        }
        let first_transcript = bind_first_fri_layer(transcript, layers.root)
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriQueryVerifyTail<
            1,
            OUTPUT,
            QUERY_HALF,
            TailLayers,
        >>::sample_fri_query_tail(first_transcript, layers.tail)
    }

    fn verify_fri_query_from_composition(
        _ composition: own CompositionQueryPair<COMPOSITION_DEPTH>,
        _ index: u32,
        _ transcript: own CompositionTranscriptDigest,
        _ shift: BabyBear,
        _ layers: own FriQueryFold<1, PAIR_DEPTH, TailLayers>,
    ) -> bool {
        let output: u32 = OUTPUT.downcast_truncate()
        let pair_width: u32 = PAIR_WIDTH.downcast_truncate()
        if !transcript.valid
            || shift.is_zero()
            || !layers.valid
            || !layers.root.valid
            || index >= output {
            return false
        }
        let pair_index = index & (pair_width - 1)
        if layers.pair.path.index != pair_index
            || !verify_fri_layer_pair_path<1, PAIR_DEPTH>(
                layers.pair.positive,
                layers.pair.negative,
                layers.pair.path,
                layers.root,
            ) {
            return false
        }
        let challenge = fri_fold_challenge(transcript)
        let folded = fold_fri_pair_at<INPUT>(
            composition.positive,
            composition.negative,
            challenge.value,
            shift,
            index,
        )
        let expected = if index < pair_width {
            layers.pair.positive
        } else {
            layers.pair.negative
        }
        let first_transcript = bind_first_fri_layer(transcript, layers.root)
        if !challenge.valid
            || !folded.valid
            || !first_transcript.valid
            || !folded.evaluations[0].equals(expected) {
            return false
        }
        <FriScheduleFold<
            NEXT_ROUND,
            NEXT_INPUT_LOG,
            NEXT_OUTPUT,
            NEXT_PAIR_WIDTH,
            NEXT_PAIR_DEPTH,
            Rest,
        > as BabyBearFriQueryVerifyTail<
            1,
            OUTPUT,
            QUERY_HALF,
            TailLayers,
        >>::verify_fri_query_tail(
            layers.pair.positive,
            layers.pair.negative,
            pair_index,
            first_transcript,
            shift.square(),
            layers.tail,
        )
    }
}

pub fn verify_fri_commitment_query16(
    _ air_transcript: own AirLdeTranscriptDigest,
    _ shift: BabyBear,
    _ proof: own FriCommitmentQuery16,
) -> bool {
    if !air_transcript.valid
        || shift.is_zero()
        || !proof.valid
        || !proof.composition_root.valid {
        return false
    }

    let composition_transcript = bind_composition(air_transcript, proof.composition_root)
    let query = <FriSchedule<1, 4> as BabyBearFriQueryVerifyFirst<
        16,
        8,
        3,
        CheckpointFriQueryLayers16,
    >>::sample_fri_query_from_composition(composition_transcript, proof.layers)
    if !composition_transcript.valid
        || !query.valid
        || proof.query_index != query.value
        || proof.composition.path.index != query.value
        || !verify_composition_pair_path<3>(
            proof.composition.positive,
            proof.composition.negative,
            proof.composition.path,
            proof.composition_root,
        ) {
        return false
    }
    <FriSchedule<1, 4> as BabyBearFriQueryVerifyFirst<
        16,
        8,
        3,
        CheckpointFriQueryLayers16,
    >>::verify_fri_query_from_composition(
        proof.composition,
        query.value,
        composition_transcript,
        shift,
        proof.layers,
    )
}
