/// A canonical BabyBear AIR and FRI receipt. Main and auxiliary codewords stay
/// in separately branded base-field trees, while the composition and every
/// FRI layer use schedule-derived shared multi-query carriers.
pub struct BabyBearAirFriReceipt<
    const AIR_MAX_LEAVES: usize,
    const AIR_MAX_SIBLINGS: usize,
    Fri,
> {
    pub valid: bool,
    pub main_root: MainLdeDigest,
    pub auxiliary_root: AuxiliaryLdeDigest,
    pub air: AirMultiOpenings<
        MainLdeTreeRole,
        AuxiliaryLdeTreeRole,
        AIR_MAX_LEAVES,
        AIR_MAX_SIBLINGS,
    >,
    pub fri: Fri,
}
