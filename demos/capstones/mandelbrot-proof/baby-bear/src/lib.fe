impl Poseidon2Domain for MandelbrotRowBabyBearV1 {
    const TAG: u32 = protocol_tag("BR01")
}

impl Poseidon2Domain for MandelbrotPublicBabyBearV1 {
    const TAG: u32 = protocol_tag("BP01")
}

impl Poseidon2Domain for MandelbrotAuxiliaryBabyBearV1 {
    const TAG: u32 = protocol_tag("BA01")
}

impl Poseidon2FieldDomain for MandelbrotStatementBabyBearV1 {
    const TAG: u32 = protocol_tag("BS01")
}

