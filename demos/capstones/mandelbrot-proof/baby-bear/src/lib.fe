pub const fn fri_multi_sibling_capacity(
    _ pair_depth: usize,
    _ query_count: usize,
) -> usize {
    (query_count + query_count) * pair_depth
}

pub const fn air_lde_request_capacity(_ query_count: usize) -> usize {
    query_count * 4
}

pub const fn air_lde_sibling_capacity(_ query_count: usize) -> usize {
    air_lde_request_capacity(query_count) * 4
}

/// One shared sparse opening for all transcript queries at a nonterminal FRI
/// layer. Its capacities are derived from the schedule and query count.
