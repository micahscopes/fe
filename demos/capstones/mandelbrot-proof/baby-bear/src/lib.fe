derive CanonicalWords for FriMultiQueryEnd<ROUND> using CanonicalWordsProvider

/// Authenticated values expose one common lookup vocabulary to the fold
/// checker. Merkle verification remains a separate once-per-layer pass.
pub trait Ext4SparseOpening: core::marker::Copy {
    fn sparse_value(ref self, _ index: u32) -> CompositionValue<BabyBearExt4>
}

impl<
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> Ext4SparseOpening for CompositionMultiOpening<MAX_LEAVES, MAX_SIBLINGS> {
    fn sparse_value(ref self, _ index: u32) -> CompositionValue<BabyBearExt4> {
        if !self.valid || !self.path.valid {
            return CompositionValue { valid: false, value: BabyBearExt4::zero() }
        }
        let count: usize = self.path.leaf_count as usize
        if count > MAX_LEAVES {
            return CompositionValue { valid: false, value: BabyBearExt4::zero() }
        }
        let mut cursor: usize = 0
        while cursor < count {
            if self.path.leaf_indices[cursor] == index {
                return CompositionValue { valid: true, value: self.values[cursor] }
            }
            cursor = cursor + 1
        }
        CompositionValue { valid: false, value: BabyBearExt4::zero() }
    }
}

impl<
    const ROUND: u32,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> Ext4SparseOpening for FriLayerMultiOpening<ROUND, MAX_LEAVES, MAX_SIBLINGS> {
    fn sparse_value(ref self, _ index: u32) -> CompositionValue<BabyBearExt4> {
        if !self.valid || !self.path.valid {
            return CompositionValue { valid: false, value: BabyBearExt4::zero() }
        }
        let count: usize = self.path.leaf_count as usize
        if count > MAX_LEAVES {
            return CompositionValue { valid: false, value: BabyBearExt4::zero() }
        }
        let mut cursor: usize = 0
        while cursor < count {
            if self.path.leaf_indices[cursor] == index {
                return CompositionValue { valid: true, value: self.values[cursor] }
            }
            cursor = cursor + 1
        }
        CompositionValue { valid: false, value: BabyBearExt4::zero() }
    }
}

/// Challenge carrier derived from the same FRI schedule as the proof and
/// shared opening carriers.
