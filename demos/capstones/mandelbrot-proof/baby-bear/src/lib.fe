pub struct FriProofComplete16 {
    pub valid: bool,
    pub first: FriRound<1, 8, 2>,
    pub second: FriRound<2, 4, 3>,
    pub third: FriRound<3, 2, 4>,
    pub final_round: FriFinalRound<4>,
}
impl core::marker::Copy for FriProofComplete16 {}

struct DigestNodeHasher {}
impl TwoToOneHasher<Poseidon2Digest> for DigestNodeHasher {
    fn zero() -> Poseidon2Digest { Poseidon2Digest::zero() }
    fn equal(_ left: Poseidon2Digest, _ right: Poseidon2Digest) -> bool { left.equals(right) }
    fn hash2(_ left: Poseidon2Digest, _ right: Poseidon2Digest) -> Poseidon2Digest {
        poseidon_compress(left, right)
    }
}

pub fn encoded_row_fields(
    _ row: own EncodedProofRow,
) -> PackedFieldBits<BabyBearModulus, ROW_FIELDS> {
    pack_bounded_words<BabyBearModulus, 17, ROW_FIELDS>(
        encoded_proof_row_words(row),
        ENCODED_PROOF_ROW_WIDTHS,
    )
}

pub fn encoded_public_fields(
    _ public: own EscapesByQ12Public,
) -> PackedFieldBits<BabyBearModulus, PUBLIC_FIELDS> {
    pack_bounded_words<BabyBearModulus, ESCAPES_BY_Q12_PUBLIC_WORDS, PUBLIC_FIELDS>(
        escapes_by_q12_public_words(public),
        ESCAPES_BY_Q12_PUBLIC_WIDTHS,
    )
}

pub fn encoded_auxiliary_fields(
    _ row: own EncodedProofRow,
) -> PackedFieldBits<BabyBearModulus, AUXILIARY_FIELDS> {
    let main = encoded_row_fields(row)
    if !main.is_valid() {
        return PackedFieldBits<BabyBearModulus, AUXILIARY_FIELDS>::empty().require(false)
    }
    let ranged = derive_ranged_air_row(row.air)
    let mut packed = PackedFieldBits<BabyBearModulus, AUXILIARY_FIELDS>::empty()
    let mut index: usize = 0
    while index < AUXILIARY_ROW_BITS {
        packed = packed.append(encoded_ranged_auxiliary_row_bit(ranged, index), 1)
        index = index + 1
    }
    packed
}

fn row_digest(_ digest: PackedCommitment) -> RowDigest {
    RowDigest { valid: digest.is_valid(), value: digest.digest() }
}

fn public_digest(_ digest: PackedCommitment) -> PublicDigest {
    PublicDigest { valid: digest.is_valid(), value: digest.digest() }
}

fn auxiliary_digest(_ digest: PackedCommitment) -> AuxiliaryDigest {
    AuxiliaryDigest { valid: digest.is_valid(), value: digest.digest() }
}

pub fn row_commitment(_ row: own EncodedProofRow) -> RowDigest {
    row_digest(commit_packed<MandelbrotRowBabyBearV1, ROW_FIELDS>(
        encoded_row_fields(row),
    ))
}

pub fn public_commitment(_ public: own EscapesByQ12Public) -> PublicDigest {
    public_digest(commit_packed<MandelbrotPublicBabyBearV1, PUBLIC_FIELDS>(
        encoded_public_fields(public),
    ))
}

pub fn auxiliary_commitment(_ row: own EncodedProofRow) -> AuxiliaryDigest {
    auxiliary_digest(commit_packed<MandelbrotAuxiliaryBabyBearV1, AUXILIARY_FIELDS>(
        encoded_auxiliary_fields(row),
    ))
}

fn digest_root_power_of_two<const N: usize>(
    _ leaves: own [Poseidon2Digest; N],
) -> MerkleRoot<Poseidon2Digest>
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut frontier = empty_frontier<Poseidon2Digest, DigestNodeHasher, TRACE_FRONTIER_LEVELS>()
    let mut index: usize = 0
    while index < N {
        frontier = push_frontier<Poseidon2Digest, DigestNodeHasher, TRACE_FRONTIER_LEVELS>(
            frontier,
            leaves[index],
        )
        index = index + 1
    }
    complete_frontier_root<Poseidon2Digest, DigestNodeHasher, TRACE_FRONTIER_LEVELS>(frontier)
}

/// Commit a complete power-of-two main trace through the reusable zk-kit
/// Merkle shape. Invalid leaf encodings fail closed before entering the tree.
pub fn trace_root_power_of_two<const N: usize>(
    _ leaves: own [RowDigest; N],
) -> RowDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return RowDigest { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    RowDigest { valid: root.valid, value: root.value }
}

/// Commit a complete power-of-two auxiliary trace while sharing the exact
/// same field-generic tree algorithm.
pub fn auxiliary_root_power_of_two<const N: usize>(
    _ leaves: own [AuxiliaryDigest; N],
) -> AuxiliaryDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut raw = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        if !leaves[index].valid {
            return AuxiliaryDigest { valid: false, value: Poseidon2Digest::zero() }
        }
        raw[index] = leaves[index].value
        index = index + 1
    }
    let root = digest_root_power_of_two<N>(raw)
    AuxiliaryDigest { valid: root.valid, value: root.value }
}

/// Bind the public claim and trace root as typed field elements.
pub fn bind_statement(
    _ public: own PublicDigest,
    _ trace: own RowDigest,
) -> StatementDigest {
    if !public.valid || !trace.valid {
        return StatementDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    StatementDigest {
        valid: true,
        value: poseidon_bind<MandelbrotStatementBabyBearV1>(public.value, trace.value),
    }
}

/// Bind the auxiliary trace root into the proof transcript.
pub fn bind_auxiliary_trace(
    _ statement: own StatementDigest,
    _ auxiliary: own AuxiliaryDigest,
) -> ProofTranscriptDigest {
    if !statement.valid || !auxiliary.valid {
        return ProofTranscriptDigest { valid: false, value: Poseidon2Digest::zero() }
    }
    ProofTranscriptDigest {
        valid: true,
        value: poseidon_bind<MandelbrotProofTranscriptBabyBearV1>(
            statement.value,
            auxiliary.value,
        ),
    }
}

/// Derive a soundness challenge in the quartic extension field rather than
/// silently treating the u32-native base field as the challenge field.
pub fn composition_challenge(
    _ transcript: own AirLdeTranscriptDigest,
) -> CompositionChallenge {
    if !transcript.valid {
        return CompositionChallenge { valid: false, value: BabyBearExt4::zero() }
    }
    CompositionChallenge {
        valid: true,
        value: squeeze_ext4<MandelbrotCompositionChallengeBabyBearV1>(
            transcript.value,
        ),
    }
}

pub fn main_lde_row_commitment(
    _ values: own [BabyBear; MAIN_LDE_ROW_FIELDS],
) -> MainLdeDigest {
    MainLdeDigest {
        valid: true,
        value: commit_fields<MandelbrotMainLdeRowBabyBearV1, MAIN_LDE_ROW_FIELDS>(values),
    }
}

pub fn auxiliary_lde_row_commitment(
    _ values: own [BabyBear; AUXILIARY_ROW_BITS],
