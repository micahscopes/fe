}

struct ProductionSparseFriCommitmentMaterial {
    base_root: SparseBaseLdeDigest<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >,
    interaction_root: SparseInteractionLdeDigest<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >,
    composition_root: CompositionDigest,
}

enum ProductionSparseFriCommitmentBuild {
    Invalid,
    Ready(ProductionSparseFriCommitmentMaterial),
}

/// Materialize one compact production receipt from caller-owned codewords.
/// Trace construction, LDE, and composition remain separately schedulable;
/// this stage binds them, folds FRI, samples once from the terminal
/// transcript, and opens only the derived sparse request sets.
fn build_production_sparse_fri_commitment_material(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ base_codeword: ref SparseBaseAirLdeCodeword<
        {PRODUCTION_LDE_LENGTH},
    >,
    _ interaction_codeword: ref SparseInteractionAirLdeCodeword<
        {PRODUCTION_LDE_LENGTH},
    >,
    _ composition_codeword: ref SparseCompositionAirCodeword<
        {PRODUCTION_LDE_LENGTH},
    >,
    _ shift: BabyBear,
    _ profile: SparseDirectFriTranscriptProfile,
    _ complete: mut ProductionSparseFriProof,
) -> ProductionSparseFriCommitmentBuild
{
    if !base_codeword.valid || !interaction_codeword.valid
        || !composition_codeword.valid || shift.is_zero() {
        return ProductionSparseFriCommitmentBuild::Invalid
    }
    let base_root = sparse_base_lde_root_power_of_two<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(base_codeword)
    let interaction_root = sparse_interaction_lde_root_power_of_two<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(base_root, interaction_codeword)
    let air = bind_sparse_air_lde_transcript<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(
        commit_recursive_leaf_statement(interval),
        base_root,
        interaction_root,
    )
    let composition = bind_sparse_air_security_profile(
        air,
        profile,
    )
    let composition_root = sparse_bound_composition_lde_root_power_of_two<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(composition, composition_codeword)
    let composition_transcript = bind_composition(
        composition.transcript(),
        composition_root.value,
    )
    if !base_root.valid || !interaction_root.valid || !composition.is_valid()
        || !composition_root.valid || !composition_transcript.valid {
        return ProductionSparseFriCommitmentBuild::Invalid
    }

    if !write_production_sparse_fri(
        ref composition_codeword.values,
        composition_transcript,
        shift,
        mut complete,
    ) {
        return ProductionSparseFriCommitmentBuild::Invalid
    }
    ProductionSparseFriCommitmentBuild::Ready(
        ProductionSparseFriCommitmentMaterial {
            base_root: base_root,
            interaction_root: interaction_root,
            composition_root: composition_root.value,
        },
    )
}

/// Materialize the four-query protocol checkpoint retained by the existing
/// exact process-isolated regression gate.
pub fn write_production_sparse_baby_bear_receipt(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ base_codeword: ref SparseBaseAirLdeCodeword<
        {PRODUCTION_LDE_LENGTH},
    >,
    _ interaction_codeword: ref SparseInteractionAirLdeCodeword<
        {PRODUCTION_LDE_LENGTH},
    >,
    _ composition_codeword: ref SparseCompositionAirCodeword<
        {PRODUCTION_LDE_LENGTH},
    >,
    _ shift: BabyBear,
    _ complete: mut ProductionSparseFriProof,
    _ receipt: mut ProductionSparseBabyBearReceipt,
) -> bool {
    receipt.valid = false
    let material = build_production_sparse_fri_commitment_material(
        interval,
        base_codeword,
        interaction_codeword,
        composition_codeword,
        shift,
        production_checkpoint_security_profile(),
        mut complete,
    )
    match material {
        ProductionSparseFriCommitmentBuild::Invalid => false
        ProductionSparseFriCommitmentBuild::Ready(ready) => {
            let sampled = <ProductionSparseFriSchedule
                as BabyBearFriMultiQueryLayers<
                    {PRODUCTION_QUERY_COUNT},
                    {PRODUCTION_LDE_LENGTH / 2},
                    {PRODUCTION_COMPOSITION_MAX_LEAVES},
                    ProductionSparseFriQueryPlan,
                    ProductionSparseFriQuerySamples,
                    ProductionSparseFriProof,
                    ProductionSparseFriLayers,
                >>::sample_fri_multi_queries(ref complete)
            if !sampled.0 { return false }
            if !<ProductionSparseFriSchedule
                as BabyBearFriMultiQueryLayers<
                    {PRODUCTION_QUERY_COUNT},
                    {PRODUCTION_LDE_LENGTH / 2},
                    {PRODUCTION_COMPOSITION_MAX_LEAVES},
                    ProductionSparseFriQueryPlan,
                    ProductionSparseFriQuerySamples,
                    ProductionSparseFriProof,
                    ProductionSparseFriLayers,
                >>::write_fri_multi_query_layers(
                    ref complete,
                    ref sampled.1,
                    mut receipt.fri.layers,
                ) {
                return false
            }
            install_production_checkpoint_receipt(
                base_codeword,
                interaction_codeword,
                composition_codeword,
                ready.base_root,
                ready.interaction_root,
                ready.composition_root,
                ref sampled.1,
                mut receipt,
            )
        }
    }
}

/// Materialize the separately typed policy-sized receipt. Its query count,
/// opening capacities, and transcript profile all descend from the same CTFE
/// security policy.
pub fn write_production_security_sparse_baby_bear_receipt(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ base_codeword: ref SparseBaseAirLdeCodeword<
        {PRODUCTION_LDE_LENGTH},
    >,
    _ interaction_codeword: ref SparseInteractionAirLdeCodeword<
        {PRODUCTION_LDE_LENGTH},
    >,
    _ composition_codeword: ref SparseCompositionAirCodeword<
        {PRODUCTION_LDE_LENGTH},
    >,
    _ shift: BabyBear,
    _ complete: mut ProductionSparseFriProof,
    _ receipt: mut ProductionSecuritySparseBabyBearReceipt,
) -> bool {
    receipt.valid = false
    let material = build_production_sparse_fri_commitment_material(
        interval,
        base_codeword,
        interaction_codeword,
        composition_codeword,
        shift,
        production_recursive_security_profile(),
        mut complete,
    )
    match material {
        ProductionSparseFriCommitmentBuild::Invalid => false
        ProductionSparseFriCommitmentBuild::Ready(ready) => {
            let sampled = <ProductionSparseFriSchedule
                as BabyBearFriMultiQueryLayers<
                    {PRODUCTION_SECURITY_QUERY_COUNT},
                    {PRODUCTION_LDE_LENGTH / 2},
                    {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
                    ProductionSecuritySparseFriQueryPlan,
                    ProductionSecuritySparseFriQuerySamples,
                    ProductionSparseFriProof,
                    ProductionSecuritySparseFriLayers,
                >>::sample_fri_multi_queries(ref complete)
            if !sampled.0 { return false }
            if !<ProductionSparseFriSchedule
                as BabyBearFriMultiQueryLayers<
                    {PRODUCTION_SECURITY_QUERY_COUNT},
                    {PRODUCTION_LDE_LENGTH / 2},
                    {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
                    ProductionSecuritySparseFriQueryPlan,
                    ProductionSecuritySparseFriQuerySamples,
                    ProductionSparseFriProof,
                    ProductionSecuritySparseFriLayers,
                >>::write_fri_multi_query_layers(
                    ref complete,
                    ref sampled.1,
                    mut receipt.fri.layers,
                ) {
                return false
            }
            install_production_security_receipt(
                base_codeword,
                interaction_codeword,
                composition_codeword,
                ready.base_root,
                ready.interaction_root,
                ready.composition_root,
                ref sampled.1,
                mut receipt,
            )
        }
    }
}

fn authenticate_production_sparse_fri(
    _ composition: SparseCompositionTranscriptDigest<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >,
    _ proof: ref ProductionSparseFriQuery,
) -> ProductionSparseFriAuthentication {
    let composition_authenticated = composition.is_valid()
        && proof.valid && proof.composition_root.valid
        && verify_composition_multi_opening<
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_COMPOSITION_MAX_LEAVES},
            {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
        >(proof.composition, proof.composition_root)
    let composition_transcript = bind_composition(
        composition.transcript(),
        proof.composition_root,
    )
    let authenticated = <ProductionSparseFriSchedule
        as BabyBearFriMultiAuthenticateFirst<
            {PRODUCTION_LDE_LENGTH / 2},
            ProductionSparseFriQueryPlan,
            ProductionSparseFriQuerySamples,
            ProductionSparseFriLayers,
            ProductionSparseFriChallenges,
        >>::authenticate_fri_multi_first(
            composition_transcript,
            proof.layers,
        )
    let queries = <ProductionSparseFriQueryPlan as BabyBearFriQueryBuffer<
        {PRODUCTION_QUERY_COUNT},
        ProductionSparseFriQuerySamples,
    >>::fri_query_buffer(ref authenticated.1)
    let composition_requests = <ProductionSparseFriQueryPlan
        as BabyBearFriPairRequests<
            {PRODUCTION_LDE_LENGTH / 2},
            {PRODUCTION_COMPOSITION_MAX_LEAVES},
            ProductionSparseFriQuerySamples,
        >>::fri_pair_requests(ref authenticated.1)
    let exact_composition = composition_requests.valid
        && composition_requests.count
            == PRODUCTION_COMPOSITION_MAX_LEAVES.downcast_truncate()
        && multi_path_matches_requests<
            Poseidon2Digest,
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_COMPOSITION_MAX_LEAVES},
            {PRODUCTION_COMPOSITION_MAX_LEAVES},
            {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
        >(ref proof.composition.path, ref composition_requests.indices)
    ProductionSparseFriAuthentication {
        valid: composition_authenticated && composition_transcript.valid
            && authenticated.0 && exact_composition
            && queries.valid
            && queries.count == PRODUCTION_QUERY_COUNT.downcast_truncate(),
        samples: authenticated.1,
        queries: queries,
        challenges: authenticated.2,
    }
}

fn verify_production_sparse_composition_query(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
    _ composition: SparseCompositionTranscriptDigest<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >,
    _ query: u32,
    _ receipt: ref ProductionSparseBabyBearReceipt,
) -> bool {
    let geometry = radix2_query_geometry<
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(query)
    if !geometry.valid { return false }
    let current = sparse_lde_opened_air_row<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_AIR_MAX_LEAVES},
        {PRODUCTION_AIR_MAX_SIBLINGS},
    >(ref receipt.base, ref receipt.interaction, geometry.evaluation)
    let next = sparse_lde_opened_air_row<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_AIR_MAX_LEAVES},
        {PRODUCTION_AIR_MAX_SIBLINGS},
    >(ref receipt.base, ref receipt.interaction, geometry.next_evaluation)
    let negative = sparse_lde_opened_air_row<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_AIR_MAX_LEAVES},
        {PRODUCTION_AIR_MAX_SIBLINGS},
    >(ref receipt.base, ref receipt.interaction, geometry.negative_evaluation)
    let negative_next = sparse_lde_opened_air_row<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_AIR_MAX_LEAVES},
        {PRODUCTION_AIR_MAX_SIBLINGS},
    >(ref receipt.base, ref receipt.interaction, geometry.negative_next_evaluation)
    if !current.0 || !next.0 || !negative.0 || !negative_next.0 {
        return false
    }

    let root = BabyBear::two_adic_root(radix2_log<
        {PRODUCTION_LDE_LENGTH},
    >())
    let point = BabyBearExt4::from_base(
        shift * root.pow_u32(geometry.evaluation),
    )
    let negative_point = BabyBearExt4::from_base(
        shift * root.pow_u32(geometry.negative_evaluation),
    )
    let expected = evaluate_sparse_bound_composition_opened<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(composition, interval, point, ref current.1, ref next.1)
    let expected_negative = evaluate_sparse_bound_composition_opened<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(composition, interval, negative_point, ref negative.1, ref negative_next.1)
    let opened = receipt.fri.composition.sparse_value(geometry.evaluation)
    let opened_negative = receipt.fri.composition.sparse_value(
        geometry.negative_evaluation,
    )
    expected.valid && expected_negative.valid
        && opened.valid && opened_negative.valid
        && expected.value.equals(opened.value)
        && expected_negative.value.equals(opened_negative.value)
}

/// Verify the production 4-limb, 4,096-row, 8,192-point sparse AIR receipt.
/// Every AIR and composition opening must be exactly transcript-selected;
/// each authenticated composition pair is then replayed through the shared
/// sparse AIR and schedule-derived FRI fold interpreters.
pub fn verify_production_sparse_baby_bear_receipt(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
    _ receipt: ref ProductionSparseBabyBearReceipt,
) -> bool {
    if !receipt.valid || shift.is_zero()
        || !receipt.base_root.valid || !receipt.interaction_root.valid
        || !verify_sparse_base_lde_multi_opening<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_SIBLINGS},
        >(ref receipt.base, receipt.base_root)
        || !verify_sparse_interaction_lde_multi_opening<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_SIBLINGS},
        >(ref receipt.interaction, receipt.interaction_root) {
        return false
    }
    let air = bind_sparse_air_lde_transcript<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(
        commit_recursive_leaf_statement(interval),
        receipt.base_root,
        receipt.interaction_root,
    )
    let composition = bind_sparse_air_security_profile(
        air,
        production_checkpoint_security_profile(),
    )
    let authenticated = authenticate_production_sparse_fri(
        composition,
        ref receipt.fri,
    )
    if !composition.is_valid() || !authenticated.valid { return false }

    let air_requests = <ProductionSparseFriQueryPlan
        as BabyBearAirLdeRequests<
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            ProductionSparseFriQuerySamples,
        >>::air_lde_requests(ref authenticated.samples)
    if !air_requests.valid
        || air_requests.count != PRODUCTION_AIR_MAX_LEAVES.downcast_truncate()
        || !multi_path_matches_requests<
            Poseidon2Digest,
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_SIBLINGS},
        >(ref receipt.base.path, ref air_requests.indices)
        || !multi_path_matches_requests<
            Poseidon2Digest,
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_SIBLINGS},
        >(ref receipt.interaction.path, ref air_requests.indices) {
        return false
    }

    let mut cursor: usize = 0
    while cursor < PRODUCTION_QUERY_COUNT {
        let query = authenticated.queries.indices[cursor]
        if !verify_production_sparse_composition_query(
            interval,
            shift,
            composition,
            query,
            receipt,
        ) || !<ProductionSparseFriSchedule as BabyBearFriMultiFoldCheck<
            {PRODUCTION_LDE_LENGTH},
            CompositionMultiOpening<
                {PRODUCTION_COMPOSITION_MAX_LEAVES},
                {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
            >,
            ProductionSparseFriLayers,
            ProductionSparseFriChallenges,
        >>::verify_fri_multi_fold(
            receipt.fri.composition,
            receipt.fri.layers,
            authenticated.challenges,
            query,
            shift,
        ) {
            return false
        }
        cursor = cursor + 1
    }
    true
}

pub struct ProductionSecuritySparseFriAuthentication {
    pub valid: bool,
    pub samples: ProductionSecuritySparseFriQuerySamples,
    pub queries: FriQueryBuffer<{PRODUCTION_SECURITY_QUERY_COUNT}>,
    pub challenges: ProductionSparseFriChallenges,
}
impl core::marker::Copy for ProductionSecuritySparseFriAuthentication {}

fn authenticate_production_security_sparse_fri(
    _ composition: SparseCompositionTranscriptDigest<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >,
    _ proof: ref ProductionSecuritySparseFriQuery,
) -> ProductionSecuritySparseFriAuthentication {
    let composition_authenticated = composition.is_valid()
        && proof.valid && proof.composition_root.valid
        && verify_composition_multi_opening<
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
            {PRODUCTION_SECURITY_COMPOSITION_MAX_SIBLINGS},
        >(proof.composition, proof.composition_root)
    let composition_transcript = bind_composition(
        composition.transcript(),
        proof.composition_root,
    )
    let authenticated = <ProductionSparseFriSchedule
        as BabyBearFriMultiAuthenticateFirst<
            {PRODUCTION_LDE_LENGTH / 2},
            ProductionSecuritySparseFriQueryPlan,
            ProductionSecuritySparseFriQuerySamples,
            ProductionSecuritySparseFriLayers,
            ProductionSparseFriChallenges,
        >>::authenticate_fri_multi_first(
            composition_transcript,
            proof.layers,
        )
    let queries = <ProductionSecuritySparseFriQueryPlan as BabyBearFriQueryBuffer<
        {PRODUCTION_SECURITY_QUERY_COUNT},
        ProductionSecuritySparseFriQuerySamples,
    >>::fri_query_buffer(ref authenticated.1)
    let composition_requests = <ProductionSecuritySparseFriQueryPlan
        as BabyBearFriPairRequests<
            {PRODUCTION_LDE_LENGTH / 2},
            {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
            ProductionSecuritySparseFriQuerySamples,
        >>::fri_pair_requests(ref authenticated.1)
    let exact_composition = composition_requests.valid
        && composition_requests.count
            == PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES.downcast_truncate()
        && multi_path_matches_requests<
            Poseidon2Digest,
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
            {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
            {PRODUCTION_SECURITY_COMPOSITION_MAX_SIBLINGS},
        >(ref proof.composition.path, ref composition_requests.indices)
    ProductionSecuritySparseFriAuthentication {
        valid: composition_authenticated && composition_transcript.valid
            && authenticated.0 && exact_composition
            && queries.valid
            && queries.count == PRODUCTION_SECURITY_QUERY_COUNT.downcast_truncate(),
        samples: authenticated.1,
        queries: queries,
        challenges: authenticated.2,
    }
}

fn verify_production_security_sparse_composition_query(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
    _ composition: SparseCompositionTranscriptDigest<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >,
    _ query: u32,
    _ receipt: ref ProductionSecuritySparseBabyBearReceipt,
) -> bool {
    let geometry = radix2_query_geometry<
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(query)
    if !geometry.valid { return false }
    let current = sparse_lde_opened_air_row<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
        {PRODUCTION_SECURITY_AIR_MAX_SIBLINGS},
    >(ref receipt.base, ref receipt.interaction, geometry.evaluation)
    let next = sparse_lde_opened_air_row<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
        {PRODUCTION_SECURITY_AIR_MAX_SIBLINGS},
    >(ref receipt.base, ref receipt.interaction, geometry.next_evaluation)
    let negative = sparse_lde_opened_air_row<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
        {PRODUCTION_SECURITY_AIR_MAX_SIBLINGS},
    >(ref receipt.base, ref receipt.interaction, geometry.negative_evaluation)
    let negative_next = sparse_lde_opened_air_row<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
        {PRODUCTION_SECURITY_AIR_MAX_SIBLINGS},
    >(ref receipt.base, ref receipt.interaction, geometry.negative_next_evaluation)
    if !current.0 || !next.0 || !negative.0 || !negative_next.0 {
        return false
    }

    let root = BabyBear::two_adic_root(radix2_log<
        {PRODUCTION_LDE_LENGTH},
    >())
    let point = BabyBearExt4::from_base(
        shift * root.pow_u32(geometry.evaluation),
    )
    let negative_point = BabyBearExt4::from_base(
        shift * root.pow_u32(geometry.negative_evaluation),
    )
    let expected = evaluate_sparse_bound_composition_opened<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(composition, interval, point, ref current.1, ref next.1)
    let expected_negative = evaluate_sparse_bound_composition_opened<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(composition, interval, negative_point, ref negative.1, ref negative_next.1)
    let opened = receipt.fri.composition.sparse_value(geometry.evaluation)
    let opened_negative = receipt.fri.composition.sparse_value(
        geometry.negative_evaluation,
    )
    expected.valid && expected_negative.valid
        && opened.valid && opened_negative.valid
        && expected.value.equals(opened.value)
        && expected_negative.value.equals(opened_negative.value)
}

fn execute_production_security_sparse_baby_bear_receipt<
    I: ProductionSecurityVerifierInterpreter,
>(
    _ interpreter: I,
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
    _ receipt: ref ProductionSecuritySparseBabyBearReceipt,
) -> I {
    let mut interpreter = interpreter
    let header_valid = receipt.valid && !shift.is_zero()
        && receipt.base_root.valid && receipt.interaction_root.valid
    interpreter = interpreter.observe(
        ProductionSecurityVerifierTask::ReceiptHeader,
        header_valid,
    ).interpreter
    if !header_valid && !interpreter.continues_after_rejection() {
        return interpreter
    }

    let base_valid = header_valid && verify_sparse_base_lde_multi_opening<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
            {PRODUCTION_SECURITY_AIR_MAX_SIBLINGS},
        >(ref receipt.base, receipt.base_root)
    interpreter = interpreter.observe(
        ProductionSecurityVerifierTask::BaseOpening,
        base_valid,
    ).interpreter
    if !base_valid && !interpreter.continues_after_rejection() {
        return interpreter
    }

    let interaction_valid = header_valid
        && verify_sparse_interaction_lde_multi_opening<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
            {PRODUCTION_SECURITY_AIR_MAX_SIBLINGS},
        >(ref receipt.interaction, receipt.interaction_root)
    interpreter = interpreter.observe(
        ProductionSecurityVerifierTask::InteractionOpening,
        interaction_valid,
    ).interpreter
    if !interaction_valid && !interpreter.continues_after_rejection() {
        return interpreter
    }

    let air = bind_sparse_air_lde_transcript<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(
        commit_recursive_leaf_statement(interval),
        receipt.base_root,
        receipt.interaction_root,
    )
    let composition = bind_sparse_air_security_profile(
        air,
        production_recursive_security_profile(),
    )
    let transcript_valid = base_valid && interaction_valid
        && composition.is_valid()
    interpreter = interpreter.observe(
        ProductionSecurityVerifierTask::SecurityTranscript,
        transcript_valid,
    ).interpreter
    if !transcript_valid && !interpreter.continues_after_rejection() {
        return interpreter
    }

    let authenticated = authenticate_production_security_sparse_fri(
        composition,
        ref receipt.fri,
    )
    let authentication_valid = transcript_valid && authenticated.valid
    interpreter = interpreter.observe(
        ProductionSecurityVerifierTask::FriAuthentication,
        authentication_valid,
    ).interpreter
    if !authentication_valid && !interpreter.continues_after_rejection() {
        return interpreter
    }

    let air_requests = <ProductionSecuritySparseFriQueryPlan
        as BabyBearAirLdeRequests<
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
            ProductionSecuritySparseFriQuerySamples,
        >>::air_lde_requests(ref authenticated.samples)
    let requests_valid = authentication_valid && air_requests.valid
        && air_requests.count
            == PRODUCTION_SECURITY_AIR_MAX_LEAVES.downcast_truncate()
        && multi_path_matches_requests<
            Poseidon2Digest,
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
            {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
            {PRODUCTION_SECURITY_AIR_MAX_SIBLINGS},
        >(ref receipt.base.path, ref air_requests.indices)
        && multi_path_matches_requests<
            Poseidon2Digest,
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
            {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
            {PRODUCTION_SECURITY_AIR_MAX_SIBLINGS},
        >(ref receipt.interaction.path, ref air_requests.indices)
    interpreter = interpreter.observe(
        ProductionSecurityVerifierTask::AirRequestSet,
        requests_valid,
    ).interpreter
    if !requests_valid && !interpreter.continues_after_rejection() {
        return interpreter
    }

    let mut cursor: usize = 0
    while cursor < PRODUCTION_SECURITY_QUERY_COUNT {
        let query = authenticated.queries.indices[cursor]
        let query_valid = requests_valid
            && verify_production_security_sparse_composition_query(
            interval,
            shift,
            composition,
            query,
            receipt,
        ) && <ProductionSparseFriSchedule as BabyBearFriMultiFoldCheck<
            {PRODUCTION_LDE_LENGTH},
            CompositionMultiOpening<
                {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
                {PRODUCTION_SECURITY_COMPOSITION_MAX_SIBLINGS},
            >,
            ProductionSecuritySparseFriLayers,
            ProductionSparseFriChallenges,
        >>::verify_fri_multi_fold(
            receipt.fri.composition,
            receipt.fri.layers,
            authenticated.challenges,
            query,
            shift,
        )
        interpreter = interpreter.observe(
            ProductionSecurityVerifierTask::Query(cursor.downcast_truncate()),
            query_valid,
        ).interpreter
        if !query_valid && !interpreter.continues_after_rejection() {
            return interpreter
        }
        cursor = cursor + 1
    }
    interpreter
}

/// Verify the production 4-limb, 4,096-row, 8,192-point sparse AIR receipt.
/// Every AIR and composition opening must be exactly transcript-selected;
/// each authenticated composition pair is then replayed through the shared
/// sparse AIR and schedule-derived FRI fold interpreters.
pub fn verify_production_security_sparse_baby_bear_receipt(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
    _ receipt: ref ProductionSecuritySparseBabyBearReceipt,
) -> bool {
    execute_production_security_sparse_baby_bear_receipt(
        ProductionSecurityVerifierValueInterpreter::new(),
        interval,
        shift,
        receipt,
    ).finish()
}

/// Record the exact fixed-shape security verifier execution in typed memory.
pub fn production_security_sparse_verifier_trace(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
    _ receipt: ref ProductionSecuritySparseBabyBearReceipt,
) -> ProductionSecurityVerifierTrace {
    execute_production_security_sparse_baby_bear_receipt(
        ProductionSecurityVerifierTraceInterpreter::new(),
        interval,
        shift,
        receipt,
    ).finish()
}

/// Re-execute the authored verifier against an untrusted stored task trace.
pub fn audit_production_security_sparse_verifier_trace(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
    _ receipt: ref ProductionSecuritySparseBabyBearReceipt,
    _ trace: ProductionSecurityVerifierTrace,
) -> ProductionSecurityVerifierTraceAudit {
    execute_production_security_sparse_baby_bear_receipt(
        ProductionSecurityVerifierTraceReplayInterpreter::new(trace),
        interval,
        shift,
        receipt,
    ).finish()
}
