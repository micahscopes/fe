const fn protocol_tag(_ label: String<4>) -> u32 {
    let bytes = label.as_bytes()
    ((bytes[0] as u32) << 24)
        | ((bytes[1] as u32) << 16)
        | ((bytes[2] as u32) << 8)
        | (bytes[3] as u32)
}

struct MandelbrotSparseSecurityProfileBabyBearV1 {}
impl Poseidon2Domain for MandelbrotSparseSecurityProfileBabyBearV1 {
    const TAG: u32 = protocol_tag("SP01")
}

struct MandelbrotSparseSecurityTranscriptBabyBearV1 {}
impl Poseidon2FieldDomain for MandelbrotSparseSecurityTranscriptBabyBearV1 {
    const TAG: u32 = protocol_tag("SP02")
}

/// One canonical sparse AIR and FRI receipt. The base and interaction roots
/// retain their limb, trace, and LDE brands. The nested FRI carrier is an
/// interpretation of `FriSchedule`, not a handwritten round list.
pub struct SparseBabyBearAirFriReceipt<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const AIR_MAX_LEAVES: usize,
    const AIR_MAX_SIBLINGS: usize,
    Fri,
> {
    pub valid: bool,
    pub base_root: SparseBaseLdeDigest<L, TRACE, LDE>,
    pub interaction_root: SparseInteractionLdeDigest<L, TRACE, LDE>,
    pub base: SparseBaseLdeMultiOpening<
        L,
        TRACE,
        LDE,
        AIR_MAX_LEAVES,
        AIR_MAX_SIBLINGS,
    >,
    pub interaction: SparseInteractionLdeMultiOpening<
        L,
        TRACE,
        LDE,
        AIR_MAX_LEAVES,
        AIR_MAX_SIBLINGS,
    >,
    pub fri: Fri,
}
impl<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const AIR_MAX_LEAVES: usize,
    const AIR_MAX_SIBLINGS: usize,
    Fri: core::marker::Copy,
> core::marker::Copy for SparseBabyBearAirFriReceipt<
    L,
    TRACE,
    LDE,
    AIR_MAX_LEAVES,
    AIR_MAX_SIBLINGS,
    Fri,
> {}
derive CanonicalWordStream for SparseBabyBearAirFriReceipt<
    L,
    TRACE,
    LDE,
    AIR_MAX_LEAVES,
    AIR_MAX_SIBLINGS,
    Fri,
> using CanonicalWordStreamProvider

pub const PRODUCTION_LIMBS: usize = 4
pub const PRODUCTION_TRACE_LENGTH: usize = 4096
pub const PRODUCTION_LDE_LENGTH: usize = 8192
pub const PRODUCTION_LDE_LOG: usize = 13
pub const PRODUCTION_TRACE_LENGTH_U32: u32 =
    PRODUCTION_TRACE_LENGTH.downcast_truncate()
pub const PRODUCTION_LDE_LENGTH_U32: u32 =
    PRODUCTION_LDE_LENGTH.downcast_truncate()
/// Protocol-shape checkpoint only. A later audited soundness policy must
/// derive the security-bearing query count before recursive proving.
pub const PRODUCTION_QUERY_COUNT: usize = 4
pub const PRODUCTION_SECURITY_TARGET_BITS: u32 = 100
pub const PRODUCTION_SECURITY_MAX_COMPOSED_PROOFS: u32 = 1024
pub const PRODUCTION_SECURITY_EXTENSION_DEGREE: u32 = 4
pub const PRODUCTION_SECURITY_FOLDING_ARITY: u32 = 2
pub const PRODUCTION_SECURITY_AIR_CONSTRAINT_CAP: u32 = 8192
pub const PRODUCTION_SECURITY_HASH_COLLISION_BITS: u32 = 128
pub const PRODUCTION_SECURITY_QUERY_POW_BITS: u32 = 0
pub const PRODUCTION_SECURITY_COMMIT_POW_BITS: u32 = 0

/// Security-affecting transcript data, including the exact structural shape
/// produced by the AIR evaluator and the query count actually executed by the
/// receipt. A verifier recomputes this value rather than trusting receipt
/// bytes, so a policy cannot claim more queries than the proof opens.
pub struct SparseDirectFriTranscriptProfile {
    pub valid: bool,
    pub policy: DirectFriSecurityPolicy,
    pub air_shape: SparseAirConstraintShape,
    pub executed_queries: u32,
}
impl core::marker::Copy for SparseDirectFriTranscriptProfile {}
derive CanonicalWords for SparseDirectFriTranscriptProfile using CanonicalWordsProvider

pub const SPARSE_SECURITY_PROFILE_WORDS: usize =
    <SparseDirectFriTranscriptProfile as CanonicalWords>::WORDS as usize
pub const SPARSE_SECURITY_PROFILE_FIELDS: usize =
    (SPARSE_SECURITY_PROFILE_WORDS * 32 + 29) / 30

pub struct SparseDirectFriProfileDigest {
    pub valid: bool,
    pub value: Poseidon2Digest,
}
impl core::marker::Copy for SparseDirectFriProfileDigest {}

const fn production_security_policy_for_bound(
    _ target_bits: u32,
    _ max_composed_proofs: u32,
    _ composition_degree_bound: u32,
) -> DirectFriSecurityPolicy {
    derive_conjectured_direct_fri_policy(
        target_bits,
        max_composed_proofs,
        BABY_BEAR_MODULUS,
        PRODUCTION_SECURITY_EXTENSION_DEGREE,
        PRODUCTION_TRACE_LENGTH_U32,
        PRODUCTION_LDE_LENGTH_U32,
        composition_degree_bound,
        PRODUCTION_SECURITY_FOLDING_ARITY,
        PRODUCTION_SECURITY_AIR_CONSTRAINT_CAP,
        PRODUCTION_SECURITY_HASH_COLLISION_BITS,
        PRODUCTION_SECURITY_QUERY_POW_BITS,
        PRODUCTION_SECURITY_COMMIT_POW_BITS,
    )
}

fn production_security_policy(
    _ target_bits: u32,
    _ max_composed_proofs: u32,
) -> DirectFriSecurityPolicy {
    production_security_policy_for_bound(
        target_bits,
        max_composed_proofs,
        sparse_composition_degree_bound(
            sparse_constraint_shape<{PRODUCTION_LIMBS}>(),
            PRODUCTION_TRACE_LENGTH_U32,
        ),
    )
}

/// CTFE-selected production security policy. The runtime profile separately
/// derives the AIR shape from the real evaluator and rejects this policy if
/// that evaluator no longer has the expected degree bound.
pub const PRODUCTION_RECURSIVE_SECURITY_POLICY: DirectFriSecurityPolicy =
    production_security_policy_for_bound(
        PRODUCTION_SECURITY_TARGET_BITS,
        PRODUCTION_SECURITY_MAX_COMPOSED_PROOFS,
        PRODUCTION_TRACE_LENGTH_U32 - 1,
    )

pub fn production_recursive_security_policy() -> DirectFriSecurityPolicy {
    PRODUCTION_RECURSIVE_SECURITY_POLICY
}

/// The already executed four-query receipt is retained as an explicitly
/// low-security protocol-shape checkpoint. It must never carry the recursive
/// 100-bit profile, whose derived query count is larger.
pub fn production_checkpoint_security_policy() -> DirectFriSecurityPolicy {
    production_security_policy(
        3,
        1,
    )
}

fn maximum_u32(_ left: u32, _ right: u32) -> u32 {
    if left > right { left } else { right }
}

fn sparse_air_shape_is_consistent(
    _ shape: SparseAirConstraintShape,
    _ policy: DirectFriSecurityPolicy,
) -> bool {
    shape.valid
        && shape.total == shape.all_rows
            + shape.pair_rows + shape.first_row + shape.last_row
        && shape.all_rows > 0 && shape.pair_rows > 0
        && shape.first_row > 0 && shape.last_row > 0
        && shape.all_rows_degree > 0 && shape.pair_rows_degree > 0
        && shape.first_row_degree > 0 && shape.last_row_degree > 0
        && shape.maximum_degree == maximum_u32(
            maximum_u32(shape.all_rows_degree, shape.pair_rows_degree),
            maximum_u32(shape.first_row_degree, shape.last_row_degree),
        )
        && shape.total <= policy.max_air_constraints
        && sparse_composition_degree_bound(
            shape,
            policy.trace_length,
        ) == policy.composition_degree_bound
}

fn sparse_direct_fri_transcript_profile(
    _ policy: DirectFriSecurityPolicy,
    _ air_shape: SparseAirConstraintShape,
    _ executed_queries: u32,
) -> SparseDirectFriTranscriptProfile {
    let shape_consistent = sparse_air_shape_is_consistent(air_shape, policy)
    let policy_consistent = policy.valid
        && policy.base_modulus == BABY_BEAR_MODULUS
        && policy.extension_degree == PRODUCTION_SECURITY_EXTENSION_DEGREE
        && policy.trace_length == PRODUCTION_TRACE_LENGTH_U32
        && policy.lde_length == PRODUCTION_LDE_LENGTH_U32
        && policy.folding_arity == PRODUCTION_SECURITY_FOLDING_ARITY
        && policy.max_air_constraints == PRODUCTION_SECURITY_AIR_CONSTRAINT_CAP
        && policy.hash_collision_bits
            == PRODUCTION_SECURITY_HASH_COLLISION_BITS
        && policy.query_pow_bits == PRODUCTION_SECURITY_QUERY_POW_BITS
        && policy.commit_pow_bits == PRODUCTION_SECURITY_COMMIT_POW_BITS
        && policy.query_count == executed_queries
    SparseDirectFriTranscriptProfile {
        valid: shape_consistent && policy_consistent,
        policy: policy,
        air_shape: air_shape,
        executed_queries: executed_queries,
    }
}

fn sparse_direct_fri_transcript_profile_is_consistent(
    _ profile: ref SparseDirectFriTranscriptProfile,
) -> bool {
    direct_fri_security_policy_is_derived(profile.policy)
        && profile.executed_queries == profile.policy.query_count
        && sparse_air_shape_is_consistent(profile.air_shape, profile.policy)
}

pub fn production_checkpoint_security_profile()
    -> SparseDirectFriTranscriptProfile {
    sparse_direct_fri_transcript_profile(
        production_checkpoint_security_policy(),
        sparse_constraint_shape<{PRODUCTION_LIMBS}>(),
        PRODUCTION_QUERY_COUNT.downcast_truncate(),
    )
}

pub fn production_recursive_security_profile()
    -> SparseDirectFriTranscriptProfile {
    let policy = production_recursive_security_policy()
    sparse_direct_fri_transcript_profile(
        policy,
        sparse_constraint_shape<{PRODUCTION_LIMBS}>(),
        policy.query_count,
    )
}

pub fn commit_sparse_direct_fri_transcript_profile(
    _ profile: ref SparseDirectFriTranscriptProfile,
) -> SparseDirectFriProfileDigest {
    let commitment = sparse_direct_fri_profile_commitment(profile)
    SparseDirectFriProfileDigest {
        valid: commitment.is_valid(),
        value: commitment.digest(),
    }
}

fn sparse_direct_fri_profile_commitment(
    _ profile: ref SparseDirectFriTranscriptProfile,
) -> PackedCommitment {
    sparse_direct_fri_profile_commitment_plan(
        profile,
        QuadraticValueInterpreter::new(),
    ).commitment()
}

pub const fn sparse_direct_fri_profile_commitment_permutations() -> usize {
    fixed_length_sponge_permutations(SPARSE_SECURITY_PROFILE_FIELDS)
}

pub fn sparse_direct_fri_profile_commitment_plan<
    I: QuadraticPlanInterpreter<BabyBear>,
>(
    _ profile: ref SparseDirectFriTranscriptProfile,
    _ interpreter: I,
) -> Poseidon2CanonicalCommitmentPlan<I> {
    commit_canonical_packed_plan<
        I,
        MandelbrotSparseSecurityProfileBabyBearV1,
        SparseDirectFriTranscriptProfile,
        {SPARSE_SECURITY_PROFILE_WORDS},
        {SPARSE_SECURITY_PROFILE_FIELDS},
    >(interpreter, profile).require(
        profile.valid
            && sparse_direct_fri_transcript_profile_is_consistent(profile),
    )
}

/// Extend an already authenticated AIR transcript with the exact security
/// profile interpreted by this receipt. The profile commitment is nominally
/// separated from all statement, AIR-root, composition, and FRI domains.
pub const fn sparse_air_security_profile_permutations() -> usize {
    sparse_direct_fri_profile_commitment_permutations()
        + BINDING_PERMUTATIONS
}

pub fn bind_sparse_air_security_profile_plan<
    I: QuadraticPlanInterpreter<BabyBear>,
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
    _ profile: SparseDirectFriTranscriptProfile,
    _ interpreter: I,
) -> SparseCompositionTranscriptPlan<I, L, TRACE, LDE> {
    let commitment = sparse_direct_fri_profile_commitment_plan(
        ref profile,
        interpreter,
    )
    bind_sparse_composition_extension_plan<
        I,
        MandelbrotSparseSecurityTranscriptBabyBearV1,
        L,
        TRACE,
        LDE,
    >(air, commitment.commitment(), commitment.interpreter)
}

pub fn bind_sparse_air_security_profile<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
    _ profile: SparseDirectFriTranscriptProfile,
) -> SparseCompositionTranscriptDigest<L, TRACE, LDE> {
    bind_sparse_air_security_profile_plan(
        air,
        profile,
        QuadraticValueInterpreter::new(),
    ).value
}

pub const PRODUCTION_AIR_MAX_LEAVES: usize = PRODUCTION_QUERY_COUNT * 4
pub const PRODUCTION_AIR_MAX_SIBLINGS: usize =
    PRODUCTION_AIR_MAX_LEAVES * PRODUCTION_LDE_LOG
pub const PRODUCTION_COMPOSITION_MAX_LEAVES: usize =
    PRODUCTION_QUERY_COUNT * 2
pub const PRODUCTION_COMPOSITION_MAX_SIBLINGS: usize =
    fri_multi_sibling_capacity(PRODUCTION_LDE_LOG - 1, PRODUCTION_QUERY_COUNT)

pub type ProductionSparseFriSchedule = FriSchedule<1, {PRODUCTION_LDE_LOG}>
pub type ProductionSparseFriLayers =
    <ProductionSparseFriSchedule as BabyBearFriMultiQueryShape<
        {PRODUCTION_QUERY_COUNT},
    >>::Query
pub type ProductionSparseFriQuery = FriMultiCommitmentQuery<
    {PRODUCTION_COMPOSITION_MAX_LEAVES},
    {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
    ProductionSparseFriLayers,
>
pub type ProductionSparseFriQueryPlan = FriQueryPlan<1, {PRODUCTION_QUERY_COUNT}>
pub type ProductionSparseFriQuerySamples =
    <ProductionSparseFriQueryPlan as BabyBearFriQueryPlanShape>::Samples
pub type ProductionSparseFriChallenges =
    <ProductionSparseFriSchedule as BabyBearFriMultiChallengeShape>::Challenges
pub type ProductionSparseFriProof =
    <ProductionSparseFriSchedule as BabyBearFriFirst<
        {PRODUCTION_LDE_LENGTH},
    >>::Proof

fn write_production_sparse_fri(
    _ evaluations: ref [BabyBearExt4; PRODUCTION_LDE_LENGTH],
    _ transcript: mandelbrot_proof_baby_bear::CompositionTranscriptDigest,
    _ shift: BabyBear,
    _ proof: mut ProductionSparseFriProof,
) -> bool {
    write_fri_schedule<
        {PRODUCTION_LDE_LENGTH},
        ProductionSparseFriSchedule,
    >(evaluations, transcript, shift, mut proof)
}
pub type ProductionSparseBabyBearReceipt = SparseBabyBearAirFriReceipt<
    {PRODUCTION_LIMBS},
    {PRODUCTION_TRACE_LENGTH},
    {PRODUCTION_LDE_LENGTH},
    {PRODUCTION_AIR_MAX_LEAVES},
    {PRODUCTION_AIR_MAX_SIBLINGS},
    ProductionSparseFriQuery,
>

pub const PRODUCTION_SECURITY_QUERY_COUNT: usize =
    PRODUCTION_RECURSIVE_SECURITY_POLICY.query_count as usize
pub const PRODUCTION_SECURITY_VERIFIER_TASK_COUNT: usize =
    PRODUCTION_SECURITY_QUERY_COUNT.saturating_add(6)
pub const PRODUCTION_SECURITY_AIR_MAX_LEAVES: usize =
    PRODUCTION_SECURITY_QUERY_COUNT * 4
pub const PRODUCTION_SECURITY_AIR_MAX_SIBLINGS: usize =
    PRODUCTION_SECURITY_AIR_MAX_LEAVES * PRODUCTION_LDE_LOG
pub const PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES: usize =
    PRODUCTION_SECURITY_QUERY_COUNT * 2
pub const PRODUCTION_SECURITY_COMPOSITION_MAX_SIBLINGS: usize =
    fri_multi_sibling_capacity(
        PRODUCTION_LDE_LOG - 1,
        PRODUCTION_SECURITY_QUERY_COUNT,
    )

pub type ProductionSecuritySparseFriLayers =
    <ProductionSparseFriSchedule as BabyBearFriMultiQueryShape<
        {PRODUCTION_SECURITY_QUERY_COUNT},
    >>::Query
pub type ProductionSecuritySparseFriQuery = FriMultiCommitmentQuery<
    {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
    {PRODUCTION_SECURITY_COMPOSITION_MAX_SIBLINGS},
    ProductionSecuritySparseFriLayers,
>
pub type ProductionSecuritySparseFriQueryPlan = FriQueryRangePlan<
    1,
    {PRODUCTION_SECURITY_QUERY_COUNT},
>
pub type ProductionSecuritySparseFriQuerySamples =
    <ProductionSecuritySparseFriQueryPlan as BabyBearFriQueryPlanShape>::Samples
pub type ProductionSecuritySparseBabyBearReceipt = SparseBabyBearAirFriReceipt<
    {PRODUCTION_LIMBS},
    {PRODUCTION_TRACE_LENGTH},
    {PRODUCTION_LDE_LENGTH},
    {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
    {PRODUCTION_SECURITY_AIR_MAX_SIBLINGS},
    ProductionSecuritySparseFriQuery,
>

/// One semantic operation in the security-policy leaf verifier.
///
/// The task graph has six shared predecessors followed by one independently
/// checkable task per transcript-derived query. The query payload is a plan
/// position, not a receipt index or a host-selected operation code. Its actual
/// query index is recovered from the authenticated Fiat-Shamir buffer.
pub enum ProductionSecurityVerifierTask {
    ReceiptHeader,
    BaseOpening,
    InteractionOpening,
    SecurityTranscript,
    FriAuthentication,
    AirRequestSet,
    Query(u32),
    Invalid,
}
impl core::marker::Copy for ProductionSecurityVerifierTask {}

/// Derive the fixed verifier task graph from the security query policy.
pub fn production_security_verifier_task_at(
    _ index: u32,
) -> ProductionSecurityVerifierTask {
    match index {
        0 => ProductionSecurityVerifierTask::ReceiptHeader,
        1 => ProductionSecurityVerifierTask::BaseOpening,
        2 => ProductionSecurityVerifierTask::InteractionOpening,
        3 => ProductionSecurityVerifierTask::SecurityTranscript,
        4 => ProductionSecurityVerifierTask::FriAuthentication,
        5 => ProductionSecurityVerifierTask::AirRequestSet,
        _ => {
            let query = index - 6
            if query < PRODUCTION_SECURITY_QUERY_COUNT.downcast_truncate() {
                ProductionSecurityVerifierTask::Query(query)
            } else {
                ProductionSecurityVerifierTask::Invalid
            }
        }
    }
}

fn production_security_verifier_tasks_equal(
    _ left: ProductionSecurityVerifierTask,
    _ right: ProductionSecurityVerifierTask,
) -> bool {
    match left {
        ProductionSecurityVerifierTask::ReceiptHeader => match right {
            ProductionSecurityVerifierTask::ReceiptHeader => true,
            _ => false,
        },
        ProductionSecurityVerifierTask::BaseOpening => match right {
            ProductionSecurityVerifierTask::BaseOpening => true,
            _ => false,
        },
        ProductionSecurityVerifierTask::InteractionOpening => match right {
            ProductionSecurityVerifierTask::InteractionOpening => true,
            _ => false,
        },
        ProductionSecurityVerifierTask::SecurityTranscript => match right {
            ProductionSecurityVerifierTask::SecurityTranscript => true,
            _ => false,
        },
        ProductionSecurityVerifierTask::FriAuthentication => match right {
            ProductionSecurityVerifierTask::FriAuthentication => true,
            _ => false,
        },
        ProductionSecurityVerifierTask::AirRequestSet => match right {
            ProductionSecurityVerifierTask::AirRequestSet => true,
            _ => false,
        },
        ProductionSecurityVerifierTask::Query(left_query) => match right {
            ProductionSecurityVerifierTask::Query(right_query) => {
                left_query == right_query
            },
            _ => false,
        },
        ProductionSecurityVerifierTask::Invalid => match right {
            ProductionSecurityVerifierTask::Invalid => true,
            _ => false,
        },
    }
}

/// Memory placement of a semantic verifier task. The authored task remains a
/// payload-bearing enum; this projection separates its nominal role from its
/// query position because portable Wasm does not yet load payload enums from
/// aggregate memory.
pub enum ProductionSecurityVerifierTaskKind {
    ReceiptHeader,
    BaseOpening,
    InteractionOpening,
    SecurityTranscript,
    FriAuthentication,
    AirRequestSet,
    Query,
    Invalid,
}
impl core::marker::Copy for ProductionSecurityVerifierTaskKind {}

pub struct ProductionSecurityVerifierTraceTask {
    pub kind: ProductionSecurityVerifierTaskKind,
    pub query_position: u32,
}
impl core::marker::Copy for ProductionSecurityVerifierTraceTask {}

fn production_security_verifier_trace_task(
    _ task: ProductionSecurityVerifierTask,
) -> ProductionSecurityVerifierTraceTask {
    match task {
        ProductionSecurityVerifierTask::ReceiptHeader => {
            ProductionSecurityVerifierTraceTask {
                kind: ProductionSecurityVerifierTaskKind::ReceiptHeader,
                query_position: 0,
            }
        },
        ProductionSecurityVerifierTask::BaseOpening => {
            ProductionSecurityVerifierTraceTask {
                kind: ProductionSecurityVerifierTaskKind::BaseOpening,
                query_position: 0,
            }
        },
        ProductionSecurityVerifierTask::InteractionOpening => {
            ProductionSecurityVerifierTraceTask {
                kind: ProductionSecurityVerifierTaskKind::InteractionOpening,
                query_position: 0,
            }
        },
        ProductionSecurityVerifierTask::SecurityTranscript => {
            ProductionSecurityVerifierTraceTask {
                kind: ProductionSecurityVerifierTaskKind::SecurityTranscript,
                query_position: 0,
            }
        },
        ProductionSecurityVerifierTask::FriAuthentication => {
            ProductionSecurityVerifierTraceTask {
                kind: ProductionSecurityVerifierTaskKind::FriAuthentication,
                query_position: 0,
            }
        },
        ProductionSecurityVerifierTask::AirRequestSet => {
            ProductionSecurityVerifierTraceTask {
                kind: ProductionSecurityVerifierTaskKind::AirRequestSet,
                query_position: 0,
            }
        },
        ProductionSecurityVerifierTask::Query(query) => {
            ProductionSecurityVerifierTraceTask {
                kind: ProductionSecurityVerifierTaskKind::Query,
                query_position: query,
            }
        },
        ProductionSecurityVerifierTask::Invalid => {
            ProductionSecurityVerifierTraceTask {
                kind: ProductionSecurityVerifierTaskKind::Invalid,
                query_position: 0,
            }
        },
    }
}

fn production_security_verifier_task_kinds_equal(
    _ left: ProductionSecurityVerifierTaskKind,
    _ right: ProductionSecurityVerifierTaskKind,
) -> bool {
    match left {
        ProductionSecurityVerifierTaskKind::ReceiptHeader => match right {
            ProductionSecurityVerifierTaskKind::ReceiptHeader => true,
            _ => false,
        },
        ProductionSecurityVerifierTaskKind::BaseOpening => match right {
            ProductionSecurityVerifierTaskKind::BaseOpening => true,
            _ => false,
        },
        ProductionSecurityVerifierTaskKind::InteractionOpening => match right {
            ProductionSecurityVerifierTaskKind::InteractionOpening => true,
            _ => false,
        },
        ProductionSecurityVerifierTaskKind::SecurityTranscript => match right {
            ProductionSecurityVerifierTaskKind::SecurityTranscript => true,
            _ => false,
        },
        ProductionSecurityVerifierTaskKind::FriAuthentication => match right {
            ProductionSecurityVerifierTaskKind::FriAuthentication => true,
            _ => false,
        },
        ProductionSecurityVerifierTaskKind::AirRequestSet => match right {
            ProductionSecurityVerifierTaskKind::AirRequestSet => true,
            _ => false,
        },
        ProductionSecurityVerifierTaskKind::Query => match right {
            ProductionSecurityVerifierTaskKind::Query => true,
            _ => false,
        },
        ProductionSecurityVerifierTaskKind::Invalid => match right {
            ProductionSecurityVerifierTaskKind::Invalid => true,
            _ => false,
        },
    }
}

fn production_security_verifier_trace_tasks_equal(
    _ stored: ProductionSecurityVerifierTraceTask,
    _ live: ProductionSecurityVerifierTask,
) -> bool {
    let expected = production_security_verifier_trace_task(live)
    production_security_verifier_task_kinds_equal(stored.kind, expected.kind)
        && stored.query_position == expected.query_position
}

pub struct ProductionSecurityVerifierStep<
    I: ProductionSecurityVerifierInterpreter,
> {
    pub interpreter: I,
}
impl<I: ProductionSecurityVerifierInterpreter> core::marker::Copy
    for ProductionSecurityVerifierStep<I> {}

/// An interpretation of the exact ordered verifier task graph.
///
/// The value interpretation produces the ordinary boolean verifier result.
/// The stream interpretation writes the same task and result sequence to
/// typed browser memory, and the replay interpretation checks an untrusted
/// stream against a fresh execution of this denotation.
pub trait ProductionSecurityVerifierInterpreter: core::marker::Copy {
    fn observe(
        self,
        _ task: ProductionSecurityVerifierTask,
        _ accepted: bool,
    ) -> ProductionSecurityVerifierStep<Self>

    /// Whether this placement needs the fixed task suffix after a rejection.
    /// Scalar verification short-circuits, while trace and replay placements
    /// retain every row needed by the recursive execution relation.
    fn continues_after_rejection(self) -> bool
}

struct ProductionSecurityVerifierValueInterpreter {
    cursor: u32,
    accepted: bool,
}
impl core::marker::Copy for ProductionSecurityVerifierValueInterpreter {}

impl ProductionSecurityVerifierValueInterpreter {
    fn new() -> Self {
        Self { cursor: 0, accepted: true }
    }

    fn finish(self) -> bool {
        self.accepted
            && self.cursor
                == PRODUCTION_SECURITY_VERIFIER_TASK_COUNT.downcast_truncate()
    }
}

impl ProductionSecurityVerifierInterpreter
    for ProductionSecurityVerifierValueInterpreter {
    fn observe(
        self,
        _ task: ProductionSecurityVerifierTask,
        _ accepted: bool,
    ) -> ProductionSecurityVerifierStep<Self> {
        ProductionSecurityVerifierStep {
            interpreter: Self {
                cursor: self.cursor + 1,
                accepted: self.accepted && accepted,
            },
        }
    }

    fn continues_after_rejection(self) -> bool { false }
}

pub struct ProductionSecurityVerifierTraceRow {
    pub task: ProductionSecurityVerifierTraceTask,
    pub accepted: bool,
}
impl core::marker::Copy for ProductionSecurityVerifierTraceRow {}

/// Canonical header for an untrusted verifier execution trace. The version is
/// a protocol boundary; the task count remains derived from the active
/// security policy rather than repeated in a host manifest.
pub struct ProductionSecurityVerifierCanonicalTraceHeader {
    pub version: u32,
    pub valid: bool,
    pub task_count: u32,
}
impl core::marker::Copy for ProductionSecurityVerifierCanonicalTraceHeader {}
derive CanonicalWords for ProductionSecurityVerifierCanonicalTraceHeader using CanonicalWordsProvider

/// Canonical row coordinates name positions in the semantic task plan. The
/// task enum itself is recovered by `production_security_verifier_task_at`, so
/// the byte format contains no parallel operation-code table.
pub struct ProductionSecurityVerifierCanonicalTraceRow {
    pub task_position: u32,
    pub accepted: bool,
}
impl core::marker::Copy for ProductionSecurityVerifierCanonicalTraceRow {}
derive CanonicalWords for ProductionSecurityVerifierCanonicalTraceRow using CanonicalWordsProvider

struct ProductionSecurityVerifierTraceArena {
    rows: [ProductionSecurityVerifierTraceRow; PRODUCTION_SECURITY_VERIFIER_TASK_COUNT],
    count: u32,
    shape_valid: bool,
}

fn initialize_production_security_verifier_trace()
uses (arena: mut ProductionSecurityVerifierTraceArena)
{
    arena.count = 0
    arena.shape_valid = false
}

fn write_production_security_verifier_trace_row(
    _ index: u32,
    _ row: ProductionSecurityVerifierTraceRow,
) -> bool
uses (arena: mut ProductionSecurityVerifierTraceArena)
{
    if index >= PRODUCTION_SECURITY_VERIFIER_TASK_COUNT.downcast_truncate()
        || index != arena.count
    {
        arena.shape_valid = false
        return false
    }
    arena.rows[index as usize] = row
    arena.count = index + 1
    true
}

fn finish_production_security_verifier_trace(_ valid: bool)
uses (arena: mut ProductionSecurityVerifierTraceArena)
{
    arena.shape_valid = valid
        && arena.count
            == PRODUCTION_SECURITY_VERIFIER_TASK_COUNT.downcast_truncate()
}

fn production_security_verifier_trace_row(
    _ index: u32,
) -> ProductionSecurityVerifierTraceRow
uses (arena: mut ProductionSecurityVerifierTraceArena)
{
    if index >= arena.count {
        return ProductionSecurityVerifierTraceRow {
            task: production_security_verifier_trace_task(
                ProductionSecurityVerifierTask::Invalid,
            ),
            accepted: false,
        }
    }
    arena.rows[index as usize]
}

fn production_security_verifier_trace_shape_valid() -> bool
uses (arena: mut ProductionSecurityVerifierTraceArena)
{
    arena.shape_valid
        && arena.count
            == PRODUCTION_SECURITY_VERIFIER_TASK_COUNT.downcast_truncate()
}

fn replace_production_security_verifier_trace_row(
    _ index: u32,
    _ row: ProductionSecurityVerifierTraceRow,
) -> bool
uses (arena: mut ProductionSecurityVerifierTraceArena)
{
    if !arena.shape_valid || index >= arena.count { return false }
    arena.rows[index as usize] = row
    true
}

/// Opaque handle to one fixed-shape execution of the policy-sized verifier.
/// The stored booleans are not a recursive proof. They are an untrusted
/// placement witness which must be replayed against the authored verifier and
/// later constrained by the recursive AIR.
pub struct ProductionSecurityVerifierTrace {
    arena: BrowserPtr<ProductionSecurityVerifierTraceArena>,
    available: bool,
}
impl core::marker::Copy for ProductionSecurityVerifierTrace {}

impl ProductionSecurityVerifierTrace {
    pub fn shape_valid(self) -> bool {
        self.available && with (self.arena) {
            production_security_verifier_trace_shape_valid()
        }
    }

    pub fn row(self, _ index: u32) -> ProductionSecurityVerifierTraceRow {
        if !self.available {
            return ProductionSecurityVerifierTraceRow {
                task: production_security_verifier_trace_task(
                    ProductionSecurityVerifierTask::Invalid,
                ),
                accepted: false,
            }
        }
        with (self.arena) {
            production_security_verifier_trace_row(index)
        }
    }

    /// Prove that a stored row occupies its compiler-derived semantic task
    /// position. Recursive relations consume this predicate together with the
    /// row result, so a validly encoded but coherently rewired trace cannot
    /// substitute one verifier stage for another.
    pub fn task_matches(self, _ index: u32) -> bool {
        if !self.shape_valid()
            || index
                >= PRODUCTION_SECURITY_VERIFIER_TASK_COUNT.downcast_truncate()
        {
            return false
        }
        production_security_verifier_trace_tasks_equal(
            self.row(index).task,
            production_security_verifier_task_at(index),
        )
    }

    pub fn replace_row(
        self,
        _ index: u32,
        _ row: ProductionSecurityVerifierTraceRow,
    ) -> bool {
        if !self.available { return false }
        with (self.arena) {
            replace_production_security_verifier_trace_row(index, row)
        }
    }
}

pub struct ProductionSecurityVerifierTraceInterpreter {
    trace: ProductionSecurityVerifierTrace,
    cursor: u32,
    valid: bool,
}
impl core::marker::Copy for ProductionSecurityVerifierTraceInterpreter {}

impl ProductionSecurityVerifierTraceInterpreter {
    pub fn new() -> Self {
        let arena = alloc_browser_object<ProductionSecurityVerifierTraceArena>()
        let available = arena.address() != 0
        let valid = available && with (arena) {
            initialize_production_security_verifier_trace()
            true
        }
        Self {
            trace: ProductionSecurityVerifierTrace {
                arena: arena,
                available: available,
            },
            cursor: 0,
            valid: valid,
        }
    }

    pub fn finish(self) -> ProductionSecurityVerifierTrace {
        let valid = self.valid
            && self.cursor
                == PRODUCTION_SECURITY_VERIFIER_TASK_COUNT.downcast_truncate()
        if self.trace.available {
            with (self.trace.arena) {
                finish_production_security_verifier_trace(valid)
            }
        }
        self.trace
    }
}

impl ProductionSecurityVerifierInterpreter
    for ProductionSecurityVerifierTraceInterpreter {
    fn observe(
        self,
        _ task: ProductionSecurityVerifierTask,
        _ accepted: bool,
    ) -> ProductionSecurityVerifierStep<Self> {
        let expected = production_security_verifier_task_at(self.cursor)
        let task_valid = production_security_verifier_tasks_equal(task, expected)
        let wrote = self.valid && task_valid && self.trace.available
            && with (self.trace.arena) {
                write_production_security_verifier_trace_row(
                    self.cursor,
                    ProductionSecurityVerifierTraceRow {
                        task: production_security_verifier_trace_task(task),
                        accepted: accepted,
                    },
                )
            }
        ProductionSecurityVerifierStep {
            interpreter: Self {
                trace: self.trace,
                cursor: if wrote { self.cursor + 1 } else { self.cursor },
                valid: wrote,
            },
        }
    }

    fn continues_after_rejection(self) -> bool { true }
}

pub struct ProductionSecurityVerifierTraceAudit {
    pub shape_valid: bool,
    pub task_mismatches: u32,
    pub result_mismatches: u32,
    pub rejected_tasks: u32,
}
impl core::marker::Copy for ProductionSecurityVerifierTraceAudit {}

pub struct ProductionSecurityVerifierTraceReplayInterpreter {
    trace: ProductionSecurityVerifierTrace,
    cursor: u32,
    task_mismatches: u32,
    result_mismatches: u32,
    rejected_tasks: u32,
    valid: bool,
}
impl core::marker::Copy for ProductionSecurityVerifierTraceReplayInterpreter {}

impl ProductionSecurityVerifierTraceReplayInterpreter {
    pub fn new(_ trace: ProductionSecurityVerifierTrace) -> Self {
        Self {
            trace: trace,
            cursor: 0,
            task_mismatches: 0,
            result_mismatches: 0,
            rejected_tasks: 0,
            valid: trace.shape_valid(),
        }
    }

    pub fn finish(self) -> ProductionSecurityVerifierTraceAudit {
        ProductionSecurityVerifierTraceAudit {
            shape_valid: self.valid
                && self.cursor
                    == PRODUCTION_SECURITY_VERIFIER_TASK_COUNT.downcast_truncate(),
            task_mismatches: self.task_mismatches,
            result_mismatches: self.result_mismatches,
            rejected_tasks: self.rejected_tasks,
        }
    }
}

impl ProductionSecurityVerifierInterpreter
    for ProductionSecurityVerifierTraceReplayInterpreter {
    fn observe(
        self,
        _ task: ProductionSecurityVerifierTask,
        _ accepted: bool,
    ) -> ProductionSecurityVerifierStep<Self> {
        let mut next = self
        if !next.valid
            || next.cursor
                >= PRODUCTION_SECURITY_VERIFIER_TASK_COUNT.downcast_truncate()
        {
            next.valid = false
            return ProductionSecurityVerifierStep { interpreter: next }
        }
        let stored = next.trace.row(next.cursor)
        if !production_security_verifier_trace_tasks_equal(stored.task, task) {
            next.task_mismatches = next.task_mismatches + 1
        }
        if stored.accepted != accepted {
            next.result_mismatches = next.result_mismatches + 1
        }
        if !accepted { next.rejected_tasks = next.rejected_tasks + 1 }
        next.cursor = next.cursor + 1
        ProductionSecurityVerifierStep { interpreter: next }
    }

    fn continues_after_rejection(self) -> bool { true }
}

fn production_security_verifier_trace_task_position(
    _ stored: ProductionSecurityVerifierTraceTask,
) -> u32 {
    let count: u32 = PRODUCTION_SECURITY_VERIFIER_TASK_COUNT.downcast_truncate()
    let mut position: u32 = 0
    while position < count {
        if production_security_verifier_trace_tasks_equal(
            stored,
            production_security_verifier_task_at(position),
        ) {
            return position
        }
        position = position + 1
    }
    count
}

/// Serialize a fixed-shape verifier execution through the general canonical
/// word interpreter. This is a proof-placement boundary, not host-owned task
/// policy: every semantic task is recovered from its derived plan position.
pub fn encode_production_security_verifier_trace(
    _ trace: ProductionSecurityVerifierTrace,
) -> BrowserBytes {
    let count: u32 = PRODUCTION_SECURITY_VERIFIER_TASK_COUNT.downcast_truncate()
    let header = ProductionSecurityVerifierCanonicalTraceHeader {
        version: 1,
        valid: trace.shape_valid(),
        task_count: count,
    }
    let mut writer = encode_canonical_words(
        ref header,
        BrowserWordWriter::growing(),
    )
    let mut position: u32 = 0
    while position < count {
        let stored = trace.row(position)
        let row = ProductionSecurityVerifierCanonicalTraceRow {
            task_position: production_security_verifier_trace_task_position(
                stored.task,
            ),
            accepted: stored.accepted,
        }
        writer = encode_canonical_words(ref row, writer)
        position = position + 1
    }
    writer.finish_prefix()
}

/// Decode an untrusted canonical trace into typed linear-memory placement.
/// Invalid versions, counts, tags, booleans, lengths, or allocation state all
/// fail closed while retaining the same opaque trace handle type.
pub fn decode_production_security_verifier_trace(
    _ bytes: BrowserBytes,
) -> ProductionSecurityVerifierTrace {
    let placement = ProductionSecurityVerifierTraceInterpreter::new()
    let trace = placement.trace
    if !trace.available { return trace }

    let count: u32 = PRODUCTION_SECURITY_VERIFIER_TASK_COUNT.downcast_truncate()
    let mut header = ProductionSecurityVerifierCanonicalTraceHeader {
        version: 0,
        valid: false,
        task_count: 0,
    }
    let mut reader = decode_canonical_words(
        mut header,
        BrowserWordReader::new(bytes),
    )
    if header.version != 1 || !header.valid || header.task_count != count {
        return trace
    }

    let mut position: u32 = 0
    let mut valid = true
    while position < count {
        let mut row = ProductionSecurityVerifierCanonicalTraceRow {
            task_position: count,
            accepted: false,
        }
        reader = decode_canonical_words(mut row, reader)
        if row.task_position > count { valid = false }
        let wrote = with (trace.arena) {
            write_production_security_verifier_trace_row(
                position,
                ProductionSecurityVerifierTraceRow {
                    task: production_security_verifier_trace_task(
                        production_security_verifier_task_at(row.task_position),
                    ),
                    accepted: row.accepted,
                },
            )
        }
        valid = valid && wrote
        position = position + 1
    }
    valid = valid && reader.complete()
    with (trace.arena) {
        finish_production_security_verifier_trace(valid)
    }
    trace
}

fn empty_profiled_sparse_baby_bear_receipt<
    const QUERY_COUNT: usize,
    const AIR_MAX_LEAVES: usize,
    const AIR_MAX_SIBLINGS: usize,
    const COMPOSITION_MAX_LEAVES: usize,
    const COMPOSITION_MAX_SIBLINGS: usize,
    Plan,
    Samples: core::marker::Copy,
    Schedule,
    Proof,
    Layers,
>() -> SparseBabyBearAirFriReceipt<
    {PRODUCTION_LIMBS},
    {PRODUCTION_TRACE_LENGTH},
    {PRODUCTION_LDE_LENGTH},
    AIR_MAX_LEAVES,
    AIR_MAX_SIBLINGS,
    FriMultiCommitmentQuery<
        COMPOSITION_MAX_LEAVES,
        COMPOSITION_MAX_SIBLINGS,
        Layers,
    >,
>
where
    Schedule: BabyBearFriMultiQueryLayers<
        QUERY_COUNT,
        {PRODUCTION_LDE_LENGTH / 2},
        COMPOSITION_MAX_LEAVES,
        Plan,
        Samples,
        Proof,
        Layers,
    >,
{
    let base_root = SparseBaseLdeDigest {
        valid: false,
        value: Poseidon2Digest::zero(),
    }
    SparseBabyBearAirFriReceipt {
        valid: false,
        base_root: base_root,
        interaction_root: SparseInteractionLdeDigest {
            valid: false,
            base: base_root,
            value: Poseidon2Digest::zero(),
        },
        base: empty_sparse_base_lde_multi_opening<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            AIR_MAX_LEAVES,
            AIR_MAX_SIBLINGS,
        >(),
        interaction: empty_sparse_interaction_lde_multi_opening<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            AIR_MAX_LEAVES,
            AIR_MAX_SIBLINGS,
        >(),
        fri: FriMultiCommitmentQuery {
            valid: false,
            composition_root: CompositionDigest {
                valid: false,
                value: Poseidon2Digest::zero(),
            },
            composition: empty_composition_multi_opening<
                COMPOSITION_MAX_LEAVES,
                COMPOSITION_MAX_SIBLINGS,
            >(),
            layers: <Schedule
                as BabyBearFriMultiQueryLayers<
                    QUERY_COUNT,
                    {PRODUCTION_LDE_LENGTH / 2},
                    COMPOSITION_MAX_LEAVES,
                    Plan,
                    Samples,
                    Proof,
                    Layers,
                >>::invalid_fri_multi_query_layers(),
        },
    }
}

/// Construct the canonical empty production carrier. Browser and native
/// decoders start from this value, so storage shape remains derived from Fe
/// types rather than repeated in host scaffolding.
pub fn empty_production_sparse_baby_bear_receipt()
    -> ProductionSparseBabyBearReceipt {
    empty_profiled_sparse_baby_bear_receipt<
        {PRODUCTION_QUERY_COUNT},
        {PRODUCTION_AIR_MAX_LEAVES},
        {PRODUCTION_AIR_MAX_SIBLINGS},
        {PRODUCTION_COMPOSITION_MAX_LEAVES},
        {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
        ProductionSparseFriQueryPlan,
        ProductionSparseFriQuerySamples,
        ProductionSparseFriSchedule,
        ProductionSparseFriProof,
        ProductionSparseFriLayers,
    >()
}

/// Construct the independently typed 114-query security carrier selected by
/// `PRODUCTION_RECURSIVE_SECURITY_POLICY`.
pub fn empty_production_security_sparse_baby_bear_receipt()
    -> ProductionSecuritySparseBabyBearReceipt {
    empty_profiled_sparse_baby_bear_receipt<
        {PRODUCTION_SECURITY_QUERY_COUNT},
        {PRODUCTION_SECURITY_AIR_MAX_LEAVES},
        {PRODUCTION_SECURITY_AIR_MAX_SIBLINGS},
        {PRODUCTION_SECURITY_COMPOSITION_MAX_LEAVES},
        {PRODUCTION_SECURITY_COMPOSITION_MAX_SIBLINGS},
        ProductionSecuritySparseFriQueryPlan,
        ProductionSecuritySparseFriQuerySamples,
        ProductionSparseFriSchedule,
        ProductionSparseFriProof,
        ProductionSecuritySparseFriLayers,
    >()
}

/// Reset caller-owned production storage without exposing its nested receipt
/// layout to a browser or native host.
pub fn clear_production_sparse_baby_bear_receipt(
    _ receipt: mut ProductionSparseBabyBearReceipt,
) {
    receipt = empty_production_sparse_baby_bear_receipt()
}

fn encode_production_sparse_receipt_header(
    _ receipt: ref ProductionSparseBabyBearReceipt,
    _ writer: BrowserWordWriter,
) -> BrowserWordWriter {
    let writer = encode_canonical_words(ref receipt.valid, writer)
    let writer = encode_canonical_words(ref receipt.base_root, writer)
    encode_canonical_words(ref receipt.interaction_root, writer)
}

fn encode_production_sparse_receipt_air(
    _ receipt: ref ProductionSparseBabyBearReceipt,
    _ writer: BrowserWordWriter,
) -> BrowserWordWriter {
    let writer = receipt.base.encode_stream(writer)
    receipt.interaction.encode_stream(writer)
}

fn encode_production_sparse_receipt_fri(
    _ receipt: ref ProductionSparseBabyBearReceipt,
    _ writer: BrowserWordWriter,
) -> BrowserWordWriter {
    receipt.fri.encode_stream(writer)
}

/// Encode one production receipt through explicit Fe-owned stages. The byte
/// order is still the FCO-derived canonical stream; staging prevents a single
/// generated browser function from absorbing the complete nested decoder.
pub fn encode_production_sparse_baby_bear_receipt(
    _ receipt: ref ProductionSparseBabyBearReceipt,
) -> BrowserBytes {
    let writer = BrowserWordWriter::growing()
    let writer = encode_production_sparse_receipt_header(receipt, writer)
    let writer = encode_production_sparse_receipt_air(receipt, writer)
    encode_production_sparse_receipt_fri(receipt, writer).finish_prefix()
}

fn decode_production_sparse_receipt_header(
    _ receipt: mut ProductionSparseBabyBearReceipt,
    _ reader: BrowserWordReader,
) -> BrowserWordReader {
    let reader = decode_canonical_words(mut receipt.valid, reader)
    let reader = decode_canonical_words(mut receipt.base_root, reader)
    decode_canonical_words(mut receipt.interaction_root, reader)
}

fn decode_production_sparse_receipt_air(
    _ receipt: mut ProductionSparseBabyBearReceipt,
    _ reader: BrowserWordReader,
) -> BrowserWordReader {
    let reader = receipt.base.decode_stream(reader)
    receipt.interaction.decode_stream(reader)
}

fn decode_production_sparse_receipt_fri(
    _ receipt: mut ProductionSparseBabyBearReceipt,
    _ reader: BrowserWordReader,
) -> BrowserWordReader {
    receipt.fri.decode_stream(reader)
}

/// Decode a bounded canonical receipt through explicit Fe stages. Truncation,
/// trailing words, invalid booleans or fields, excessive sparse counts, and
/// noncanonical unused capacity fail closed and reset the caller-owned value.
pub fn decode_production_sparse_baby_bear_receipt(
    _ bytes: BrowserBytes,
    _ receipt: mut ProductionSparseBabyBearReceipt,
) -> bool {
    clear_production_sparse_baby_bear_receipt(mut receipt)
    let reader = BrowserWordReader::new(bytes)
    let reader = decode_production_sparse_receipt_header(mut receipt, reader)
    let reader = decode_production_sparse_receipt_air(mut receipt, reader)
    let reader = decode_production_sparse_receipt_fri(mut receipt, reader)
    if !reader.complete() {
        clear_production_sparse_baby_bear_receipt(mut receipt)
        return false
    }
    true
}

/// Reset caller-owned production storage without exposing its nested receipt
/// layout to a browser or native host.
pub fn clear_production_security_sparse_baby_bear_receipt(
    _ receipt: mut ProductionSecuritySparseBabyBearReceipt,
) {
    receipt = empty_production_security_sparse_baby_bear_receipt()
}

fn encode_production_security_sparse_receipt_header(
    _ receipt: ref ProductionSecuritySparseBabyBearReceipt,
    _ writer: BrowserWordWriter,
) -> BrowserWordWriter {
    let writer = encode_canonical_words(ref receipt.valid, writer)
    let writer = encode_canonical_words(ref receipt.base_root, writer)
    encode_canonical_words(ref receipt.interaction_root, writer)
}

fn encode_production_security_sparse_receipt_air(
    _ receipt: ref ProductionSecuritySparseBabyBearReceipt,
    _ writer: BrowserWordWriter,
) -> BrowserWordWriter {
    let writer = receipt.base.encode_stream(writer)
    receipt.interaction.encode_stream(writer)
}

fn encode_production_security_sparse_receipt_fri(
    _ receipt: ref ProductionSecuritySparseBabyBearReceipt,
    _ writer: BrowserWordWriter,
) -> BrowserWordWriter {
    receipt.fri.encode_stream(writer)
}

/// Encode one production receipt through explicit Fe-owned stages. The byte
/// order is still the FCO-derived canonical stream; staging prevents a single
/// generated browser function from absorbing the complete nested decoder.
pub fn encode_production_security_sparse_baby_bear_receipt(
    _ receipt: ref ProductionSecuritySparseBabyBearReceipt,
) -> BrowserBytes {
    let writer = BrowserWordWriter::growing()
    let writer = encode_production_security_sparse_receipt_header(receipt, writer)
    let writer = encode_production_security_sparse_receipt_air(receipt, writer)
    encode_production_security_sparse_receipt_fri(receipt, writer).finish_prefix()
}

fn decode_production_security_sparse_receipt_header(
    _ receipt: mut ProductionSecuritySparseBabyBearReceipt,
    _ reader: BrowserWordReader,
) -> BrowserWordReader {
    let reader = decode_canonical_words(mut receipt.valid, reader)
    let reader = decode_canonical_words(mut receipt.base_root, reader)
    decode_canonical_words(mut receipt.interaction_root, reader)
}

fn decode_production_security_sparse_receipt_air(
    _ receipt: mut ProductionSecuritySparseBabyBearReceipt,
    _ reader: BrowserWordReader,
) -> BrowserWordReader {
    let reader = receipt.base.decode_stream(reader)
    receipt.interaction.decode_stream(reader)
}

fn decode_production_security_sparse_receipt_fri(
    _ receipt: mut ProductionSecuritySparseBabyBearReceipt,
    _ reader: BrowserWordReader,
) -> BrowserWordReader {
    receipt.fri.decode_stream(reader)
}

/// Decode a bounded canonical receipt through explicit Fe stages. Truncation,
/// trailing words, invalid booleans or fields, excessive sparse counts, and
/// noncanonical unused capacity fail closed and reset the caller-owned value.
pub fn decode_production_security_sparse_baby_bear_receipt(
    _ bytes: BrowserBytes,
    _ receipt: mut ProductionSecuritySparseBabyBearReceipt,
) -> bool {
    clear_production_security_sparse_baby_bear_receipt(mut receipt)
    let reader = BrowserWordReader::new(bytes)
    let reader = decode_production_security_sparse_receipt_header(mut receipt, reader)
    let reader = decode_production_security_sparse_receipt_air(mut receipt, reader)
    let reader = decode_production_security_sparse_receipt_fri(mut receipt, reader)
    if !reader.complete() {
        clear_production_security_sparse_baby_bear_receipt(mut receipt)
        return false
    }
    true
}

pub struct ProductionSparseFriAuthentication {
    pub valid: bool,
    pub samples: ProductionSparseFriQuerySamples,
    pub queries: FriQueryBuffer<{PRODUCTION_QUERY_COUNT}>,
    pub challenges: ProductionSparseFriChallenges,
}
impl core::marker::Copy for ProductionSparseFriAuthentication {}


fn install_production_checkpoint_receipt(
        _ base_codeword: ref SparseBaseAirLdeCodeword<
            {PRODUCTION_LDE_LENGTH},
        >,
        _ interaction_codeword: ref SparseInteractionAirLdeCodeword<
            {PRODUCTION_LDE_LENGTH},
        >,
        _ composition_codeword: ref SparseCompositionAirCodeword<
            {PRODUCTION_LDE_LENGTH},
        >,
        _ base_root: SparseBaseLdeDigest<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
        >,
        _ interaction_root: SparseInteractionLdeDigest<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
        >,
        _ composition_root: CompositionDigest,
        _ samples: ref ProductionSparseFriQuerySamples,
        _ receipt: mut ProductionSparseBabyBearReceipt,
    ) -> bool {
        receipt.fri.valid = false
        if !write_composition_multi_query_opening_power_of_two<
            ProductionSparseFriQueryPlan,
            ProductionSparseFriQuerySamples,
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_LDE_LENGTH / 2},
            {PRODUCTION_COMPOSITION_MAX_LEAVES},
            {PRODUCTION_COMPOSITION_MAX_LEAVES},
            {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
        >(
            ref composition_codeword.values,
            samples,
            mut receipt.fri.composition,
        ) {
            return false
        }
        let requests = <ProductionSparseFriQueryPlan
            as BabyBearAirLdeRequests<
                {PRODUCTION_TRACE_LENGTH},
                {PRODUCTION_LDE_LENGTH},
                {PRODUCTION_AIR_MAX_LEAVES},
                ProductionSparseFriQuerySamples,
            >>::air_lde_requests(samples)
        if !requests.valid
            || requests.count != PRODUCTION_AIR_MAX_LEAVES.downcast_truncate()
            || !write_sparse_base_lde_multi_opening_power_of_two<
                {PRODUCTION_LIMBS},
                {PRODUCTION_TRACE_LENGTH},
                {PRODUCTION_LDE_LENGTH},
                {PRODUCTION_AIR_MAX_LEAVES},
                {PRODUCTION_AIR_MAX_LEAVES},
                {PRODUCTION_AIR_MAX_SIBLINGS},
            >(
                base_codeword,
                base_root,
                requests.indices,
                mut receipt.base,
            )
            || !write_sparse_interaction_lde_multi_opening_power_of_two<
                {PRODUCTION_LIMBS},
                {PRODUCTION_TRACE_LENGTH},
                {PRODUCTION_LDE_LENGTH},
                {PRODUCTION_AIR_MAX_LEAVES},
                {PRODUCTION_AIR_MAX_LEAVES},
                {PRODUCTION_AIR_MAX_SIBLINGS},
            >(
                interaction_codeword,
                interaction_root,
                requests.indices,
                mut receipt.interaction,
            ) {
            return false
        }
        receipt.base_root = base_root
        receipt.interaction_root = interaction_root
        receipt.fri.composition_root = composition_root
        receipt.fri.valid = true
        receipt.valid = true
        true
}

fn install_production_security_receipt(
        _ base_codeword: ref SparseBaseAirLdeCodeword<
            {PRODUCTION_LDE_LENGTH},
        >,
        _ interaction_codeword: ref SparseInteractionAirLdeCodeword<
            {PRODUCTION_LDE_LENGTH},
