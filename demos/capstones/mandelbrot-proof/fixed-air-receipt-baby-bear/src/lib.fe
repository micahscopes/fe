//! Authenticated BabyBear receipt schema for the production sparse fixed AIR.
//!
//! This join layer depends on both the high-precision sparse AIR and the
//! field-generic BabyBear FRI interpreter. Neither lower layer depends on the
//! other, so the protocol stays acyclic and no browser host owns proof shape.

use canonical_words::{
    BrowserWordReader,
    BrowserWordWriter,
    CanonicalWordStream,
    CanonicalWordStreamProvider,
    CanonicalWords,
    CanonicalWordsProvider,
    canonical_word_stream_count,
    decode_canonical_words,
    encode_canonical_words,
}
use core::BrowserBytes
use mandelbrot_proof_air_core::{FriQueryPlan, FriSchedule, radix2_query_geometry}
use mandelbrot_proof_baby_bear::{
    BabyBearAirLdeRequests,
    BabyBearFriFirst,
    BabyBearFriMultiAuthenticateFirst,
    BabyBearFriMultiChallengeShape,
    BabyBearFriMultiFoldCheck,
    BabyBearFriMultiQueryShape,
    BabyBearFriMultiQueryLayers,
    BabyBearFriPairRequests,
    BabyBearFriQueryBuffer,
    BabyBearFriQueryPlanShape,
    CompositionMultiOpening,
    CompositionDigest,
    Ext4SparseOpening,
    FriMultiCommitmentQuery,
    FriQueryBuffer,
    bind_composition,
    composition_multi_query_opening_power_of_two,
    empty_composition_multi_opening,
    fold_fri_schedule,
    fri_multi_sibling_capacity,
    verify_composition_multi_opening,
}
use mandelbrot_proof_fixed_air_baby_bear::{
    SparseAirConstraintShape,
    SparseBaseLdeDigest,
    SparseBaseAirLdeCodeword,
    SparseBaseLdeMultiOpening,
    SparseCompositionAirCodeword,
    SparseInteractionLdeDigest,
    SparseInteractionAirLdeCodeword,
    SparseInteractionLdeMultiOpening,
    SparseAirLdeTranscriptDigest,
    SparseCompositionTranscriptDigest,
    bind_sparse_air_lde_transcript,
    bind_sparse_composition_extension,
    evaluate_sparse_bound_composition_opened,
    sparse_lde_opened_air_row,
    sparse_base_lde_root_power_of_two,
    sparse_composition_degree_bound,
    sparse_bound_composition_lde_root_power_of_two,
    sparse_interaction_lde_root_power_of_two,
    sparse_constraint_shape,
    empty_sparse_base_lde_multi_opening,
    empty_sparse_interaction_lde_multi_opening,
    verify_sparse_base_lde_multi_opening,
    verify_sparse_interaction_lde_multi_opening,
    write_sparse_base_lde_multi_opening_power_of_two,
    write_sparse_interaction_lde_multi_opening_power_of_two,
}
use mandelbrot_proof_recursive::OrbitInterval
use mandelbrot_proof_recursive_baby_bear::commit_recursive_leaf_statement
use merkle_core::multi_path_matches_requests
use poseidon_baby_bear::{
    Poseidon2Digest,
    Poseidon2Domain,
    Poseidon2FieldDomain,
    PackedCommitment,
    commit_canonical_packed,
}
use precision::baby_bear::{BABY_BEAR_MODULUS, BabyBear, BabyBearExt4}
use precision::polynomial::{Radix2Field, radix2_log}
use proof_security::{
    DirectFriSecurityPolicy,
    derive_conjectured_direct_fri_policy,
    direct_fri_security_policy_is_derived,
}

const fn protocol_tag(_ label: String<4>) -> u32 {
    let bytes = label.as_bytes()
    ((bytes[0] as u32) << 24)
        | ((bytes[1] as u32) << 16)
        | ((bytes[2] as u32) << 8)
        | (bytes[3] as u32)
}

struct MandelbrotSparseSecurityProfileBabyBearV1 {}
impl Poseidon2Domain for MandelbrotSparseSecurityProfileBabyBearV1 {
    const TAG: u32 = protocol_tag("SP01")
}

struct MandelbrotSparseSecurityTranscriptBabyBearV1 {}
impl Poseidon2FieldDomain for MandelbrotSparseSecurityTranscriptBabyBearV1 {
    const TAG: u32 = protocol_tag("SP02")
}

/// One canonical sparse AIR and FRI receipt. The base and interaction roots
/// retain their limb, trace, and LDE brands. The nested FRI carrier is an
/// interpretation of `FriSchedule`, not a handwritten round list.
pub struct SparseBabyBearAirFriReceipt<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const AIR_MAX_LEAVES: usize,
    const AIR_MAX_SIBLINGS: usize,
    Fri,
> {
    pub valid: bool,
    pub base_root: SparseBaseLdeDigest<L, TRACE, LDE>,
    pub interaction_root: SparseInteractionLdeDigest<L, TRACE, LDE>,
    pub base: SparseBaseLdeMultiOpening<
        L,
        TRACE,
        LDE,
        AIR_MAX_LEAVES,
        AIR_MAX_SIBLINGS,
    >,
    pub interaction: SparseInteractionLdeMultiOpening<
        L,
        TRACE,
        LDE,
        AIR_MAX_LEAVES,
        AIR_MAX_SIBLINGS,
    >,
    pub fri: Fri,
}
impl<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const AIR_MAX_LEAVES: usize,
    const AIR_MAX_SIBLINGS: usize,
    Fri: core::marker::Copy,
> core::marker::Copy for SparseBabyBearAirFriReceipt<
    L,
    TRACE,
    LDE,
    AIR_MAX_LEAVES,
    AIR_MAX_SIBLINGS,
    Fri,
> {}
derive CanonicalWordStream for SparseBabyBearAirFriReceipt<
    L,
    TRACE,
    LDE,
    AIR_MAX_LEAVES,
    AIR_MAX_SIBLINGS,
    Fri,
> using CanonicalWordStreamProvider

pub const PRODUCTION_LIMBS: usize = 4
pub const PRODUCTION_TRACE_LENGTH: usize = 4096
pub const PRODUCTION_LDE_LENGTH: usize = 8192
pub const PRODUCTION_LDE_LOG: usize = 13
pub const PRODUCTION_TRACE_LENGTH_U32: u32 =
    PRODUCTION_TRACE_LENGTH.downcast_truncate()
pub const PRODUCTION_LDE_LENGTH_U32: u32 =
    PRODUCTION_LDE_LENGTH.downcast_truncate()
/// Protocol-shape checkpoint only. A later audited soundness policy must
/// derive the security-bearing query count before recursive proving.
pub const PRODUCTION_QUERY_COUNT: usize = 4
pub const PRODUCTION_SECURITY_TARGET_BITS: u32 = 100
pub const PRODUCTION_SECURITY_MAX_COMPOSED_PROOFS: u32 = 1024
pub const PRODUCTION_SECURITY_EXTENSION_DEGREE: u32 = 4
pub const PRODUCTION_SECURITY_FOLDING_ARITY: u32 = 2
pub const PRODUCTION_SECURITY_AIR_CONSTRAINT_CAP: u32 = 8192
pub const PRODUCTION_SECURITY_HASH_COLLISION_BITS: u32 = 128
pub const PRODUCTION_SECURITY_QUERY_POW_BITS: u32 = 0
pub const PRODUCTION_SECURITY_COMMIT_POW_BITS: u32 = 0

/// Security-affecting transcript data, including the exact structural shape
/// produced by the AIR evaluator and the query count actually executed by the
/// receipt. A verifier recomputes this value rather than trusting receipt
/// bytes, so a policy cannot claim more queries than the proof opens.
pub struct SparseDirectFriTranscriptProfile {
    pub valid: bool,
    pub policy: DirectFriSecurityPolicy,
    pub air_shape: SparseAirConstraintShape,
    pub executed_queries: u32,
}
impl core::marker::Copy for SparseDirectFriTranscriptProfile {}
derive CanonicalWords for SparseDirectFriTranscriptProfile using CanonicalWordsProvider

pub const SPARSE_SECURITY_PROFILE_WORDS: usize =
    <SparseDirectFriTranscriptProfile as CanonicalWords>::WORDS as usize
pub const SPARSE_SECURITY_PROFILE_FIELDS: usize =
    (SPARSE_SECURITY_PROFILE_WORDS * 32 + 29) / 30

pub struct SparseDirectFriProfileDigest {
    pub valid: bool,
    pub value: Poseidon2Digest,
}
impl core::marker::Copy for SparseDirectFriProfileDigest {}

fn production_security_policy(
    _ target_bits: u32,
    _ max_composed_proofs: u32,
) -> DirectFriSecurityPolicy {
    let shape = sparse_constraint_shape<{PRODUCTION_LIMBS}>()
    derive_conjectured_direct_fri_policy(
        target_bits,
        max_composed_proofs,
        BABY_BEAR_MODULUS,
        PRODUCTION_SECURITY_EXTENSION_DEGREE,
        PRODUCTION_TRACE_LENGTH_U32,
        PRODUCTION_LDE_LENGTH_U32,
        sparse_composition_degree_bound(
            shape,
            PRODUCTION_TRACE_LENGTH_U32,
        ),
        PRODUCTION_SECURITY_FOLDING_ARITY,
        PRODUCTION_SECURITY_AIR_CONSTRAINT_CAP,
        PRODUCTION_SECURITY_HASH_COLLISION_BITS,
        PRODUCTION_SECURITY_QUERY_POW_BITS,
        PRODUCTION_SECURITY_COMMIT_POW_BITS,
    )
}

pub fn production_recursive_security_policy() -> DirectFriSecurityPolicy {
    production_security_policy(
        PRODUCTION_SECURITY_TARGET_BITS,
        PRODUCTION_SECURITY_MAX_COMPOSED_PROOFS,
    )
}

/// The already executed four-query receipt is retained as an explicitly
/// low-security protocol-shape checkpoint. It must never carry the recursive
/// 100-bit profile, whose derived query count is larger.
pub fn production_checkpoint_security_policy() -> DirectFriSecurityPolicy {
    production_security_policy(
        3,
        1,
    )
}

fn maximum_u32(_ left: u32, _ right: u32) -> u32 {
    if left > right { left } else { right }
}

fn sparse_air_shape_is_consistent(
    _ shape: SparseAirConstraintShape,
    _ policy: DirectFriSecurityPolicy,
) -> bool {
    shape.valid
        && shape.total == shape.all_rows
            + shape.pair_rows + shape.first_row + shape.last_row
        && shape.all_rows > 0 && shape.pair_rows > 0
        && shape.first_row > 0 && shape.last_row > 0
        && shape.all_rows_degree > 0 && shape.pair_rows_degree > 0
        && shape.first_row_degree > 0 && shape.last_row_degree > 0
        && shape.maximum_degree == maximum_u32(
            maximum_u32(shape.all_rows_degree, shape.pair_rows_degree),
            maximum_u32(shape.first_row_degree, shape.last_row_degree),
        )
        && shape.total <= policy.max_air_constraints
        && sparse_composition_degree_bound(
            shape,
            policy.trace_length,
        ) == policy.composition_degree_bound
}

fn sparse_direct_fri_transcript_profile(
    _ policy: DirectFriSecurityPolicy,
    _ air_shape: SparseAirConstraintShape,
    _ executed_queries: u32,
) -> SparseDirectFriTranscriptProfile {
    let shape_consistent = sparse_air_shape_is_consistent(air_shape, policy)
    let policy_consistent = policy.valid
        && policy.base_modulus == BABY_BEAR_MODULUS
        && policy.extension_degree == PRODUCTION_SECURITY_EXTENSION_DEGREE
        && policy.trace_length == PRODUCTION_TRACE_LENGTH_U32
        && policy.lde_length == PRODUCTION_LDE_LENGTH_U32
        && policy.folding_arity == PRODUCTION_SECURITY_FOLDING_ARITY
        && policy.max_air_constraints == PRODUCTION_SECURITY_AIR_CONSTRAINT_CAP
        && policy.hash_collision_bits
            == PRODUCTION_SECURITY_HASH_COLLISION_BITS
        && policy.query_pow_bits == PRODUCTION_SECURITY_QUERY_POW_BITS
        && policy.commit_pow_bits == PRODUCTION_SECURITY_COMMIT_POW_BITS
        && policy.query_count == executed_queries
    SparseDirectFriTranscriptProfile {
        valid: shape_consistent && policy_consistent,
        policy: policy,
        air_shape: air_shape,
        executed_queries: executed_queries,
    }
}

fn sparse_direct_fri_transcript_profile_is_consistent(
    _ profile: ref SparseDirectFriTranscriptProfile,
) -> bool {
    direct_fri_security_policy_is_derived(profile.policy)
        && profile.executed_queries == profile.policy.query_count
        && sparse_air_shape_is_consistent(profile.air_shape, profile.policy)
}

pub fn production_checkpoint_security_profile()
    -> SparseDirectFriTranscriptProfile {
    sparse_direct_fri_transcript_profile(
        production_checkpoint_security_policy(),
        sparse_constraint_shape<{PRODUCTION_LIMBS}>(),
        PRODUCTION_QUERY_COUNT.downcast_truncate(),
    )
}

pub fn production_recursive_security_profile()
    -> SparseDirectFriTranscriptProfile {
    let policy = production_recursive_security_policy()
    sparse_direct_fri_transcript_profile(
        policy,
        sparse_constraint_shape<{PRODUCTION_LIMBS}>(),
        policy.query_count,
    )
}

pub fn commit_sparse_direct_fri_transcript_profile(
    _ profile: ref SparseDirectFriTranscriptProfile,
) -> SparseDirectFriProfileDigest {
    let commitment = sparse_direct_fri_profile_commitment(profile)
    SparseDirectFriProfileDigest {
        valid: commitment.is_valid(),
        value: commitment.digest(),
    }
}

fn sparse_direct_fri_profile_commitment(
    _ profile: ref SparseDirectFriTranscriptProfile,
) -> PackedCommitment {
    let commitment = commit_canonical_packed<
        MandelbrotSparseSecurityProfileBabyBearV1,
        SparseDirectFriTranscriptProfile,
        {SPARSE_SECURITY_PROFILE_WORDS},
        {SPARSE_SECURITY_PROFILE_FIELDS},
    >(profile)
    commitment.require(
        profile.valid
            && sparse_direct_fri_transcript_profile_is_consistent(profile),
    )
}

/// Extend an already authenticated AIR transcript with the exact security
/// profile interpreted by this receipt. The profile commitment is nominally
/// separated from all statement, AIR-root, composition, and FRI domains.
pub fn bind_sparse_air_security_profile<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
    _ profile: SparseDirectFriTranscriptProfile,
) -> SparseCompositionTranscriptDigest<L, TRACE, LDE> {
    bind_sparse_composition_extension<
        MandelbrotSparseSecurityTranscriptBabyBearV1,
        L,
        TRACE,
        LDE,
    >(air, sparse_direct_fri_profile_commitment(ref profile))
}

pub const PRODUCTION_AIR_MAX_LEAVES: usize = PRODUCTION_QUERY_COUNT * 4
pub const PRODUCTION_AIR_MAX_SIBLINGS: usize =
    PRODUCTION_AIR_MAX_LEAVES * PRODUCTION_LDE_LOG
pub const PRODUCTION_COMPOSITION_MAX_LEAVES: usize =
    PRODUCTION_QUERY_COUNT * 2
pub const PRODUCTION_COMPOSITION_MAX_SIBLINGS: usize =
    fri_multi_sibling_capacity(PRODUCTION_LDE_LOG - 1, PRODUCTION_QUERY_COUNT)

pub type ProductionSparseFriSchedule = FriSchedule<1, {PRODUCTION_LDE_LOG}>
pub type ProductionSparseFriLayers =
    <ProductionSparseFriSchedule as BabyBearFriMultiQueryShape<
        {PRODUCTION_QUERY_COUNT},
    >>::Query
pub type ProductionSparseFriQuery = FriMultiCommitmentQuery<
    {PRODUCTION_COMPOSITION_MAX_LEAVES},
    {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
    ProductionSparseFriLayers,
>
pub type ProductionSparseFriQueryPlan = FriQueryPlan<1, {PRODUCTION_QUERY_COUNT}>
pub type ProductionSparseFriQuerySamples =
    <ProductionSparseFriQueryPlan as BabyBearFriQueryPlanShape>::Samples
pub type ProductionSparseFriChallenges =
    <ProductionSparseFriSchedule as BabyBearFriMultiChallengeShape>::Challenges
pub type ProductionSparseFriProof =
    <ProductionSparseFriSchedule as BabyBearFriFirst<
        {PRODUCTION_LDE_LENGTH},
    >>::Proof
pub type ProductionSparseBabyBearReceipt = SparseBabyBearAirFriReceipt<
    {PRODUCTION_LIMBS},
    {PRODUCTION_TRACE_LENGTH},
    {PRODUCTION_LDE_LENGTH},
    {PRODUCTION_AIR_MAX_LEAVES},
    {PRODUCTION_AIR_MAX_SIBLINGS},
    ProductionSparseFriQuery,
>

/// Construct the canonical empty production carrier. Browser and native
/// decoders start from this value, so storage shape remains derived from Fe
/// types rather than repeated in host scaffolding.
pub fn empty_production_sparse_baby_bear_receipt()
    -> ProductionSparseBabyBearReceipt {
    let base_root = SparseBaseLdeDigest {
        valid: false,
        value: Poseidon2Digest::zero(),
    }
    SparseBabyBearAirFriReceipt {
        valid: false,
        base_root: base_root,
        interaction_root: SparseInteractionLdeDigest {
            valid: false,
            base: base_root,
            value: Poseidon2Digest::zero(),
        },
        base: empty_sparse_base_lde_multi_opening<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_SIBLINGS},
        >(),
        interaction: empty_sparse_interaction_lde_multi_opening<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_SIBLINGS},
        >(),
        fri: FriMultiCommitmentQuery {
            valid: false,
            composition_root: CompositionDigest {
                valid: false,
                value: Poseidon2Digest::zero(),
            },
            composition: empty_composition_multi_opening<
                {PRODUCTION_COMPOSITION_MAX_LEAVES},
                {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
            >(),
            layers: <ProductionSparseFriSchedule
                as BabyBearFriMultiQueryLayers<
                    {PRODUCTION_QUERY_COUNT},
                    {PRODUCTION_LDE_LENGTH / 2},
                    {PRODUCTION_COMPOSITION_MAX_LEAVES},
                    ProductionSparseFriQueryPlan,
                    ProductionSparseFriQuerySamples,
                    ProductionSparseFriProof,
                    ProductionSparseFriLayers,
                >>::invalid_fri_multi_query_layers(),
        },
    }
}

/// Reset caller-owned production storage without exposing its nested receipt
/// layout to a browser or native host.
pub fn clear_production_sparse_baby_bear_receipt(
    _ receipt: mut ProductionSparseBabyBearReceipt,
) {
    receipt = empty_production_sparse_baby_bear_receipt()
}

fn encode_production_sparse_receipt_header(
    _ receipt: ref ProductionSparseBabyBearReceipt,
    _ writer: BrowserWordWriter,
) -> BrowserWordWriter {
    let writer = encode_canonical_words(ref receipt.valid, writer)
    let writer = encode_canonical_words(ref receipt.base_root, writer)
    encode_canonical_words(ref receipt.interaction_root, writer)
}

fn encode_production_sparse_receipt_air(
    _ receipt: ref ProductionSparseBabyBearReceipt,
    _ writer: BrowserWordWriter,
) -> BrowserWordWriter {
    let writer = receipt.base.encode_stream(writer)
    receipt.interaction.encode_stream(writer)
}

fn encode_production_sparse_receipt_fri(
    _ receipt: ref ProductionSparseBabyBearReceipt,
    _ writer: BrowserWordWriter,
) -> BrowserWordWriter {
    receipt.fri.encode_stream(writer)
}

/// Encode one production receipt through explicit Fe-owned stages. The byte
/// order is still the FCO-derived canonical stream; staging prevents a single
/// generated browser function from absorbing the complete nested decoder.
pub fn encode_production_sparse_baby_bear_receipt(
    _ receipt: ref ProductionSparseBabyBearReceipt,
) -> BrowserBytes {
    let words = canonical_word_stream_count(receipt)
    if words == 0 { return BrowserBytes { ptr: 0, len: 0 } }
    let writer = BrowserWordWriter::allocate(words)
    let writer = encode_production_sparse_receipt_header(receipt, writer)
    let writer = encode_production_sparse_receipt_air(receipt, writer)
    encode_production_sparse_receipt_fri(receipt, writer).finish()
}

fn decode_production_sparse_receipt_header(
    _ receipt: mut ProductionSparseBabyBearReceipt,
    _ reader: BrowserWordReader,
) -> BrowserWordReader {
    let reader = decode_canonical_words(mut receipt.valid, reader)
    let reader = decode_canonical_words(mut receipt.base_root, reader)
    decode_canonical_words(mut receipt.interaction_root, reader)
}

fn decode_production_sparse_receipt_air(
    _ receipt: mut ProductionSparseBabyBearReceipt,
    _ reader: BrowserWordReader,
) -> BrowserWordReader {
    let reader = receipt.base.decode_stream(reader)
    receipt.interaction.decode_stream(reader)
}

fn decode_production_sparse_receipt_fri(
    _ receipt: mut ProductionSparseBabyBearReceipt,
    _ reader: BrowserWordReader,
) -> BrowserWordReader {
    receipt.fri.decode_stream(reader)
}

/// Decode a bounded canonical receipt through explicit Fe stages. Truncation,
/// trailing words, invalid booleans or fields, excessive sparse counts, and
/// noncanonical unused capacity fail closed and reset the caller-owned value.
pub fn decode_production_sparse_baby_bear_receipt(
    _ bytes: BrowserBytes,
    _ receipt: mut ProductionSparseBabyBearReceipt,
) -> bool {
    clear_production_sparse_baby_bear_receipt(mut receipt)
    let reader = BrowserWordReader::new(bytes)
    let reader = decode_production_sparse_receipt_header(mut receipt, reader)
    let reader = decode_production_sparse_receipt_air(mut receipt, reader)
    let reader = decode_production_sparse_receipt_fri(mut receipt, reader)
    if !reader.complete() {
        clear_production_sparse_baby_bear_receipt(mut receipt)
        return false
    }
    true
}

pub struct ProductionSparseFriAuthentication {
    pub valid: bool,
    pub samples: ProductionSparseFriQuerySamples,
    pub queries: FriQueryBuffer<{PRODUCTION_QUERY_COUNT}>,
    pub challenges: ProductionSparseFriChallenges,
}
impl core::marker::Copy for ProductionSparseFriAuthentication {}

/// Materialize one compact production receipt from caller-owned codewords.
/// Trace construction, LDE, and composition remain separately schedulable;
/// this stage binds them, folds FRI, samples once from the terminal
/// transcript, and opens only the derived sparse request sets.
pub fn write_production_sparse_baby_bear_receipt(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ base_codeword: ref SparseBaseAirLdeCodeword<
        {PRODUCTION_LDE_LENGTH},
    >,
    _ interaction_codeword: ref SparseInteractionAirLdeCodeword<
        {PRODUCTION_LDE_LENGTH},
    >,
    _ composition_codeword: ref SparseCompositionAirCodeword<
        {PRODUCTION_LDE_LENGTH},
    >,
    _ shift: BabyBear,
    _ receipt: mut ProductionSparseBabyBearReceipt,
) -> bool {
    receipt.valid = false
    if !base_codeword.valid || !interaction_codeword.valid
        || !composition_codeword.valid || shift.is_zero() {
        return false
    }
    let base_root = sparse_base_lde_root_power_of_two<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(base_codeword)
    let interaction_root = sparse_interaction_lde_root_power_of_two<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(base_root, interaction_codeword)
    let air = bind_sparse_air_lde_transcript<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(
        commit_recursive_leaf_statement(interval),
        base_root,
        interaction_root,
    )
    let composition = bind_sparse_air_security_profile(
        air,
        production_checkpoint_security_profile(),
    )
    let composition_root = sparse_bound_composition_lde_root_power_of_two<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(composition, composition_codeword)
    let composition_transcript = bind_composition(
        composition.transcript(),
        composition_root.value,
    )
    if !base_root.valid || !interaction_root.valid || !composition.is_valid()
        || !composition_root.valid || !composition_transcript.valid {
        return false
    }

    let complete: ProductionSparseFriProof = fold_fri_schedule<
        {PRODUCTION_LDE_LENGTH},
        ProductionSparseFriSchedule,
    >(composition_codeword.values, composition_transcript, shift)
    let sampled = <ProductionSparseFriSchedule as BabyBearFriMultiQueryLayers<
        {PRODUCTION_QUERY_COUNT},
        {PRODUCTION_LDE_LENGTH / 2},
        {PRODUCTION_COMPOSITION_MAX_LEAVES},
        ProductionSparseFriQueryPlan,
        ProductionSparseFriQuerySamples,
        ProductionSparseFriProof,
        ProductionSparseFriLayers,
    >>::sample_fri_multi_queries(ref complete)
    if !complete.valid || !sampled.0 { return false }

    let composition = composition_multi_query_opening_power_of_two<
        ProductionSparseFriQueryPlan,
        ProductionSparseFriQuerySamples,
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_LDE_LENGTH / 2},
        {PRODUCTION_COMPOSITION_MAX_LEAVES},
        {PRODUCTION_COMPOSITION_MAX_LEAVES},
        {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
    >(composition_codeword.values, sampled.1)
    let layers = <ProductionSparseFriSchedule as BabyBearFriMultiQueryLayers<
        {PRODUCTION_QUERY_COUNT},
        {PRODUCTION_LDE_LENGTH / 2},
        {PRODUCTION_COMPOSITION_MAX_LEAVES},
        ProductionSparseFriQueryPlan,
        ProductionSparseFriQuerySamples,
        ProductionSparseFriProof,
        ProductionSparseFriLayers,
    >>::open_fri_multi_query_layers(complete, sampled.1)
    let air_requests = <ProductionSparseFriQueryPlan
        as BabyBearAirLdeRequests<
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            ProductionSparseFriQuerySamples,
        >>::air_lde_requests(sampled.1)
    if !composition.valid || !layers.0 || !air_requests.valid
        || air_requests.count != PRODUCTION_AIR_MAX_LEAVES.downcast_truncate()
        || !write_sparse_base_lde_multi_opening_power_of_two<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_SIBLINGS},
        >(
            base_codeword,
            base_root,
            air_requests.indices,
            mut receipt.base,
        )
        || !write_sparse_interaction_lde_multi_opening_power_of_two<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_SIBLINGS},
        >(
            interaction_codeword,
            interaction_root,
            air_requests.indices,
            mut receipt.interaction,
        ) {
        return false
    }
    receipt.base_root = base_root
    receipt.interaction_root = interaction_root
    receipt.fri = FriMultiCommitmentQuery {
        valid: true,
        composition_root: composition_root.value,
        composition: composition,
        layers: layers.1,
    }
    receipt.valid = true
    true
}

fn authenticate_production_sparse_fri(
    _ composition: SparseCompositionTranscriptDigest<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >,
    _ proof: ref ProductionSparseFriQuery,
) -> ProductionSparseFriAuthentication {
    let composition_authenticated = composition.is_valid()
        && proof.valid && proof.composition_root.valid
        && verify_composition_multi_opening<
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_COMPOSITION_MAX_LEAVES},
            {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
        >(proof.composition, proof.composition_root)
    let composition_transcript = bind_composition(
        composition.transcript(),
        proof.composition_root,
    )
    let authenticated = <ProductionSparseFriSchedule
        as BabyBearFriMultiAuthenticateFirst<
            {PRODUCTION_LDE_LENGTH / 2},
            ProductionSparseFriQueryPlan,
            ProductionSparseFriQuerySamples,
            ProductionSparseFriLayers,
            ProductionSparseFriChallenges,
        >>::authenticate_fri_multi_first(
            composition_transcript,
            proof.layers,
        )
    let queries = <ProductionSparseFriQueryPlan as BabyBearFriQueryBuffer<
        {PRODUCTION_QUERY_COUNT},
        ProductionSparseFriQuerySamples,
    >>::fri_query_buffer(authenticated.1)
    let composition_requests = <ProductionSparseFriQueryPlan
        as BabyBearFriPairRequests<
            {PRODUCTION_LDE_LENGTH / 2},
            {PRODUCTION_COMPOSITION_MAX_LEAVES},
            ProductionSparseFriQuerySamples,
        >>::fri_pair_requests(authenticated.1)
    let exact_composition = composition_requests.valid
        && composition_requests.count
            == PRODUCTION_COMPOSITION_MAX_LEAVES.downcast_truncate()
        && multi_path_matches_requests<
            Poseidon2Digest,
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_COMPOSITION_MAX_LEAVES},
            {PRODUCTION_COMPOSITION_MAX_LEAVES},
            {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
        >(ref proof.composition.path, composition_requests.indices)
    ProductionSparseFriAuthentication {
        valid: composition_authenticated && composition_transcript.valid
            && authenticated.0 && exact_composition
            && queries.valid
            && queries.count == PRODUCTION_QUERY_COUNT.downcast_truncate(),
        samples: authenticated.1,
        queries: queries,
        challenges: authenticated.2,
    }
}

fn verify_production_sparse_composition_query(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
    _ composition: SparseCompositionTranscriptDigest<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >,
    _ query: u32,
    _ receipt: ref ProductionSparseBabyBearReceipt,
) -> bool {
    let geometry = radix2_query_geometry<
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(query)
    if !geometry.valid { return false }
    let current = sparse_lde_opened_air_row<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_AIR_MAX_LEAVES},
        {PRODUCTION_AIR_MAX_SIBLINGS},
    >(ref receipt.base, ref receipt.interaction, geometry.evaluation)
    let next = sparse_lde_opened_air_row<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_AIR_MAX_LEAVES},
        {PRODUCTION_AIR_MAX_SIBLINGS},
    >(ref receipt.base, ref receipt.interaction, geometry.next_evaluation)
    let negative = sparse_lde_opened_air_row<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_AIR_MAX_LEAVES},
        {PRODUCTION_AIR_MAX_SIBLINGS},
    >(ref receipt.base, ref receipt.interaction, geometry.negative_evaluation)
    let negative_next = sparse_lde_opened_air_row<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
        {PRODUCTION_AIR_MAX_LEAVES},
        {PRODUCTION_AIR_MAX_SIBLINGS},
    >(ref receipt.base, ref receipt.interaction, geometry.negative_next_evaluation)
    if !current.0 || !next.0 || !negative.0 || !negative_next.0 {
        return false
    }

    let root = BabyBear::two_adic_root(radix2_log<
        {PRODUCTION_LDE_LENGTH},
    >())
    let point = BabyBearExt4::from_base(
        shift * root.pow_u32(geometry.evaluation),
    )
    let negative_point = BabyBearExt4::from_base(
        shift * root.pow_u32(geometry.negative_evaluation),
    )
    let expected = evaluate_sparse_bound_composition_opened<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(composition, interval, point, ref current.1, ref next.1)
    let expected_negative = evaluate_sparse_bound_composition_opened<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(composition, interval, negative_point, ref negative.1, ref negative_next.1)
    let opened = receipt.fri.composition.sparse_value(geometry.evaluation)
    let opened_negative = receipt.fri.composition.sparse_value(
        geometry.negative_evaluation,
    )
    expected.valid && expected_negative.valid
        && opened.valid && opened_negative.valid
        && expected.value.equals(opened.value)
        && expected_negative.value.equals(opened_negative.value)
}

/// Verify the production 4-limb, 4,096-row, 8,192-point sparse AIR receipt.
/// Every AIR and composition opening must be exactly transcript-selected;
/// each authenticated composition pair is then replayed through the shared
/// sparse AIR and schedule-derived FRI fold interpreters.
pub fn verify_production_sparse_baby_bear_receipt(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
    _ receipt: ref ProductionSparseBabyBearReceipt,
) -> bool {
    if !receipt.valid || shift.is_zero()
        || !receipt.base_root.valid || !receipt.interaction_root.valid
        || !verify_sparse_base_lde_multi_opening<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_SIBLINGS},
        >(ref receipt.base, receipt.base_root)
        || !verify_sparse_interaction_lde_multi_opening<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_SIBLINGS},
        >(ref receipt.interaction, receipt.interaction_root) {
        return false
    }
    let air = bind_sparse_air_lde_transcript<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(
        commit_recursive_leaf_statement(interval),
        receipt.base_root,
        receipt.interaction_root,
    )
    let composition = bind_sparse_air_security_profile(
        air,
        production_checkpoint_security_profile(),
    )
    let authenticated = authenticate_production_sparse_fri(
        composition,
        ref receipt.fri,
    )
    if !composition.is_valid() || !authenticated.valid { return false }

    let air_requests = <ProductionSparseFriQueryPlan
        as BabyBearAirLdeRequests<
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            ProductionSparseFriQuerySamples,
        >>::air_lde_requests(authenticated.samples)
    if !air_requests.valid
        || air_requests.count != PRODUCTION_AIR_MAX_LEAVES.downcast_truncate()
        || !multi_path_matches_requests<
            Poseidon2Digest,
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_SIBLINGS},
        >(ref receipt.base.path, air_requests.indices)
        || !multi_path_matches_requests<
            Poseidon2Digest,
            {PRODUCTION_LDE_LENGTH},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_LEAVES},
            {PRODUCTION_AIR_MAX_SIBLINGS},
        >(ref receipt.interaction.path, air_requests.indices) {
        return false
    }

    let mut cursor: usize = 0
    while cursor < PRODUCTION_QUERY_COUNT {
        let query = authenticated.queries.indices[cursor]
        if !verify_production_sparse_composition_query(
            interval,
            shift,
            composition,
            query,
            receipt,
        ) || !<ProductionSparseFriSchedule as BabyBearFriMultiFoldCheck<
            {PRODUCTION_LDE_LENGTH},
            CompositionMultiOpening<
                {PRODUCTION_COMPOSITION_MAX_LEAVES},
                {PRODUCTION_COMPOSITION_MAX_SIBLINGS},
            >,
            ProductionSparseFriLayers,
            ProductionSparseFriChallenges,
        >>::verify_fri_multi_fold(
            receipt.fri.composition,
            receipt.fri.layers,
            authenticated.challenges,
            query,
            shift,
        ) {
            return false
        }
        cursor = cursor + 1
    }
    true
}
