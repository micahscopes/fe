//! Pure field interpretation of the high-precision Mandelbrot recurrence DAG.
//!
//! The scalar witness generator and authenticated opening views both target
//! these typed records. Constraint code therefore contains no flat column IDs
//! and no host integer operations.

use mandelbrot_proof_fixed_air::{
    BoundedU18Witness,
    FixedLinearWitness,
    FixedMandelbrotTransitionWitness,
    FixedProductCarryRangeWitness,
    FixedProductWitness,
    RadixRangeWitness,
    convolution_is_safe_below,
    convolution_left_index,
    convolution_right_index,
    convolution_term_count,
    derive_fixed_product_carry_range_witness,
    derive_radix_range_witness,
    product_carry_bound,
}
use mandelbrot_proof_recursive::ComplexFixed
use precision::fixed::Fixed
use precision::polynomial::Radix2Field

pub struct AirRadixLimbRange<F: Radix2Field> {
    pub bits: [F; 13],
    pub nonzero_prefix: [F; 13],
}
impl<F: Radix2Field> core::marker::Copy for AirRadixLimbRange<F> {}

pub struct AirRadixRange<F: Radix2Field, const L: usize> {
    pub limbs: [AirRadixLimbRange<F>; L],
    pub nonzero: F,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy for AirRadixRange<F, L> {}

pub struct AirRangedDigits<F: Radix2Field, const L: usize> {
    pub digits: [F; L],
    pub range: AirRadixRange<F, L>,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy for AirRangedDigits<F, L> {}

pub struct AirRangedFixed<F: Radix2Field, const L: usize> {
    pub negative: F,
    pub magnitude: AirRangedDigits<F, L>,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy for AirRangedFixed<F, L> {}

pub struct AirBoundedU18<F: Radix2Field> {
    pub bits: [F; 18],
    pub slack_bits: [F; 18],
}
impl<F: Radix2Field> core::marker::Copy for AirBoundedU18<F> {}

pub struct AirProductCarryRange<F: Radix2Field, const L: usize> {
    pub low: [AirBoundedU18<F>; L],
    pub high: [AirBoundedU18<F>; L],
}
impl<F: Radix2Field, const L: usize> core::marker::Copy
    for AirProductCarryRange<F, L> {}

pub struct AirProduct<F: Radix2Field, const L: usize> {
    pub valid: F,
    pub low: AirRangedDigits<F, L>,
    pub low_carries: [F; L],
    pub high: AirRangedDigits<F, L>,
    pub high_carries: [F; L],
    pub round_up: F,
    pub round_carries: [F; L],
    pub round_overflow: F,
    pub output: AirRangedFixed<F, L>,
    pub carry_range: AirProductCarryRange<F, L>,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy for AirProduct<F, L> {}

pub struct AirLinear<F: Radix2Field, const L: usize> {
    pub valid: F,
    pub same_sign: F,
    pub select_right: F,
    pub output_nonzero: F,
    pub sum: AirRangedDigits<F, L>,
    pub sum_carries: [F; L],
    pub left_difference: AirRangedDigits<F, L>,
    pub left_borrows: [F; L],
    pub right_difference: AirRangedDigits<F, L>,
    pub right_borrows: [F; L],
    pub output: AirRangedFixed<F, L>,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy for AirLinear<F, L> {}

pub struct AirComplex<F: Radix2Field, const L: usize> {
    pub real: AirRangedFixed<F, L>,
    pub imaginary: AirRangedFixed<F, L>,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy for AirComplex<F, L> {}

pub struct AirMandelbrotTransition<F: Radix2Field, const L: usize> {
    pub valid: F,
    pub point: AirComplex<F, L>,
    pub current: AirComplex<F, L>,
    pub next: AirComplex<F, L>,
    pub xx: AirProduct<F, L>,
    pub yy: AirProduct<F, L>,
    pub xy: AirProduct<F, L>,
    pub real_difference: AirLinear<F, L>,
    pub next_real: AirLinear<F, L>,
    pub double_xy: AirLinear<F, L>,
    pub next_imaginary: AirLinear<F, L>,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy
    for AirMandelbrotTransition<F, L> {}

pub struct FixedAirConstraintEvaluation<F: Radix2Field> {
    pub valid: bool,
    pub constraints: u32,
    pub folded: F,
}
impl<F: Radix2Field> core::marker::Copy for FixedAirConstraintEvaluation<F> {}

pub enum ProductNode {
    Xx,
    Yy,
    Xy,
    Invalid,
}
impl core::marker::Copy for ProductNode {}

pub enum LinearNode {
    RealDifference,
    NextReal,
    DoubleXy,
    NextImaginary,
    Invalid,
}
impl core::marker::Copy for LinearNode {}

pub enum CoordinateNode {
    Real,
    Imaginary,
    Invalid,
}
impl core::marker::Copy for CoordinateNode {}

pub enum LinearLimbRole {
    Sum,
    LeftDifference,
    RightDifference,
    Select,
    Invalid,
}
impl core::marker::Copy for LinearLimbRole {}

/// Nominal radix vectors in the recurrence DAG. Product and linear payloads
/// keep the plan hierarchical, avoiding a manually numbered 31-vector table.
pub enum RangeNode {
    PointReal,
    PointImaginary,
    CurrentReal,
    CurrentImaginary,
    NextReal,
    NextImaginary,
    ProductLow(ProductNode),
    ProductHigh(ProductNode),
    ProductOutput(ProductNode),
    LinearSum(LinearNode),
    LinearLeftDifference(LinearNode),
    LinearRightDifference(LinearNode),
    LinearOutput(LinearNode),
    Invalid,
}
impl core::marker::Copy for RangeNode {}

/// One generated unit in the sparse transition trace. Each variant is a
/// semantic phase, and its payload is enough for scalar, packed, subgroup, or
/// workgroup interpreters to choose placement without changing the relation.
pub enum SparseTransitionTask {
    RadixBit(RangeNode, u32, u32),
    RadixLimb(RangeNode, u32),
    RadixFinish(RangeNode),
    CarryBit(ProductNode, u32, bool, u32),
    CarryFinish(ProductNode, u32),
    ProductTerm(ProductNode, u32, u32),
    ProductCoefficient(ProductNode, u32),
    ProductRound(ProductNode, u32),
    ProductFinish(ProductNode),
    LinearLimb(LinearNode, LinearLimbRole, u32),
    LinearFinish(LinearNode),
    BoundarySign(CoordinateNode),
    BoundaryLimb(CoordinateNode, u32),
    TransitionFinish,
    Invalid,
}
impl core::marker::Copy for SparseTransitionTask {}

/// Uniform witness columns used by the sparse interpreters. A task gives the
/// columns their local meaning. The two accumulator pairs are deliberately
/// generic so the same trace shape can host radix reconstruction, carry bit
/// reconstruction, convolution reduction, and linear ripples.
pub struct SparseTaskRow<F: Radix2Field> {
    pub value: F,
    pub auxiliary: F,
    pub accumulator_before: F,
    pub accumulator_after: F,
    pub state_before: F,
    pub state_after: F,
}
impl<F: Radix2Field> core::marker::Copy for SparseTaskRow<F> {}

/// Nominal addresses for values copied between distant sparse phases. The
/// field key is derived from this type, so application code never maintains a
/// numeric column or memory-address table.
pub enum SparseCopyAddress {
    RangeDigit(RangeNode, u32),
    RangeBit(RangeNode, u32, u32),
    RangeSign(RangeNode),
    RangeNonzero(RangeNode),
    ProductCarry(ProductNode, u32),
    LinearBorrow(LinearNode, bool),
    LinearSameSign(LinearNode),
    LinearSelectRight(LinearNode),
    Invalid,
}
impl core::marker::Copy for SparseCopyAddress {}

pub const fn sparse_range_node_count() -> u32 { 31 }
pub const fn sparse_product_node_count() -> u32 { 3 }
pub const fn sparse_linear_node_count() -> u32 { 4 }

pub const fn sparse_radix_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    let ranges = sparse_range_node_count()
    ranges * (limbs * 14 + 1)
}

pub const fn sparse_carry_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    sparse_product_node_count() * limbs * 2 * 37
}

pub const fn sparse_product_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    sparse_product_node_count() * (limbs * limbs + limbs + limbs)
}

pub const fn sparse_round_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    sparse_product_node_count() * (limbs + 1)
}

pub const fn sparse_linear_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    sparse_linear_node_count() * (limbs * 4 + 1)
}

pub const fn sparse_boundary_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    2 * (limbs + 1) + 1
}

pub const fn sparse_transition_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    3 * limbs * limbs + 683 * limbs + 41
}

pub const fn sparse_transition_trace_length<const L: usize>() -> u32 {
    let tasks = sparse_transition_task_count<L>()
    let mut length: u32 = 1
    while length < tasks { length = length + length }
    length
}

pub const fn sparse_transition_trace_log<const L: usize>() -> u32 {
    let target = sparse_transition_trace_length<L>()
    let mut length: u32 = 1
    let mut log: u32 = 0
    while length < target {
        length = length + length
        log = log + 1
    }
    log
}

fn product_node_at(_ index: u32) -> ProductNode {
    match index {
        0 => ProductNode::Xx,
        1 => ProductNode::Yy,
        2 => ProductNode::Xy,
        _ => ProductNode::Invalid,
    }
}

fn linear_node_at(_ index: u32) -> LinearNode {
    match index {
        0 => LinearNode::RealDifference,
        1 => LinearNode::NextReal,
        2 => LinearNode::DoubleXy,
        3 => LinearNode::NextImaginary,
        _ => LinearNode::Invalid,
    }
}

fn coordinate_node_at(_ index: u32) -> CoordinateNode {
    match index {
        0 => CoordinateNode::Real,
        1 => CoordinateNode::Imaginary,
        _ => CoordinateNode::Invalid,
    }
}

fn linear_limb_role_at(_ index: u32) -> LinearLimbRole {
    match index {
        0 => LinearLimbRole::Sum,
        1 => LinearLimbRole::LeftDifference,
        2 => LinearLimbRole::RightDifference,
        3 => LinearLimbRole::Select,
        _ => LinearLimbRole::Invalid,
    }
}

fn range_node_at(_ index: u32) -> RangeNode {
    match index {
        0 => RangeNode::PointReal,
        1 => RangeNode::PointImaginary,
        2 => RangeNode::CurrentReal,
        3 => RangeNode::CurrentImaginary,
        4 => RangeNode::NextReal,
        5 => RangeNode::NextImaginary,
        _ => {
            if index < 15 {
                let local = index - 6
                let product = product_node_at(local / 3)
                match local - (local / 3) * 3 {
                    0 => RangeNode::ProductLow(product),
                    1 => RangeNode::ProductHigh(product),
                    _ => RangeNode::ProductOutput(product),
                }
            } else {
                if index < 31 {
                    let local = index - 15
                    let linear = linear_node_at(local / 4)
                    match local - (local / 4) * 4 {
                        0 => RangeNode::LinearSum(linear),
                        1 => RangeNode::LinearLeftDifference(linear),
                        2 => RangeNode::LinearRightDifference(linear),
                        _ => RangeNode::LinearOutput(linear),
                    }
                } else {
                    RangeNode::Invalid
                }
            }
        }
    }
}

/// Interleave every convolution coefficient with the terms that reduce into
/// it. This makes the accumulator at the end of one term row directly
/// available to the coefficient row, without a lookup into a distant phase.
fn sparse_product_work_at<const L: usize>(
    _ product: ProductNode,
    _ rank: u32,
) -> SparseTransitionTask {
    let limbs: u32 = L.downcast_truncate()
    let mut coefficient: u32 = 0
    let mut remaining = rank
    while coefficient < limbs + limbs {
        let terms = convolution_term_count<L>(coefficient)
        if remaining < terms {
            return SparseTransitionTask::ProductTerm(
                product,
                coefficient,
                remaining,
            )
        }
        remaining = remaining - terms
        if remaining == 0 {
            return SparseTransitionTask::ProductCoefficient(product, coefficient)
        }
        remaining = remaining - 1
        coefficient = coefficient + 1
    }
    SparseTransitionTask::Invalid
}

pub fn sparse_transition_task_at<const L: usize>(
    _ index: u32,
) -> SparseTransitionTask {
    if L < 2 || index >= sparse_transition_task_count<L>() {
        return SparseTransitionTask::Invalid
    }
    let limbs: u32 = L.downcast_truncate()
    let ranges = sparse_range_node_count()
    let products = sparse_product_node_count()
    let linears = sparse_linear_node_count()
    let mut remaining = index

    let radix_rows = ranges * (limbs * 14 + 1)
    if remaining < radix_rows {
        let per_range = limbs * 14 + 1
        let range_index = remaining / per_range
        let local = remaining - range_index * per_range
        if local < limbs * 14 {
            let limb = local / 14
            let within = local - limb * 14
            if within < 13 {
                return SparseTransitionTask::RadixBit(
                    range_node_at(range_index),
                    limb,
                    within,
                )
            }
            return SparseTransitionTask::RadixLimb(
                range_node_at(range_index),
                limb,
            )
        }
        return SparseTransitionTask::RadixFinish(range_node_at(range_index))
    }
    remaining = remaining - radix_rows

    let carry_rows = products * limbs * 2 * 37
    if remaining < carry_rows {
        let per_product = limbs * 2 * 37
        let product_index = remaining / per_product
        let local = remaining - product_index * per_product
        let coefficient = local / 37
        let within = local - coefficient * 37
        if within < 36 {
            return SparseTransitionTask::CarryBit(
                product_node_at(product_index),
                coefficient,
                within >= 18,
                if within >= 18 { within - 18 } else { within },
            )
        }
        return SparseTransitionTask::CarryFinish(
            product_node_at(product_index),
            coefficient,
        )
    }
    remaining = remaining - carry_rows

    let product_rows = products * (limbs * limbs + limbs + limbs)
    if remaining < product_rows {
        let per_product = limbs * limbs + limbs + limbs
        return sparse_product_work_at<L>(
            product_node_at(remaining / per_product),
            remaining - (remaining / per_product) * per_product,
        )
    }
    remaining = remaining - product_rows

    let product_round_rows = products * (limbs + 1)
    if remaining < product_round_rows {
        let per_product = limbs + 1
        let product_index = remaining / per_product
        let local = remaining - product_index * per_product
        if local < limbs {
            return SparseTransitionTask::ProductRound(
                product_node_at(product_index),
                local,
            )
        }
        return SparseTransitionTask::ProductFinish(product_node_at(product_index))
    }
    remaining = remaining - product_round_rows

    let linear_rows = linears * (limbs * 4 + 1)
    if remaining < linear_rows {
        let per_linear = limbs * 4 + 1
        let linear_index = remaining / per_linear
        let local = remaining - linear_index * per_linear
        if local < limbs * 4 {
            return SparseTransitionTask::LinearLimb(
                linear_node_at(linear_index),
                linear_limb_role_at(local / limbs),
                local - (local / limbs) * limbs,
            )
        }
        return SparseTransitionTask::LinearFinish(linear_node_at(linear_index))
    }
    remaining = remaining - linear_rows

    if remaining < 2 * (limbs + 1) {
        let per_coordinate = limbs + 1
        let coordinate_index = remaining / per_coordinate
        let local = remaining - coordinate_index * per_coordinate
        if local == 0 {
            return SparseTransitionTask::BoundarySign(
                coordinate_node_at(coordinate_index),
            )
        }
        return SparseTransitionTask::BoundaryLimb(
            coordinate_node_at(coordinate_index),
            local - 1,
        )
    }
    SparseTransitionTask::TransitionFinish
}

fn range_node_digits<const L: usize>(
    _ node: RangeNode,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> [u32; L] {
    match node {
        RangeNode::PointReal => point.real.limbs,
        RangeNode::PointImaginary => point.imaginary.limbs,
        RangeNode::CurrentReal => current.real.limbs,
        RangeNode::CurrentImaginary => current.imaginary.limbs,
        RangeNode::NextReal => next.real.limbs,
        RangeNode::NextImaginary => next.imaginary.limbs,
        RangeNode::ProductLow(ProductNode::Xx) => witness.xx.low_digits,
        RangeNode::ProductHigh(ProductNode::Xx) => witness.xx.high_digits,
        RangeNode::ProductOutput(ProductNode::Xx) => witness.xx.output.limbs,
        RangeNode::ProductLow(ProductNode::Yy) => witness.yy.low_digits,
        RangeNode::ProductHigh(ProductNode::Yy) => witness.yy.high_digits,
        RangeNode::ProductOutput(ProductNode::Yy) => witness.yy.output.limbs,
        RangeNode::ProductLow(ProductNode::Xy) => witness.xy.low_digits,
        RangeNode::ProductHigh(ProductNode::Xy) => witness.xy.high_digits,
        RangeNode::ProductOutput(ProductNode::Xy) => witness.xy.output.limbs,
        RangeNode::LinearSum(LinearNode::RealDifference) => {
            witness.real_difference.sum_digits
        }
        RangeNode::LinearLeftDifference(LinearNode::RealDifference) => {
            witness.real_difference.left_difference_digits
        }
        RangeNode::LinearRightDifference(LinearNode::RealDifference) => {
            witness.real_difference.right_difference_digits
        }
        RangeNode::LinearOutput(LinearNode::RealDifference) => {
            witness.real_difference.output.limbs
        }
        RangeNode::LinearSum(LinearNode::NextReal) => witness.next_real.sum_digits,
        RangeNode::LinearLeftDifference(LinearNode::NextReal) => {
            witness.next_real.left_difference_digits
        }
        RangeNode::LinearRightDifference(LinearNode::NextReal) => {
            witness.next_real.right_difference_digits
        }
        RangeNode::LinearOutput(LinearNode::NextReal) => witness.next_real.output.limbs,
        RangeNode::LinearSum(LinearNode::DoubleXy) => witness.double_xy.sum_digits,
        RangeNode::LinearLeftDifference(LinearNode::DoubleXy) => {
            witness.double_xy.left_difference_digits
        }
        RangeNode::LinearRightDifference(LinearNode::DoubleXy) => {
            witness.double_xy.right_difference_digits
        }
        RangeNode::LinearOutput(LinearNode::DoubleXy) => witness.double_xy.output.limbs,
        RangeNode::LinearSum(LinearNode::NextImaginary) => {
            witness.next_imaginary.sum_digits
        }
        RangeNode::LinearLeftDifference(LinearNode::NextImaginary) => {
            witness.next_imaginary.left_difference_digits
        }
        RangeNode::LinearRightDifference(LinearNode::NextImaginary) => {
            witness.next_imaginary.right_difference_digits
        }
        RangeNode::LinearOutput(LinearNode::NextImaginary) => {
            witness.next_imaginary.output.limbs
        }
        _ => [0; L],
    }
}

fn range_node_is_signed(_ node: RangeNode) -> bool {
    match node {
        RangeNode::PointReal => true,
        RangeNode::PointImaginary => true,
        RangeNode::CurrentReal => true,
        RangeNode::CurrentImaginary => true,
        RangeNode::NextReal => true,
        RangeNode::NextImaginary => true,
        RangeNode::ProductOutput(_) => true,
        RangeNode::LinearOutput(_) => true,
        _ => false,
    }
}

fn range_node_is_product_output(_ node: RangeNode) -> bool {
    match node {
        RangeNode::ProductOutput(_) => true,
        _ => false,
    }
}

fn range_node_negative<const L: usize>(
    _ node: RangeNode,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> bool {
    match node {
        RangeNode::PointReal => point.real.negative,
        RangeNode::PointImaginary => point.imaginary.negative,
        RangeNode::CurrentReal => current.real.negative,
        RangeNode::CurrentImaginary => current.imaginary.negative,
        RangeNode::NextReal => next.real.negative,
        RangeNode::NextImaginary => next.imaginary.negative,
        RangeNode::ProductOutput(ProductNode::Xx) => witness.xx.output.negative,
        RangeNode::ProductOutput(ProductNode::Yy) => witness.yy.output.negative,
        RangeNode::ProductOutput(ProductNode::Xy) => witness.xy.output.negative,
        RangeNode::LinearOutput(LinearNode::RealDifference) => {
            witness.real_difference.output.negative
        }
        RangeNode::LinearOutput(LinearNode::NextReal) => {
            witness.next_real.output.negative
        }
        RangeNode::LinearOutput(LinearNode::DoubleXy) => {
            witness.double_xy.output.negative
        }
        RangeNode::LinearOutput(LinearNode::NextImaginary) => {
            witness.next_imaginary.output.negative
        }
        _ => false,
    }
}

fn radix_prefix_before<const L: usize>(
    _ range: RadixRangeWitness<L>,
    _ limb: u32,
    _ bit: u32,
) -> u32 {
    if bit > 0 {
        range.limbs[limb as usize].nonzero_prefix[(bit - 1) as usize]
    } else {
        if limb > 0 {
            range.limbs[(limb - 1) as usize].nonzero_prefix[12]
        } else {
            0
        }
    }
}

fn radix_reconstruction_before<const L: usize>(
    _ range: RadixRangeWitness<L>,
    _ limb: u32,
    _ bit: u32,
) -> u32 {
    let mut reconstructed: u32 = 0
    let mut index: u32 = 0
    let mut place: u32 = 1
    while index < bit {
        reconstructed = reconstructed
            + range.limbs[limb as usize].bits[index as usize] * place
        place = place + place
        index = index + 1
    }
    reconstructed
}

fn empty_sparse_row<F: Radix2Field>() -> SparseTaskRow<F> {
    SparseTaskRow {
        value: zero<F>(),
        auxiliary: zero<F>(),
        accumulator_before: zero<F>(),
        accumulator_after: zero<F>(),
        state_before: zero<F>(),
        state_after: zero<F>(),
    }
}

/// Derive one narrow radix row from the exact transition witness. Only six
/// field columns cross this interpretation boundary, regardless of precision.
pub fn sparse_radix_row_from_witness<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    match task {
        SparseTransitionTask::RadixBit(node, limb, bit) => {
            let digits = range_node_digits(node, point, current, next, witness)
            let range = derive_radix_range_witness(digits)
            let before = radix_reconstruction_before(range, limb, bit)
            let value = range.limbs[limb as usize].bits[bit as usize]
            SparseTaskRow {
                value: natural<F>(value),
                auxiliary: zero<F>(),
                accumulator_before: natural<F>(before),
                accumulator_after: natural<F>(before + value * (1 << bit)),
                state_before: natural<F>(radix_prefix_before(range, limb, bit)),
                state_after: natural<F>(
                    range.limbs[limb as usize].nonzero_prefix[bit as usize],
                ),
            }
        }
        SparseTransitionTask::RadixLimb(node, limb) => {
            let digits = range_node_digits(node, point, current, next, witness)
            let range = derive_radix_range_witness(digits)
            let prefix = range.limbs[limb as usize].nonzero_prefix[12]
            SparseTaskRow {
                value: natural<F>(digits[limb as usize]),
                auxiliary: zero<F>(),
                accumulator_before: natural<F>(
                    radix_reconstruction_before(range, limb, 13),
                ),
                accumulator_after: zero<F>(),
                state_before: natural<F>(prefix),
                state_after: natural<F>(prefix),
            }
        }
        SparseTransitionTask::RadixFinish(node) => {
            let digits = range_node_digits(node, point, current, next, witness)
            let range = derive_radix_range_witness(digits)
            SparseTaskRow {
                value: boolean<F>(range.nonzero),
                auxiliary: boolean<F>(
                    range_node_negative(node, point, current, next, witness),
                ),
                accumulator_before: zero<F>(),
                accumulator_after: zero<F>(),
                state_before: natural<F>(range.limbs[L - 1].nonzero_prefix[12]),
                state_after: zero<F>(),
            }
        }
        _ => empty_sparse_row<F>(),
    }
}

fn product_node_witness<const L: usize>(
    _ node: ProductNode,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> FixedProductWitness<L> {
    match node {
        ProductNode::Xx => witness.xx,
        ProductNode::Yy => witness.yy,
        ProductNode::Xy => witness.xy,
        ProductNode::Invalid => witness.xx,
    }
}

fn fixed_product_carry<const L: usize>(
    _ product: FixedProductWitness<L>,
    _ coefficient: u32,
) -> u32 {
    let limbs: u32 = L.downcast_truncate()
    if coefficient < limbs {
        product.low_carries[coefficient as usize]
    } else {
        product.high_carries[(coefficient - limbs) as usize]
    }
}

fn fixed_product_bounded_carry<const L: usize>(
    _ range: FixedProductCarryRangeWitness<L>,
    _ coefficient: u32,
) -> BoundedU18Witness {
    let limbs: u32 = L.downcast_truncate()
    if coefficient < limbs {
        range.low[coefficient as usize]
    } else {
        range.high[(coefficient - limbs) as usize]
    }
}

fn bits18_reconstruction_before(_ bits: [u32; 18], _ bit: u32) -> u32 {
    let mut reconstructed: u32 = 0
    let mut index: u32 = 0
    let mut place: u32 = 1
    while index < bit {
        reconstructed = reconstructed + bits[index as usize] * place
        place = place + place
        index = index + 1
    }
    reconstructed
}

/// Interpret one bounded product-carry task through the same six-column row.
/// The value-bit scan occupies the first accumulator. The slack scan resets
/// that accumulator and retains the reconstructed carry in the second pair.
pub fn sparse_carry_row_from_witness<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    match task {
        SparseTransitionTask::CarryBit(node, coefficient, slack, bit) => {
            let product = product_node_witness(node, witness)
            let range = derive_fixed_product_carry_range_witness(product)
            let bounded = fixed_product_bounded_carry(range, coefficient)
            let bits = if slack { bounded.slack_bits } else { bounded.bits }
            let before = bits18_reconstruction_before(bits, bit)
            let value = bits[bit as usize]
            let retained = if slack {
                fixed_product_carry(product, coefficient)
            } else {
                0
            }
            SparseTaskRow {
                value: natural<F>(value),
                auxiliary: zero<F>(),
                accumulator_before: natural<F>(before),
                accumulator_after: natural<F>(before + value * (1 << bit)),
                state_before: natural<F>(retained),
                state_after: natural<F>(retained),
            }
        }
        SparseTransitionTask::CarryFinish(node, coefficient) => {
            let product = product_node_witness(node, witness)
            let range = derive_fixed_product_carry_range_witness(product)
            let bounded = fixed_product_bounded_carry(range, coefficient)
            SparseTaskRow {
                value: natural<F>(fixed_product_carry(product, coefficient)),
                auxiliary: zero<F>(),
                accumulator_before: natural<F>(
                    bits18_reconstruction_before(bounded.slack_bits, 18),
                ),
                accumulator_after: zero<F>(),
                state_before: natural<F>(
                    bits18_reconstruction_before(bounded.bits, 18),
                ),
                state_after: zero<F>(),
            }
        }
        _ => empty_sparse_row<F>(),
    }
}

fn product_left_value<const L: usize>(
    _ node: ProductNode,
    _ current: ComplexFixed<L>,
) -> Fixed<L> {
    match node {
        ProductNode::Xx => current.real,
        ProductNode::Yy => current.imaginary,
        ProductNode::Xy => current.real,
        ProductNode::Invalid => current.real,
    }
}

fn product_right_value<const L: usize>(
    _ node: ProductNode,
    _ current: ComplexFixed<L>,
) -> Fixed<L> {
    match node {
        ProductNode::Xx => current.real,
        ProductNode::Yy => current.imaginary,
        ProductNode::Xy => current.imaginary,
        ProductNode::Invalid => current.real,
    }
}

fn fixed_product_digit<const L: usize>(
    _ product: FixedProductWitness<L>,
    _ coefficient: u32,
) -> u32 {
    let limbs: u32 = L.downcast_truncate()
    if coefficient < limbs {
        product.low_digits[coefficient as usize]
    } else {
        product.high_digits[(coefficient - limbs) as usize]
    }
}

fn product_term_accumulator_before<const L: usize>(
    _ left: Fixed<L>,
    _ right: Fixed<L>,
    _ coefficient: u32,
    _ term: u32,
) -> u32 {
    let mut accumulator: u32 = 0
    let mut index: u32 = 0
    while index < term {
        let left_index = convolution_left_index<L>(coefficient, index)
        let right_index = convolution_right_index<L>(coefficient, index)
        accumulator = accumulator
            + left.limbs[left_index as usize] * right.limbs[right_index as usize]
        index = index + 1
    }
    accumulator
}

/// One convolution term or coefficient close in the shared six-column row.
/// Term products form an explicit reduction scan. The coefficient close
/// applies the incoming carry, emits the normalized digit and outgoing carry,
/// resets the reduction accumulator, and forwards the carry to the next
/// coefficient.
pub fn sparse_product_row_from_witness<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
    _ current: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    match task {
        SparseTransitionTask::ProductTerm(node, coefficient, term) => {
            let left = product_left_value(node, current)
            let right = product_right_value(node, current)
            let left_index = convolution_left_index<L>(coefficient, term)
            let right_index = convolution_right_index<L>(coefficient, term)
            let left_digit = left.limbs[left_index as usize]
            let right_digit = right.limbs[right_index as usize]
            let before = product_term_accumulator_before(
                left,
                right,
                coefficient,
                term,
            )
            let carry_in = if coefficient == 0 {
                0
            } else {
                fixed_product_carry(
                    product_node_witness(node, witness),
                    coefficient - 1,
                )
            }
            SparseTaskRow {
                value: natural<F>(left_digit),
                auxiliary: natural<F>(right_digit),
                accumulator_before: natural<F>(before),
                accumulator_after: natural<F>(before + left_digit * right_digit),
                state_before: natural<F>(carry_in),
                state_after: natural<F>(carry_in),
            }
        }
        SparseTransitionTask::ProductCoefficient(node, coefficient) => {
            let product = product_node_witness(node, witness)
            let left = product_left_value(node, current)
            let right = product_right_value(node, current)
            let terms = convolution_term_count<L>(coefficient)
            let carry_in = if coefficient == 0 {
                0
            } else {
                fixed_product_carry(product, coefficient - 1)
            }
            let carry_out = fixed_product_carry(product, coefficient)
            SparseTaskRow {
                value: natural<F>(fixed_product_digit(product, coefficient)),
                auxiliary: natural<F>(carry_out),
                accumulator_before: natural<F>(product_term_accumulator_before(
                    left,
                    right,
                    coefficient,
                    terms,
                )),
                accumulator_after: zero<F>(),
                state_before: natural<F>(carry_in),
                state_after: natural<F>(carry_out),
            }
        }
        _ => empty_sparse_row<F>(),
    }
}

fn fixed_product_retained_digit<const L: usize>(
    _ product: FixedProductWitness<L>,
    _ output_index: u32,
) -> u32 {
    if output_index == 0 {
        product.low_digits[L - 1]
    } else {
        product.high_digits[(output_index - 1) as usize]
    }
}

/// The rounding ripple reuses the arithmetic row. Its state pair retains the
/// guard-bit decision across all limbs. The finish row then reuses the six
/// fields for the final carry and four sign inputs; product groups reset
/// explicitly instead of linking those semantic fields into the next group.
pub fn sparse_round_row_from_witness<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
    _ current: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    match task {
        SparseTransitionTask::ProductRound(node, output_index) => {
            let product = product_node_witness(node, witness)
            let round_up = if product.round_up { 1 } else { 0 }
            let carry_in = if output_index == 0 {
                round_up
            } else {
                product.round_carries[(output_index - 1) as usize]
            }
            SparseTaskRow {
                value: natural<F>(fixed_product_retained_digit(product, output_index)),
                auxiliary: natural<F>(product.output.limbs[output_index as usize]),
                accumulator_before: natural<F>(carry_in),
                accumulator_after: natural<F>(
                    product.round_carries[output_index as usize],
                ),
                state_before: natural<F>(round_up),
                state_after: natural<F>(round_up),
            }
        }
        SparseTransitionTask::ProductFinish(node) => {
            let product = product_node_witness(node, witness)
            let left = product_left_value(node, current)
            let right = product_right_value(node, current)
            let output_range = derive_radix_range_witness(product.output.limbs)
            SparseTaskRow {
                value: boolean<F>(product.output.negative),
                auxiliary: boolean<F>(output_range.nonzero),
                accumulator_before: natural<F>(product.round_carries[L - 1]),
                accumulator_after: boolean<F>(left.negative),
                state_before: boolean<F>(product.round_up),
                state_after: boolean<F>(right.negative),
            }
        }
        _ => empty_sparse_row<F>(),
    }
}

fn linear_node_witness<const L: usize>(
    _ node: LinearNode,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> FixedLinearWitness<L> {
    match node {
        LinearNode::RealDifference => witness.real_difference,
        LinearNode::NextReal => witness.next_real,
        LinearNode::DoubleXy => witness.double_xy,
        LinearNode::NextImaginary => witness.next_imaginary,
        LinearNode::Invalid => witness.real_difference,
    }
}

fn linear_left_value<const L: usize>(
    _ node: LinearNode,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> Fixed<L> {
    match node {
        LinearNode::RealDifference => witness.xx.output,
        LinearNode::NextReal => witness.real_difference.output,
        LinearNode::DoubleXy => witness.xy.output,
        LinearNode::NextImaginary => witness.double_xy.output,
        LinearNode::Invalid => witness.xx.output,
    }
}

fn linear_right_value<const L: usize>(
    _ node: LinearNode,
    _ point: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> Fixed<L> {
    match node {
        LinearNode::RealDifference => witness.yy.output,
        LinearNode::NextReal => point.real,
        LinearNode::DoubleXy => witness.xy.output,
        LinearNode::NextImaginary => point.imaginary,
        LinearNode::Invalid => witness.yy.output,
    }
}

fn linear_subtracts_right(_ node: LinearNode) -> bool {
    match node {
        LinearNode::RealDifference => true,
        _ => false,
    }
}

/// Four role-specific rows keep each signed linear limb narrow. Carry and
/// borrow roles form independent adjacency chains; selection consumes their
/// range-constrained digits through the linear copy bus.
pub fn sparse_linear_row_from_witness<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
    _ point: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    match task {
        SparseTransitionTask::LinearLimb(node, role, limb) => {
            let linear = linear_node_witness(node, witness)
            let left = linear_left_value(node, witness)
            let right = linear_right_value(node, point, witness)
            match role {
                LinearLimbRole::Sum => SparseTaskRow {
                    value: natural<F>(left.limbs[limb as usize]),
                    auxiliary: natural<F>(right.limbs[limb as usize]),
                    accumulator_before: natural<F>(if limb == 0 {
                        0
                    } else {
                        linear.sum_carries[(limb - 1) as usize]
                    }),
                    accumulator_after: natural<F>(linear.sum_carries[limb as usize]),
                    state_before: natural<F>(linear.sum_digits[limb as usize]),
                    state_after: zero<F>(),
                },
                LinearLimbRole::LeftDifference => SparseTaskRow {
                    value: natural<F>(left.limbs[limb as usize]),
                    auxiliary: natural<F>(right.limbs[limb as usize]),
                    accumulator_before: natural<F>(if limb == 0 {
                        0
                    } else {
                        linear.left_borrows[(limb - 1) as usize]
                    }),
                    accumulator_after: natural<F>(linear.left_borrows[limb as usize]),
                    state_before: natural<F>(
                        linear.left_difference_digits[limb as usize],
                    ),
                    state_after: zero<F>(),
                },
                LinearLimbRole::RightDifference => SparseTaskRow {
                    value: natural<F>(left.limbs[limb as usize]),
                    auxiliary: natural<F>(right.limbs[limb as usize]),
                    accumulator_before: natural<F>(if limb == 0 {
                        0
                    } else {
                        linear.right_borrows[(limb - 1) as usize]
                    }),
                    accumulator_after: natural<F>(linear.right_borrows[limb as usize]),
                    state_before: natural<F>(
                        linear.right_difference_digits[limb as usize],
                    ),
                    state_after: zero<F>(),
                },
                LinearLimbRole::Select => SparseTaskRow {
                    value: natural<F>(linear.sum_digits[limb as usize]),
                    auxiliary: natural<F>(
                        linear.left_difference_digits[limb as usize],
                    ),
                    accumulator_before: natural<F>(
                        linear.right_difference_digits[limb as usize],
                    ),
                    accumulator_after: natural<F>(linear.output.limbs[limb as usize]),
                    state_before: boolean<F>(linear.same_sign),
                    state_after: boolean<F>(linear.select_right),
                },
                LinearLimbRole::Invalid => empty_sparse_row<F>(),
            }
        }
        SparseTransitionTask::LinearFinish(node) => {
            let linear = linear_node_witness(node, witness)
            let left = linear_left_value(node, witness)
            let right = linear_right_value(node, point, witness)
            let output_range = derive_radix_range_witness(linear.output.limbs)
            SparseTaskRow {
                value: boolean<F>(left.negative),
                auxiliary: boolean<F>(right.negative),
                accumulator_before: natural<F>(linear.left_borrows[L - 1]),
                accumulator_after: natural<F>(linear.right_borrows[L - 1]),
                state_before: boolean<F>(output_range.nonzero),
                state_after: boolean<F>(linear.output.negative),
            }
        }
        _ => empty_sparse_row<F>(),
    }
}

fn boundary_computed<const L: usize>(
    _ coordinate: CoordinateNode,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> Fixed<L> {
    match coordinate {
        CoordinateNode::Real => witness.next_real.output,
        CoordinateNode::Imaginary => witness.next_imaginary.output,
        CoordinateNode::Invalid => witness.next_real.output,
    }
}

fn boundary_claimed<const L: usize>(
    _ coordinate: CoordinateNode,
    _ next: ComplexFixed<L>,
) -> Fixed<L> {
    match coordinate {
        CoordinateNode::Real => next.real,
        CoordinateNode::Imaginary => next.imaginary,
        CoordinateNode::Invalid => next.real,
    }
}

pub fn sparse_boundary_row_from_witness<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    match task {
        SparseTransitionTask::BoundarySign(coordinate) => {
            let computed = boundary_computed(coordinate, witness)
            let claimed = boundary_claimed(coordinate, next)
            SparseTaskRow {
                value: boolean<F>(computed.negative),
                auxiliary: boolean<F>(claimed.negative),
                accumulator_before: zero<F>(),
                accumulator_after: zero<F>(),
                state_before: zero<F>(),
                state_after: zero<F>(),
            }
        }
        SparseTransitionTask::BoundaryLimb(coordinate, limb) => {
            let computed = boundary_computed(coordinate, witness)
            let claimed = boundary_claimed(coordinate, next)
            SparseTaskRow {
                value: natural<F>(computed.limbs[limb as usize]),
                auxiliary: natural<F>(claimed.limbs[limb as usize]),
                accumulator_before: zero<F>(),
                accumulator_after: zero<F>(),
                state_before: zero<F>(),
                state_after: zero<F>(),
            }
        }
        SparseTransitionTask::TransitionFinish => SparseTaskRow {
            value: boolean<F>(witness.valid),
            auxiliary: zero<F>(),
            accumulator_before: zero<F>(),
            accumulator_after: zero<F>(),
            state_before: zero<F>(),
            state_after: zero<F>(),
        },
        _ => empty_sparse_row<F>(),
    }
}

fn zero<F: Radix2Field>() -> F { F::radix2_zero() }
fn one<F: Radix2Field>() -> F { F::radix2_root(0) }
fn add<F: Radix2Field>(_ left: F, _ right: F) -> F { left.radix2_add(right) }
fn sub<F: Radix2Field>(_ left: F, _ right: F) -> F { left.radix2_sub(right) }
fn mul<F: Radix2Field>(_ left: F, _ right: F) -> F { left.radix2_mul(right) }

fn natural<F: Radix2Field>(_ value: u32) -> F {
    let mut value = value
    let mut result = zero<F>()
    let mut place = one<F>()
    while value != 0 {
        if (value & 1) == 1 { result = add(result, place) }
        place = add(place, place)
        value = value >> 1
    }
    result
}

fn boolean<F: Radix2Field>(_ value: bool) -> F {
    natural<F>(if value { 1 } else { 0 })
}

fn field_words<F: Radix2Field, const N: usize>(_ words: [u32; N]) -> [F; N] {
    let mut output = [zero<F>(); N]
    let mut index: usize = 0
    while index < N {
        output[index] = natural<F>(words[index])
        index = index + 1
    }
    output
}

fn air_radix_range<F: Radix2Field, const L: usize>(
    _ witness: RadixRangeWitness<L>,
) -> AirRadixRange<F, L> {
    let empty = AirRadixLimbRange {
        bits: [zero<F>(); 13],
        nonzero_prefix: [zero<F>(); 13],
    }
    let mut limbs = [empty; L]
    let mut index: usize = 0
    while index < L {
        limbs[index] = AirRadixLimbRange {
            bits: field_words<F, 13>(witness.limbs[index].bits),
            nonzero_prefix: field_words<F, 13>(witness.limbs[index].nonzero_prefix),
        }
        index = index + 1
    }
    AirRadixRange { limbs: limbs, nonzero: boolean<F>(witness.nonzero) }
}

fn air_ranged_digits<F: Radix2Field, const L: usize>(
    _ digits: [u32; L],
) -> AirRangedDigits<F, L> {
    AirRangedDigits {
        digits: field_words<F, L>(digits),
        range: air_radix_range<F, L>(derive_radix_range_witness(digits)),
    }
}

fn air_ranged_fixed<F: Radix2Field, const L: usize>(
    _ value: Fixed<L>,
) -> AirRangedFixed<F, L> {
    AirRangedFixed {
        negative: boolean<F>(value.negative),
        magnitude: air_ranged_digits<F, L>(value.limbs),
    }
}

fn air_bounded_u18<F: Radix2Field>(
    _ witness: BoundedU18Witness,
) -> AirBoundedU18<F> {
    AirBoundedU18 {
        bits: field_words<F, 18>(witness.bits),
        slack_bits: field_words<F, 18>(witness.slack_bits),
    }
}

fn air_carry_range<F: Radix2Field, const L: usize>(
    _ witness: FixedProductCarryRangeWitness<L>,
) -> AirProductCarryRange<F, L> {
    let empty = AirBoundedU18 {
        bits: [zero<F>(); 18],
        slack_bits: [zero<F>(); 18],
    }
    let mut low = [empty; L]
    let mut high = [empty; L]
    let mut index: usize = 0
    while index < L {
        low[index] = air_bounded_u18<F>(witness.low[index])
        high[index] = air_bounded_u18<F>(witness.high[index])
        index = index + 1
    }
    AirProductCarryRange { low: low, high: high }
}

fn air_product<F: Radix2Field, const L: usize>(
    _ witness: FixedProductWitness<L>,
) -> AirProduct<F, L> {
    AirProduct {
        valid: boolean<F>(witness.valid),
        low: air_ranged_digits<F, L>(witness.low_digits),
        low_carries: field_words<F, L>(witness.low_carries),
        high: air_ranged_digits<F, L>(witness.high_digits),
        high_carries: field_words<F, L>(witness.high_carries),
        round_up: boolean<F>(witness.round_up),
        round_carries: field_words<F, L>(witness.round_carries),
        round_overflow: boolean<F>(witness.round_overflow),
        output: air_ranged_fixed<F, L>(witness.output),
        carry_range: air_carry_range<F, L>(
            derive_fixed_product_carry_range_witness(witness),
        ),
    }
}

fn air_linear<F: Radix2Field, const L: usize>(
    _ witness: FixedLinearWitness<L>,
) -> AirLinear<F, L> {
    AirLinear {
        valid: boolean<F>(witness.valid),
        same_sign: boolean<F>(witness.same_sign),
        select_right: boolean<F>(witness.select_right),
        output_nonzero: boolean<F>(witness.output_nonzero),
        sum: air_ranged_digits<F, L>(witness.sum_digits),
        sum_carries: field_words<F, L>(witness.sum_carries),
        left_difference: air_ranged_digits<F, L>(witness.left_difference_digits),
        left_borrows: field_words<F, L>(witness.left_borrows),
        right_difference: air_ranged_digits<F, L>(witness.right_difference_digits),
        right_borrows: field_words<F, L>(witness.right_borrows),
        output: air_ranged_fixed<F, L>(witness.output),
    }
}

fn air_complex<F: Radix2Field, const L: usize>(
    _ value: ComplexFixed<L>,
) -> AirComplex<F, L> {
    AirComplex {
        real: air_ranged_fixed<F, L>(value.real),
        imaginary: air_ranged_fixed<F, L>(value.imaginary),
    }
}

pub fn transition_air_from_witness<F: Radix2Field, const L: usize>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> AirMandelbrotTransition<F, L> {
    AirMandelbrotTransition {
        valid: boolean<F>(witness.valid),
        point: air_complex<F, L>(point),
        current: air_complex<F, L>(current),
        next: air_complex<F, L>(next),
        xx: air_product<F, L>(witness.xx),
        yy: air_product<F, L>(witness.yy),
        xy: air_product<F, L>(witness.xy),
        real_difference: air_linear<F, L>(witness.real_difference),
        next_real: air_linear<F, L>(witness.next_real),
        double_xy: air_linear<F, L>(witness.double_xy),
        next_imaginary: air_linear<F, L>(witness.next_imaginary),
    }
}

struct ConstraintFold<F: Radix2Field> {
    challenge: F,
    power: F,
    value: F,
    constraints: u32,
}
impl<F: Radix2Field> core::marker::Copy for ConstraintFold<F> {}

impl<F: Radix2Field> ConstraintFold<F> {
    fn new(_ challenge: F) -> Self {
        Self {
            challenge: challenge,
            power: one<F>(),
            value: zero<F>(),
            constraints: 0,
        }
    }

    fn absorb(mut self, _ residual: F) -> Self {
        self.value = add(self.value, mul(self.power, residual))
        self.power = mul(self.power, self.challenge)
        self.constraints = self.constraints + 1
        self
    }
}

fn bit_residual<F: Radix2Field>(_ value: F) -> F {
    mul(value, sub(value, one<F>()))
}

fn absorb_sparse_radix_row<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    match task {
        SparseTransitionTask::RadixBit(_node, _limb, bit) => {
            fold = fold.absorb(bit_residual(row.value))
            fold = fold.absorb(bit_residual(row.state_after))
            fold = fold.absorb(sub(
                row.state_after,
                sub(
                    add(row.state_before, row.value),
                    mul(row.state_before, row.value),
                ),
            ))
            fold.absorb(sub(
                row.accumulator_after,
                add(
                    row.accumulator_before,
                    mul(row.value, natural<F>(1 << bit)),
                ),
            ))
        }
        SparseTransitionTask::RadixLimb(_node, _limb) => {
            fold = fold.absorb(sub(row.value, row.accumulator_before))
            fold = fold.absorb(row.accumulator_after)
            fold.absorb(sub(row.state_after, row.state_before))
        }
        SparseTransitionTask::RadixFinish(node) => {
            fold = fold.absorb(bit_residual(row.value))
            fold = fold.absorb(sub(row.value, row.state_before))
            fold = fold.absorb(row.accumulator_before)
            fold = fold.absorb(row.accumulator_after)
            fold = fold.absorb(row.state_after)
            if range_node_is_signed(node) {
                fold = fold.absorb(bit_residual(row.auxiliary))
                fold.absorb(mul(row.auxiliary, sub(one<F>(), row.value)))
            } else {
                fold.absorb(row.auxiliary)
            }
        }
        _ => fold.absorb(one<F>()),
    }
}

/// Local constraints for one radix task. Row adjacency is deliberately a
/// separate relation so scalar and parallel interpreters can choose their own
/// scan implementation without changing row semantics.
pub fn evaluate_sparse_radix_row<F: Radix2Field>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_radix_row(
        ConstraintFold<F>::new(challenge),
        task,
        row,
    )
    FixedAirConstraintEvaluation {
        valid: match task {
            SparseTransitionTask::RadixBit(_, _, _) => true,
            SparseTransitionTask::RadixLimb(_, _) => true,
            SparseTransitionTask::RadixFinish(_) => true,
            _ => false,
        },
        constraints: fold.constraints,
        folded: fold.value,
    }
}

/// The initial row and every adjacent pair use the same two accumulator
/// columns. The first row links to the all-zero virtual predecessor.
pub fn sparse_radix_initial_residuals<F: Radix2Field>(
    _ row: SparseTaskRow<F>,
) -> (F, F) {
    (row.accumulator_before, row.state_before)
}

pub fn sparse_radix_link_residuals<F: Radix2Field>(
    _ current: SparseTaskRow<F>,
    _ next: SparseTaskRow<F>,
) -> (F, F) {
    (
        sub(next.accumulator_before, current.accumulator_after),
        sub(next.state_before, current.state_after),
    )
}

fn absorb_sparse_carry_row<F: Radix2Field, const L: usize>(
    _ fold: own ConstraintFold<F>,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    match task {
        SparseTransitionTask::CarryBit(_node, _coefficient, _slack, bit) => {
            fold = fold.absorb(bit_residual(row.value))
            fold = fold.absorb(sub(
                row.accumulator_after,
                add(
                    row.accumulator_before,
                    mul(row.value, natural<F>(1 << bit)),
                ),
            ))
            fold.absorb(sub(row.state_after, row.state_before))
        }
        SparseTransitionTask::CarryFinish(_node, _coefficient) => {
            fold = fold.absorb(sub(row.value, row.state_before))
            fold = fold.absorb(sub(
                add(row.state_before, row.accumulator_before),
                natural<F>(product_carry_bound<L>()),
            ))
            fold = fold.absorb(row.auxiliary)
            fold = fold.absorb(row.accumulator_after)
            fold.absorb(row.state_after)
        }
        _ => fold.absorb(one<F>()),
    }
}

pub fn evaluate_sparse_carry_row<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_carry_row<F, L>(
        ConstraintFold<F>::new(challenge),
        task,
        row,
    )
    FixedAirConstraintEvaluation {
        valid: match task {
            SparseTransitionTask::CarryBit(_, _, _, _) => true,
            SparseTransitionTask::CarryFinish(_, _) => true,
            _ => false,
        },
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn sparse_carry_initial_residuals<F: Radix2Field>(
    _ row: SparseTaskRow<F>,
) -> (F, F) {
    (row.accumulator_before, row.state_before)
}

/// Link carry rows while handling the one intentional scan handoff. The first
/// slack bit resets the active reconstruction and retains the completed carry
/// reconstruction in the state accumulator.
pub fn sparse_carry_link_residuals<F: Radix2Field>(
    _ current_task: SparseTransitionTask,
    _ current: SparseTaskRow<F>,
    _ next_task: SparseTransitionTask,
    _ next: SparseTaskRow<F>,
) -> (F, F) {
    match next_task {
        SparseTransitionTask::CarryBit(_node, _coefficient, true, 0) => (
            next.accumulator_before,
            sub(next.state_before, current.accumulator_after),
        ),
        _ => (
            sub(next.accumulator_before, current.accumulator_after),
            sub(next.state_before, current.state_after),
        ),
    }
}

fn absorb_sparse_product_row<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    match task {
        SparseTransitionTask::ProductTerm(_node, _coefficient, _term) => {
            fold = fold.absorb(sub(
                row.accumulator_after,
                add(
                    row.accumulator_before,
                    mul(row.value, row.auxiliary),
                ),
            ))
            fold.absorb(sub(row.state_after, row.state_before))
        }
        SparseTransitionTask::ProductCoefficient(_node, _coefficient) => {
            fold = fold.absorb(sub(
                sub(
                    add(row.accumulator_before, row.state_before),
                    row.value,
                ),
                mul(natural<F>(8192), row.auxiliary),
            ))
            fold = fold.absorb(row.accumulator_after)
            fold.absorb(sub(row.state_after, row.auxiliary))
        }
        _ => fold.absorb(one<F>()),
    }
}

pub fn evaluate_sparse_product_row<F: Radix2Field>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_product_row(
        ConstraintFold<F>::new(challenge),
        task,
        row,
    )
    FixedAirConstraintEvaluation {
        valid: match task {
            SparseTransitionTask::ProductTerm(_, _, _) => true,
            SparseTransitionTask::ProductCoefficient(_, _) => true,
            _ => false,
        },
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn sparse_product_initial_residuals<F: Radix2Field>(
    _ row: SparseTaskRow<F>,
) -> (F, F) {
    (row.accumulator_before, row.state_before)
}

pub fn sparse_product_link_residuals<F: Radix2Field>(
    _ current: SparseTaskRow<F>,
    _ next: SparseTaskRow<F>,
) -> (F, F) {
    (
        sub(next.accumulator_before, current.accumulator_after),
        sub(next.state_before, current.state_after),
    )
}

pub fn sparse_product_terminal_residuals<F: Radix2Field>(
    _ row: SparseTaskRow<F>,
) -> (F, F) {
    (row.accumulator_after, row.state_after)
}

fn product_node_rank(_ node: ProductNode) -> u32 {
    match node {
        ProductNode::Xx => 0,
        ProductNode::Yy => 1,
        ProductNode::Xy => 2,
        ProductNode::Invalid => 99,
    }
}

fn product_copy_range_rank(_ node: RangeNode) -> u32 {
    match node {
        RangeNode::CurrentReal => 0,
        RangeNode::CurrentImaginary => 1,
        RangeNode::ProductLow(product) => 2 + 2 * product_node_rank(product),
        RangeNode::ProductHigh(product) => 3 + 2 * product_node_rank(product),
        _ => 99,
    }
}

fn product_copy_key<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ address: SparseCopyAddress,
) -> F {
    let limbs: u32 = L.downcast_truncate()
    let rank = match address {
        SparseCopyAddress::RangeDigit(node, limb) => {
            product_copy_range_rank(node) * limbs + limb
        }
        SparseCopyAddress::ProductCarry(product, coefficient) => {
            8 * limbs + product_node_rank(product) * limbs * 2 + coefficient
        }
        _ => return zero<F>(),
    }
    let mut key = one<F>()
    let mut exponent: u32 = 0
    while exponent < rank + 1 {
        key = mul(key, challenge)
        exponent = exponent + 1
    }
    key
}

fn product_input_range(_ product: ProductNode, _ left: bool) -> RangeNode {
    match product {
        ProductNode::Xx => RangeNode::CurrentReal,
        ProductNode::Yy => RangeNode::CurrentImaginary,
        ProductNode::Xy => {
            if left { RangeNode::CurrentReal } else { RangeNode::CurrentImaginary }
        }
        ProductNode::Invalid => RangeNode::Invalid,
    }
}

fn product_digit_range<const L: usize>(
    _ product: ProductNode,
    _ coefficient: u32,
) -> (RangeNode, u32) {
    let limbs: u32 = L.downcast_truncate()
    if coefficient < limbs {
        (RangeNode::ProductLow(product), coefficient)
    } else {
        (RangeNode::ProductHigh(product), coefficient - limbs)
    }
}

/// Producer side of the convolution copy bus. Multiplicities are derived from
/// the nominal product DAG: each coordinate digit is read by one square twice
/// and the mixed product once; each normalized digit is read once; each carry
/// is read as an output and, except for the last carry, as the next input.
pub fn sparse_product_copy_source<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::RadixLimb(node, limb) => {
            let limbs: u32 = L.downcast_truncate()
            let multiplicity = match node {
                RangeNode::CurrentReal => 3 * limbs,
                RangeNode::CurrentImaginary => 3 * limbs,
                RangeNode::ProductLow(_) => 1,
                RangeNode::ProductHigh(_) => 1,
                _ => 0,
            }
            mul(
                mul(
                    product_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeDigit(node, limb),
                    ),
                    row.value,
                ),
                natural<F>(multiplicity),
            )
        }
        SparseTransitionTask::CarryFinish(product, coefficient) => {
            let limbs: u32 = L.downcast_truncate()
            let multiplicity = if coefficient + 1 < limbs + limbs { 2 } else { 1 }
            mul(
                mul(
                    product_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::ProductCarry(product, coefficient),
                    ),
                    row.value,
                ),
                natural<F>(multiplicity),
            )
        }
        _ => zero<F>(),
    }
}

pub fn sparse_product_copy_consumer<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::ProductTerm(product, coefficient, term) => {
            let left_index = convolution_left_index<L>(coefficient, term)
            let right_index = convolution_right_index<L>(coefficient, term)
            add(
                mul(
                    product_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeDigit(
                            product_input_range(product, true),
                            left_index,
                        ),
                    ),
                    row.value,
                ),
                mul(
                    product_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeDigit(
                            product_input_range(product, false),
                            right_index,
                        ),
                    ),
                    row.auxiliary,
                ),
            )
        }
        SparseTransitionTask::ProductCoefficient(product, coefficient) => {
            let digit = product_digit_range<L>(product, coefficient)
            let mut contribution = mul(
                product_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeDigit(digit.0, digit.1),
                ),
                row.value,
            )
            contribution = add(
                contribution,
                mul(
                    product_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::ProductCarry(product, coefficient),
                    ),
                    row.auxiliary,
                ),
            )
            if coefficient > 0 {
                contribution = add(
                    contribution,
                    mul(
                        product_copy_key<F, L>(
                            challenge,
                            SparseCopyAddress::ProductCarry(product, coefficient - 1),
                        ),
                        row.state_before,
                    ),
                )
            }
            contribution
        }
        _ => zero<F>(),
    }
}

fn absorb_sparse_round_row<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    match task {
        SparseTransitionTask::ProductRound(_node, _output_index) => {
            fold = fold.absorb(bit_residual(row.accumulator_after))
            fold = fold.absorb(sub(
                sub(
                    add(row.value, row.accumulator_before),
                    row.auxiliary,
                ),
                mul(natural<F>(8192), row.accumulator_after),
            ))
            fold.absorb(sub(row.state_after, row.state_before))
        }
        SparseTransitionTask::ProductFinish(_node) => {
            fold = fold.absorb(bit_residual(row.value))
            fold = fold.absorb(bit_residual(row.auxiliary))
            fold = fold.absorb(bit_residual(row.accumulator_before))
            fold = fold.absorb(bit_residual(row.accumulator_after))
            fold = fold.absorb(bit_residual(row.state_before))
            fold = fold.absorb(bit_residual(row.state_after))
            let sign_xor = sub(
                add(row.accumulator_after, row.state_after),
                mul(
                    natural<F>(2),
                    mul(row.accumulator_after, row.state_after),
                ),
            )
            fold.absorb(sub(row.value, mul(sign_xor, row.auxiliary)))
        }
        _ => fold.absorb(one<F>()),
    }
}

pub fn evaluate_sparse_round_row<F: Radix2Field>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_round_row(
        ConstraintFold<F>::new(challenge),
        task,
        row,
    )
    FixedAirConstraintEvaluation {
        valid: match task {
            SparseTransitionTask::ProductRound(_, _) => true,
            SparseTransitionTask::ProductFinish(_) => true,
            _ => false,
        },
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn sparse_round_initial_residual<F: Radix2Field>(
    _ row: SparseTaskRow<F>,
) -> F {
    sub(row.accumulator_before, row.state_before)
}

pub fn sparse_round_link_residuals<F: Radix2Field>(
    _ current: SparseTaskRow<F>,
    _ next: SparseTaskRow<F>,
) -> (F, F) {
    (
        sub(next.accumulator_before, current.accumulator_after),
        sub(next.state_before, current.state_after),
    )
}

fn round_copy_range_rank(_ node: RangeNode) -> u32 {
    match node {
        RangeNode::CurrentReal => 0,
        RangeNode::CurrentImaginary => 1,
        RangeNode::ProductLow(product) => 2 + 3 * product_node_rank(product),
        RangeNode::ProductHigh(product) => 3 + 3 * product_node_rank(product),
        RangeNode::ProductOutput(product) => 4 + 3 * product_node_rank(product),
        _ => 99,
    }
}

fn round_copy_key<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ address: SparseCopyAddress,
) -> F {
    let limbs: u32 = L.downcast_truncate()
    let ranges: u32 = 11
    let digit_addresses = ranges * limbs
    let bit_addresses = ranges * limbs * 13
    let rank = match address {
        SparseCopyAddress::RangeDigit(node, limb) => {
            round_copy_range_rank(node) * limbs + limb
        }
        SparseCopyAddress::RangeBit(node, limb, bit) => {
            digit_addresses
                + round_copy_range_rank(node) * limbs * 13
                + limb * 13
                + bit
        }
        SparseCopyAddress::RangeSign(node) => {
            digit_addresses + bit_addresses + round_copy_range_rank(node)
        }
        SparseCopyAddress::RangeNonzero(node) => {
            digit_addresses + bit_addresses + ranges + round_copy_range_rank(node)
        }
        _ => return zero<F>(),
    }
    let mut key = one<F>()
    let mut exponent: u32 = 0
    while exponent < rank + 1 {
        key = mul(key, challenge)
        exponent = exponent + 1
    }
    key
}

fn round_retained_range<const L: usize>(
    _ product: ProductNode,
    _ output_index: u32,
) -> (RangeNode, u32) {
    let limbs: u32 = L.downcast_truncate()
    if output_index == 0 {
        (RangeNode::ProductLow(product), limbs - 1)
    } else {
        (RangeNode::ProductHigh(product), output_index - 1)
    }
}

/// Source side of the rounding copy bus. Only the retained window, output
/// digits, one guard bit, and sign/nonzero values participate, so every
/// multiplicity follows directly from the nominal task variants.
pub fn sparse_round_copy_source<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::RadixBit(
            RangeNode::ProductLow(product),
            limb,
            bit,
        ) => {
            let limbs: u32 = L.downcast_truncate()
            if limb == limbs - 2 && bit == 12 {
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeBit(
                            RangeNode::ProductLow(product),
                            limb,
                            bit,
                        ),
                    ),
                    row.value,
                )
            } else {
                zero<F>()
            }
        }
        SparseTransitionTask::RadixLimb(node, limb) => {
            let limbs: u32 = L.downcast_truncate()
            let used = match node {
                RangeNode::ProductLow(_) => limb + 1 == limbs,
                RangeNode::ProductHigh(_) => limb + 1 < limbs,
                RangeNode::ProductOutput(_) => true,
                _ => false,
            }
            if used {
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeDigit(node, limb),
                    ),
                    row.value,
                )
            } else {
                zero<F>()
            }
        }
        SparseTransitionTask::RadixFinish(node) => {
            let sign_multiplicity = match node {
                RangeNode::CurrentReal => 3,
                RangeNode::CurrentImaginary => 3,
                RangeNode::ProductOutput(_) => 1,
                _ => 0,
            }
            let mut contribution = mul(
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeSign(node),
                    ),
                    row.auxiliary,
                ),
                natural<F>(sign_multiplicity),
            )
            if range_node_is_product_output(node) {
                contribution = add(
                    contribution,
                    mul(
                        round_copy_key<F, L>(
                            challenge,
                            SparseCopyAddress::RangeNonzero(node),
                        ),
                        row.value,
                    ),
                )
            }
            contribution
        }
        _ => zero<F>(),
    }
}

pub fn sparse_round_copy_consumer<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::ProductRound(product, output_index) => {
            let retained = round_retained_range<L>(product, output_index)
            add(
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeDigit(retained.0, retained.1),
                    ),
                    row.value,
                ),
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeDigit(
                            RangeNode::ProductOutput(product),
                            output_index,
                        ),
                    ),
                    row.auxiliary,
                ),
            )
        }
        SparseTransitionTask::ProductFinish(product) => {
            let left = product_input_range(product, true)
            let right = product_input_range(product, false)
            let output = RangeNode::ProductOutput(product)
            let limbs: u32 = L.downcast_truncate()
            let mut contribution = mul(
                round_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeBit(
                        RangeNode::ProductLow(product),
                        limbs - 2,
                        12,
                    ),
                ),
                row.state_before,
            )
            contribution = add(
                contribution,
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeSign(output),
                    ),
                    row.value,
                ),
            )
            contribution = add(
                contribution,
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeNonzero(output),
                    ),
                    row.auxiliary,
                ),
            )
            contribution = add(
                contribution,
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeSign(left),
                    ),
                    row.accumulator_after,
                ),
            )
            add(
                contribution,
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeSign(right),
                    ),
                    row.state_after,
                ),
            )
        }
        _ => zero<F>(),
    }
}

fn absorb_sparse_linear_row<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    match task {
        SparseTransitionTask::LinearLimb(_node, role, _limb) => {
            match role {
                LinearLimbRole::Sum => {
                    fold = fold.absorb(bit_residual(row.accumulator_after))
                    fold = fold.absorb(sub(
                        sub(
                            add(
                                add(row.value, row.auxiliary),
                                row.accumulator_before,
                            ),
                            row.state_before,
                        ),
                        mul(natural<F>(8192), row.accumulator_after),
                    ))
                    fold.absorb(row.state_after)
                }
                LinearLimbRole::LeftDifference => {
                    fold = fold.absorb(bit_residual(row.accumulator_after))
                    fold = fold.absorb(sub(
                        sub(
                            add(
                                row.value,
                                mul(natural<F>(8192), row.accumulator_after),
                            ),
                            row.auxiliary,
                        ),
                        add(row.accumulator_before, row.state_before),
                    ))
                    fold.absorb(row.state_after)
                }
                LinearLimbRole::RightDifference => {
                    fold = fold.absorb(bit_residual(row.accumulator_after))
                    fold = fold.absorb(sub(
                        sub(
                            add(
                                row.auxiliary,
                                mul(natural<F>(8192), row.accumulator_after),
                            ),
                            row.value,
                        ),
                        add(row.accumulator_before, row.state_before),
                    ))
                    fold.absorb(row.state_after)
                }
                LinearLimbRole::Select => {
                    fold = fold.absorb(bit_residual(row.state_before))
                    fold = fold.absorb(bit_residual(row.state_after))
                    let difference = add(
                        mul(sub(one<F>(), row.state_after), row.auxiliary),
                        mul(row.state_after, row.accumulator_before),
                    )
                    let selected = add(
                        mul(row.state_before, row.value),
                        mul(sub(one<F>(), row.state_before), difference),
                    )
                    fold.absorb(sub(row.accumulator_after, selected))
                }
                LinearLimbRole::Invalid => fold.absorb(one<F>()),
            }
        }
        SparseTransitionTask::LinearFinish(node) => {
            fold = fold.absorb(bit_residual(row.value))
            fold = fold.absorb(bit_residual(row.auxiliary))
            fold = fold.absorb(bit_residual(row.accumulator_before))
            fold = fold.absorb(bit_residual(row.accumulator_after))
            fold = fold.absorb(bit_residual(row.state_before))
            fold = fold.absorb(bit_residual(row.state_after))
            let subtract = boolean<F>(linear_subtracts_right(node))
            let effective_right = sub(
                add(row.auxiliary, subtract),
                mul(natural<F>(2), mul(row.auxiliary, subtract)),
            )
            let different = sub(
                add(row.value, effective_right),
                mul(natural<F>(2), mul(row.value, effective_right)),
            )
            let same = sub(one<F>(), different)
            let select = row.accumulator_before
            fold = fold.absorb(add(
                mul(sub(one<F>(), select), row.accumulator_before),
                mul(select, row.accumulator_after),
            ))
            let selected_difference_sign = add(
                mul(sub(one<F>(), select), row.value),
                mul(select, effective_right),
            )
            let selected_sign = add(
                mul(same, row.value),
                mul(sub(one<F>(), same), selected_difference_sign),
            )
            fold.absorb(sub(
                row.state_after,
                mul(selected_sign, row.state_before),
            ))
        }
        _ => fold.absorb(one<F>()),
    }
}

pub fn evaluate_sparse_linear_row<F: Radix2Field>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_linear_row(
        ConstraintFold<F>::new(challenge),
        task,
        row,
    )
    FixedAirConstraintEvaluation {
        valid: match task {
            SparseTransitionTask::LinearLimb(_, _, _) => true,
            SparseTransitionTask::LinearFinish(_) => true,
            _ => false,
        },
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn sparse_linear_initial_residual<F: Radix2Field>(
    _ row: SparseTaskRow<F>,
) -> F {
    row.accumulator_before
}

pub fn sparse_linear_link_residual<F: Radix2Field>(
    _ current: SparseTaskRow<F>,
    _ next: SparseTaskRow<F>,
) -> F {
    sub(next.accumulator_before, current.accumulator_after)
}

fn linear_node_rank(_ node: LinearNode) -> u32 {
    match node {
        LinearNode::RealDifference => 0,
        LinearNode::NextReal => 1,
        LinearNode::DoubleXy => 2,
        LinearNode::NextImaginary => 3,
        LinearNode::Invalid => 99,
    }
}

fn range_node_rank(_ node: RangeNode) -> u32 {
    match node {
        RangeNode::PointReal => 0,
        RangeNode::PointImaginary => 1,
        RangeNode::CurrentReal => 2,
        RangeNode::CurrentImaginary => 3,
        RangeNode::NextReal => 4,
        RangeNode::NextImaginary => 5,
        RangeNode::ProductLow(product) => 6 + 3 * product_node_rank(product),
        RangeNode::ProductHigh(product) => 7 + 3 * product_node_rank(product),
        RangeNode::ProductOutput(product) => 8 + 3 * product_node_rank(product),
        RangeNode::LinearSum(linear) => 15 + 4 * linear_node_rank(linear),
        RangeNode::LinearLeftDifference(linear) => 16 + 4 * linear_node_rank(linear),
        RangeNode::LinearRightDifference(linear) => 17 + 4 * linear_node_rank(linear),
        RangeNode::LinearOutput(linear) => 18 + 4 * linear_node_rank(linear),
        RangeNode::Invalid => 99,
    }
}

fn linear_copy_key<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ address: SparseCopyAddress,
) -> F {
    let limbs: u32 = L.downcast_truncate()
    let digit_addresses = sparse_range_node_count() * limbs
    let rank = match address {
        SparseCopyAddress::RangeDigit(node, limb) => {
            range_node_rank(node) * limbs + limb
        }
        SparseCopyAddress::RangeSign(node) => {
            digit_addresses + range_node_rank(node)
        }
        SparseCopyAddress::RangeNonzero(node) => {
            digit_addresses + sparse_range_node_count() + range_node_rank(node)
        }
        SparseCopyAddress::LinearBorrow(linear, right) => {
            digit_addresses + 2 * sparse_range_node_count()
                + 2 * linear_node_rank(linear)
                + if right { 1 } else { 0 }
        }
        SparseCopyAddress::LinearSameSign(linear) => {
            digit_addresses + 2 * sparse_range_node_count()
                + 2 * sparse_linear_node_count()
                + linear_node_rank(linear)
        }
        SparseCopyAddress::LinearSelectRight(linear) => {
            digit_addresses + 2 * sparse_range_node_count()
                + 3 * sparse_linear_node_count()
                + linear_node_rank(linear)
        }
        _ => return zero<F>(),
    }
    let mut key = one<F>()
    let mut exponent: u32 = 0
    while exponent < rank + 1 {
        key = mul(key, challenge)
        exponent = exponent + 1
    }
    key
}

fn linear_left_range(_ linear: LinearNode) -> RangeNode {
    match linear {
        LinearNode::RealDifference => RangeNode::ProductOutput(ProductNode::Xx),
        LinearNode::NextReal => RangeNode::LinearOutput(LinearNode::RealDifference),
        LinearNode::DoubleXy => RangeNode::ProductOutput(ProductNode::Xy),
        LinearNode::NextImaginary => RangeNode::LinearOutput(LinearNode::DoubleXy),
        LinearNode::Invalid => RangeNode::Invalid,
    }
}

fn linear_right_range(_ linear: LinearNode) -> RangeNode {
    match linear {
        LinearNode::RealDifference => RangeNode::ProductOutput(ProductNode::Yy),
        LinearNode::NextReal => RangeNode::PointReal,
        LinearNode::DoubleXy => RangeNode::ProductOutput(ProductNode::Xy),
        LinearNode::NextImaginary => RangeNode::PointImaginary,
        LinearNode::Invalid => RangeNode::Invalid,
    }
}

fn range_node_same(_ left: RangeNode, _ right: RangeNode) -> bool {
    range_node_rank(left) == range_node_rank(right)
}

fn linear_copy_range_contribution<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ address: RangeNode,
    _ limb: u32,
    _ value: F,
    _ candidate: RangeNode,
    _ multiplicity: u32,
) -> F {
    if range_node_same(address, candidate) {
        mul(
            mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeDigit(address, limb),
                ),
                value,
            ),
            natural<F>(multiplicity),
        )
    } else {
        zero<F>()
    }
}

pub fn sparse_linear_copy_source<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ target: LinearNode,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::RadixLimb(node, limb) => {
            let mut contribution = linear_copy_range_contribution<F, L>(
                challenge, node, limb, row.value, linear_left_range(target), 3,
            )
            contribution = add(contribution, linear_copy_range_contribution<F, L>(
                challenge, node, limb, row.value, linear_right_range(target), 3,
            ))
            contribution = add(contribution, linear_copy_range_contribution<F, L>(
                challenge, node, limb, row.value, RangeNode::LinearSum(target), 1,
            ))
            contribution = add(contribution, linear_copy_range_contribution<F, L>(
                challenge, node, limb, row.value,
                RangeNode::LinearLeftDifference(target), 1,
            ))
            contribution = add(contribution, linear_copy_range_contribution<F, L>(
                challenge, node, limb, row.value,
                RangeNode::LinearRightDifference(target), 1,
            ))
            add(contribution, linear_copy_range_contribution<F, L>(
                challenge, node, limb, row.value, RangeNode::LinearOutput(target), 1,
            ))
        }
        SparseTransitionTask::RadixFinish(node) => {
            let mut contribution = zero<F>()
            if range_node_same(node, linear_left_range(target)) {
                contribution = add(contribution, mul(
                    linear_copy_key<F, L>(challenge, SparseCopyAddress::RangeSign(node)),
                    row.auxiliary,
                ))
            }
            if range_node_same(node, linear_right_range(target)) {
                contribution = add(contribution, mul(
                    linear_copy_key<F, L>(challenge, SparseCopyAddress::RangeSign(node)),
                    row.auxiliary,
                ))
            }
            if range_node_same(node, RangeNode::LinearOutput(target)) {
                contribution = add(contribution, mul(
                    linear_copy_key<F, L>(challenge, SparseCopyAddress::RangeSign(node)),
                    row.auxiliary,
                ))
                contribution = add(contribution, mul(
                    linear_copy_key<F, L>(challenge, SparseCopyAddress::RangeNonzero(node)),
                    row.value,
                ))
            }
            contribution
        }
        SparseTransitionTask::LinearLimb(node, role, limb) => {
            let limbs: u32 = L.downcast_truncate()
            if linear_node_rank(node) != linear_node_rank(target)
                || limb + 1 != limbs
            {
                return zero<F>()
            }
            match role {
                LinearLimbRole::LeftDifference => mul(
                    linear_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::LinearBorrow(target, false),
                    ),
                    row.accumulator_after,
                ),
                LinearLimbRole::RightDifference => mul(
                    linear_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::LinearBorrow(target, true),
                    ),
                    row.accumulator_after,
                ),
                _ => zero<F>(),
            }
        }
        SparseTransitionTask::LinearFinish(node) => {
            if linear_node_rank(node) != linear_node_rank(target) {
                return zero<F>()
            }
            let subtract = boolean<F>(linear_subtracts_right(node))
            let effective_right = sub(
                add(row.auxiliary, subtract),
                mul(natural<F>(2), mul(row.auxiliary, subtract)),
            )
            let different = sub(
                add(row.value, effective_right),
                mul(natural<F>(2), mul(row.value, effective_right)),
            )
            let same = sub(one<F>(), different)
            let limbs: u32 = L.downcast_truncate()
            add(
                mul(
                    mul(
                        linear_copy_key<F, L>(
                            challenge,
                            SparseCopyAddress::LinearSameSign(target),
                        ),
                        same,
                    ),
                    natural<F>(limbs),
                ),
                mul(
                    mul(
                        linear_copy_key<F, L>(
                            challenge,
                            SparseCopyAddress::LinearSelectRight(target),
                        ),
                        row.accumulator_before,
                    ),
                    natural<F>(limbs),
                ),
            )
        }
        _ => zero<F>(),
    }
}

fn linear_copy_read<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ range: RangeNode,
    _ limb: u32,
    _ value: F,
) -> F {
    mul(
        linear_copy_key<F, L>(
            challenge,
            SparseCopyAddress::RangeDigit(range, limb),
        ),
        value,
    )
}

pub fn sparse_linear_copy_consumer<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ target: LinearNode,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::LinearLimb(node, role, limb) => {
            if linear_node_rank(node) != linear_node_rank(target) {
                return zero<F>()
            }
            match role {
                LinearLimbRole::Sum => add(
                    add(
                        linear_copy_read<F, L>(
                            challenge, linear_left_range(target), limb, row.value,
                        ),
                        linear_copy_read<F, L>(
                            challenge, linear_right_range(target), limb, row.auxiliary,
                        ),
                    ),
                    linear_copy_read<F, L>(
                        challenge, RangeNode::LinearSum(target), limb, row.state_before,
                    ),
                ),
                LinearLimbRole::LeftDifference => add(
                    add(
                        linear_copy_read<F, L>(
                            challenge, linear_left_range(target), limb, row.value,
                        ),
                        linear_copy_read<F, L>(
                            challenge, linear_right_range(target), limb, row.auxiliary,
                        ),
                    ),
                    linear_copy_read<F, L>(
                        challenge, RangeNode::LinearLeftDifference(target), limb,
                        row.state_before,
                    ),
                ),
                LinearLimbRole::RightDifference => add(
                    add(
                        linear_copy_read<F, L>(
                            challenge, linear_left_range(target), limb, row.value,
                        ),
                        linear_copy_read<F, L>(
                            challenge, linear_right_range(target), limb, row.auxiliary,
                        ),
                    ),
                    linear_copy_read<F, L>(
                        challenge, RangeNode::LinearRightDifference(target), limb,
                        row.state_before,
                    ),
                ),
                LinearLimbRole::Select => {
                    let mut contribution = linear_copy_read<F, L>(
                        challenge, RangeNode::LinearSum(target), limb, row.value,
                    )
                    contribution = add(contribution, linear_copy_read<F, L>(
                        challenge, RangeNode::LinearLeftDifference(target), limb,
                        row.auxiliary,
                    ))
                    contribution = add(contribution, linear_copy_read<F, L>(
                        challenge, RangeNode::LinearRightDifference(target), limb,
                        row.accumulator_before,
                    ))
                    contribution = add(contribution, linear_copy_read<F, L>(
                        challenge, RangeNode::LinearOutput(target), limb,
                        row.accumulator_after,
                    ))
                    contribution = add(contribution, mul(
                        linear_copy_key<F, L>(
                            challenge,
                            SparseCopyAddress::LinearSameSign(target),
                        ),
                        row.state_before,
                    ))
                    add(contribution, mul(
                        linear_copy_key<F, L>(
                            challenge,
                            SparseCopyAddress::LinearSelectRight(target),
                        ),
                        row.state_after,
                    ))
                }
                LinearLimbRole::Invalid => zero<F>(),
            }
        }
        SparseTransitionTask::LinearFinish(node) => {
            if linear_node_rank(node) != linear_node_rank(target) {
                return zero<F>()
            }
            let output = RangeNode::LinearOutput(target)
            let mut contribution = mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeSign(linear_left_range(target)),
                ),
                row.value,
            )
            contribution = add(contribution, mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeSign(linear_right_range(target)),
                ),
                row.auxiliary,
            ))
            contribution = add(contribution, mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::LinearBorrow(target, false),
                ),
                row.accumulator_before,
            ))
            contribution = add(contribution, mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::LinearBorrow(target, true),
                ),
                row.accumulator_after,
            ))
            contribution = add(contribution, mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeNonzero(output),
                ),
                row.state_before,
            ))
            add(contribution, mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeSign(output),
                ),
                row.state_after,
            ))
        }
        _ => zero<F>(),
    }
}

fn absorb_sparse_boundary_row<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    match task {
        SparseTransitionTask::BoundarySign(_coordinate) => {
            fold = fold.absorb(bit_residual(row.value))
            fold = fold.absorb(bit_residual(row.auxiliary))
            fold = fold.absorb(sub(row.value, row.auxiliary))
            fold = fold.absorb(row.accumulator_before)
            fold = fold.absorb(row.accumulator_after)
            fold = fold.absorb(row.state_before)
            fold.absorb(row.state_after)
        }
        SparseTransitionTask::BoundaryLimb(_coordinate, _limb) => {
            fold = fold.absorb(sub(row.value, row.auxiliary))
            fold = fold.absorb(row.accumulator_before)
            fold = fold.absorb(row.accumulator_after)
            fold = fold.absorb(row.state_before)
            fold.absorb(row.state_after)
        }
        SparseTransitionTask::TransitionFinish => {
            fold = fold.absorb(sub(row.value, one<F>()))
            fold = fold.absorb(row.auxiliary)
            fold = fold.absorb(row.accumulator_before)
            fold = fold.absorb(row.accumulator_after)
            fold = fold.absorb(row.state_before)
            fold.absorb(row.state_after)
        }
        _ => fold.absorb(one<F>()),
    }
}

pub fn evaluate_sparse_boundary_row<F: Radix2Field>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_boundary_row(
        ConstraintFold<F>::new(challenge),
        task,
        row,
    )
    FixedAirConstraintEvaluation {
        valid: match task {
            SparseTransitionTask::BoundarySign(_) => true,
            SparseTransitionTask::BoundaryLimb(_, _) => true,
            SparseTransitionTask::TransitionFinish => true,
            _ => false,
        },
        constraints: fold.constraints,
        folded: fold.value,
    }
}

fn boundary_computed_range(_ coordinate: CoordinateNode) -> RangeNode {
    match coordinate {
        CoordinateNode::Real => RangeNode::LinearOutput(LinearNode::NextReal),
        CoordinateNode::Imaginary => {
            RangeNode::LinearOutput(LinearNode::NextImaginary)
        }
        CoordinateNode::Invalid => RangeNode::Invalid,
    }
}

fn boundary_claimed_range(_ coordinate: CoordinateNode) -> RangeNode {
    match coordinate {
        CoordinateNode::Real => RangeNode::NextReal,
        CoordinateNode::Imaginary => RangeNode::NextImaginary,
        CoordinateNode::Invalid => RangeNode::Invalid,
    }
}

fn boundary_copy_key<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ address: SparseCopyAddress,
) -> F {
    let limbs: u32 = L.downcast_truncate()
    let digit_addresses = sparse_range_node_count() * limbs
    let rank = match address {
        SparseCopyAddress::RangeDigit(node, limb) => {
            range_node_rank(node) * limbs + limb
        }
        SparseCopyAddress::RangeSign(node) => {
            digit_addresses + range_node_rank(node)
        }
        _ => return zero<F>(),
    }
    let mut key = one<F>()
    let mut exponent: u32 = 0
    while exponent < rank + 1 {
        key = mul(key, challenge)
        exponent = exponent + 1
    }
    key
}

fn boundary_source_for_range<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ node: RangeNode,
    _ limb: u32,
    _ value: F,
    _ candidate: RangeNode,
) -> F {
    if range_node_same(node, candidate) {
        mul(
            boundary_copy_key<F, L>(
                challenge,
                SparseCopyAddress::RangeDigit(node, limb),
            ),
            value,
        )
    } else {
        zero<F>()
    }
}

pub fn sparse_boundary_copy_source<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::RadixLimb(node, limb) => {
            let mut contribution = zero<F>()
            let mut coordinate: u32 = 0
            while coordinate < 2 {
                let coordinate_node = coordinate_node_at(coordinate)
                contribution = add(
                    contribution,
                    boundary_source_for_range<F, L>(
                        challenge,
                        node,
                        limb,
                        row.value,
                        boundary_computed_range(coordinate_node),
                    ),
                )
                contribution = add(
                    contribution,
                    boundary_source_for_range<F, L>(
                        challenge,
                        node,
                        limb,
                        row.value,
                        boundary_claimed_range(coordinate_node),
                    ),
                )
                coordinate = coordinate + 1
            }
            contribution
        }
        SparseTransitionTask::RadixFinish(node) => {
            let mut contribution = zero<F>()
            let mut coordinate: u32 = 0
            while coordinate < 2 {
                let coordinate_node = coordinate_node_at(coordinate)
                let computed = boundary_computed_range(coordinate_node)
                let claimed = boundary_claimed_range(coordinate_node)
                if range_node_same(node, computed) || range_node_same(node, claimed) {
                    contribution = add(
                        contribution,
                        mul(
                            boundary_copy_key<F, L>(
                                challenge,
                                SparseCopyAddress::RangeSign(node),
                            ),
                            row.auxiliary,
                        ),
                    )
                }
                coordinate = coordinate + 1
            }
            contribution
        }
        _ => zero<F>(),
    }
}

pub fn sparse_boundary_copy_consumer<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::BoundarySign(coordinate) => add(
            mul(
                boundary_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeSign(boundary_computed_range(coordinate)),
                ),
                row.value,
            ),
            mul(
                boundary_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeSign(boundary_claimed_range(coordinate)),
                ),
                row.auxiliary,
            ),
        ),
        SparseTransitionTask::BoundaryLimb(coordinate, limb) => add(
            mul(
                boundary_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeDigit(
                        boundary_computed_range(coordinate),
                        limb,
                    ),
                ),
                row.value,
            ),
            mul(
                boundary_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeDigit(
                        boundary_claimed_range(coordinate),
                        limb,
                    ),
                ),
                row.auxiliary,
            ),
        ),
        _ => zero<F>(),
    }
}

fn absorb_radix_range<F: Radix2Field, const L: usize>(
    _ fold: own ConstraintFold<F>,
    _ value: AirRangedDigits<F, L>,
) -> ConstraintFold<F> {
    let mut fold = fold
    let mut previous = zero<F>()
    let mut limb_index: usize = 0
    while limb_index < L {
        let mut reconstructed = zero<F>()
        let mut place = one<F>()
        let mut bit_index: usize = 0
        while bit_index < 13 {
            let bit = value.range.limbs[limb_index].bits[bit_index]
            let prefix = value.range.limbs[limb_index].nonzero_prefix[bit_index]
            fold = fold.absorb(bit_residual(bit))
            fold = fold.absorb(bit_residual(prefix))
            fold = fold.absorb(sub(prefix, sub(add(previous, bit), mul(previous, bit))))
            reconstructed = add(reconstructed, mul(bit, place))
            place = add(place, place)
            previous = prefix
            bit_index = bit_index + 1
        }
        fold = fold.absorb(sub(value.digits[limb_index], reconstructed))
        limb_index = limb_index + 1
    }
    fold = fold.absorb(bit_residual(value.range.nonzero))
    fold.absorb(sub(value.range.nonzero, previous))
}

fn absorb_ranged_fixed<F: Radix2Field, const L: usize>(
    _ fold: own ConstraintFold<F>,
    _ value: AirRangedFixed<F, L>,
) -> ConstraintFold<F> {
    let mut fold = fold.absorb(bit_residual(value.negative))
    fold = absorb_radix_range<F, L>(fold, value.magnitude)
    fold.absorb(mul(value.negative, sub(one<F>(), value.magnitude.range.nonzero)))
}

fn bits18<F: Radix2Field>(_ bits: [F; 18]) -> F {
    let mut value = zero<F>()
    let mut place = one<F>()
    let mut index: usize = 0
    while index < 18 {
        value = add(value, mul(bits[index], place))
        place = add(place, place)
        index = index + 1
    }
    value
}

fn absorb_bounded_u18<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ value: F,
    _ bound: F,
    _ witness: AirBoundedU18<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    let mut index: usize = 0
    while index < 18 {
        fold = fold.absorb(bit_residual(witness.bits[index]))
        fold = fold.absorb(bit_residual(witness.slack_bits[index]))
        index = index + 1
    }
    let reconstructed = bits18(witness.bits)
    let slack = bits18(witness.slack_bits)
    fold = fold.absorb(sub(value, reconstructed))
    fold.absorb(sub(add(reconstructed, slack), bound))
}

fn product_digit<F: Radix2Field, const L: usize>(
    _ product: AirProduct<F, L>,
    _ coefficient: u32,
) -> F {
    let limbs: u32 = L.downcast_truncate()
    if coefficient < limbs {
        product.low.digits[coefficient as usize]
    } else {
        product.high.digits[(coefficient - limbs) as usize]
    }
}

fn product_carry<F: Radix2Field, const L: usize>(
    _ product: AirProduct<F, L>,
    _ coefficient: u32,
) -> F {
    let limbs: u32 = L.downcast_truncate()
    if coefficient < limbs {
        product.low_carries[coefficient as usize]
    } else {
        product.high_carries[(coefficient - limbs) as usize]
    }
}

fn product_carry_range<F: Radix2Field, const L: usize>(
    _ product: AirProduct<F, L>,
    _ coefficient: u32,
) -> AirBoundedU18<F> {
    let limbs: u32 = L.downcast_truncate()
    if coefficient < limbs {
        product.carry_range.low[coefficient as usize]
    } else {
        product.carry_range.high[(coefficient - limbs) as usize]
    }
}

fn retained_product_digit<F: Radix2Field, const L: usize>(
    _ product: AirProduct<F, L>,
    _ output_index: u32,
) -> F {
    if output_index == 0 {
        product.low.digits[L - 1]
    } else {
        product.high.digits[(output_index - 1) as usize]
    }
}

fn absorb_product<F: Radix2Field, const L: usize>(
    _ fold: own ConstraintFold<F>,
    _ left: AirRangedFixed<F, L>,
    _ right: AirRangedFixed<F, L>,
    _ product: AirProduct<F, L>,
) -> ConstraintFold<F> {
    let mut fold = fold.absorb(sub(product.valid, one<F>()))
    fold = absorb_radix_range<F, L>(fold, product.low)
    fold = absorb_radix_range<F, L>(fold, product.high)
    fold = absorb_ranged_fixed<F, L>(fold, product.output)
    let limbs: u32 = L.downcast_truncate()
    let carry_bound = natural<F>(product_carry_bound<L>())
    let radix = natural<F>(8192)
    let mut coefficient: u32 = 0
    while coefficient < limbs + limbs {
        let carry_in = if coefficient == 0 {
            zero<F>()
        } else {
            product_carry(product, coefficient - 1)
        }
        let carry_out = product_carry(product, coefficient)
        fold = absorb_bounded_u18(
            fold,
            carry_out,
            carry_bound,
            product_carry_range(product, coefficient),
        )
        let count = convolution_term_count<L>(coefficient)
        let mut sum = carry_in
        let mut term: u32 = 0
        while term < count {
            let left_index = convolution_left_index<L>(coefficient, term)
            let right_index = convolution_right_index<L>(coefficient, term)
            sum = add(sum, mul(
                left.magnitude.digits[left_index as usize],
                right.magnitude.digits[right_index as usize],
            ))
            term = term + 1
        }
        fold = fold.absorb(sub(
            sub(sum, product_digit(product, coefficient)),
            mul(radix, carry_out),
        ))
        coefficient = coefficient + 1
    }

    fold = fold.absorb(bit_residual(product.round_up))
    fold = fold.absorb(sub(product.round_up, product.low.range.limbs[L - 2].bits[12]))
    let mut output_index: u32 = 0
    while output_index < limbs {
        let carry_in = if output_index == 0 {
            product.round_up
        } else {
            product.round_carries[(output_index - 1) as usize]
        }
        let carry_out = product.round_carries[output_index as usize]
        fold = fold.absorb(bit_residual(carry_out))
        fold = fold.absorb(sub(
            sub(
                add(retained_product_digit(product, output_index), carry_in),
                product.output.magnitude.digits[output_index as usize],
            ),
            mul(radix, carry_out),
        ))
        output_index = output_index + 1
    }
    fold = fold.absorb(bit_residual(product.round_overflow))
    fold = fold.absorb(sub(product.round_overflow, product.round_carries[L - 1]))
    let sign_xor = sub(
        add(left.negative, right.negative),
        mul(natural<F>(2), mul(left.negative, right.negative)),
    )
    fold.absorb(sub(
        product.output.negative,
        mul(sign_xor, product.output.magnitude.range.nonzero),
    ))
}

fn absorb_linear<F: Radix2Field, const L: usize>(
    _ fold: own ConstraintFold<F>,
    _ left: AirRangedFixed<F, L>,
    _ right: AirRangedFixed<F, L>,
    _ subtract_right: bool,
    _ linear: AirLinear<F, L>,
) -> ConstraintFold<F> {
    let mut fold = fold.absorb(sub(linear.valid, one<F>()))
    fold = fold.absorb(bit_residual(linear.same_sign))
    fold = fold.absorb(bit_residual(linear.select_right))
    fold = fold.absorb(bit_residual(linear.output_nonzero))
    fold = absorb_radix_range<F, L>(fold, linear.sum)
    fold = absorb_radix_range<F, L>(fold, linear.left_difference)
    fold = absorb_radix_range<F, L>(fold, linear.right_difference)
    fold = absorb_ranged_fixed<F, L>(fold, linear.output)
    let radix = natural<F>(8192)
    let limbs: u32 = L.downcast_truncate()
    let mut index: u32 = 0
    while index < limbs {
        let sum_carry_in = if index == 0 {
            zero<F>()
        } else {
            linear.sum_carries[(index - 1) as usize]
        }
        let left_borrow_in = if index == 0 {
            zero<F>()
        } else {
            linear.left_borrows[(index - 1) as usize]
        }
        let right_borrow_in = if index == 0 {
            zero<F>()
        } else {
            linear.right_borrows[(index - 1) as usize]
        }
        let sum_carry_out = linear.sum_carries[index as usize]
        let left_borrow_out = linear.left_borrows[index as usize]
        let right_borrow_out = linear.right_borrows[index as usize]
        fold = fold.absorb(bit_residual(sum_carry_out))
        fold = fold.absorb(bit_residual(left_borrow_out))
        fold = fold.absorb(bit_residual(right_borrow_out))
        fold = fold.absorb(sub(
            sub(
                add(
                    add(left.magnitude.digits[index as usize], right.magnitude.digits[index as usize]),
                    sum_carry_in,
                ),
                linear.sum.digits[index as usize],
            ),
            mul(radix, sum_carry_out),
        ))
        fold = fold.absorb(sub(
            sub(
                add(left.magnitude.digits[index as usize], mul(radix, left_borrow_out)),
                right.magnitude.digits[index as usize],
            ),
            add(left_borrow_in, linear.left_difference.digits[index as usize]),
        ))
        fold = fold.absorb(sub(
            sub(
                add(right.magnitude.digits[index as usize], mul(radix, right_borrow_out)),
                left.magnitude.digits[index as usize],
            ),
            add(right_borrow_in, linear.right_difference.digits[index as usize]),
        ))
        let selected_difference = add(
            mul(sub(one<F>(), linear.select_right), linear.left_difference.digits[index as usize]),
            mul(linear.select_right, linear.right_difference.digits[index as usize]),
        )
        let selected = add(
            mul(linear.same_sign, linear.sum.digits[index as usize]),
            mul(sub(one<F>(), linear.same_sign), selected_difference),
        )
        fold = fold.absorb(sub(linear.output.magnitude.digits[index as usize], selected))
        index = index + 1
    }

    let subtract = boolean<F>(subtract_right)
    let two = natural<F>(2)
    let effective_right_sign = sub(
        add(right.negative, subtract),
        mul(two, mul(right.negative, subtract)),
    )
    let different = sub(
        add(left.negative, effective_right_sign),
        mul(two, mul(left.negative, effective_right_sign)),
    )
    fold = fold.absorb(sub(linear.same_sign, sub(one<F>(), different)))
    fold = fold.absorb(sub(linear.select_right, linear.left_borrows[L - 1]))
    fold = fold.absorb(add(
        mul(sub(one<F>(), linear.select_right), linear.left_borrows[L - 1]),
        mul(linear.select_right, linear.right_borrows[L - 1]),
    ))
    fold = fold.absorb(sub(linear.output_nonzero, linear.output.magnitude.range.nonzero))
    let selected_difference_sign = add(
        mul(sub(one<F>(), linear.select_right), left.negative),
        mul(linear.select_right, effective_right_sign),
    )
    let selected_sign = add(
        mul(linear.same_sign, left.negative),
        mul(sub(one<F>(), linear.same_sign), selected_difference_sign),
    )
    fold.absorb(sub(
        linear.output.negative,
        mul(selected_sign, linear.output_nonzero),
    ))
}

fn absorb_fixed_equality<F: Radix2Field, const L: usize>(
    _ fold: own ConstraintFold<F>,
    _ left: AirRangedFixed<F, L>,
    _ right: AirRangedFixed<F, L>,
) -> ConstraintFold<F> {
    let mut fold = fold.absorb(sub(left.negative, right.negative))
    let mut index: usize = 0
    while index < L {
        fold = fold.absorb(sub(left.magnitude.digits[index], right.magnitude.digits[index]))
        index = index + 1
    }
    fold
}

pub fn evaluate_transition_constraints<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ base_modulus: u32,
    _ air: AirMandelbrotTransition<F, L>,
) -> FixedAirConstraintEvaluation<F> {
    if !convolution_is_safe_below<L>(base_modulus)
        || product_carry_bound<L>() >= 262144
    {
        return FixedAirConstraintEvaluation {
            valid: false,
            constraints: 0,
            folded: zero<F>(),
        }
    }
    let mut fold = ConstraintFold<F>::new(challenge)
    fold = fold.absorb(sub(air.valid, one<F>()))
    fold = absorb_ranged_fixed<F, L>(fold, air.point.real)
    fold = absorb_ranged_fixed<F, L>(fold, air.point.imaginary)
    fold = absorb_ranged_fixed<F, L>(fold, air.current.real)
    fold = absorb_ranged_fixed<F, L>(fold, air.current.imaginary)
    fold = absorb_ranged_fixed<F, L>(fold, air.next.real)
    fold = absorb_ranged_fixed<F, L>(fold, air.next.imaginary)
    fold = absorb_product<F, L>(fold, air.current.real, air.current.real, air.xx)
    fold = absorb_product<F, L>(fold, air.current.imaginary, air.current.imaginary, air.yy)
    fold = absorb_product<F, L>(fold, air.current.real, air.current.imaginary, air.xy)
    fold = absorb_linear<F, L>(
        fold,
        air.xx.output,
        air.yy.output,
        true,
        air.real_difference,
    )
    fold = absorb_linear<F, L>(
        fold,
        air.real_difference.output,
        air.point.real,
        false,
        air.next_real,
    )
    fold = absorb_linear<F, L>(
        fold,
        air.xy.output,
        air.xy.output,
        false,
        air.double_xy,
    )
    fold = absorb_linear<F, L>(
        fold,
        air.double_xy.output,
        air.point.imaginary,
        false,
        air.next_imaginary,
    )
    fold = absorb_fixed_equality<F, L>(fold, air.next_real.output, air.next.real)
    fold = absorb_fixed_equality<F, L>(fold, air.next_imaginary.output, air.next.imaginary)
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

/// Scalar-witness adapter for the pure field interpreter. It deliberately
/// streams typed subrecords into the fold instead of returning or passing one
/// fully flattened transition aggregate across a backend ABI boundary.
pub fn evaluate_transition_witness_constraints<
    F: Radix2Field,
    const L: usize,
>(
    _ challenge: F,
    _ base_modulus: u32,
    _ point_value: ComplexFixed<L>,
    _ current_value: ComplexFixed<L>,
    _ next_value: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> FixedAirConstraintEvaluation<F> {
    if !convolution_is_safe_below<L>(base_modulus)
        || product_carry_bound<L>() >= 262144
    {
        return FixedAirConstraintEvaluation {
            valid: false,
            constraints: 0,
            folded: zero<F>(),
        }
    }
    let point = air_complex<F, L>(point_value)
    let current = air_complex<F, L>(current_value)
    let next = air_complex<F, L>(next_value)
    let xx = air_product<F, L>(witness.xx)
    let yy = air_product<F, L>(witness.yy)
    let xy = air_product<F, L>(witness.xy)
    let real_difference = air_linear<F, L>(witness.real_difference)
    let next_real = air_linear<F, L>(witness.next_real)
    let double_xy = air_linear<F, L>(witness.double_xy)
    let next_imaginary = air_linear<F, L>(witness.next_imaginary)

    let mut fold = ConstraintFold<F>::new(challenge)
    fold = fold.absorb(sub(boolean<F>(witness.valid), one<F>()))
    fold = absorb_ranged_fixed<F, L>(fold, point.real)
    fold = absorb_ranged_fixed<F, L>(fold, point.imaginary)
    fold = absorb_ranged_fixed<F, L>(fold, current.real)
    fold = absorb_ranged_fixed<F, L>(fold, current.imaginary)
    fold = absorb_ranged_fixed<F, L>(fold, next.real)
    fold = absorb_ranged_fixed<F, L>(fold, next.imaginary)
    fold = absorb_product<F, L>(fold, current.real, current.real, xx)
    fold = absorb_product<F, L>(fold, current.imaginary, current.imaginary, yy)
    fold = absorb_product<F, L>(fold, current.real, current.imaginary, xy)
    fold = absorb_linear<F, L>(
        fold,
        xx.output,
        yy.output,
        true,
        real_difference,
    )
    fold = absorb_linear<F, L>(
        fold,
        real_difference.output,
        point.real,
        false,
        next_real,
    )
    fold = absorb_linear<F, L>(
        fold,
        xy.output,
        xy.output,
        false,
        double_xy,
    )
    fold = absorb_linear<F, L>(
        fold,
        double_xy.output,
        point.imaginary,
        false,
        next_imaginary,
    )
    fold = absorb_fixed_equality<F, L>(fold, next_real.output, next.real)
    fold = absorb_fixed_equality<F, L>(fold, next_imaginary.output, next.imaginary)
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}
