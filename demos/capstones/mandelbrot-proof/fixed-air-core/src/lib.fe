//! Pure field interpretation of the high-precision Mandelbrot recurrence DAG.
//!
//! The scalar witness generator and authenticated opening views both target
//! these typed records. Constraint code therefore contains no flat column IDs
//! and no host integer operations.

use canonical_words::{CanonicalWords, CanonicalWordsProvider}
use mandelbrot_proof_fixed_air::{
    BoundedU18Witness,
    FixedLinearWitness,
    FixedMandelbrotTransitionWitness,
    FixedProductCarryRangeWitness,
    FixedProductWitness,
    RadixRangeWitness,
    convolution_is_safe_below,
    convolution_left_index,
    convolution_right_index,
    convolution_term_count,
    derive_fixed_product_carry_range_witness,
    derive_radix_range_witness,
    product_carry_bound,
}
use mandelbrot_proof_recursive::ComplexFixed
use precision::fixed::Fixed
use precision::polynomial::{Radix2Field, write_batch_inverse_or_zero}

pub struct AirRadixLimbRange<F: Radix2Field> {
    pub bits: [F; 13],
    pub nonzero_prefix: [F; 13],
}
impl<F: Radix2Field> core::marker::Copy for AirRadixLimbRange<F> {}

pub struct AirRadixRange<F: Radix2Field, const L: usize> {
    pub limbs: [AirRadixLimbRange<F>; L],
    pub nonzero: F,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy for AirRadixRange<F, L> {}

pub struct AirRangedDigits<F: Radix2Field, const L: usize> {
    pub digits: [F; L],
    pub range: AirRadixRange<F, L>,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy for AirRangedDigits<F, L> {}

pub struct AirRangedFixed<F: Radix2Field, const L: usize> {
    pub negative: F,
    pub magnitude: AirRangedDigits<F, L>,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy for AirRangedFixed<F, L> {}

pub struct AirBoundedU18<F: Radix2Field> {
    pub bits: [F; 18],
    pub slack_bits: [F; 18],
}
impl<F: Radix2Field> core::marker::Copy for AirBoundedU18<F> {}

pub struct AirProductCarryRange<F: Radix2Field, const L: usize> {
    pub low: [AirBoundedU18<F>; L],
    pub high: [AirBoundedU18<F>; L],
}
impl<F: Radix2Field, const L: usize> core::marker::Copy
    for AirProductCarryRange<F, L> {}

pub struct AirProduct<F: Radix2Field, const L: usize> {
    pub valid: F,
    pub low: AirRangedDigits<F, L>,
    pub low_carries: [F; L],
    pub high: AirRangedDigits<F, L>,
    pub high_carries: [F; L],
    pub round_up: F,
    pub round_carries: [F; L],
    pub round_overflow: F,
    pub output: AirRangedFixed<F, L>,
    pub carry_range: AirProductCarryRange<F, L>,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy for AirProduct<F, L> {}

pub struct AirLinear<F: Radix2Field, const L: usize> {
    pub valid: F,
    pub same_sign: F,
    pub select_right: F,
    pub output_nonzero: F,
    pub sum: AirRangedDigits<F, L>,
    pub sum_carries: [F; L],
    pub left_difference: AirRangedDigits<F, L>,
    pub left_borrows: [F; L],
    pub right_difference: AirRangedDigits<F, L>,
    pub right_borrows: [F; L],
    pub output: AirRangedFixed<F, L>,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy for AirLinear<F, L> {}

pub struct AirComplex<F: Radix2Field, const L: usize> {
    pub real: AirRangedFixed<F, L>,
    pub imaginary: AirRangedFixed<F, L>,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy for AirComplex<F, L> {}

pub struct AirMandelbrotTransition<F: Radix2Field, const L: usize> {
    pub valid: F,
    pub point: AirComplex<F, L>,
    pub current: AirComplex<F, L>,
    pub next: AirComplex<F, L>,
    pub xx: AirProduct<F, L>,
    pub yy: AirProduct<F, L>,
    pub xy: AirProduct<F, L>,
    pub real_difference: AirLinear<F, L>,
    pub next_real: AirLinear<F, L>,
    pub double_xy: AirLinear<F, L>,
    pub next_imaginary: AirLinear<F, L>,
}
impl<F: Radix2Field, const L: usize> core::marker::Copy
    for AirMandelbrotTransition<F, L> {}

pub struct FixedAirConstraintEvaluation<F: Radix2Field> {
    pub valid: bool,
    pub constraints: u32,
    pub folded: F,
}
impl<F: Radix2Field> core::marker::Copy for FixedAirConstraintEvaluation<F> {}

pub enum ProductNode {
    Xx,
    Yy,
    Xy,
    Invalid,
}
impl core::marker::Copy for ProductNode {}

pub enum LinearNode {
    RealDifference,
    NextReal,
    DoubleXy,
    NextImaginary,
    Invalid,
}
impl core::marker::Copy for LinearNode {}

pub enum CoordinateNode {
    Real,
    Imaginary,
    Invalid,
}
impl core::marker::Copy for CoordinateNode {}

pub enum LinearLimbRole {
    Sum,
    LeftDifference,
    RightDifference,
    Select,
    Invalid,
}
impl core::marker::Copy for LinearLimbRole {}

/// Nominal radix vectors in the recurrence DAG. Product and linear payloads
/// keep the plan hierarchical, avoiding a manually numbered 31-vector table.
pub enum RangeNode {
    PointReal,
    PointImaginary,
    CurrentReal,
    CurrentImaginary,
    NextReal,
    NextImaginary,
    ProductLow(ProductNode),
    ProductHigh(ProductNode),
    ProductOutput(ProductNode),
    LinearSum(LinearNode),
    LinearLeftDifference(LinearNode),
    LinearRightDifference(LinearNode),
    LinearOutput(LinearNode),
    Invalid,
}
impl core::marker::Copy for RangeNode {}

/// Public recurrence values whose exact fixed-point digits must be bound to
/// the sparse trace. This semantic index is shared by commitment, composition,
/// and scheduling interpreters, so none of them maintain a parallel numeric
/// row table.
pub enum SparsePublicCoordinate {
    PointReal,
    PointImaginary,
    CurrentReal,
    CurrentImaginary,
    NextReal,
    NextImaginary,
    Invalid,
}
impl core::marker::Copy for SparsePublicCoordinate {}

/// One generated unit in the sparse transition trace. Each variant is a
/// semantic phase, and its payload is enough for scalar, packed, subgroup, or
/// workgroup interpreters to choose placement without changing the relation.
pub enum SparseTransitionTask {
    RadixBit(RangeNode, u32, u32),
    RadixLimb(RangeNode, u32),
    RadixFinish(RangeNode),
    CarryBit(ProductNode, u32, bool, u32),
    CarryFinish(ProductNode, u32),
    ProductTerm(ProductNode, u32, u32),
    ProductCoefficient(ProductNode, u32),
    ProductRound(ProductNode, u32),
    ProductFinish(ProductNode),
    LinearLimb(LinearNode, LinearLimbRole, u32),
    LinearFinish(LinearNode),
    BoundarySign(CoordinateNode),
    BoundaryLimb(CoordinateNode, u32),
    TransitionFinish,
    Invalid,
}
impl core::marker::Copy for SparseTransitionTask {}

/// Uniform witness columns used by the sparse interpreters. A task gives the
/// columns their local meaning. The two accumulator pairs are deliberately
/// generic so the same trace shape can host radix reconstruction, carry bit
/// reconstruction, convolution reduction, and linear ripples.
pub struct SparseTaskRow<F: Radix2Field> {
    pub value: F,
    pub auxiliary: F,
    pub accumulator_before: F,
    pub accumulator_after: F,
    pub state_before: F,
    pub state_after: F,
}
impl<F: Radix2Field> core::marker::Copy for SparseTaskRow<F> {}
derive CanonicalWords for SparseTaskRow<F> using CanonicalWordsProvider

/// Algebraic task-kind columns for the sparse transition schedule. These are
/// committed field values, not host enum tags. Keeping each role named lets
/// the same control trace be evaluated at base rows and at LDE points without
/// consulting a row index or dispatching through `SparseTransitionTask`.
pub struct SparseControlSelectors<F: Radix2Field> {
    pub radix_bit: F,
    pub radix_limb: F,
    pub radix_finish: F,
    pub carry_bit: F,
    pub carry_finish: F,
    pub product_term: F,
    pub product_coefficient: F,
    pub product_round: F,
    pub product_finish: F,
    pub linear_limb: F,
    pub linear_finish: F,
    pub boundary_sign: F,
    pub boundary_limb: F,
    pub transition_finish: F,
    pub padding: F,
}
impl<F: Radix2Field> core::marker::Copy for SparseControlSelectors<F> {}
derive Eq for SparseControlSelectors<F>
derive CanonicalWords for SparseControlSelectors<F> using CanonicalWordsProvider

/// Low-degree role selectors for the four signed linear limb relations.
/// Keeping these columns explicit avoids a cubic interpolation in the role
/// counter and therefore keeps the arithmetic composition degree small.
pub struct SparseLinearRoleSelectors<F: Radix2Field> {
    pub sum: F,
    pub left_difference: F,
    pub right_difference: F,
    pub select: F,
}
impl<F: Radix2Field> core::marker::Copy for SparseLinearRoleSelectors<F> {}
derive Eq for SparseLinearRoleSelectors<F>
derive CanonicalWords for SparseLinearRoleSelectors<F> using CanonicalWordsProvider

/// Semantic range roles shared by radix constraints and copy interactions.
/// These named low-degree columns replace both a 31-way numeric lookup and a
/// high-degree interpolation in the flattened range-node counter.
pub struct SparseRangeRoleSelectors<F: Radix2Field> {
    pub coordinate: F,
    pub product_low: F,
    pub product_high: F,
    pub product_output: F,
    pub linear_sum: F,
    pub linear_left_difference: F,
    pub linear_right_difference: F,
    pub linear_output: F,
}
impl<F: Radix2Field> core::marker::Copy for SparseRangeRoleSelectors<F> {}
derive Eq for SparseRangeRoleSelectors<F>
derive CanonicalWords for SparseRangeRoleSelectors<F> using CanonicalWordsProvider

/// Low-degree position selectors for the two radix limbs that define the
/// fixed-point rounding boundary. They replace an equality interpolation whose
/// degree would otherwise grow with `L`.
pub struct SparseLimbPositionSelectors<F: Radix2Field> {
    pub penultimate: F,
    pub last: F,
}
impl<F: Radix2Field> core::marker::Copy for SparseLimbPositionSelectors<F> {}
derive Eq for SparseLimbPositionSelectors<F>
derive CanonicalWords for SparseLimbPositionSelectors<F> using CanonicalWordsProvider

/// Polynomial control state paired with one sparse witness row.
///
/// `major`, `minor`, and `step` are semantic counters whose meaning is chosen
/// by the named selector. `flag` distinguishes carry slack bits and the
/// descending half of a convolution. `width` is the number of convolution
/// terms for the active coefficient. `weight` is the radix bit weight.
pub struct SparseControlRow<F: Radix2Field> {
    pub selectors: SparseControlSelectors<F>,
    pub linear_roles: SparseLinearRoleSelectors<F>,
    pub range_roles: SparseRangeRoleSelectors<F>,
    pub limb_positions: SparseLimbPositionSelectors<F>,
    pub major: F,
    pub minor: F,
    pub step: F,
    pub flag: F,
    pub width: F,
    pub weight: F,
}
impl<F: Radix2Field> core::marker::Copy for SparseControlRow<F> {}
derive Eq for SparseControlRow<F>
derive CanonicalWords for SparseControlRow<F> using CanonicalWordsProvider

/// Transcript challenges for one log-derivative copy interaction. `beta`
/// compresses the copied value with its nominal address, while `gamma` moves
/// the inverse pole away from the committed tuples.
pub struct SparseCopyChallenges<F: Radix2Field> {
    pub beta: F,
    pub gamma: F,
}
impl<F: Radix2Field> core::marker::Copy for SparseCopyChallenges<F> {}
derive CanonicalWords for SparseCopyChallenges<F> using CanonicalWordsProvider

/// Extension-trace columns for a fixed-width copy interaction. The port count
/// is part of the type, so each semantic bus can select its required width
/// while sharing one constraint and prover interpretation.
pub struct SparseCopyInteractionRow<F, const PORTS: usize> {
    pub accumulator: F,
    pub inverses: [F; PORTS],
}
impl<F: Radix2Field, const PORTS: usize> core::marker::Copy
    for SparseCopyInteractionRow<F, PORTS> {}
derive CanonicalWords for SparseCopyInteractionRow<F, PORTS> using CanonicalWordsProvider

/// Two product ports remain sufficient after scan adjacency removes the
/// redundant carry-in copy from the older scalar audit.
pub type SparseProductInteractionRow<F> = SparseCopyInteractionRow<F, 2>

/// Rounding needs at most five simultaneous semantic ports: guard, output
/// sign, output nonzero, and the two input signs.
pub type SparseRoundInteractionRow<F> = SparseCopyInteractionRow<F, 5>

/// Linear rows need six consumer ports plus two simultaneously derived
/// control values on each finish row.
pub type SparseLinearInteractionRow<F> = SparseCopyInteractionRow<F, 8>

/// Each boundary row compares one computed value with one claimed value.
pub type SparseBoundaryInteractionRow<F> = SparseCopyInteractionRow<F, 2>

/// A folded local interaction evaluation plus the accumulator delta produced
/// by the same constrained ports.
pub struct SparseInteractionEvaluation<F: Radix2Field> {
    pub valid: bool,
    pub constraints: u32,
    pub folded: F,
    pub delta: F,
}
impl<F: Radix2Field> core::marker::Copy for SparseInteractionEvaluation<F> {}

/// Nominal addresses for values copied between distant sparse phases. The
/// field key is derived from this type, so application code never maintains a
/// numeric column or memory-address table.
pub enum SparseCopyAddress {
    RangeDigit(RangeNode, u32),
    RangeBit(RangeNode, u32, u32),
    RangeSign(RangeNode),
    RangeNonzero(RangeNode),
    ProductCarry(ProductNode, u32),
    LinearBorrow(LinearNode, bool),
    LinearSameSign(LinearNode),
    LinearSelectRight(LinearNode),
    Invalid,
}
impl core::marker::Copy for SparseCopyAddress {}

pub const fn sparse_range_node_count() -> u32 { 31 }
pub const fn sparse_product_node_count() -> u32 { 3 }
pub const fn sparse_linear_node_count() -> u32 { 4 }
pub const fn sparse_public_coordinate_count() -> u32 { 6 }

pub fn sparse_public_coordinate_at(_ index: u32) -> SparsePublicCoordinate {
    match index {
        0 => SparsePublicCoordinate::PointReal,
        1 => SparsePublicCoordinate::PointImaginary,
        2 => SparsePublicCoordinate::CurrentReal,
        3 => SparsePublicCoordinate::CurrentImaginary,
        4 => SparsePublicCoordinate::NextReal,
        5 => SparsePublicCoordinate::NextImaginary,
        _ => SparsePublicCoordinate::Invalid,
    }
}

fn sparse_public_coordinate_rank(_ coordinate: SparsePublicCoordinate) -> u32 {
    match coordinate {
        SparsePublicCoordinate::PointReal => 0,
        SparsePublicCoordinate::PointImaginary => 1,
        SparsePublicCoordinate::CurrentReal => 2,
        SparsePublicCoordinate::CurrentImaginary => 3,
        SparsePublicCoordinate::NextReal => 4,
        SparsePublicCoordinate::NextImaginary => 5,
        SparsePublicCoordinate::Invalid => sparse_public_coordinate_count(),
    }
}

fn sparse_public_range_matches(
    _ coordinate: SparsePublicCoordinate,
    _ node: RangeNode,
) -> bool {
    match coordinate {
        SparsePublicCoordinate::PointReal => match node {
            RangeNode::PointReal => true,
            _ => false,
        },
        SparsePublicCoordinate::PointImaginary => match node {
            RangeNode::PointImaginary => true,
            _ => false,
        },
        SparsePublicCoordinate::CurrentReal => match node {
            RangeNode::CurrentReal => true,
            _ => false,
        },
        SparsePublicCoordinate::CurrentImaginary => match node {
            RangeNode::CurrentImaginary => true,
            _ => false,
        },
        SparsePublicCoordinate::NextReal => match node {
            RangeNode::NextReal => true,
            _ => false,
        },
        SparsePublicCoordinate::NextImaginary => match node {
            RangeNode::NextImaginary => true,
            _ => false,
        },
        SparsePublicCoordinate::Invalid => false,
    }
}

/// Row containing one canonical 13-bit limb of a public coordinate. The
/// formula is the radix prefix of `sparse_transition_task_at`, expressed once
/// beside that plan rather than copied into a proof consumer.
pub fn sparse_public_limb_trace_row<const L: usize>(
    _ coordinate: SparsePublicCoordinate,
    _ limb: u32,
) -> u32 {
    let limbs: u32 = L.downcast_truncate()
    let rank = sparse_public_coordinate_rank(coordinate)
    if L < 2 || rank >= sparse_public_coordinate_count() || limb >= limbs {
        return sparse_transition_task_count<L>()
    }
    rank * (limbs * 14 + 1) + limb * 14 + 13
}

/// Row containing the canonical sign of a public coordinate.
pub fn sparse_public_sign_trace_row<const L: usize>(
    _ coordinate: SparsePublicCoordinate,
) -> u32 {
    let limbs: u32 = L.downcast_truncate()
    let rank = sparse_public_coordinate_rank(coordinate)
    if L < 2 || rank >= sparse_public_coordinate_count() {
        return sparse_transition_task_count<L>()
    }
    rank * (limbs * 14 + 1) + limbs * 14
}

pub fn sparse_public_constraint_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    sparse_public_coordinate_count() * (limbs + 1)
}

pub const fn sparse_radix_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    let ranges = sparse_range_node_count()
    ranges * (limbs * 14 + 1)
}

pub const fn sparse_carry_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    sparse_product_node_count() * limbs * 2 * 37
}

pub const fn sparse_product_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    sparse_product_node_count() * (limbs * limbs + limbs + limbs)
}

pub const fn sparse_round_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    sparse_product_node_count() * (limbs + 1)
}

pub const fn sparse_linear_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    sparse_linear_node_count() * (limbs * 4 + 1)
}

pub const fn sparse_boundary_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    2 * (limbs + 1) + 1
}

pub const fn sparse_transition_task_count<const L: usize>() -> u32 {
    let limbs: u32 = L.downcast_truncate()
    3 * limbs * limbs + 683 * limbs + 41
}

pub const fn sparse_transition_trace_length<const L: usize>() -> u32 {
    let tasks = sparse_transition_task_count<L>()
    let mut length: u32 = 1
    while length < tasks { length = length + length }
    length
}

pub const fn sparse_transition_trace_log<const L: usize>() -> u32 {
    let target = sparse_transition_trace_length<L>()
    let mut length: u32 = 1
    let mut log: u32 = 0
    while length < target {
        length = length + length
        log = log + 1
    }
    log
}

fn product_node_at(_ index: u32) -> ProductNode {
    match index {
        0 => ProductNode::Xx,
        1 => ProductNode::Yy,
        2 => ProductNode::Xy,
        _ => ProductNode::Invalid,
    }
}

fn linear_node_at(_ index: u32) -> LinearNode {
    match index {
        0 => LinearNode::RealDifference,
        1 => LinearNode::NextReal,
        2 => LinearNode::DoubleXy,
        3 => LinearNode::NextImaginary,
        _ => LinearNode::Invalid,
    }
}

fn coordinate_node_at(_ index: u32) -> CoordinateNode {
    match index {
        0 => CoordinateNode::Real,
        1 => CoordinateNode::Imaginary,
        _ => CoordinateNode::Invalid,
    }
}

fn linear_limb_role_at(_ index: u32) -> LinearLimbRole {
    match index {
        0 => LinearLimbRole::Sum,
        1 => LinearLimbRole::LeftDifference,
        2 => LinearLimbRole::RightDifference,
        3 => LinearLimbRole::Select,
        _ => LinearLimbRole::Invalid,
    }
}

fn range_node_at(_ index: u32) -> RangeNode {
    match index {
        0 => RangeNode::PointReal,
        1 => RangeNode::PointImaginary,
        2 => RangeNode::CurrentReal,
        3 => RangeNode::CurrentImaginary,
        4 => RangeNode::NextReal,
        5 => RangeNode::NextImaginary,
        _ => {
            if index < 15 {
                let local = index - 6
                let product = product_node_at(local / 3)
                match local - (local / 3) * 3 {
                    0 => RangeNode::ProductLow(product),
                    1 => RangeNode::ProductHigh(product),
                    _ => RangeNode::ProductOutput(product),
                }
            } else {
                if index < 31 {
                    let local = index - 15
                    let linear = linear_node_at(local / 4)
                    match local - (local / 4) * 4 {
                        0 => RangeNode::LinearSum(linear),
                        1 => RangeNode::LinearLeftDifference(linear),
                        2 => RangeNode::LinearRightDifference(linear),
                        _ => RangeNode::LinearOutput(linear),
                    }
                } else {
                    RangeNode::Invalid
                }
            }
        }
    }
}

/// Interleave every convolution coefficient with the terms that reduce into
/// it. This makes the accumulator at the end of one term row directly
/// available to the coefficient row, without a lookup into a distant phase.
fn sparse_product_work_at<const L: usize>(
    _ product: ProductNode,
    _ rank: u32,
) -> SparseTransitionTask {
    let limbs: u32 = L.downcast_truncate()
    let mut coefficient: u32 = 0
    let mut remaining = rank
    while coefficient < limbs + limbs {
        let terms = convolution_term_count<L>(coefficient)
        if remaining < terms {
            return SparseTransitionTask::ProductTerm(
                product,
                coefficient,
                remaining,
            )
        }
        remaining = remaining - terms
        if remaining == 0 {
            return SparseTransitionTask::ProductCoefficient(product, coefficient)
        }
        remaining = remaining - 1
        coefficient = coefficient + 1
    }
    SparseTransitionTask::Invalid
}

pub fn sparse_transition_task_at<const L: usize>(
    _ index: u32,
) -> SparseTransitionTask {
    if L < 2 || index >= sparse_transition_task_count<L>() {
        return SparseTransitionTask::Invalid
    }
    let limbs: u32 = L.downcast_truncate()
    let ranges = sparse_range_node_count()
    let products = sparse_product_node_count()
    let linears = sparse_linear_node_count()
    let mut remaining = index

    let radix_rows = ranges * (limbs * 14 + 1)
    if remaining < radix_rows {
        let per_range = limbs * 14 + 1
        let range_index = remaining / per_range
        let local = remaining - range_index * per_range
        if local < limbs * 14 {
            let limb = local / 14
            let within = local - limb * 14
            if within < 13 {
                return SparseTransitionTask::RadixBit(
                    range_node_at(range_index),
                    limb,
                    within,
                )
            }
            return SparseTransitionTask::RadixLimb(
                range_node_at(range_index),
                limb,
            )
        }
        return SparseTransitionTask::RadixFinish(range_node_at(range_index))
    }
    remaining = remaining - radix_rows

    let carry_rows = products * limbs * 2 * 37
    if remaining < carry_rows {
        let per_product = limbs * 2 * 37
        let product_index = remaining / per_product
        let local = remaining - product_index * per_product
        let coefficient = local / 37
        let within = local - coefficient * 37
        if within < 36 {
            return SparseTransitionTask::CarryBit(
                product_node_at(product_index),
                coefficient,
                within >= 18,
                if within >= 18 { within - 18 } else { within },
            )
        }
        return SparseTransitionTask::CarryFinish(
            product_node_at(product_index),
            coefficient,
        )
    }
    remaining = remaining - carry_rows

    let product_rows = products * (limbs * limbs + limbs + limbs)
    if remaining < product_rows {
        let per_product = limbs * limbs + limbs + limbs
        return sparse_product_work_at<L>(
            product_node_at(remaining / per_product),
            remaining - (remaining / per_product) * per_product,
        )
    }
    remaining = remaining - product_rows

    let product_round_rows = products * (limbs + 1)
    if remaining < product_round_rows {
        let per_product = limbs + 1
        let product_index = remaining / per_product
        let local = remaining - product_index * per_product
        if local < limbs {
            return SparseTransitionTask::ProductRound(
                product_node_at(product_index),
                local,
            )
        }
        return SparseTransitionTask::ProductFinish(product_node_at(product_index))
    }
    remaining = remaining - product_round_rows

    let linear_rows = linears * (limbs * 4 + 1)
    if remaining < linear_rows {
        let per_linear = limbs * 4 + 1
        let linear_index = remaining / per_linear
        let local = remaining - linear_index * per_linear
        if local < limbs * 4 {
            return SparseTransitionTask::LinearLimb(
                linear_node_at(linear_index),
                linear_limb_role_at(local / limbs),
                local - (local / limbs) * limbs,
            )
        }
        return SparseTransitionTask::LinearFinish(linear_node_at(linear_index))
    }
    remaining = remaining - linear_rows

    if remaining < 2 * (limbs + 1) {
        let per_coordinate = limbs + 1
        let coordinate_index = remaining / per_coordinate
        let local = remaining - coordinate_index * per_coordinate
        if local == 0 {
            return SparseTransitionTask::BoundarySign(
                coordinate_node_at(coordinate_index),
            )
        }
        return SparseTransitionTask::BoundaryLimb(
            coordinate_node_at(coordinate_index),
            local - 1,
        )
    }
    SparseTransitionTask::TransitionFinish
}

/// Executable coherence check between the public-position API and the exact
/// generated sparse task plan. A task-plan refactor therefore fails closed
/// until the semantic position interpreter is updated with it.
pub fn sparse_public_positions_follow_task_plan<const L: usize>() -> bool {
    if L < 2 { return false }
    let limbs: u32 = L.downcast_truncate()
    let mut coordinate_index: u32 = 0
    while coordinate_index < sparse_public_coordinate_count() {
        let coordinate = sparse_public_coordinate_at(coordinate_index)
        let mut limb: u32 = 0
        while limb < limbs {
            let row = sparse_public_limb_trace_row<L>(coordinate, limb)
            match sparse_transition_task_at<L>(row) {
                SparseTransitionTask::RadixLimb(node, task_limb) => {
                    if task_limb != limb
                        || !sparse_public_range_matches(coordinate, node) {
                        return false
                    }
                }
                _ => return false,
            }
            limb = limb + 1
        }
        let sign_row = sparse_public_sign_trace_row<L>(coordinate)
        match sparse_transition_task_at<L>(sign_row) {
            SparseTransitionTask::RadixFinish(node) => {
                if !sparse_public_range_matches(coordinate, node) {
                    return false
                }
            }
            _ => return false,
        }
        coordinate_index = coordinate_index + 1
    }
    true
}

fn range_node_digits<const L: usize>(
    _ node: RangeNode,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> [u32; L] {
    match node {
        RangeNode::PointReal => point.real.limbs,
        RangeNode::PointImaginary => point.imaginary.limbs,
        RangeNode::CurrentReal => current.real.limbs,
        RangeNode::CurrentImaginary => current.imaginary.limbs,
        RangeNode::NextReal => next.real.limbs,
        RangeNode::NextImaginary => next.imaginary.limbs,
        RangeNode::ProductLow(ProductNode::Xx) => witness.xx.low_digits,
        RangeNode::ProductHigh(ProductNode::Xx) => witness.xx.high_digits,
        RangeNode::ProductOutput(ProductNode::Xx) => witness.xx.output.limbs,
        RangeNode::ProductLow(ProductNode::Yy) => witness.yy.low_digits,
        RangeNode::ProductHigh(ProductNode::Yy) => witness.yy.high_digits,
        RangeNode::ProductOutput(ProductNode::Yy) => witness.yy.output.limbs,
        RangeNode::ProductLow(ProductNode::Xy) => witness.xy.low_digits,
        RangeNode::ProductHigh(ProductNode::Xy) => witness.xy.high_digits,
        RangeNode::ProductOutput(ProductNode::Xy) => witness.xy.output.limbs,
        RangeNode::LinearSum(LinearNode::RealDifference) => {
            witness.real_difference.sum_digits
        }
        RangeNode::LinearLeftDifference(LinearNode::RealDifference) => {
            witness.real_difference.left_difference_digits
        }
        RangeNode::LinearRightDifference(LinearNode::RealDifference) => {
            witness.real_difference.right_difference_digits
        }
        RangeNode::LinearOutput(LinearNode::RealDifference) => {
            witness.real_difference.output.limbs
        }
        RangeNode::LinearSum(LinearNode::NextReal) => witness.next_real.sum_digits,
        RangeNode::LinearLeftDifference(LinearNode::NextReal) => {
            witness.next_real.left_difference_digits
        }
        RangeNode::LinearRightDifference(LinearNode::NextReal) => {
            witness.next_real.right_difference_digits
        }
        RangeNode::LinearOutput(LinearNode::NextReal) => witness.next_real.output.limbs,
        RangeNode::LinearSum(LinearNode::DoubleXy) => witness.double_xy.sum_digits,
        RangeNode::LinearLeftDifference(LinearNode::DoubleXy) => {
            witness.double_xy.left_difference_digits
        }
        RangeNode::LinearRightDifference(LinearNode::DoubleXy) => {
            witness.double_xy.right_difference_digits
        }
        RangeNode::LinearOutput(LinearNode::DoubleXy) => witness.double_xy.output.limbs,
        RangeNode::LinearSum(LinearNode::NextImaginary) => {
            witness.next_imaginary.sum_digits
        }
        RangeNode::LinearLeftDifference(LinearNode::NextImaginary) => {
            witness.next_imaginary.left_difference_digits
        }
        RangeNode::LinearRightDifference(LinearNode::NextImaginary) => {
            witness.next_imaginary.right_difference_digits
        }
        RangeNode::LinearOutput(LinearNode::NextImaginary) => {
            witness.next_imaginary.output.limbs
        }
        _ => [0; L],
    }
}

fn range_node_is_signed(_ node: RangeNode) -> bool {
    match node {
        RangeNode::PointReal => true,
        RangeNode::PointImaginary => true,
        RangeNode::CurrentReal => true,
        RangeNode::CurrentImaginary => true,
        RangeNode::NextReal => true,
        RangeNode::NextImaginary => true,
        RangeNode::ProductOutput(_) => true,
        RangeNode::LinearOutput(_) => true,
        _ => false,
    }
}

fn range_node_is_product_output(_ node: RangeNode) -> bool {
    match node {
        RangeNode::ProductOutput(_) => true,
        _ => false,
    }
}

fn range_node_negative<const L: usize>(
    _ node: RangeNode,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> bool {
    match node {
        RangeNode::PointReal => point.real.negative,
        RangeNode::PointImaginary => point.imaginary.negative,
        RangeNode::CurrentReal => current.real.negative,
        RangeNode::CurrentImaginary => current.imaginary.negative,
        RangeNode::NextReal => next.real.negative,
        RangeNode::NextImaginary => next.imaginary.negative,
        RangeNode::ProductOutput(ProductNode::Xx) => witness.xx.output.negative,
        RangeNode::ProductOutput(ProductNode::Yy) => witness.yy.output.negative,
        RangeNode::ProductOutput(ProductNode::Xy) => witness.xy.output.negative,
        RangeNode::LinearOutput(LinearNode::RealDifference) => {
            witness.real_difference.output.negative
        }
        RangeNode::LinearOutput(LinearNode::NextReal) => {
            witness.next_real.output.negative
        }
        RangeNode::LinearOutput(LinearNode::DoubleXy) => {
            witness.double_xy.output.negative
        }
        RangeNode::LinearOutput(LinearNode::NextImaginary) => {
            witness.next_imaginary.output.negative
        }
        _ => false,
    }
}

fn radix_prefix_before<const L: usize>(
    _ range: RadixRangeWitness<L>,
    _ limb: u32,
    _ bit: u32,
) -> u32 {
    if bit > 0 {
        range.limbs[limb as usize].nonzero_prefix[(bit - 1) as usize]
    } else {
        if limb > 0 {
            range.limbs[(limb - 1) as usize].nonzero_prefix[12]
        } else {
            0
        }
    }
}

fn radix_reconstruction_before<const L: usize>(
    _ range: RadixRangeWitness<L>,
    _ limb: u32,
    _ bit: u32,
) -> u32 {
    let mut reconstructed: u32 = 0
    let mut index: u32 = 0
    let mut place: u32 = 1
    while index < bit {
        reconstructed = reconstructed
            + range.limbs[limb as usize].bits[index as usize] * place
        place = place + place
        index = index + 1
    }
    reconstructed
}

fn empty_sparse_row<F: Radix2Field>() -> SparseTaskRow<F> {
    SparseTaskRow {
        value: zero<F>(),
        auxiliary: zero<F>(),
        accumulator_before: zero<F>(),
        accumulator_after: zero<F>(),
        state_before: zero<F>(),
        state_after: zero<F>(),
    }
}

/// Derive one narrow radix row from the exact transition witness. Only six
/// field columns cross this interpretation boundary, regardless of precision.
pub fn sparse_radix_row_from_witness<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    match task {
        SparseTransitionTask::RadixBit(node, limb, bit) => {
            let digits = range_node_digits(node, point, current, next, witness)
            let range = derive_radix_range_witness(digits)
            let before = radix_reconstruction_before(range, limb, bit)
            let value = range.limbs[limb as usize].bits[bit as usize]
            SparseTaskRow {
                value: natural<F>(value),
                auxiliary: zero<F>(),
                accumulator_before: natural<F>(before),
                accumulator_after: natural<F>(before + value * (1 << bit)),
                state_before: natural<F>(radix_prefix_before(range, limb, bit)),
                state_after: natural<F>(
                    range.limbs[limb as usize].nonzero_prefix[bit as usize],
                ),
            }
        }
        SparseTransitionTask::RadixLimb(node, limb) => {
            let digits = range_node_digits(node, point, current, next, witness)
            let range = derive_radix_range_witness(digits)
            let prefix = range.limbs[limb as usize].nonzero_prefix[12]
            SparseTaskRow {
                value: natural<F>(digits[limb as usize]),
                auxiliary: zero<F>(),
                accumulator_before: natural<F>(
                    radix_reconstruction_before(range, limb, 13),
                ),
                accumulator_after: zero<F>(),
                state_before: natural<F>(prefix),
                state_after: natural<F>(prefix),
            }
        }
        SparseTransitionTask::RadixFinish(node) => {
            let digits = range_node_digits(node, point, current, next, witness)
            let range = derive_radix_range_witness(digits)
            SparseTaskRow {
                value: boolean<F>(range.nonzero),
                auxiliary: boolean<F>(
                    range_node_negative(node, point, current, next, witness),
                ),
                accumulator_before: zero<F>(),
                accumulator_after: zero<F>(),
                state_before: natural<F>(range.limbs[L - 1].nonzero_prefix[12]),
                state_after: zero<F>(),
            }
        }
        _ => empty_sparse_row<F>(),
    }
}

fn product_node_witness<const L: usize>(
    _ node: ProductNode,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> FixedProductWitness<L> {
    match node {
        ProductNode::Xx => witness.xx,
        ProductNode::Yy => witness.yy,
        ProductNode::Xy => witness.xy,
        ProductNode::Invalid => witness.xx,
    }
}

fn fixed_product_carry<const L: usize>(
    _ product: FixedProductWitness<L>,
    _ coefficient: u32,
) -> u32 {
    let limbs: u32 = L.downcast_truncate()
    if coefficient < limbs {
        product.low_carries[coefficient as usize]
    } else {
        product.high_carries[(coefficient - limbs) as usize]
    }
}

fn fixed_product_bounded_carry<const L: usize>(
    _ range: FixedProductCarryRangeWitness<L>,
    _ coefficient: u32,
) -> BoundedU18Witness {
    let limbs: u32 = L.downcast_truncate()
    if coefficient < limbs {
        range.low[coefficient as usize]
    } else {
        range.high[(coefficient - limbs) as usize]
    }
}

fn bits18_reconstruction_before(_ bits: [u32; 18], _ bit: u32) -> u32 {
    let mut reconstructed: u32 = 0
    let mut index: u32 = 0
    let mut place: u32 = 1
    while index < bit {
        reconstructed = reconstructed + bits[index as usize] * place
        place = place + place
        index = index + 1
    }
    reconstructed
}

/// Interpret one bounded product-carry task through the same six-column row.
/// The value-bit scan occupies the first accumulator. The slack scan resets
/// that accumulator and retains the reconstructed carry in the second pair.
pub fn sparse_carry_row_from_witness<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    match task {
        SparseTransitionTask::CarryBit(node, coefficient, slack, bit) => {
            let product = product_node_witness(node, witness)
            let range = derive_fixed_product_carry_range_witness(product)
            let bounded = fixed_product_bounded_carry(range, coefficient)
            let bits = if slack { bounded.slack_bits } else { bounded.bits }
            let before = bits18_reconstruction_before(bits, bit)
            let value = bits[bit as usize]
            let retained = if slack {
                fixed_product_carry(product, coefficient)
            } else {
                0
            }
            SparseTaskRow {
                value: natural<F>(value),
                auxiliary: zero<F>(),
                accumulator_before: natural<F>(before),
                accumulator_after: natural<F>(before + value * (1 << bit)),
                state_before: natural<F>(retained),
                state_after: natural<F>(retained),
            }
        }
        SparseTransitionTask::CarryFinish(node, coefficient) => {
            let product = product_node_witness(node, witness)
            let range = derive_fixed_product_carry_range_witness(product)
            let bounded = fixed_product_bounded_carry(range, coefficient)
            SparseTaskRow {
                value: natural<F>(fixed_product_carry(product, coefficient)),
                auxiliary: zero<F>(),
                accumulator_before: natural<F>(
                    bits18_reconstruction_before(bounded.slack_bits, 18),
                ),
                accumulator_after: zero<F>(),
                state_before: natural<F>(
                    bits18_reconstruction_before(bounded.bits, 18),
                ),
                state_after: zero<F>(),
            }
        }
        _ => empty_sparse_row<F>(),
    }
}

fn product_left_value<const L: usize>(
    _ node: ProductNode,
    _ current: ComplexFixed<L>,
) -> Fixed<L> {
    match node {
        ProductNode::Xx => current.real,
        ProductNode::Yy => current.imaginary,
        ProductNode::Xy => current.real,
        ProductNode::Invalid => current.real,
    }
}

fn product_right_value<const L: usize>(
    _ node: ProductNode,
    _ current: ComplexFixed<L>,
) -> Fixed<L> {
    match node {
        ProductNode::Xx => current.real,
        ProductNode::Yy => current.imaginary,
        ProductNode::Xy => current.imaginary,
        ProductNode::Invalid => current.real,
    }
}

fn fixed_product_digit<const L: usize>(
    _ product: FixedProductWitness<L>,
    _ coefficient: u32,
) -> u32 {
    let limbs: u32 = L.downcast_truncate()
    if coefficient < limbs {
        product.low_digits[coefficient as usize]
    } else {
        product.high_digits[(coefficient - limbs) as usize]
    }
}

fn product_term_accumulator_before<const L: usize>(
    _ left: Fixed<L>,
    _ right: Fixed<L>,
    _ coefficient: u32,
    _ term: u32,
) -> u32 {
    let mut accumulator: u32 = 0
    let mut index: u32 = 0
    while index < term {
        let left_index = convolution_left_index<L>(coefficient, index)
        let right_index = convolution_right_index<L>(coefficient, index)
        accumulator = accumulator
            + left.limbs[left_index as usize] * right.limbs[right_index as usize]
        index = index + 1
    }
    accumulator
}

/// One convolution term or coefficient close in the shared six-column row.
/// Term products form an explicit reduction scan. The coefficient close
/// applies the incoming carry, emits the normalized digit and outgoing carry,
/// resets the reduction accumulator, and forwards the carry to the next
/// coefficient.
pub fn sparse_product_row_from_witness<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
    _ current: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    match task {
        SparseTransitionTask::ProductTerm(node, coefficient, term) => {
            let left = product_left_value(node, current)
            let right = product_right_value(node, current)
            let left_index = convolution_left_index<L>(coefficient, term)
            let right_index = convolution_right_index<L>(coefficient, term)
            let left_digit = left.limbs[left_index as usize]
            let right_digit = right.limbs[right_index as usize]
            let before = product_term_accumulator_before(
                left,
                right,
                coefficient,
                term,
            )
            let carry_in = if coefficient == 0 {
                0
            } else {
                fixed_product_carry(
                    product_node_witness(node, witness),
                    coefficient - 1,
                )
            }
            SparseTaskRow {
                value: natural<F>(left_digit),
                auxiliary: natural<F>(right_digit),
                accumulator_before: natural<F>(before),
                accumulator_after: natural<F>(before + left_digit * right_digit),
                state_before: natural<F>(carry_in),
                state_after: natural<F>(carry_in),
            }
        }
        SparseTransitionTask::ProductCoefficient(node, coefficient) => {
            let product = product_node_witness(node, witness)
            let left = product_left_value(node, current)
            let right = product_right_value(node, current)
            let terms = convolution_term_count<L>(coefficient)
            let carry_in = if coefficient == 0 {
                0
            } else {
                fixed_product_carry(product, coefficient - 1)
            }
            let carry_out = fixed_product_carry(product, coefficient)
            SparseTaskRow {
                value: natural<F>(fixed_product_digit(product, coefficient)),
                auxiliary: natural<F>(carry_out),
                accumulator_before: natural<F>(product_term_accumulator_before(
                    left,
                    right,
                    coefficient,
                    terms,
                )),
                accumulator_after: zero<F>(),
                state_before: natural<F>(carry_in),
                state_after: natural<F>(carry_out),
            }
        }
        _ => empty_sparse_row<F>(),
    }
}

fn fixed_product_retained_digit<const L: usize>(
    _ product: FixedProductWitness<L>,
    _ output_index: u32,
) -> u32 {
    if output_index == 0 {
        product.low_digits[L - 1]
    } else {
        product.high_digits[(output_index - 1) as usize]
    }
}

/// The rounding ripple reuses the arithmetic row. Its state pair retains the
/// guard-bit decision across all limbs. The finish row then reuses the six
/// fields for the final carry and four sign inputs; product groups reset
/// explicitly instead of linking those semantic fields into the next group.
pub fn sparse_round_row_from_witness<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
    _ current: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    match task {
        SparseTransitionTask::ProductRound(node, output_index) => {
            let product = product_node_witness(node, witness)
            let round_up = if product.round_up { 1 } else { 0 }
            let carry_in = if output_index == 0 {
                round_up
            } else {
                product.round_carries[(output_index - 1) as usize]
            }
            SparseTaskRow {
                value: natural<F>(fixed_product_retained_digit(product, output_index)),
                auxiliary: natural<F>(product.output.limbs[output_index as usize]),
                accumulator_before: natural<F>(carry_in),
                accumulator_after: natural<F>(
                    product.round_carries[output_index as usize],
                ),
                state_before: natural<F>(round_up),
                state_after: natural<F>(round_up),
            }
        }
        SparseTransitionTask::ProductFinish(node) => {
            let product = product_node_witness(node, witness)
            let left = product_left_value(node, current)
            let right = product_right_value(node, current)
            let output_range = derive_radix_range_witness(product.output.limbs)
            SparseTaskRow {
                value: boolean<F>(product.output.negative),
                auxiliary: boolean<F>(output_range.nonzero),
                accumulator_before: natural<F>(product.round_carries[L - 1]),
                accumulator_after: boolean<F>(left.negative),
                state_before: boolean<F>(product.round_up),
                state_after: boolean<F>(right.negative),
            }
        }
        _ => empty_sparse_row<F>(),
    }
}

fn linear_node_witness<const L: usize>(
    _ node: LinearNode,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> FixedLinearWitness<L> {
    match node {
        LinearNode::RealDifference => witness.real_difference,
        LinearNode::NextReal => witness.next_real,
        LinearNode::DoubleXy => witness.double_xy,
        LinearNode::NextImaginary => witness.next_imaginary,
        LinearNode::Invalid => witness.real_difference,
    }
}

fn linear_left_value<const L: usize>(
    _ node: LinearNode,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> Fixed<L> {
    match node {
        LinearNode::RealDifference => witness.xx.output,
        LinearNode::NextReal => witness.real_difference.output,
        LinearNode::DoubleXy => witness.xy.output,
        LinearNode::NextImaginary => witness.double_xy.output,
        LinearNode::Invalid => witness.xx.output,
    }
}

fn linear_right_value<const L: usize>(
    _ node: LinearNode,
    _ point: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> Fixed<L> {
    match node {
        LinearNode::RealDifference => witness.yy.output,
        LinearNode::NextReal => point.real,
        LinearNode::DoubleXy => witness.xy.output,
        LinearNode::NextImaginary => point.imaginary,
        LinearNode::Invalid => witness.yy.output,
    }
}

fn linear_subtracts_right(_ node: LinearNode) -> bool {
    match node {
        LinearNode::RealDifference => true,
        _ => false,
    }
}

/// Four role-specific rows keep each signed linear limb narrow. Carry and
/// borrow roles form independent adjacency chains; selection consumes their
/// range-constrained digits through the linear copy bus.
pub fn sparse_linear_row_from_witness<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
    _ point: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    match task {
        SparseTransitionTask::LinearLimb(node, role, limb) => {
            let linear = linear_node_witness(node, witness)
            let left = linear_left_value(node, witness)
            let right = linear_right_value(node, point, witness)
            match role {
                LinearLimbRole::Sum => SparseTaskRow {
                    value: natural<F>(left.limbs[limb as usize]),
                    auxiliary: natural<F>(right.limbs[limb as usize]),
                    accumulator_before: natural<F>(if limb == 0 {
                        0
                    } else {
                        linear.sum_carries[(limb - 1) as usize]
                    }),
                    accumulator_after: natural<F>(linear.sum_carries[limb as usize]),
                    state_before: natural<F>(linear.sum_digits[limb as usize]),
                    state_after: zero<F>(),
                },
                LinearLimbRole::LeftDifference => SparseTaskRow {
                    value: natural<F>(left.limbs[limb as usize]),
                    auxiliary: natural<F>(right.limbs[limb as usize]),
                    accumulator_before: natural<F>(if limb == 0 {
                        0
                    } else {
                        linear.left_borrows[(limb - 1) as usize]
                    }),
                    accumulator_after: natural<F>(linear.left_borrows[limb as usize]),
                    state_before: natural<F>(
                        linear.left_difference_digits[limb as usize],
                    ),
                    state_after: zero<F>(),
                },
                LinearLimbRole::RightDifference => SparseTaskRow {
                    value: natural<F>(left.limbs[limb as usize]),
                    auxiliary: natural<F>(right.limbs[limb as usize]),
                    accumulator_before: natural<F>(if limb == 0 {
                        0
                    } else {
                        linear.right_borrows[(limb - 1) as usize]
                    }),
                    accumulator_after: natural<F>(linear.right_borrows[limb as usize]),
                    state_before: natural<F>(
                        linear.right_difference_digits[limb as usize],
                    ),
                    state_after: zero<F>(),
                },
                LinearLimbRole::Select => SparseTaskRow {
                    value: natural<F>(linear.sum_digits[limb as usize]),
                    auxiliary: natural<F>(
                        linear.left_difference_digits[limb as usize],
                    ),
                    accumulator_before: natural<F>(
                        linear.right_difference_digits[limb as usize],
                    ),
                    accumulator_after: natural<F>(linear.output.limbs[limb as usize]),
                    state_before: boolean<F>(linear.same_sign),
                    state_after: boolean<F>(linear.select_right),
                },
                LinearLimbRole::Invalid => empty_sparse_row<F>(),
            }
        }
        SparseTransitionTask::LinearFinish(node) => {
            let linear = linear_node_witness(node, witness)
            let left = linear_left_value(node, witness)
            let right = linear_right_value(node, point, witness)
            let output_range = derive_radix_range_witness(linear.output.limbs)
            SparseTaskRow {
                value: boolean<F>(left.negative),
                auxiliary: boolean<F>(right.negative),
                accumulator_before: natural<F>(linear.left_borrows[L - 1]),
                accumulator_after: natural<F>(linear.right_borrows[L - 1]),
                state_before: boolean<F>(output_range.nonzero),
                state_after: boolean<F>(linear.output.negative),
            }
        }
        _ => empty_sparse_row<F>(),
    }
}

fn boundary_computed<const L: usize>(
    _ coordinate: CoordinateNode,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> Fixed<L> {
    match coordinate {
        CoordinateNode::Real => witness.next_real.output,
        CoordinateNode::Imaginary => witness.next_imaginary.output,
        CoordinateNode::Invalid => witness.next_real.output,
    }
}

fn boundary_claimed<const L: usize>(
    _ coordinate: CoordinateNode,
    _ next: ComplexFixed<L>,
) -> Fixed<L> {
    match coordinate {
        CoordinateNode::Real => next.real,
        CoordinateNode::Imaginary => next.imaginary,
        CoordinateNode::Invalid => next.real,
    }
}

pub fn sparse_boundary_row_from_witness<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    match task {
        SparseTransitionTask::BoundarySign(coordinate) => {
            let computed = boundary_computed(coordinate, witness)
            let claimed = boundary_claimed(coordinate, next)
            SparseTaskRow {
                value: boolean<F>(computed.negative),
                auxiliary: boolean<F>(claimed.negative),
                accumulator_before: zero<F>(),
                accumulator_after: zero<F>(),
                state_before: zero<F>(),
                state_after: zero<F>(),
            }
        }
        SparseTransitionTask::BoundaryLimb(coordinate, limb) => {
            let computed = boundary_computed(coordinate, witness)
            let claimed = boundary_claimed(coordinate, next)
            SparseTaskRow {
                value: natural<F>(computed.limbs[limb as usize]),
                auxiliary: natural<F>(claimed.limbs[limb as usize]),
                accumulator_before: zero<F>(),
                accumulator_after: zero<F>(),
                state_before: zero<F>(),
                state_after: zero<F>(),
            }
        }
        SparseTransitionTask::TransitionFinish => SparseTaskRow {
            value: boolean<F>(witness.valid),
            auxiliary: zero<F>(),
            accumulator_before: zero<F>(),
            accumulator_after: zero<F>(),
            state_before: zero<F>(),
            state_after: zero<F>(),
        },
        _ => empty_sparse_row<F>(),
    }
}

/// Interpret one generated task into the canonical six-column sparse row.
/// This is the shared scalar source for commitments, LDE construction, and
/// future GPU placement interpreters. Padding rows are derived from the same
/// task plan and are canonical zeroes, so callers never maintain a parallel
/// phase table or witness-layout switch.
pub fn sparse_transition_row_from_witness<F: Radix2Field, const L: usize>(
    _ index: u32,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTaskRow<F> {
    let task = sparse_transition_task_at<L>(index)
    match task {
        SparseTransitionTask::RadixBit(_, _, _) => {
            sparse_radix_row_from_witness<F, L>(task, point, current, next, witness)
        }
        SparseTransitionTask::RadixLimb(_, _) => {
            sparse_radix_row_from_witness<F, L>(task, point, current, next, witness)
        }
        SparseTransitionTask::RadixFinish(_) => {
            sparse_radix_row_from_witness<F, L>(task, point, current, next, witness)
        }
        SparseTransitionTask::CarryBit(_, _, _, _) => {
            sparse_carry_row_from_witness<F, L>(task, witness)
        }
        SparseTransitionTask::CarryFinish(_, _) => {
            sparse_carry_row_from_witness<F, L>(task, witness)
        }
        SparseTransitionTask::ProductTerm(_, _, _) => {
            sparse_product_row_from_witness<F, L>(task, current, witness)
        }
        SparseTransitionTask::ProductCoefficient(_, _) => {
            sparse_product_row_from_witness<F, L>(task, current, witness)
        }
        SparseTransitionTask::ProductRound(_, _) => {
            sparse_round_row_from_witness<F, L>(task, current, witness)
        }
        SparseTransitionTask::ProductFinish(_) => {
            sparse_round_row_from_witness<F, L>(task, current, witness)
        }
        SparseTransitionTask::LinearLimb(_, _, _) => {
            sparse_linear_row_from_witness<F, L>(task, point, witness)
        }
        SparseTransitionTask::LinearFinish(_) => {
            sparse_linear_row_from_witness<F, L>(task, point, witness)
        }
        SparseTransitionTask::BoundarySign(_) => {
            sparse_boundary_row_from_witness<F, L>(task, next, witness)
        }
        SparseTransitionTask::BoundaryLimb(_, _) => {
            sparse_boundary_row_from_witness<F, L>(task, next, witness)
        }
        SparseTransitionTask::TransitionFinish => {
            sparse_boundary_row_from_witness<F, L>(task, next, witness)
        }
        SparseTransitionTask::Invalid => empty_sparse_row<F>(),
    }
}

fn zero<F: Radix2Field>() -> F { F::radix2_zero() }
fn one<F: Radix2Field>() -> F { F::radix2_root(0) }
fn add<F: Radix2Field>(_ left: F, _ right: F) -> F { left.radix2_add(right) }
fn sub<F: Radix2Field>(_ left: F, _ right: F) -> F { left.radix2_sub(right) }
fn mul<F: Radix2Field>(_ left: F, _ right: F) -> F { left.radix2_mul(right) }

fn natural<F: Radix2Field>(_ value: u32) -> F {
    let mut value = value
    let mut result = zero<F>()
    let mut place = one<F>()
    while value != 0 {
        if (value & 1) == 1 { result = add(result, place) }
        place = add(place, place)
        value = value >> 1
    }
    result
}

fn boolean<F: Radix2Field>(_ value: bool) -> F {
    natural<F>(if value { 1 } else { 0 })
}

fn field_words<F: Radix2Field, const N: usize>(_ words: [u32; N]) -> [F; N] {
    let mut output = [zero<F>(); N]
    let mut index: usize = 0
    while index < N {
        output[index] = natural<F>(words[index])
        index = index + 1
    }
    output
}

fn air_radix_range<F: Radix2Field, const L: usize>(
    _ witness: RadixRangeWitness<L>,
) -> AirRadixRange<F, L> {
    let empty = AirRadixLimbRange {
        bits: [zero<F>(); 13],
        nonzero_prefix: [zero<F>(); 13],
    }
    let mut limbs = [empty; L]
    let mut index: usize = 0
    while index < L {
        limbs[index] = AirRadixLimbRange {
            bits: field_words<F, 13>(witness.limbs[index].bits),
            nonzero_prefix: field_words<F, 13>(witness.limbs[index].nonzero_prefix),
        }
        index = index + 1
    }
    AirRadixRange { limbs: limbs, nonzero: boolean<F>(witness.nonzero) }
}

fn air_ranged_digits<F: Radix2Field, const L: usize>(
    _ digits: [u32; L],
) -> AirRangedDigits<F, L> {
    AirRangedDigits {
        digits: field_words<F, L>(digits),
        range: air_radix_range<F, L>(derive_radix_range_witness(digits)),
    }
}

fn air_ranged_fixed<F: Radix2Field, const L: usize>(
    _ value: Fixed<L>,
) -> AirRangedFixed<F, L> {
    AirRangedFixed {
        negative: boolean<F>(value.negative),
        magnitude: air_ranged_digits<F, L>(value.limbs),
    }
}

fn air_bounded_u18<F: Radix2Field>(
    _ witness: BoundedU18Witness,
) -> AirBoundedU18<F> {
    AirBoundedU18 {
        bits: field_words<F, 18>(witness.bits),
        slack_bits: field_words<F, 18>(witness.slack_bits),
    }
}

fn air_carry_range<F: Radix2Field, const L: usize>(
    _ witness: FixedProductCarryRangeWitness<L>,
) -> AirProductCarryRange<F, L> {
    let empty = AirBoundedU18 {
        bits: [zero<F>(); 18],
        slack_bits: [zero<F>(); 18],
    }
    let mut low = [empty; L]
    let mut high = [empty; L]
    let mut index: usize = 0
    while index < L {
        low[index] = air_bounded_u18<F>(witness.low[index])
        high[index] = air_bounded_u18<F>(witness.high[index])
        index = index + 1
    }
    AirProductCarryRange { low: low, high: high }
}

fn air_product<F: Radix2Field, const L: usize>(
    _ witness: FixedProductWitness<L>,
) -> AirProduct<F, L> {
    AirProduct {
        valid: boolean<F>(witness.valid),
        low: air_ranged_digits<F, L>(witness.low_digits),
        low_carries: field_words<F, L>(witness.low_carries),
        high: air_ranged_digits<F, L>(witness.high_digits),
        high_carries: field_words<F, L>(witness.high_carries),
        round_up: boolean<F>(witness.round_up),
        round_carries: field_words<F, L>(witness.round_carries),
        round_overflow: boolean<F>(witness.round_overflow),
        output: air_ranged_fixed<F, L>(witness.output),
        carry_range: air_carry_range<F, L>(
            derive_fixed_product_carry_range_witness(witness),
        ),
    }
}

fn air_linear<F: Radix2Field, const L: usize>(
    _ witness: FixedLinearWitness<L>,
) -> AirLinear<F, L> {
    AirLinear {
        valid: boolean<F>(witness.valid),
        same_sign: boolean<F>(witness.same_sign),
        select_right: boolean<F>(witness.select_right),
        output_nonzero: boolean<F>(witness.output_nonzero),
        sum: air_ranged_digits<F, L>(witness.sum_digits),
        sum_carries: field_words<F, L>(witness.sum_carries),
        left_difference: air_ranged_digits<F, L>(witness.left_difference_digits),
        left_borrows: field_words<F, L>(witness.left_borrows),
        right_difference: air_ranged_digits<F, L>(witness.right_difference_digits),
        right_borrows: field_words<F, L>(witness.right_borrows),
        output: air_ranged_fixed<F, L>(witness.output),
    }
}

fn air_complex<F: Radix2Field, const L: usize>(
    _ value: ComplexFixed<L>,
) -> AirComplex<F, L> {
    AirComplex {
        real: air_ranged_fixed<F, L>(value.real),
        imaginary: air_ranged_fixed<F, L>(value.imaginary),
    }
}

pub fn transition_air_from_witness<F: Radix2Field, const L: usize>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> AirMandelbrotTransition<F, L> {
    AirMandelbrotTransition {
        valid: boolean<F>(witness.valid),
        point: air_complex<F, L>(point),
        current: air_complex<F, L>(current),
        next: air_complex<F, L>(next),
        xx: air_product<F, L>(witness.xx),
        yy: air_product<F, L>(witness.yy),
        xy: air_product<F, L>(witness.xy),
        real_difference: air_linear<F, L>(witness.real_difference),
        next_real: air_linear<F, L>(witness.next_real),
        double_xy: air_linear<F, L>(witness.double_xy),
        next_imaginary: air_linear<F, L>(witness.next_imaginary),
    }
}

struct ConstraintFold<F: Radix2Field> {
    challenge: F,
    power: F,
    value: F,
    constraints: u32,
}
impl<F: Radix2Field> core::marker::Copy for ConstraintFold<F> {}

impl<F: Radix2Field> ConstraintFold<F> {
    fn new(_ challenge: F) -> Self {
        Self {
            challenge: challenge,
            power: one<F>(),
            value: zero<F>(),
            constraints: 0,
        }
    }

    fn absorb(mut self, _ residual: F) -> Self {
        self.value = add(self.value, mul(self.power, residual))
        self.power = mul(self.power, self.challenge)
        self.constraints = self.constraints + 1
        self
    }
}

fn bit_residual<F: Radix2Field>(_ value: F) -> F {
    mul(value, sub(value, one<F>()))
}

fn absorb_sparse_radix_row<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    match task {
        SparseTransitionTask::RadixBit(_node, _limb, bit) => {
            fold = fold.absorb(bit_residual(row.value))
            fold = fold.absorb(bit_residual(row.state_after))
            fold = fold.absorb(sub(
                row.state_after,
                sub(
                    add(row.state_before, row.value),
                    mul(row.state_before, row.value),
                ),
            ))
            fold.absorb(sub(
                row.accumulator_after,
                add(
                    row.accumulator_before,
                    mul(row.value, natural<F>(1 << bit)),
                ),
            ))
        }
        SparseTransitionTask::RadixLimb(_node, _limb) => {
            fold = fold.absorb(sub(row.value, row.accumulator_before))
            fold = fold.absorb(row.accumulator_after)
            fold.absorb(sub(row.state_after, row.state_before))
        }
        SparseTransitionTask::RadixFinish(node) => {
            fold = fold.absorb(bit_residual(row.value))
            fold = fold.absorb(sub(row.value, row.state_before))
            fold = fold.absorb(row.accumulator_before)
            fold = fold.absorb(row.accumulator_after)
            fold = fold.absorb(row.state_after)
            if range_node_is_signed(node) {
                fold = fold.absorb(bit_residual(row.auxiliary))
                fold.absorb(mul(row.auxiliary, sub(one<F>(), row.value)))
            } else {
                fold.absorb(row.auxiliary)
            }
        }
        _ => fold.absorb(one<F>()),
    }
}

/// Local constraints for one radix task. Row adjacency is deliberately a
/// separate relation so scalar and parallel interpreters can choose their own
/// scan implementation without changing row semantics.
pub fn evaluate_sparse_radix_row<F: Radix2Field>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_radix_row(
        ConstraintFold<F>::new(challenge),
        task,
        row,
    )
    FixedAirConstraintEvaluation {
        valid: match task {
            SparseTransitionTask::RadixBit(_, _, _) => true,
            SparseTransitionTask::RadixLimb(_, _) => true,
            SparseTransitionTask::RadixFinish(_) => true,
            _ => false,
        },
        constraints: fold.constraints,
        folded: fold.value,
    }
}

/// The initial row and every adjacent pair use the same two accumulator
/// columns. The first row links to the all-zero virtual predecessor.
pub fn sparse_radix_initial_residuals<F: Radix2Field>(
    _ row: SparseTaskRow<F>,
) -> (F, F) {
    (row.accumulator_before, row.state_before)
}

pub fn sparse_radix_link_residuals<F: Radix2Field>(
    _ current: SparseTaskRow<F>,
    _ next: SparseTaskRow<F>,
) -> (F, F) {
    (
        sub(next.accumulator_before, current.accumulator_after),
        sub(next.state_before, current.state_after),
    )
}

fn absorb_sparse_carry_row<F: Radix2Field, const L: usize>(
    _ fold: own ConstraintFold<F>,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    match task {
        SparseTransitionTask::CarryBit(_node, _coefficient, _slack, bit) => {
            fold = fold.absorb(bit_residual(row.value))
            fold = fold.absorb(sub(
                row.accumulator_after,
                add(
                    row.accumulator_before,
                    mul(row.value, natural<F>(1 << bit)),
                ),
            ))
            fold.absorb(sub(row.state_after, row.state_before))
        }
        SparseTransitionTask::CarryFinish(_node, _coefficient) => {
            fold = fold.absorb(sub(row.value, row.state_before))
            fold = fold.absorb(sub(
                add(row.state_before, row.accumulator_before),
                natural<F>(product_carry_bound<L>()),
            ))
            fold = fold.absorb(row.auxiliary)
            fold = fold.absorb(row.accumulator_after)
            fold.absorb(row.state_after)
        }
        _ => fold.absorb(one<F>()),
    }
}

pub fn evaluate_sparse_carry_row<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_carry_row<F, L>(
        ConstraintFold<F>::new(challenge),
        task,
        row,
    )
    FixedAirConstraintEvaluation {
        valid: match task {
            SparseTransitionTask::CarryBit(_, _, _, _) => true,
            SparseTransitionTask::CarryFinish(_, _) => true,
            _ => false,
        },
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn sparse_carry_initial_residuals<F: Radix2Field>(
    _ row: SparseTaskRow<F>,
) -> (F, F) {
    (row.accumulator_before, row.state_before)
}

/// Link carry rows while handling the one intentional scan handoff. The first
/// slack bit resets the active reconstruction and retains the completed carry
/// reconstruction in the state accumulator.
pub fn sparse_carry_link_residuals<F: Radix2Field>(
    _ current_task: SparseTransitionTask,
    _ current: SparseTaskRow<F>,
    _ next_task: SparseTransitionTask,
    _ next: SparseTaskRow<F>,
) -> (F, F) {
    match next_task {
        SparseTransitionTask::CarryBit(_node, _coefficient, true, 0) => (
            next.accumulator_before,
            sub(next.state_before, current.accumulator_after),
        ),
        _ => (
            sub(next.accumulator_before, current.accumulator_after),
            sub(next.state_before, current.state_after),
        ),
    }
}

fn absorb_sparse_product_row<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    match task {
        SparseTransitionTask::ProductTerm(_node, _coefficient, _term) => {
            fold = fold.absorb(sub(
                row.accumulator_after,
                add(
                    row.accumulator_before,
                    mul(row.value, row.auxiliary),
                ),
            ))
            fold.absorb(sub(row.state_after, row.state_before))
        }
        SparseTransitionTask::ProductCoefficient(_node, _coefficient) => {
            fold = fold.absorb(sub(
                sub(
                    add(row.accumulator_before, row.state_before),
                    row.value,
                ),
                mul(natural<F>(8192), row.auxiliary),
            ))
            fold = fold.absorb(row.accumulator_after)
            fold.absorb(sub(row.state_after, row.auxiliary))
        }
        _ => fold.absorb(one<F>()),
    }
}

pub fn evaluate_sparse_product_row<F: Radix2Field>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_product_row(
        ConstraintFold<F>::new(challenge),
        task,
        row,
    )
    FixedAirConstraintEvaluation {
        valid: match task {
            SparseTransitionTask::ProductTerm(_, _, _) => true,
            SparseTransitionTask::ProductCoefficient(_, _) => true,
            _ => false,
        },
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn sparse_product_initial_residuals<F: Radix2Field>(
    _ row: SparseTaskRow<F>,
) -> (F, F) {
    (row.accumulator_before, row.state_before)
}

pub fn sparse_product_link_residuals<F: Radix2Field>(
    _ current: SparseTaskRow<F>,
    _ next: SparseTaskRow<F>,
) -> (F, F) {
    (
        sub(next.accumulator_before, current.accumulator_after),
        sub(next.state_before, current.state_after),
    )
}

pub fn sparse_product_terminal_residuals<F: Radix2Field>(
    _ row: SparseTaskRow<F>,
) -> (F, F) {
    (row.accumulator_after, row.state_after)
}

fn product_node_rank(_ node: ProductNode) -> u32 {
    match node {
        ProductNode::Xx => 0,
        ProductNode::Yy => 1,
        ProductNode::Xy => 2,
        ProductNode::Invalid => 99,
    }
}

fn product_copy_range_rank(_ node: RangeNode) -> u32 {
    match node {
        RangeNode::CurrentReal => 0,
        RangeNode::CurrentImaginary => 1,
        RangeNode::ProductLow(product) => 2 + 2 * product_node_rank(product),
        RangeNode::ProductHigh(product) => 3 + 2 * product_node_rank(product),
        _ => 99,
    }
}

fn product_copy_key<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ address: SparseCopyAddress,
) -> F {
    let limbs: u32 = L.downcast_truncate()
    let rank = match address {
        SparseCopyAddress::RangeDigit(node, limb) => {
            product_copy_range_rank(node) * limbs + limb
        }
        SparseCopyAddress::ProductCarry(product, coefficient) => {
            8 * limbs + product_node_rank(product) * limbs * 2 + coefficient
        }
        _ => return zero<F>(),
    }
    let mut key = one<F>()
    let mut exponent: u32 = 0
    while exponent < rank + 1 {
        key = mul(key, challenge)
        exponent = exponent + 1
    }
    key
}

fn product_input_range(_ product: ProductNode, _ left: bool) -> RangeNode {
    match product {
        ProductNode::Xx => RangeNode::CurrentReal,
        ProductNode::Yy => RangeNode::CurrentImaginary,
        ProductNode::Xy => {
            if left { RangeNode::CurrentReal } else { RangeNode::CurrentImaginary }
        }
        ProductNode::Invalid => RangeNode::Invalid,
    }
}

fn product_digit_range<const L: usize>(
    _ product: ProductNode,
    _ coefficient: u32,
) -> (RangeNode, u32) {
    let limbs: u32 = L.downcast_truncate()
    if coefficient < limbs {
        (RangeNode::ProductLow(product), coefficient)
    } else {
        (RangeNode::ProductHigh(product), coefficient - limbs)
    }
}

/// Producer side of the convolution copy bus. Multiplicities are derived from
/// the nominal product DAG: each coordinate digit is read by one square twice
/// and the mixed product once; each normalized digit is read once; each carry
/// is read as an output and, except for the last carry, as the next input.
pub fn sparse_product_copy_source<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::RadixLimb(node, limb) => {
            let limbs: u32 = L.downcast_truncate()
            let multiplicity = match node {
                RangeNode::CurrentReal => 3 * limbs,
                RangeNode::CurrentImaginary => 3 * limbs,
                RangeNode::ProductLow(_) => 1,
                RangeNode::ProductHigh(_) => 1,
                _ => 0,
            }
            mul(
                mul(
                    product_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeDigit(node, limb),
                    ),
                    row.value,
                ),
                natural<F>(multiplicity),
            )
        }
        SparseTransitionTask::CarryFinish(product, coefficient) => {
            let limbs: u32 = L.downcast_truncate()
            let multiplicity = if coefficient + 1 < limbs + limbs { 2 } else { 1 }
            mul(
                mul(
                    product_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::ProductCarry(product, coefficient),
                    ),
                    row.value,
                ),
                natural<F>(multiplicity),
            )
        }
        _ => zero<F>(),
    }
}

pub fn sparse_product_copy_consumer<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::ProductTerm(product, coefficient, term) => {
            let left_index = convolution_left_index<L>(coefficient, term)
            let right_index = convolution_right_index<L>(coefficient, term)
            add(
                mul(
                    product_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeDigit(
                            product_input_range(product, true),
                            left_index,
                        ),
                    ),
                    row.value,
                ),
                mul(
                    product_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeDigit(
                            product_input_range(product, false),
                            right_index,
                        ),
                    ),
                    row.auxiliary,
                ),
            )
        }
        SparseTransitionTask::ProductCoefficient(product, coefficient) => {
            let digit = product_digit_range<L>(product, coefficient)
            let mut contribution = mul(
                product_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeDigit(digit.0, digit.1),
                ),
                row.value,
            )
            contribution = add(
                contribution,
                mul(
                    product_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::ProductCarry(product, coefficient),
                    ),
                    row.auxiliary,
                ),
            )
            if coefficient > 0 {
                contribution = add(
                    contribution,
                    mul(
                        product_copy_key<F, L>(
                            challenge,
                            SparseCopyAddress::ProductCarry(product, coefficient - 1),
                        ),
                        row.state_before,
                    ),
                )
            }
            contribution
        }
        _ => zero<F>(),
    }
}

fn absorb_sparse_round_row<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    match task {
        SparseTransitionTask::ProductRound(_node, _output_index) => {
            fold = fold.absorb(bit_residual(row.accumulator_after))
            fold = fold.absorb(sub(
                sub(
                    add(row.value, row.accumulator_before),
                    row.auxiliary,
                ),
                mul(natural<F>(8192), row.accumulator_after),
            ))
            fold.absorb(sub(row.state_after, row.state_before))
        }
        SparseTransitionTask::ProductFinish(_node) => {
            fold = fold.absorb(bit_residual(row.value))
            fold = fold.absorb(bit_residual(row.auxiliary))
            fold = fold.absorb(bit_residual(row.accumulator_before))
            fold = fold.absorb(bit_residual(row.accumulator_after))
            fold = fold.absorb(bit_residual(row.state_before))
            fold = fold.absorb(bit_residual(row.state_after))
            let sign_xor = sub(
                add(row.accumulator_after, row.state_after),
                mul(
                    natural<F>(2),
                    mul(row.accumulator_after, row.state_after),
                ),
            )
            fold.absorb(sub(row.value, mul(sign_xor, row.auxiliary)))
        }
        _ => fold.absorb(one<F>()),
    }
}

pub fn evaluate_sparse_round_row<F: Radix2Field>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_round_row(
        ConstraintFold<F>::new(challenge),
        task,
        row,
    )
    FixedAirConstraintEvaluation {
        valid: match task {
            SparseTransitionTask::ProductRound(_, _) => true,
            SparseTransitionTask::ProductFinish(_) => true,
            _ => false,
        },
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn sparse_round_initial_residual<F: Radix2Field>(
    _ row: SparseTaskRow<F>,
) -> F {
    sub(row.accumulator_before, row.state_before)
}

pub fn sparse_round_link_residuals<F: Radix2Field>(
    _ current: SparseTaskRow<F>,
    _ next: SparseTaskRow<F>,
) -> (F, F) {
    (
        sub(next.accumulator_before, current.accumulator_after),
        sub(next.state_before, current.state_after),
    )
}

fn round_copy_range_rank(_ node: RangeNode) -> u32 {
    match node {
        RangeNode::CurrentReal => 0,
        RangeNode::CurrentImaginary => 1,
        RangeNode::ProductLow(product) => 2 + 3 * product_node_rank(product),
        RangeNode::ProductHigh(product) => 3 + 3 * product_node_rank(product),
        RangeNode::ProductOutput(product) => 4 + 3 * product_node_rank(product),
        _ => 99,
    }
}

fn round_copy_key<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ address: SparseCopyAddress,
) -> F {
    let limbs: u32 = L.downcast_truncate()
    let ranges: u32 = 11
    let digit_addresses = ranges * limbs
    let bit_addresses = ranges * limbs * 13
    let rank = match address {
        SparseCopyAddress::RangeDigit(node, limb) => {
            round_copy_range_rank(node) * limbs + limb
        }
        SparseCopyAddress::RangeBit(node, limb, bit) => {
            digit_addresses
                + round_copy_range_rank(node) * limbs * 13
                + limb * 13
                + bit
        }
        SparseCopyAddress::RangeSign(node) => {
            digit_addresses + bit_addresses + round_copy_range_rank(node)
        }
        SparseCopyAddress::RangeNonzero(node) => {
            digit_addresses + bit_addresses + ranges + round_copy_range_rank(node)
        }
        _ => return zero<F>(),
    }
    let mut key = one<F>()
    let mut exponent: u32 = 0
    while exponent < rank + 1 {
        key = mul(key, challenge)
        exponent = exponent + 1
    }
    key
}

fn round_retained_range<const L: usize>(
    _ product: ProductNode,
    _ output_index: u32,
) -> (RangeNode, u32) {
    let limbs: u32 = L.downcast_truncate()
    if output_index == 0 {
        (RangeNode::ProductLow(product), limbs - 1)
    } else {
        (RangeNode::ProductHigh(product), output_index - 1)
    }
}

/// Source side of the rounding copy bus. Only the retained window, output
/// digits, one guard bit, and sign/nonzero values participate, so every
/// multiplicity follows directly from the nominal task variants.
pub fn sparse_round_copy_source<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::RadixBit(
            RangeNode::ProductLow(product),
            limb,
            bit,
        ) => {
            let limbs: u32 = L.downcast_truncate()
            if limb == limbs - 2 && bit == 12 {
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeBit(
                            RangeNode::ProductLow(product),
                            limb,
                            bit,
                        ),
                    ),
                    row.value,
                )
            } else {
                zero<F>()
            }
        }
        SparseTransitionTask::RadixLimb(node, limb) => {
            let limbs: u32 = L.downcast_truncate()
            let used = match node {
                RangeNode::ProductLow(_) => limb + 1 == limbs,
                RangeNode::ProductHigh(_) => limb + 1 < limbs,
                RangeNode::ProductOutput(_) => true,
                _ => false,
            }
            if used {
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeDigit(node, limb),
                    ),
                    row.value,
                )
            } else {
                zero<F>()
            }
        }
        SparseTransitionTask::RadixFinish(node) => {
            let sign_multiplicity = match node {
                RangeNode::CurrentReal => 3,
                RangeNode::CurrentImaginary => 3,
                RangeNode::ProductOutput(_) => 1,
                _ => 0,
            }
            let mut contribution = mul(
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeSign(node),
                    ),
                    row.auxiliary,
                ),
                natural<F>(sign_multiplicity),
            )
            if range_node_is_product_output(node) {
                contribution = add(
                    contribution,
                    mul(
                        round_copy_key<F, L>(
                            challenge,
                            SparseCopyAddress::RangeNonzero(node),
                        ),
                        row.value,
                    ),
                )
            }
            contribution
        }
        _ => zero<F>(),
    }
}

pub fn sparse_round_copy_consumer<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::ProductRound(product, output_index) => {
            let retained = round_retained_range<L>(product, output_index)
            add(
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeDigit(retained.0, retained.1),
                    ),
                    row.value,
                ),
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeDigit(
                            RangeNode::ProductOutput(product),
                            output_index,
                        ),
                    ),
                    row.auxiliary,
                ),
            )
        }
        SparseTransitionTask::ProductFinish(product) => {
            let left = product_input_range(product, true)
            let right = product_input_range(product, false)
            let output = RangeNode::ProductOutput(product)
            let limbs: u32 = L.downcast_truncate()
            let mut contribution = mul(
                round_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeBit(
                        RangeNode::ProductLow(product),
                        limbs - 2,
                        12,
                    ),
                ),
                row.state_before,
            )
            contribution = add(
                contribution,
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeSign(output),
                    ),
                    row.value,
                ),
            )
            contribution = add(
                contribution,
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeNonzero(output),
                    ),
                    row.auxiliary,
                ),
            )
            contribution = add(
                contribution,
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeSign(left),
                    ),
                    row.accumulator_after,
                ),
            )
            add(
                contribution,
                mul(
                    round_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::RangeSign(right),
                    ),
                    row.state_after,
                ),
            )
        }
        _ => zero<F>(),
    }
}

fn absorb_sparse_linear_row<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    match task {
        SparseTransitionTask::LinearLimb(_node, role, _limb) => {
            match role {
                LinearLimbRole::Sum => {
                    fold = fold.absorb(bit_residual(row.accumulator_after))
                    fold = fold.absorb(sub(
                        sub(
                            add(
                                add(row.value, row.auxiliary),
                                row.accumulator_before,
                            ),
                            row.state_before,
                        ),
                        mul(natural<F>(8192), row.accumulator_after),
                    ))
                    fold.absorb(row.state_after)
                }
                LinearLimbRole::LeftDifference => {
                    fold = fold.absorb(bit_residual(row.accumulator_after))
                    fold = fold.absorb(sub(
                        sub(
                            add(
                                row.value,
                                mul(natural<F>(8192), row.accumulator_after),
                            ),
                            row.auxiliary,
                        ),
                        add(row.accumulator_before, row.state_before),
                    ))
                    fold.absorb(row.state_after)
                }
                LinearLimbRole::RightDifference => {
                    fold = fold.absorb(bit_residual(row.accumulator_after))
                    fold = fold.absorb(sub(
                        sub(
                            add(
                                row.auxiliary,
                                mul(natural<F>(8192), row.accumulator_after),
                            ),
                            row.value,
                        ),
                        add(row.accumulator_before, row.state_before),
                    ))
                    fold.absorb(row.state_after)
                }
                LinearLimbRole::Select => {
                    fold = fold.absorb(bit_residual(row.state_before))
                    fold = fold.absorb(bit_residual(row.state_after))
                    let difference = add(
                        mul(sub(one<F>(), row.state_after), row.auxiliary),
                        mul(row.state_after, row.accumulator_before),
                    )
                    let selected = add(
                        mul(row.state_before, row.value),
                        mul(sub(one<F>(), row.state_before), difference),
                    )
                    fold.absorb(sub(row.accumulator_after, selected))
                }
                LinearLimbRole::Invalid => fold.absorb(one<F>()),
            }
        }
        SparseTransitionTask::LinearFinish(node) => {
            fold = fold.absorb(bit_residual(row.value))
            fold = fold.absorb(bit_residual(row.auxiliary))
            fold = fold.absorb(bit_residual(row.accumulator_before))
            fold = fold.absorb(bit_residual(row.accumulator_after))
            fold = fold.absorb(bit_residual(row.state_before))
            fold = fold.absorb(bit_residual(row.state_after))
            let subtract = boolean<F>(linear_subtracts_right(node))
            let effective_right = sub(
                add(row.auxiliary, subtract),
                mul(natural<F>(2), mul(row.auxiliary, subtract)),
            )
            let different = sub(
                add(row.value, effective_right),
                mul(natural<F>(2), mul(row.value, effective_right)),
            )
            let same = sub(one<F>(), different)
            let select = row.accumulator_before
            fold = fold.absorb(add(
                mul(sub(one<F>(), select), row.accumulator_before),
                mul(select, row.accumulator_after),
            ))
            let selected_difference_sign = add(
                mul(sub(one<F>(), select), row.value),
                mul(select, effective_right),
            )
            let selected_sign = add(
                mul(same, row.value),
                mul(sub(one<F>(), same), selected_difference_sign),
            )
            fold.absorb(sub(
                row.state_after,
                mul(selected_sign, row.state_before),
            ))
        }
        _ => fold.absorb(one<F>()),
    }
}

pub fn evaluate_sparse_linear_row<F: Radix2Field>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_linear_row(
        ConstraintFold<F>::new(challenge),
        task,
        row,
    )
    FixedAirConstraintEvaluation {
        valid: match task {
            SparseTransitionTask::LinearLimb(_, _, _) => true,
            SparseTransitionTask::LinearFinish(_) => true,
            _ => false,
        },
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn sparse_linear_initial_residual<F: Radix2Field>(
    _ row: SparseTaskRow<F>,
) -> F {
    row.accumulator_before
}

pub fn sparse_linear_link_residual<F: Radix2Field>(
    _ current: SparseTaskRow<F>,
    _ next: SparseTaskRow<F>,
) -> F {
    sub(next.accumulator_before, current.accumulator_after)
}

fn linear_node_rank(_ node: LinearNode) -> u32 {
    match node {
        LinearNode::RealDifference => 0,
        LinearNode::NextReal => 1,
        LinearNode::DoubleXy => 2,
        LinearNode::NextImaginary => 3,
        LinearNode::Invalid => 99,
    }
}

fn range_node_rank(_ node: RangeNode) -> u32 {
    match node {
        RangeNode::PointReal => 0,
        RangeNode::PointImaginary => 1,
        RangeNode::CurrentReal => 2,
        RangeNode::CurrentImaginary => 3,
        RangeNode::NextReal => 4,
        RangeNode::NextImaginary => 5,
        RangeNode::ProductLow(product) => 6 + 3 * product_node_rank(product),
        RangeNode::ProductHigh(product) => 7 + 3 * product_node_rank(product),
        RangeNode::ProductOutput(product) => 8 + 3 * product_node_rank(product),
        RangeNode::LinearSum(linear) => 15 + 4 * linear_node_rank(linear),
        RangeNode::LinearLeftDifference(linear) => 16 + 4 * linear_node_rank(linear),
        RangeNode::LinearRightDifference(linear) => 17 + 4 * linear_node_rank(linear),
        RangeNode::LinearOutput(linear) => 18 + 4 * linear_node_rank(linear),
        RangeNode::Invalid => 99,
    }
}

fn coordinate_node_rank(_ node: CoordinateNode) -> u32 {
    match node {
        CoordinateNode::Real => 0,
        CoordinateNode::Imaginary => 1,
        CoordinateNode::Invalid => 99,
    }
}

fn linear_limb_role_rank(_ role: LinearLimbRole) -> u32 {
    match role {
        LinearLimbRole::Sum => 0,
        LinearLimbRole::LeftDifference => 1,
        LinearLimbRole::RightDifference => 2,
        LinearLimbRole::Select => 3,
        LinearLimbRole::Invalid => 99,
    }
}

fn empty_sparse_control_selectors<F: Radix2Field>() -> SparseControlSelectors<F> {
    SparseControlSelectors {
        radix_bit: zero<F>(),
        radix_limb: zero<F>(),
        radix_finish: zero<F>(),
        carry_bit: zero<F>(),
        carry_finish: zero<F>(),
        product_term: zero<F>(),
        product_coefficient: zero<F>(),
        product_round: zero<F>(),
        product_finish: zero<F>(),
        linear_limb: zero<F>(),
        linear_finish: zero<F>(),
        boundary_sign: zero<F>(),
        boundary_limb: zero<F>(),
        transition_finish: zero<F>(),
        padding: zero<F>(),
    }
}

fn empty_sparse_linear_role_selectors<F: Radix2Field>(
) -> SparseLinearRoleSelectors<F> {
    SparseLinearRoleSelectors {
        sum: zero<F>(),
        left_difference: zero<F>(),
        right_difference: zero<F>(),
        select: zero<F>(),
    }
}

fn empty_sparse_range_role_selectors<F: Radix2Field>(
) -> SparseRangeRoleSelectors<F> {
    SparseRangeRoleSelectors {
        coordinate: zero<F>(),
        product_low: zero<F>(),
        product_high: zero<F>(),
        product_output: zero<F>(),
        linear_sum: zero<F>(),
        linear_left_difference: zero<F>(),
        linear_right_difference: zero<F>(),
        linear_output: zero<F>(),
    }
}

fn empty_sparse_limb_position_selectors<F: Radix2Field>(
) -> SparseLimbPositionSelectors<F> {
    SparseLimbPositionSelectors {
        penultimate: zero<F>(),
        last: zero<F>(),
    }
}

fn sparse_range_roles_from_node<F: Radix2Field>(
    _ node: RangeNode,
) -> SparseRangeRoleSelectors<F> {
    let mut roles = empty_sparse_range_role_selectors<F>()
    match node {
        RangeNode::PointReal => roles.coordinate = one<F>(),
        RangeNode::PointImaginary => roles.coordinate = one<F>(),
        RangeNode::CurrentReal => roles.coordinate = one<F>(),
        RangeNode::CurrentImaginary => roles.coordinate = one<F>(),
        RangeNode::NextReal => roles.coordinate = one<F>(),
        RangeNode::NextImaginary => roles.coordinate = one<F>(),
        RangeNode::ProductLow(_) => roles.product_low = one<F>(),
        RangeNode::ProductHigh(_) => roles.product_high = one<F>(),
        RangeNode::ProductOutput(_) => roles.product_output = one<F>(),
        RangeNode::LinearSum(_) => roles.linear_sum = one<F>(),
        RangeNode::LinearLeftDifference(_) => {
            roles.linear_left_difference = one<F>()
        }
        RangeNode::LinearRightDifference(_) => {
            roles.linear_right_difference = one<F>()
        }
        RangeNode::LinearOutput(_) => roles.linear_output = one<F>(),
        RangeNode::Invalid => {}
    }
    roles
}

/// Interpret one generated base task as field-valued control columns. Enum
/// dispatch occurs only while constructing the base trace. AIR evaluation uses
/// `SparseControlRow` directly, including at off-domain LDE points.
pub fn sparse_control_row_from_task<F: Radix2Field, const L: usize>(
    _ task: SparseTransitionTask,
) -> SparseControlRow<F> {
    let mut selectors = empty_sparse_control_selectors<F>()
    let mut linear_roles = empty_sparse_linear_role_selectors<F>()
    let mut range_roles = empty_sparse_range_role_selectors<F>()
    let mut limb_positions = empty_sparse_limb_position_selectors<F>()
    let mut major = zero<F>()
    let mut minor = zero<F>()
    let mut step = zero<F>()
    let mut flag = zero<F>()
    let mut width = zero<F>()
    let mut weight = zero<F>()
    let limbs: u32 = L.downcast_truncate()
    match task {
        SparseTransitionTask::RadixBit(node, limb, bit) => {
            selectors.radix_bit = one<F>()
            range_roles = sparse_range_roles_from_node<F>(node)
            major = natural<F>(range_node_rank(node))
            minor = natural<F>(limb)
            step = natural<F>(bit)
            flag = boolean<F>(range_node_is_signed(node))
            weight = natural<F>(1 << bit)
            limb_positions.penultimate = boolean<F>(limb + 2 == limbs)
            limb_positions.last = boolean<F>(limb + 1 == limbs)
        }
        SparseTransitionTask::RadixLimb(node, limb) => {
            selectors.radix_limb = one<F>()
            range_roles = sparse_range_roles_from_node<F>(node)
            major = natural<F>(range_node_rank(node))
            minor = natural<F>(limb)
            flag = boolean<F>(range_node_is_signed(node))
            limb_positions.penultimate = boolean<F>(limb + 2 == limbs)
            limb_positions.last = boolean<F>(limb + 1 == limbs)
        }
        SparseTransitionTask::RadixFinish(node) => {
            selectors.radix_finish = one<F>()
            range_roles = sparse_range_roles_from_node<F>(node)
            major = natural<F>(range_node_rank(node))
            flag = boolean<F>(range_node_is_signed(node))
        }
        SparseTransitionTask::CarryBit(node, coefficient, slack, bit) => {
            selectors.carry_bit = one<F>()
            major = natural<F>(product_node_rank(node))
            minor = natural<F>(coefficient)
            step = natural<F>(bit)
            flag = boolean<F>(slack)
            weight = natural<F>(1 << bit)
        }
        SparseTransitionTask::CarryFinish(node, coefficient) => {
            selectors.carry_finish = one<F>()
            major = natural<F>(product_node_rank(node))
            minor = natural<F>(coefficient)
        }
        SparseTransitionTask::ProductTerm(node, coefficient, term) => {
            selectors.product_term = one<F>()
            major = natural<F>(product_node_rank(node))
            minor = natural<F>(coefficient)
            step = natural<F>(term)
            flag = boolean<F>(coefficient >= limbs)
            width = natural<F>(convolution_term_count<L>(coefficient))
        }
        SparseTransitionTask::ProductCoefficient(node, coefficient) => {
            selectors.product_coefficient = one<F>()
            major = natural<F>(product_node_rank(node))
            minor = natural<F>(coefficient)
            flag = boolean<F>(coefficient >= limbs)
            width = natural<F>(convolution_term_count<L>(coefficient))
        }
        SparseTransitionTask::ProductRound(node, output_index) => {
            selectors.product_round = one<F>()
            major = natural<F>(product_node_rank(node))
            minor = natural<F>(output_index)
        }
        SparseTransitionTask::ProductFinish(node) => {
            selectors.product_finish = one<F>()
            major = natural<F>(product_node_rank(node))
        }
        SparseTransitionTask::LinearLimb(node, role, limb) => {
            selectors.linear_limb = one<F>()
            major = natural<F>(linear_node_rank(node))
            minor = natural<F>(linear_limb_role_rank(role))
            step = natural<F>(limb)
            flag = boolean<F>(linear_subtracts_right(node))
            match role {
                LinearLimbRole::Sum => linear_roles.sum = one<F>(),
                LinearLimbRole::LeftDifference => {
                    linear_roles.left_difference = one<F>()
                }
                LinearLimbRole::RightDifference => {
                    linear_roles.right_difference = one<F>()
                }
                LinearLimbRole::Select => linear_roles.select = one<F>(),
                LinearLimbRole::Invalid => {}
            }
        }
        SparseTransitionTask::LinearFinish(node) => {
            selectors.linear_finish = one<F>()
            major = natural<F>(linear_node_rank(node))
            flag = boolean<F>(linear_subtracts_right(node))
        }
        SparseTransitionTask::BoundarySign(coordinate) => {
            selectors.boundary_sign = one<F>()
            major = natural<F>(coordinate_node_rank(coordinate))
        }
        SparseTransitionTask::BoundaryLimb(coordinate, limb) => {
            selectors.boundary_limb = one<F>()
            major = natural<F>(coordinate_node_rank(coordinate))
            minor = natural<F>(limb)
        }
        SparseTransitionTask::TransitionFinish => {
            selectors.transition_finish = one<F>()
        }
        SparseTransitionTask::Invalid => {
            selectors.padding = one<F>()
        }
    }
    SparseControlRow {
        selectors: selectors,
        linear_roles: linear_roles,
        range_roles: range_roles,
        limb_positions: limb_positions,
        major: major,
        minor: minor,
        step: step,
        flag: flag,
        width: width,
        weight: weight,
    }
}

pub fn sparse_control_row_at<F: Radix2Field, const L: usize>(
    _ index: u32,
) -> SparseControlRow<F> {
    sparse_control_row_from_task<F, L>(sparse_transition_task_at<L>(index))
}

fn sparse_selector_sum<F: Radix2Field>(
    _ selectors: SparseControlSelectors<F>,
) -> F {
    let mut total = selectors.radix_bit
    total = add(total, selectors.radix_limb)
    total = add(total, selectors.radix_finish)
    total = add(total, selectors.carry_bit)
    total = add(total, selectors.carry_finish)
    total = add(total, selectors.product_term)
    total = add(total, selectors.product_coefficient)
    total = add(total, selectors.product_round)
    total = add(total, selectors.product_finish)
    total = add(total, selectors.linear_limb)
    total = add(total, selectors.linear_finish)
    total = add(total, selectors.boundary_sign)
    total = add(total, selectors.boundary_limb)
    total = add(total, selectors.transition_finish)
    add(total, selectors.padding)
}

fn absorb_sparse_selector_bits<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ selectors: SparseControlSelectors<F>,
) -> ConstraintFold<F> {
    let mut fold = fold.absorb(bit_residual(selectors.radix_bit))
    fold = fold.absorb(bit_residual(selectors.radix_limb))
    fold = fold.absorb(bit_residual(selectors.radix_finish))
    fold = fold.absorb(bit_residual(selectors.carry_bit))
    fold = fold.absorb(bit_residual(selectors.carry_finish))
    fold = fold.absorb(bit_residual(selectors.product_term))
    fold = fold.absorb(bit_residual(selectors.product_coefficient))
    fold = fold.absorb(bit_residual(selectors.product_round))
    fold = fold.absorb(bit_residual(selectors.product_finish))
    fold = fold.absorb(bit_residual(selectors.linear_limb))
    fold = fold.absorb(bit_residual(selectors.linear_finish))
    fold = fold.absorb(bit_residual(selectors.boundary_sign))
    fold = fold.absorb(bit_residual(selectors.boundary_limb))
    fold = fold.absorb(bit_residual(selectors.transition_finish))
    fold.absorb(bit_residual(selectors.padding))
}

fn absorb_sparse_control_local<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ row: SparseControlRow<F>,
) -> ConstraintFold<F> {
    let selectors = row.selectors
    let mut fold = absorb_sparse_selector_bits(fold, selectors)
    fold = fold.absorb(sub(sparse_selector_sum(selectors), one<F>()))
    let roles = row.linear_roles
    fold = fold.absorb(bit_residual(roles.sum))
    fold = fold.absorb(bit_residual(roles.left_difference))
    fold = fold.absorb(bit_residual(roles.right_difference))
    fold = fold.absorb(bit_residual(roles.select))
    let mut role_sum = roles.sum
    role_sum = add(role_sum, roles.left_difference)
    role_sum = add(role_sum, roles.right_difference)
    role_sum = add(role_sum, roles.select)
    fold = fold.absorb(sub(role_sum, selectors.linear_limb))
    let range_roles = row.range_roles
    fold = fold.absorb(bit_residual(range_roles.coordinate))
    fold = fold.absorb(bit_residual(range_roles.product_low))
    fold = fold.absorb(bit_residual(range_roles.product_high))
    fold = fold.absorb(bit_residual(range_roles.product_output))
    fold = fold.absorb(bit_residual(range_roles.linear_sum))
    fold = fold.absorb(bit_residual(range_roles.linear_left_difference))
    fold = fold.absorb(bit_residual(range_roles.linear_right_difference))
    fold = fold.absorb(bit_residual(range_roles.linear_output))
    let mut range_role_sum = range_roles.coordinate
    range_role_sum = add(range_role_sum, range_roles.product_low)
    range_role_sum = add(range_role_sum, range_roles.product_high)
    range_role_sum = add(range_role_sum, range_roles.product_output)
    range_role_sum = add(range_role_sum, range_roles.linear_sum)
    range_role_sum = add(range_role_sum, range_roles.linear_left_difference)
    range_role_sum = add(range_role_sum, range_roles.linear_right_difference)
    range_role_sum = add(range_role_sum, range_roles.linear_output)
    let radix_used = add(
        selectors.radix_bit,
        add(selectors.radix_limb, selectors.radix_finish),
    )
    fold = fold.absorb(sub(range_role_sum, radix_used))
    let range_signed = add(
        range_roles.coordinate,
        add(range_roles.product_output, range_roles.linear_output),
    )
    fold = fold.absorb(mul(radix_used, sub(row.flag, range_signed)))
    fold = fold.absorb(bit_residual(row.flag))

    let positions = row.limb_positions
    fold = fold.absorb(bit_residual(positions.penultimate))
    fold = fold.absorb(bit_residual(positions.last))
    fold = fold.absorb(mul(positions.penultimate, positions.last))
    let limb_position_used = add(selectors.radix_bit, selectors.radix_limb)
    fold = fold.absorb(mul(
        sub(one<F>(), limb_position_used),
        positions.penultimate,
    ))
    fold = fold.absorb(mul(
        sub(one<F>(), limb_position_used),
        positions.last,
    ))

    let major_unused = add(selectors.transition_finish, selectors.padding)
    fold = fold.absorb(mul(major_unused, row.major))

    let mut minor_used = selectors.radix_bit
    minor_used = add(minor_used, selectors.radix_limb)
    minor_used = add(minor_used, selectors.carry_bit)
    minor_used = add(minor_used, selectors.carry_finish)
    minor_used = add(minor_used, selectors.product_term)
    minor_used = add(minor_used, selectors.product_coefficient)
    minor_used = add(minor_used, selectors.product_round)
    minor_used = add(minor_used, selectors.linear_limb)
    minor_used = add(minor_used, selectors.boundary_limb)
    fold = fold.absorb(mul(sub(one<F>(), minor_used), row.minor))

    let mut step_used = selectors.radix_bit
    step_used = add(step_used, selectors.carry_bit)
    step_used = add(step_used, selectors.product_term)
    step_used = add(step_used, selectors.linear_limb)
    fold = fold.absorb(mul(sub(one<F>(), step_used), row.step))

    let flag_used = add(
        radix_used,
        add(
            selectors.carry_bit,
            add(
                selectors.product_term,
                add(
                    selectors.product_coefficient,
                    add(selectors.linear_limb, selectors.linear_finish),
                ),
            ),
        ),
    )
    fold = fold.absorb(mul(sub(one<F>(), flag_used), row.flag))

    let width_used = add(selectors.product_term, selectors.product_coefficient)
    fold = fold.absorb(mul(sub(one<F>(), width_used), row.width))

    let weight_used = add(selectors.radix_bit, selectors.carry_bit)
    fold.absorb(mul(sub(one<F>(), weight_used), row.weight))
}

/// Polynomial local constraints for a sparse control row. No row index, enum,
/// or host integer enters this evaluator.
pub fn evaluate_sparse_control_row<F: Radix2Field>(
    _ challenge: F,
    _ row: SparseControlRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_control_local(ConstraintFold<F>::new(challenge), row)
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

fn absorb_sparse_control_edge<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ gate: F,
    _ next: SparseControlRow<F>,
    _ major: F,
    _ minor: F,
    _ step: F,
    _ flag: F,
    _ width: F,
    _ weight: F,
) -> ConstraintFold<F> {
    let mut fold = fold.absorb(mul(gate, sub(next.major, major)))
    fold = fold.absorb(mul(gate, sub(next.minor, minor)))
    fold = fold.absorb(mul(gate, sub(next.step, step)))
    fold = fold.absorb(mul(gate, sub(next.flag, flag)))
    fold = fold.absorb(mul(gate, sub(next.width, width)))
    fold.absorb(mul(gate, sub(next.weight, weight)))
}

fn absorb_sparse_control_link<F: Radix2Field, const L: usize>(
    _ fold: own ConstraintFold<F>,
    _ current: SparseControlRow<F>,
    _ next: SparseControlRow<F>,
) -> ConstraintFold<F>
where L > 1,
{
    let current_selectors = current.selectors
    let next_selectors = next.selectors
    let zero = zero<F>()
    let one = one<F>()
    let two = natural<F>(2)
    let limbs = natural<F>(L.downcast_truncate())
    let last_limb = sub(limbs, one)
    let last_coefficient = sub(mul(two, limbs), one)

    let radix_bit_to_bit = mul(
        current_selectors.radix_bit,
        next_selectors.radix_bit,
    )
    let radix_bit_to_limb = mul(
        current_selectors.radix_bit,
        next_selectors.radix_limb,
    )
    let radix_limb_to_bit = mul(
        current_selectors.radix_limb,
        next_selectors.radix_bit,
    )
    let radix_limb_to_finish = mul(
        current_selectors.radix_limb,
        next_selectors.radix_finish,
    )
    let radix_finish_to_bit = mul(
        current_selectors.radix_finish,
        next_selectors.radix_bit,
    )
    let radix_finish_to_carry = mul(
        current_selectors.radix_finish,
        next_selectors.carry_bit,
    )
    let carry_bit_to_bit = mul(
        current_selectors.carry_bit,
        next_selectors.carry_bit,
    )
    let carry_bit_to_finish = mul(
        current_selectors.carry_bit,
        next_selectors.carry_finish,
    )
    let carry_finish_to_bit = mul(
        current_selectors.carry_finish,
        next_selectors.carry_bit,
    )
    let carry_finish_to_product = mul(
        current_selectors.carry_finish,
        next_selectors.product_term,
    )
    let product_term_to_term = mul(
        current_selectors.product_term,
        next_selectors.product_term,
    )
    let product_term_to_coefficient = mul(
        current_selectors.product_term,
        next_selectors.product_coefficient,
    )
    let product_coefficient_to_term = mul(
        current_selectors.product_coefficient,
        next_selectors.product_term,
    )
    let product_coefficient_to_coefficient = mul(
        current_selectors.product_coefficient,
        next_selectors.product_coefficient,
    )
    let product_coefficient_to_round = mul(
        current_selectors.product_coefficient,
        next_selectors.product_round,
    )
    let product_round_to_round = mul(
        current_selectors.product_round,
        next_selectors.product_round,
    )
    let product_round_to_finish = mul(
        current_selectors.product_round,
        next_selectors.product_finish,
    )
    let product_finish_to_round = mul(
        current_selectors.product_finish,
        next_selectors.product_round,
    )
    let product_finish_to_linear = mul(
        current_selectors.product_finish,
        next_selectors.linear_limb,
    )
    let linear_limb_to_limb = mul(
        current_selectors.linear_limb,
        next_selectors.linear_limb,
    )
    let linear_limb_to_finish = mul(
        current_selectors.linear_limb,
        next_selectors.linear_finish,
    )
    let linear_finish_to_limb = mul(
        current_selectors.linear_finish,
        next_selectors.linear_limb,
    )
    let linear_finish_to_boundary = mul(
        current_selectors.linear_finish,
        next_selectors.boundary_sign,
    )
    let boundary_sign_to_limb = mul(
        current_selectors.boundary_sign,
        next_selectors.boundary_limb,
    )
    let boundary_limb_to_limb = mul(
        current_selectors.boundary_limb,
        next_selectors.boundary_limb,
    )
    let boundary_limb_to_sign = mul(
        current_selectors.boundary_limb,
        next_selectors.boundary_sign,
    )
    let boundary_limb_to_finish = mul(
        current_selectors.boundary_limb,
        next_selectors.transition_finish,
    )
    let finish_to_padding = mul(
        current_selectors.transition_finish,
        next_selectors.padding,
    )
    let padding_to_padding = mul(
        current_selectors.padding,
        next_selectors.padding,
    )

    let mut allowed = radix_bit_to_bit
    allowed = add(allowed, radix_bit_to_limb)
    allowed = add(allowed, radix_limb_to_bit)
    allowed = add(allowed, radix_limb_to_finish)
    allowed = add(allowed, radix_finish_to_bit)
    allowed = add(allowed, radix_finish_to_carry)
    allowed = add(allowed, carry_bit_to_bit)
    allowed = add(allowed, carry_bit_to_finish)
    allowed = add(allowed, carry_finish_to_bit)
    allowed = add(allowed, carry_finish_to_product)
    allowed = add(allowed, product_term_to_term)
    allowed = add(allowed, product_term_to_coefficient)
    allowed = add(allowed, product_coefficient_to_term)
    allowed = add(allowed, product_coefficient_to_coefficient)
    allowed = add(allowed, product_coefficient_to_round)
    allowed = add(allowed, product_round_to_round)
    allowed = add(allowed, product_round_to_finish)
    allowed = add(allowed, product_finish_to_round)
    allowed = add(allowed, product_finish_to_linear)
    allowed = add(allowed, linear_limb_to_limb)
    allowed = add(allowed, linear_limb_to_finish)
    allowed = add(allowed, linear_finish_to_limb)
    allowed = add(allowed, linear_finish_to_boundary)
    allowed = add(allowed, boundary_sign_to_limb)
    allowed = add(allowed, boundary_limb_to_limb)
    allowed = add(allowed, boundary_limb_to_sign)
    allowed = add(allowed, boundary_limb_to_finish)
    allowed = add(allowed, finish_to_padding)
    allowed = add(allowed, padding_to_padding)
    let mut fold = fold.absorb(sub(allowed, one))

    fold = absorb_sparse_control_edge(
        fold, radix_bit_to_bit, next,
        current.major, current.minor, add(current.step, one),
        current.flag, zero, mul(two, current.weight),
    )
    fold = absorb_sparse_control_edge(
        fold, radix_bit_to_limb, next,
        current.major, current.minor, zero, current.flag, zero, zero,
    )
    fold = fold.absorb(mul(
        radix_bit_to_limb,
        sub(current.step, natural<F>(12)),
    ))
    fold = absorb_sparse_control_edge(
        fold, radix_limb_to_bit, next,
        current.major, add(current.minor, one), zero, current.flag, zero, one,
    )
    fold = absorb_sparse_control_edge(
        fold, radix_limb_to_finish, next,
        current.major, zero, zero, current.flag, zero, zero,
    )
    fold = fold.absorb(mul(
        radix_limb_to_finish,
        sub(current.minor, last_limb),
    ))
    fold = absorb_sparse_control_edge(
        fold, radix_finish_to_bit, next,
        add(current.major, one), zero, zero, next.flag, zero, one,
    )
    fold = absorb_sparse_control_edge(
        fold, radix_finish_to_carry, next,
        zero, zero, zero, zero, zero, one,
    )
    fold = fold.absorb(mul(
        radix_finish_to_carry,
        sub(current.major, natural<F>(30)),
    ))

    let current_range = current.range_roles
    let next_range = next.range_roles
    let same_range = add(
        radix_bit_to_bit,
        add(
            radix_bit_to_limb,
            add(radix_limb_to_bit, radix_limb_to_finish),
        ),
    )
    fold = fold.absorb(mul(
        same_range,
        sub(next_range.coordinate, current_range.coordinate),
    ))
    fold = fold.absorb(mul(
        same_range,
        sub(next_range.product_low, current_range.product_low),
    ))
    fold = fold.absorb(mul(
        same_range,
        sub(next_range.product_high, current_range.product_high),
    ))
    fold = fold.absorb(mul(
        same_range,
        sub(next_range.product_output, current_range.product_output),
    ))
    fold = fold.absorb(mul(
        same_range,
        sub(next_range.linear_sum, current_range.linear_sum),
    ))
    fold = fold.absorb(mul(
        same_range,
        sub(
            next_range.linear_left_difference,
            current_range.linear_left_difference,
        ),
    ))
    fold = fold.absorb(mul(
        same_range,
        sub(
            next_range.linear_right_difference,
            current_range.linear_right_difference,
        ),
    ))
    fold = fold.absorb(mul(
        same_range,
        sub(next_range.linear_output, current_range.linear_output),
    ))
    let mut next_range_allowed = mul(
        current_range.coordinate,
        add(next_range.coordinate, next_range.product_low),
    )
    next_range_allowed = add(
        next_range_allowed,
        mul(current_range.product_low, next_range.product_high),
    )
    next_range_allowed = add(
        next_range_allowed,
        mul(current_range.product_high, next_range.product_output),
    )
    next_range_allowed = add(
        next_range_allowed,
        mul(
            current_range.product_output,
            add(next_range.product_low, next_range.linear_sum),
        ),
    )
    next_range_allowed = add(
        next_range_allowed,
        mul(current_range.linear_sum, next_range.linear_left_difference),
    )
    next_range_allowed = add(
        next_range_allowed,
        mul(
            current_range.linear_left_difference,
            next_range.linear_right_difference,
        ),
    )
    next_range_allowed = add(
        next_range_allowed,
        mul(current_range.linear_right_difference, next_range.linear_output),
    )
    next_range_allowed = add(
        next_range_allowed,
        mul(current_range.linear_output, next_range.linear_sum),
    )
    fold = fold.absorb(mul(
        radix_finish_to_bit,
        sub(next_range_allowed, one),
    ))
    fold = fold.absorb(mul(
        mul(
            radix_finish_to_bit,
            mul(current_range.coordinate, next_range.product_low),
        ),
        sub(current.major, natural<F>(5)),
    ))
    fold = fold.absorb(mul(
        mul(
            radix_finish_to_bit,
            mul(current_range.product_output, next_range.linear_sum),
        ),
        sub(current.major, natural<F>(14)),
    ))

    let current_positions = current.limb_positions
    let next_positions = next.limb_positions
    let penultimate_limb = sub(limbs, two)
    fold = fold.absorb(mul(
        current_positions.penultimate,
        sub(current.minor, penultimate_limb),
    ))
    fold = fold.absorb(mul(
        current_positions.last,
        sub(current.minor, last_limb),
    ))
    let same_limb_position = add(radix_bit_to_bit, radix_bit_to_limb)
    fold = fold.absorb(mul(
        same_limb_position,
        sub(next_positions.penultimate, current_positions.penultimate),
    ))
    fold = fold.absorb(mul(
        same_limb_position,
        sub(next_positions.last, current_positions.last),
    ))
    fold = fold.absorb(mul(
        radix_limb_to_bit,
        sub(next_positions.last, current_positions.penultimate),
    ))
    fold = fold.absorb(mul(radix_limb_to_bit, current_positions.last))
    fold = fold.absorb(mul(
        radix_limb_to_finish,
        sub(current_positions.last, one),
    ))
    fold = fold.absorb(mul(
        radix_finish_to_bit,
        sub(
            next_positions.penultimate,
            boolean<F>(L == 2),
        ),
    ))
    fold = fold.absorb(mul(radix_finish_to_bit, next_positions.last))

    let carry_reset = sub(next.flag, current.flag)
    fold = fold.absorb(mul(carry_bit_to_bit, bit_residual(carry_reset)))
    fold = fold.absorb(mul(
        carry_bit_to_bit,
        mul(current.flag, sub(one, next.flag)),
    ))
    fold = fold.absorb(mul(
        carry_bit_to_bit,
        mul(carry_reset, sub(current.step, natural<F>(17))),
    ))
    fold = absorb_sparse_control_edge(
        fold, carry_bit_to_bit, next,
        current.major,
        current.minor,
        mul(sub(one, carry_reset), add(current.step, one)),
        next.flag,
        zero,
        add(
            mul(sub(one, carry_reset), mul(two, current.weight)),
            carry_reset,
        ),
    )
    fold = absorb_sparse_control_edge(
        fold, carry_bit_to_finish, next,
        current.major, current.minor, zero, zero, zero, zero,
    )
    fold = fold.absorb(mul(carry_bit_to_finish, sub(current.flag, one)))
    fold = fold.absorb(mul(
        carry_bit_to_finish,
        sub(current.step, natural<F>(17)),
    ))

    let carry_product_delta = sub(next.major, current.major)
    fold = fold.absorb(mul(
        carry_finish_to_bit,
        bit_residual(carry_product_delta),
    ))
    fold = absorb_sparse_control_edge(
        fold, carry_finish_to_bit, next,
        add(current.major, carry_product_delta),
        mul(sub(one, carry_product_delta), add(current.minor, one)),
        zero, zero, zero, one,
    )
    fold = fold.absorb(mul(
        carry_finish_to_bit,
        mul(carry_product_delta, sub(current.minor, last_coefficient)),
    ))
    fold = absorb_sparse_control_edge(
        fold, carry_finish_to_product, next,
        zero, zero, zero, zero, one, zero,
    )
    fold = fold.absorb(mul(
        carry_finish_to_product,
        sub(current.major, natural<F>(2)),
    ))
    fold = fold.absorb(mul(
        carry_finish_to_product,
        sub(current.minor, last_coefficient),
    ))

    fold = absorb_sparse_control_edge(
        fold, product_term_to_term, next,
        current.major, current.minor, add(current.step, one),
        current.flag, current.width, zero,
    )
    fold = absorb_sparse_control_edge(
        fold, product_term_to_coefficient, next,
        current.major, current.minor, zero,
        current.flag, current.width, zero,
    )
    fold = fold.absorb(mul(
        product_term_to_coefficient,
        sub(add(current.step, one), current.width),
    ))

    let next_product_delta = sub(next.major, current.major)
    let same_product = sub(one, next_product_delta)
    let descending_rise = sub(next.flag, current.flag)
    fold = fold.absorb(mul(
        product_coefficient_to_term,
        bit_residual(next_product_delta),
    ))
    fold = fold.absorb(mul(
        product_coefficient_to_term,
        mul(same_product, mul(current.flag, sub(one, next.flag))),
    ))
    fold = fold.absorb(mul(
        product_coefficient_to_term,
        mul(
            same_product,
            mul(descending_rise, sub(current.minor, last_limb)),
        ),
    ))
    fold = absorb_sparse_control_edge(
        fold, product_coefficient_to_term, next,
        add(current.major, next_product_delta),
        mul(same_product, add(current.minor, one)),
        zero,
        mul(same_product, next.flag),
        add(
            mul(
                same_product,
                sub(add(current.width, one), mul(two, next.flag)),
            ),
            next_product_delta,
        ),
        zero,
    )
    fold = fold.absorb(mul(
        product_coefficient_to_term,
        mul(next_product_delta, sub(current.minor, last_coefficient)),
    ))
    fold = fold.absorb(mul(
        product_coefficient_to_term,
        mul(next_product_delta, current.width),
    ))

    fold = absorb_sparse_control_edge(
        fold, product_coefficient_to_coefficient, next,
        current.major, add(current.minor, one), zero, one, zero, zero,
    )
    fold = fold.absorb(mul(
        product_coefficient_to_coefficient,
        sub(current.minor, sub(last_coefficient, one)),
    ))
    fold = fold.absorb(mul(
        product_coefficient_to_coefficient,
        sub(current.flag, one),
    ))
    fold = fold.absorb(mul(
        product_coefficient_to_coefficient,
        sub(current.width, one),
    ))

    fold = absorb_sparse_control_edge(
        fold, product_coefficient_to_round, next,
        zero, zero, zero, zero, zero, zero,
    )
    fold = fold.absorb(mul(
        product_coefficient_to_round,
        sub(current.major, natural<F>(2)),
    ))
    fold = fold.absorb(mul(
        product_coefficient_to_round,
        sub(current.minor, last_coefficient),
    ))
    fold = fold.absorb(mul(
        product_coefficient_to_round,
        sub(current.flag, one),
    ))
    fold = fold.absorb(mul(product_coefficient_to_round, current.width))

    fold = absorb_sparse_control_edge(
        fold, product_round_to_round, next,
        current.major, add(current.minor, one), zero, zero, zero, zero,
    )
    fold = absorb_sparse_control_edge(
        fold, product_round_to_finish, next,
        current.major, zero, zero, zero, zero, zero,
    )
    fold = fold.absorb(mul(
        product_round_to_finish,
        sub(current.minor, last_limb),
    ))
    fold = absorb_sparse_control_edge(
        fold, product_finish_to_round, next,
        add(current.major, one), zero, zero, zero, zero, zero,
    )
    fold = absorb_sparse_control_edge(
        fold, product_finish_to_linear, next,
        zero, zero, zero, one, zero, zero,
    )
    fold = fold.absorb(mul(
        product_finish_to_linear,
        sub(current.major, natural<F>(2)),
    ))

    let linear_role_delta = sub(next.minor, current.minor)
    fold = fold.absorb(mul(
        linear_limb_to_limb,
        bit_residual(linear_role_delta),
    ))
    fold = absorb_sparse_control_edge(
        fold, linear_limb_to_limb, next,
        current.major,
        add(current.minor, linear_role_delta),
        mul(sub(one, linear_role_delta), add(current.step, one)),
        current.flag, zero, zero,
    )
    fold = fold.absorb(mul(
        linear_limb_to_limb,
        mul(linear_role_delta, sub(current.step, last_limb)),
    ))
    fold = absorb_sparse_control_edge(
        fold, linear_limb_to_finish, next,
        current.major, zero, zero, current.flag, zero, zero,
    )
    fold = fold.absorb(mul(
        linear_limb_to_finish,
        sub(current.minor, natural<F>(3)),
    ))
    fold = fold.absorb(mul(
        linear_limb_to_finish,
        sub(current.step, last_limb),
    ))
    fold = absorb_sparse_control_edge(
        fold, linear_finish_to_limb, next,
        add(current.major, one), zero, zero, zero, zero, zero,
    )
    fold = absorb_sparse_control_edge(
        fold, linear_finish_to_boundary, next,
        zero, zero, zero, zero, zero, zero,
    )
    fold = fold.absorb(mul(
        linear_finish_to_boundary,
        sub(current.major, natural<F>(3)),
    ))

    let current_roles = current.linear_roles
    let next_roles = next.linear_roles
    fold = fold.absorb(mul(
        product_finish_to_linear,
        sub(next_roles.sum, one),
    ))
    fold = fold.absorb(mul(
        product_finish_to_linear,
        next_roles.left_difference,
    ))
    fold = fold.absorb(mul(
        product_finish_to_linear,
        next_roles.right_difference,
    ))
    fold = fold.absorb(mul(
        product_finish_to_linear,
        next_roles.select,
    ))
    fold = fold.absorb(mul(
        linear_limb_to_limb,
        sub(
            next_roles.sum,
            mul(sub(one, linear_role_delta), current_roles.sum),
        ),
    ))
    fold = fold.absorb(mul(
        linear_limb_to_limb,
        sub(
            next_roles.left_difference,
            add(
                mul(
                    sub(one, linear_role_delta),
                    current_roles.left_difference,
                ),
                mul(linear_role_delta, current_roles.sum),
            ),
        ),
    ))
    fold = fold.absorb(mul(
        linear_limb_to_limb,
        sub(
            next_roles.right_difference,
            add(
                mul(
                    sub(one, linear_role_delta),
                    current_roles.right_difference,
                ),
                mul(linear_role_delta, current_roles.left_difference),
            ),
        ),
    ))
    fold = fold.absorb(mul(
        linear_limb_to_limb,
        sub(
            next_roles.select,
            add(
                mul(
                    sub(one, linear_role_delta),
                    current_roles.select,
                ),
                mul(linear_role_delta, current_roles.right_difference),
            ),
        ),
    ))
    fold = fold.absorb(mul(
        linear_finish_to_limb,
        sub(next_roles.sum, one),
    ))
    fold = fold.absorb(mul(
        linear_finish_to_limb,
        next_roles.left_difference,
    ))
    fold = fold.absorb(mul(
        linear_finish_to_limb,
        next_roles.right_difference,
    ))
    fold = fold.absorb(mul(
        linear_finish_to_limb,
        next_roles.select,
    ))

    fold = absorb_sparse_control_edge(
        fold, boundary_sign_to_limb, next,
        current.major, zero, zero, zero, zero, zero,
    )
    fold = absorb_sparse_control_edge(
        fold, boundary_limb_to_limb, next,
        current.major, add(current.minor, one), zero, zero, zero, zero,
    )
    fold = absorb_sparse_control_edge(
        fold, boundary_limb_to_sign, next,
        add(current.major, one), zero, zero, zero, zero, zero,
    )
    fold = fold.absorb(mul(
        boundary_limb_to_sign,
        sub(current.minor, last_limb),
    ))
    fold = absorb_sparse_control_edge(
        fold, boundary_limb_to_finish, next,
        zero, zero, zero, zero, zero, zero,
    )
    fold = fold.absorb(mul(
        boundary_limb_to_finish,
        sub(current.major, one),
    ))
    fold = fold.absorb(mul(
        boundary_limb_to_finish,
        sub(current.minor, last_limb),
    ))
    fold = absorb_sparse_control_edge(
        fold, finish_to_padding, next,
        zero, zero, zero, zero, zero, zero,
    )
    absorb_sparse_control_edge(
        fold, padding_to_padding, next,
        zero, zero, zero, zero, zero, zero,
    )
}

/// Constrain one adjacent pair in the deterministic sparse schedule. Every
/// residual is polynomial in committed field columns, so the same relation is
/// meaningful after low-degree extension.
pub fn evaluate_sparse_control_link<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ current: SparseControlRow<F>,
    _ next: SparseControlRow<F>,
) -> FixedAirConstraintEvaluation<F>
where L > 1,
{
    let fold = absorb_sparse_control_link<F, L>(
        ConstraintFold<F>::new(challenge),
        current,
        next,
    )
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn evaluate_sparse_control_initial<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ row: SparseControlRow<F>,
) -> FixedAirConstraintEvaluation<F>
where L > 1,
{
    let mut fold = ConstraintFold<F>::new(challenge)
    fold = fold.absorb(sub(row.selectors.radix_bit, one<F>()))
    fold = fold.absorb(row.major)
    fold = fold.absorb(row.minor)
    fold = fold.absorb(row.step)
    fold = fold.absorb(sub(row.flag, one<F>()))
    fold = fold.absorb(row.width)
    fold = fold.absorb(sub(row.weight, one<F>()))
    fold = fold.absorb(sub(row.range_roles.coordinate, one<F>()))
    fold = fold.absorb(sub(
        row.limb_positions.penultimate,
        boolean<F>(L == 2),
    ))
    fold = fold.absorb(row.limb_positions.last)
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn evaluate_sparse_control_terminal<F: Radix2Field>(
    _ challenge: F,
    _ row: SparseControlRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let mut fold = ConstraintFold<F>::new(challenge)
    fold = fold.absorb(sub(row.selectors.padding, one<F>()))
    fold = fold.absorb(row.major)
    fold = fold.absorb(row.minor)
    fold = fold.absorb(row.step)
    fold = fold.absorb(row.flag)
    fold = fold.absorb(row.width)
    fold = fold.absorb(row.weight)
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

fn linear_copy_key<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ address: SparseCopyAddress,
) -> F {
    let limbs: u32 = L.downcast_truncate()
    let digit_addresses = sparse_range_node_count() * limbs
    let rank = match address {
        SparseCopyAddress::RangeDigit(node, limb) => {
            range_node_rank(node) * limbs + limb
        }
        SparseCopyAddress::RangeSign(node) => {
            digit_addresses + range_node_rank(node)
        }
        SparseCopyAddress::RangeNonzero(node) => {
            digit_addresses + sparse_range_node_count() + range_node_rank(node)
        }
        SparseCopyAddress::LinearBorrow(linear, right) => {
            digit_addresses + 2 * sparse_range_node_count()
                + 2 * linear_node_rank(linear)
                + if right { 1 } else { 0 }
        }
        SparseCopyAddress::LinearSameSign(linear) => {
            digit_addresses + 2 * sparse_range_node_count()
                + 2 * sparse_linear_node_count()
                + linear_node_rank(linear)
        }
        SparseCopyAddress::LinearSelectRight(linear) => {
            digit_addresses + 2 * sparse_range_node_count()
                + 3 * sparse_linear_node_count()
                + linear_node_rank(linear)
        }
        _ => return zero<F>(),
    }
    let mut key = one<F>()
    let mut exponent: u32 = 0
    while exponent < rank + 1 {
        key = mul(key, challenge)
        exponent = exponent + 1
    }
    key
}

fn linear_left_range(_ linear: LinearNode) -> RangeNode {
    match linear {
        LinearNode::RealDifference => RangeNode::ProductOutput(ProductNode::Xx),
        LinearNode::NextReal => RangeNode::LinearOutput(LinearNode::RealDifference),
        LinearNode::DoubleXy => RangeNode::ProductOutput(ProductNode::Xy),
        LinearNode::NextImaginary => RangeNode::LinearOutput(LinearNode::DoubleXy),
        LinearNode::Invalid => RangeNode::Invalid,
    }
}

fn linear_right_range(_ linear: LinearNode) -> RangeNode {
    match linear {
        LinearNode::RealDifference => RangeNode::ProductOutput(ProductNode::Yy),
        LinearNode::NextReal => RangeNode::PointReal,
        LinearNode::DoubleXy => RangeNode::ProductOutput(ProductNode::Xy),
        LinearNode::NextImaginary => RangeNode::PointImaginary,
        LinearNode::Invalid => RangeNode::Invalid,
    }
}

fn range_node_same(_ left: RangeNode, _ right: RangeNode) -> bool {
    range_node_rank(left) == range_node_rank(right)
}

fn linear_copy_range_contribution<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ address: RangeNode,
    _ limb: u32,
    _ value: F,
    _ candidate: RangeNode,
    _ multiplicity: u32,
) -> F {
    if range_node_same(address, candidate) {
        mul(
            mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeDigit(address, limb),
                ),
                value,
            ),
            natural<F>(multiplicity),
        )
    } else {
        zero<F>()
    }
}

pub fn sparse_linear_copy_source<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ target: LinearNode,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::RadixLimb(node, limb) => {
            let mut contribution = linear_copy_range_contribution<F, L>(
                challenge, node, limb, row.value, linear_left_range(target), 3,
            )
            contribution = add(contribution, linear_copy_range_contribution<F, L>(
                challenge, node, limb, row.value, linear_right_range(target), 3,
            ))
            contribution = add(contribution, linear_copy_range_contribution<F, L>(
                challenge, node, limb, row.value, RangeNode::LinearSum(target), 1,
            ))
            contribution = add(contribution, linear_copy_range_contribution<F, L>(
                challenge, node, limb, row.value,
                RangeNode::LinearLeftDifference(target), 1,
            ))
            contribution = add(contribution, linear_copy_range_contribution<F, L>(
                challenge, node, limb, row.value,
                RangeNode::LinearRightDifference(target), 1,
            ))
            add(contribution, linear_copy_range_contribution<F, L>(
                challenge, node, limb, row.value, RangeNode::LinearOutput(target), 1,
            ))
        }
        SparseTransitionTask::RadixFinish(node) => {
            let mut contribution = zero<F>()
            if range_node_same(node, linear_left_range(target)) {
                contribution = add(contribution, mul(
                    linear_copy_key<F, L>(challenge, SparseCopyAddress::RangeSign(node)),
                    row.auxiliary,
                ))
            }
            if range_node_same(node, linear_right_range(target)) {
                contribution = add(contribution, mul(
                    linear_copy_key<F, L>(challenge, SparseCopyAddress::RangeSign(node)),
                    row.auxiliary,
                ))
            }
            if range_node_same(node, RangeNode::LinearOutput(target)) {
                contribution = add(contribution, mul(
                    linear_copy_key<F, L>(challenge, SparseCopyAddress::RangeSign(node)),
                    row.auxiliary,
                ))
                contribution = add(contribution, mul(
                    linear_copy_key<F, L>(challenge, SparseCopyAddress::RangeNonzero(node)),
                    row.value,
                ))
            }
            contribution
        }
        SparseTransitionTask::LinearLimb(node, role, limb) => {
            let limbs: u32 = L.downcast_truncate()
            if linear_node_rank(node) != linear_node_rank(target)
                || limb + 1 != limbs
            {
                return zero<F>()
            }
            match role {
                LinearLimbRole::LeftDifference => mul(
                    linear_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::LinearBorrow(target, false),
                    ),
                    row.accumulator_after,
                ),
                LinearLimbRole::RightDifference => mul(
                    linear_copy_key<F, L>(
                        challenge,
                        SparseCopyAddress::LinearBorrow(target, true),
                    ),
                    row.accumulator_after,
                ),
                _ => zero<F>(),
            }
        }
        SparseTransitionTask::LinearFinish(node) => {
            if linear_node_rank(node) != linear_node_rank(target) {
                return zero<F>()
            }
            let subtract = boolean<F>(linear_subtracts_right(node))
            let effective_right = sub(
                add(row.auxiliary, subtract),
                mul(natural<F>(2), mul(row.auxiliary, subtract)),
            )
            let different = sub(
                add(row.value, effective_right),
                mul(natural<F>(2), mul(row.value, effective_right)),
            )
            let same = sub(one<F>(), different)
            let limbs: u32 = L.downcast_truncate()
            add(
                mul(
                    mul(
                        linear_copy_key<F, L>(
                            challenge,
                            SparseCopyAddress::LinearSameSign(target),
                        ),
                        same,
                    ),
                    natural<F>(limbs),
                ),
                mul(
                    mul(
                        linear_copy_key<F, L>(
                            challenge,
                            SparseCopyAddress::LinearSelectRight(target),
                        ),
                        row.accumulator_before,
                    ),
                    natural<F>(limbs),
                ),
            )
        }
        _ => zero<F>(),
    }
}

fn linear_copy_read<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ range: RangeNode,
    _ limb: u32,
    _ value: F,
) -> F {
    mul(
        linear_copy_key<F, L>(
            challenge,
            SparseCopyAddress::RangeDigit(range, limb),
        ),
        value,
    )
}

pub fn sparse_linear_copy_consumer<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ target: LinearNode,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> F {
    match task {
        SparseTransitionTask::LinearLimb(node, role, limb) => {
            if linear_node_rank(node) != linear_node_rank(target) {
                return zero<F>()
            }
            match role {
                LinearLimbRole::Sum => add(
                    add(
                        linear_copy_read<F, L>(
                            challenge, linear_left_range(target), limb, row.value,
                        ),
                        linear_copy_read<F, L>(
                            challenge, linear_right_range(target), limb, row.auxiliary,
                        ),
                    ),
                    linear_copy_read<F, L>(
                        challenge, RangeNode::LinearSum(target), limb, row.state_before,
                    ),
                ),
                LinearLimbRole::LeftDifference => add(
                    add(
                        linear_copy_read<F, L>(
                            challenge, linear_left_range(target), limb, row.value,
                        ),
                        linear_copy_read<F, L>(
                            challenge, linear_right_range(target), limb, row.auxiliary,
                        ),
                    ),
                    linear_copy_read<F, L>(
                        challenge, RangeNode::LinearLeftDifference(target), limb,
                        row.state_before,
                    ),
                ),
                LinearLimbRole::RightDifference => add(
                    add(
                        linear_copy_read<F, L>(
                            challenge, linear_left_range(target), limb, row.value,
                        ),
                        linear_copy_read<F, L>(
                            challenge, linear_right_range(target), limb, row.auxiliary,
                        ),
                    ),
                    linear_copy_read<F, L>(
                        challenge, RangeNode::LinearRightDifference(target), limb,
                        row.state_before,
                    ),
                ),
                LinearLimbRole::Select => {
                    let mut contribution = linear_copy_read<F, L>(
                        challenge, RangeNode::LinearSum(target), limb, row.value,
                    )
                    contribution = add(contribution, linear_copy_read<F, L>(
                        challenge, RangeNode::LinearLeftDifference(target), limb,
                        row.auxiliary,
                    ))
                    contribution = add(contribution, linear_copy_read<F, L>(
                        challenge, RangeNode::LinearRightDifference(target), limb,
                        row.accumulator_before,
                    ))
                    contribution = add(contribution, linear_copy_read<F, L>(
                        challenge, RangeNode::LinearOutput(target), limb,
                        row.accumulator_after,
                    ))
                    contribution = add(contribution, mul(
                        linear_copy_key<F, L>(
                            challenge,
                            SparseCopyAddress::LinearSameSign(target),
                        ),
                        row.state_before,
                    ))
                    add(contribution, mul(
                        linear_copy_key<F, L>(
                            challenge,
                            SparseCopyAddress::LinearSelectRight(target),
                        ),
                        row.state_after,
                    ))
                }
                LinearLimbRole::Invalid => zero<F>(),
            }
        }
        SparseTransitionTask::LinearFinish(node) => {
            if linear_node_rank(node) != linear_node_rank(target) {
                return zero<F>()
            }
            let output = RangeNode::LinearOutput(target)
            let mut contribution = mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeSign(linear_left_range(target)),
                ),
                row.value,
            )
            contribution = add(contribution, mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeSign(linear_right_range(target)),
                ),
                row.auxiliary,
            ))
            contribution = add(contribution, mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::LinearBorrow(target, false),
                ),
                row.accumulator_before,
            ))
            contribution = add(contribution, mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::LinearBorrow(target, true),
                ),
                row.accumulator_after,
            ))
            contribution = add(contribution, mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeNonzero(output),
                ),
                row.state_before,
            ))
            add(contribution, mul(
                linear_copy_key<F, L>(
                    challenge,
                    SparseCopyAddress::RangeSign(output),
                ),
                row.state_after,
            ))
        }
        _ => zero<F>(),
    }
}

fn absorb_sparse_boundary_row<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> ConstraintFold<F> {
    let mut fold = fold
    match task {
        SparseTransitionTask::BoundarySign(_coordinate) => {
            fold = fold.absorb(bit_residual(row.value))
            fold = fold.absorb(bit_residual(row.auxiliary))
            fold = fold.absorb(sub(row.value, row.auxiliary))
            fold = fold.absorb(row.accumulator_before)
            fold = fold.absorb(row.accumulator_after)
            fold = fold.absorb(row.state_before)
            fold.absorb(row.state_after)
        }
        SparseTransitionTask::BoundaryLimb(_coordinate, _limb) => {
            fold = fold.absorb(sub(row.value, row.auxiliary))
            fold = fold.absorb(row.accumulator_before)
            fold = fold.absorb(row.accumulator_after)
            fold = fold.absorb(row.state_before)
            fold.absorb(row.state_after)
        }
        SparseTransitionTask::TransitionFinish => {
            fold = fold.absorb(sub(row.value, one<F>()))
            fold = fold.absorb(row.auxiliary)
            fold = fold.absorb(row.accumulator_before)
            fold = fold.absorb(row.accumulator_after)
            fold = fold.absorb(row.state_before)
            fold.absorb(row.state_after)
        }
        _ => fold.absorb(one<F>()),
    }
}

pub fn evaluate_sparse_boundary_row<F: Radix2Field>(
    _ challenge: F,
    _ task: SparseTransitionTask,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = absorb_sparse_boundary_row(
        ConstraintFold<F>::new(challenge),
        task,
        row,
    )
    FixedAirConstraintEvaluation {
        valid: match task {
            SparseTransitionTask::BoundarySign(_) => true,
            SparseTransitionTask::BoundaryLimb(_, _) => true,
            SparseTransitionTask::TransitionFinish => true,
            _ => false,
        },
        constraints: fold.constraints,
        folded: fold.value,
    }
}

fn absorb_selected<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ selector: F,
    _ residual: F,
) -> ConstraintFold<F> {
    fold.absorb(mul(selector, residual))
}

/// Index-free arithmetic interpretation of one sparse row. Task selection,
/// bit weights, linear roles, and subtraction mode all come from constrained
/// field columns. The evaluator therefore remains the same polynomial after
/// the trace columns are extended off the base domain.
pub fn evaluate_sparse_arithmetic_row<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let selectors = control.selectors
    let roles = control.linear_roles
    let radix = natural<F>(8192)
    let one = one<F>()
    let two = natural<F>(2)
    let mut fold = ConstraintFold<F>::new(challenge)

    fold = absorb_selected(fold, selectors.radix_bit, bit_residual(row.value))
    fold = absorb_selected(
        fold,
        selectors.radix_bit,
        bit_residual(row.state_after),
    )
    fold = absorb_selected(
        fold,
        selectors.radix_bit,
        sub(
            row.state_after,
            sub(
                add(row.state_before, row.value),
                mul(row.state_before, row.value),
            ),
        ),
    )
    fold = absorb_selected(
        fold,
        selectors.radix_bit,
        sub(
            row.accumulator_after,
            add(
                row.accumulator_before,
                mul(row.value, control.weight),
            ),
        ),
    )
    fold = absorb_selected(
        fold,
        selectors.radix_limb,
        sub(row.value, row.accumulator_before),
    )
    fold = absorb_selected(fold, selectors.radix_limb, row.accumulator_after)
    fold = absorb_selected(
        fold,
        selectors.radix_limb,
        sub(row.state_after, row.state_before),
    )
    fold = absorb_selected(
        fold,
        selectors.radix_finish,
        bit_residual(row.value),
    )
    fold = absorb_selected(
        fold,
        selectors.radix_finish,
        sub(row.value, row.state_before),
    )
    fold = absorb_selected(fold, selectors.radix_finish, row.accumulator_before)
    fold = absorb_selected(fold, selectors.radix_finish, row.accumulator_after)
    fold = absorb_selected(fold, selectors.radix_finish, row.state_after)
    fold = absorb_selected(
        fold,
        selectors.radix_finish,
        bit_residual(row.auxiliary),
    )
    fold = absorb_selected(
        fold,
        selectors.radix_finish,
        mul(
            row.auxiliary,
            sub(one, mul(control.flag, row.value)),
        ),
    )

    fold = absorb_selected(fold, selectors.carry_bit, bit_residual(row.value))
    fold = absorb_selected(
        fold,
        selectors.carry_bit,
        sub(
            row.accumulator_after,
            add(
                row.accumulator_before,
                mul(row.value, control.weight),
            ),
        ),
    )
    fold = absorb_selected(
        fold,
        selectors.carry_bit,
        sub(row.state_after, row.state_before),
    )
    fold = absorb_selected(
        fold,
        selectors.carry_finish,
        sub(row.value, row.state_before),
    )
    fold = absorb_selected(
        fold,
        selectors.carry_finish,
        sub(
            add(row.state_before, row.accumulator_before),
            natural<F>(product_carry_bound<L>()),
        ),
    )
    fold = absorb_selected(fold, selectors.carry_finish, row.auxiliary)
    fold = absorb_selected(fold, selectors.carry_finish, row.accumulator_after)
    fold = absorb_selected(fold, selectors.carry_finish, row.state_after)

    fold = absorb_selected(
        fold,
        selectors.product_term,
        sub(
            row.accumulator_after,
            add(
                row.accumulator_before,
                mul(row.value, row.auxiliary),
            ),
        ),
    )
    fold = absorb_selected(
        fold,
        selectors.product_term,
        sub(row.state_after, row.state_before),
    )
    fold = absorb_selected(
        fold,
        selectors.product_coefficient,
        sub(
            sub(
                add(row.accumulator_before, row.state_before),
                row.value,
            ),
            mul(radix, row.auxiliary),
        ),
    )
    fold = absorb_selected(
        fold,
        selectors.product_coefficient,
        row.accumulator_after,
    )
    fold = absorb_selected(
        fold,
        selectors.product_coefficient,
        sub(row.state_after, row.auxiliary),
    )

    fold = absorb_selected(
        fold,
        selectors.product_round,
        bit_residual(row.accumulator_after),
    )
    fold = absorb_selected(
        fold,
        selectors.product_round,
        sub(
            sub(
                add(row.value, row.accumulator_before),
                row.auxiliary,
            ),
            mul(radix, row.accumulator_after),
        ),
    )
    fold = absorb_selected(
        fold,
        selectors.product_round,
        sub(row.state_after, row.state_before),
    )
    fold = absorb_selected(
        fold,
        selectors.product_finish,
        bit_residual(row.value),
    )
    fold = absorb_selected(
        fold,
        selectors.product_finish,
        bit_residual(row.auxiliary),
    )
    fold = absorb_selected(
        fold,
        selectors.product_finish,
        bit_residual(row.accumulator_before),
    )
    fold = absorb_selected(
        fold,
        selectors.product_finish,
        bit_residual(row.accumulator_after),
    )
    fold = absorb_selected(
        fold,
        selectors.product_finish,
        bit_residual(row.state_before),
    )
    fold = absorb_selected(
        fold,
        selectors.product_finish,
        bit_residual(row.state_after),
    )
    let product_sign_xor = sub(
        add(row.accumulator_after, row.state_after),
        mul(two, mul(row.accumulator_after, row.state_after)),
    )
    fold = absorb_selected(
        fold,
        selectors.product_finish,
        sub(row.value, mul(product_sign_xor, row.auxiliary)),
    )

    fold = absorb_selected(
        fold,
        roles.sum,
        bit_residual(row.accumulator_after),
    )
    fold = absorb_selected(
        fold,
        roles.sum,
        sub(
            sub(
                add(
                    add(row.value, row.auxiliary),
                    row.accumulator_before,
                ),
                row.state_before,
            ),
            mul(radix, row.accumulator_after),
        ),
    )
    fold = absorb_selected(fold, roles.sum, row.state_after)
    fold = absorb_selected(
        fold,
        roles.left_difference,
        bit_residual(row.accumulator_after),
    )
    fold = absorb_selected(
        fold,
        roles.left_difference,
        sub(
            sub(
                add(
                    row.value,
                    mul(radix, row.accumulator_after),
                ),
                row.auxiliary,
            ),
            add(row.accumulator_before, row.state_before),
        ),
    )
    fold = absorb_selected(fold, roles.left_difference, row.state_after)
    fold = absorb_selected(
        fold,
        roles.right_difference,
        bit_residual(row.accumulator_after),
    )
    fold = absorb_selected(
        fold,
        roles.right_difference,
        sub(
            sub(
                add(
                    row.auxiliary,
                    mul(radix, row.accumulator_after),
                ),
                row.value,
            ),
            add(row.accumulator_before, row.state_before),
        ),
    )
    fold = absorb_selected(fold, roles.right_difference, row.state_after)
    fold = absorb_selected(fold, roles.select, bit_residual(row.state_before))
    fold = absorb_selected(fold, roles.select, bit_residual(row.state_after))
    let selected_difference = add(
        mul(sub(one, row.state_after), row.auxiliary),
        mul(row.state_after, row.accumulator_before),
    )
    let selected_magnitude = add(
        mul(row.state_before, row.value),
        mul(sub(one, row.state_before), selected_difference),
    )
    fold = absorb_selected(
        fold,
        roles.select,
        sub(row.accumulator_after, selected_magnitude),
    )

    fold = absorb_selected(
        fold,
        selectors.linear_finish,
        bit_residual(row.value),
    )
    fold = absorb_selected(
        fold,
        selectors.linear_finish,
        bit_residual(row.auxiliary),
    )
    fold = absorb_selected(
        fold,
        selectors.linear_finish,
        bit_residual(row.accumulator_before),
    )
    fold = absorb_selected(
        fold,
        selectors.linear_finish,
        bit_residual(row.accumulator_after),
    )
    fold = absorb_selected(
        fold,
        selectors.linear_finish,
        bit_residual(row.state_before),
    )
    fold = absorb_selected(
        fold,
        selectors.linear_finish,
        bit_residual(row.state_after),
    )
    let effective_right = sub(
        add(row.auxiliary, control.flag),
        mul(two, mul(row.auxiliary, control.flag)),
    )
    let signs_different = sub(
        add(row.value, effective_right),
        mul(two, mul(row.value, effective_right)),
    )
    let signs_same = sub(one, signs_different)
    let select_right = row.accumulator_before
    fold = absorb_selected(
        fold,
        selectors.linear_finish,
        add(
            mul(sub(one, select_right), row.accumulator_before),
            mul(select_right, row.accumulator_after),
        ),
    )
    let selected_difference_sign = add(
        mul(sub(one, select_right), row.value),
        mul(select_right, effective_right),
    )
    let selected_sign = add(
        mul(signs_same, row.value),
        mul(sub(one, signs_same), selected_difference_sign),
    )
    fold = absorb_selected(
        fold,
        selectors.linear_finish,
        sub(row.state_after, mul(selected_sign, row.state_before)),
    )

    fold = absorb_selected(
        fold,
        selectors.boundary_sign,
        bit_residual(row.value),
    )
    fold = absorb_selected(
        fold,
        selectors.boundary_sign,
        bit_residual(row.auxiliary),
    )
    fold = absorb_selected(
        fold,
        selectors.boundary_sign,
        sub(row.value, row.auxiliary),
    )
    fold = absorb_selected(fold, selectors.boundary_sign, row.accumulator_before)
    fold = absorb_selected(fold, selectors.boundary_sign, row.accumulator_after)
    fold = absorb_selected(fold, selectors.boundary_sign, row.state_before)
    fold = absorb_selected(fold, selectors.boundary_sign, row.state_after)
    fold = absorb_selected(
        fold,
        selectors.boundary_limb,
        sub(row.value, row.auxiliary),
    )
    fold = absorb_selected(fold, selectors.boundary_limb, row.accumulator_before)
    fold = absorb_selected(fold, selectors.boundary_limb, row.accumulator_after)
    fold = absorb_selected(fold, selectors.boundary_limb, row.state_before)
    fold = absorb_selected(fold, selectors.boundary_limb, row.state_after)
    fold = absorb_selected(
        fold,
        selectors.transition_finish,
        sub(row.value, one),
    )
    fold = absorb_selected(fold, selectors.transition_finish, row.auxiliary)
    fold = absorb_selected(
        fold,
        selectors.transition_finish,
        row.accumulator_before,
    )
    fold = absorb_selected(
        fold,
        selectors.transition_finish,
        row.accumulator_after,
    )
    fold = absorb_selected(fold, selectors.transition_finish, row.state_before)
    fold = absorb_selected(fold, selectors.transition_finish, row.state_after)
    fold = absorb_selected(fold, selectors.padding, row.value)
    fold = absorb_selected(fold, selectors.padding, row.auxiliary)
    fold = absorb_selected(fold, selectors.padding, row.accumulator_before)
    fold = absorb_selected(fold, selectors.padding, row.accumulator_after)
    fold = absorb_selected(fold, selectors.padding, row.state_before)
    fold = absorb_selected(fold, selectors.padding, row.state_after)

    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

/// Index-free adjacency for the sparse arithmetic scans. Phase handoffs are
/// selected by the constrained current and next control rows, including carry
/// value-to-slack reset, product boundaries, rounding resets, and the three
/// independent signed-linear ripples.
pub fn evaluate_sparse_arithmetic_link<F: Radix2Field>(
    _ challenge: F,
    _ current_control: SparseControlRow<F>,
    _ current: SparseTaskRow<F>,
    _ next_control: SparseControlRow<F>,
    _ next: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let current_selectors = current_control.selectors
    let next_selectors = next_control.selectors
    let one = one<F>()
    let mut fold = ConstraintFold<F>::new(challenge)

    let current_radix = add(
        current_selectors.radix_bit,
        add(
            current_selectors.radix_limb,
            current_selectors.radix_finish,
        ),
    )
    let next_radix = add(
        next_selectors.radix_bit,
        add(next_selectors.radix_limb, next_selectors.radix_finish),
    )
    let radix_link = mul(current_radix, next_radix)
    fold = absorb_selected(
        fold,
        radix_link,
        sub(next.accumulator_before, current.accumulator_after),
    )
    fold = absorb_selected(
        fold,
        radix_link,
        sub(next.state_before, current.state_after),
    )

    let carry_entry = mul(
        current_selectors.radix_finish,
        next_selectors.carry_bit,
    )
    fold = absorb_selected(fold, carry_entry, next.accumulator_before)
    fold = absorb_selected(fold, carry_entry, next.state_before)
    let current_carry = add(
        current_selectors.carry_bit,
        current_selectors.carry_finish,
    )
    let next_carry = add(
        next_selectors.carry_bit,
        next_selectors.carry_finish,
    )
    let carry_link = mul(current_carry, next_carry)
    let carry_reset = mul(
        mul(current_selectors.carry_bit, next_selectors.carry_bit),
        sub(next_control.flag, current_control.flag),
    )
    fold = absorb_selected(
        fold,
        carry_link,
        sub(
            next.accumulator_before,
            mul(sub(one, carry_reset), current.accumulator_after),
        ),
    )
    fold = absorb_selected(
        fold,
        carry_link,
        sub(
            next.state_before,
            add(
                mul(sub(one, carry_reset), current.state_after),
                mul(carry_reset, current.accumulator_after),
            ),
        ),
    )

    let product_entry = mul(
        current_selectors.carry_finish,
        next_selectors.product_term,
    )
    fold = absorb_selected(fold, product_entry, next.accumulator_before)
    fold = absorb_selected(fold, product_entry, next.state_before)
    let current_product = add(
        current_selectors.product_term,
        current_selectors.product_coefficient,
    )
    let next_product = add(
        next_selectors.product_term,
        next_selectors.product_coefficient,
    )
    let product_link = mul(current_product, next_product)
    fold = absorb_selected(
        fold,
        product_link,
        sub(next.accumulator_before, current.accumulator_after),
    )
    fold = absorb_selected(
        fold,
        product_link,
        sub(next.state_before, current.state_after),
    )
    let product_terminal = mul(
        current_selectors.product_coefficient,
        next_selectors.product_round,
    )
    fold = absorb_selected(fold, product_terminal, current.state_after)

    let round_start = mul(
        add(
            current_selectors.product_coefficient,
            current_selectors.product_finish,
        ),
        next_selectors.product_round,
    )
    fold = absorb_selected(
        fold,
        round_start,
        sub(next.accumulator_before, next.state_before),
    )
    let round_link = mul(
        current_selectors.product_round,
        add(
            next_selectors.product_round,
            next_selectors.product_finish,
        ),
    )
    fold = absorb_selected(
        fold,
        round_link,
        sub(next.accumulator_before, current.accumulator_after),
    )
    fold = absorb_selected(
        fold,
        round_link,
        sub(next.state_before, current.state_after),
    )

    let current_roles = current_control.linear_roles
    let next_roles = next_control.linear_roles
    let linear_sum_start = mul(
        add(
            current_selectors.product_finish,
            current_selectors.linear_finish,
        ),
        next_roles.sum,
    )
    let linear_left_start = mul(current_roles.sum, next_roles.left_difference)
    let linear_right_start = mul(
        current_roles.left_difference,
        next_roles.right_difference,
    )
    fold = absorb_selected(fold, linear_sum_start, next.accumulator_before)
    fold = absorb_selected(fold, linear_left_start, next.accumulator_before)
    fold = absorb_selected(fold, linear_right_start, next.accumulator_before)
    fold = absorb_selected(
        fold,
        mul(current_roles.sum, next_roles.sum),
        sub(next.accumulator_before, current.accumulator_after),
    )
    fold = absorb_selected(
        fold,
        mul(
            current_roles.left_difference,
            next_roles.left_difference,
        ),
        sub(next.accumulator_before, current.accumulator_after),
    )
    fold = absorb_selected(
        fold,
        mul(
            current_roles.right_difference,
            next_roles.right_difference,
        ),
        sub(next.accumulator_before, current.accumulator_after),
    )

    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn evaluate_sparse_arithmetic_initial<F: Radix2Field>(
    _ challenge: F,
    _ row: SparseTaskRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let mut fold = ConstraintFold<F>::new(challenge)
    fold = fold.absorb(row.accumulator_before)
    fold = fold.absorb(row.state_before)
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

struct SparseCopyPort<F: Radix2Field> {
    selector: F,
    coefficient: F,
    address: F,
    value: F,
}
impl<F: Radix2Field> core::marker::Copy for SparseCopyPort<F> {}

fn zero_sparse_copy_port<F: Radix2Field>() -> SparseCopyPort<F> {
    SparseCopyPort {
        selector: zero<F>(),
        coefficient: zero<F>(),
        address: zero<F>(),
        value: zero<F>(),
    }
}

fn sparse_product_current_coordinate<F: Radix2Field>(
    _ control: SparseControlRow<F>,
) -> F {
    let major = control.major
    let numerator = mul(
        mul(major, sub(major, one<F>())),
        mul(
            sub(major, natural<F>(4)),
            sub(major, natural<F>(5)),
        ),
    )
    mul(
        control.range_roles.coordinate,
        mul(numerator, natural<F>(12).radix2_inverse_or_zero()),
    )
}

fn sparse_product_range_address<F: Radix2Field, const L: usize>(
    _ control: SparseControlRow<F>,
) -> F {
    let roles = control.range_roles
    let current = sparse_product_current_coordinate(control)
    let product = add(roles.product_low, roles.product_high)
    let product_node = mul(
        sub(
            sub(control.major, natural<F>(6)),
            roles.product_high,
        ),
        natural<F>(3).radix2_inverse_or_zero(),
    )
    let current_rank = sub(control.major, natural<F>(2))
    let product_rank = add(
        natural<F>(2),
        add(mul(natural<F>(2), product_node), roles.product_high),
    )
    let rank = add(mul(current, current_rank), mul(product, product_rank))
    add(
        mul(rank, natural<F>(L.downcast_truncate())),
        control.minor,
    )
}

fn sparse_product_carry_address<F: Radix2Field, const L: usize>(
    _ product: F,
    _ coefficient: F,
) -> F {
    let limbs = natural<F>(L.downcast_truncate())
    add(
        add(mul(natural<F>(8), limbs), mul(mul(natural<F>(2), limbs), product)),
        coefficient,
    )
}

fn sparse_product_left_rank<F: Radix2Field>(_ product: F) -> F {
    mul(product, sub(natural<F>(2), product))
}

fn sparse_product_right_rank<F: Radix2Field>(_ product: F) -> F {
    mul(
        mul(product, sub(natural<F>(3), product)),
        natural<F>(2).radix2_inverse_or_zero(),
    )
}

fn sparse_product_term_left_index<F: Radix2Field, const L: usize>(
    _ control: SparseControlRow<F>,
) -> F {
    let limbs: u32 = L.downcast_truncate()
    add(
        control.step,
        mul(
            control.flag,
            sub(control.minor, natural<F>(limbs - 1)),
        ),
    )
}

fn sparse_product_copy_ports<F: Radix2Field, const L: usize>(
    _ control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
) -> (SparseCopyPort<F>, SparseCopyPort<F>) {
    let selectors = control.selectors
    let roles = control.range_roles
    let limbs = natural<F>(L.downcast_truncate())
    let current = sparse_product_current_coordinate(control)
    let product_range = add(roles.product_low, roles.product_high)
    let source_range_selector = mul(
        selectors.radix_limb,
        add(current, product_range),
    )
    let source_range_coefficient = mul(
        selectors.radix_limb,
        add(mul(current, mul(natural<F>(3), limbs)), product_range),
    )
    let carry_source_selector = selectors.carry_finish
    let source_selector = add(source_range_selector, carry_source_selector)
    let source_address = add(
        mul(source_range_selector, sparse_product_range_address<F, L>(control)),
        mul(
            carry_source_selector,
            sparse_product_carry_address<F, L>(control.major, control.minor),
        ),
    )

    let left_index = sparse_product_term_left_index<F, L>(control)
    let right_index = sub(control.minor, left_index)
    let term_left_address = add(
        mul(sparse_product_left_rank(control.major), limbs),
        left_index,
    )
    let term_right_address = add(
        mul(sparse_product_right_rank(control.major), limbs),
        right_index,
    )
    let coefficient_digit_rank = add(
        natural<F>(2),
        add(mul(natural<F>(2), control.major), control.flag),
    )
    let coefficient_digit_address = add(
        mul(coefficient_digit_rank, limbs),
        sub(control.minor, mul(control.flag, limbs)),
    )
    let coefficient_carry_address = sparse_product_carry_address<F, L>(
        control.major,
        control.minor,
    )

    let first_selector = add(
        source_selector,
        add(selectors.product_term, selectors.product_coefficient),
    )
    let first_address = add(
        source_address,
        add(
            mul(selectors.product_term, term_left_address),
            mul(selectors.product_coefficient, coefficient_digit_address),
        ),
    )
    let first_coefficient = sub(
        add(source_range_coefficient, carry_source_selector),
        add(selectors.product_term, selectors.product_coefficient),
    )
    let second_selector = add(
        selectors.product_term,
        selectors.product_coefficient,
    )
    let second_address = add(
        mul(selectors.product_term, term_right_address),
        mul(selectors.product_coefficient, coefficient_carry_address),
    )
    (
        SparseCopyPort {
            selector: first_selector,
            coefficient: first_coefficient,
            address: first_address,
            value: row.value,
        },
        SparseCopyPort {
            selector: second_selector,
            coefficient: sub(zero<F>(), second_selector),
            address: second_address,
            value: row.auxiliary,
        },
    )
}

fn sparse_copy_port_compressed<F: Radix2Field>(
    _ challenges: SparseCopyChallenges<F>,
    _ port: SparseCopyPort<F>,
) -> F {
    add(
        challenges.gamma,
        add(port.address, mul(challenges.beta, port.value)),
    )
}

fn absorb_sparse_copy_port<F: Radix2Field>(
    _ fold: own ConstraintFold<F>,
    _ challenges: SparseCopyChallenges<F>,
    _ port: SparseCopyPort<F>,
    _ inverse: F,
) -> ConstraintFold<F> {
    let fold = fold.absorb(mul(
        port.selector,
        sub(mul(sparse_copy_port_compressed(challenges, port), inverse), one<F>()),
    ))
    fold.absorb(mul(sub(one<F>(), port.selector), inverse))
}

fn write_sparse_copy_interaction_inverses<
    F: Radix2Field,
    const PORTS: usize,
>(
    _ challenges: SparseCopyChallenges<F>,
    _ ports: ref [SparseCopyPort<F>; PORTS],
    _ inverses: mut [F; PORTS],
) {
    let mut denominators = [zero<F>(); PORTS]
    let mut index: usize = 0
    while index < PORTS {
        if !ports[index].selector.radix2_is_zero() {
            denominators[index] = sparse_copy_port_compressed(
                challenges, ports[index],
            )
        }
        index = index + 1
    }
    write_batch_inverse_or_zero<F, PORTS>(
        ref denominators, mut inverses,
    )
}

fn sparse_copy_interaction_inverses<
    F: Radix2Field,
    const PORTS: usize,
>(
    _ challenges: SparseCopyChallenges<F>,
    _ ports: [SparseCopyPort<F>; PORTS],
) -> [F; PORTS] {
    let mut inverses = [zero<F>(); PORTS]
    write_sparse_copy_interaction_inverses<F, PORTS>(
        challenges, ref ports, mut inverses,
    )
    inverses
}

fn sparse_copy_interaction_delta<F: Radix2Field, const PORTS: usize>(
    _ ports: [SparseCopyPort<F>; PORTS],
    _ inverses: [F; PORTS],
) -> F {
    let mut delta = zero<F>()
    let mut index: usize = 0
    while index < PORTS {
        delta = add(delta, mul(ports[index].coefficient, inverses[index]))
        index = index + 1
    }
    delta
}

fn absorb_sparse_copy_interaction<F: Radix2Field, const PORTS: usize>(
    _ fold: own ConstraintFold<F>,
    _ challenges: SparseCopyChallenges<F>,
    _ ports: [SparseCopyPort<F>; PORTS],
    _ inverses: [F; PORTS],
) -> ConstraintFold<F> {
    let mut fold = fold
    let mut index: usize = 0
    while index < PORTS {
        fold = absorb_sparse_copy_port(
            fold, challenges, ports[index], inverses[index],
        )
        index = index + 1
    }
    fold
}

fn write_sparse_product_interaction_ports<
    F: Radix2Field,
    const L: usize,
>(
    _ control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ output: mut [SparseCopyPort<F>; 2],
) {
    let ports = sparse_product_copy_ports<F, L>(control, row)
    output = [ports.0, ports.1]
}

/// Derive one product interaction witness row from the committed base row and
/// the current prefix accumulator. This is the prover interpretation of the
/// same two ports constrained below.
pub fn sparse_product_interaction_row<F: Radix2Field, const L: usize>(
    _ challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ accumulator: F,
) -> SparseProductInteractionRow<F> {
    let mut ports = [zero_sparse_copy_port<F>(); 2]
    write_sparse_product_interaction_ports<F, L>(control, row, mut ports)
    SparseCopyInteractionRow {
        accumulator: accumulator,
        inverses: sparse_copy_interaction_inverses<F, 2>(challenges, ports),
    }
}

/// Target-friendly placement of the product interaction witness into storage
/// owned by the caller. This is denotationally identical to
/// `sparse_product_interaction_row`, while bounded scalar and GPU interpreters
/// can reuse one row slot instead of returning an array-backed aggregate on
/// every trace row.
pub fn write_sparse_product_interaction_row<
    F: Radix2Field,
    const L: usize,
>(
    _ challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ accumulator: F,
    _ interaction: mut SparseProductInteractionRow<F>,
) {
    let mut ports = [zero_sparse_copy_port<F>(); 2]
    write_sparse_product_interaction_ports<F, L>(control, row, mut ports)
    interaction.accumulator = accumulator
    write_sparse_copy_interaction_inverses<F, 2>(
        challenges, ref ports, mut interaction.inverses,
    )
}

pub fn evaluate_sparse_product_interaction_row<
    F: Radix2Field,
    const L: usize,
>(
    _ challenge: F,
    _ challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ interaction: SparseProductInteractionRow<F>,
) -> SparseInteractionEvaluation<F> {
    let mut ports = [zero_sparse_copy_port<F>(); 2]
    write_sparse_product_interaction_ports<F, L>(control, row, mut ports)
    let fold = absorb_sparse_copy_interaction<F, 2>(
        ConstraintFold<F>::new(challenge),
        challenges,
        ports,
        interaction.inverses,
    )
    SparseInteractionEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
        delta: sparse_copy_interaction_delta<F, 2>(ports, interaction.inverses),
    }
}

pub fn evaluate_sparse_product_interaction_initial<F: Radix2Field>(
    _ challenge: F,
    _ interaction: SparseProductInteractionRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = ConstraintFold<F>::new(challenge).absorb(interaction.accumulator)
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn evaluate_sparse_product_interaction_link<
    F: Radix2Field,
    const L: usize,
>(
    _ challenge: F,
    _ current_control: SparseControlRow<F>,
    _ current: SparseTaskRow<F>,
    _ current_interaction: SparseProductInteractionRow<F>,
    _ next_interaction: SparseProductInteractionRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let mut ports = [zero_sparse_copy_port<F>(); 2]
    write_sparse_product_interaction_ports<F, L>(
        current_control, current, mut ports,
    )
    let delta = sparse_copy_interaction_delta<F, 2>(
        ports, current_interaction.inverses,
    )
    let fold = ConstraintFold<F>::new(challenge).absorb(sub(
        next_interaction.accumulator,
        add(current_interaction.accumulator, delta),
    ))
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn evaluate_sparse_product_interaction_terminal<
    F: Radix2Field,
    const L: usize,
>(
    _ challenge: F,
    _ control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ interaction: SparseProductInteractionRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let mut ports = [zero_sparse_copy_port<F>(); 2]
    write_sparse_product_interaction_ports<F, L>(control, row, mut ports)
    let delta = sparse_copy_interaction_delta<F, 2>(
        ports, interaction.inverses,
    )
    let fold = ConstraintFold<F>::new(challenge).absorb(add(
        interaction.accumulator,
        delta,
    ))
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

fn sparse_round_range_rank<F: Radix2Field>(
    _ control: SparseControlRow<F>,
) -> F {
    let roles = control.range_roles
    let current = sparse_product_current_coordinate(control)
    let product = add(
        add(roles.product_low, roles.product_high),
        roles.product_output,
    )
    add(
        mul(current, sub(control.major, natural<F>(2))),
        mul(product, sub(control.major, natural<F>(4))),
    )
}

fn sparse_round_digit_address<F: Radix2Field, const L: usize>(
    _ rank: F,
    _ limb: F,
) -> F {
    add(mul(rank, natural<F>(L.downcast_truncate())), limb)
}

fn sparse_round_bit_address<F: Radix2Field, const L: usize>(
    _ rank: F,
    _ limb: F,
    _ bit: F,
) -> F {
    let limbs: u32 = L.downcast_truncate()
    add(
        natural<F>(11 * limbs),
        add(
            mul(rank, natural<F>(limbs * 13)),
            add(mul(limb, natural<F>(13)), bit),
        ),
    )
}

fn sparse_round_sign_address<F: Radix2Field, const L: usize>(
    _ rank: F,
) -> F {
    let limbs: u32 = L.downcast_truncate()
    add(natural<F>(11 * limbs + 11 * limbs * 13), rank)
}

fn sparse_round_nonzero_address<F: Radix2Field, const L: usize>(
    _ rank: F,
) -> F {
    add(sparse_round_sign_address<F, L>(rank), natural<F>(11))
}

fn write_sparse_round_interaction_ports<F: Radix2Field, const L: usize>(
    _ control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ output: mut [SparseCopyPort<F>; 5],
)
where L > 1,
{
    let selectors = control.selectors
    let roles = control.range_roles
    let positions = control.limb_positions
    let next_selectors = next_control.selectors
    let one = one<F>()
    let zero = zero<F>()
    let limbs: u32 = L.downcast_truncate()
    let limb_count = natural<F>(limbs)
    let range_rank = sparse_round_range_rank(control)
    let range_digit_address = sparse_round_digit_address<F, L>(
        range_rank, control.minor,
    )
    let range_bit_address = sparse_round_bit_address<F, L>(
        range_rank, control.minor, control.step,
    )

    let guard_source = mul(
        mul(
            mul(selectors.radix_bit, roles.product_low),
            positions.penultimate,
        ),
        next_selectors.radix_limb,
    )
    let low_retained_source = mul(
        mul(selectors.radix_limb, roles.product_low),
        positions.last,
    )
    let high_retained_source = mul(
        mul(selectors.radix_limb, roles.product_high),
        next_selectors.radix_bit,
    )
    let retained_source = add(low_retained_source, high_retained_source)
    let first_source = add(guard_source, retained_source)

    let output_digit_source = mul(
        selectors.radix_limb, roles.product_output,
    )
    let output_finish_source = mul(
        selectors.radix_finish, roles.product_output,
    )
    let current_sign_source = mul(
        selectors.radix_finish,
        sparse_product_current_coordinate(control),
    )

    let round_consumer = selectors.product_round
    let finish_consumer = selectors.product_finish
    let product_low_rank = add(
        natural<F>(2), mul(natural<F>(3), control.major),
    )
    let product_output_rank = add(product_low_rank, natural<F>(2))
    let retained_limb = add(
        sub(limb_count, one), control.minor,
    )
    let retained_address = sparse_round_digit_address<F, L>(
        product_low_rank, retained_limb,
    )
    let output_digit_address = sparse_round_digit_address<F, L>(
        product_output_rank, control.minor,
    )
    let guard_address = sparse_round_bit_address<F, L>(
        product_low_rank,
        natural<F>(limbs - 2),
        natural<F>(12),
    )
    let output_sign_address = sparse_round_sign_address<F, L>(
        product_output_rank,
    )
    let output_nonzero_address = sparse_round_nonzero_address<F, L>(
        product_output_rank,
    )
    let left_sign_address = sparse_round_sign_address<F, L>(
        sparse_product_left_rank(control.major),
    )
    let right_sign_address = sparse_round_sign_address<F, L>(
        sparse_product_right_rank(control.major),
    )

    let first_consumers = add(round_consumer, finish_consumer)
    let first_port = SparseCopyPort {
        selector: add(first_source, first_consumers),
        coefficient: sub(first_source, first_consumers),
        address: add(
            add(
                mul(guard_source, range_bit_address),
                mul(retained_source, range_digit_address),
            ),
            add(
                mul(round_consumer, retained_address),
                mul(finish_consumer, guard_address),
            ),
        ),
        value: add(
            mul(add(first_source, round_consumer), row.value),
            mul(finish_consumer, row.state_before),
        ),
    }

    let second_sources = add(output_digit_source, output_finish_source)
    let second_consumers = add(round_consumer, finish_consumer)
    let second_port = SparseCopyPort {
        selector: add(second_sources, second_consumers),
        coefficient: sub(second_sources, second_consumers),
        address: add(
            add(
                mul(output_digit_source, range_digit_address),
                mul(
                    output_finish_source,
                    sparse_round_sign_address<F, L>(range_rank),
                ),
            ),
            add(
                mul(round_consumer, output_digit_address),
                mul(finish_consumer, output_sign_address),
            ),
        ),
        value: add(
            add(
                mul(output_digit_source, row.value),
                mul(output_finish_source, row.auxiliary),
            ),
            add(
                mul(round_consumer, row.auxiliary),
                mul(finish_consumer, row.value),
            ),
        ),
    }

    let third_port = SparseCopyPort {
        selector: add(output_finish_source, finish_consumer),
        coefficient: sub(output_finish_source, finish_consumer),
        address: add(
            mul(
                output_finish_source,
                sparse_round_nonzero_address<F, L>(range_rank),
            ),
            mul(finish_consumer, output_nonzero_address),
        ),
        value: add(
            mul(output_finish_source, row.value),
            mul(finish_consumer, row.auxiliary),
        ),
    }

    let fourth_port = SparseCopyPort {
        selector: add(current_sign_source, finish_consumer),
        coefficient: sub(
            mul(natural<F>(3), current_sign_source),
            finish_consumer,
        ),
        address: add(
            mul(
                current_sign_source,
                sparse_round_sign_address<F, L>(range_rank),
            ),
            mul(finish_consumer, left_sign_address),
        ),
        value: add(
            mul(current_sign_source, row.auxiliary),
            mul(finish_consumer, row.accumulator_after),
        ),
    }

    let fifth_port = SparseCopyPort {
        selector: finish_consumer,
        coefficient: sub(zero, finish_consumer),
        address: mul(finish_consumer, right_sign_address),
        value: mul(finish_consumer, row.state_after),
    }
    output = [first_port, second_port, third_port, fourth_port, fifth_port]
}

/// Derive the five-port rounding interaction witness from adjacent committed
/// control rows and the current committed arithmetic row.
pub fn sparse_round_interaction_row<F: Radix2Field, const L: usize>(
    _ challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ accumulator: F,
) -> SparseRoundInteractionRow<F>
where L > 1,
{
    let mut ports = [zero_sparse_copy_port<F>(); 5]
    write_sparse_round_interaction_ports<F, L>(
        control, next_control, row, mut ports,
    )
    SparseCopyInteractionRow {
        accumulator: accumulator,
        inverses: sparse_copy_interaction_inverses<F, 5>(challenges, ports),
    }
}

pub fn write_sparse_round_interaction_row<
    F: Radix2Field,
    const L: usize,
>(
    _ challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ accumulator: F,
    _ interaction: mut SparseRoundInteractionRow<F>,
)
where L > 1,
{
    let mut ports = [zero_sparse_copy_port<F>(); 5]
    write_sparse_round_interaction_ports<F, L>(
        control, next_control, row, mut ports,
    )
    interaction.accumulator = accumulator
    write_sparse_copy_interaction_inverses<F, 5>(
        challenges, ref ports, mut interaction.inverses,
    )
}

pub fn evaluate_sparse_round_interaction_row<
    F: Radix2Field,
    const L: usize,
>(
    _ challenge: F,
    _ challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ interaction: SparseRoundInteractionRow<F>,
) -> SparseInteractionEvaluation<F>
where L > 1,
{
    let mut ports = [zero_sparse_copy_port<F>(); 5]
    write_sparse_round_interaction_ports<F, L>(
        control, next_control, row, mut ports,
    )
    let fold = absorb_sparse_copy_interaction<F, 5>(
        ConstraintFold<F>::new(challenge),
        challenges,
        ports,
        interaction.inverses,
    )
    SparseInteractionEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
        delta: sparse_copy_interaction_delta<F, 5>(ports, interaction.inverses),
    }
}

pub fn evaluate_sparse_round_interaction_initial<F: Radix2Field>(
    _ challenge: F,
    _ interaction: SparseRoundInteractionRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = ConstraintFold<F>::new(challenge).absorb(interaction.accumulator)
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn evaluate_sparse_round_interaction_link<
    F: Radix2Field,
    const L: usize,
>(
    _ challenge: F,
    _ current_control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ current: SparseTaskRow<F>,
    _ current_interaction: SparseRoundInteractionRow<F>,
    _ next_interaction: SparseRoundInteractionRow<F>,
) -> FixedAirConstraintEvaluation<F>
where L > 1,
{
    let mut ports = [zero_sparse_copy_port<F>(); 5]
    write_sparse_round_interaction_ports<F, L>(
        current_control, next_control, current, mut ports,
    )
    let delta = sparse_copy_interaction_delta<F, 5>(
        ports, current_interaction.inverses,
    )
    let fold = ConstraintFold<F>::new(challenge).absorb(sub(
        next_interaction.accumulator,
        add(current_interaction.accumulator, delta),
    ))
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn evaluate_sparse_round_interaction_terminal<
    F: Radix2Field,
    const L: usize,
>(
    _ challenge: F,
    _ control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ interaction: SparseRoundInteractionRow<F>,
) -> FixedAirConstraintEvaluation<F>
where L > 1,
{
    let mut ports = [zero_sparse_copy_port<F>(); 5]
    write_sparse_round_interaction_ports<F, L>(
        control, next_control, row, mut ports,
    )
    let delta = sparse_copy_interaction_delta<F, 5>(
        ports, interaction.inverses,
    )
    let fold = ConstraintFold<F>::new(challenge).absorb(add(
        interaction.accumulator,
        delta,
    ))
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

fn sparse_linear_point_coordinate<F: Radix2Field>(
    _ control: SparseControlRow<F>,
) -> F {
    let major = control.major
    let roots = mul(
        mul(sub(major, natural<F>(2)), sub(major, natural<F>(3))),
        mul(sub(major, natural<F>(4)), sub(major, natural<F>(5))),
    )
    mul(
        control.range_roles.coordinate,
        mul(
            roots,
            mul(
                add(mul(natural<F>(4), major), one<F>()),
                natural<F>(120).radix2_inverse_or_zero(),
            ),
        ),
    )
}

fn sparse_linear_product_xy<F: Radix2Field>(
    _ control: SparseControlRow<F>,
) -> F {
    let product = mul(
        sub(control.major, natural<F>(8)),
        natural<F>(3).radix2_inverse_or_zero(),
    )
    mul(
        mul(product, sub(product, one<F>())),
        natural<F>(2).radix2_inverse_or_zero(),
    )
}

fn sparse_linear_even_node<F: Radix2Field>(_ node: F) -> F {
    let product = mul(
        mul(sub(node, one<F>()), sub(node, natural<F>(3))),
        sub(mul(natural<F>(2), node), one<F>()),
    )
    sub(
        zero<F>(),
        mul(product, natural<F>(3).radix2_inverse_or_zero()),
    )
}

fn sparse_linear_output_node<F: Radix2Field>(
    _ control: SparseControlRow<F>,
) -> F {
    mul(
        sub(control.major, natural<F>(18)),
        natural<F>(4).radix2_inverse_or_zero(),
    )
}

fn sparse_linear_left_range_rank<F: Radix2Field>(_ node: F) -> F {
    let even = sparse_linear_even_node(node)
    add(
        mul(even, add(natural<F>(8), mul(natural<F>(3), node))),
        mul(
            sub(one<F>(), even),
            add(natural<F>(14), mul(natural<F>(4), node)),
        ),
    )
}

fn sparse_linear_right_range_rank<F: Radix2Field>(_ node: F) -> F {
    let even = sparse_linear_even_node(node)
    add(
        mul(
            even,
            add(
                natural<F>(11),
                mul(
                    mul(natural<F>(3), node),
                    natural<F>(2).radix2_inverse_or_zero(),
                ),
            ),
        ),
        mul(
            sub(one<F>(), even),
            mul(
                sub(node, one<F>()),
                natural<F>(2).radix2_inverse_or_zero(),
            ),
        ),
    )
}

fn sparse_linear_digit_address<F: Radix2Field, const L: usize>(
    _ rank: F,
    _ limb: F,
) -> F {
    add(mul(rank, natural<F>(L.downcast_truncate())), limb)
}

fn sparse_linear_sign_address<F: Radix2Field, const L: usize>(
    _ rank: F,
) -> F {
    add(natural<F>(31 * L.downcast_truncate()), rank)
}

fn sparse_linear_nonzero_address<F: Radix2Field, const L: usize>(
    _ rank: F,
) -> F {
    add(
        natural<F>(31 * L.downcast_truncate() + 31),
        rank,
    )
}

fn sparse_linear_borrow_address<F: Radix2Field, const L: usize>(
    _ node: F,
    _ right: F,
) -> F {
    add(
        natural<F>(31 * L.downcast_truncate() + 62),
        add(mul(natural<F>(2), node), right),
    )
}

fn sparse_linear_same_address<F: Radix2Field, const L: usize>(
    _ node: F,
) -> F {
    add(natural<F>(31 * L.downcast_truncate() + 70), node)
}

fn sparse_linear_select_address<F: Radix2Field, const L: usize>(
    _ node: F,
) -> F {
    add(natural<F>(31 * L.downcast_truncate() + 74), node)
}

fn write_sparse_linear_interaction_ports<
    F: Radix2Field,
    const L: usize,
>(
    _ control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ output: mut [SparseCopyPort<F>; 8],
)
where L > 1,
{
    let selectors = control.selectors
    let roles = control.range_roles
    let linear_roles = control.linear_roles
    let next_linear_roles = next_control.linear_roles
    let zero = zero<F>()
    let one = one<F>()
    let limb_count = natural<F>(L.downcast_truncate())

    let point = sparse_linear_point_coordinate(control)
    let product = roles.product_output
    let product_xy = sparse_linear_product_xy(control)
    let intermediate = add(
        add(roles.linear_sum, roles.linear_left_difference),
        roles.linear_right_difference,
    )
    let output_role = roles.linear_output
    let output_even = sparse_linear_even_node(
        sparse_linear_output_node(control),
    )
    let digit_source_kind = add(
        add(point, product), add(intermediate, output_role),
    )
    let digit_source = mul(selectors.radix_limb, digit_source_kind)
    let digit_source_coefficient = mul(
        selectors.radix_limb,
        add(
            add(
                mul(natural<F>(3), point),
                mul(
                    natural<F>(3),
                    mul(product, add(one, product_xy)),
                ),
            ),
            add(
                mul(natural<F>(2), intermediate),
                mul(output_role, add(one, mul(natural<F>(3), output_even))),
            ),
        ),
    )
    let sign_source_kind = add(add(point, product), output_role)
    let sign_source = mul(selectors.radix_finish, sign_source_kind)
    let sign_source_coefficient = mul(
        selectors.radix_finish,
        add(
            point,
            add(
                mul(product, add(one, product_xy)),
                mul(output_role, add(one, output_even)),
            ),
        ),
    )
    let nonzero_source = mul(selectors.radix_finish, output_role)

    let left_borrow_source = mul(
        mul(selectors.linear_limb, linear_roles.left_difference),
        next_linear_roles.right_difference,
    )
    let right_borrow_source = mul(
        mul(selectors.linear_limb, linear_roles.right_difference),
        next_linear_roles.select,
    )

    let limb_nonselect = mul(
        selectors.linear_limb,
        add(
            add(linear_roles.sum, linear_roles.left_difference),
            linear_roles.right_difference,
        ),
    )
    let limb_select = mul(selectors.linear_limb, linear_roles.select)
    let finish = selectors.linear_finish
    let node = control.major
    let left_rank = sparse_linear_left_range_rank(node)
    let right_rank = sparse_linear_right_range_rank(node)
    let sum_rank = add(natural<F>(15), mul(natural<F>(4), node))
    let left_difference_rank = add(sum_rank, one)
    let right_difference_rank = add(sum_rank, natural<F>(2))
    let output_rank = add(sum_rank, natural<F>(3))
    let nonselect_rank = add(
        sum_rank,
        add(linear_roles.left_difference, mul(natural<F>(2), linear_roles.right_difference)),
    )

    let source_digit_address = sparse_linear_digit_address<F, L>(
        control.major, control.minor,
    )
    let first_port = SparseCopyPort {
        selector: add(
            digit_source,
            add(add(limb_nonselect, limb_select), finish),
        ),
        coefficient: sub(
            digit_source_coefficient,
            add(add(limb_nonselect, limb_select), finish),
        ),
        address: add(
            mul(digit_source, source_digit_address),
            add(
                mul(
                    limb_nonselect,
                    sparse_linear_digit_address<F, L>(left_rank, control.step),
                ),
                add(
                    mul(
                        limb_select,
                        sparse_linear_digit_address<F, L>(sum_rank, control.step),
                    ),
                    mul(finish, sparse_linear_sign_address<F, L>(left_rank)),
                ),
            ),
        ),
        value: row.value,
    }

    let second_port = SparseCopyPort {
        selector: add(
            sign_source,
            add(add(limb_nonselect, limb_select), finish),
        ),
        coefficient: sub(
            sign_source_coefficient,
            add(add(limb_nonselect, limb_select), finish),
        ),
        address: add(
            mul(
                sign_source,
                sparse_linear_sign_address<F, L>(control.major),
            ),
            add(
                mul(
                    limb_nonselect,
                    sparse_linear_digit_address<F, L>(right_rank, control.step),
                ),
                add(
                    mul(
                        limb_select,
                        sparse_linear_digit_address<F, L>(
                            left_difference_rank, control.step,
                        ),
                    ),
                    mul(finish, sparse_linear_sign_address<F, L>(right_rank)),
                ),
            ),
        ),
        value: row.auxiliary,
    }

    let third_consumers = add(add(limb_nonselect, limb_select), finish)
    let third_port = SparseCopyPort {
        selector: add(nonzero_source, third_consumers),
        coefficient: sub(nonzero_source, third_consumers),
        address: add(
            mul(
                nonzero_source,
                sparse_linear_nonzero_address<F, L>(control.major),
            ),
            add(
                mul(
                    limb_nonselect,
                    sparse_linear_digit_address<F, L>(
                        nonselect_rank, control.step,
                    ),
                ),
                add(
                    mul(
                        limb_select,
                        sparse_linear_digit_address<F, L>(
                            right_difference_rank, control.step,
                        ),
                    ),
                    mul(
                        finish,
                        sparse_linear_borrow_address<F, L>(node, zero),
                    ),
                ),
            ),
        ),
        value: add(
            mul(nonzero_source, row.value),
            add(
                mul(limb_nonselect, row.state_before),
                mul(add(limb_select, finish), row.accumulator_before),
            ),
        ),
    }

    let fourth_consumers = add(limb_select, finish)
    let fourth_port = SparseCopyPort {
        selector: add(left_borrow_source, fourth_consumers),
        coefficient: sub(left_borrow_source, fourth_consumers),
        address: add(
            mul(
                left_borrow_source,
                sparse_linear_borrow_address<F, L>(node, zero),
            ),
            add(
                mul(
                    limb_select,
                    sparse_linear_digit_address<F, L>(output_rank, control.step),
                ),
                mul(
                    finish,
                    sparse_linear_borrow_address<F, L>(node, one),
                ),
            ),
        ),
        value: row.accumulator_after,
    }

    let fifth_consumers = add(limb_select, finish)
    let fifth_port = SparseCopyPort {
        selector: add(right_borrow_source, fifth_consumers),
        coefficient: sub(right_borrow_source, fifth_consumers),
        address: add(
            mul(
                right_borrow_source,
                sparse_linear_borrow_address<F, L>(node, one),
            ),
            add(
                mul(
                    limb_select,
                    sparse_linear_same_address<F, L>(node),
                ),
                mul(
                    finish,
                    sparse_linear_nonzero_address<F, L>(output_rank),
                ),
            ),
        ),
        value: add(
            mul(right_borrow_source, row.accumulator_after),
            mul(fifth_consumers, row.state_before),
        ),
    }

    let sixth_consumers = add(limb_select, finish)
    let sixth_port = SparseCopyPort {
        selector: sixth_consumers,
        coefficient: sub(zero, sixth_consumers),
        address: add(
            mul(
                limb_select,
                sparse_linear_select_address<F, L>(node),
            ),
            mul(
                finish,
                sparse_linear_sign_address<F, L>(output_rank),
            ),
        ),
        value: row.state_after,
    }

    let effective_right = sub(
        add(row.auxiliary, control.flag),
        mul(natural<F>(2), mul(row.auxiliary, control.flag)),
    )
    let different = sub(
        add(row.value, effective_right),
        mul(natural<F>(2), mul(row.value, effective_right)),
    )
    let same = sub(one, different)
    let seventh_port = SparseCopyPort {
        selector: finish,
        coefficient: mul(limb_count, finish),
        address: mul(finish, sparse_linear_same_address<F, L>(node)),
        value: mul(finish, same),
    }
    let eighth_port = SparseCopyPort {
        selector: finish,
        coefficient: mul(limb_count, finish),
        address: mul(finish, sparse_linear_select_address<F, L>(node)),
        value: mul(finish, row.accumulator_before),
    }
    output = [
        first_port,
        second_port,
        third_port,
        fourth_port,
        fifth_port,
        sixth_port,
        seventh_port,
        eighth_port,
    ]
}

pub fn sparse_linear_interaction_row<F: Radix2Field, const L: usize>(
    _ challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ accumulator: F,
) -> SparseLinearInteractionRow<F>
where L > 1,
{
    let mut ports = [zero_sparse_copy_port<F>(); 8]
    write_sparse_linear_interaction_ports<F, L>(
        control, next_control, row, mut ports,
    )
    SparseCopyInteractionRow {
        accumulator: accumulator,
        inverses: sparse_copy_interaction_inverses<F, 8>(challenges, ports),
    }
}

pub fn write_sparse_linear_interaction_row<
    F: Radix2Field,
    const L: usize,
>(
    _ challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ accumulator: F,
    _ interaction: mut SparseLinearInteractionRow<F>,
)
where L > 1,
{
    let mut ports = [zero_sparse_copy_port<F>(); 8]
    write_sparse_linear_interaction_ports<F, L>(
        control, next_control, row, mut ports,
    )
    interaction.accumulator = accumulator
    write_sparse_copy_interaction_inverses<F, 8>(
        challenges, ref ports, mut interaction.inverses,
    )
}

pub fn evaluate_sparse_linear_interaction_row<
    F: Radix2Field,
    const L: usize,
>(
    _ challenge: F,
    _ challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ interaction: SparseLinearInteractionRow<F>,
) -> SparseInteractionEvaluation<F>
where L > 1,
{
    let mut ports = [zero_sparse_copy_port<F>(); 8]
    write_sparse_linear_interaction_ports<F, L>(
        control, next_control, row, mut ports,
    )
    let fold = absorb_sparse_copy_interaction<F, 8>(
        ConstraintFold<F>::new(challenge),
        challenges,
        ports,
        interaction.inverses,
    )
    SparseInteractionEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
        delta: sparse_copy_interaction_delta<F, 8>(ports, interaction.inverses),
    }
}

pub fn evaluate_sparse_linear_interaction_initial<F: Radix2Field>(
    _ challenge: F,
    _ interaction: SparseLinearInteractionRow<F>,
) -> FixedAirConstraintEvaluation<F> {
    let fold = ConstraintFold<F>::new(challenge).absorb(interaction.accumulator)
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn evaluate_sparse_linear_interaction_link<
    F: Radix2Field,
    const L: usize,
>(
    _ challenge: F,
    _ current_control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ current: SparseTaskRow<F>,
    _ current_interaction: SparseLinearInteractionRow<F>,
    _ next_interaction: SparseLinearInteractionRow<F>,
) -> FixedAirConstraintEvaluation<F>
where L > 1,
{
    let mut ports = [zero_sparse_copy_port<F>(); 8]
    write_sparse_linear_interaction_ports<F, L>(
        current_control, next_control, current, mut ports,
    )
    let delta = sparse_copy_interaction_delta<F, 8>(
        ports, current_interaction.inverses,
    )
    let fold = ConstraintFold<F>::new(challenge).absorb(sub(
        next_interaction.accumulator,
        add(current_interaction.accumulator, delta),
    ))
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

pub fn evaluate_sparse_linear_interaction_terminal<
    F: Radix2Field,
    const L: usize,
>(
    _ challenge: F,
    _ control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ interaction: SparseLinearInteractionRow<F>,
) -> FixedAirConstraintEvaluation<F>
where L > 1,
{
    let mut ports = [zero_sparse_copy_port<F>(); 8]
    write_sparse_linear_interaction_ports<F, L>(
        control, next_control, row, mut ports,
    )
    let delta = sparse_copy_interaction_delta<F, 8>(
        ports, interaction.inverses,
    )
    let fold = ConstraintFold<F>::new(challenge).absorb(add(
        interaction.accumulator,
        delta,
    ))
    FixedAirConstraintEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
    }
}

fn sparse_boundary_next_coordinate<F: Radix2Field>(
    _ control: SparseControlRow<F>,
) -> F {
    let major = control.major
    let roots = mul(
        mul(major, sub(major, one<F>())),
        mul(sub(major, natural<F>(2)), sub(major, natural<F>(3))),
    )
    mul(
        control.range_roles.coordinate,
        mul(
            roots,
            mul(
                sub(natural<F>(21), mul(natural<F>(4), major)),
                natural<F>(120).radix2_inverse_or_zero(),
            ),
        ),
    )
}

fn write_sparse_boundary_interaction_ports<
    F: Radix2Field,
    const L: usize,
>(
    _ control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ output: mut [SparseCopyPort<F>; 2],
) {
    let selectors = control.selectors
    let roles = control.range_roles
    let computed = mul(
        roles.linear_output,
        sub(
            one<F>(),
            sparse_linear_even_node(sparse_linear_output_node(control)),
        ),
    )
    let claimed = sparse_boundary_next_coordinate(control)
    let source_kind = add(computed, claimed)
    let digit_source = mul(selectors.radix_limb, source_kind)
    let sign_source = mul(selectors.radix_finish, source_kind)
    let limb_consumer = selectors.boundary_limb
    let sign_consumer = selectors.boundary_sign
    let consumers = add(limb_consumer, sign_consumer)
    let computed_rank = add(
        natural<F>(22), mul(natural<F>(8), control.major),
    )
    let claimed_rank = add(natural<F>(4), control.major)
    let first_port = SparseCopyPort {
        selector: add(add(digit_source, sign_source), consumers),
        coefficient: sub(add(digit_source, sign_source), consumers),
        address: add(
            add(
                mul(
                    digit_source,
                    sparse_linear_digit_address<F, L>(
                        control.major, control.minor,
                    ),
                ),
                mul(
                    sign_source,
                    sparse_linear_sign_address<F, L>(control.major),
                ),
            ),
            add(
                mul(
                    limb_consumer,
                    sparse_linear_digit_address<F, L>(
                        computed_rank, control.minor,
                    ),
                ),
                mul(
                    sign_consumer,
                    sparse_linear_sign_address<F, L>(computed_rank),
                ),
            ),
        ),
        value: add(
            mul(sign_source, row.auxiliary),
            mul(add(digit_source, consumers), row.value),
        ),
    }
    let second_port = SparseCopyPort {
        selector: consumers,
        coefficient: sub(zero<F>(), consumers),
        address: add(
            mul(
                limb_consumer,
                sparse_linear_digit_address<F, L>(
                    claimed_rank, control.minor,
                ),
            ),
            mul(
                sign_consumer,
                sparse_linear_sign_address<F, L>(claimed_rank),
            ),
        ),
        value: mul(consumers, row.auxiliary),
    }
    output = [first_port, second_port]
}

pub fn sparse_boundary_interaction_row<F: Radix2Field, const L: usize>(
    _ challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ accumulator: F,
) -> SparseBoundaryInteractionRow<F> {
    let mut ports = [zero_sparse_copy_port<F>(); 2]
    write_sparse_boundary_interaction_ports<F, L>(control, row, mut ports)
    SparseCopyInteractionRow {
        accumulator: accumulator,
        inverses: sparse_copy_interaction_inverses<F, 2>(challenges, ports),
    }
}

pub fn write_sparse_boundary_interaction_row<
    F: Radix2Field,
    const L: usize,
>(
    _ challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ accumulator: F,
    _ interaction: mut SparseBoundaryInteractionRow<F>,
) {
    let mut ports = [zero_sparse_copy_port<F>(); 2]
    write_sparse_boundary_interaction_ports<F, L>(control, row, mut ports)
    interaction.accumulator = accumulator
    write_sparse_copy_interaction_inverses<F, 2>(
        challenges, ref ports, mut interaction.inverses,
    )
}

pub fn evaluate_sparse_boundary_interaction_row<
    F: Radix2Field,
    const L: usize,
>(
    _ challenge: F,
    _ challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ row: SparseTaskRow<F>,
    _ interaction: SparseBoundaryInteractionRow<F>,
) -> SparseInteractionEvaluation<F> {
    let mut ports = [zero_sparse_copy_port<F>(); 2]
    write_sparse_boundary_interaction_ports<F, L>(control, row, mut ports)
    let fold = absorb_sparse_copy_interaction<F, 2>(
        ConstraintFold<F>::new(challenge),
        challenges,
        ports,
        interaction.inverses,
    )
    SparseInteractionEvaluation {
        valid: true,
        constraints: fold.constraints,
        folded: fold.value,
        delta: sparse_copy_interaction_delta<F, 2>(ports, interaction.inverses),
    }
}

pub fn evaluate_sparse_boundary_interaction_initial<F: Radix2Field>(
    _ challenge: F,
    _ interaction: SparseBoundaryInteractionRow<F>,
