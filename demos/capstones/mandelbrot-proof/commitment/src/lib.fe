struct FriLayerFrontier<const ROUND: u32> { raw: RawFrontier }
impl<const ROUND: u32> core::marker::Copy for FriLayerFrontier<ROUND> {}
impl<const ROUND: u32> FriLayerFrontier<ROUND> {
    fn empty() -> Self {
        Self { raw: RawFrontier::empty() }
    }
    fn push(mut self, _ leaf: FriLayerDigest<ROUND>) -> Self {
        self.raw = push_merkle<MandelbrotFriLayerNode<ROUND>>(self.raw, leaf.value)
        self
    }
    fn complete_root(self) -> FriLayerDigest<ROUND> {
        FriLayerDigest { value: self.raw.complete_root() }
    }
}

fn invalid_streamed_commitment() -> StreamedCommitment {
    StreamedCommitment {
        valid: false,
        terminal_step: 0,
        trace_length: 0,
        padded_length: 0,
        trace: TraceDigest { value: Fr::zero() },
        auxiliary: AuxiliaryDigest { value: Fr::zero() },
        statement: StatementDigest { value: Fr::zero() },
        proof_transcript: ProofTranscriptDigest { value: Fr::zero() },
    }
}

/// Generate, encode, and commit the canonical proof trace in one Fe pass.
/// Active rows are never retained after entering the Merkle frontier. Once
/// the least terminal row is found, its AIR values are reused for the uniquely
/// defined inactive suffix up to the next power-of-two domain.
pub fn stream_statement_q12(_ c_re_q12: i32, _ c_im_q12: i32, _ bound: u32) -> StreamedCommitment {
    let claim = EscapesByQ12::new(c_re_q12, c_im_q12, bound)
    let mut stream = EscapeTraceStream::new(claim)
    if !stream.is_valid() {
        return invalid_streamed_commitment()
    }

    let mut frontier = TraceFrontier::empty()
    let mut auxiliary = AuxiliaryFrontier::empty()
    while true {
        let row = stream.current_proof_row()
        let encoded = encode_proof_row(row)
        frontier = frontier.push(row_commitment(encoded))
        auxiliary = auxiliary.push(auxiliary_row_commitment(encoded))
        if row.terminal { break }
        if !stream.can_advance() {
            return invalid_streamed_commitment()
        }
        stream = stream.advance()
    }

    let terminal_air = stream.current_air_row()
    let terminal_step = terminal_air.semantic.step
    let trace_length = terminal_step + 1
    let padded_length = padded_trace_length(trace_length)
    let padding = PaddedEscapeAirRow {
        valid: true,
        active: false,
        terminal: false,
        air: terminal_air,
    }
    while frontier.count() < padded_length {
        let encoded = encode_proof_row(padding)
        frontier = frontier.push(row_commitment(encoded))
        auxiliary = auxiliary.push(auxiliary_row_commitment(encoded))
    }

    let trace = frontier.complete_root()
    let auxiliary = auxiliary.complete_root()
    let public = EscapesByQ12Public {
        c_re: encode_signed_word(c_re_q12),
        c_im: encode_signed_word(c_im_q12),
        bound: bound,
        terminal_step: terminal_step,
        trace_length: trace_length,
        padded_length: padded_length,
    }
    let statement = bind_statement(public, trace)
    let proof_transcript = bind_auxiliary_trace(statement, auxiliary)
    StreamedCommitment {
        valid: true,
        terminal_step: terminal_step,
        trace_length: trace_length,
        padded_length: padded_length,
        trace: trace,
        auxiliary: auxiliary,
        statement: statement,
        proof_transcript: proof_transcript,
    }
}

/// Fold a compile-time-checked power-of-two row domain through an O(log N)
/// frontier. The production streamer below updates this same shape as it emits
/// rows, without retaining the Merkle tree or its leaves.
fn trace_root_power_of_two<const N: usize>(_ rows: own [EncodedProofRow; N]) -> TraceDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut frontier = TraceFrontier::empty()
    let mut row: usize = 0
    while row < N {
        frontier = frontier.push(row_commitment(rows[row]))
        row = row + 1
    }
    frontier.complete_root()
}

fn statement_commitment_power_of_two<const N: usize>(
    _ public: own EscapesByQ12Public,
    _ rows: own [EncodedProofRow; N],
) -> StatementDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    bind_statement(public, trace_root_power_of_two<N>(rows))
}

/// Four-row compatibility boundary, now routed through the general frontier.
pub fn trace_root4(_ rows: own [EncodedProofRow; 4]) -> TraceDigest {
    trace_root_power_of_two<4>(rows)
}

pub fn trace_root4_plain_words(_ rows: own [EncodedProofRow; 4]) -> [u32; 20] {
    plain_words(trace_root4(rows).value)
}

pub fn bind_statement(
    _ public: own EscapesByQ12Public,
    _ trace: own TraceDigest,
) -> StatementDigest {
    StatementDigest {
        value: bind_plain_words<MandelbrotTranscriptV1>(packed_public(public), trace.value),
    }
}

pub fn bind_auxiliary_trace(
    _ statement: own StatementDigest,
    _ auxiliary: own AuxiliaryDigest,
) -> ProofTranscriptDigest {
    ProofTranscriptDigest {
        value: compress<MandelbrotAuxiliaryTranscriptV1>(statement.value, auxiliary.value),
    }
}

fn field_row_commitment<D: PoseidonDomain, const N: usize>(_ values: ref [Fr; N]) -> Fr
where N > 0
{
    let mut digest = Fr::from_u32(N.downcast_truncate())
    let mut column: usize = 0
    while column < N {
        digest = compress<D>(digest, values[column])
        column = column + 1
    }
    digest
}

pub fn main_lde_row_commitment(_ values: ref [Fr; ROW_WORDS]) -> MainLdeDigest {
    MainLdeDigest { value: field_row_commitment<MandelbrotMainLdeRowV1, ROW_WORDS>(values) }
}

pub fn auxiliary_lde_row_commitment(
    _ values: ref [Fr; AUXILIARY_ROW_BITS],
) -> AuxiliaryLdeDigest {
    AuxiliaryLdeDigest {
        value: field_row_commitment<MandelbrotAuxiliaryLdeRowV1, AUXILIARY_ROW_BITS>(values),
    }
}

pub fn main_lde_root_power_of_two<const N: usize>(_ leaves: own [MainLdeDigest; N]) -> MainLdeDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut frontier = MainLdeFrontier::empty()
    let mut index: usize = 0
    while index < N {
        frontier = frontier.push(leaves[index])
        index = index + 1
    }
    frontier.complete_root()
}

pub fn auxiliary_lde_root_power_of_two<const N: usize>(
    _ leaves: own [AuxiliaryLdeDigest; N],
) -> AuxiliaryLdeDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut frontier = AuxiliaryLdeFrontier::empty()
    let mut index: usize = 0
    while index < N {
        frontier = frontier.push(leaves[index])
        index = index + 1
    }
    frontier.complete_root()
}

pub fn main_lde_quartet_path_power_of_two<const N: usize, const QUARTER: usize, const DEPTH: usize>(
    _ leaves: own [MainLdeDigest; N],
    _ index: u32,
) -> MainLdeQuartetPath<DEPTH>
where
    N > 3, N <= MAX_PADDED_TRACE_LENGTH, QUARTER > 0, { QUARTER + QUARTER + QUARTER + QUARTER == N }
{
    let mut raw_leaves = [Fr::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        raw_leaves[cursor] = leaves[cursor].value
        cursor = cursor + 1
    }
    let raw = quartet_path_from_leaves<MandelbrotMainLdeNodeV1, N, QUARTER, DEPTH>(
        raw_leaves,
        index,
    )
    MainLdeQuartetPath {
        valid: raw.valid,
        index: raw.index,
        first_siblings: raw.first_siblings,
        second_siblings: raw.second_siblings,
        third_siblings: raw.third_siblings,
        fourth_siblings: raw.fourth_siblings,
    }
}

pub fn auxiliary_lde_quartet_path_power_of_two<
    const N: usize,
    const QUARTER: usize,
    const DEPTH: usize,
>(_ leaves: own [AuxiliaryLdeDigest; N], _ index: u32) -> AuxiliaryLdeQuartetPath<DEPTH>
where
    N > 3, N <= MAX_PADDED_TRACE_LENGTH, QUARTER > 0, { QUARTER + QUARTER + QUARTER + QUARTER == N }
{
    let mut raw_leaves = [Fr::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        raw_leaves[cursor] = leaves[cursor].value
        cursor = cursor + 1
    }
    let raw = quartet_path_from_leaves<MandelbrotAuxiliaryLdeNodeV1, N, QUARTER, DEPTH>(
        raw_leaves,
        index,
    )
    AuxiliaryLdeQuartetPath {
        valid: raw.valid,
        index: raw.index,
        first_siblings: raw.first_siblings,
        second_siblings: raw.second_siblings,
        third_siblings: raw.third_siblings,
        fourth_siblings: raw.fourth_siblings,
    }
}

pub fn verify_main_lde_quartet_path<const DEPTH: usize>(
    _ first: MainLdeDigest,
    _ second: MainLdeDigest,
    _ third: MainLdeDigest,
    _ fourth: MainLdeDigest,
    _ path: own MainLdeQuartetPath<DEPTH>,
    _ root: MainLdeDigest,
) -> bool {
    let shared = MerkleQuartetPath {
        valid: path.valid,
        index: path.index,
        first_siblings: path.first_siblings,
        second_siblings: path.second_siblings,
        third_siblings: path.third_siblings,
        fourth_siblings: path.fourth_siblings,
    }
    quartet_verify<MandelbrotMainLdeNodeV1, DEPTH>(
        root.value,
        first.value,
        second.value,
        third.value,
        fourth.value,
        shared,
    )
}

pub fn verify_auxiliary_lde_quartet_path<const DEPTH: usize>(
    _ first: AuxiliaryLdeDigest,
    _ second: AuxiliaryLdeDigest,
    _ third: AuxiliaryLdeDigest,
    _ fourth: AuxiliaryLdeDigest,
    _ path: own AuxiliaryLdeQuartetPath<DEPTH>,
    _ root: AuxiliaryLdeDigest,
) -> bool {
    let shared = MerkleQuartetPath {
        valid: path.valid,
        index: path.index,
        first_siblings: path.first_siblings,
        second_siblings: path.second_siblings,
        third_siblings: path.third_siblings,
        fourth_siblings: path.fourth_siblings,
    }
    quartet_verify<MandelbrotAuxiliaryLdeNodeV1, DEPTH>(
        root.value,
        first.value,
        second.value,
        third.value,
        fourth.value,
        shared,
    )
}

pub fn bind_main_lde(
    _ transcript: ProofTranscriptDigest,
    _ main: MainLdeDigest,
) -> MainLdeTranscriptDigest {
    MainLdeTranscriptDigest {
        value: compress<MandelbrotMainLdeTranscriptV1>(transcript.value, main.value),
    }
}

pub fn bind_auxiliary_lde(
    _ transcript: MainLdeTranscriptDigest,
    _ auxiliary: AuxiliaryLdeDigest,
) -> AirLdeTranscriptDigest {
    AirLdeTranscriptDigest {
        value: compress<MandelbrotAuxiliaryLdeTranscriptV1>(transcript.value, auxiliary.value),
    }
}

pub fn composition_challenge(_ transcript: own AirLdeTranscriptDigest) -> CompositionChallenge {
    CompositionChallenge { value: compress<MandelbrotCompositionV1>(transcript.value, Fr::zero()) }
}

pub fn composition_row_commitment(_ value: Fr) -> CompositionDigest {
    CompositionDigest { value: compress<MandelbrotCompositionRowV1>(value, Fr::zero()) }
}

pub fn composition_root_power_of_two<const N: usize>(
    _ evaluations: own [Fr; N],
) -> CompositionDigest
where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut frontier = CompositionFrontier::empty()
    let mut index: usize = 0
    while index < N {
        frontier = frontier.push(composition_row_commitment(evaluations[index]))
        index = index + 1
    }
    frontier.complete_root()
}

pub fn composition_pair_path_power_of_two<const N: usize, const HALF: usize, const DEPTH: usize>(
    _ evaluations: own [Fr; N],
    _ index: u32,
) -> CompositionPairPath<DEPTH>
where N > 1, N <= MAX_PADDED_TRACE_LENGTH, HALF > 0, { HALF + HALF == N }
{
    let mut leaves = [Fr::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        leaves[cursor] = composition_row_commitment(evaluations[cursor]).value
        cursor = cursor + 1
    }
    let raw = pair_path_from_leaves<MandelbrotCompositionNodeV1, N, HALF, DEPTH>(leaves, index)
    CompositionPairPath {
        valid: raw.valid,
        index: raw.index,
        positive_siblings: raw.positive_siblings,
        negative_siblings: raw.negative_siblings,
    }
}

pub fn verify_composition_pair_path<const DEPTH: usize>(
    _ positive: Fr,
    _ negative: Fr,
    _ path: own CompositionPairPath<DEPTH>,
    _ root: CompositionDigest,
) -> bool {
    if !path.valid {
        return false
    }
    let shared = MerklePairPath {
        valid: true,
        index: path.index,
        positive_siblings: path.positive_siblings,
        negative_siblings: path.negative_siblings,
    }
    pair_verify<MandelbrotCompositionNodeV1, DEPTH>(
        root.value,
        composition_row_commitment(positive).value,
        composition_row_commitment(negative).value,
        shared,
    )
}

pub fn bind_composition(
    _ transcript: AirLdeTranscriptDigest,
    _ composition: CompositionDigest,
) -> CompositionTranscriptDigest {
    CompositionTranscriptDigest {
        value: compress<MandelbrotCompositionTranscriptV1>(transcript.value, composition.value),
    }
}

pub fn fri_fold_challenge(_ transcript: CompositionTranscriptDigest) -> FriFoldChallenge<1> {
    FriFoldChallenge { value: compress<MandelbrotFriFold<1>>(transcript.value, Fr::zero()) }
}

pub fn fri_layer_row_commitment<const ROUND: u32>(_ value: Fr) -> FriLayerDigest<ROUND>
where { ROUND > 0 }, { ROUND < 100 }
{
    FriLayerDigest { value: compress<MandelbrotFriLayerRow<ROUND>>(value, Fr::zero()) }
}

pub fn fri_layer_root_power_of_two<const ROUND: u32, const N: usize>(
    _ evaluations: own [Fr; N],
) -> FriLayerDigest<ROUND>
where { ROUND > 0 }, { ROUND < 100 }, N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 }
{
    let mut frontier = FriLayerFrontier<ROUND>::empty()
    let mut index: usize = 0
    while index < N {
        frontier = frontier.push(fri_layer_row_commitment<ROUND>(evaluations[index]))
        index = index + 1
    }
    frontier.complete_root()
}

pub fn fri_layer_pair_path_power_of_two<
    const ROUND: u32,
    const N: usize,
    const HALF: usize,
    const DEPTH: usize,
>(_ evaluations: own [Fr; N], _ index: u32) -> FriLayerPairPath<ROUND, DEPTH>
where
    {
        ROUND > 0
    },
    {
        ROUND < 100
    },
    N > 1,
    N <= MAX_PADDED_TRACE_LENGTH,
    HALF > 0,
    {
        HALF + HALF == N
    }
{
    let mut leaves = [Fr::zero(); N]
    let mut cursor: usize = 0
    while cursor < N {
        leaves[cursor] = fri_layer_row_commitment<ROUND>(evaluations[cursor]).value
        cursor = cursor + 1
    }
    let raw = pair_path_from_leaves<MandelbrotFriLayerNode<ROUND>, N, HALF, DEPTH>(leaves, index)
    FriLayerPairPath {
        valid: raw.valid,
        index: raw.index,
        positive_siblings: raw.positive_siblings,
        negative_siblings: raw.negative_siblings,
    }
}

pub fn verify_fri_layer_pair_path<const ROUND: u32, const DEPTH: usize>(
    _ positive: Fr,
    _ negative: Fr,
    _ path: own FriLayerPairPath<ROUND, DEPTH>,
    _ root: FriLayerDigest<ROUND>,
) -> bool
where { ROUND > 0 }, { ROUND < 100 }
{
    if !path.valid {
        return false
    }
    let shared = MerklePairPath {
        valid: true,
        index: path.index,
        positive_siblings: path.positive_siblings,
        negative_siblings: path.negative_siblings,
    }
    pair_verify<MandelbrotFriLayerNode<ROUND>, DEPTH>(
        root.value,
        fri_layer_row_commitment<ROUND>(positive).value,
        fri_layer_row_commitment<ROUND>(negative).value,
        shared,
    )
}

pub fn fri_layer_pair_path_two<const ROUND: u32>(_ evaluations: own [Fr; 2]) -> FriLayerPairPath<
    ROUND,
    0,
>
where { ROUND > 0 }, { ROUND < 100 }
{
    let raw = pair_path_two(0)
    FriLayerPairPath {
        valid: raw.valid,
        index: raw.index,
        positive_siblings: raw.positive_siblings,
        negative_siblings: raw.negative_siblings,
    }
}

pub fn verify_fri_layer_pair_path_two<const ROUND: u32>(
    _ positive: Fr,
    _ negative: Fr,
    _ path: own FriLayerPairPath<ROUND, 0>,
    _ root: FriLayerDigest<ROUND>,
) -> bool
where { ROUND > 0 }, { ROUND < 100 }
{
    let shared = MerklePairPath {
        valid: path.valid,
        index: path.index,
        positive_siblings: path.positive_siblings,
        negative_siblings: path.negative_siblings,
    }
    pair_verify_two<MandelbrotFriLayerNode<ROUND>>(
        root.value,
        fri_layer_row_commitment<ROUND>(positive).value,
        fri_layer_row_commitment<ROUND>(negative).value,
        shared,
    )
}

pub fn bind_fri_layer(
    _ transcript: CompositionTranscriptDigest,
    _ layer: FriLayerDigest<1>,
) -> FriLayerTranscriptDigest<1> {
    FriLayerTranscriptDigest {
        value: compress<MandelbrotFriLayerTranscript<1>>(transcript.value, layer.value),
    }
}

pub fn bind_next_fri_layer<const PREVIOUS: u32, const ROUND: u32>(
    _ transcript: FriLayerTranscriptDigest<PREVIOUS>,
    _ layer: FriLayerDigest<ROUND>,
) -> FriLayerTranscriptDigest<ROUND>
where { PREVIOUS > 0 }, { ROUND == PREVIOUS + 1 }, { ROUND < 100 }
{
    FriLayerTranscriptDigest {
        value: compress<MandelbrotFriLayerTranscript<ROUND>>(transcript.value, layer.value),
    }
}

pub fn fri_next_fold_challenge<const ROUND: u32, const NEXT: u32>(
    _ transcript: FriLayerTranscriptDigest<ROUND>,
) -> FriFoldChallenge<NEXT>
where { ROUND > 0 }, { NEXT == ROUND + 1 }, { NEXT < 100 }
{
    FriFoldChallenge { value: compress<MandelbrotFriFold<NEXT>>(transcript.value, Fr::zero()) }
}

pub fn fri_query_challenge<const ROUND: u32, const QUERY: u32>(
    _ transcript: FriLayerTranscriptDigest<ROUND>,
) -> FriQueryChallenge<QUERY>
where { ROUND > 0 }, { ROUND < 100 }, { QUERY > 0 }, { QUERY < 100 }
{
    FriQueryChallenge { value: compress<MandelbrotFriQuery<QUERY>>(transcript.value, Fr::zero()) }
}

pub fn statement_commitment4(
    _ public: own EscapesByQ12Public,
    _ rows: own [EncodedProofRow; 4],
) -> StatementDigest {
    statement_commitment_power_of_two<4>(public, rows)
}

pub fn statement_commitment4_plain_words(
    _ public: own EscapesByQ12Public,
    _ rows: own [EncodedProofRow; 4],
) -> [u32; 20] {
    plain_words(statement_commitment4(public, rows).value)
}

/// First domain-growth boundary: eight rows and three tree levels exercise the
/// same streaming frontier without another hand-authored tree shape.
pub fn trace_root8_plain_words(_ rows: own [EncodedProofRow; 8]) -> [u32; 20] {
    plain_words(trace_root_power_of_two<8>(rows).value)
}

pub fn statement_commitment8_plain_words(
    _ public: own EscapesByQ12Public,
    _ rows: own [EncodedProofRow; 8],
) -> [u32; 20] {
    plain_words(statement_commitment_power_of_two<8>(public, rows).value)
}

/// Scalar Wasm oracle boundary for the production one-pass Fe generator.
/// The 44 words are `(valid, terminal_step, trace_length, padded_length)`, the
/// 20 trace-root limbs, then the 20 public-statement limbs. Internally all
/// stages remain nominal, and no host-authored witness rows cross this API.
pub fn streamed_statement_q12_plain_words(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ bound: u32,
) -> [u32; 44] {
    let generated = stream_statement_q12(c_re_q12, c_im_q12, bound)
    let mut output: [u32; 44] = [0; 44]
    if !generated.valid {
        return output
    }

    output[0] = 1
    output[1] = generated.terminal_step
    output[2] = generated.trace_length
    output[3] = generated.padded_length
    let trace = plain_words(generated.trace.value)
    let statement = plain_words(generated.statement.value)
    let mut limb: usize = 0
    while limb < LIMBS {
        output[4 + limb] = trace[limb]
        output[24 + limb] = statement[limb]
        limb = limb + 1
    }
    output
}

/// Base-trace transcript boundary. The 64 words contain metadata, the main
/// base-row root, the auxiliary base-row root, and the digest binding both to
/// the public statement. The composition challenge is intentionally absent:
/// it is derived only after the field-valued LDE roots are committed.
pub fn streamed_base_proof_transcript_q12_plain_words(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ bound: u32,
) -> [u32; 64] {
    let generated = stream_statement_q12(c_re_q12, c_im_q12, bound)
    let mut output: [u32; 64] = [0; 64]
    if !generated.valid {
        return output
    }

    output[0] = 1
    output[1] = generated.terminal_step
    output[2] = generated.trace_length
    output[3] = generated.padded_length
    let trace = plain_words(generated.trace.value)
    let auxiliary = plain_words(generated.auxiliary.value)
    let transcript = plain_words(generated.proof_transcript.value)
    let mut limb: usize = 0
    while limb < LIMBS {
        output[4 + limb] = trace[limb]
        output[24 + limb] = auxiliary[limb]
        output[44 + limb] = transcript[limb]
        limb = limb + 1
    }
    output
}
