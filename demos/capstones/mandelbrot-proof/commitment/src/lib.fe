/// Main and auxiliary roots remain nominally distinct even though their
/// frontier storage shares one field-level implementation below.
pub struct TraceDigest { pub value: Fr }

impl core::marker::Copy for TraceDigest {}
derive CanonicalWords for TraceDigest using CanonicalWordsProvider

pub struct AuxiliaryDigest { pub value: Fr }

impl core::marker::Copy for AuxiliaryDigest {}
derive CanonicalWords for AuxiliaryDigest using CanonicalWordsProvider

/// The public statement and trace root are distinct nominal stages, so later
/// verifier code cannot accidentally treat an unbound tree root as a proof
/// statement commitment.
pub struct StatementDigest { pub value: Fr }

impl core::marker::Copy for StatementDigest {}

/// Public claim plus the ordered main and auxiliary trace commitments.
pub struct ProofTranscriptDigest { pub value: Fr }

impl core::marker::Copy for ProofTranscriptDigest {}

/// Commitments to the field-valued low-degree extensions. These are distinct
/// from the base-row roots above: the verifier opens these trees at the FRI
/// query positions instead of receiving the complete trace.
pub struct MainLdeDigest { pub value: Fr }
impl core::marker::Copy for MainLdeDigest {}
derive CanonicalWords for MainLdeDigest using CanonicalWordsProvider

pub struct AuxiliaryLdeDigest { pub value: Fr }
impl core::marker::Copy for AuxiliaryLdeDigest {}
derive CanonicalWords for AuxiliaryLdeDigest using CanonicalWordsProvider

pub struct MainLdeTranscriptDigest { pub value: Fr }
impl core::marker::Copy for MainLdeTranscriptDigest {}

pub struct AirLdeTranscriptDigest { pub value: Fr }
impl core::marker::Copy for AirLdeTranscriptDigest {}

pub struct CompositionChallenge { pub value: Fr }

impl core::marker::Copy for CompositionChallenge {}

pub struct CompositionDigest { pub value: Fr }
impl core::marker::Copy for CompositionDigest {}
derive CanonicalWords for CompositionDigest using CanonicalWordsProvider

pub struct CompositionTranscriptDigest { pub value: Fr }
impl core::marker::Copy for CompositionTranscriptDigest {}

pub struct FriFoldChallenge<const ROUND: u32> { pub value: Fr }
impl<const ROUND: u32> core::marker::Copy for FriFoldChallenge<ROUND> {}

pub struct FriLayerDigest<const ROUND: u32> { pub value: Fr }
impl<const ROUND: u32> core::marker::Copy for FriLayerDigest<ROUND> {}
impl<const ROUND: u32> CanonicalWords for FriLayerDigest<ROUND> {
    const WORDS: u32 = <Fr as CanonicalWords>::WORDS

    fn encode<W: canonical_words::WordSink>(self, _ writer: W) -> W {
        self.value.encode(writer)
    }

    fn decode<R: canonical_words::WordSource>(mut self, _ reader: R) -> R {
        self.value.decode(reader)
    }
}

pub struct FriLayerTranscriptDigest<const ROUND: u32> { pub value: Fr }
impl<const ROUND: u32> core::marker::Copy for FriLayerTranscriptDigest<ROUND> {}

pub struct FriQueryChallenge<const QUERY: u32> { pub value: Fr }
impl<const QUERY: u32> core::marker::Copy for FriQueryChallenge<QUERY> {}

/// Authentication paths for two leaves at local positions `index` and
/// `index + N / 2`. Each half is authenticated only to its half-root; the
/// verifier combines those roots once. This avoids carrying the two redundant
/// root-level siblings found in separate Merkle paths.
pub struct CompositionPairPath<const DEPTH: usize> {
    pub valid: bool,
    pub index: u32,
    pub positive_siblings: [Fr; DEPTH],
    pub negative_siblings: [Fr; DEPTH],
}
impl<const DEPTH: usize> core::marker::Copy for CompositionPairPath<DEPTH> {}
impl<const DEPTH: usize> CanonicalWords for CompositionPairPath<DEPTH> {
    const WORDS: u32 = <bool as CanonicalWords>::WORDS
        + <u32 as CanonicalWords>::WORDS
        + <[Fr; DEPTH] as CanonicalWords>::WORDS * 2

    fn encode<W: canonical_words::WordSink>(self, _ writer: W) -> W {
        let writer = self.valid.encode(writer)
        let writer = self.index.encode(writer)
        let writer = self.positive_siblings.encode(writer)
        self.negative_siblings.encode(writer)
    }

    fn decode<R: canonical_words::WordSource>(mut self, _ reader: R) -> R {
        let reader = self.valid.decode(reader)
        let reader = self.index.decode(reader)
        let reader = self.positive_siblings.decode(reader)
        self.negative_siblings.decode(reader)
    }
}

pub struct MainLdeQuartetPath<const DEPTH: usize> {
    pub valid: bool,
    pub index: u32,
    pub first_siblings: [Fr; DEPTH],
    pub second_siblings: [Fr; DEPTH],
    pub third_siblings: [Fr; DEPTH],
    pub fourth_siblings: [Fr; DEPTH],
}
impl<const DEPTH: usize> core::marker::Copy for MainLdeQuartetPath<DEPTH> {}
impl<const DEPTH: usize> CanonicalWords for MainLdeQuartetPath<DEPTH> {
    const WORDS: u32 = <bool as CanonicalWords>::WORDS
        + <u32 as CanonicalWords>::WORDS
        + <[Fr; DEPTH] as CanonicalWords>::WORDS * 4

    fn encode<W: canonical_words::WordSink>(self, _ writer: W) -> W {
        let writer = self.valid.encode(writer)
        let writer = self.index.encode(writer)
        let writer = self.first_siblings.encode(writer)
        let writer = self.second_siblings.encode(writer)
        let writer = self.third_siblings.encode(writer)
        self.fourth_siblings.encode(writer)
    }

    fn decode<R: canonical_words::WordSource>(mut self, _ reader: R) -> R {
        let reader = self.valid.decode(reader)
        let reader = self.index.decode(reader)
        let reader = self.first_siblings.decode(reader)
        let reader = self.second_siblings.decode(reader)
        let reader = self.third_siblings.decode(reader)
        self.fourth_siblings.decode(reader)
    }
}

