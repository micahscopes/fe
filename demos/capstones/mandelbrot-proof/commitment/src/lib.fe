//! Domain-separated Poseidon commitment to canonical bounded-Mandelbrot rows.

use mandelbrot_proof_kernel::{
    AUXILIARY_ROW_BITS,
    ENCODED_PROOF_ROW_WIDTHS,
    ESCAPES_BY_Q12_PUBLIC_WIDTHS,
    ESCAPES_BY_Q12_PUBLIC_WORDS,
    EncodedProofRow,
    EscapesByQ12Public,
    EscapesByQ12,
    EscapeTraceStream,
    MAX_PADDED_TRACE_LENGTH,
    PaddedEscapeAirRow,
    encode_proof_row,
    encode_signed_word,
    encoded_auxiliary_row_bit,
    encoded_proof_row_words,
    escapes_by_q12_public_words,
    padded_trace_length,
}
use poseidon_bn254::{
    Fr,
    LIMBS,
    WORD_BITS,
    PoseidonDomain,
    bind_plain_words,
    commit_plain_words,
    compress,
    plain_words,
}
use poseidon_merkle::{
    MerklePairPath,
    MerkleQuartetPath,
    pair_path_from_leaves,
    pair_path_two,
    pair_verify,
    pair_verify_two,
    quartet_path_from_leaves,
    quartet_verify,
}
use canonical_words::{CanonicalWords, CanonicalWordsProvider}

const ROW_WORDS: usize = 17
const PUBLIC_WORDS: usize = ESCAPES_BY_Q12_PUBLIC_WORDS
const TRACE_FRONTIER_LEVELS: usize = 22
const AUXILIARY_FIELD_BITS: u32 = 253
const AUXILIARY_FIELDS: usize = 2

/// Pack a four-byte ASCII protocol label without a numeric magic constant.
const fn protocol_tag(_ label: String<4>) -> u32 {
    let bytes = label.as_bytes()
    ((bytes[0] as u32) << 24)
        | ((bytes[1] as u32) << 16)
        | ((bytes[2] as u32) << 8)
        | (bytes[3] as u32)
}

/// Derive a two-letter, two-digit protocol domain such as `FR01` or `FC04`.
/// Public constructors constrain rounds to the representable `01..99` range.
const fn protocol_round_tag(_ prefix: String<2>, _ round: u32) -> u32 {
    let bytes = prefix.as_bytes()
    let tens = round / 10
    let ones = round - tens * 10
    ((bytes[0] as u32) << 24) | ((bytes[1] as u32) << 16) | ((48 + tens) << 8) | (48 + ones)
}

