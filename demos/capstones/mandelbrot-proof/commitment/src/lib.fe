//! Domain-separated Poseidon commitment to canonical bounded-Mandelbrot rows.

use mandelbrot_proof_kernel::{
    BitRangeWitness, ENCODED_PROOF_ROW_WIDTHS, EncodedProofRow, EscapesByQ12,
    EscapeTraceStream, PaddedEscapeAirRow, RangedAirRow, SignedWord,
    derive_ranged_air_row, encode_proof_row, encode_signed_word,
    encoded_proof_row_words, padded_trace_length,
}
use poseidon_bn254::{
    Fr, LIMBS, WORD_BITS, PoseidonDomain, bind_plain_words, commit_plain_words, compress,
    plain_words,
}

const ROW_WORDS: usize = 17
const PUBLIC_WORDS: usize = 8
const TRACE_FRONTIER_LEVELS: usize = 22
const MAX_PADDED_TRACE_LENGTH: usize = 2097152
const AUXILIARY_ROW_BITS: u32 = 411
const AUXILIARY_FIELD_BITS: u32 = 253
const AUXILIARY_FIELDS: usize = 2

/// Widths implied by the public-domain and proof-shape checks: signed Q12
/// point components, the inclusive 2^20 bound, terminal step, semantic trace
/// length, and a padded length that may reach 2^21.
const ESCAPES_BY_Q12_PUBLIC_WIDTHS: [u32; PUBLIC_WORDS] = [
    1, 14,
    1, 13,
    21,
    21,
    21,
    22,
]

/// Pack a four-byte ASCII protocol label without a numeric magic constant.
const fn protocol_tag(_ label: String<4>) -> u32 {
    let bytes = label.as_bytes()
    ((bytes[0] as u32) << 24)
        | ((bytes[1] as u32) << 16)
        | ((bytes[2] as u32) << 8)
        | (bytes[3] as u32)
}

pub struct MandelbrotRowV1 {}
pub struct MandelbrotNodeV1 {}
pub struct MandelbrotTranscriptV1 {}
pub struct MandelbrotAuxiliaryRowV1 {}
pub struct MandelbrotAuxiliaryNodeV1 {}
pub struct MandelbrotAuxiliaryTranscriptV1 {}
pub struct MandelbrotCompositionV1 {}

impl PoseidonDomain for MandelbrotRowV1 {
    const TAG: u32 = protocol_tag("MR01")
}

impl PoseidonDomain for MandelbrotNodeV1 {
    const TAG: u32 = protocol_tag("MN01")
}

impl PoseidonDomain for MandelbrotTranscriptV1 {
    const TAG: u32 = protocol_tag("MT01")
}

impl PoseidonDomain for MandelbrotAuxiliaryRowV1 {
    const TAG: u32 = protocol_tag("AR01")
}

impl PoseidonDomain for MandelbrotAuxiliaryNodeV1 {
    const TAG: u32 = protocol_tag("AN01")
}

impl PoseidonDomain for MandelbrotAuxiliaryTranscriptV1 {
    const TAG: u32 = protocol_tag("AT01")
}

impl PoseidonDomain for MandelbrotCompositionV1 {
    const TAG: u32 = protocol_tag("MC01")
}

/// Public statement already validated by the cheap proof-domain boundary.
/// Keeping its shape nominal prevents transcript fields from becoming an
/// untyped positional protocol at Fe call sites.
pub struct EscapesByQ12Public {
    pub c_re: SignedWord,
    pub c_im: SignedWord,
    pub bound: u32,
    pub terminal_step: u32,
    pub trace_length: u32,
    pub padded_length: u32,
}

impl core::marker::Copy for EscapesByQ12Public {}

/// Main and auxiliary roots remain nominally distinct even though their
/// frontier storage shares one field-level implementation below.
pub struct TraceDigest { value: Fr }

impl core::marker::Copy for TraceDigest {}

pub struct AuxiliaryDigest { value: Fr }

impl core::marker::Copy for AuxiliaryDigest {}

/// The public statement and trace root are distinct nominal stages, so later
/// verifier code cannot accidentally treat an unbound tree root as a proof
/// statement commitment.
pub struct StatementDigest { value: Fr }

impl core::marker::Copy for StatementDigest {}

/// Public claim plus the ordered main and auxiliary trace commitments.
pub struct ProofTranscriptDigest { value: Fr }

impl core::marker::Copy for ProofTranscriptDigest {}

pub struct CompositionChallenge { value: Fr }

impl core::marker::Copy for CompositionChallenge {}

/// Result of one canonical prover-side pass. Invalid and non-escaping claims
/// fail closed instead of exposing a digest for an incomplete trace.
struct StreamedCommitment {
    valid: bool,
    terminal_step: u32,
    trace_length: u32,
    padded_length: u32,
    trace: TraceDigest,
    auxiliary: AuxiliaryDigest,
    statement: StatementDigest,
    proof_transcript: ProofTranscriptDigest,
    composition: CompositionChallenge,
}

impl core::marker::Copy for StreamedCommitment {}

/// Canonical 411-bit auxiliary-row serializer. Ten bit decompositions carry
/// 203 bits and 203 inclusive prefix-OR values; the terminal threshold adds
/// five more prefix values. Two 253-bit chunks are each injective in BN254 Fr.
struct AuxiliaryRowPacker {
    words: [[u32; LIMBS]; AUXILIARY_FIELDS],
    offset: u32,
}

impl core::marker::Copy for AuxiliaryRowPacker {}

impl AuxiliaryRowPacker {
    fn empty() -> Self {
        Self { words: [[0; LIMBS]; AUXILIARY_FIELDS], offset: 0 }
    }

    fn push_bit(mut self, _ bit: u32) -> Self {
        let field = self.offset / AUXILIARY_FIELD_BITS
        let within = self.offset - field * AUXILIARY_FIELD_BITS
        let limb = within / WORD_BITS
        let shift = within - limb * WORD_BITS
        self.words[field as usize][limb as usize] =
            self.words[field as usize][limb as usize] | ((bit & 1) << shift)
        self.offset = self.offset + 1
        self
    }

}

fn pack_witness<const N: usize>(
    _ packed: own AuxiliaryRowPacker,
    _ witness: BitRangeWitness<N>,
) -> AuxiliaryRowPacker {
    let mut packed = packed
    let mut i: usize = 0
    while i < N {
        packed = packed.push_bit(witness.bits[i])
        i = i + 1
    }
    i = 0
    while i < N {
        packed = packed.push_bit(witness.any[i])
        i = i + 1
    }
    packed
}

fn pack_words<const N: usize>(
    _ source: own [u32; N],
    _ widths: own [u32; N],
) -> [u32; LIMBS] {
    let mut packed: [u32; LIMBS] = [0; LIMBS]
    let mut field: usize = 0
    let mut offset: u32 = 0
    while field < N {
        let width = widths[field]
        let value = source[field]
        let mut bit: u32 = 0
        while bit < width {
            let destination = offset + bit
            let limb = destination / WORD_BITS
            let shift = destination - limb * WORD_BITS
            packed[limb as usize] = packed[limb as usize]
                | (((value >> bit) & 1) << shift)
            bit = bit + 1
        }
        offset = offset + width
        field = field + 1
    }
    packed
}

fn packed_row(_ row: own EncodedProofRow) -> [u32; LIMBS] {
    pack_words<ROW_WORDS>(encoded_proof_row_words(row), ENCODED_PROOF_ROW_WIDTHS)
}

fn packed_public(_ public: own EscapesByQ12Public) -> [u32; LIMBS] {
    pack_words<PUBLIC_WORDS>([
        public.c_re.sign, public.c_re.magnitude,
        public.c_im.sign, public.c_im.magnitude,
        public.bound,
        public.terminal_step,
        public.trace_length,
        public.padded_length,
    ], ESCAPES_BY_Q12_PUBLIC_WIDTHS)
}

fn packed_auxiliary_row(_ row: own EncodedProofRow) -> [[u32; LIMBS]; AUXILIARY_FIELDS] {
    let ranged: RangedAirRow = derive_ranged_air_row(row.air)
    let mut packed = AuxiliaryRowPacker::empty()
    packed = pack_witness<21>(packed, ranged.step.witness)
    packed = pack_witness<15>(packed, ranged.zr.witness)
    packed = pack_witness<15>(packed, ranged.zi.witness)
    packed = pack_witness<30>(packed, ranged.rr.witness)
    packed = pack_witness<30>(packed, ranged.ii.witness)
    packed = pack_witness<31>(packed, ranged.magnitude.witness)
    packed = pack_witness<18>(packed, ranged.q_re.witness)
    packed = pack_witness<12>(packed, ranged.r_re.witness)
    packed = pack_witness<19>(packed, ranged.q_im.witness)
    packed = pack_witness<12>(packed, ranged.r_im.witness)
    let mut high: u32 = 0
    while high < 5 {
        packed = packed.push_bit(ranged.terminal_high_any.any[high as usize])
        high = high + 1
    }
    if packed.offset != AUXILIARY_ROW_BITS {
        let zero: [u32; LIMBS] = [0; LIMBS]
        return [zero, zero]
    }
    packed.words
}

pub fn row_commitment(_ row: own EncodedProofRow) -> TraceDigest {
    TraceDigest {
        value: commit_plain_words<MandelbrotRowV1>(packed_row(row)),
    }
}

pub fn auxiliary_row_commitment(_ row: own EncodedProofRow) -> AuxiliaryDigest {
    let packed = packed_auxiliary_row(row)
    AuxiliaryDigest {
        value: compress<MandelbrotAuxiliaryRowV1>(
            Fr::from_plain_words(packed[0]),
            Fr::from_plain_words(packed[1]),
        ),
    }
}

pub fn node_commitment(_ left: own TraceDigest, _ right: own TraceDigest) -> TraceDigest {
    TraceDigest {
        value: compress<MandelbrotNodeV1>(left.value, right.value),
    }
}

/// Streaming Merkle state for every proof domain admitted by the public Q12
/// bound. Slot `level` holds the completed left subtree of width `2^level`
/// selected by the corresponding set bit in `count`.
struct RawFrontier {
    count: u32,
    nodes: [Fr; TRACE_FRONTIER_LEVELS],
}

impl core::marker::Copy for RawFrontier {}

impl RawFrontier {
    fn empty() -> Self {
        Self {
            count: 0,
            nodes: [Fr::zero(); TRACE_FRONTIER_LEVELS],
        }
    }

    fn complete_root(self) -> Fr {
        let mut level: usize = 0
        let mut width: u32 = 1
        while width < self.count {
            width = width + width
            level = level + 1
        }
        self.nodes[level]
    }
}

fn push_merkle<D: PoseidonDomain>(
    _ frontier: own RawFrontier,
    _ leaf: Fr,
) -> RawFrontier {
    let mut frontier = frontier
    let mut carry = leaf
    let mut occupied = frontier.count
    let mut level: usize = 0
    while (occupied & 1) == 1 {
        carry = compress<D>(frontier.nodes[level], carry)
        occupied = occupied >> 1
        level = level + 1
    }
    frontier.nodes[level] = carry
    frontier.count = frontier.count + 1
    frontier
}

struct TraceFrontier { raw: RawFrontier }
impl core::marker::Copy for TraceFrontier {}
impl TraceFrontier {
    fn empty() -> Self { Self { raw: RawFrontier::empty() } }
    fn push(mut self, _ leaf: TraceDigest) -> Self {
        self.raw = push_merkle<MandelbrotNodeV1>(self.raw, leaf.value)
        self
    }
    fn complete_root(self) -> TraceDigest { TraceDigest { value: self.raw.complete_root() } }
    fn count(self) -> u32 { self.raw.count }
}

struct AuxiliaryFrontier { raw: RawFrontier }
impl core::marker::Copy for AuxiliaryFrontier {}
impl AuxiliaryFrontier {
    fn empty() -> Self { Self { raw: RawFrontier::empty() } }
    fn push(mut self, _ leaf: AuxiliaryDigest) -> Self {
        self.raw = push_merkle<MandelbrotAuxiliaryNodeV1>(self.raw, leaf.value)
        self
    }
    fn complete_root(self) -> AuxiliaryDigest {
        AuxiliaryDigest { value: self.raw.complete_root() }
    }
}

fn invalid_streamed_commitment() -> StreamedCommitment {
    StreamedCommitment {
        valid: false,
        terminal_step: 0,
        trace_length: 0,
        padded_length: 0,
        trace: TraceDigest { value: Fr::zero() },
        auxiliary: AuxiliaryDigest { value: Fr::zero() },
        statement: StatementDigest { value: Fr::zero() },
        proof_transcript: ProofTranscriptDigest { value: Fr::zero() },
        composition: CompositionChallenge { value: Fr::zero() },
    }
}

/// Generate, encode, and commit the canonical proof trace in one Fe pass.
/// Active rows are never retained after entering the Merkle frontier. Once
/// the least terminal row is found, its AIR values are reused for the uniquely
/// defined inactive suffix up to the next power-of-two domain.
fn stream_statement_q12(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ bound: u32,
) -> StreamedCommitment {
    let claim = EscapesByQ12::new(c_re_q12, c_im_q12, bound)
    let mut stream = EscapeTraceStream::new(claim)
    if !stream.is_valid() { return invalid_streamed_commitment() }

    let mut frontier = TraceFrontier::empty()
    let mut auxiliary = AuxiliaryFrontier::empty()
    while true {
        let row = stream.current_proof_row()
        let encoded = encode_proof_row(row)
        frontier = frontier.push(row_commitment(encoded))
        auxiliary = auxiliary.push(auxiliary_row_commitment(encoded))
        if row.terminal { break }
        if !stream.can_advance() { return invalid_streamed_commitment() }
        stream = stream.advance()
    }

    let terminal_air = stream.current_air_row()
    let terminal_step = terminal_air.semantic.step
    let trace_length = terminal_step + 1
    let padded_length = padded_trace_length(trace_length)
    let padding = PaddedEscapeAirRow {
        valid: true,
        active: false,
        terminal: false,
        air: terminal_air,
    }
    while frontier.count() < padded_length {
        let encoded = encode_proof_row(padding)
        frontier = frontier.push(row_commitment(encoded))
        auxiliary = auxiliary.push(auxiliary_row_commitment(encoded))
    }

    let trace = frontier.complete_root()
    let auxiliary = auxiliary.complete_root()
    let public = EscapesByQ12Public {
        c_re: encode_signed_word(c_re_q12),
        c_im: encode_signed_word(c_im_q12),
        bound: bound,
        terminal_step: terminal_step,
        trace_length: trace_length,
        padded_length: padded_length,
    }
    let statement = bind_statement(public, trace)
    let proof_transcript = bind_auxiliary_trace(statement, auxiliary)
    StreamedCommitment {
        valid: true,
        terminal_step: terminal_step,
        trace_length: trace_length,
        padded_length: padded_length,
        trace: trace,
        auxiliary: auxiliary,
        statement: statement,
        proof_transcript: proof_transcript,
        composition: composition_challenge(proof_transcript),
    }
}

/// Fold a compile-time-checked power-of-two row domain through an O(log N)
/// frontier. The production streamer below updates this same shape as it emits
/// rows, without retaining the Merkle tree or its leaves.
fn trace_root_power_of_two<const N: usize>(
    _ rows: own [EncodedProofRow; N],
) -> TraceDigest
    where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 },
{
    let mut frontier = TraceFrontier::empty()
    let mut row: usize = 0
    while row < N {
        frontier = frontier.push(row_commitment(rows[row]))
        row = row + 1
    }
    frontier.complete_root()
}

fn statement_commitment_power_of_two<const N: usize>(
    _ public: own EscapesByQ12Public,
    _ rows: own [EncodedProofRow; N],
) -> StatementDigest
    where N > 0, N <= MAX_PADDED_TRACE_LENGTH, { (N & (N - 1)) == 0 },
{
    bind_statement(public, trace_root_power_of_two<N>(rows))
}

/// Four-row compatibility boundary, now routed through the general frontier.
pub fn trace_root4(_ rows: own [EncodedProofRow; 4]) -> TraceDigest {
    trace_root_power_of_two<4>(rows)
}

pub fn trace_root4_plain_words(_ rows: own [EncodedProofRow; 4]) -> [u32; 20] {
    plain_words(trace_root4(rows).value)
}

pub fn bind_statement(
    _ public: own EscapesByQ12Public,
    _ trace: own TraceDigest,
) -> StatementDigest {
    StatementDigest {
        value: bind_plain_words<MandelbrotTranscriptV1>(packed_public(public), trace.value),
    }
}

pub fn bind_auxiliary_trace(
    _ statement: own StatementDigest,
    _ auxiliary: own AuxiliaryDigest,
) -> ProofTranscriptDigest {
    ProofTranscriptDigest {
        value: compress<MandelbrotAuxiliaryTranscriptV1>(statement.value, auxiliary.value),
    }
}

pub fn composition_challenge(
    _ transcript: own ProofTranscriptDigest,
) -> CompositionChallenge {
    CompositionChallenge {
        value: compress<MandelbrotCompositionV1>(transcript.value, Fr::zero()),
    }
}

pub fn statement_commitment4(
    _ public: own EscapesByQ12Public,
    _ rows: own [EncodedProofRow; 4],
) -> StatementDigest {
    statement_commitment_power_of_two<4>(public, rows)
}

pub fn statement_commitment4_plain_words(
    _ public: own EscapesByQ12Public,
    _ rows: own [EncodedProofRow; 4],
) -> [u32; 20] {
    plain_words(statement_commitment4(public, rows).value)
}

/// First domain-growth boundary: eight rows and three tree levels exercise the
/// same streaming frontier without another hand-authored tree shape.
pub fn trace_root8_plain_words(_ rows: own [EncodedProofRow; 8]) -> [u32; 20] {
    plain_words(trace_root_power_of_two<8>(rows).value)
}

pub fn statement_commitment8_plain_words(
    _ public: own EscapesByQ12Public,
    _ rows: own [EncodedProofRow; 8],
) -> [u32; 20] {
    plain_words(statement_commitment_power_of_two<8>(public, rows).value)
}

/// Scalar Wasm oracle boundary for the production one-pass Fe generator.
/// The 44 words are `(valid, terminal_step, trace_length, padded_length)`, the
/// 20 trace-root limbs, then the 20 public-statement limbs. Internally all
/// stages remain nominal, and no host-authored witness rows cross this API.
pub fn streamed_statement_q12_plain_words(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ bound: u32,
) -> [u32; 44] {
    let generated = stream_statement_q12(c_re_q12, c_im_q12, bound)
    let mut output: [u32; 44] = [0; 44]
    if !generated.valid { return output }

    output[0] = 1
    output[1] = generated.terminal_step
    output[2] = generated.trace_length
    output[3] = generated.padded_length
    let trace = plain_words(generated.trace.value)
    let statement = plain_words(generated.statement.value)
    let mut limb: usize = 0
    while limb < LIMBS {
        output[4 + limb] = trace[limb]
        output[24 + limb] = statement[limb]
        limb = limb + 1
    }
    output
}

/// Full pre-composition transcript boundary. The 84 words contain metadata,
/// main root, auxiliary root, the digest that binds both roots to the public
/// statement, and only then the composition challenge. All auxiliary columns
/// are derived and committed inside the same Fe pass.
pub fn streamed_proof_transcript_q12_plain_words(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ bound: u32,
) -> [u32; 84] {
    let generated = stream_statement_q12(c_re_q12, c_im_q12, bound)
    let mut output: [u32; 84] = [0; 84]
    if !generated.valid { return output }

    output[0] = 1
    output[1] = generated.terminal_step
    output[2] = generated.trace_length
    output[3] = generated.padded_length
    let trace = plain_words(generated.trace.value)
    let auxiliary = plain_words(generated.auxiliary.value)
    let transcript = plain_words(generated.proof_transcript.value)
    let composition = plain_words(generated.composition.value)
    let mut limb: usize = 0
    while limb < LIMBS {
        output[4 + limb] = trace[limb]
        output[24 + limb] = auxiliary[limb]
        output[44 + limb] = transcript[limb]
        output[64 + limb] = composition[limb]
        limb = limb + 1
    }
    output
}
