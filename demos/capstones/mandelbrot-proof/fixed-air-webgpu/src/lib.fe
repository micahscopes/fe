/// Compiler-derived storage layout for the seven arithmetic nodes of one
/// exact Mandelbrot transition. The record is the semantic dependency DAG;
/// its region interpretation decides only physical placement.
struct TransitionWitnessRegions<const L: usize> {
    xx: Region<TransitionWitnessRegions<L>, FixedProductWitness<L>>,
    yy: Region<TransitionWitnessRegions<L>, FixedProductWitness<L>>,
    xy: Region<TransitionWitnessRegions<L>, FixedProductWitness<L>>,
    real_difference: Region<TransitionWitnessRegions<L>, FixedLinearWitness<L>>,
    next_real: Region<TransitionWitnessRegions<L>, FixedLinearWitness<L>>,
    double_xy: Region<TransitionWitnessRegions<L>, FixedLinearWitness<L>>,
    next_imaginary: Region<TransitionWitnessRegions<L>, FixedLinearWitness<L>>,
    valid: Region<TransitionWitnessRegions<L>, u32>,
}
impl<const L: usize> core::marker::Copy for TransitionWitnessRegions<L> {}
derive RegionSchema for TransitionWitnessRegions<L> using RegionSchemaProvider

const fn transition_witness_regions<const L: usize>() -> TransitionWitnessRegions<L> {
    <TransitionWitnessRegions<L> as RegionSchema>::regions()
}

pub const fn transition_witness_workspace_words<const L: usize>() -> usize {
    <TransitionWitnessRegions<L> as RegionSchema>::WORDS as usize
}

/// Preserve the generated transition witness while later phases carry one
/// independent validity receipt in the trailing word.
pub const fn transition_phase_workspace_words<const L: usize>() -> usize {
    transition_witness_workspace_words<L>() + 1
}

pub const fn transition_phase_receipt_word<const L: usize>() -> usize {
    transition_witness_workspace_words<L>()
}

pub fn store_transition_phase_receipt<const L: usize, const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ valid: bool,
)
where L > 1, { WORKSPACE_WORDS >= transition_phase_workspace_words<L>() }
{
    workspace
        .store(
            index: transition_phase_receipt_word<L>().downcast_truncate(),
            value: if valid { 1 } else { 0 },
        )
}

pub fn load_transition_phase_receipt<const L: usize, const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> bool
where L > 1, { WORKSPACE_WORDS >= transition_phase_workspace_words<L>() }
{
    workspace.load(
                index: transition_phase_receipt_word<L>().downcast_truncate(),
            ) == 1
}

/// Canonical-word interpreter into one compiler-derived GPU region.
struct WorkspaceWordWriter<Space, T, const STORAGE_WORDS: usize> {
    storage: StorageBuffer<u32, STORAGE_WORDS>,
    region: Region<Space, T>,
    cursor: u32,
    valid: bool,
}
impl<Space, T, const STORAGE_WORDS: usize> core::marker::Copy for WorkspaceWordWriter<
    Space,
    T,
    STORAGE_WORDS,
> {}

impl<Space: RegionSchema, T: CanonicalWords, const STORAGE_WORDS: usize> WorkspaceWordWriter<
    Space,
    T,
    STORAGE_WORDS,
> where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>() {
    fn new(_ storage: StorageBuffer<u32, STORAGE_WORDS>, _ region: Region<Space, T>) -> Self {
        Self { storage: storage, region: region, cursor: 0, valid: true }
    }

    fn finish(self) -> bool {
        self.valid && self.cursor == T::WORDS
    }
}

impl<
    Space: RegionSchema,
    T: CanonicalWords,
    const STORAGE_WORDS: usize,
> WordSink for WorkspaceWordWriter<Space, T, STORAGE_WORDS>
where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>() {
    fn write(self, _ value: u32) -> Self {
        let valid = self.valid && store_region_word(self.storage, self.region, self.cursor, value)
        Self { storage: self.storage, region: self.region, cursor: self.cursor + 1, valid: valid }
    }

    fn reject(self) -> Self {
        Self { storage: self.storage, region: self.region, cursor: self.cursor, valid: false }
    }
}

/// Canonical-word interpreter from one compiler-derived GPU region.
struct WorkspaceWordReader<Space, T, const STORAGE_WORDS: usize> {
    storage: StorageBuffer<u32, STORAGE_WORDS>,
    region: Region<Space, T>,
    cursor: u32,
    valid: bool,
}
impl<Space, T, const STORAGE_WORDS: usize> core::marker::Copy for WorkspaceWordReader<
    Space,
    T,
    STORAGE_WORDS,
> {}

impl<Space: RegionSchema, T: CanonicalWords, const STORAGE_WORDS: usize> WorkspaceWordReader<
    Space,
    T,
    STORAGE_WORDS,
> where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>() {
    fn new(_ storage: StorageBuffer<u32, STORAGE_WORDS>, _ region: Region<Space, T>) -> Self {
        Self { storage: storage, region: region, cursor: 0, valid: true }
    }

    fn finish(self) -> bool {
        self.valid && self.cursor == T::WORDS
    }
}

impl<
    Space: RegionSchema,
    T: CanonicalWords,
    const STORAGE_WORDS: usize,
> WordSource for WorkspaceWordReader<Space, T, STORAGE_WORDS>
where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>() {
    fn read(self) -> WordRead<Self> {
        let read = load_region_word(self.storage, self.region, self.cursor)
        WordRead {
            source: Self {
                storage: self.storage,
                region: self.region,
                cursor: self.cursor + 1,
                valid: self.valid && read.valid,
            },
            value: read.value,
        }
    }

    fn reject(self) -> Self {
        Self { storage: self.storage, region: self.region, cursor: self.cursor, valid: false }
    }
}

struct WorkspaceDecoded<T> { value: T, valid: bool }
impl<T: core::marker::Copy> core::marker::Copy for WorkspaceDecoded<T> {}

/// Read the generic squeeze batch as one nominal interaction-challenge
/// record. The derived codec owns field grouping and order. This placement
/// contributes only the leading validity word and skips the batch's trailing
/// per-value receipts.
struct SparseChallengeBatchReader<const OUTPUT_WORDS: usize> {
    output: StorageBuffer<u32, OUTPUT_WORDS>,
    cursor: u32,
    valid: bool,
}
impl<const OUTPUT_WORDS: usize> core::marker::Copy for SparseChallengeBatchReader<OUTPUT_WORDS> {}

impl<const OUTPUT_WORDS: usize> SparseChallengeBatchReader<OUTPUT_WORDS>
where { OUTPUT_WORDS >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values()) } {
    fn new(_ output: StorageBuffer<u32, OUTPUT_WORDS>) -> Self {
        Self { output: output, cursor: 0, valid: true }
    }

    fn finish(self) -> bool {
        self.valid && self.cursor == <SparseInteractionChallenges as CanonicalWords>::WORDS
    }
}

impl<const OUTPUT_WORDS: usize> WordSource for SparseChallengeBatchReader<OUTPUT_WORDS>
where { OUTPUT_WORDS >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values()) } {
    fn read(self) -> WordRead<Self> {
        let words = <SparseInteractionChallenges as CanonicalWords>::WORDS
        if !self.valid || self.cursor >= words {
            return WordRead {
                source: Self { output: self.output, cursor: self.cursor, valid: false },
                value: 0,
            }
        }
        if self.cursor == 0 {
            return WordRead {
                source: Self { output: self.output, cursor: 1, valid: true },
                value: 1,
            }
        }
        let coefficient_word = self.cursor - 1
        let coefficient_words = <BabyBearExt4 as CanonicalWords>::WORDS
        let state = coefficient_word / coefficient_words
        let valid_start: u32 = digest_squeeze_batch_output_valid_start(
            sparse_interaction_challenge_values(),
        )
            .downcast_truncate()
        WordRead {
            source: Self {
                output: self.output,
                cursor: self.cursor + 1,
                valid: state < sparse_interaction_challenge_values().downcast_truncate()
                    && self.output.load(index: valid_start + state) == 1,
            },
            value: self.output.load(index: coefficient_word),
        }
    }

    fn reject(self) -> Self {
        Self { output: self.output, cursor: self.cursor, valid: false }
    }
}

/// Production-domain authority decoded from the root-derived squeeze batch.
/// The payload stays private so later placement APIs cannot accept a raw
/// array of quartic values as an equivalent transcript source.
pub struct SparseLdeInteractionChallengeBatch<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> { valid: bool, value: SparseInteractionChallenges }
impl<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> core::marker::Copy for SparseLdeInteractionChallengeBatch<L, TRACE, LDE> {}

pub fn load_sparse_lde_interaction_challenge_batch<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const OUTPUT_WORDS: usize,
>(_ output: StorageBuffer<u32, OUTPUT_WORDS>) -> SparseLdeInteractionChallengeBatch<L, TRACE, LDE>
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    {
        OUTPUT_WORDS >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values())
    }
{
    let mut value = zero_sparse_interaction_challenges()
    let reader = decode_canonical_words(
        mut value,
        SparseChallengeBatchReader<OUTPUT_WORDS>::new(output),
    )
    SparseLdeInteractionChallengeBatch { valid: reader.finish() && value.valid, value: value }
}

pub fn sparse_lde_interaction_challenge_batch_is_valid<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(_ batch: SparseLdeInteractionChallengeBatch<L, TRACE, LDE>) -> bool {
    batch.valid && batch.value.valid
}

fn decode_workspace_value<
    Space: RegionSchema,
    T: CanonicalWords + core::marker::Copy,
    const STORAGE_WORDS: usize,
>(
    _ initial: T,
    _ storage: StorageBuffer<u32, STORAGE_WORDS>,
    _ region: Region<Space, T>,
) -> WorkspaceDecoded<T>
where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>()
{
    let mut value = initial
    let reader = decode_canonical_words(
        mut value,
        WorkspaceWordReader<Space, T, STORAGE_WORDS>::new(storage, region),
    )
    WorkspaceDecoded { value: value, valid: reader.finish() }
}

fn encode_workspace_value<Space: RegionSchema, T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ value: ref T,
    _ storage: StorageBuffer<u32, STORAGE_WORDS>,
    _ region: Region<Space, T>,
) -> bool
where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>()
{
    encode_canonical_words(
        ref value,
        WorkspaceWordWriter<Space, T, STORAGE_WORDS>::new(storage, region),
    )
        .finish()
}

fn product_workspace_region<const L: usize>(
    _ node: ProductNode,
    _ regions: TransitionWitnessRegions<L>,
) -> Region<TransitionWitnessRegions<L>, FixedProductWitness<L>> {
    match node {
        ProductNode::Xx => regions.xx,
        ProductNode::Yy => regions.yy,
        ProductNode::Xy => regions.xy,
        ProductNode::Invalid => regions.xx,
    }
}

fn linear_workspace_region<const L: usize>(
    _ node: LinearNode,
    _ regions: TransitionWitnessRegions<L>,
) -> Region<TransitionWitnessRegions<L>, FixedLinearWitness<L>> {
    match node {
        LinearNode::RealDifference => regions.real_difference,
        LinearNode::NextReal => regions.next_real,
        LinearNode::DoubleXy => regions.double_xy,
        LinearNode::NextImaginary => regions.next_imaginary,
        LinearNode::Invalid => regions.real_difference,
    }
}

fn decode_product_node<const L: usize, const WORKSPACE_WORDS: usize>(
    _ node: ProductNode,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> WorkspaceDecoded<FixedProductWitness<L>>
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node_valid = match node {
        ProductNode::Invalid => false,
        _ => true,
    }
    let decoded = decode_workspace_value(
        empty_product_witness<L>(),
        workspace,
        product_workspace_region(node, transition_witness_regions<L>()),
    )
    WorkspaceDecoded { value: decoded.value, valid: node_valid && decoded.valid }
}

fn decode_linear_node<const L: usize, const WORKSPACE_WORDS: usize>(
    _ node: LinearNode,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> WorkspaceDecoded<FixedLinearWitness<L>>
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node_valid = match node {
        LinearNode::Invalid => false,
        _ => true,
    }
    let decoded = decode_workspace_value(
        empty_linear_witness<L>(),
        workspace,
        linear_workspace_region(node, transition_witness_regions<L>()),
    )
    WorkspaceDecoded { value: decoded.value, valid: node_valid && decoded.valid }
}

struct DecodedFixed<const L: usize> { value: Fixed<L>, valid: bool }
impl<const L: usize> core::marker::Copy for DecodedFixed<L> {}

struct DecodedDigits<const L: usize> { digits: [u32; L], negative: bool, valid: bool }
impl<const L: usize> core::marker::Copy for DecodedDigits<L> {}

fn product_left<const L: usize>(_ node: ProductNode, _ current: ComplexFixed<L>) -> Fixed<L> {
    match node {
        ProductNode::Xx => current.real,
        ProductNode::Yy => current.imaginary,
        ProductNode::Xy => current.real,
        ProductNode::Invalid => current.real,
    }
}

fn product_right<const L: usize>(_ node: ProductNode, _ current: ComplexFixed<L>) -> Fixed<L> {
    match node {
        ProductNode::Xx => current.real,
        ProductNode::Yy => current.imaginary,
        ProductNode::Xy => current.imaginary,
        ProductNode::Invalid => current.real,
    }
}

fn decode_next_coordinate<const L: usize, const WORKSPACE_WORDS: usize>(
    _ coordinate: CoordinateNode,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> DecodedFixed<L>
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node = match coordinate {
        CoordinateNode::Real => LinearNode::NextReal,
        CoordinateNode::Imaginary => LinearNode::NextImaginary,
        CoordinateNode::Invalid => LinearNode::Invalid,
    }
    let decoded = decode_linear_node(node, workspace)
    DecodedFixed { value: decoded.value.output, valid: decoded.valid }
}

fn decode_linear_left<const L: usize, const WORKSPACE_WORDS: usize>(
    _ node: LinearNode,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> DecodedFixed<L>
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    match node {
        LinearNode::RealDifference => {
            let product = decode_product_node(ProductNode::Xx, workspace)
            DecodedFixed { value: product.value.output, valid: product.valid }
        },
        LinearNode::NextReal => {
            let linear = decode_linear_node(LinearNode::RealDifference, workspace)
            DecodedFixed { value: linear.value.output, valid: linear.valid }
        },
        LinearNode::DoubleXy => {
            let product = decode_product_node(ProductNode::Xy, workspace)
            DecodedFixed { value: product.value.output, valid: product.valid }
        },
        LinearNode::NextImaginary => {
            let linear = decode_linear_node(LinearNode::DoubleXy, workspace)
            DecodedFixed { value: linear.value.output, valid: linear.valid }
        },
        LinearNode::Invalid => DecodedFixed {
            value: Fixed { negative: false, limbs: [0; L] },
            valid: false,
        },
    }
}

fn decode_linear_right<const L: usize, const WORKSPACE_WORDS: usize>(
    _ node: LinearNode,
    _ point: ComplexFixed<L>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> DecodedFixed<L>
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    match node {
        LinearNode::RealDifference => {
            let product = decode_product_node(ProductNode::Yy, workspace)
            DecodedFixed { value: product.value.output, valid: product.valid }
        },
        LinearNode::NextReal => DecodedFixed { value: point.real, valid: true },
        LinearNode::DoubleXy => {
            let product = decode_product_node(ProductNode::Xy, workspace)
            DecodedFixed { value: product.value.output, valid: product.valid }
        },
        LinearNode::NextImaginary => DecodedFixed { value: point.imaginary, valid: true },
        LinearNode::Invalid => DecodedFixed {
            value: Fixed { negative: false, limbs: [0; L] },
            valid: false,
        },
    }
}

/// First parallel layer of the recurrence DAG. Three invocations derive
/// `x*x`, `y*y`, and `x*y` independently and write the same canonical witness
/// records consumed by the scalar AIR.
pub fn write_transition_product_witness_lane<const L: usize, const WORKSPACE_WORDS: usize>(
    _ current: ComplexFixed<L>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let lane = invocation.global.x
    if lane >= 3 { return }
    let regions = transition_witness_regions<L>()
    let (left, right, region) = match lane {
        0 => (current.real, current.real, regions.xx),
        1 => (current.imaginary, current.imaginary, regions.yy),
        _ => (current.real, current.imaginary, regions.xy),
    }
    let witness = derive_fixed_product_witness(left, right)
    encode_workspace_value(ref witness, workspace, region)
}

/// Second parallel layer. The real difference depends on `x*x` and `y*y`;
/// doubled `x*y` is independent and occupies the sibling lane.
pub fn write_transition_primary_linear_witness_lane<const L: usize, const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let lane = invocation.global.x
    if lane >= 2 { return }
    let regions = transition_witness_regions<L>()
    let xx = decode_workspace_value(empty_product_witness<L>(), workspace, regions.xx)
    let yy = decode_workspace_value(empty_product_witness<L>(), workspace, regions.yy)
    let xy = decode_workspace_value(empty_product_witness<L>(), workspace, regions.xy)
    let (left, right, subtract_right, region, dependencies_valid) = if lane == 0 {
        (xx.value.output, yy.value.output, true, regions.real_difference, xx.valid && yy.valid)
    } else {
        (xy.value.output, xy.value.output, false, regions.double_xy, xy.valid)
    }
    let witness = derive_fixed_linear_witness(left, right, subtract_right)
    if dependencies_valid {
        encode_workspace_value(ref witness, workspace, region)
    }
}

/// Third parallel layer. The two public-coordinate additions depend on
/// disjoint primary linear nodes and therefore share one two-lane dispatch.
pub fn write_transition_final_linear_witness_lane<const L: usize, const WORKSPACE_WORDS: usize>(
    _ point: ComplexFixed<L>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let lane = invocation.global.x
    if lane >= 2 { return }
    let regions = transition_witness_regions<L>()
    let difference = decode_workspace_value(
        empty_linear_witness<L>(),
        workspace,
        regions.real_difference,
    )
    let doubled = decode_workspace_value(empty_linear_witness<L>(), workspace, regions.double_xy)
    let (left, right, region, dependency_valid) = if lane == 0 {
        (difference.value.output, point.real, regions.next_real, difference.valid)
    } else {
        (doubled.value.output, point.imaginary, regions.next_imaginary, doubled.valid)
    }
    let witness = derive_fixed_sum_witness(left, right)
    if dependency_valid {
        encode_workspace_value(ref witness, workspace, region)
    }
}

fn workspace_region_is_valid<Space: RegionSchema, T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ storage: StorageBuffer<u32, STORAGE_WORDS>,
    _ region: Region<Space, T>,
) -> bool
where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>()
{
    let word = load_region_word(storage, region, 0)
    word.valid && word.value == 1
}

/// Close the recurrence DAG after all seven arithmetic records have been
/// produced. Canonical witness codecs place their validity word first, so this
/// pass reads one word per dependency instead of reconstructing the aggregate.
pub fn finish_transition_witness_workspace<const L: usize, const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    if invocation.global.x != 0 {
        return
    }
    let regions = transition_witness_regions<L>()
    let valid = workspace_region_is_valid(workspace, regions.xx)
        && workspace_region_is_valid(workspace, regions.yy)
        && workspace_region_is_valid(workspace, regions.xy)
        && workspace_region_is_valid(workspace, regions.real_difference)
        && workspace_region_is_valid(workspace, regions.next_real)
        && workspace_region_is_valid(workspace, regions.double_xy)
        && workspace_region_is_valid(workspace, regions.next_imaginary)
    store_region_word(workspace, regions.valid, 0, if valid { 1 } else { 0 })
}

fn transition_workspace_is_valid<const L: usize, const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> bool
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    workspace_region_is_valid(workspace, transition_witness_regions<L>().valid)
}

fn decode_range_node<const L: usize, const WORKSPACE_WORDS: usize>(
    _ node: RangeNode,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> DecodedDigits<L>
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    match node {
        RangeNode::PointReal => DecodedDigits {
            digits: point.real.limbs,
            negative: point.real.negative,
            valid: true,
        },
        RangeNode::PointImaginary => DecodedDigits {
            digits: point.imaginary.limbs,
            negative: point.imaginary.negative,
            valid: true,
        },
        RangeNode::CurrentReal => DecodedDigits {
            digits: current.real.limbs,
            negative: current.real.negative,
            valid: true,
        },
        RangeNode::CurrentImaginary => DecodedDigits {
            digits: current.imaginary.limbs,
            negative: current.imaginary.negative,
            valid: true,
        },
        RangeNode::NextReal => {
            let decoded = decode_next_coordinate(CoordinateNode::Real, workspace)
            DecodedDigits {
                digits: decoded.value.limbs,
                negative: decoded.value.negative,
                valid: decoded.valid,
            }
        },
        RangeNode::NextImaginary => {
            let decoded = decode_next_coordinate(CoordinateNode::Imaginary, workspace)
            DecodedDigits {
                digits: decoded.value.limbs,
                negative: decoded.value.negative,
                valid: decoded.valid,
            }
        },
        RangeNode::ProductLow(product,) => {
            let decoded = decode_product_node(product, workspace)
            DecodedDigits {
                digits: decoded.value.low_digits,
                negative: false,
                valid: decoded.valid,
            }
        },
        RangeNode::ProductHigh(product,) => {
            let decoded = decode_product_node(product, workspace)
            DecodedDigits {
                digits: decoded.value.high_digits,
                negative: false,
                valid: decoded.valid,
            }
        },
        RangeNode::ProductOutput(product,) => {
            let decoded = decode_product_node(product, workspace)
            DecodedDigits {
                digits: decoded.value.output.limbs,
                negative: decoded.value.output.negative,
                valid: decoded.valid,
            }
        },
        RangeNode::LinearSum(linear,) => {
            let decoded = decode_linear_node(linear, workspace)
            DecodedDigits {
                digits: decoded.value.sum_digits,
                negative: false,
                valid: decoded.valid,
            }
        },
        RangeNode::LinearLeftDifference(linear,) => {
            let decoded = decode_linear_node(linear, workspace)
            DecodedDigits {
                digits: decoded.value.left_difference_digits,
                negative: false,
                valid: decoded.valid,
            }
        },
        RangeNode::LinearRightDifference(linear,) => {
            let decoded = decode_linear_node(linear, workspace)
            DecodedDigits {
                digits: decoded.value.right_difference_digits,
                negative: false,
                valid: decoded.valid,
            }
        },
        RangeNode::LinearOutput(linear,) => {
            let decoded = decode_linear_node(linear, workspace)
            DecodedDigits {
                digits: decoded.value.output.limbs,
                negative: decoded.value.output.negative,
                valid: decoded.valid,
            }
        },
        RangeNode::Invalid => DecodedDigits { digits: [0; L], negative: false, valid: false },
    }
}

pub struct SparseWitnessRow { value: SparseTaskRow<BabyBear>, valid: bool }
impl core::marker::Copy for SparseWitnessRow {}

fn complete_sparse_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ value: SparseTaskRow<BabyBear>,
    _ local_valid: bool,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    SparseWitnessRow {
        value: value,
        valid: local_valid && transition_workspace_is_valid<L, WORKSPACE_WORDS>(workspace),
    }
}

fn decode_sparse_radix_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ task: SparseTransitionTask,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node = match task {
        SparseTransitionTask::RadixBit(node, _, _) => node,
        SparseTransitionTask::RadixLimb(node, _) => node,
        SparseTransitionTask::RadixFinish(node,) => node,
        _ => RangeNode::Invalid,
    }
    let range = decode_range_node(node, point, current, workspace)
    complete_sparse_witness_row<L, WORKSPACE_WORDS>(
        sparse_radix_row<BabyBear, L>(task, range.digits, range.negative),
        range.valid,
        workspace,
    )
}

fn decode_sparse_carry_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ task: SparseTransitionTask,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node = match task {
        SparseTransitionTask::CarryBit(node, _, _, _) => node,
        SparseTransitionTask::CarryFinish(node, _) => node,
        _ => ProductNode::Invalid,
    }
    let product = decode_product_node(node, workspace)
    complete_sparse_witness_row<L, WORKSPACE_WORDS>(
        sparse_carry_row<BabyBear, L>(task, product.value),
        product.valid,
        workspace,
    )
}

fn decode_sparse_product_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ current: ComplexFixed<L>,
    _ task: SparseTransitionTask,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node = match task {
        SparseTransitionTask::ProductTerm(node, _, _) => node,
        SparseTransitionTask::ProductCoefficient(node, _) => node,
        _ => ProductNode::Invalid,
    }
    let product = decode_product_node(node, workspace)
    complete_sparse_witness_row<L, WORKSPACE_WORDS>(
        sparse_product_row<BabyBear, L>(
            task,
            product_left(node, current),
            product_right(node, current),
            product.value,
        ),
        product.valid,
        workspace,
    )
}

fn decode_sparse_round_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ current: ComplexFixed<L>,
    _ task: SparseTransitionTask,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node = match task {
        SparseTransitionTask::ProductRound(node, _) => node,
        SparseTransitionTask::ProductFinish(node,) => node,
        _ => ProductNode::Invalid,
    }
    let product = decode_product_node(node, workspace)
    complete_sparse_witness_row<L, WORKSPACE_WORDS>(
        sparse_round_row<BabyBear, L>(
            task,
            product_left(node, current),
            product_right(node, current),
            product.value,
        ),
        product.valid,
        workspace,
    )
}

fn decode_sparse_linear_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ point: ComplexFixed<L>,
    _ task: SparseTransitionTask,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node = match task {
        SparseTransitionTask::LinearLimb(node, _, _) => node,
        SparseTransitionTask::LinearFinish(node,) => node,
        _ => LinearNode::Invalid,
    }
    let linear = decode_linear_node(node, workspace)
    let left = decode_linear_left(node, workspace)
    let right = decode_linear_right(node, point, workspace)
    complete_sparse_witness_row<L, WORKSPACE_WORDS>(
        sparse_linear_row<BabyBear, L>(task, left.value, right.value, linear.value),
        linear.valid && left.valid && right.valid,
        workspace,
    )
}

fn decode_sparse_boundary_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ current: ComplexFixed<L>,
    _ task: SparseTransitionTask,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let coordinate = match task {
        SparseTransitionTask::BoundarySign(coordinate,) => coordinate,
        SparseTransitionTask::BoundaryLimb(coordinate, _) => coordinate,
        _ => CoordinateNode::Invalid,
    }
    let is_finish = match task {
        SparseTransitionTask::TransitionFinish => true,
        _ => false,
    }
    let next = if is_finish {
        DecodedFixed { value: current.real, valid: true }
    } else {
        decode_next_coordinate(coordinate, workspace)
    }
    complete_sparse_witness_row<L, WORKSPACE_WORDS>(
        sparse_boundary_row<BabyBear, L>(
            task,
            next.value,
            next.value,
            transition_workspace_is_valid<L, WORKSPACE_WORDS>(workspace),
        ),
        next.valid,
        workspace,
    )
}

/// A semantic family is a contiguous interpretation of the generated task
/// stream. The family owns neither formulas nor row numbers: its bounds are
/// derived from the same task-count functions used by the scalar AIR.
pub trait SparseWitnessFamily<const L: usize> {
    const START: u32
    const ROWS: u32
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    ) -> SparseWitnessRow
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
}

pub struct SparseRadixWitnessFamily {}
pub struct SparseCarryWitnessFamily {}
pub struct SparseProductWitnessFamily {}
pub struct SparseRoundWitnessFamily {}
pub struct SparseLinearWitnessFamily {}
pub struct SparseBoundaryWitnessFamily {}
pub struct SparsePaddingWitnessFamily {}

impl<const L: usize> SparseWitnessFamily<L> for SparseRadixWitnessFamily {
    const START: u32 = 0
    const ROWS: u32 = sparse_radix_task_count<L>()
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    ) -> SparseWitnessRow
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        decode_sparse_radix_witness_row<L, WORKSPACE_WORDS>(
            point,
            current,
            sparse_transition_task_at<L>(
                <SparseRadixWitnessFamily as SparseWitnessFamily<L>>::START + local_row,
            ),
            workspace,
        )
    }
}

impl<const L: usize> SparseWitnessFamily<L> for SparseCarryWitnessFamily {
    const START: u32 = sparse_radix_task_count<L>()
    const ROWS: u32 = sparse_carry_task_count<L>()
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    ) -> SparseWitnessRow
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        decode_sparse_carry_witness_row<L, WORKSPACE_WORDS>(
            sparse_transition_task_at<L>(
                <SparseCarryWitnessFamily as SparseWitnessFamily<L>>::START + local_row,
            ),
            workspace,
        )
    }
}

impl<const L: usize> SparseWitnessFamily<L> for SparseProductWitnessFamily {
    const START: u32 = sparse_radix_task_count<L>() + sparse_carry_task_count<L>()
    const ROWS: u32 = sparse_product_task_count<L>()
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    ) -> SparseWitnessRow
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        decode_sparse_product_witness_row<L, WORKSPACE_WORDS>(
            current,
            sparse_transition_task_at<L>(
                <SparseProductWitnessFamily as SparseWitnessFamily<L>>::START + local_row,
            ),
            workspace,
        )
    }
}

impl<const L: usize> SparseWitnessFamily<L> for SparseRoundWitnessFamily {
    const START: u32 = sparse_radix_task_count<L>()
        + sparse_carry_task_count<L>()
        + sparse_product_task_count<L>()
    const ROWS: u32 = sparse_round_task_count<L>()
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    ) -> SparseWitnessRow
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        decode_sparse_round_witness_row<L, WORKSPACE_WORDS>(
            current,
            sparse_transition_task_at<L>(
                <SparseRoundWitnessFamily as SparseWitnessFamily<L>>::START + local_row,
            ),
            workspace,
        )
    }
}

impl<const L: usize> SparseWitnessFamily<L> for SparseLinearWitnessFamily {
    const START: u32 = sparse_radix_task_count<L>()
        + sparse_carry_task_count<L>()
        + sparse_product_task_count<L>()
        + sparse_round_task_count<L>()
    const ROWS: u32 = sparse_linear_task_count<L>()
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    ) -> SparseWitnessRow
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        decode_sparse_linear_witness_row<L, WORKSPACE_WORDS>(
            point,
            sparse_transition_task_at<L>(
                <SparseLinearWitnessFamily as SparseWitnessFamily<L>>::START + local_row,
            ),
            workspace,
        )
    }
}

impl<const L: usize> SparseWitnessFamily<L> for SparseBoundaryWitnessFamily {
    const START: u32 = sparse_radix_task_count<L>()
        + sparse_carry_task_count<L>()
        + sparse_product_task_count<L>()
        + sparse_round_task_count<L>()
        + sparse_linear_task_count<L>()
    const ROWS: u32 = sparse_boundary_task_count<L>()
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    ) -> SparseWitnessRow
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        decode_sparse_boundary_witness_row<L, WORKSPACE_WORDS>(
            current,
            sparse_transition_task_at<L>(
                <SparseBoundaryWitnessFamily as SparseWitnessFamily<L>>::START + local_row,
            ),
            workspace,
        )
    }
}

impl<const L: usize> SparseWitnessFamily<L> for SparsePaddingWitnessFamily {
    const START: u32 = sparse_transition_task_count<L>()
    const ROWS: u32 = sparse_transition_trace_length<L>() - sparse_transition_task_count<L>()
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    ) -> SparseWitnessRow
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        complete_sparse_witness_row<L, WORKSPACE_WORDS>(
            empty_sparse_row<BabyBear>(),
            true,
            workspace,
        )
    }
}

/// Streaming interpretation of a canonical Fe record into one row of a
/// column-major GPU matrix. The derived `CanonicalWords` implementation owns
/// field order; this writer owns only physical placement.
struct ColumnMajorWordWriter<const ROWS: usize, const OUTPUT_WORDS: usize> {
    output: StorageBuffer<u32, OUTPUT_WORDS>,
    row: u32,
    column_start: u32,
    cursor: u32,
    width: u32,
    valid: bool,
}
impl<const ROWS: usize, const OUTPUT_WORDS: usize> core::marker::Copy for ColumnMajorWordWriter<
    ROWS,
    OUTPUT_WORDS,
> {}

impl<const ROWS: usize, const OUTPUT_WORDS: usize> ColumnMajorWordWriter<ROWS, OUTPUT_WORDS> {
    fn new(
        _ output: StorageBuffer<u32, OUTPUT_WORDS>,
        _ row: u32,
        _ column_start: u32,
        _ width: u32,
    ) -> Self {
        Self {
            output: output,
            row: row,
            column_start: column_start,
            cursor: 0,
            width: width,
            valid: row < ROWS.downcast_truncate(),
        }
    }

    fn finish(self) -> bool {
        self.valid && self.cursor == self.width
    }
}

impl<const ROWS: usize, const OUTPUT_WORDS: usize> WordSink for ColumnMajorWordWriter<
    ROWS,
    OUTPUT_WORDS,
> {
    fn write(self, _ value: u32) -> Self {
        if !self.valid || self.cursor >= self.width {
            return Self {
                output: self.output,
                row: self.row,
                column_start: self.column_start,
                cursor: self.cursor,
                width: self.width,
                valid: false,
            }
        }
        let column = self.column_start + self.cursor
        let index = column * ROWS.downcast_truncate() + self.row
        if index >= OUTPUT_WORDS.downcast_truncate() {
            return Self {
                output: self.output,
                row: self.row,
                column_start: self.column_start,
                cursor: self.cursor,
                width: self.width,
                valid: false,
            }
        }
        self.output.store(index: index, value: value)
        Self {
            output: self.output,
            row: self.row,
            column_start: self.column_start,
            cursor: self.cursor + 1,
            width: self.width,
            valid: true,
        }
    }

    fn reject(self) -> Self {
        Self {
            output: self.output,
            row: self.row,
            column_start: self.column_start,
            cursor: self.cursor,
            width: self.width,
            valid: false,
        }
    }
}

/// Canonical base-field embedding into `BabyBearExt4` storage. A caller emits
/// one BabyBear word, while the underlying sink receives the four canonical
/// extension coefficients `(value, 0, 0, 0)`. This lets deterministic plans
/// execute in the base field without constructing an extension-field array.
struct BabyBearExt4EmbeddingSink<W: WordSink> { writer: W }
impl<W: WordSink> core::marker::Copy for BabyBearExt4EmbeddingSink<W> {}

impl<W: WordSink> BabyBearExt4EmbeddingSink<W> {
    fn new(_ writer: W) -> Self {
        Self { writer: writer }
    }

    fn finish(self) -> W {
        self.writer
    }
}

impl<W: WordSink> WordSink for BabyBearExt4EmbeddingSink<W> {
    fn write(self, _ value: u32) -> Self {
        Self { writer: self.writer.write(value).write(0).write(0).write(0) }
    }

    fn reject(self) -> Self {
        Self { writer: self.writer.reject() }
    }
}

/// Streaming interpretation from one row of a column-major GPU matrix. It is
/// the read-side dual of `ColumnMajorWordWriter`, so later actor passes consume
/// the exact nominal records emitted by earlier passes.
struct ColumnMajorWordReader<const ROWS: usize, const INPUT_WORDS: usize> {
    input: StorageBuffer<u32, INPUT_WORDS>,
    row: u32,
    column_start: u32,
    cursor: u32,
    width: u32,
    valid: bool,
}
impl<const ROWS: usize, const INPUT_WORDS: usize> core::marker::Copy for ColumnMajorWordReader<
    ROWS,
    INPUT_WORDS,
> {}

impl<const ROWS: usize, const INPUT_WORDS: usize> ColumnMajorWordReader<ROWS, INPUT_WORDS> {
    fn new(
        _ input: StorageBuffer<u32, INPUT_WORDS>,
        _ row: u32,
        _ column_start: u32,
        _ width: u32,
    ) -> Self {
        Self {
            input: input,
            row: row,
            column_start: column_start,
            cursor: 0,
            width: width,
            valid: row < ROWS.downcast_truncate(),
        }
    }

    fn finish(self) -> bool {
        self.valid && self.cursor == self.width
    }
}

impl<const ROWS: usize, const INPUT_WORDS: usize> WordSource for ColumnMajorWordReader<
    ROWS,
    INPUT_WORDS,
> {
    fn read(self) -> WordRead<Self> {
        if !self.valid || self.cursor >= self.width {
            return WordRead {
                source: Self {
                    input: self.input,
                    row: self.row,
                    column_start: self.column_start,
                    cursor: self.cursor,
                    width: self.width,
                    valid: false,
                },
                value: 0,
            }
        }
        let column = self.column_start + self.cursor
        let index = column * ROWS.downcast_truncate() + self.row
        if index >= INPUT_WORDS.downcast_truncate() {
            return WordRead {
                source: Self {
                    input: self.input,
                    row: self.row,
                    column_start: self.column_start,
                    cursor: self.cursor,
                    width: self.width,
                    valid: false,
                },
                value: 0,
            }
        }
        WordRead {
            source: Self {
                input: self.input,
                row: self.row,
                column_start: self.column_start,
                cursor: self.cursor + 1,
                width: self.width,
                valid: true,
            },
            value: self.input.load(index: index),
        }
    }

    fn reject(self) -> Self {
        Self {
            input: self.input,
            row: self.row,
            column_start: self.column_start,
            cursor: self.cursor,
            width: self.width,
            valid: false,
        }
    }
}

fn decode_column_major_value<
    T: CanonicalWords + core::marker::Copy,
    const ROWS: usize,
    const INPUT_WORDS: usize,
>(
    _ initial: T,
    _ input: StorageBuffer<u32, INPUT_WORDS>,
    _ row: u32,
    _ column_start: u32,
) -> WorkspaceDecoded<T> {
    let mut value = initial
    let reader = decode_canonical_words(
        mut value,
        ColumnMajorWordReader<ROWS, INPUT_WORDS>::new(input, row, column_start, T::WORDS),
    )
    WorkspaceDecoded { value: value, valid: reader.finish() }
}

fn decode_default_column_major_value<
    T: CanonicalWords + core::marker::Copy + Default,
    const ROWS: usize,
    const INPUT_WORDS: usize,
>(
    _ input: StorageBuffer<u32, INPUT_WORDS>,
    _ row: u32,
    _ column_start: u32,
) -> WorkspaceDecoded<T> {
    let mut value = <T as Default>::default()
    let reader = decode_canonical_words(
        mut value,
        ColumnMajorWordReader<ROWS, INPUT_WORDS>::new(input, row, column_start, T::WORDS),
    )
    WorkspaceDecoded { value: value, valid: reader.finish() }
}

const CONTROL_WORDS: usize = <SparseControlRow<BabyBear> as CanonicalWords>::WORDS as usize
const CONTROL_PLAN_WORDS: usize = <SparseControlPlanWitness<
    BabyBear,
> as CanonicalWords>::WORDS as usize
const CONTROL_LINK_WORDS: usize = <SparseControlLinkPlanWitness<
    BabyBear,
> as CanonicalWords>::WORDS as usize
const WITNESS_WORDS: usize = <SparseTaskRow<BabyBear> as CanonicalWords>::WORDS as usize
const ARITHMETIC_PLAN_WORDS: usize = <SparseArithmeticPlanWitness<
    BabyBear,
> as CanonicalWords>::WORDS as usize
const ARITHMETIC_LINK_WORDS: usize = <SparseArithmeticLinkPlanWitness<
    BabyBear,
> as CanonicalWords>::WORDS as usize
const ROUND_PLAN_WORDS: usize = <SparseRoundPlanWitness<BabyBear> as CanonicalWords>::WORDS as usize
const LINEAR_PLAN_WORDS: usize = <SparseLinearPlanWitness<
    BabyBear,
> as CanonicalWords>::WORDS as usize
const BOUNDARY_PLAN_WORDS: usize = <SparseBoundaryPlanWitness<
    BabyBear,
> as CanonicalWords>::WORDS as usize

const CONTROL_START: usize = 0
const CONTROL_PLAN_START: usize = CONTROL_START + CONTROL_WORDS
const CONTROL_LINK_START: usize = CONTROL_PLAN_START + CONTROL_PLAN_WORDS
const WITNESS_START: usize = CONTROL_LINK_START + CONTROL_LINK_WORDS
const ARITHMETIC_PLAN_START: usize = WITNESS_START + WITNESS_WORDS
const ARITHMETIC_LINK_START: usize = ARITHMETIC_PLAN_START + ARITHMETIC_PLAN_WORDS
const ROUND_PLAN_START: usize = ARITHMETIC_LINK_START + ARITHMETIC_LINK_WORDS
const LINEAR_PLAN_START: usize = ROUND_PLAN_START + ROUND_PLAN_WORDS
const BOUNDARY_PLAN_START: usize = LINEAR_PLAN_START + LINEAR_PLAN_WORDS
static_assert(BOUNDARY_PLAN_START + BOUNDARY_PLAN_WORDS == SPARSE_BASE_AIR_FIELDS)

fn decode_stored_control<const L: usize, const TRACE: usize, const BASE_TRACE_WORDS: usize>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ row: u32,
) -> WorkspaceDecoded<SparseControlRow<BabyBear>>
where L > 1
{
    if row >= TRACE.downcast_truncate() {
        return WorkspaceDecoded { value: sparse_padding_control_row<BabyBear>(), valid: true }
    }
    decode_default_column_major_value<SparseControlRow<BabyBear>, TRACE, BASE_TRACE_WORDS>(
        base_trace,
        row,
        CONTROL_START.downcast_truncate(),
    )
}

fn decode_stored_witness<const TRACE: usize, const BASE_TRACE_WORDS: usize>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ row: u32,
) -> WorkspaceDecoded<SparseTaskRow<BabyBear>> {
    let initial = empty_sparse_row<BabyBear>()
    if row >= TRACE.downcast_truncate() {
        return WorkspaceDecoded { value: initial, valid: true }
    }
    decode_column_major_value<SparseTaskRow<BabyBear>, TRACE, BASE_TRACE_WORDS>(
        initial,
        base_trace,
        row,
        WITNESS_START.downcast_truncate(),
    )
}

fn decode_stored_arithmetic_plan<const TRACE: usize, const BASE_TRACE_WORDS: usize>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ row: u32,
) -> WorkspaceDecoded<SparseArithmeticPlanWitness<BabyBear>> {
    let initial = zero_sparse_arithmetic_plan_witness<BabyBear>()
    if row >= TRACE.downcast_truncate() {
        return WorkspaceDecoded { value: initial, valid: true }
    }
    decode_column_major_value<SparseArithmeticPlanWitness<BabyBear>, TRACE, BASE_TRACE_WORDS>(
        initial,
        base_trace,
        row,
        ARITHMETIC_PLAN_START.downcast_truncate(),
    )
}

/// Place one generated semantic family into the shared witness columns. Actor
/// passes select only the family type and a work grid; row bounds and task
/// identities remain derived from the scalar schedule.
pub fn write_sparse_witness_family_lane<
    F: SparseWitnessFamily<L>,
    const L: usize,
    const TRACE: usize,
    const WORKSPACE_WORDS: usize,
    const OUTPUT_WORDS: usize,
    const VALIDITY_WORDS: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ validity: StorageBuffer<u32, VALIDITY_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    {
        OUTPUT_WORDS == TRACE * SPARSE_BASE_AIR_FIELDS
    },
    {
        VALIDITY_WORDS == TRACE
    }
{
    let local_row = invocation.global.x
    if local_row >= F::ROWS {
        return
    }
    let row = F::START + local_row
    if row >= TRACE.downcast_truncate() {
        return
    }

    let decoded = F::decode<WORKSPACE_WORDS>(point, current, local_row, workspace)
    let writer = encode_canonical_words(
        ref decoded.value,
        ColumnMajorWordWriter<TRACE, OUTPUT_WORDS>::new(
            output,
            row,
            WITNESS_START.downcast_truncate(),
            WITNESS_WORDS.downcast_truncate(),
        ),
    )
    let valid = validity.load(index: row) == 1 && decoded.valid && writer.finish()
    validity.store(index: row, value: if valid { 1 } else { 0 })
}

const PRODUCT_INTERACTION_WORDS: usize = <SparseProductInteractionRow<
    BabyBearExt4,
> as CanonicalWords>::WORDS as usize
const ROUND_INTERACTION_WORDS: usize = <SparseRoundInteractionRow<
    BabyBearExt4,
> as CanonicalWords>::WORDS as usize
const LINEAR_INTERACTION_WORDS: usize = <SparseLinearInteractionRow<
    BabyBearExt4,
> as CanonicalWords>::WORDS as usize
const BOUNDARY_INTERACTION_WORDS: usize = <SparseBoundaryInteractionRow<
    BabyBearExt4,
> as CanonicalWords>::WORDS as usize
const PRODUCT_INTERACTION_START: usize = 0
const ROUND_INTERACTION_START: usize = PRODUCT_INTERACTION_START + PRODUCT_INTERACTION_WORDS
const LINEAR_INTERACTION_START: usize = ROUND_INTERACTION_START + ROUND_INTERACTION_WORDS
const BOUNDARY_INTERACTION_START: usize = LINEAR_INTERACTION_START + LINEAR_INTERACTION_WORDS
static_assert(BOUNDARY_INTERACTION_START + BOUNDARY_INTERACTION_WORDS
    == SPARSE_INTERACTION_AIR_FIELDS)

/// Compiler-derived field coordinates for the product interaction segment.
/// The storage interpreter streams the address plan into its nominal field
/// instead of materializing the plan as a private array.
struct ProductInteractionRegions {
    accumulator: Region<ProductInteractionRegions, BabyBearExt4>,
    inverses: Region<ProductInteractionRegions, [BabyBearExt4; 2]>,
    address_plan: Region<
        ProductInteractionRegions,
        QuadraticPlanWitness<BabyBearExt4, SPARSE_PRODUCT_ADDRESS_MULTIPLICATIONS>,
    >,
}
impl core::marker::Copy for ProductInteractionRegions {}
derive RegionSchema for ProductInteractionRegions using RegionSchemaProvider

const fn product_interaction_regions() -> ProductInteractionRegions {
    <ProductInteractionRegions as RegionSchema>::regions()
}

static_assert(<ProductInteractionRegions as RegionSchema>::WORDS as usize
    == PRODUCT_INTERACTION_WORDS)

fn encode_interaction_bus<T: CanonicalWords, const TRACE: usize, const INTERACTION_WORDS: usize>(
    _ value: ref T,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ row: u32,
    _ start: u32,
) -> bool {
    encode_canonical_words(
        ref value,
        ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(interaction, row, start, T::WORDS),
    )
        .finish()
}

/// Stream the product address plan and its two batch-inversion denominators
/// from one committed base row. The nominal inverse fields are deliberate
/// phase-local scratch until the shared scan replaces every denominator with
/// its inverse. No field inversion occurs in this per-row kernel.
pub fn prepare_sparse_product_interaction_denominator_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const BASE_TRACE_WORDS: usize,
    const CHALLENGE_OUTPUT_WORDS: usize,
    const INTERACTION_WORDS: usize,
    const VALIDITY_WORDS: usize,
>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ challenge_output: StorageBuffer<u32, CHALLENGE_OUTPUT_WORDS>,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ validity: StorageBuffer<u32, VALIDITY_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    {
        BASE_TRACE_WORDS >= TRACE * SPARSE_BASE_AIR_FIELDS
    },
    {
        CHALLENGE_OUTPUT_WORDS
            >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values())
    },
    {
        INTERACTION_WORDS >= TRACE * SPARSE_INTERACTION_AIR_FIELDS
    },
    {
        VALIDITY_WORDS >= TRACE
    }
{
    let row = invocation.global.x
    if row >= TRACE.downcast_truncate() {
        return
    }
    let batch = load_sparse_lde_interaction_challenge_batch<L, TRACE, LDE, CHALLENGE_OUTPUT_WORDS>(
        challenge_output,
    )
    let decoded_control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let decoded = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let control = decoded_control.value
    let row_value = decoded.value
    let regions = product_interaction_regions()
    let product_start: u32 = PRODUCT_INTERACTION_START.downcast_truncate()
    let plan_bounds = region_bounds(regions.address_plan)
    let plan_writer = ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(
        interaction,
        row,
        product_start + plan_bounds.start,
        plan_bounds.words,
    )
    let planned = sparse_product_copy_plan<
        QuadraticWordWitnessInterpreter<
            BabyBearExt4EmbeddingSink<ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>>,
            SPARSE_PRODUCT_ADDRESS_MULTIPLICATIONS,
        >,
        BabyBear,
        L,
    >(
        control,
        row_value,
        QuadraticWordWitnessInterpreter::new(BabyBearExt4EmbeddingSink::new(plan_writer)),
    )
    let ports: [SparseCopyPort<BabyBearExt4>; 2] = [
        sparse_copy_port_extension(planned.first),
        sparse_copy_port_extension(planned.second),
    ]
    let mut denominators = [BabyBearExt4::one(); 2]
    write_sparse_copy_interaction_batch_denominators<BabyBearExt4, 2>(
        batch.value.product,
        ref ports,
        mut denominators,
    )
    let zero = BabyBearExt4::zero()
    let accumulator_bounds = region_bounds(regions.accumulator)
    let accumulator_writer = encode_canonical_words(
        ref zero,
        ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(
            interaction,
            row,
            product_start + accumulator_bounds.start,
            accumulator_bounds.words,
        ),
    )
    let inverse_bounds = region_bounds(regions.inverses)
    let denominator_writer = encode_canonical_words(
        ref denominators,
        ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(
            interaction,
            row,
            product_start + inverse_bounds.start,
            inverse_bounds.words,
        ),
    )
    let plan_writer = planned.interpreter.finish().finish()
    let valid = batch.valid
        && decoded_control.valid
        && decoded.valid
        && accumulator_writer.finish()
        && denominator_writer.finish()
        && plan_writer.finish()
    validity.store(index: row, value: if valid { 1 } else { 0 })
}

/// Derive product-bus inverses and deltas from the committed base row. This
/// scalar-shaped placement remains only as a compile-scale regression while
/// the production actor moves to global batch inversion.
pub fn write_sparse_product_interaction_local_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const BASE_TRACE_WORDS: usize,
    const CHALLENGE_OUTPUT_WORDS: usize,
    const INTERACTION_WORDS: usize,
    const VALIDITY_WORDS: usize,
>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ challenge_output: StorageBuffer<u32, CHALLENGE_OUTPUT_WORDS>,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ validity: StorageBuffer<u32, VALIDITY_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    {
        BASE_TRACE_WORDS >= TRACE * SPARSE_BASE_AIR_FIELDS
    },
    {
        CHALLENGE_OUTPUT_WORDS
            >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values())
    },
    {
        INTERACTION_WORDS >= TRACE * SPARSE_INTERACTION_AIR_FIELDS
    },
    {
        VALIDITY_WORDS >= TRACE
    }
{
    let row = invocation.global.x
    if row >= TRACE.downcast_truncate() {
        return
    }
    let batch = load_sparse_lde_interaction_challenge_batch<L, TRACE, LDE, CHALLENGE_OUTPUT_WORDS>(
        challenge_output,
    )
    let decoded = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let control = sparse_control_row_at<BabyBearExt4, L>(row)
    let row_value = sparse_task_row_extension(decoded.value)
    let regions = product_interaction_regions()
    let product_start: u32 = PRODUCT_INTERACTION_START.downcast_truncate()
    let plan_bounds = region_bounds(regions.address_plan)
    let plan_writer = ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(
        interaction,
        row,
        product_start + plan_bounds.start,
        plan_bounds.words,
    )
    let planned = sparse_product_copy_plan<
        QuadraticWordWitnessInterpreter<
            ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>,
            SPARSE_PRODUCT_ADDRESS_MULTIPLICATIONS,
        >,
        BabyBearExt4,
        L,
    >(
        control,
        row_value,
        QuadraticWordWitnessInterpreter::new(plan_writer),
    )
    let ports: [SparseCopyPort<BabyBearExt4>; 2] = [planned.first, planned.second]
    let mut inverses = [BabyBearExt4::zero(); 2]
    write_sparse_copy_interaction_inverses<BabyBearExt4, 2>(
        batch.value.product,
        ref ports,
        mut inverses,
    )
    let delta = sparse_copy_interaction_delta<BabyBearExt4, 2>(ports, inverses)
    let accumulator_bounds = region_bounds(regions.accumulator)
    let accumulator_writer = encode_canonical_words(
        ref delta,
        ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(
            interaction,
            row,
            product_start + accumulator_bounds.start,
            accumulator_bounds.words,
        ),
    )
    let inverse_bounds = region_bounds(regions.inverses)
    let inverse_writer = encode_canonical_words(
        ref inverses,
        ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(
            interaction,
            row,
            product_start + inverse_bounds.start,
            inverse_bounds.words,
        ),
    )
    let plan_writer = planned.interpreter.finish()
    let valid = batch.valid
        && decoded.valid
        && sparse_copy_interaction_witness_valid<BabyBearExt4, 2>(
            batch.value.product,
            ports,
            inverses,
        )
        && accumulator_writer.finish()
        && inverse_writer.finish()
        && plan_writer.finish()
    validity.store(index: row, value: if valid { 1 } else { 0 })
}

/// Reinterpret the committed base-field round plan directly from trace
/// storage, then lift only its five ports into the extension-field interaction
/// bus. The authored plan executes once and no private plan or residual array
/// exists in this kernel.
pub fn write_sparse_round_interaction_local_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const BASE_TRACE_WORDS: usize,
    const CHALLENGE_OUTPUT_WORDS: usize,
    const INTERACTION_WORDS: usize,
    const VALIDITY_WORDS: usize,
>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ challenge_output: StorageBuffer<u32, CHALLENGE_OUTPUT_WORDS>,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ validity: StorageBuffer<u32, VALIDITY_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    {
        BASE_TRACE_WORDS >= TRACE * SPARSE_BASE_AIR_FIELDS
    },
    {
        CHALLENGE_OUTPUT_WORDS
            >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values())
    },
    {
        INTERACTION_WORDS >= TRACE * SPARSE_INTERACTION_AIR_FIELDS
    },
    {
        VALIDITY_WORDS >= TRACE
    }
{
    let row = invocation.global.x
    if row >= TRACE.downcast_truncate() {
        return
    }
    let batch = load_sparse_lde_interaction_challenge_batch<L, TRACE, LDE, CHALLENGE_OUTPUT_WORDS>(
        challenge_output,
    )
    let decoded_control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let decoded_next_control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(
        base_trace,
        row + 1,
    )
    let decoded = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let plan_reader = ColumnMajorWordReader<TRACE, BASE_TRACE_WORDS>::new(
        base_trace,
        row,
        ROUND_PLAN_START.downcast_truncate(),
        ROUND_PLAN_WORDS.downcast_truncate(),
    )
    let planned = sparse_round_copy_plan<
        QuadraticWordConstraintInterpreter<
            ColumnMajorWordReader<TRACE, BASE_TRACE_WORDS>,
            SPARSE_ROUND_PORT_MULTIPLICATIONS,
        >,
        BabyBear,
        L,
    >(
        decoded_control.value,
        decoded_next_control.value,
        decoded.value,
        QuadraticWordConstraintInterpreter::new(plan_reader),
    )
    let checked = planned.interpreter.finish()
    let ports: [SparseCopyPort<BabyBearExt4>; 5] = [
        sparse_copy_port_extension(planned.ports[0]),
        sparse_copy_port_extension(planned.ports[1]),
        sparse_copy_port_extension(planned.ports[2]),
        sparse_copy_port_extension(planned.ports[3]),
        sparse_copy_port_extension(planned.ports[4]),
    ]
    let mut inverses = [BabyBearExt4::zero(); 5]
    write_sparse_copy_interaction_inverses<BabyBearExt4, 5>(
        batch.value.round,
        ref ports,
        mut inverses,
    )
    let mut value = zero_sparse_interaction_trace_row().round
    value.accumulator = sparse_copy_interaction_delta<BabyBearExt4, 5>(ports, inverses)
    value.inverses = inverses
    let valid = validity.load(index: row) == 1
        && batch.valid
        && decoded_control.valid
        && decoded_next_control.valid
        && decoded.valid
        && checked.valid
        && checked.reader.finish()
        && sparse_copy_interaction_witness_valid<BabyBearExt4, 5>(
            batch.value.round,
            ports,
            inverses,
        )
        && encode_interaction_bus<
            SparseRoundInteractionRow<BabyBearExt4>,
            TRACE,
            INTERACTION_WORDS,
        >(
            ref value,
            interaction,
            row,
            ROUND_INTERACTION_START.downcast_truncate(),
        )
    validity.store(index: row, value: if valid { 1 } else { 0 })
}

pub fn write_sparse_linear_interaction_local_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const BASE_TRACE_WORDS: usize,
    const CHALLENGE_OUTPUT_WORDS: usize,
    const INTERACTION_WORDS: usize,
    const VALIDITY_WORDS: usize,
>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ challenge_output: StorageBuffer<u32, CHALLENGE_OUTPUT_WORDS>,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ validity: StorageBuffer<u32, VALIDITY_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    {
        BASE_TRACE_WORDS >= TRACE * SPARSE_BASE_AIR_FIELDS
    },
    {
        CHALLENGE_OUTPUT_WORDS
            >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values())
    },
    {
        INTERACTION_WORDS >= TRACE * SPARSE_INTERACTION_AIR_FIELDS
    },
    {
        VALIDITY_WORDS >= TRACE
    }
{
    let row = invocation.global.x
    if row >= TRACE.downcast_truncate() {
        return
    }
    let batch = load_sparse_lde_interaction_challenge_batch<L, TRACE, LDE, CHALLENGE_OUTPUT_WORDS>(
        challenge_output,
    )
    let decoded_control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let decoded_next_control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(
        base_trace,
        row + 1,
    )
    let decoded = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let arithmetic = decode_stored_arithmetic_plan<TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let plan_reader = ColumnMajorWordReader<TRACE, BASE_TRACE_WORDS>::new(
        base_trace,
        row,
        LINEAR_PLAN_START.downcast_truncate(),
        LINEAR_PLAN_WORDS.downcast_truncate(),
    )
    let planned = sparse_linear_copy_plan<
        QuadraticWordConstraintInterpreter<
            ColumnMajorWordReader<TRACE, BASE_TRACE_WORDS>,
            SPARSE_LINEAR_PORT_MULTIPLICATIONS,
        >,
        BabyBear,
        L,
    >(
        decoded_control.value,
        decoded_next_control.value,
        decoded.value,
        arithmetic.value,
        QuadraticWordConstraintInterpreter::new(plan_reader),
    )
    let checked = planned.interpreter.finish()
    let ports: [SparseCopyPort<BabyBearExt4>; 8] = [
        sparse_copy_port_extension(planned.ports[0]),
        sparse_copy_port_extension(planned.ports[1]),
        sparse_copy_port_extension(planned.ports[2]),
        sparse_copy_port_extension(planned.ports[3]),
        sparse_copy_port_extension(planned.ports[4]),
        sparse_copy_port_extension(planned.ports[5]),
        sparse_copy_port_extension(planned.ports[6]),
        sparse_copy_port_extension(planned.ports[7]),
    ]
    let mut inverses = [BabyBearExt4::zero(); 8]
    write_sparse_copy_interaction_inverses<BabyBearExt4, 8>(
        batch.value.linear,
        ref ports,
        mut inverses,
    )
    let mut value = zero_sparse_interaction_trace_row().linear
    value.accumulator = sparse_copy_interaction_delta<BabyBearExt4, 8>(ports, inverses)
    value.inverses = inverses
    let valid = validity.load(index: row) == 1
        && batch.valid
        && decoded_control.valid
        && decoded_next_control.valid
        && decoded.valid
        && arithmetic.valid
        && checked.valid
        && checked.reader.finish()
        && sparse_copy_interaction_witness_valid<BabyBearExt4, 8>(
            batch.value.linear,
            ports,
            inverses,
        )
        && encode_interaction_bus<
            SparseLinearInteractionRow<BabyBearExt4>,
            TRACE,
            INTERACTION_WORDS,
        >(
            ref value,
            interaction,
            row,
            LINEAR_INTERACTION_START.downcast_truncate(),
        )
    validity.store(index: row, value: if valid { 1 } else { 0 })
}

pub fn write_sparse_boundary_interaction_local_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const BASE_TRACE_WORDS: usize,
    const CHALLENGE_OUTPUT_WORDS: usize,
    const INTERACTION_WORDS: usize,
    const VALIDITY_WORDS: usize,
>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ challenge_output: StorageBuffer<u32, CHALLENGE_OUTPUT_WORDS>,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ validity: StorageBuffer<u32, VALIDITY_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    {
        BASE_TRACE_WORDS >= TRACE * SPARSE_BASE_AIR_FIELDS
    },
    {
        CHALLENGE_OUTPUT_WORDS
            >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values())
    },
    {
        INTERACTION_WORDS >= TRACE * SPARSE_INTERACTION_AIR_FIELDS
    },
    {
        VALIDITY_WORDS >= TRACE
    }
{
    let row = invocation.global.x
    if row >= TRACE.downcast_truncate() {
        return
    }
    let batch = load_sparse_lde_interaction_challenge_batch<L, TRACE, LDE, CHALLENGE_OUTPUT_WORDS>(
        challenge_output,
    )
    let decoded = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let control = sparse_control_row_at<BabyBearExt4, L>(row)
    let row_value = sparse_task_row_extension(decoded.value)
    let mut value = zero_sparse_interaction_trace_row().boundary
    write_sparse_boundary_interaction_row<BabyBearExt4, L>(
        batch.value.boundary,
        control,
        row_value,
        BabyBearExt4::zero(),
        mut value,
    )
    let evaluated = evaluate_sparse_boundary_interaction_row<BabyBearExt4, L>(
        BabyBearExt4::one(),
        batch.value.boundary,
        control,
        row_value,
        sparse_boundary_plan_witness<BabyBearExt4, L>(control, row_value),
        value,
    )
    value.accumulator = evaluated.delta
    let valid = validity.load(index: row) == 1
        && batch.valid
        && decoded.valid
        && evaluated.valid
        && evaluated.folded.is_zero()
        && encode_interaction_bus<
            SparseBoundaryInteractionRow<BabyBearExt4>,
            TRACE,
            INTERACTION_WORDS,
        >(
            ref value,
            interaction,
            row,
            BOUNDARY_INTERACTION_START.downcast_truncate(),
        )
    validity.store(index: row, value: if valid { 1 } else { 0 })
}

/// One semantic cut of the fixed AIR row. These implementations do not define
/// a second schema: their starts and widths are derived from the canonical
/// codecs of the row's nominal fields. The marker selects only physical shader
/// placement.
pub trait SparseBaseAirPartition {
    const INDEX: usize
    const START: usize
    const WORDS: usize
    fn encode<
        const L: usize,
        const TRACE: usize,
        const WORKSPACE_WORDS: usize,
        const BASE_TRACE_WORDS: usize,
        W: WordSink,
    >(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
        _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
        _ writer: W,
    ) -> PartitionEncoding<W>
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        {
            BASE_TRACE_WORDS == TRACE * SPARSE_BASE_AIR_FIELDS
        },
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
}

struct PartitionEncoding<W: WordSink> { writer: W, valid: bool }

pub struct SparseBaseControlPartition {}
impl SparseBaseAirPartition for SparseBaseControlPartition {
    const INDEX: usize = 0
    const START: usize = CONTROL_START
    const WORDS: usize = CONTROL_WORDS
    fn encode<
        const L: usize,
        const TRACE: usize,
        const WORKSPACE_WORDS: usize,
        const BASE_TRACE_WORDS: usize,
        W: WordSink,
    >(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
        _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
        _ writer: W,
    ) -> PartitionEncoding<W>
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        {
            BASE_TRACE_WORDS == TRACE * SPARSE_BASE_AIR_FIELDS
        },
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        let value = sparse_base_air_control_at<L>(row)
        PartitionEncoding { writer: encode_canonical_words(ref value, writer), valid: true }
    }
}

