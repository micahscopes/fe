impl<const L: usize> SparseWitnessFamily<L> for SparsePaddingWitnessFamily {
    const START: u32 = sparse_transition_task_count<L>()
    const ROWS: u32 = sparse_transition_trace_length<L>() - sparse_transition_task_count<L>()
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    ) -> SparseWitnessRow
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        complete_sparse_witness_row<L, WORKSPACE_WORDS>(
            empty_sparse_row<BabyBear>(),
            true,
            workspace,
        )
    }
}

/// Streaming interpretation of a canonical Fe record into one row of a
/// column-major GPU matrix. The derived `CanonicalWords` implementation owns
/// field order; this writer owns only physical placement.
struct ColumnMajorWordWriter<const ROWS: usize, const OUTPUT_WORDS: usize> {
    output: StorageBuffer<u32, OUTPUT_WORDS>,
    row: u32,
    column_start: u32,
    cursor: u32,
    width: u32,
    valid: bool,
}
impl<const ROWS: usize, const OUTPUT_WORDS: usize> core::marker::Copy for ColumnMajorWordWriter<
    ROWS,
    OUTPUT_WORDS,
> {}

impl<const ROWS: usize, const OUTPUT_WORDS: usize> ColumnMajorWordWriter<ROWS, OUTPUT_WORDS> {
    fn new(
        _ output: StorageBuffer<u32, OUTPUT_WORDS>,
        _ row: u32,
        _ column_start: u32,
        _ width: u32,
    ) -> Self {
        Self {
            output: output,
            row: row,
            column_start: column_start,
            cursor: 0,
            width: width,
            valid: row < ROWS.downcast_truncate(),
        }
    }

    fn finish(self) -> bool {
        self.valid && self.cursor == self.width
    }
}

impl<const ROWS: usize, const OUTPUT_WORDS: usize> WordSink for ColumnMajorWordWriter<
    ROWS,
    OUTPUT_WORDS,
> {
    fn write(self, _ value: u32) -> Self {
        if !self.valid || self.cursor >= self.width {
            return Self {
                output: self.output,
                row: self.row,
                column_start: self.column_start,
                cursor: self.cursor,
                width: self.width,
                valid: false,
            }
        }
        let column = self.column_start + self.cursor
        let index = column * ROWS.downcast_truncate() + self.row
        if index >= OUTPUT_WORDS.downcast_truncate() {
            return Self {
                output: self.output,
                row: self.row,
                column_start: self.column_start,
                cursor: self.cursor,
                width: self.width,
                valid: false,
            }
        }
        self.output.store(index: index, value: value)
        Self {
            output: self.output,
            row: self.row,
            column_start: self.column_start,
            cursor: self.cursor + 1,
            width: self.width,
            valid: true,
        }
    }

    fn reject(self) -> Self {
        Self {
            output: self.output,
            row: self.row,
            column_start: self.column_start,
            cursor: self.cursor,
            width: self.width,
            valid: false,
        }
    }
}

/// Canonical base-field embedding into `BabyBearExt4` storage. A caller emits
/// one BabyBear word, while the underlying sink receives the four canonical
/// extension coefficients `(value, 0, 0, 0)`. This lets deterministic plans
/// execute in the base field without constructing an extension-field array.
struct BabyBearExt4EmbeddingSink<W: WordSink> { writer: W }
impl<W: WordSink> core::marker::Copy for BabyBearExt4EmbeddingSink<W> {}

impl<W: WordSink> BabyBearExt4EmbeddingSink<W> {
    fn new(_ writer: W) -> Self {
        Self { writer: writer }
    }

    fn finish(self) -> W {
        self.writer
    }
}

impl<W: WordSink> WordSink for BabyBearExt4EmbeddingSink<W> {
    fn write(self, _ value: u32) -> Self {
        Self { writer: self.writer.write(value).write(0).write(0).write(0) }
    }

    fn reject(self) -> Self {
        Self { writer: self.writer.reject() }
    }
}

/// Streaming interpretation from one row of a column-major GPU matrix. It is
/// the read-side dual of `ColumnMajorWordWriter`, so later actor passes consume
/// the exact nominal records emitted by earlier passes.
struct ColumnMajorWordReader<const ROWS: usize, const INPUT_WORDS: usize> {
    input: StorageBuffer<u32, INPUT_WORDS>,
    row: u32,
    column_start: u32,
    cursor: u32,
    width: u32,
    valid: bool,
}
impl<const ROWS: usize, const INPUT_WORDS: usize> core::marker::Copy for ColumnMajorWordReader<
    ROWS,
    INPUT_WORDS,
> {}

impl<const ROWS: usize, const INPUT_WORDS: usize> ColumnMajorWordReader<ROWS, INPUT_WORDS> {
    fn new(
        _ input: StorageBuffer<u32, INPUT_WORDS>,
        _ row: u32,
        _ column_start: u32,
        _ width: u32,
    ) -> Self {
        Self {
            input: input,
            row: row,
            column_start: column_start,
            cursor: 0,
            width: width,
            valid: row < ROWS.downcast_truncate(),
        }
    }

    fn finish(self) -> bool {
        self.valid && self.cursor == self.width
    }
}

impl<const ROWS: usize, const INPUT_WORDS: usize> WordSource for ColumnMajorWordReader<
    ROWS,
    INPUT_WORDS,
> {
    fn read(self) -> WordRead<Self> {
        if !self.valid || self.cursor >= self.width {
            return WordRead {
                source: Self {
                    input: self.input,
                    row: self.row,
                    column_start: self.column_start,
                    cursor: self.cursor,
                    width: self.width,
                    valid: false,
                },
                value: 0,
            }
        }
        let column = self.column_start + self.cursor
        let index = column * ROWS.downcast_truncate() + self.row
        if index >= INPUT_WORDS.downcast_truncate() {
            return WordRead {
                source: Self {
                    input: self.input,
                    row: self.row,
                    column_start: self.column_start,
                    cursor: self.cursor,
                    width: self.width,
                    valid: false,
                },
                value: 0,
            }
        }
        WordRead {
            source: Self {
                input: self.input,
                row: self.row,
                column_start: self.column_start,
                cursor: self.cursor + 1,
                width: self.width,
                valid: true,
            },
            value: self.input.load(index: index),
        }
    }

    fn reject(self) -> Self {
        Self {
            input: self.input,
            row: self.row,
            column_start: self.column_start,
            cursor: self.cursor,
            width: self.width,
            valid: false,
        }
    }
}

/// Read a base-field word source as canonical extension-field coordinates.
/// This is the read-side dual of `BabyBearExt4EmbeddingSink`: the underlying
/// source advances once, followed by three denotational zero coefficients.
struct BabyBearExt4EmbeddingSource<R: WordSource> { reader: R, coefficient: u32 }
impl<R: WordSource> core::marker::Copy for BabyBearExt4EmbeddingSource<R> {}

impl<R: WordSource> BabyBearExt4EmbeddingSource<R> {
    fn new(_ reader: R) -> Self {
        Self { reader: reader, coefficient: 0 }
    }

    fn finish(self) -> R {
        self.reader
    }
}

impl<R: WordSource> WordSource for BabyBearExt4EmbeddingSource<R> {
    fn read(self) -> WordRead<Self> {
        if self.coefficient == 0 {
            let read = self.reader.read()
            return WordRead {
                source: Self { reader: read.source, coefficient: 1 },
                value: read.value,
            }
        }
        WordRead {
            source: Self {
                reader: self.reader,
                coefficient: if self.coefficient == 3 {
                    0
                } else {
                    self.coefficient + 1
                },
            },
            value: 0,
        }
    }

    fn reject(self) -> Self {
        Self { reader: self.reader.reject(), coefficient: self.coefficient }
    }
}

fn load_sparse_composition_accumulator<const LDE: usize, const OUTPUT_WORDS: usize>(
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ row: u32,
) -> SparseCompositionAccumulator
where LDE > 0, OUTPUT_WORDS >= sparse_composition_staging_words<LDE>()
{
    let mut accumulator = begin_sparse_composition_accumulator(false)
    let reader = decode_canonical_words(
        mut accumulator,
        ColumnMajorWordReader<LDE, OUTPUT_WORDS>::new(
            output,
            row,
            sparse_composition_accumulator_column().downcast_truncate(),
            <SparseCompositionAccumulator as CanonicalWords>::WORDS,
        ),
    )
    guard_sparse_composition_accumulator(accumulator, reader.finish())
}

fn store_sparse_composition_accumulator<const LDE: usize, const OUTPUT_WORDS: usize>(
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ row: u32,
    _ accumulator: ref SparseCompositionAccumulator,
) -> bool
where LDE > 0, OUTPUT_WORDS >= sparse_composition_staging_words<LDE>()
{
    encode_canonical_words(
        accumulator,
        ColumnMajorWordWriter<LDE, OUTPUT_WORDS>::new(
            output,
            row,
            sparse_composition_accumulator_column().downcast_truncate(),
            <SparseCompositionAccumulator as CanonicalWords>::WORDS,
        ),
    )
        .finish()
}

fn store_sparse_composition_value<const LDE: usize, const OUTPUT_WORDS: usize>(
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ row: u32,
    _ value: BabyBearExt4,
    _ valid: bool,
)
where LDE > 0, OUTPUT_WORDS >= sparse_composition_codeword_words<LDE>()
{
    let rows: u32 = LDE.downcast_truncate()
    output.store(index: row, value: value.coefficient_0().to_u32())
    output.store(index: rows + row, value: value.coefficient_1().to_u32())
    output.store(
            index: rows + rows + row,
            value: value.coefficient_2().to_u32(),
        )
    output.store(
            index: rows + rows + rows + row,
            value: value.coefficient_3().to_u32(),
        )
    let validity = rows * <BabyBearExt4 as CanonicalWords>::WORDS + row
    output.store(index: validity, value: if valid { 1 } else { 0 })
}

/// Evaluate the all-row control component from only the columns it denotes.
/// The canonical codecs derive both field offsets and widths. This is the
/// storage interpretation of `SparseControlAllRowsComposition`, not a second
/// constraint implementation.
pub fn write_sparse_control_all_rows_composition_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
    const BASE_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ shift: BabyBear,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ base: StorageBuffer<u32, BASE_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    {
        (TRACE & (TRACE - 1)) == 0
    },
    {
        radix2_field_domain_supported<TRACE, BabyBear>()
    },
    LDE > 0,
    LDE > TRACE,
    {
        (LDE & (LDE - 1)) == 0
    },
    {
        radix2_field_domain_supported<LDE, BabyBear>()
    },
    {
        (LDE % TRACE) == 0
    },
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    WORKSPACE_WORDS > 0,
    BASE_WORDS >= LDE * SPARSE_BASE_AIR_FIELDS,
    OUTPUT_WORDS >= sparse_composition_staging_words<LDE>()
{
    let row_index = invocation.global.x
    if row_index >= LDE.downcast_truncate() {
        return
    }
    let context = load_sparse_composition_phase_context<L, TRACE, LDE, WORKSPACE_WORDS>(workspace)

    let control = decode_embedded_column_major_value<
        SparseControlRow<BabyBearExt4>,
        LDE,
        BASE_WORDS,
    >(
        zero_sparse_trace_control_field<BabyBearExt4>(),
        base,
        row_index,
        CONTROL_START.downcast_truncate(),
    )
    let control_plan = decode_embedded_column_major_value<
        SparseControlPlanWitness<BabyBearExt4>,
        LDE,
        BASE_WORDS,
    >(
        zero_sparse_control_plan_witness<BabyBearExt4>(),
        base,
        row_index,
        CONTROL_PLAN_START.downcast_truncate(),
    )
    let lane_valid = context.valid
        && context.challenges.is_valid()
        && !shift.is_zero()
        && !shift.pow_u32(TRACE.downcast_truncate()).equals(BabyBear::one())
        && control.valid
        && control_plan.valid
    let evaluation = evaluate_sparse_control_all_rows_component(
        context.challenges.composition(),
        control.value,
        control_plan.value,
    )
    let accumulator = accumulate_sparse_composition_component<SparseControlAllRowsComposition>(
        begin_sparse_composition_accumulator(lane_valid),
        context.challenges.composition(),
        evaluation,
    )
    store_sparse_composition_accumulator<LDE, OUTPUT_WORDS>(output, row_index, ref accumulator)
}

/// Evaluate one adjacent-row control component from the canonical control and
/// link-plan projection. The component marker selects the denotation and its
/// position in the ordered fold; this interpreter owns only storage placement.
pub fn write_sparse_control_link_composition_lane<
    C: SparseControlLinkCompositionComponent,
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
    const BASE_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ shift: BabyBear,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ base: StorageBuffer<u32, BASE_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    {
        (TRACE & (TRACE - 1)) == 0
    },
    {
        radix2_field_domain_supported<TRACE, BabyBear>()
    },
    LDE > 0,
    LDE > TRACE,
    {
        (LDE & (LDE - 1)) == 0
    },
    {
        radix2_field_domain_supported<LDE, BabyBear>()
    },
    {
        (LDE % TRACE) == 0
    },
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    WORKSPACE_WORDS > 0,
    BASE_WORDS >= LDE * SPARSE_BASE_AIR_FIELDS,
    OUTPUT_WORDS >= sparse_composition_staging_words<LDE>()
{
    let row_index = invocation.global.x
    if row_index >= LDE.downcast_truncate() {
        return
    }
    let context = load_sparse_composition_phase_context<L, TRACE, LDE, WORKSPACE_WORDS>(workspace)
    let stride: u32 = (LDE / TRACE).downcast_truncate()
    let mut next_index = row_index + stride
    if next_index >= LDE.downcast_truncate() {
        next_index = next_index - LDE.downcast_truncate()
    }
    let current = decode_embedded_column_major_value<
        SparseControlRow<BabyBearExt4>,
        LDE,
        BASE_WORDS,
    >(
        zero_sparse_trace_control_field<BabyBearExt4>(),
        base,
        row_index,
        CONTROL_START.downcast_truncate(),
    )
    let next = decode_embedded_column_major_value<SparseControlRow<BabyBearExt4>, LDE, BASE_WORDS>(
        zero_sparse_trace_control_field<BabyBearExt4>(),
        base,
        next_index,
        CONTROL_START.downcast_truncate(),
    )
    let witness = decode_embedded_column_major_value<
        SparseControlLinkPlanWitness<BabyBearExt4>,
        LDE,
        BASE_WORDS,
    >(
        zero_sparse_control_link_plan_witness<BabyBearExt4>(),
        base,
        row_index,
        CONTROL_LINK_START.downcast_truncate(),
    )
    let lane_valid = context.valid
        && context.challenges.is_valid()
        && !shift.is_zero()
        && !shift.pow_u32(TRACE.downcast_truncate()).equals(BabyBear::one())
        && current.valid
        && next.valid
        && witness.valid
    let accumulator = guard_sparse_composition_accumulator(
        load_sparse_composition_accumulator<LDE, OUTPUT_WORDS>(output, row_index),
        lane_valid,
    )
    let evaluation = C::evaluate_control_link<L>(
        context.challenges.composition(),
        current.value,
        next.value,
        witness.value,
    )
    let accumulator = accumulate_sparse_composition_component<C>(
        accumulator,
        context.challenges.composition(),
        evaluation,
    )
    store_sparse_composition_accumulator<LDE, OUTPUT_WORDS>(output, row_index, ref accumulator)
}

/// Evaluate arithmetic constraints from their exact canonical base-row
/// projection. No interaction record or unrelated multiplication plan enters
/// this shader placement.
pub fn write_sparse_arithmetic_composition_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
    const BASE_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ shift: BabyBear,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ base: StorageBuffer<u32, BASE_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    {
        (TRACE & (TRACE - 1)) == 0
    },
    {
        radix2_field_domain_supported<TRACE, BabyBear>()
    },
    LDE > 0,
    LDE > TRACE,
    {
        (LDE & (LDE - 1)) == 0
    },
    {
        radix2_field_domain_supported<LDE, BabyBear>()
    },
    {
        (LDE % TRACE) == 0
    },
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    WORKSPACE_WORDS > 0,
    BASE_WORDS >= LDE * SPARSE_BASE_AIR_FIELDS,
    OUTPUT_WORDS >= sparse_composition_staging_words<LDE>()
{
    let row_index = invocation.global.x
    if row_index >= LDE.downcast_truncate() {
        return
    }
    let context = load_sparse_composition_phase_context<L, TRACE, LDE, WORKSPACE_WORDS>(workspace)
    let stride: u32 = (LDE / TRACE).downcast_truncate()
    let mut next_index = row_index + stride
    if next_index >= LDE.downcast_truncate() {
        next_index = next_index - LDE.downcast_truncate()
    }
    let control = decode_embedded_column_major_value<
        SparseControlRow<BabyBearExt4>,
        LDE,
        BASE_WORDS,
    >(
        zero_sparse_trace_control_field<BabyBearExt4>(),
        base,
        row_index,
        CONTROL_START.downcast_truncate(),
    )
    let witness = decode_embedded_column_major_value<SparseTaskRow<BabyBearExt4>, LDE, BASE_WORDS>(
        zero_sparse_trace_row_field<BabyBearExt4>(),
        base,
        row_index,
        WITNESS_START.downcast_truncate(),
    )
    let arithmetic_plan = decode_embedded_column_major_value<
        SparseArithmeticPlanWitness<BabyBearExt4>,
        LDE,
        BASE_WORDS,
    >(
        zero_sparse_arithmetic_plan_witness<BabyBearExt4>(),
        base,
        row_index,
        ARITHMETIC_PLAN_START.downcast_truncate(),
    )
    let arithmetic_link_plan = decode_embedded_column_major_value<
        SparseArithmeticLinkPlanWitness<BabyBearExt4>,
        LDE,
        BASE_WORDS,
    >(
        zero_sparse_arithmetic_link_plan_witness<BabyBearExt4>(),
        base,
        row_index,
        ARITHMETIC_LINK_START.downcast_truncate(),
    )
    let next_control = decode_embedded_column_major_value<
        SparseControlRow<BabyBearExt4>,
        LDE,
        BASE_WORDS,
    >(
        zero_sparse_trace_control_field<BabyBearExt4>(),
        base,
        next_index,
        CONTROL_START.downcast_truncate(),
    )
    let next_witness = decode_embedded_column_major_value<
        SparseTaskRow<BabyBearExt4>,
        LDE,
        BASE_WORDS,
    >(
        zero_sparse_trace_row_field<BabyBearExt4>(),
        base,
        next_index,
        WITNESS_START.downcast_truncate(),
    )
    let lane_valid = context.valid
        && context.challenges.is_valid()
        && !shift.is_zero()
        && !shift.pow_u32(TRACE.downcast_truncate()).equals(BabyBear::one())
        && control.valid
        && witness.valid
        && arithmetic_plan.valid
        && arithmetic_link_plan.valid
        && next_control.valid
        && next_witness.valid
    let accumulator = guard_sparse_composition_accumulator(
        load_sparse_composition_accumulator<LDE, OUTPUT_WORDS>(output, row_index),
        lane_valid,
    )
    let evaluation = evaluate_sparse_arithmetic_component<L>(
        context.challenges.composition(),
        control.value,
        witness.value,
        arithmetic_plan.value,
        next_control.value,
        next_witness.value,
