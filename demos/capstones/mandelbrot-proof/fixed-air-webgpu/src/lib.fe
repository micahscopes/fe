/// Evaluate the product copy-bus component from its exact base and
/// interaction projections. The transcript challenge remains inside the
/// authenticated composition context.
pub fn write_sparse_product_composition_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
    const BASE_WORDS: usize,
    const INTERACTION_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ shift: BabyBear,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ base: StorageBuffer<u32, BASE_WORDS>,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    {
        (TRACE & (TRACE - 1)) == 0
    },
    {
        radix2_field_domain_supported<TRACE, BabyBear>()
    },
    LDE > 0,
    LDE > TRACE,
    {
        (LDE & (LDE - 1)) == 0
    },
    {
        radix2_field_domain_supported<LDE, BabyBear>()
    },
    {
        (LDE % TRACE) == 0
    },
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    WORKSPACE_WORDS > 0,
    BASE_WORDS >= LDE * SPARSE_BASE_AIR_FIELDS,
    INTERACTION_WORDS >= LDE * SPARSE_INTERACTION_AIR_FIELDS,
    OUTPUT_WORDS >= sparse_composition_staging_words<LDE>()
{
    let row_index = invocation.global.x
    if row_index >= LDE.downcast_truncate() {
        return
    }
    let context = load_sparse_composition_phase_context<L, TRACE, LDE, WORKSPACE_WORDS>(workspace)
    let stride: u32 = (LDE / TRACE).downcast_truncate()
    let mut next_index = row_index + stride
    if next_index >= LDE.downcast_truncate() {
        next_index = next_index - LDE.downcast_truncate()
    }
    let control = decode_embedded_column_major_value<
        SparseControlRow<BabyBearExt4>,
        LDE,
        BASE_WORDS,
    >(
        zero_sparse_trace_control_field<BabyBearExt4>(),
        base,
        row_index,
        CONTROL_START.downcast_truncate(),
    )
    let witness = decode_embedded_column_major_value<SparseTaskRow<BabyBearExt4>, LDE, BASE_WORDS>(
        zero_sparse_trace_row_field<BabyBearExt4>(),
        base,
        row_index,
        WITNESS_START.downcast_truncate(),
    )
    let product = decode_column_major_value<
        SparseProductInteractionRow<BabyBearExt4>,
        LDE,
        INTERACTION_WORDS,
    >(
        zero_sparse_product_interaction_row<BabyBearExt4>(),
        interaction,
        row_index,
        PRODUCT_INTERACTION_START.downcast_truncate(),
    )
    let next_product = decode_column_major_value<
        SparseProductInteractionRow<BabyBearExt4>,
        LDE,
        INTERACTION_WORDS,
    >(
        zero_sparse_product_interaction_row<BabyBearExt4>(),
        interaction,
        next_index,
        PRODUCT_INTERACTION_START.downcast_truncate(),
    )
    let lane_valid = context.valid
        && context.challenges.is_valid()
        && !shift.is_zero()
        && !shift.pow_u32(TRACE.downcast_truncate()).equals(BabyBear::one())
        && control.valid
        && witness.valid
        && product.valid
        && next_product.valid
    let accumulator = guard_sparse_composition_accumulator(
        load_sparse_composition_accumulator<LDE, OUTPUT_WORDS>(output, row_index),
        lane_valid,
    )
    let evaluation = evaluate_sparse_product_component<L>(
        context.challenges.composition(),
        context.challenges.interaction().product,
        control.value,
        witness.value,
        product.value,
        next_product.value,
    )
    let accumulator = accumulate_sparse_composition_component<SparseProductComposition>(
        accumulator,
        context.challenges.composition(),
        evaluation,
    )
    store_sparse_composition_accumulator<LDE, OUTPUT_WORDS>(output, row_index, ref accumulator)
}

