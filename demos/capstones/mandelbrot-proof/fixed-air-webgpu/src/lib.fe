/// Compiler-derived storage layout for the seven arithmetic nodes of one
/// exact Mandelbrot transition. The record is the semantic dependency DAG;
/// its region interpretation decides only physical placement.
struct TransitionWitnessRegions<const L: usize> {
    xx: Region<TransitionWitnessRegions<L>, FixedProductWitness<L>>,
    yy: Region<TransitionWitnessRegions<L>, FixedProductWitness<L>>,
    xy: Region<TransitionWitnessRegions<L>, FixedProductWitness<L>>,
    real_difference: Region<TransitionWitnessRegions<L>, FixedLinearWitness<L>>,
    next_real: Region<TransitionWitnessRegions<L>, FixedLinearWitness<L>>,
    double_xy: Region<TransitionWitnessRegions<L>, FixedLinearWitness<L>>,
    next_imaginary: Region<TransitionWitnessRegions<L>, FixedLinearWitness<L>>,
    valid: Region<TransitionWitnessRegions<L>, u32>,
}
impl<const L: usize> core::marker::Copy for TransitionWitnessRegions<L> {}
derive RegionSchema for TransitionWitnessRegions<L> using RegionSchemaProvider

const fn transition_witness_regions<const L: usize>() -> TransitionWitnessRegions<L> {
    <TransitionWitnessRegions<L> as RegionSchema>::regions()
}

/// Phase-local authority retained after both sparse LDE trees are committed.
/// The region schema, rather than parallel offsets, owns the physical overlay
/// used by composition evaluation and the later receipt/FRI stages.
struct SparseCompositionPhaseRegions<const L: usize, const TRACE: usize, const LDE: usize> {
    base_root: Region<SparseCompositionPhaseRegions<L, TRACE, LDE>, Poseidon2Digest>,
    interaction_root: Region<SparseCompositionPhaseRegions<L, TRACE, LDE>, Poseidon2Digest>,
    seed: Region<
        SparseCompositionPhaseRegions<L, TRACE, LDE>,
        SparseCompositionChallengeSeed<L, TRACE, LDE>,
    >,
    challenges: Region<
        SparseCompositionPhaseRegions<L, TRACE, LDE>,
        SparseCompositionEvaluationChallenges,
    >,
    valid: Region<SparseCompositionPhaseRegions<L, TRACE, LDE>, u32>,
}
impl<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> core::marker::Copy for SparseCompositionPhaseRegions<L, TRACE, LDE> {}
derive RegionSchema for SparseCompositionPhaseRegions<L, TRACE, LDE> using RegionSchemaProvider

const fn sparse_composition_phase_regions<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>() -> SparseCompositionPhaseRegions<L, TRACE, LDE> {
    <SparseCompositionPhaseRegions<L, TRACE, LDE> as RegionSchema>::regions()
}

pub const fn sparse_composition_phase_workspace_words<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>() -> usize {
    <SparseCompositionPhaseRegions<L, TRACE, LDE> as RegionSchema>::WORDS as usize
}

pub const fn sparse_composition_phase_validity_word<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>() -> usize {
    region_bounds(sparse_composition_phase_regions<L, TRACE, LDE>().valid).start as usize
}

pub const fn sparse_composition_codeword_words<const LDE: usize>() -> usize {
    LDE * (<BabyBearExt4 as CanonicalWords>::WORDS as usize + 1)
}

const fn sparse_composition_accumulator_column() -> usize {
    <BabyBearExt4 as CanonicalWords>::WORDS as usize + 1
}

pub const fn sparse_composition_accumulator_words<const LDE: usize>() -> usize {
    LDE * <SparseCompositionAccumulator as CanonicalWords>::WORDS as usize
}

/// One buffer carries both the final column-major composition codeword and
/// the storage-backed affine folds used to derive it. Their column regions are
/// disjoint, so the final reduction never races another row's checkpoint.
pub const fn sparse_composition_staging_words<const LDE: usize>() -> usize {
    sparse_composition_codeword_words<LDE>() + sparse_composition_accumulator_words<LDE>()
}

pub const fn transition_witness_workspace_words<const L: usize>() -> usize {
    <TransitionWitnessRegions<L> as RegionSchema>::WORDS as usize
}

/// Preserve the generated transition witness while later phases carry one
/// independent validity receipt in the trailing word.
pub const fn transition_phase_workspace_words<const L: usize>() -> usize {
    transition_witness_workspace_words<L>() + 1
}

pub const fn transition_phase_receipt_word<const L: usize>() -> usize {
    transition_witness_workspace_words<L>()
}

pub fn store_transition_phase_receipt<const L: usize, const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ valid: bool,
)
where L > 1, { WORKSPACE_WORDS >= transition_phase_workspace_words<L>() }
{
    workspace
        .store(
            index: transition_phase_receipt_word<L>().downcast_truncate(),
            value: if valid { 1 } else { 0 },
        )
}

pub fn load_transition_phase_receipt<const L: usize, const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> bool
where L > 1, { WORKSPACE_WORDS >= transition_phase_workspace_words<L>() }
{
    workspace.load(
                index: transition_phase_receipt_word<L>().downcast_truncate(),
            ) == 1
}

/// Canonical-word interpreter into one compiler-derived GPU region.
struct WorkspaceWordWriter<Space, T, const STORAGE_WORDS: usize> {
    storage: StorageBuffer<u32, STORAGE_WORDS>,
    region: Region<Space, T>,
    cursor: u32,
    valid: bool,
}
impl<Space, T, const STORAGE_WORDS: usize> core::marker::Copy for WorkspaceWordWriter<
    Space,
    T,
    STORAGE_WORDS,
> {}

impl<Space: RegionSchema, T: CanonicalWords, const STORAGE_WORDS: usize> WorkspaceWordWriter<
    Space,
    T,
    STORAGE_WORDS,
> where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>() {
    fn new(_ storage: StorageBuffer<u32, STORAGE_WORDS>, _ region: Region<Space, T>) -> Self {
        Self { storage: storage, region: region, cursor: 0, valid: true }
    }

    fn finish(self) -> bool {
        self.valid && self.cursor == T::WORDS
    }
}

impl<
    Space: RegionSchema,
    T: CanonicalWords,
    const STORAGE_WORDS: usize,
> WordSink for WorkspaceWordWriter<Space, T, STORAGE_WORDS>
where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>() {
    fn write(self, _ value: u32) -> Self {
        let valid = self.valid && store_region_word(self.storage, self.region, self.cursor, value)
        Self { storage: self.storage, region: self.region, cursor: self.cursor + 1, valid: valid }
    }

    fn reject(self) -> Self {
        Self { storage: self.storage, region: self.region, cursor: self.cursor, valid: false }
    }
}

/// Canonical-word interpreter from one compiler-derived GPU region.
struct WorkspaceWordReader<Space, T, const STORAGE_WORDS: usize> {
    storage: StorageBuffer<u32, STORAGE_WORDS>,
    region: Region<Space, T>,
    cursor: u32,
    valid: bool,
}
impl<Space, T, const STORAGE_WORDS: usize> core::marker::Copy for WorkspaceWordReader<
    Space,
    T,
    STORAGE_WORDS,
> {}

impl<Space: RegionSchema, T: CanonicalWords, const STORAGE_WORDS: usize> WorkspaceWordReader<
    Space,
    T,
    STORAGE_WORDS,
> where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>() {
    fn new(_ storage: StorageBuffer<u32, STORAGE_WORDS>, _ region: Region<Space, T>) -> Self {
        Self { storage: storage, region: region, cursor: 0, valid: true }
    }

    fn finish(self) -> bool {
        self.valid && self.cursor == T::WORDS
    }
}

impl<
    Space: RegionSchema,
    T: CanonicalWords,
    const STORAGE_WORDS: usize,
> WordSource for WorkspaceWordReader<Space, T, STORAGE_WORDS>
where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>() {
    fn read(self) -> WordRead<Self> {
        let read = load_region_word(self.storage, self.region, self.cursor)
        WordRead {
            source: Self {
                storage: self.storage,
                region: self.region,
                cursor: self.cursor + 1,
                valid: self.valid && read.valid,
            },
            value: read.value,
        }
    }

    fn reject(self) -> Self {
        Self { storage: self.storage, region: self.region, cursor: self.cursor, valid: false }
    }
}

struct WorkspaceDecoded<T> { value: T, valid: bool }
impl<T: core::marker::Copy> core::marker::Copy for WorkspaceDecoded<T> {}

/// Read the generic squeeze batch as one nominal interaction-challenge
/// record. The derived codec owns field grouping and order. This placement
/// contributes only the leading validity word and skips the batch's trailing
/// per-value receipts.
struct SparseChallengeBatchReader<const OUTPUT_WORDS: usize> {
    output: StorageBuffer<u32, OUTPUT_WORDS>,
    cursor: u32,
    valid: bool,
}
impl<const OUTPUT_WORDS: usize> core::marker::Copy for SparseChallengeBatchReader<OUTPUT_WORDS> {}

impl<const OUTPUT_WORDS: usize> SparseChallengeBatchReader<OUTPUT_WORDS>
where { OUTPUT_WORDS >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values()) } {
    fn new(_ output: StorageBuffer<u32, OUTPUT_WORDS>) -> Self {
        Self { output: output, cursor: 0, valid: true }
    }

    fn finish(self) -> bool {
        self.valid && self.cursor == <SparseInteractionChallenges as CanonicalWords>::WORDS
    }
}

impl<const OUTPUT_WORDS: usize> WordSource for SparseChallengeBatchReader<OUTPUT_WORDS>
where { OUTPUT_WORDS >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values()) } {
    fn read(self) -> WordRead<Self> {
        let words = <SparseInteractionChallenges as CanonicalWords>::WORDS
        if !self.valid || self.cursor >= words {
            return WordRead {
                source: Self { output: self.output, cursor: self.cursor, valid: false },
                value: 0,
            }
        }
        if self.cursor == 0 {
            return WordRead {
                source: Self { output: self.output, cursor: 1, valid: true },
                value: 1,
            }
        }
        let coefficient_word = self.cursor - 1
        let coefficient_words = <BabyBearExt4 as CanonicalWords>::WORDS
        let state = coefficient_word / coefficient_words
        let valid_start: u32 = digest_squeeze_batch_output_valid_start(
            sparse_interaction_challenge_values(),
        )
            .downcast_truncate()
        WordRead {
            source: Self {
                output: self.output,
                cursor: self.cursor + 1,
                valid: state < sparse_interaction_challenge_values().downcast_truncate()
                    && self.output.load(index: valid_start + state) == 1,
            },
            value: self.output.load(index: coefficient_word),
        }
    }

    fn reject(self) -> Self {
        Self { output: self.output, cursor: self.cursor, valid: false }
    }
}

/// Production-domain authority decoded from the root-derived squeeze batch.
/// The payload stays private so later placement APIs cannot accept a raw
/// array of quartic values as an equivalent transcript source.
pub struct SparseLdeInteractionChallengeBatch<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> { valid: bool, value: SparseInteractionChallenges }
impl<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> core::marker::Copy for SparseLdeInteractionChallengeBatch<L, TRACE, LDE> {}

pub fn load_sparse_lde_interaction_challenge_batch<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const OUTPUT_WORDS: usize,
>(_ output: StorageBuffer<u32, OUTPUT_WORDS>) -> SparseLdeInteractionChallengeBatch<L, TRACE, LDE>
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    {
        OUTPUT_WORDS >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values())
    }
{
    let mut value = zero_sparse_interaction_challenges()
    let reader = decode_canonical_words(
        mut value,
        SparseChallengeBatchReader<OUTPUT_WORDS>::new(output),
    )
    SparseLdeInteractionChallengeBatch { valid: reader.finish() && value.valid, value: value }
}

pub fn sparse_lde_interaction_challenge_batch_is_valid<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(_ batch: SparseLdeInteractionChallengeBatch<L, TRACE, LDE>) -> bool {
    batch.valid && batch.value.valid
}

fn decode_workspace_value<
    Space: RegionSchema,
    T: CanonicalWords + core::marker::Copy,
    const STORAGE_WORDS: usize,
>(
    _ initial: T,
    _ storage: StorageBuffer<u32, STORAGE_WORDS>,
    _ region: Region<Space, T>,
) -> WorkspaceDecoded<T>
where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>()
{
    let mut value = initial
    let reader = decode_canonical_words(
        mut value,
        WorkspaceWordReader<Space, T, STORAGE_WORDS>::new(storage, region),
    )
    WorkspaceDecoded { value: value, valid: reader.finish() }
}

fn encode_workspace_value<Space: RegionSchema, T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ value: ref T,
    _ storage: StorageBuffer<u32, STORAGE_WORDS>,
    _ region: Region<Space, T>,
) -> bool
where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>()
{
    encode_canonical_words(
        ref value,
        WorkspaceWordWriter<Space, T, STORAGE_WORDS>::new(storage, region),
    )
        .finish()
}

/// Persist one authenticated composition context after the AIR roots and
/// security profile have been bound. Later workgroups receive only this
/// nominal carrier, never a raw array of host-supplied challenge words.
pub fn store_sparse_composition_phase_context<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
>(
    _ composition: SparseCompositionTranscriptDigest<L, TRACE, LDE>,
    _ interval: OrbitInterval<L>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> bool
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    WORKSPACE_WORDS > 0,
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    Limbs<L>: TruncRows<
        Limbs<L>,
    > + Mac + ShiftAppend + Head + Carry + Zero + SubBorrow + Select + Top + OrLower + core::marker::Copy
{
    let regions = sparse_composition_phase_regions<L, TRACE, LDE>()
    let challenges = sparse_bound_composition_evaluation_challenges(composition, interval)
    let base = composition.base().value
    let interaction = composition.interaction().value
    let seed = sparse_composition_challenge_seed(composition, interval)
    let mut valid = composition.is_valid() && challenges.is_valid()
    valid = encode_workspace_value(ref base, workspace, regions.base_root) && valid
    valid = encode_workspace_value(ref interaction, workspace, regions.interaction_root) && valid
    valid = encode_workspace_value(ref seed, workspace, regions.seed) && valid
    valid = encode_workspace_value(ref challenges, workspace, regions.challenges) && valid
    let valid_word: u32 = if valid { 1 } else { 0 }
    encode_workspace_value(ref valid_word, workspace, regions.valid) && valid
}

/// Rebrand the two roots produced by storage-resident ordered trees, bind the
/// exact recursive leaf statement, and persist the resulting composition
/// authority. Raw roots cross into the proof protocol only through this one
/// checked boundary.
pub fn store_sparse_composition_phase_context_from_committed_roots<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
>(
    _ interval: OrbitInterval<L>,
    _ base_root: Poseidon2Digest,
    _ interaction_root: Poseidon2Digest,
    _ roots_valid: bool,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> bool
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    WORKSPACE_WORDS > 0,
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    Limbs<L>: TruncRows<
        Limbs<L>,
    > + Mac + ShiftAppend + Head + Carry + Zero + SubBorrow + Select + Top + OrLower + core::marker::Copy
{
    let composition = sparse_composition_transcript_from_committed_roots<L, TRACE, LDE>(
        interval,
        base_root,
        interaction_root,
        roots_valid,
    )
    store_sparse_composition_phase_context(composition, interval, workspace)
}

/// Stage the two authenticated AIR roots without deriving transcript
/// challenges in the same GPU function that finishes a Merkle tree. This
/// queue-ordered boundary keeps the tree scratch frame and transcript scratch
/// frame disjoint while preserving one typed workspace layout.
pub fn stage_sparse_composition_phase_roots<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
>(
    _ base_root: Poseidon2Digest,
    _ interaction_root: Poseidon2Digest,
    _ roots_valid: bool,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> bool
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    WORKSPACE_WORDS > 0,
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let regions = sparse_composition_phase_regions<L, TRACE, LDE>()
    let mut valid = roots_valid
    valid = encode_workspace_value(ref base_root, workspace, regions.base_root) && valid
    valid = encode_workspace_value(ref interaction_root, workspace, regions.interaction_root)
        && valid
    let valid_word: u32 = if valid { 1 } else { 0 }
    encode_workspace_value(ref valid_word, workspace, regions.valid) && valid
}

/// Bind the statement and staged roots into one opaque challenge seed. The
/// following pass derives challenges from this compact authority, keeping the
/// two transcript operations in disjoint private-memory frames.
pub fn bind_sparse_composition_phase_seed<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
>(_ interval: OrbitInterval<L>, _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>) -> bool
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    WORKSPACE_WORDS > 0,
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    Limbs<L>: TruncRows<
        Limbs<L>,
    > + Mac + ShiftAppend + Head + Carry + Zero + SubBorrow + Select + Top + OrLower + core::marker::Copy
{
    let regions = sparse_composition_phase_regions<L, TRACE, LDE>()
    let base_root = decode_workspace_value(Poseidon2Digest::zero(), workspace, regions.base_root)
    let interaction_root = decode_workspace_value(
        Poseidon2Digest::zero(),
        workspace,
        regions.interaction_root,
    )
    let staged_valid = load_region_word(workspace, regions.valid, 0)
    let roots_valid = staged_valid.valid
        && staged_valid.value == 1
        && base_root.valid
        && interaction_root.valid
    let composition = sparse_composition_transcript_from_committed_roots<L, TRACE, LDE>(
        interval,
        base_root.value,
        interaction_root.value,
        roots_valid,
    )
    let seed = sparse_composition_challenge_seed(composition, interval)
    let valid = composition.is_valid()
        && seed.is_valid()
        && encode_workspace_value(ref seed, workspace, regions.seed)
    let valid_word: u32 = if valid { 1 } else { 0 }
    encode_workspace_value(ref valid_word, workspace, regions.valid) && valid
}

/// Derive and persist the per-row composition challenges from the bound seed.
pub fn finish_sparse_composition_phase_context<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
>(_ workspace: StorageBuffer<u32, WORKSPACE_WORDS>) -> bool
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    WORKSPACE_WORDS > 0,
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let regions = sparse_composition_phase_regions<L, TRACE, LDE>()
    let seed = decode_workspace_value(
        zero_sparse_composition_challenge_seed<L, TRACE, LDE>(),
        workspace,
        regions.seed,
    )
    let staged_valid = load_region_word(workspace, regions.valid, 0)
    let challenges = sparse_composition_evaluation_challenges_from_seed(seed.value)
    let valid = staged_valid.valid
        && staged_valid.value == 1
        && seed.valid
        && seed.value.is_valid()
        && challenges.is_valid()
        && encode_workspace_value(ref challenges, workspace, regions.challenges)
    let valid_word: u32 = if valid { 1 } else { 0 }
    encode_workspace_value(ref valid_word, workspace, regions.valid) && valid
}

/// Private source-branded view recovered from the phase workspace. Public
/// placement entry points can consume this type, but application code cannot
/// manufacture one from a raw challenge tuple.
struct SparseCompositionPhaseContext<const L: usize, const TRACE: usize, const LDE: usize> {
    valid: bool,
    challenges: SparseCompositionEvaluationChallenges,
}
impl<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> core::marker::Copy for SparseCompositionPhaseContext<L, TRACE, LDE> {}

fn load_sparse_composition_phase_context<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
>(_ workspace: StorageBuffer<u32, WORKSPACE_WORDS>) -> SparseCompositionPhaseContext<L, TRACE, LDE>
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    WORKSPACE_WORDS > 0,
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let regions = sparse_composition_phase_regions<L, TRACE, LDE>()
    let challenges = decode_workspace_value(
        zero_sparse_composition_evaluation_challenges(),
        workspace,
        regions.challenges,
    )
    let valid = load_region_word(workspace, regions.valid, 0)
    SparseCompositionPhaseContext {
        valid: challenges.valid && challenges.value.is_valid() && valid.valid && valid.value == 1,
        challenges: challenges.value,
    }
}

fn product_workspace_region<const L: usize>(
    _ node: ProductNode,
    _ regions: TransitionWitnessRegions<L>,
) -> Region<TransitionWitnessRegions<L>, FixedProductWitness<L>> {
    match node {
        ProductNode::Xx => regions.xx,
        ProductNode::Yy => regions.yy,
        ProductNode::Xy => regions.xy,
        ProductNode::Invalid => regions.xx,
    }
}

fn linear_workspace_region<const L: usize>(
    _ node: LinearNode,
    _ regions: TransitionWitnessRegions<L>,
) -> Region<TransitionWitnessRegions<L>, FixedLinearWitness<L>> {
    match node {
        LinearNode::RealDifference => regions.real_difference,
        LinearNode::NextReal => regions.next_real,
        LinearNode::DoubleXy => regions.double_xy,
        LinearNode::NextImaginary => regions.next_imaginary,
        LinearNode::Invalid => regions.real_difference,
    }
}

fn decode_product_node<const L: usize, const WORKSPACE_WORDS: usize>(
    _ node: ProductNode,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> WorkspaceDecoded<FixedProductWitness<L>>
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node_valid = match node {
        ProductNode::Invalid => false,
        _ => true,
    }
    let decoded = decode_workspace_value(
        empty_product_witness<L>(),
        workspace,
        product_workspace_region(node, transition_witness_regions<L>()),
    )
    WorkspaceDecoded { value: decoded.value, valid: node_valid && decoded.valid }
}

fn decode_linear_node<const L: usize, const WORKSPACE_WORDS: usize>(
    _ node: LinearNode,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> WorkspaceDecoded<FixedLinearWitness<L>>
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node_valid = match node {
        LinearNode::Invalid => false,
        _ => true,
    }
    let decoded = decode_workspace_value(
        empty_linear_witness<L>(),
        workspace,
        linear_workspace_region(node, transition_witness_regions<L>()),
    )
    WorkspaceDecoded { value: decoded.value, valid: node_valid && decoded.valid }
}

struct DecodedFixed<const L: usize> { value: Fixed<L>, valid: bool }
impl<const L: usize> core::marker::Copy for DecodedFixed<L> {}

struct DecodedDigits<const L: usize> { digits: [u32; L], negative: bool, valid: bool }
impl<const L: usize> core::marker::Copy for DecodedDigits<L> {}

fn product_left<const L: usize>(_ node: ProductNode, _ current: ComplexFixed<L>) -> Fixed<L> {
    match node {
        ProductNode::Xx => current.real,
        ProductNode::Yy => current.imaginary,
        ProductNode::Xy => current.real,
        ProductNode::Invalid => current.real,
    }
}

fn product_right<const L: usize>(_ node: ProductNode, _ current: ComplexFixed<L>) -> Fixed<L> {
    match node {
        ProductNode::Xx => current.real,
        ProductNode::Yy => current.imaginary,
        ProductNode::Xy => current.imaginary,
        ProductNode::Invalid => current.real,
    }
}

fn decode_next_coordinate<const L: usize, const WORKSPACE_WORDS: usize>(
    _ coordinate: CoordinateNode,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> DecodedFixed<L>
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node = match coordinate {
        CoordinateNode::Real => LinearNode::NextReal,
        CoordinateNode::Imaginary => LinearNode::NextImaginary,
        CoordinateNode::Invalid => LinearNode::Invalid,
    }
    let decoded = decode_linear_node(node, workspace)
    DecodedFixed { value: decoded.value.output, valid: decoded.valid }
}

fn decode_linear_left<const L: usize, const WORKSPACE_WORDS: usize>(
    _ node: LinearNode,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> DecodedFixed<L>
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    match node {
        LinearNode::RealDifference => {
            let product = decode_product_node(ProductNode::Xx, workspace)
            DecodedFixed { value: product.value.output, valid: product.valid }
        },
        LinearNode::NextReal => {
            let linear = decode_linear_node(LinearNode::RealDifference, workspace)
            DecodedFixed { value: linear.value.output, valid: linear.valid }
        },
        LinearNode::DoubleXy => {
            let product = decode_product_node(ProductNode::Xy, workspace)
            DecodedFixed { value: product.value.output, valid: product.valid }
        },
        LinearNode::NextImaginary => {
            let linear = decode_linear_node(LinearNode::DoubleXy, workspace)
            DecodedFixed { value: linear.value.output, valid: linear.valid }
        },
        LinearNode::Invalid => DecodedFixed {
            value: Fixed { negative: false, limbs: [0; L] },
            valid: false,
        },
    }
}

fn decode_linear_right<const L: usize, const WORKSPACE_WORDS: usize>(
    _ node: LinearNode,
    _ point: ComplexFixed<L>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> DecodedFixed<L>
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    match node {
        LinearNode::RealDifference => {
            let product = decode_product_node(ProductNode::Yy, workspace)
            DecodedFixed { value: product.value.output, valid: product.valid }
        },
        LinearNode::NextReal => DecodedFixed { value: point.real, valid: true },
        LinearNode::DoubleXy => {
            let product = decode_product_node(ProductNode::Xy, workspace)
            DecodedFixed { value: product.value.output, valid: product.valid }
        },
        LinearNode::NextImaginary => DecodedFixed { value: point.imaginary, valid: true },
        LinearNode::Invalid => DecodedFixed {
            value: Fixed { negative: false, limbs: [0; L] },
            valid: false,
        },
    }
}

/// First parallel layer of the recurrence DAG. Three invocations derive
/// `x*x`, `y*y`, and `x*y` independently and write the same canonical witness
/// records consumed by the scalar AIR.
pub fn write_transition_product_witness_lane<const L: usize, const WORKSPACE_WORDS: usize>(
    _ current: ComplexFixed<L>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let lane = invocation.global.x
    if lane >= 3 { return }
    let regions = transition_witness_regions<L>()
    let (left, right, region) = match lane {
        0 => (current.real, current.real, regions.xx),
        1 => (current.imaginary, current.imaginary, regions.yy),
        _ => (current.real, current.imaginary, regions.xy),
    }
    let witness = derive_fixed_product_witness(left, right)
    encode_workspace_value(ref witness, workspace, region)
}

/// Second parallel layer. The real difference depends on `x*x` and `y*y`;
/// doubled `x*y` is independent and occupies the sibling lane.
pub fn write_transition_primary_linear_witness_lane<const L: usize, const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let lane = invocation.global.x
    if lane >= 2 { return }
    let regions = transition_witness_regions<L>()
    let xx = decode_workspace_value(empty_product_witness<L>(), workspace, regions.xx)
    let yy = decode_workspace_value(empty_product_witness<L>(), workspace, regions.yy)
    let xy = decode_workspace_value(empty_product_witness<L>(), workspace, regions.xy)
    let (left, right, subtract_right, region, dependencies_valid) = if lane == 0 {
        (xx.value.output, yy.value.output, true, regions.real_difference, xx.valid && yy.valid)
    } else {
        (xy.value.output, xy.value.output, false, regions.double_xy, xy.valid)
    }
    let witness = derive_fixed_linear_witness(left, right, subtract_right)
    if dependencies_valid {
        encode_workspace_value(ref witness, workspace, region)
    }
}

/// Third parallel layer. The two public-coordinate additions depend on
/// disjoint primary linear nodes and therefore share one two-lane dispatch.
pub fn write_transition_final_linear_witness_lane<const L: usize, const WORKSPACE_WORDS: usize>(
    _ point: ComplexFixed<L>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let lane = invocation.global.x
    if lane >= 2 { return }
    let regions = transition_witness_regions<L>()
    let difference = decode_workspace_value(
        empty_linear_witness<L>(),
        workspace,
        regions.real_difference,
    )
    let doubled = decode_workspace_value(empty_linear_witness<L>(), workspace, regions.double_xy)
    let (left, right, region, dependency_valid) = if lane == 0 {
        (difference.value.output, point.real, regions.next_real, difference.valid)
    } else {
        (doubled.value.output, point.imaginary, regions.next_imaginary, doubled.valid)
    }
    let witness = derive_fixed_sum_witness(left, right)
    if dependency_valid {
        encode_workspace_value(ref witness, workspace, region)
    }
}

fn workspace_region_is_valid<Space: RegionSchema, T: CanonicalWords, const STORAGE_WORDS: usize>(
    _ storage: StorageBuffer<u32, STORAGE_WORDS>,
    _ region: Region<Space, T>,
) -> bool
where STORAGE_WORDS > 0, Space::WORDS <= storage_word_capacity<STORAGE_WORDS>()
{
    let word = load_region_word(storage, region, 0)
    word.valid && word.value == 1
}

/// Close the recurrence DAG after all seven arithmetic records have been
/// produced. Canonical witness codecs place their validity word first, so this
/// pass reads one word per dependency instead of reconstructing the aggregate.
pub fn finish_transition_witness_workspace<const L: usize, const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    if invocation.global.x != 0 {
        return
    }
    let regions = transition_witness_regions<L>()
    let valid = workspace_region_is_valid(workspace, regions.xx)
        && workspace_region_is_valid(workspace, regions.yy)
        && workspace_region_is_valid(workspace, regions.xy)
        && workspace_region_is_valid(workspace, regions.real_difference)
        && workspace_region_is_valid(workspace, regions.next_real)
        && workspace_region_is_valid(workspace, regions.double_xy)
        && workspace_region_is_valid(workspace, regions.next_imaginary)
    store_region_word(workspace, regions.valid, 0, if valid { 1 } else { 0 })
}

fn transition_workspace_is_valid<const L: usize, const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> bool
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    workspace_region_is_valid(workspace, transition_witness_regions<L>().valid)
}

fn decode_range_node<const L: usize, const WORKSPACE_WORDS: usize>(
    _ node: RangeNode,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> DecodedDigits<L>
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    match node {
        RangeNode::PointReal => DecodedDigits {
            digits: point.real.limbs,
            negative: point.real.negative,
            valid: true,
        },
        RangeNode::PointImaginary => DecodedDigits {
            digits: point.imaginary.limbs,
            negative: point.imaginary.negative,
            valid: true,
        },
        RangeNode::CurrentReal => DecodedDigits {
            digits: current.real.limbs,
            negative: current.real.negative,
            valid: true,
        },
        RangeNode::CurrentImaginary => DecodedDigits {
            digits: current.imaginary.limbs,
            negative: current.imaginary.negative,
            valid: true,
        },
        RangeNode::NextReal => {
            let decoded = decode_next_coordinate(CoordinateNode::Real, workspace)
            DecodedDigits {
                digits: decoded.value.limbs,
                negative: decoded.value.negative,
                valid: decoded.valid,
            }
        },
        RangeNode::NextImaginary => {
            let decoded = decode_next_coordinate(CoordinateNode::Imaginary, workspace)
            DecodedDigits {
                digits: decoded.value.limbs,
                negative: decoded.value.negative,
                valid: decoded.valid,
            }
        },
        RangeNode::ProductLow(product,) => {
            let decoded = decode_product_node(product, workspace)
            DecodedDigits {
                digits: decoded.value.low_digits,
                negative: false,
                valid: decoded.valid,
            }
        },
        RangeNode::ProductHigh(product,) => {
            let decoded = decode_product_node(product, workspace)
            DecodedDigits {
                digits: decoded.value.high_digits,
                negative: false,
                valid: decoded.valid,
            }
        },
        RangeNode::ProductOutput(product,) => {
            let decoded = decode_product_node(product, workspace)
            DecodedDigits {
                digits: decoded.value.output.limbs,
                negative: decoded.value.output.negative,
                valid: decoded.valid,
            }
        },
        RangeNode::LinearSum(linear,) => {
            let decoded = decode_linear_node(linear, workspace)
            DecodedDigits {
                digits: decoded.value.sum_digits,
                negative: false,
                valid: decoded.valid,
            }
        },
        RangeNode::LinearLeftDifference(linear,) => {
            let decoded = decode_linear_node(linear, workspace)
            DecodedDigits {
                digits: decoded.value.left_difference_digits,
                negative: false,
                valid: decoded.valid,
            }
        },
        RangeNode::LinearRightDifference(linear,) => {
            let decoded = decode_linear_node(linear, workspace)
            DecodedDigits {
                digits: decoded.value.right_difference_digits,
                negative: false,
                valid: decoded.valid,
            }
        },
        RangeNode::LinearOutput(linear,) => {
            let decoded = decode_linear_node(linear, workspace)
            DecodedDigits {
                digits: decoded.value.output.limbs,
                negative: decoded.value.output.negative,
                valid: decoded.valid,
            }
        },
        RangeNode::Invalid => DecodedDigits { digits: [0; L], negative: false, valid: false },
    }
}

pub struct SparseWitnessRow { value: SparseTaskRow<BabyBear>, valid: bool }
impl core::marker::Copy for SparseWitnessRow {}

fn complete_sparse_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ value: SparseTaskRow<BabyBear>,
    _ local_valid: bool,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    SparseWitnessRow {
        value: value,
        valid: local_valid && transition_workspace_is_valid<L, WORKSPACE_WORDS>(workspace),
    }
}

fn decode_sparse_radix_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ task: SparseTransitionTask,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node = match task {
        SparseTransitionTask::RadixBit(node, _, _) => node,
        SparseTransitionTask::RadixLimb(node, _) => node,
        SparseTransitionTask::RadixFinish(node,) => node,
        _ => RangeNode::Invalid,
    }
    let range = decode_range_node(node, point, current, workspace)
    complete_sparse_witness_row<L, WORKSPACE_WORDS>(
        sparse_radix_row<BabyBear, L>(task, range.digits, range.negative),
        range.valid,
        workspace,
    )
}

fn decode_sparse_carry_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ task: SparseTransitionTask,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node = match task {
        SparseTransitionTask::CarryBit(node, _, _, _) => node,
        SparseTransitionTask::CarryFinish(node, _) => node,
        _ => ProductNode::Invalid,
    }
    let product = decode_product_node(node, workspace)
    complete_sparse_witness_row<L, WORKSPACE_WORDS>(
        sparse_carry_row<BabyBear, L>(task, product.value),
        product.valid,
        workspace,
    )
}

fn decode_sparse_product_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ current: ComplexFixed<L>,
    _ task: SparseTransitionTask,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node = match task {
        SparseTransitionTask::ProductTerm(node, _, _) => node,
        SparseTransitionTask::ProductCoefficient(node, _) => node,
        _ => ProductNode::Invalid,
    }
    let product = decode_product_node(node, workspace)
    complete_sparse_witness_row<L, WORKSPACE_WORDS>(
        sparse_product_row<BabyBear, L>(
            task,
            product_left(node, current),
            product_right(node, current),
            product.value,
        ),
        product.valid,
        workspace,
    )
}

fn decode_sparse_round_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ current: ComplexFixed<L>,
    _ task: SparseTransitionTask,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node = match task {
        SparseTransitionTask::ProductRound(node, _) => node,
        SparseTransitionTask::ProductFinish(node,) => node,
        _ => ProductNode::Invalid,
    }
    let product = decode_product_node(node, workspace)
    complete_sparse_witness_row<L, WORKSPACE_WORDS>(
        sparse_round_row<BabyBear, L>(
            task,
            product_left(node, current),
            product_right(node, current),
            product.value,
        ),
        product.valid,
        workspace,
    )
}

fn decode_sparse_linear_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ point: ComplexFixed<L>,
    _ task: SparseTransitionTask,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let node = match task {
        SparseTransitionTask::LinearLimb(node, _, _) => node,
        SparseTransitionTask::LinearFinish(node,) => node,
        _ => LinearNode::Invalid,
    }
    let linear = decode_linear_node(node, workspace)
    let left = decode_linear_left(node, workspace)
    let right = decode_linear_right(node, point, workspace)
    complete_sparse_witness_row<L, WORKSPACE_WORDS>(
        sparse_linear_row<BabyBear, L>(task, left.value, right.value, linear.value),
        linear.valid && left.valid && right.valid,
        workspace,
    )
}

fn decode_sparse_boundary_witness_row<const L: usize, const WORKSPACE_WORDS: usize>(
    _ current: ComplexFixed<L>,
    _ task: SparseTransitionTask,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
) -> SparseWitnessRow
where
    L > 1,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
{
    let coordinate = match task {
        SparseTransitionTask::BoundarySign(coordinate,) => coordinate,
        SparseTransitionTask::BoundaryLimb(coordinate, _) => coordinate,
        _ => CoordinateNode::Invalid,
    }
    let is_finish = match task {
        SparseTransitionTask::TransitionFinish => true,
        _ => false,
    }
    let next = if is_finish {
        DecodedFixed { value: current.real, valid: true }
    } else {
        decode_next_coordinate(coordinate, workspace)
    }
    complete_sparse_witness_row<L, WORKSPACE_WORDS>(
        sparse_boundary_row<BabyBear, L>(
            task,
            next.value,
            next.value,
            transition_workspace_is_valid<L, WORKSPACE_WORDS>(workspace),
        ),
        next.valid,
        workspace,
    )
}

/// A semantic family is a contiguous interpretation of the generated task
/// stream. The family owns neither formulas nor row numbers: its bounds are
/// derived from the same task-count functions used by the scalar AIR.
pub trait SparseWitnessFamily<const L: usize> {
    const START: u32
    const ROWS: u32
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    ) -> SparseWitnessRow
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
}

pub struct SparseRadixWitnessFamily {}
pub struct SparseCarryWitnessFamily {}
pub struct SparseProductWitnessFamily {}
pub struct SparseRoundWitnessFamily {}
pub struct SparseLinearWitnessFamily {}
pub struct SparseBoundaryWitnessFamily {}
pub struct SparsePaddingWitnessFamily {}

impl<const L: usize> SparseWitnessFamily<L> for SparseRadixWitnessFamily {
    const START: u32 = 0
    const ROWS: u32 = sparse_radix_task_count<L>()
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    ) -> SparseWitnessRow
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        decode_sparse_radix_witness_row<L, WORKSPACE_WORDS>(
            point,
            current,
            sparse_transition_task_at<L>(
                <SparseRadixWitnessFamily as SparseWitnessFamily<L>>::START + local_row,
            ),
            workspace,
        )
    }
}

impl<const L: usize> SparseWitnessFamily<L> for SparseCarryWitnessFamily {
    const START: u32 = sparse_radix_task_count<L>()
    const ROWS: u32 = sparse_carry_task_count<L>()
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    ) -> SparseWitnessRow
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        decode_sparse_carry_witness_row<L, WORKSPACE_WORDS>(
            sparse_transition_task_at<L>(
                <SparseCarryWitnessFamily as SparseWitnessFamily<L>>::START + local_row,
            ),
            workspace,
        )
    }
}

impl<const L: usize> SparseWitnessFamily<L> for SparseProductWitnessFamily {
    const START: u32 = sparse_radix_task_count<L>() + sparse_carry_task_count<L>()
    const ROWS: u32 = sparse_product_task_count<L>()
    fn decode<const WORKSPACE_WORDS: usize>(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ local_row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
