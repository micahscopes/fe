pub struct SparseBaseArithmeticPlanPartition {}
impl SparseBaseAirPartition for SparseBaseArithmeticPlanPartition {
    const INDEX: usize = 4
    const START: usize = ARITHMETIC_PLAN_START
    const WORDS: usize = ARITHMETIC_PLAN_WORDS
    fn encode<
        const L: usize,
        const TRACE: usize,
        const WORKSPACE_WORDS: usize,
        const BASE_TRACE_WORDS: usize,
        W: WordSink,
    >(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
        _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
        _ writer: W,
    ) -> PartitionEncoding<W>
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        {
            BASE_TRACE_WORDS == TRACE * SPARSE_BASE_AIR_FIELDS
        },
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        let control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row)
        let witness = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
        let value = sparse_arithmetic_plan_witness(control.value, witness.value)
        PartitionEncoding {
            writer: encode_canonical_words(ref value, writer),
            valid: control.valid && witness.valid,
        }
    }
}

pub struct SparseBaseArithmeticLinkPartition {}
impl SparseBaseAirPartition for SparseBaseArithmeticLinkPartition {
    const INDEX: usize = 5
    const START: usize = ARITHMETIC_LINK_START
    const WORDS: usize = ARITHMETIC_LINK_WORDS
    fn encode<
        const L: usize,
        const TRACE: usize,
        const WORKSPACE_WORDS: usize,
        const BASE_TRACE_WORDS: usize,
        W: WordSink,
    >(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
        _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
        _ writer: W,
    ) -> PartitionEncoding<W>
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        {
            BASE_TRACE_WORDS == TRACE * SPARSE_BASE_AIR_FIELDS
        },
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        let control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row)
        let witness = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
        let next_control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row + 1)
        let next_witness = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row + 1)
        let value = sparse_arithmetic_link_plan_witness(
            control.value,
            witness.value,
            next_control.value,
            next_witness.value,
        )
        PartitionEncoding {
            writer: encode_canonical_words(ref value, writer),
            valid: control.valid && witness.valid && next_control.valid && next_witness.valid,
        }
    }
}

pub struct SparseBaseRoundPlanPartition {}
impl SparseBaseAirPartition for SparseBaseRoundPlanPartition {
    const INDEX: usize = 6
    const START: usize = ROUND_PLAN_START
    const WORDS: usize = ROUND_PLAN_WORDS
    fn encode<
        const L: usize,
        const TRACE: usize,
        const WORKSPACE_WORDS: usize,
        const BASE_TRACE_WORDS: usize,
        W: WordSink,
    >(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
        _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
        _ writer: W,
    ) -> PartitionEncoding<W>
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        {
            BASE_TRACE_WORDS == TRACE * SPARSE_BASE_AIR_FIELDS
        },
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        let control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row)
        let next_control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row + 1)
        let witness = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
        let planned = sparse_round_copy_plan<
            QuadraticWordWitnessInterpreter<W, SPARSE_ROUND_PORT_MULTIPLICATIONS>,
            BabyBear,
            L,
        >(
            control.value,
            next_control.value,
            witness.value,
            QuadraticWordWitnessInterpreter::new(writer),
        )
        PartitionEncoding {
            writer: planned.interpreter.finish(),
            valid: control.valid && next_control.valid && witness.valid,
        }
    }
}

pub struct SparseBaseLinearPlanPartition {}
impl SparseBaseAirPartition for SparseBaseLinearPlanPartition {
    const INDEX: usize = 7
    const START: usize = LINEAR_PLAN_START
    const WORDS: usize = LINEAR_PLAN_WORDS
    fn encode<
        const L: usize,
        const TRACE: usize,
        const WORKSPACE_WORDS: usize,
        const BASE_TRACE_WORDS: usize,
        W: WordSink,
    >(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
        _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
        _ writer: W,
    ) -> PartitionEncoding<W>
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        {
            BASE_TRACE_WORDS == TRACE * SPARSE_BASE_AIR_FIELDS
        },
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        let control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row)
        let next_control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row + 1)
        let witness = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
        let arithmetic = decode_stored_arithmetic_plan<TRACE, BASE_TRACE_WORDS>(base_trace, row)
        let interpreter = interpret_sparse_linear_plan<
            QuadraticWordWitnessInterpreter<W, SPARSE_LINEAR_PORT_MULTIPLICATIONS>,
            BabyBear,
            L,
        >(
            control.value,
            next_control.value,
            witness.value,
            arithmetic.value,
            QuadraticWordWitnessInterpreter::new(writer),
        )
        PartitionEncoding {
            writer: interpreter.finish(),
            valid: control.valid && next_control.valid && witness.valid && arithmetic.valid,
        }
    }
}

pub struct SparseBaseBoundaryPlanPartition {}
impl SparseBaseAirPartition for SparseBaseBoundaryPlanPartition {
    const INDEX: usize = 8
    const START: usize = BOUNDARY_PLAN_START
    const WORDS: usize = BOUNDARY_PLAN_WORDS
    fn encode<
        const L: usize,
        const TRACE: usize,
        const WORKSPACE_WORDS: usize,
        const BASE_TRACE_WORDS: usize,
        W: WordSink,
    >(
        _ point: ComplexFixed<L>,
        _ current: ComplexFixed<L>,
        _ row: u32,
        _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
        _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
        _ writer: W,
    ) -> PartitionEncoding<W>
    where
        L > 1,
        WORKSPACE_WORDS > 0,
        {
            BASE_TRACE_WORDS == TRACE * SPARSE_BASE_AIR_FIELDS
        },
        TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>()
    {
        let control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row)
        let witness = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
        let value = sparse_boundary_plan_witness<BabyBear, L>(control.value, witness.value)
        PartitionEncoding {
            writer: encode_canonical_words(ref value, writer),
            valid: control.valid && witness.valid,
        }
    }
}

/// Materialize one semantic partition of one production sparse base AIR row
/// in column-major storage. Column-major placement feeds the shared batched NTT
/// interpreter directly, without a host or shader-side transpose table.
///
/// The partition type selects the smallest semantic dependency slice needed by
/// its record. Control-only partitions never materialize a transition witness;
/// witness-dependent partitions consume the compiler-derived transition
/// workspace produced from that same authored recurrence. A later fused or
/// workgroup-shared interpretation may change placement, but it must preserve
/// this row-level denotation and its independent oracle.
pub fn write_sparse_base_air_partition_lane<
    P: SparseBaseAirPartition,
    const L: usize,
    const TRACE: usize,
    const WORKSPACE_WORDS: usize,
    const OUTPUT_WORDS: usize,
    const VALIDITY_WORDS: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ validity: StorageBuffer<u32, VALIDITY_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    {
        OUTPUT_WORDS == TRACE * SPARSE_BASE_AIR_FIELDS
    },
    {
        VALIDITY_WORDS == TRACE
    }
{
    let row = invocation.global.x
    if row >= TRACE.downcast_truncate() {
        return
    }

    let trace: u32 = TRACE.downcast_truncate()
    let trace_shape_valid = trace == sparse_transition_trace_length<L>()
    let writer = ColumnMajorWordWriter<TRACE, OUTPUT_WORDS>::new(
        output,
        row,
        P::START.downcast_truncate(),
        P::WORDS.downcast_truncate(),
    )
    let encoded = P::encode<
        L,
        TRACE,
        WORKSPACE_WORDS,
        OUTPUT_WORDS,
        ColumnMajorWordWriter<TRACE, OUTPUT_WORDS>,
    >(point, current, row, workspace, output, writer)
    let writer_valid = encoded.writer.finish()
    let prior_valid = if P::INDEX == 0 {
        true
    } else {
        validity.load(index: row) == 1
    }
    let valid = prior_valid && encoded.valid && writer_valid && trace_shape_valid
    validity.store(index: row, value: if valid { 1 } else { 0 })
}
