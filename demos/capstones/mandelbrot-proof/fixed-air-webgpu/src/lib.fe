    empty_sparse_row,
    evaluate_sparse_boundary_interaction_row,
    evaluate_sparse_product_interaction_row,
    interpret_sparse_linear_plan,
    sparse_arithmetic_link_plan_witness,
    sparse_arithmetic_plan_witness,
    sparse_boundary_row,
    sparse_boundary_plan_witness,
    sparse_boundary_task_count,
    sparse_carry_row,
    sparse_carry_task_count,
