        decode_sparse_product_witness_row<L, WORKSPACE_WORDS>(
            current,
            sparse_transition_task_at<L>(
                <SparseProductWitnessFamily as SparseWitnessFamily<L>>::START + local_row,
            ),
            workspace,
        )
    }
}

