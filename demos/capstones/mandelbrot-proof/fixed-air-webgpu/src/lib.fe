    )
    let lane_valid = context.valid
        && context.challenges.is_valid()
        && !shift.is_zero()
        && !shift.pow_u32(TRACE.downcast_truncate()).equals(BabyBear::one())
        && current.valid
        && next.valid
        && witness.valid
        && arithmetic_plan.valid
        && linear_plan.valid
        && current_interaction.valid
        && next_interaction.valid
    let accumulator = guard_sparse_composition_accumulator(
        load_sparse_composition_accumulator<LDE, OUTPUT_WORDS>(output, row_index),
        lane_valid,
    )
    let evaluation = C::evaluate_linear_interaction<L>(
        context.challenges.composition(),
        context.challenges.interaction().linear,
        current.value,
        next.value,
        witness.value,
        arithmetic_plan.value,
        linear_plan.value,
        current_interaction.value,
        next_interaction.value,
    )
    let accumulator = accumulate_sparse_composition_component<C>(
        accumulator,
        context.challenges.composition(),
        evaluation,
    )
    store_sparse_composition_accumulator<LDE, OUTPUT_WORDS>(output, row_index, ref accumulator)
}

/// Evaluate the public-boundary copy bus from its exact base and interaction
/// projection. The next row contributes only the adjacent accumulator.
pub fn write_sparse_boundary_composition_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
    const BASE_WORDS: usize,
    const INTERACTION_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ shift: BabyBear,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ base: StorageBuffer<u32, BASE_WORDS>,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    {
        (TRACE & (TRACE - 1)) == 0
    },
    {
        radix2_field_domain_supported<TRACE, BabyBear>()
    },
    LDE > 0,
    LDE > TRACE,
    {
        (LDE & (LDE - 1)) == 0
    },
    {
        radix2_field_domain_supported<LDE, BabyBear>()
    },
    {
        (LDE % TRACE) == 0
    },
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    WORKSPACE_WORDS > 0,
    BASE_WORDS >= LDE * SPARSE_BASE_AIR_FIELDS,
    INTERACTION_WORDS >= LDE * SPARSE_INTERACTION_AIR_FIELDS,
    OUTPUT_WORDS >= sparse_composition_staging_words<LDE>()
{
    let row_index = invocation.global.x
    if row_index >= LDE.downcast_truncate() {
        return
    }
    let context = load_sparse_composition_phase_context<L, TRACE, LDE, WORKSPACE_WORDS>(workspace)
    let stride: u32 = (LDE / TRACE).downcast_truncate()
    let mut next_index = row_index + stride
    if next_index >= LDE.downcast_truncate() {
        next_index = next_index - LDE.downcast_truncate()
    }
    let control = decode_embedded_column_major_value<
        SparseControlRow<BabyBearExt4>,
        LDE,
        BASE_WORDS,
    >(
        zero_sparse_trace_control_field<BabyBearExt4>(),
        base,
        row_index,
        CONTROL_START.downcast_truncate(),
    )
    let witness = decode_embedded_column_major_value<SparseTaskRow<BabyBearExt4>, LDE, BASE_WORDS>(
        zero_sparse_trace_row_field<BabyBearExt4>(),
        base,
        row_index,
        WITNESS_START.downcast_truncate(),
    )
    let plan = decode_embedded_column_major_value<
        SparseBoundaryPlanWitness<BabyBearExt4>,
        LDE,
        BASE_WORDS,
    >(
        zero_sparse_boundary_plan_witness<BabyBearExt4>(),
        base,
        row_index,
        BOUNDARY_PLAN_START.downcast_truncate(),
    )
    let current_interaction = decode_column_major_value<
        SparseBoundaryInteractionRow<BabyBearExt4>,
        LDE,
        INTERACTION_WORDS,
    >(
        zero_sparse_copy_interaction_row<BabyBearExt4, 2>(),
        interaction,
        row_index,
        BOUNDARY_INTERACTION_START.downcast_truncate(),
    )
    let next_interaction = decode_column_major_value<
        SparseBoundaryInteractionRow<BabyBearExt4>,
        LDE,
        INTERACTION_WORDS,
    >(
        zero_sparse_copy_interaction_row<BabyBearExt4, 2>(),
        interaction,
        next_index,
        BOUNDARY_INTERACTION_START.downcast_truncate(),
    )
    let lane_valid = context.valid
        && context.challenges.is_valid()
        && !shift.is_zero()
        && !shift.pow_u32(TRACE.downcast_truncate()).equals(BabyBear::one())
        && control.valid
        && witness.valid
        && plan.valid
        && current_interaction.valid
        && next_interaction.valid
    let accumulator = guard_sparse_composition_accumulator(
        load_sparse_composition_accumulator<LDE, OUTPUT_WORDS>(output, row_index),
        lane_valid,
    )
    let evaluation = evaluate_sparse_boundary_component<L>(
        context.challenges.composition(),
        context.challenges.interaction().boundary,
        control.value,
        witness.value,
        plan.value,
        current_interaction.value,
        next_interaction.value,
    )
    let accumulator = accumulate_sparse_composition_component<SparseBoundaryComposition>(
        accumulator,
        context.challenges.composition(),
        evaluation,
    )
    store_sparse_composition_accumulator<LDE, OUTPUT_WORDS>(output, row_index, ref accumulator)
}

/// Reduce the completed component folds, apply the four AIR zerofiers, and
/// add the transcript-bound public constraints for one LDE position.
pub fn finish_sparse_composition_component_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
    const BASE_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ interval: OrbitInterval<L>,
    _ shift: BabyBear,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ base: StorageBuffer<u32, BASE_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    {
        (TRACE & (TRACE - 1)) == 0
    },
    {
        radix2_field_domain_supported<TRACE, BabyBear>()
    },
    LDE > 0,
    LDE > TRACE,
    {
        (LDE & (LDE - 1)) == 0
    },
    {
        radix2_field_domain_supported<LDE, BabyBear>()
    },
    {
        (LDE % TRACE) == 0
    },
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    WORKSPACE_WORDS > 0,
    BASE_WORDS >= LDE * SPARSE_BASE_AIR_FIELDS,
    OUTPUT_WORDS >= sparse_composition_codeword_words<LDE>(),
    OUTPUT_WORDS >= sparse_composition_staging_words<LDE>()
{
    let row_index = invocation.global.x
    if row_index >= LDE.downcast_truncate() {
        return
    }
    let context = load_sparse_composition_phase_context<L, TRACE, LDE, WORKSPACE_WORDS>(workspace)
    let mut row = ZERO_SPARSE_OPENED_AIR_ROW
    let row_base_reader = decode_canonical_words(
        mut row.base,
        BabyBearExt4EmbeddingSource::new(
            ColumnMajorWordReader<LDE, BASE_WORDS>::new(
                base,
                row_index,
                0,
                SPARSE_BASE_AIR_FIELDS.downcast_truncate(),
            ),
        ),
    )
    row.valid = row_base_reader.finish().finish()
    let root = BabyBear::two_adic_root(radix2_log<LDE>())
    let point = BabyBearExt4::from_base(shift * root.pow_u32(row_index))
    let accumulator = load_sparse_composition_accumulator<LDE, OUTPUT_WORDS>(output, row_index)
    let evaluated = evaluate_sparse_bound_composition_accumulator_opened<L, TRACE>(
        interval,
        context.challenges,
        point,
        ref row,
        accumulator,
    )
    let valid = context.valid
        && !shift.is_zero()
        && !shift.pow_u32(TRACE.downcast_truncate()).equals(BabyBear::one())
        && row.valid
        && evaluated.valid
    store_sparse_composition_value<LDE, OUTPUT_WORDS>(
        output,
        row_index,
        if valid {
            evaluated.value
        } else {
            BabyBearExt4::zero()
        },
        valid,
    )
}

/// Evaluate one position of the real production sparse composition. The
/// scalar AIR owns every constraint and transcript value; this function owns
/// only the physical mapping from one WebGPU invocation to one LDE position.
pub fn write_sparse_bound_composition_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
    const BASE_WORDS: usize,
    const INTERACTION_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ interval: OrbitInterval<L>,
    _ shift: BabyBear,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ base: StorageBuffer<u32, BASE_WORDS>,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    {
        (TRACE & (TRACE - 1)) == 0
    },
    {
        radix2_field_domain_supported<TRACE, BabyBear>()
    },
    LDE > 0,
    LDE > TRACE,
    {
        (LDE & (LDE - 1)) == 0
    },
    {
        radix2_field_domain_supported<LDE, BabyBear>()
    },
    {
        (LDE % TRACE) == 0
    },
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    WORKSPACE_WORDS > 0,
    BASE_WORDS >= LDE * SPARSE_BASE_AIR_FIELDS,
    INTERACTION_WORDS >= LDE * SPARSE_INTERACTION_AIR_FIELDS,
    OUTPUT_WORDS >= sparse_composition_codeword_words<LDE>()
{
    let row_index = invocation.global.x
    if row_index >= LDE.downcast_truncate() {
        return
    }
    let context = load_sparse_composition_phase_context<L, TRACE, LDE, WORKSPACE_WORDS>(workspace)
    let stride: u32 = (LDE / TRACE).downcast_truncate()
    let mut next_index = row_index + stride
    if next_index >= LDE.downcast_truncate() {
        next_index = next_index - LDE.downcast_truncate()
    }
    let mut row = ZERO_SPARSE_OPENED_AIR_ROW
    let row_base_reader = decode_canonical_words(
        mut row.base,
        BabyBearExt4EmbeddingSource::new(
            ColumnMajorWordReader<LDE, BASE_WORDS>::new(
                base,
                row_index,
                0,
                SPARSE_BASE_AIR_FIELDS.downcast_truncate(),
            ),
        ),
    )
    let row_interaction_reader = decode_canonical_words(
        mut row.interaction,
        ColumnMajorWordReader<LDE, INTERACTION_WORDS>::new(
            interaction,
            row_index,
            0,
            <SparseInteractionTraceRow<BabyBearExt4> as CanonicalWords>::WORDS,
        ),
    )
    row.valid = row_base_reader.finish().finish() && row_interaction_reader.finish()
    let mut next = ZERO_SPARSE_OPENED_AIR_ROW
    let next_base_reader = decode_canonical_words(
        mut next.base,
        BabyBearExt4EmbeddingSource::new(
            ColumnMajorWordReader<LDE, BASE_WORDS>::new(
                base,
                next_index,
                0,
                SPARSE_BASE_AIR_FIELDS.downcast_truncate(),
            ),
        ),
    )
    let next_interaction_reader = decode_canonical_words(
        mut next.interaction,
        ColumnMajorWordReader<LDE, INTERACTION_WORDS>::new(
            interaction,
            next_index,
            0,
            <SparseInteractionTraceRow<BabyBearExt4> as CanonicalWords>::WORDS,
        ),
    )
    next.valid = next_base_reader.finish().finish() && next_interaction_reader.finish()
    let root = BabyBear::two_adic_root(radix2_log<LDE>())
    let point = BabyBearExt4::from_base(shift * root.pow_u32(row_index))
    let evaluated = evaluate_sparse_bound_composition_challenge_values_opened<L, TRACE>(
        interval,
        context.challenges,
        point,
        ref row,
        ref next,
    )
    let valid = context.valid
        && !shift.is_zero()
        && !shift.pow_u32(TRACE.downcast_truncate()).equals(BabyBear::one())
        && row.valid
        && next.valid
        && evaluated.valid
    store_sparse_composition_value<LDE, OUTPUT_WORDS>(
        output,
        row_index,
        if valid {
            evaluated.value
        } else {
            BabyBearExt4::zero()
        },
        valid,
    )
}

/// Close the distributed composition phase after every position has written
/// an independent validity receipt. This updates the same typed phase context
/// consumed by the later commitment and FRI interpreters.
pub fn finish_sparse_bound_composition_codeword<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
) -> bool
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    LDE > 0,
    LDE > TRACE,
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    WORKSPACE_WORDS > 0,
    OUTPUT_WORDS >= sparse_composition_codeword_words<LDE>()
{
    let context = load_sparse_composition_phase_context<L, TRACE, LDE, WORKSPACE_WORDS>(workspace)
    let validity_start: u32 = (LDE * <BabyBearExt4 as CanonicalWords>::WORDS as usize)
        .downcast_truncate()
    let mut valid = context.valid
    let mut row: u32 = 0
    while row < LDE.downcast_truncate() {
        valid = valid && output.load(index: validity_start + row) == 1
        row = row + 1
    }
    let regions = sparse_composition_phase_regions<L, TRACE, LDE>()
    let stored = store_region_word(workspace, regions.valid, 0, if valid { 1 } else { 0 })
    valid && stored
}

pub fn sparse_composition_phase_is_valid<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const WORKSPACE_WORDS: usize,
>(_ workspace: StorageBuffer<u32, WORKSPACE_WORDS>) -> bool
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    LDE > 0,
    LDE > TRACE,
    SparseCompositionPhaseRegions<L, TRACE, LDE>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    WORKSPACE_WORDS > 0
{
    load_sparse_composition_phase_context<L, TRACE, LDE, WORKSPACE_WORDS>(workspace).valid
}

fn decode_column_major_value<
    T: CanonicalWords + core::marker::Copy,
    const ROWS: usize,
    const INPUT_WORDS: usize,
>(
    _ initial: T,
    _ input: StorageBuffer<u32, INPUT_WORDS>,
    _ row: u32,
    _ column_start: u32,
) -> WorkspaceDecoded<T> {
    let mut value = initial
    let reader = decode_canonical_words(
        mut value,
        ColumnMajorWordReader<ROWS, INPUT_WORDS>::new(input, row, column_start, T::WORDS),
    )
    WorkspaceDecoded { value: value, valid: reader.finish() }
}

/// Decode one base-field record directly into its extension-field view. The
/// target codec derives the source width, so callers name only the semantic
/// field start and cannot maintain a parallel column count.
fn decode_embedded_column_major_value<
    T: CanonicalWords + core::marker::Copy,
    const ROWS: usize,
    const INPUT_WORDS: usize,
>(
    _ initial: T,
    _ input: StorageBuffer<u32, INPUT_WORDS>,
    _ row: u32,
    _ column_start: u32,
) -> WorkspaceDecoded<T> {
    let mut value = initial
    let reader = decode_canonical_words(
        mut value,
        BabyBearExt4EmbeddingSource::new(
            ColumnMajorWordReader<ROWS, INPUT_WORDS>::new(
                input,
                row,
                column_start,
                T::WORDS / <BabyBearExt4 as CanonicalWords>::WORDS,
            ),
        ),
    )
        .finish()
    WorkspaceDecoded { value: value, valid: reader.finish() }
}

fn decode_default_column_major_value<
    T: CanonicalWords + core::marker::Copy + Default,
    const ROWS: usize,
    const INPUT_WORDS: usize,
>(_ input: StorageBuffer<u32, INPUT_WORDS>, _ row: u32, _ column_start: u32) -> WorkspaceDecoded<
    T,
> {
    let mut value = <T as Default>::default()
    let reader = decode_canonical_words(
        mut value,
        ColumnMajorWordReader<ROWS, INPUT_WORDS>::new(input, row, column_start, T::WORDS),
    )
    WorkspaceDecoded { value: value, valid: reader.finish() }
}

const CONTROL_WORDS: usize = <SparseControlRow<BabyBear> as CanonicalWords>::WORDS as usize
const CONTROL_PLAN_WORDS: usize = <SparseControlPlanWitness<
    BabyBear,
> as CanonicalWords>::WORDS as usize
const CONTROL_LINK_WORDS: usize = <SparseControlLinkPlanWitness<
    BabyBear,
> as CanonicalWords>::WORDS as usize
const WITNESS_WORDS: usize = <SparseTaskRow<BabyBear> as CanonicalWords>::WORDS as usize
const ARITHMETIC_PLAN_WORDS: usize = <SparseArithmeticPlanWitness<
    BabyBear,
> as CanonicalWords>::WORDS as usize
const ARITHMETIC_LINK_WORDS: usize = <SparseArithmeticLinkPlanWitness<
    BabyBear,
> as CanonicalWords>::WORDS as usize
const ROUND_PLAN_WORDS: usize = <SparseRoundPlanWitness<BabyBear> as CanonicalWords>::WORDS as usize
const LINEAR_PLAN_WORDS: usize = <SparseLinearPlanWitness<
    BabyBear,
> as CanonicalWords>::WORDS as usize
const BOUNDARY_PLAN_WORDS: usize = <SparseBoundaryPlanWitness<
    BabyBear,
> as CanonicalWords>::WORDS as usize

const CONTROL_START: usize = 0
const CONTROL_PLAN_START: usize = CONTROL_START + CONTROL_WORDS
const CONTROL_LINK_START: usize = CONTROL_PLAN_START + CONTROL_PLAN_WORDS
const WITNESS_START: usize = CONTROL_LINK_START + CONTROL_LINK_WORDS
const ARITHMETIC_PLAN_START: usize = WITNESS_START + WITNESS_WORDS
const ARITHMETIC_LINK_START: usize = ARITHMETIC_PLAN_START + ARITHMETIC_PLAN_WORDS
const ROUND_PLAN_START: usize = ARITHMETIC_LINK_START + ARITHMETIC_LINK_WORDS
const LINEAR_PLAN_START: usize = ROUND_PLAN_START + ROUND_PLAN_WORDS
const BOUNDARY_PLAN_START: usize = LINEAR_PLAN_START + LINEAR_PLAN_WORDS
static_assert(BOUNDARY_PLAN_START + BOUNDARY_PLAN_WORDS == SPARSE_BASE_AIR_FIELDS)

fn decode_stored_control<const L: usize, const TRACE: usize, const BASE_TRACE_WORDS: usize>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ row: u32,
) -> WorkspaceDecoded<SparseControlRow<BabyBear>>
where L > 1
{
    if row >= TRACE.downcast_truncate() {
        return WorkspaceDecoded { value: sparse_padding_control_row<BabyBear>(), valid: true }
    }
    decode_default_column_major_value<SparseControlRow<BabyBear>, TRACE, BASE_TRACE_WORDS>(
        base_trace,
        row,
        CONTROL_START.downcast_truncate(),
    )
}

fn decode_stored_witness<const TRACE: usize, const BASE_TRACE_WORDS: usize>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ row: u32,
) -> WorkspaceDecoded<SparseTaskRow<BabyBear>> {
    let initial = empty_sparse_row<BabyBear>()
    if row >= TRACE.downcast_truncate() {
        return WorkspaceDecoded { value: initial, valid: true }
    }
    decode_column_major_value<SparseTaskRow<BabyBear>, TRACE, BASE_TRACE_WORDS>(
        initial,
        base_trace,
        row,
        WITNESS_START.downcast_truncate(),
    )
}

fn decode_stored_arithmetic_plan<const TRACE: usize, const BASE_TRACE_WORDS: usize>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ row: u32,
) -> WorkspaceDecoded<SparseArithmeticPlanWitness<BabyBear>> {
    let initial = zero_sparse_arithmetic_plan_witness<BabyBear>()
    if row >= TRACE.downcast_truncate() {
        return WorkspaceDecoded { value: initial, valid: true }
    }
    decode_column_major_value<SparseArithmeticPlanWitness<BabyBear>, TRACE, BASE_TRACE_WORDS>(
        initial,
        base_trace,
        row,
        ARITHMETIC_PLAN_START.downcast_truncate(),
    )
}

/// Place one generated semantic family into the shared witness columns. Actor
/// passes select only the family type and a work grid; row bounds and task
/// identities remain derived from the scalar schedule.
pub fn write_sparse_witness_family_lane<
    F: SparseWitnessFamily<L>,
    const L: usize,
    const TRACE: usize,
    const WORKSPACE_WORDS: usize,
    const OUTPUT_WORDS: usize,
    const VALIDITY_WORDS: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ validity: StorageBuffer<u32, VALIDITY_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    WORKSPACE_WORDS > 0,
    TransitionWitnessRegions<L>::WORDS <= storage_word_capacity<WORKSPACE_WORDS>(),
    {
        OUTPUT_WORDS == TRACE * SPARSE_BASE_AIR_FIELDS
    },
    {
        VALIDITY_WORDS == TRACE
    }
{
    let local_row = invocation.global.x
    if local_row >= F::ROWS {
        return
    }
    let row = F::START + local_row
    if row >= TRACE.downcast_truncate() {
        return
    }

    let decoded = F::decode<WORKSPACE_WORDS>(point, current, local_row, workspace)
    let writer = encode_canonical_words(
        ref decoded.value,
        ColumnMajorWordWriter<TRACE, OUTPUT_WORDS>::new(
            output,
            row,
            WITNESS_START.downcast_truncate(),
            WITNESS_WORDS.downcast_truncate(),
        ),
    )
    let valid = validity.load(index: row) == 1 && decoded.valid && writer.finish()
    validity.store(index: row, value: if valid { 1 } else { 0 })
}

const PRODUCT_INTERACTION_WORDS: usize = <SparseProductInteractionRow<
    BabyBearExt4,
> as CanonicalWords>::WORDS as usize
const ROUND_INTERACTION_WORDS: usize = <SparseRoundInteractionRow<
    BabyBearExt4,
> as CanonicalWords>::WORDS as usize
const LINEAR_INTERACTION_WORDS: usize = <SparseLinearInteractionRow<
    BabyBearExt4,
> as CanonicalWords>::WORDS as usize
const BOUNDARY_INTERACTION_WORDS: usize = <SparseBoundaryInteractionRow<
    BabyBearExt4,
> as CanonicalWords>::WORDS as usize
const PRODUCT_INTERACTION_START: usize = 0
const ROUND_INTERACTION_START: usize = PRODUCT_INTERACTION_START + PRODUCT_INTERACTION_WORDS
const LINEAR_INTERACTION_START: usize = ROUND_INTERACTION_START + ROUND_INTERACTION_WORDS
const BOUNDARY_INTERACTION_START: usize = LINEAR_INTERACTION_START + LINEAR_INTERACTION_WORDS
static_assert(BOUNDARY_INTERACTION_START + BOUNDARY_INTERACTION_WORDS
    == SPARSE_INTERACTION_AIR_FIELDS)

/// Compiler-derived field coordinates for the product interaction segment.
/// The storage interpreter streams the address plan into its nominal field
/// instead of materializing the plan as a private array.
struct ProductInteractionRegions {
    accumulator: Region<ProductInteractionRegions, BabyBearExt4>,
    inverses: Region<ProductInteractionRegions, [BabyBearExt4; 2]>,
    address_plan: Region<
        ProductInteractionRegions,
        QuadraticPlanWitness<BabyBearExt4, SPARSE_PRODUCT_ADDRESS_MULTIPLICATIONS>,
    >,
}
impl core::marker::Copy for ProductInteractionRegions {}
derive RegionSchema for ProductInteractionRegions using RegionSchemaProvider

const fn product_interaction_regions() -> ProductInteractionRegions {
    <ProductInteractionRegions as RegionSchema>::regions()
}

static_assert(<ProductInteractionRegions as RegionSchema>::WORDS as usize
    == PRODUCT_INTERACTION_WORDS)

struct RoundInteractionRegions {
    accumulator: Region<RoundInteractionRegions, BabyBearExt4>,
    inverses: Region<RoundInteractionRegions, [BabyBearExt4; 5]>,
}
impl core::marker::Copy for RoundInteractionRegions {}
derive RegionSchema for RoundInteractionRegions using RegionSchemaProvider

struct LinearInteractionRegions {
    accumulator: Region<LinearInteractionRegions, BabyBearExt4>,
    inverses: Region<LinearInteractionRegions, [BabyBearExt4; 8]>,
}
impl core::marker::Copy for LinearInteractionRegions {}
derive RegionSchema for LinearInteractionRegions using RegionSchemaProvider

struct BoundaryInteractionRegions {
    accumulator: Region<BoundaryInteractionRegions, BabyBearExt4>,
    inverses: Region<BoundaryInteractionRegions, [BabyBearExt4; 2]>,
}
impl core::marker::Copy for BoundaryInteractionRegions {}
derive RegionSchema for BoundaryInteractionRegions using RegionSchemaProvider

const fn round_interaction_regions() -> RoundInteractionRegions {
    <RoundInteractionRegions as RegionSchema>::regions()
}

const fn linear_interaction_regions() -> LinearInteractionRegions {
    <LinearInteractionRegions as RegionSchema>::regions()
}

const fn boundary_interaction_regions() -> BoundaryInteractionRegions {
    <BoundaryInteractionRegions as RegionSchema>::regions()
}

pub const SPARSE_INTERACTION_ACCUMULATOR_FIELDS: usize = <SparseInteractionAccumulators as CanonicalWords>::WORDS as usize
const EXTENSION_FIELDS: usize = <BabyBearExt4 as CanonicalWords>::WORDS as usize
static_assert(SPARSE_INTERACTION_ACCUMULATOR_FIELDS == 4 * EXTENSION_FIELDS)

fn sparse_interaction_accumulator_column(_ lane: u32) -> u32 {
    let field: u32 = EXTENSION_FIELDS.downcast_truncate()
    let bus = lane / field
    let word = lane % field
    let product_start: u32 = PRODUCT_INTERACTION_START.downcast_truncate()
    let round_start: u32 = ROUND_INTERACTION_START.downcast_truncate()
    let linear_start: u32 = LINEAR_INTERACTION_START.downcast_truncate()
    let boundary_start: u32 = BOUNDARY_INTERACTION_START.downcast_truncate()
    let start: u32 = match bus {
        0 => product_start + region_bounds(product_interaction_regions().accumulator).start,
        1 => round_start + region_bounds(round_interaction_regions().accumulator).start,
        2 => linear_start + region_bounds(linear_interaction_regions().accumulator).start,
        3 => boundary_start + region_bounds(boundary_interaction_regions().accumulator).start,
        _ => SPARSE_INTERACTION_AIR_FIELDS.downcast_truncate(),
    }
    start + word
}

/// Gather the four quartic row deltas into a compact scan matrix.
///
/// The source columns are located from the nominal interaction records. The
/// compact scan placement is column-major and contains no copied schema or
/// browser-authored offset table.
pub fn prepare_sparse_interaction_accumulator_scan_lane<
    const TRACE: usize,
    const INTERACTION_WORDS: usize,
    const SCAN_WORDS: usize,
    const PROGRESS_WORDS: usize,
>(
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ scan: StorageBuffer<u32, SCAN_WORDS>,
    _ progress: StorageBuffer<u32, PROGRESS_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    TRACE > 1,
    {
        (TRACE & (TRACE - 1)) == 0
    },
    {
        INTERACTION_WORDS >= TRACE * SPARSE_INTERACTION_AIR_FIELDS
    },
    {
        SCAN_WORDS >= TRACE * SPARSE_INTERACTION_ACCUMULATOR_FIELDS
    },
    {
        PROGRESS_WORDS >= TRACE
    }
{
    let row = invocation.global.x
    if row >= TRACE.downcast_truncate() {
        return
    }
    let rows: u32 = TRACE.downcast_truncate()
    let mut lane: u32 = 0
    while lane < SPARSE_INTERACTION_ACCUMULATOR_FIELDS.downcast_truncate() {
        let column = sparse_interaction_accumulator_column(lane)
        scan.store(
            index: lane * rows + row,
            value: interaction.load(index: column * rows + row),
        )
        lane = lane + 1
    }
    progress.store(index: row, value: 0)
}

pub struct SparseInteractionAccumulatorScanFinish {
    pub active: bool,
    pub valid: bool,
    pub terminal: bool,
    pub closed: bool,
}
impl core::marker::Copy for SparseInteractionAccumulatorScanFinish {}

/// Replace row-local deltas with the exclusive accumulators required by the
/// AIR, and expose closure of all four extension-field buses at the terminal
/// row. The inclusive scan retains the total, while subtracting the original
/// row delta produces the exact accumulator before that row.
pub fn finish_sparse_interaction_accumulator_scan_lane<
    const TRACE: usize,
    const INTERACTION_WORDS: usize,
    const PRIMARY_WORDS: usize,
    const SECONDARY_WORDS: usize,
    const PROGRESS_WORDS: usize,
    Plan: StageGrid,
>(
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ primary: StorageBuffer<u32, PRIMARY_WORDS>,
    _ secondary: StorageBuffer<u32, SECONDARY_WORDS>,
    _ progress: StorageBuffer<u32, PROGRESS_WORDS>,
    _ invocation: ComputeInvocation,
) -> SparseInteractionAccumulatorScanFinish
where
    TRACE > 1,
    {
        (TRACE & (TRACE - 1)) == 0
    },
    {
        INTERACTION_WORDS >= TRACE * SPARSE_INTERACTION_AIR_FIELDS
    },
    {
        PRIMARY_WORDS >= SPARSE_INTERACTION_ACCUMULATOR_FIELDS * TRACE
    },
    {
        SECONDARY_WORDS >= SPARSE_INTERACTION_ACCUMULATOR_FIELDS * TRACE
    },
    {
        PROGRESS_WORDS >= TRACE
    },
    {
        Plan::POINTS == TRACE
    }
{
    let row = invocation.global.x
    if row >= TRACE.downcast_truncate() {
        return SparseInteractionAccumulatorScanFinish {
            active: false,
            valid: true,
            terminal: false,
            closed: true,
        }
    }
    let rows: u32 = TRACE.downcast_truncate()
    let terminal = row + 1 == rows
    let mut lane: u32 = 0
    let mut valid = true
    let mut closed = true
    while lane < SPARSE_INTERACTION_ACCUMULATOR_FIELDS.downcast_truncate() {
        let inclusive = batched_additive_scan_value<
            SPARSE_INTERACTION_ACCUMULATOR_FIELDS,
            TRACE,
            PRIMARY_WORDS,
            SECONDARY_WORDS,
            PROGRESS_WORDS,
            BabyBear,
            Plan,
        >(primary, secondary, progress, lane, row)
        let column = sparse_interaction_accumulator_column(lane)
        let delta = interaction.load(index: column * rows + row)
        valid = valid && inclusive.valid && delta < BABY_BEAR_MODULUS
        let exclusive = (BabyBear::from_u32(inclusive.value) - BabyBear::from_u32(delta)).to_u32()
        interaction.store(index: column * rows + row, value: exclusive)
        if terminal {
            closed = closed && inclusive.value == 0
        }
        lane = lane + 1
    }
    SparseInteractionAccumulatorScanFinish {
        active: true,
        valid: valid,
        terminal: terminal,
        closed: closed,
    }
}

fn encode_interaction_bus<T: CanonicalWords, const TRACE: usize, const INTERACTION_WORDS: usize>(
    _ value: ref T,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ row: u32,
    _ start: u32,
) -> bool {
    encode_canonical_words(
        ref value,
        ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(interaction, row, start, T::WORDS),
    )
        .finish()
}

/// Stream the product address plan and its two batch-inversion denominators
/// from one committed base row. The nominal inverse fields are deliberate
/// phase-local scratch until the shared scan replaces every denominator with
/// its inverse. No field inversion occurs in this per-row kernel.
pub fn prepare_sparse_product_interaction_denominator_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const BASE_TRACE_WORDS: usize,
    const CHALLENGE_OUTPUT_WORDS: usize,
    const INTERACTION_WORDS: usize,
    const VALIDITY_WORDS: usize,
>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ challenge_output: StorageBuffer<u32, CHALLENGE_OUTPUT_WORDS>,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ validity: StorageBuffer<u32, VALIDITY_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    {
        BASE_TRACE_WORDS >= TRACE * SPARSE_BASE_AIR_FIELDS
    },
    {
        CHALLENGE_OUTPUT_WORDS
            >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values())
    },
    {
        INTERACTION_WORDS >= TRACE * SPARSE_INTERACTION_AIR_FIELDS
    },
    {
        VALIDITY_WORDS >= TRACE
    }
{
    let row = invocation.global.x
    if row >= TRACE.downcast_truncate() {
        return
    }
    let batch = load_sparse_lde_interaction_challenge_batch<L, TRACE, LDE, CHALLENGE_OUTPUT_WORDS>(
        challenge_output,
    )
    let decoded_control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let decoded = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let control = decoded_control.value
    let row_value = decoded.value
    let regions = product_interaction_regions()
    let product_start: u32 = PRODUCT_INTERACTION_START.downcast_truncate()
    let plan_bounds = region_bounds(regions.address_plan)
    let plan_writer = ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(
        interaction,
        row,
        product_start + plan_bounds.start,
        plan_bounds.words,
    )
    let planned = sparse_product_copy_plan<
        QuadraticWordWitnessInterpreter<
            BabyBearExt4EmbeddingSink<ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>>,
            SPARSE_PRODUCT_ADDRESS_MULTIPLICATIONS,
        >,
        BabyBear,
        L,
    >(
        control,
        row_value,
        QuadraticWordWitnessInterpreter::new(BabyBearExt4EmbeddingSink::new(plan_writer)),
    )
    let ports: [SparseCopyPort<BabyBearExt4>; 2] = [
        sparse_copy_port_extension(planned.first),
        sparse_copy_port_extension(planned.second),
    ]
    let mut denominators = [BabyBearExt4::one(); 2]
    write_sparse_copy_interaction_batch_denominators<BabyBearExt4, 2>(
        batch.value.product,
        ref ports,
        mut denominators,
    )
    let zero = BabyBearExt4::zero()
    let accumulator_bounds = region_bounds(regions.accumulator)
    let accumulator_writer = encode_canonical_words(
        ref zero,
        ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(
            interaction,
            row,
            product_start + accumulator_bounds.start,
            accumulator_bounds.words,
        ),
    )
    let inverse_bounds = region_bounds(regions.inverses)
    let denominator_writer = encode_canonical_words(
        ref denominators,
        ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(
            interaction,
            row,
            product_start + inverse_bounds.start,
            inverse_bounds.words,
        ),
    )
    let plan_writer = planned.interpreter.finish().finish()
    let valid = batch.valid
        && decoded_control.valid
        && decoded.valid
        && accumulator_writer.finish()
        && denominator_writer.finish()
        && plan_writer.finish()
    validity.store(index: row, value: if valid { 1 } else { 0 })
}

/// Derive product-bus inverses and deltas from the committed base row. This
/// scalar-shaped placement remains only as a compile-scale regression while
/// the production actor moves to global batch inversion.
pub fn write_sparse_product_interaction_local_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const BASE_TRACE_WORDS: usize,
    const CHALLENGE_OUTPUT_WORDS: usize,
    const INTERACTION_WORDS: usize,
    const VALIDITY_WORDS: usize,
>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ challenge_output: StorageBuffer<u32, CHALLENGE_OUTPUT_WORDS>,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ validity: StorageBuffer<u32, VALIDITY_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    {
        BASE_TRACE_WORDS >= TRACE * SPARSE_BASE_AIR_FIELDS
    },
    {
        CHALLENGE_OUTPUT_WORDS
            >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values())
    },
    {
        INTERACTION_WORDS >= TRACE * SPARSE_INTERACTION_AIR_FIELDS
    },
    {
        VALIDITY_WORDS >= TRACE
    }
{
    let row = invocation.global.x
    if row >= TRACE.downcast_truncate() {
        return
    }
    let batch = load_sparse_lde_interaction_challenge_batch<L, TRACE, LDE, CHALLENGE_OUTPUT_WORDS>(
        challenge_output,
    )
    let decoded = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let control = sparse_control_row_at<BabyBearExt4, L>(row)
    let row_value = sparse_task_row_extension(decoded.value)
    let regions = product_interaction_regions()
    let product_start: u32 = PRODUCT_INTERACTION_START.downcast_truncate()
    let plan_bounds = region_bounds(regions.address_plan)
    let plan_writer = ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(
        interaction,
        row,
        product_start + plan_bounds.start,
        plan_bounds.words,
    )
    let planned = sparse_product_copy_plan<
        QuadraticWordWitnessInterpreter<
            ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>,
            SPARSE_PRODUCT_ADDRESS_MULTIPLICATIONS,
        >,
        BabyBearExt4,
        L,
    >(
        control,
        row_value,
        QuadraticWordWitnessInterpreter::new(plan_writer),
    )
    let ports: [SparseCopyPort<BabyBearExt4>; 2] = [planned.first, planned.second]
    let mut inverses = [BabyBearExt4::zero(); 2]
    write_sparse_copy_interaction_inverses<BabyBearExt4, 2>(
        batch.value.product,
        ref ports,
        mut inverses,
    )
    let delta = sparse_copy_interaction_delta<BabyBearExt4, 2>(ports, inverses)
    let accumulator_bounds = region_bounds(regions.accumulator)
    let accumulator_writer = encode_canonical_words(
        ref delta,
        ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(
            interaction,
            row,
            product_start + accumulator_bounds.start,
            accumulator_bounds.words,
        ),
    )
    let inverse_bounds = region_bounds(regions.inverses)
    let inverse_writer = encode_canonical_words(
        ref inverses,
        ColumnMajorWordWriter<TRACE, INTERACTION_WORDS>::new(
            interaction,
            row,
            product_start + inverse_bounds.start,
            inverse_bounds.words,
        ),
    )
    let plan_writer = planned.interpreter.finish()
    let valid = batch.valid
        && decoded.valid
        && sparse_copy_interaction_witness_valid<BabyBearExt4, 2>(
            batch.value.product,
            ports,
            inverses,
        )
        && accumulator_writer.finish()
        && inverse_writer.finish()
        && plan_writer.finish()
    validity.store(index: row, value: if valid { 1 } else { 0 })
}

/// Reinterpret the committed base-field round plan directly from trace
/// storage, then lift only its five ports into the extension-field interaction
/// bus. The authored plan executes once and no private plan or residual array
/// exists in this kernel.
pub fn write_sparse_round_interaction_local_lane<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const BASE_TRACE_WORDS: usize,
    const CHALLENGE_OUTPUT_WORDS: usize,
    const INTERACTION_WORDS: usize,
    const VALIDITY_WORDS: usize,
>(
    _ base_trace: StorageBuffer<u32, BASE_TRACE_WORDS>,
    _ challenge_output: StorageBuffer<u32, CHALLENGE_OUTPUT_WORDS>,
    _ interaction: StorageBuffer<u32, INTERACTION_WORDS>,
    _ validity: StorageBuffer<u32, VALIDITY_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    L > 1,
    TRACE > 0,
    LDE > TRACE,
    {
        BASE_TRACE_WORDS >= TRACE * SPARSE_BASE_AIR_FIELDS
    },
    {
        CHALLENGE_OUTPUT_WORDS
            >= digest_squeeze_batch_output_words(sparse_interaction_challenge_values())
    },
    {
        INTERACTION_WORDS >= TRACE * SPARSE_INTERACTION_AIR_FIELDS
    },
    {
        VALIDITY_WORDS >= TRACE
    }
{
    let row = invocation.global.x
    if row >= TRACE.downcast_truncate() {
        return
    }
    let batch = load_sparse_lde_interaction_challenge_batch<L, TRACE, LDE, CHALLENGE_OUTPUT_WORDS>(
        challenge_output,
    )
    let decoded_control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let decoded_next_control = decode_stored_control<L, TRACE, BASE_TRACE_WORDS>(
        base_trace,
        row + 1,
    )
    let decoded = decode_stored_witness<TRACE, BASE_TRACE_WORDS>(base_trace, row)
    let plan_reader = ColumnMajorWordReader<TRACE, BASE_TRACE_WORDS>::new(
        base_trace,
        row,
        ROUND_PLAN_START.downcast_truncate(),
        ROUND_PLAN_WORDS.downcast_truncate(),
    )
    let planned = sparse_round_copy_plan<
        QuadraticWordConstraintInterpreter<
            ColumnMajorWordReader<TRACE, BASE_TRACE_WORDS>,
            SPARSE_ROUND_PORT_MULTIPLICATIONS,
        >,
        BabyBear,
        L,
    >(
        decoded_control.value,
        decoded_next_control.value,
        decoded.value,
        QuadraticWordConstraintInterpreter::new(plan_reader),
    )
    let checked = planned.interpreter.finish()
    let ports: [SparseCopyPort<BabyBearExt4>; 5] = [
        sparse_copy_port_extension(planned.ports[0]),
        sparse_copy_port_extension(planned.ports[1]),
        sparse_copy_port_extension(planned.ports[2]),
        sparse_copy_port_extension(planned.ports[3]),
        sparse_copy_port_extension(planned.ports[4]),
    ]
    let mut inverses = [BabyBearExt4::zero(); 5]
    write_sparse_copy_interaction_inverses<BabyBearExt4, 5>(
        batch.value.round,
        ref ports,
        mut inverses,
    )
    let mut value = zero_sparse_interaction_trace_row().round
    value.accumulator = sparse_copy_interaction_delta<BabyBearExt4, 5>(ports, inverses)
    value.inverses = inverses
    let valid = validity.load(index: row) == 1
        && batch.valid
        && decoded_control.valid
        && decoded_next_control.valid
        && decoded.valid
        && checked.valid
        && checked.reader.finish()
        && sparse_copy_interaction_witness_valid<BabyBearExt4, 5>(
            batch.value.round,
            ports,
            inverses,
        )
        && encode_interaction_bus<
            SparseRoundInteractionRow<BabyBearExt4>,
            TRACE,
            INTERACTION_WORDS,
        >(
            ref value,
            interaction,
            row,
            ROUND_INTERACTION_START.downcast_truncate(),
        )
    validity.store(index: row, value: if valid { 1 } else { 0 })
}

