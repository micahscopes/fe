//! BN254 evaluation of the bounded Mandelbrot AIR polynomials.
//!
//! This is the proof-field lift of the integer residuals in the reusable
//! `mandelbrot_proof_kernel` ingot.
//! It consumes the canonical sign-plus-magnitude columns, reconstructs signed
//! field values algebraically as `(1 - 2s) * magnitude`, constrains every sign
//! with `s * (s - 1)`, and evaluates the row and transition equalities in
//! BN254 Fr. Generic bit decomposition, quadratic prefix OR, canonical-zero,
//! signed-i32, and terminal-threshold residuals live below. Full row wiring,
//! composition, commitments, and low-degree testing remain separate layers.

use precision::bn254_fr::Bn254Fr
use precision::field::FieldElement
use precision::polynomial::radix2_intt
pub use mandelbrot_proof_kernel::{
    AUXILIARY_ROW_BITS,
    BitRangeWitness,
    ENCODED_PROOF_ROW_WIDTHS,
    EncodedAirRow,
    EncodedProofRow,
    OrWitness,
    RangedAirRow,
    RangedSigned,
    RangedUnsigned,
    SignedWord,
    derive_ranged_air_row,
    encoded_auxiliary_row_bit,
    encoded_proof_row_words,
}

pub type Fr = FieldElement<20, Bn254Fr>

pub const MAIN_LDE_ROW_FIELDS: usize = 17

pub struct SignedField { pub sign: Fr, pub magnitude: Fr, pub value: Fr }

impl core::marker::Copy for SignedField {}

pub struct AirFieldRow {
    pub step: Fr,
    pub zr: SignedField,
    pub zi: SignedField,
    pub rr: Fr,
    pub ii: Fr,
    pub magnitude: Fr,
    pub q_re: SignedField,
    pub r_re: Fr,
    pub q_im: SignedField,
    pub r_im: Fr,
    pub terminal: Fr,
}

impl core::marker::Copy for AirFieldRow {}

/// The 17 main-trace columns evaluated at one LDE point. Keeping the semantic
/// row nominal lets AIR code use names while commitment code receives one
/// canonical field order through `main_lde_row_values`.
pub struct MainLdeRow { pub active: Fr, pub terminal: Fr, pub air: AirFieldRow }

impl core::marker::Copy for MainLdeRow {}

/// The 411 range and prefix columns evaluated at the same LDE point.
pub struct AuxiliaryLdeRow { pub values: [Fr; AUXILIARY_ROW_BITS] }

impl core::marker::Copy for AuxiliaryLdeRow {}

/// One authenticated AIR leaf before row and auxiliary commitments are
/// domain-separated. This is the verifier-facing witness shape as well as the
/// prover's derived LDE row, so there is no parallel numeric lane protocol.
pub struct AirLdeRow { pub main: MainLdeRow, pub auxiliary: AuxiliaryLdeRow }

impl core::marker::Copy for AirLdeRow {}

const ZERO_SIGNED_FIELD: SignedField = SignedField {
    sign: Fr::zero(),
    magnitude: Fr::zero(),
    value: Fr::zero(),
}

/// Compile-time storage initializer for a caller-owned LDE row. This is a
/// value rather than a runtime constructor so the 428-field row never becomes
/// a flattened function result in Wasm.
pub const ZERO_AIR_LDE_ROW: AirLdeRow = AirLdeRow {
    main: MainLdeRow {
        active: Fr::zero(),
        terminal: Fr::zero(),
        air: AirFieldRow {
            step: Fr::zero(),
            zr: ZERO_SIGNED_FIELD,
            zi: ZERO_SIGNED_FIELD,
            rr: Fr::zero(),
            ii: Fr::zero(),
            magnitude: Fr::zero(),
            q_re: ZERO_SIGNED_FIELD,
            r_re: Fr::zero(),
            q_im: ZERO_SIGNED_FIELD,
            r_im: Fr::zero(),
            terminal: Fr::zero(),
        },
    },
    auxiliary: AuxiliaryLdeRow { values: [Fr::zero(); AUXILIARY_ROW_BITS] },
}

fn field_is_zero(_ value: Fr) -> bool {
    let words = value.to_montgomery_words()
    let mut i: u32 = 0
    while i < 20 {
        if words[i as usize] != 0 {
            return false
        }
        i = i + 1
    }
    true
}

fn bit_residual(_ word: Fr) -> Fr {
    word * (word - Fr::one())
}

fn residual_flag(_ residual: Fr) -> u32 {
    if field_is_zero(residual) { 0 } else { 1 }
}

fn signed_value(_ sign: Fr, _ magnitude: Fr) -> Fr {
    magnitude - sign * magnitude * Fr::from_u32(2)
}

pub fn signed_field(_ word: SignedWord) -> SignedField {
    let sign = Fr::from_u32(word.sign)
    let magnitude = Fr::from_u32(word.magnitude)
    SignedField { sign: sign, magnitude: magnitude, value: signed_value(sign, magnitude) }
}

fn air_field_row(_ row: EncodedAirRow) -> AirFieldRow {
    AirFieldRow {
        step: Fr::from_u32(row.step),
        zr: signed_field(row.zr),
        zi: signed_field(row.zi),
        rr: Fr::from_u32(row.rr),
        ii: Fr::from_u32(row.ii),
        magnitude: Fr::from_u32(row.magnitude),
        q_re: signed_field(row.q_re),
        r_re: Fr::from_u32(row.r_re),
        q_im: signed_field(row.q_im),
        r_im: Fr::from_u32(row.r_im),
        terminal: Fr::from_u32(row.terminal),
    }
}

fn proof_field_row(_ row: EncodedProofRow) -> MainLdeRow {
    MainLdeRow {
        active: Fr::from_u32(row.active),
        terminal: Fr::from_u32(row.terminal),
        air: air_field_row(row.air),
    }
}

fn air_words(_ row: AirFieldRow) -> [Fr; 15] {
    [
        row.step,
        row.zr.sign,
        row.zr.magnitude,
        row.zi.sign,
        row.zi.magnitude,
        row.rr,
        row.ii,
        row.magnitude,
        row.q_re.sign,
        row.q_re.magnitude,
        row.r_re,
        row.q_im.sign,
        row.q_im.magnitude,
        row.r_im,
        row.terminal,
    ]
}

pub fn main_lde_row_values(_ row: MainLdeRow) -> [Fr; MAIN_LDE_ROW_FIELDS] {
    let air = air_words(row.air)
    [
        air[0],
        air[1],
        air[2],
        air[3],
        air[4],
        air[5],
        air[6],
        air[7],
        air[8],
        air[9],
        air[10],
        air[11],
        air[12],
        air[13],
        air[14],
        row.active,
        row.terminal,
    ]
}

fn local_residuals(_ row: AirFieldRow) -> [Fr; 9] {
    let scale = Fr::from_u32(4096)
    [
        bit_residual(row.zr.sign),
        bit_residual(row.zi.sign),
        bit_residual(row.q_re.sign),
        bit_residual(row.q_im.sign),
        row.rr - row.zr.value.square(),
        row.ii - row.zi.value.square(),
        row.magnitude - row.rr - row.ii,
        row.rr - row.ii - scale * row.q_re.value - row.r_re,
        Fr::from_u32(2) * row.zr.value * row.zi.value - scale * row.q_im.value - row.r_im,
    ]
}

fn transition_residuals(
    _ c_re: SignedField,
    _ c_im: SignedField,
    _ row: AirFieldRow,
    _ next: AirFieldRow,
) -> [Fr; 9] {
    [
        bit_residual(c_re.sign),
        bit_residual(c_im.sign),
        bit_residual(row.q_re.sign),
        bit_residual(row.q_im.sign),
        bit_residual(next.zr.sign),
        bit_residual(next.zi.sign),
        next.step - row.step - Fr::one(),
        next.zr.value - row.q_re.value - c_re.value,
        next.zi.value - row.q_im.value - c_im.value,
    ]
}

fn scaled_residual_mask<const N: usize>(_ selector: Fr, _ residuals: [Fr; N]) -> u32 {
    let mut selected: [Fr; N] = [Fr::zero(); N]
    let count: u32 = N.downcast_truncate()
    let mut i: u32 = 0
    while i < count {
        selected[i as usize] = selector * residuals[i as usize]
        i = i + 1
    }
    residual_mask<N>(selected)
}

fn row_state_residuals(_ row: MainLdeRow) -> [Fr; 5] {
    let one = Fr::one()
    [
        bit_residual(row.active),
        bit_residual(row.terminal),
        bit_residual(row.air.terminal),
        row.terminal - row.active * row.air.terminal,
        (one - row.active) * (row.air.terminal - one),
    ]
}

fn range_residual_masks<const N: usize>(_ value: Fr, _ witness: BitRangeWitness<N>) -> (
    u32,
    u32,
    u32,
    u32,
) {
    let mut bit_mask: u32 = 0
    let mut any_bit_mask: u32 = 0
    let mut any_relation_mask: u32 = 0
    let mut reconstructed = Fr::zero()
    let mut weight = Fr::one()
    let mut previous_any = Fr::zero()
    let count: u32 = N.downcast_truncate()
    let mut i: u32 = 0
    while i < count {
        let bit = Fr::from_u32(witness.bits[i as usize])
        let any = Fr::from_u32(witness.any[i as usize])
        if !field_is_zero(bit_residual(bit)) {
            bit_mask = bit_mask | (1 << i)
        }
        if !field_is_zero(bit_residual(any)) {
            any_bit_mask = any_bit_mask | (1 << i)
        }
        let relation = any - previous_any - bit + previous_any * bit
        if !field_is_zero(relation) {
            any_relation_mask = any_relation_mask | (1 << i)
        }
        reconstructed = reconstructed + bit * weight
        weight = weight + weight
        previous_any = any
        i = i + 1
    }
    (bit_mask, any_bit_mask, any_relation_mask, residual_flag(value - reconstructed))
}

fn combined_range_mask<const N: usize>(_ value: u32, _ witness: BitRangeWitness<N>) -> u32 {
    let masks = range_residual_masks<N>(Fr::from_u32(value), witness)
    masks.0 | masks.1 | masks.2 | masks.3
}

fn combined_signed_range_mask<const N: usize>(
    _ value: SignedWord,
    _ witness: BitRangeWitness<N>,
) -> u32 {
    let masks = range_residual_masks<N>(Fr::from_u32(value.magnitude), witness)
    let mut nonzero = Fr::zero()
    let count: u32 = N.downcast_truncate()
    let mut i: u32 = 0
    while i < count {
        nonzero = Fr::from_u32(witness.any[i as usize])
        i = i + 1
    }
    let sign = Fr::from_u32(value.sign)
    masks.0
        | masks.1
        | masks.2
        | masks.3
        | residual_flag(bit_residual(sign))
        | residual_flag(sign * (Fr::one() - nonzero))
}

fn residual_mask<const N: usize>(_ residuals: [Fr; N]) -> u32 {
    let mut mask: u32 = 0
    let mut i: u32 = 0
    let count: u32 = N.downcast_truncate()
    while i < count {
        if !field_is_zero(residuals[i as usize]) {
            mask = mask | (1 << i)
        }
        i = i + 1
    }
    mask
}

pub struct MandelbrotConstraintNumerators {
    pub all_rows: Fr,
    pub pair_rows: Fr,
    pub first_row: Fr,
    pub last_row: Fr,
}

impl core::marker::Copy for MandelbrotConstraintNumerators {}

struct ConstraintFold { challenge: Fr, power: Fr, value: Fr }
impl core::marker::Copy for ConstraintFold {}

impl ConstraintFold {
    fn new(_ challenge: Fr) -> Self {
        Self { challenge: challenge, power: Fr::one(), value: Fr::zero() }
    }

    fn absorb(mut self, _ residual: Fr) -> Self {
        self.value = self.value + self.power * residual
        self.power = self.power * self.challenge
        self
    }

    fn next_family(mut self) -> Self {
        self.value = Fr::zero()
        self
    }
}

fn absorb_residuals<const N: usize>(
    _ fold: own ConstraintFold,
    _ residuals: [Fr; N],
) -> ConstraintFold {
    let mut fold = fold
    let mut index: usize = 0
    while index < N {
        fold = fold.absorb(residuals[index])
        index = index + 1
    }
    fold
}

fn extend_column_point4(_ values: own [Fr; 4], _ point: Fr) -> Fr {
    let coefficients = radix2_intt<4, 20, Bn254Fr>(values)
    ((coefficients[3] * point + coefficients[2]) * point + coefficients[1]) * point
        + coefficients[0]
}

fn main_column_point4(_ rows: own [EncodedProofRow; 4], _ column: usize, _ point: Fr) -> Fr {
    extend_column_point4(
        [
            Fr::from_u32(encoded_proof_row_words(rows[0])[column]),
            Fr::from_u32(encoded_proof_row_words(rows[1])[column]),
            Fr::from_u32(encoded_proof_row_words(rows[2])[column]),
            Fr::from_u32(encoded_proof_row_words(rows[3])[column]),
        ],
        point,
    )
}

fn auxiliary_column_point4(_ rows: own [EncodedProofRow; 4], _ column: usize, _ point: Fr) -> Fr {
    extend_column_point4(
        [
            Fr::from_u32(encoded_auxiliary_row_bit(rows[0].air, column)),
            Fr::from_u32(encoded_auxiliary_row_bit(rows[1].air, column)),
            Fr::from_u32(encoded_auxiliary_row_bit(rows[2].air, column)),
            Fr::from_u32(encoded_auxiliary_row_bit(rows[3].air, column)),
        ],
        point,
    )
}

fn signed_field_point(_ sign: Fr, _ magnitude: Fr) -> SignedField {
    SignedField { sign: sign, magnitude: magnitude, value: signed_value(sign, magnitude) }
}

/// A constraint column source. The derived trace-point and authenticated
/// opening implementations below feed one shared AIR evaluator.
trait AirColumnView: core::marker::Copy {
    fn main(self, _ column: usize) -> Fr
    fn auxiliary(self, _ column: usize) -> Fr
}

struct TracePoint4 { rows: [EncodedProofRow; 4], point: Fr }

impl core::marker::Copy for TracePoint4 {}

impl AirColumnView for TracePoint4 {
    fn main(self, _ column: usize) -> Fr {
        main_column_point4(self.rows, column, self.point)
    }

    fn auxiliary(self, _ column: usize) -> Fr {
        auxiliary_column_point4(self.rows, column, self.point)
    }
}

fn main_lde_row_value(_ row: MainLdeRow, _ column: usize) -> Fr {
    if column >= MAIN_LDE_ROW_FIELDS {
        return Fr::zero()
    }
    main_lde_row_values(row)[column]
}

impl AirColumnView for AirLdeRow {
    fn main(self, _ column: usize) -> Fr {
        main_lde_row_value(self.main, column)
    }

    fn auxiliary(self, _ column: usize) -> Fr {
        if column >= AUXILIARY_ROW_BITS {
            return Fr::zero()
        }
        self.auxiliary.values[column]
    }
}

fn main_lde_row_from_view<V: AirColumnView>(_ view: V) -> MainLdeRow {
    MainLdeRow {
        active: view.main(15),
        terminal: view.main(16),
        air: AirFieldRow {
            step: view.main(0),
            zr: signed_field_point(view.main(1), view.main(2)),
            zi: signed_field_point(view.main(3), view.main(4)),
            rr: view.main(5),
            ii: view.main(6),
            magnitude: view.main(7),
            q_re: signed_field_point(view.main(8), view.main(9)),
            r_re: view.main(10),
            q_im: signed_field_point(view.main(11), view.main(12)),
            r_im: view.main(13),
            terminal: view.main(14),
        },
    }
}

/// Derive one complete field-valued AIR row from the canonical four-row trace.
/// This is used both to build LDE commitments and to materialize the four rows
/// selected by a Fiat-Shamir query.
pub fn write_air_lde_row4(
    _ rows: own [EncodedProofRow; 4],
    _ point: Fr,
    _ output: mut AirLdeRow,
) {
    let view = TracePoint4 { rows: rows, point: point }
    output.main.active = view.main(15)
    output.main.terminal = view.main(16)
    output.main.air.step = view.main(0)
    output.main.air.zr = signed_field_point(view.main(1), view.main(2))
    output.main.air.zi = signed_field_point(view.main(3), view.main(4))
    output.main.air.rr = view.main(5)
    output.main.air.ii = view.main(6)
    output.main.air.magnitude = view.main(7)
    output.main.air.q_re = signed_field_point(view.main(8), view.main(9))
    output.main.air.r_re = view.main(10)
    output.main.air.q_im = signed_field_point(view.main(11), view.main(12))
    output.main.air.r_im = view.main(13)
    output.main.air.terminal = view.main(14)
    let mut column: usize = 0
    while column < AUXILIARY_ROW_BITS {
        output.auxiliary.values[column] = view.auxiliary(column)
        column = column + 1
    }
}

/// Return the one-based index of the first field that differs between direct
/// trace interpolation and the materialized row, or zero when all 428 fields
/// agree. Main columns precede auxiliary columns in the diagnostic index.
pub fn air_lde_row4_first_mismatch(
    _ rows: own [EncodedProofRow; 4],
    _ point: Fr,
) -> u32 {
    let view = TracePoint4 { rows: rows, point: point }
    let mut row = ZERO_AIR_LDE_ROW
    write_air_lde_row4(rows, point, mut row)
    let main = main_lde_row_values(row.main)
    let mut column: usize = 0
    while column < MAIN_LDE_ROW_FIELDS {
        if !(view.main(column) - main[column]).is_zero() {
            return (column + 1).downcast_truncate()
        }
        column = column + 1
    }
    column = 0
    while column < AUXILIARY_ROW_BITS {
        if !(view.auxiliary(column) - row.auxiliary.values[column]).is_zero() {
            return (MAIN_LDE_ROW_FIELDS + column + 1).downcast_truncate()
        }
        column = column + 1
    }
    0
}

/// Stream one interpolated bit range into the challenge-power fold. Keeping
/// the canonical rows and cursor compact avoids a giant field-valued witness
/// aggregate at the Wasm boundary.
fn absorb_range_columns<const N: usize, V: AirColumnView>(
    _ fold: own ConstraintFold,
    _ value: Fr,
    _ view: V,
    _ start: usize,
) -> ConstraintFold {
    let mut fold = fold
    let mut reconstructed = Fr::zero()
    let mut weight = Fr::one()
    let mut previous_any = Fr::zero()
    let mut index: usize = 0
    while index < N {
        let bit = view.auxiliary(start + index)
        let any = view.auxiliary(start + N + index)
        fold = fold.absorb(bit_residual(bit))
        fold = fold.absorb(bit_residual(any))
        fold = fold.absorb(any - previous_any - bit + previous_any * bit)
        reconstructed = reconstructed + bit * weight
        weight = weight + weight
        previous_any = any
        index = index + 1
    }
    fold.absorb(value - reconstructed)
}

fn absorb_signed_range_columns<const N: usize, V: AirColumnView>(
    _ fold: own ConstraintFold,
    _ sign: Fr,
    _ magnitude: Fr,
    _ view: V,
    _ start: usize,
) -> ConstraintFold {
    let mut fold = fold.absorb(bit_residual(sign))
    fold = absorb_range_columns<N, V>(fold, magnitude, view, start)
    let nonzero = view.auxiliary(start + 2 * N - 1)
    fold.absorb(sign * (Fr::one() - nonzero))
}

fn absorb_terminal_range_columns<V: AirColumnView>(
    _ fold: own ConstraintFold,
    _ magnitude: Fr,
    _ terminal: Fr,
    _ view: V,
    _ magnitude_start: usize,
    _ terminal_start: usize,
) -> ConstraintFold {
    let mut fold = absorb_range_columns<31, V>(fold, magnitude, view, magnitude_start)
    fold = fold.absorb(bit_residual(terminal))
    let mut previous = Fr::zero()
    let mut index: usize = 0
    while index < 5 {
        let bit = view.auxiliary(magnitude_start + index + 26)
        let any = view.auxiliary(terminal_start + index)
        fold = fold.absorb(bit_residual(any))
        fold = fold.absorb(any - previous - bit + previous * bit)
        previous = any
        index = index + 1
    }
    fold.absorb(terminal - previous)
}

/// Fold every AIR constraint with consecutive powers of one transcript-derived
/// challenge. The four outputs remain separate because each constraint family
/// has a different zerofier in the composition polynomial.
fn mandelbrot_constraint_numerators_from_views<Row: AirColumnView, Next: AirColumnView>(
    _ challenge: Fr,
    _ c_re: SignedField,
    _ c_im: SignedField,
    _ row_view: Row,
    _ next_view: Next,
) -> MandelbrotConstraintNumerators {
    let row = main_lde_row_from_view<Row>(row_view)
    let next = main_lde_row_from_view<Next>(next_view)
    let one = Fr::one()
    let continue_selector = row.active * (one - row.terminal)
    let freeze_selector = row.terminal + (one - row.active)

    let mut fold = ConstraintFold::new(challenge)
    fold = absorb_residuals<9>(fold, local_residuals(row.air))
    fold = absorb_residuals<5>(fold, row_state_residuals(row))
    let mut cursor: usize = 0
    fold = absorb_range_columns<21, Row>(fold, row.air.step, row_view, cursor)
    cursor = cursor + 2 * 21
    fold = absorb_signed_range_columns<15, Row>(
        fold,
        row.air.zr.sign,
        row.air.zr.magnitude,
        row_view,
        cursor,
    )
    cursor = cursor + 2 * 15
    fold = absorb_signed_range_columns<15, Row>(
        fold,
        row.air.zi.sign,
        row.air.zi.magnitude,
        row_view,
        cursor,
    )
    cursor = cursor + 2 * 15
    fold = absorb_range_columns<30, Row>(fold, row.air.rr, row_view, cursor)
    cursor = cursor + 2 * 30
    fold = absorb_range_columns<30, Row>(fold, row.air.ii, row_view, cursor)
    cursor = cursor + 2 * 30
    let magnitude_start = cursor
    cursor = cursor + 2 * 31
    fold = absorb_signed_range_columns<18, Row>(
        fold,
        row.air.q_re.sign,
        row.air.q_re.magnitude,
        row_view,
        cursor,
    )
    cursor = cursor + 2 * 18
    fold = absorb_range_columns<12, Row>(fold, row.air.r_re, row_view, cursor)
    cursor = cursor + 2 * 12
    fold = absorb_signed_range_columns<19, Row>(
        fold,
        row.air.q_im.sign,
        row.air.q_im.magnitude,
        row_view,
        cursor,
    )
    cursor = cursor + 2 * 19
    fold = absorb_range_columns<12, Row>(fold, row.air.r_im, row_view, cursor)
    cursor = cursor + 2 * 12
    if cursor + 5 != AUXILIARY_ROW_BITS {
        return MandelbrotConstraintNumerators {
            all_rows: Fr::zero(),
            pair_rows: Fr::zero(),
            first_row: Fr::zero(),
            last_row: Fr::zero(),
        }
    }
    fold = absorb_terminal_range_columns<Row>(
        fold,
        row.air.magnitude,
        row.air.terminal,
        row_view,
        magnitude_start,
        cursor,
    )
    let all_rows = fold.value

    fold = fold.next_family()
    let row_state = row_state_residuals(row)
    let next_state = row_state_residuals(next)
    fold = absorb_residuals<5>(fold, row_state)
    fold = absorb_residuals<5>(fold, next_state)
    fold = fold.absorb(continue_selector * (next.active - one))
    fold = fold.absorb(freeze_selector * next.active)
    fold = fold.absorb(freeze_selector * next.terminal)
    let row_words = air_words(row.air)
    let next_words = air_words(next.air)
    let mut column: usize = 0
    while column < 15 {
        fold = fold.absorb(freeze_selector * (next_words[column] - row_words[column]))
        column = column + 1
    }
    let transition = transition_residuals(c_re, c_im, row.air, next.air)
    column = 0
    while column < 9 {
        fold = fold.absorb(continue_selector * transition[column])
        column = column + 1
    }
    let pair_rows = fold.value

    fold = fold.next_family()
    let first_state = row_state_residuals(row)
    fold = absorb_residuals<5>(fold, first_state)
    fold = fold.absorb(row.active - one)
    fold = fold.absorb(row.terminal)
    fold = fold.absorb(row.air.step)
    fold = fold.absorb(row.air.zr.sign)
    fold = fold.absorb(row.air.zr.magnitude)
    fold = fold.absorb(row.air.zi.sign)
    fold = fold.absorb(row.air.zi.magnitude)
    let first_row = fold.value

    fold = fold.next_family()
    let last_state = row_state_residuals(row)
    fold = absorb_residuals<5>(fold, last_state)
    fold = fold.absorb(row.active * (one - row.terminal))
    MandelbrotConstraintNumerators {
        all_rows: all_rows,
        pair_rows: pair_rows,
        first_row: first_row,
        last_row: fold.value,
    }
}

/// Prover-side evaluation directly from the four canonical Fe rows.
pub fn mandelbrot_constraint_numerators_trace4(
    _ challenge: Fr,
    _ c_re: SignedField,
    _ c_im: SignedField,
    _ rows: own [EncodedProofRow; 4],
    _ point: Fr,
    _ next_point: Fr,
) -> MandelbrotConstraintNumerators {
    mandelbrot_constraint_numerators_from_views<TracePoint4, TracePoint4>(
        challenge,
        c_re,
        c_im,
        TracePoint4 { rows: rows, point: point },
        TracePoint4 { rows: rows, point: next_point },
    )
}

/// Verifier-side evaluation from two authenticated field-valued rows. It is
/// the same generic constraint fold as the prover path, not a second formula.
pub fn mandelbrot_constraint_numerators_opened(
    _ challenge: Fr,
    _ c_re: SignedField,
    _ c_im: SignedField,
    _ row: AirLdeRow,
    _ next: AirLdeRow,
) -> MandelbrotConstraintNumerators {
    mandelbrot_constraint_numerators_from_views<AirLdeRow, AirLdeRow>(
        challenge,
        c_re,
        c_im,
        row,
        next,
    )
}

/// Evaluate the five local Mandelbrot equalities and the four sign-bit
/// polynomials. Bit `i` is one exactly when residual `i` is nonzero:
/// `(x_sign, y_sign, q_re_sign, q_im_sign, x^2, y^2, magnitude,
/// real_shift, imaginary_shift)`.
pub fn mandelbrot_bn254_local_residual_mask(
    zr_sign: u32,
    zr_magnitude: u32,
    zi_sign: u32,
    zi_magnitude: u32,
    rr: u32,
    ii: u32,
    magnitude: u32,
    q_re_sign: u32,
    q_re_magnitude: u32,
    r_re: u32,
    q_im_sign: u32,
    q_im_magnitude: u32,
    r_im: u32,
) -> u32 {
    let row = air_field_row(
        EncodedAirRow {
            step: 0,
            zr: SignedWord { sign: zr_sign, magnitude: zr_magnitude },
            zi: SignedWord { sign: zi_sign, magnitude: zi_magnitude },
            rr: rr,
            ii: ii,
            magnitude: magnitude,
            q_re: SignedWord { sign: q_re_sign, magnitude: q_re_magnitude },
            r_re: r_re,
            q_im: SignedWord { sign: q_im_sign, magnitude: q_im_magnitude },
            r_im: r_im,
            terminal: 0,
        },
    )
    residual_mask<9>(local_residuals(row))
}

/// Evaluate the directed-row equalities plus the six sign-bit polynomials.
/// Residual order is `(c_re_sign, c_im_sign, q_re_sign, q_im_sign,
/// next_x_sign, next_y_sign, step, next_x, next_y)`.
pub fn mandelbrot_bn254_transition_residual_mask(
    c_re_sign: u32,
    c_re_magnitude: u32,
    c_im_sign: u32,
    c_im_magnitude: u32,
    step: u32,
    q_re_sign: u32,
    q_re_magnitude: u32,
    q_im_sign: u32,
    q_im_magnitude: u32,
    next_step: u32,
    next_zr_sign: u32,
    next_zr_magnitude: u32,
    next_zi_sign: u32,
    next_zi_magnitude: u32,
) -> u32 {
    let zero = SignedWord { sign: 0, magnitude: 0 }
    let row = air_field_row(
        EncodedAirRow {
            step: step,
            zr: zero,
            zi: zero,
            rr: 0,
            ii: 0,
            magnitude: 0,
            q_re: SignedWord { sign: q_re_sign, magnitude: q_re_magnitude },
            r_re: 0,
            q_im: SignedWord { sign: q_im_sign, magnitude: q_im_magnitude },
            r_im: 0,
            terminal: 0,
        },
    )
    let next = air_field_row(
        EncodedAirRow {
            step: next_step,
            zr: SignedWord { sign: next_zr_sign, magnitude: next_zr_magnitude },
            zi: SignedWord { sign: next_zi_sign, magnitude: next_zi_magnitude },
            rr: 0,
            ii: 0,
            magnitude: 0,
            q_re: zero,
            r_re: 0,
            q_im: zero,
            r_im: 0,
            terminal: 0,
        },
    )
    residual_mask<9>(
        transition_residuals(
            signed_field(SignedWord { sign: c_re_sign, magnitude: c_re_magnitude }),
            signed_field(SignedWord { sign: c_im_sign, magnitude: c_im_magnitude }),
            row,
            next,
        ),
    )
}

/// Constrain one padded trace pair. The first mask contains the boolean state
/// machine and terminal-state fixed point. The second contains the Mandelbrot
/// transition residuals selected only on an active nonterminal row.
pub fn mandelbrot_bn254_padded_pair_residual_masks(
    _ c_re: SignedWord,
    _ c_im: SignedWord,
    _ row: EncodedProofRow,
    _ next: EncodedProofRow,
) -> (u32, u32) {
    let one = Fr::one()
    let row = proof_field_row(row)
    let next = proof_field_row(next)
    let continue_selector = row.active * (one - row.terminal)
    let freeze_selector = row.terminal + (one - row.active)
    let row_state = row_state_residuals(row)
    let next_state = row_state_residuals(next)
    let state_mask = residual_mask<13>(
        [
            row_state[0],
            row_state[1],
            row_state[2],
            row_state[3],
            row_state[4],
            next_state[0],
            next_state[1],
            next_state[2],
            next_state[3],
            next_state[4],
            continue_selector * (next.active - one),
            freeze_selector * next.active,
            freeze_selector * next.terminal,
        ],
    )
    let row_words = air_words(row.air)
    let next_words = air_words(next.air)
    let mut equality: [Fr; 15] = [Fr::zero(); 15]
    let mut i: u32 = 0
    while i < 15 {
        equality[i as usize] = freeze_selector * (next_words[i as usize] - row_words[i as usize])
        i = i + 1
    }
    let equality_mask = residual_mask<15>(equality)
    let transition_mask = scaled_residual_mask<9>(
        continue_selector,
        transition_residuals(signed_field(c_re), signed_field(c_im), row.air, next.air),
    )
    (state_mask | (equality_mask << 13), transition_mask)
}

/// Constrain the canonical first row: active, not terminal, step zero, and
/// `z_0 = (0, 0)`. Row-local arithmetic is checked by the ordinary local mask.
pub fn mandelbrot_bn254_padded_first_residual_mask(_ row: EncodedProofRow) -> u32 {
    let row = proof_field_row(row)
    let state = row_state_residuals(row)
    residual_mask<12>(
        [
            state[0],
            state[1],
            state[2],
            state[3],
            state[4],
            row.active - Fr::one(),
            row.terminal,
            row.air.step,
            row.air.zr.sign,
            row.air.zr.magnitude,
            row.air.zi.sign,
            row.air.zi.magnitude,
        ],
    )
}

/// Constrain the final domain row to active-terminal or inactive padding.
pub fn mandelbrot_bn254_padded_last_residual_mask(_ row: EncodedProofRow) -> u32 {
    let row = proof_field_row(row)
    let state = row_state_residuals(row)
    residual_mask<6>(
        [state[0], state[1], state[2], state[3], state[4], row.active * (Fr::one() - row.terminal)],
    )
}

/// Constrain an unsigned 12-bit value, used by each Euclidean Q12 remainder.
pub fn mandelbrot_bn254_unsigned12_range_residual_masks(
    _ value: u32,
    _ witness: BitRangeWitness<12>,
) -> (u32, u32, u32, u32) {
    range_residual_masks<12>(Fr::from_u32(value), witness)
}

/// Constrain an arbitrary u32 witness column without trusting the Wasm lane's
/// host type as proof evidence.
pub fn mandelbrot_bn254_unsigned32_range_residual_masks(
    _ value: u32,
    _ witness: BitRangeWitness<32>,
) -> (u32, u32, u32, u32) {
    range_residual_masks<32>(Fr::from_u32(value), witness)
}

/// Constrain sign-plus-magnitude as a unique signed 32-bit field encoding.
/// The final residual forces zero to have positive sign.
pub fn mandelbrot_bn254_signed32_range_residual_masks(
    _ value: SignedWord,
    _ witness: BitRangeWitness<32>,
) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let sign = Fr::from_u32(value.sign)
    let range = range_residual_masks<32>(Fr::from_u32(value.magnitude), witness)
    let nonzero = Fr::from_u32(witness.any[31])
    let high = Fr::from_u32(witness.bits[31])
    let lower_nonzero = Fr::from_u32(witness.any[30])
    (
        residual_flag(bit_residual(sign)),
        range.0,
        range.1,
        range.2,
        range.3,
        residual_flag(sign * (Fr::one() - nonzero)),
        residual_flag(high * (sign - Fr::one())),
        residual_flag(high * lower_nonzero),
    )
}

/// Constrain the semantic terminal flag. Magnitude is 31-bit in the canonical
/// trace domain, and the escape threshold is exactly `2^26`, so terminal is
/// the OR of magnitude bits 26 through 30. `high_any` carries that five-step
/// OR through quadratic relations.
pub fn mandelbrot_bn254_terminal_residual_masks(
    _ terminal: u32,
    _ magnitude: u32,
    _ magnitude_witness: BitRangeWitness<31>,
    _ high_any: OrWitness<5>,
) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
    let terminal = Fr::from_u32(terminal)
    let magnitude_range = range_residual_masks<31>(Fr::from_u32(magnitude), magnitude_witness)
    let high_bits = [
        Fr::from_u32(magnitude_witness.bits[26]),
        Fr::from_u32(magnitude_witness.bits[27]),
        Fr::from_u32(magnitude_witness.bits[28]),
        Fr::from_u32(magnitude_witness.bits[29]),
        Fr::from_u32(magnitude_witness.bits[30]),
    ]
    let mut high_any_bit_mask: u32 = 0
    let mut high_relation_mask: u32 = 0
    let mut previous = Fr::zero()
    let mut i: u32 = 0
    while i < 5 {
        let bit = high_bits[i as usize]
        let any = Fr::from_u32(high_any.any[i as usize])
        if !field_is_zero(bit_residual(any)) {
            high_any_bit_mask = high_any_bit_mask | (1 << i)
        }
        let relation = any - previous - bit + previous * bit
        if !field_is_zero(relation) {
            high_relation_mask = high_relation_mask | (1 << i)
        }
        previous = any
        i = i + 1
    }
    (
        magnitude_range.0,
        magnitude_range.1,
        magnitude_range.2,
        magnitude_range.3,
        residual_flag(bit_residual(terminal)),
        high_any_bit_mask,
        high_relation_mask,
        residual_flag(terminal - previous),
    )
}

/// Wire every row column to its Fe-authored width. Result order is `(step,
/// zr, zi, rr, ii, q_re, r_re, q_im, r_im, magnitude_and_terminal)`.
pub fn mandelbrot_bn254_row_range_residual_masks(_ row: RangedAirRow) -> (
    u32,
    u32,
    u32,
    u32,
    u32,
    u32,
    u32,
    u32,
    u32,
    u32,
) {
    let terminal = mandelbrot_bn254_terminal_residual_masks(
        row.terminal,
        row.magnitude.value,
        row.magnitude.witness,
        row.terminal_high_any,
    )
    (
        combined_range_mask<21>(row.step.value, row.step.witness),
        combined_signed_range_mask<15>(row.zr.value, row.zr.witness),
        combined_signed_range_mask<15>(row.zi.value, row.zi.witness),
        combined_range_mask<30>(row.rr.value, row.rr.witness),
        combined_range_mask<30>(row.ii.value, row.ii.witness),
        combined_signed_range_mask<18>(row.q_re.value, row.q_re.witness),
        combined_range_mask<12>(row.r_re.value, row.r_re.witness),
        combined_signed_range_mask<19>(row.q_im.value, row.q_im.witness),
        combined_range_mask<12>(row.r_im.value, row.r_im.witness),
        terminal.0
            | terminal.1
            | terminal.2
            | terminal.3
            | terminal.4
            | terminal.5
            | terminal.6
            | terminal.7,
    )
}

/// Prover-side Fe derivation followed by the independent constraint surface.
/// This boundary demonstrates that range witnesses need not be authored or
/// serialized by the host before they enter the auxiliary trace commitment.
pub fn mandelbrot_bn254_derived_row_range_residual_masks(_ row: EncodedAirRow) -> (
    u32,
    u32,
    u32,
    u32,
    u32,
    u32,
    u32,
    u32,
    u32,
    u32,
) {
    mandelbrot_bn254_row_range_residual_masks(derive_ranged_air_row(row))
}
