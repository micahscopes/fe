//! Quadratic relations for the production BabyBear child verifier.
//!
//! This begins with the exact receipt-header task. The stored task result is
//! witness, not authority: one authored plan constrains receipt validity, both
//! typed roots, trace shape, the nonzero evaluation shift, and the accepted
//! result. Later verifier stages extend this same relation vocabulary rather
//! than treating a trace boolean as proof of its computation.

use mandelbrot_proof_fixed_air_receipt_baby_bear::{
    PRODUCTION_LDE_LOG,
    PRODUCTION_LDE_LENGTH,
    PRODUCTION_LIMBS,
    PRODUCTION_SECURITY_AIR_MAX_LEAVES,
    PRODUCTION_TRACE_LENGTH,
    ProductionSecuritySparseBabyBearReceipt,
    ProductionSecurityVerifierTrace,
}
use mandelbrot_proof_fixed_air_baby_bear::{
    SPARSE_BASE_AIR_FIELDS,
    SPARSE_INTERACTION_AIR_FIELDS,
    SparseBaseLdeLeaf,
    SparseInteractionLdeLeaf,
    sparse_base_lde_leaf_commitment_permutations,
    sparse_base_lde_leaf_commitment_plan,
    sparse_interaction_lde_leaf_commitment_permutations,
    sparse_interaction_lde_leaf_commitment_plan,
}
use merkle_core::{
    MerkleMultiPath,
    MerkleMultiPathInterpretation,
    MerkleMultiPathInterpreter,
    MerkleMultiPathStep,
    MerkleMultiPathTask,
    TwoToOneHasher,
    interpret_multi_root,
}
use precision::baby_bear::BabyBear
use precision::polynomial::Radix2Field
use poseidon_baby_bear::{
    POSEIDON2_PERMUTATION_MULTIPLICATIONS,
    Poseidon2Digest,
    compress,
    compress_plan,
}
use quadratic_plan::{
    QuadraticRelationConstraintInterpreter,
    QuadraticRelationInterpreter,
    QuadraticRelationResiduals,
    QuadraticRelationValueInterpreter,
    QuadraticRelationWitness,
    QuadraticRelationWitnessInterpreter,
}

pub const RECEIPT_HEADER_PRODUCTS: usize = 8
pub const RECEIPT_HEADER_ASSERTIONS: usize = 9
pub const MERKLE_NODE_PRODUCTS: usize = POSEIDON2_PERMUTATION_MULTIPLICATIONS + 9
pub const MERKLE_NODE_ASSERTIONS: usize = 9
pub const PRODUCTION_BASE_LEAF_PRODUCTS: usize =
    sparse_base_lde_leaf_commitment_permutations<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >() * POSEIDON2_PERMUTATION_MULTIPLICATIONS
pub const PRODUCTION_INTERACTION_LEAF_PRODUCTS: usize =
    sparse_interaction_lde_leaf_commitment_permutations<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >() * POSEIDON2_PERMUTATION_MULTIPLICATIONS
pub const PRODUCTION_LEAF_ASSERTIONS: usize = 8

pub const fn merkle_multi_path_max_hashes(
    _ maximum_leaves: usize,
    _ depth: usize,
) -> usize {
    maximum_leaves * depth
}

pub const fn merkle_multi_path_max_products(
    _ maximum_leaves: usize,
    _ depth: usize,
) -> usize {
    merkle_multi_path_max_hashes(maximum_leaves, depth)
        * MERKLE_NODE_PRODUCTS
}

pub const fn merkle_multi_path_max_assertions(
    _ maximum_leaves: usize,
    _ depth: usize,
) -> usize {
    merkle_multi_path_max_hashes(maximum_leaves, depth) + 9
}

pub const PRODUCTION_AIR_MULTIPATH_MAX_HASHES: usize =
    PRODUCTION_SECURITY_AIR_MAX_LEAVES * PRODUCTION_LDE_LOG
pub const PRODUCTION_AIR_MULTIPATH_MAX_PRODUCTS: usize =
    PRODUCTION_AIR_MULTIPATH_MAX_HASHES * MERKLE_NODE_PRODUCTS
pub const PRODUCTION_AIR_MULTIPATH_MAX_ASSERTIONS: usize =
    PRODUCTION_AIR_MULTIPATH_MAX_HASHES + 9

/// Field projection of the exact receipt-header verifier task. The trace row
/// is selected by its semantic position, so no caller-authored task opcode
/// enters the relation.
pub struct ReceiptHeaderRelationInputs {
    pub receipt_valid: BabyBear,
    pub base_root_valid: BabyBear,
    pub interaction_root_valid: BabyBear,
    pub shift: BabyBear,
    pub accepted: BabyBear,
    pub trace_valid: BabyBear,
}
impl core::marker::Copy for ReceiptHeaderRelationInputs {}

/// Private nonzero witness for the public evaluation shift.
pub struct ReceiptHeaderRelationAuxiliary { pub shift_inverse: BabyBear }
impl core::marker::Copy for ReceiptHeaderRelationAuxiliary {}

pub type ReceiptHeaderRelationWitness = QuadraticRelationWitness<
    BabyBear,
    RECEIPT_HEADER_PRODUCTS,
    RECEIPT_HEADER_ASSERTIONS,
>

pub type ReceiptHeaderRelationResiduals = QuadraticRelationResiduals<
    BabyBear,
    RECEIPT_HEADER_PRODUCTS,
    RECEIPT_HEADER_ASSERTIONS,
>

fn bool_field(_ value: bool) -> BabyBear {
    BabyBear::from_u32(if value { 1 } else { 0 })
}

/// Project the live receipt and the canonical first trace row into the shared
/// relation input. This is the only production adapter for this stage.
pub fn production_receipt_header_relation_inputs(
    _ shift: BabyBear,
    _ receipt: ref ProductionSecuritySparseBabyBearReceipt,
    _ trace: ProductionSecurityVerifierTrace,
) -> ReceiptHeaderRelationInputs {
    let row = trace.row(0)
    ReceiptHeaderRelationInputs {
        receipt_valid: bool_field(receipt.valid),
        base_root_valid: bool_field(receipt.base_root.valid),
        interaction_root_valid: bool_field(receipt.interaction_root.valid),
        shift: shift,
        accepted: bool_field(row.accepted),
        trace_valid: bool_field(trace.shape_valid()),
    }
}

pub fn derive_receipt_header_relation_auxiliary(
    _ inputs: ReceiptHeaderRelationInputs,
) -> ReceiptHeaderRelationAuxiliary {
    ReceiptHeaderRelationAuxiliary { shift_inverse: inputs.shift.inverse_or_zero() }
}

fn constrain_zero<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreter: I,
    _ value: BabyBear,
) -> I {
    interpreter.constrain_zero(value).interpreter
}

fn constrain_equal<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreter: I,
    _ left: BabyBear,
    _ right: BabyBear,
) -> I {
    constrain_zero(interpreter, left - right)
}

fn constrain_one<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreter: I,
    _ value: BabyBear,
) -> I {
    constrain_equal(interpreter, value, BabyBear::one())
}

fn constrain_boolean<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreter: I,
    _ value: BabyBear,
) -> I {
    let product = interpreter.multiply(value, value - BabyBear::one())
    constrain_zero(product.interpreter, product.value)
}

struct ReceiptHeaderRelationPlan<I: QuadraticRelationInterpreter<BabyBear>> { interpreter: I }
impl<I: QuadraticRelationInterpreter<BabyBear>> core::marker::Copy for ReceiptHeaderRelationPlan<
    I,
> {}

/// The sole authored receipt-header relation. Every interpretation must
/// consume exactly eight products and nine assertions.
fn receipt_header_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ inputs: ReceiptHeaderRelationInputs,
    _ auxiliary: ReceiptHeaderRelationAuxiliary,
    _ interpreter: I,
) -> ReceiptHeaderRelationPlan<I> {
    let mut interpreter = interpreter
    interpreter = constrain_boolean(interpreter, inputs.receipt_valid)
    interpreter = constrain_boolean(interpreter, inputs.base_root_valid)
    interpreter = constrain_boolean(interpreter, inputs.interaction_root_valid)
    interpreter = constrain_boolean(interpreter, inputs.accepted)
    interpreter = constrain_boolean(interpreter, inputs.trace_valid)

    let nonzero = interpreter.multiply(inputs.shift, auxiliary.shift_inverse)
    interpreter = constrain_one(nonzero.interpreter, nonzero.value)

    let receipt_and_base = interpreter.multiply(inputs.receipt_valid, inputs.base_root_valid)
    let complete = receipt_and_base
        .interpreter
        .multiply(receipt_and_base.value, inputs.interaction_root_valid)
    interpreter = constrain_equal(complete.interpreter, complete.value, inputs.accepted)
    interpreter = constrain_one(interpreter, inputs.accepted)
    interpreter = constrain_one(interpreter, inputs.trace_valid)
    ReceiptHeaderRelationPlan { interpreter: interpreter }
}

pub fn receipt_header_relation_witness(
    _ inputs: ReceiptHeaderRelationInputs,
) -> ReceiptHeaderRelationWitness {
    let auxiliary = derive_receipt_header_relation_auxiliary(inputs)
    receipt_header_relation_plan(
        inputs,
        auxiliary,
        QuadraticRelationWitnessInterpreter<
            BabyBear,
            RECEIPT_HEADER_PRODUCTS,
            RECEIPT_HEADER_ASSERTIONS,
        >::new(),
    )
        .interpreter
        .finish()
}

pub fn receipt_header_relation_residuals(
    _ inputs: ReceiptHeaderRelationInputs,
    _ auxiliary: ReceiptHeaderRelationAuxiliary,
    _ witness: ReceiptHeaderRelationWitness,
) -> ReceiptHeaderRelationResiduals {
    receipt_header_relation_plan(
        inputs,
        auxiliary,
        QuadraticRelationConstraintInterpreter<
            BabyBear,
            RECEIPT_HEADER_PRODUCTS,
            RECEIPT_HEADER_ASSERTIONS,
        >::new(witness),
    )
        .interpreter
        .finish()
}

pub fn evaluate_receipt_header_relation(_ inputs: ReceiptHeaderRelationInputs) -> bool {
    let auxiliary = derive_receipt_header_relation_auxiliary(inputs)
    receipt_header_relation_plan(
        inputs,
        auxiliary,
        QuadraticRelationValueInterpreter::new(),
    )
        .interpreter
        .finish()
}

/// One ordered binary Merkle dependency. `direction = 0` places the current
/// digest on the left; `direction = 1` places its sibling on the left. The
/// direction is a constrained field value, not a host branch.
pub struct MerkleNodeRelationInputs {
    pub child: Poseidon2Digest,
    pub sibling: Poseidon2Digest,
    pub direction: BabyBear,
    pub expected_parent: Poseidon2Digest,
}
impl core::marker::Copy for MerkleNodeRelationInputs {}

pub struct OrderedMerkleNodeInputs {
    pub child: Poseidon2Digest,
    pub sibling: Poseidon2Digest,
    pub direction: BabyBear,
}
impl core::marker::Copy for OrderedMerkleNodeInputs {}

pub type MerkleNodeRelationWitness = QuadraticRelationWitness<
    BabyBear,
    MERKLE_NODE_PRODUCTS,
    MERKLE_NODE_ASSERTIONS,
>

pub type MerkleNodeRelationResiduals = QuadraticRelationResiduals<
    BabyBear,
    MERKLE_NODE_PRODUCTS,
    MERKLE_NODE_ASSERTIONS,
>

pub struct MerkleNodeRelationPlan<I: QuadraticRelationInterpreter<BabyBear>> {
    pub interpreter: I,
    pub parent: Poseidon2Digest,
}
impl<I: QuadraticRelationInterpreter<BabyBear>> core::marker::Copy for MerkleNodeRelationPlan<I> {}

/// Interpret one ordered compression without asserting its parent. This is
/// the compositional kernel used by path and multipath relations.
pub fn ordered_merkle_node_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ inputs: OrderedMerkleNodeInputs,
    _ interpreter: I,
) -> MerkleNodeRelationPlan<I> {
    let mut interpreter = constrain_boolean(interpreter, inputs.direction)
    let mut left_fields = [BabyBear::zero(); 8]
    let mut right_fields = [BabyBear::zero(); 8]
    let mut lane: usize = 0
    while lane < 8 {
        let child = inputs.child.field(lane.downcast_truncate())
        let sibling = inputs.sibling.field(lane.downcast_truncate())
        let selected = interpreter.multiply(inputs.direction, sibling - child)
        interpreter = selected.interpreter
        left_fields[lane] = child + selected.value
        right_fields[lane] = child + sibling - left_fields[lane]
        lane = lane + 1
    }
    let compressed = compress_plan(
        interpreter,
        Poseidon2Digest::from_fields(left_fields),
        Poseidon2Digest::from_fields(right_fields),
    )
    MerkleNodeRelationPlan { interpreter: compressed.interpreter, parent: compressed.value }
}

/// Interpret the ordered node through one shared arithmetic dependency plan.
/// Eight selection products place the children without branching, then the
/// production Poseidon2 compression plan contributes its complete 564-product
/// permutation.
pub fn merkle_node_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ inputs: MerkleNodeRelationInputs,
    _ interpreter: I,
) -> MerkleNodeRelationPlan<I> {
    let ordered = ordered_merkle_node_plan(
        OrderedMerkleNodeInputs {
            child: inputs.child,
            sibling: inputs.sibling,
            direction: inputs.direction,
        },
        interpreter,
    )
    let mut interpreter = ordered.interpreter
    let mut lane: usize = 0
    while lane < 8 {
        interpreter = constrain_equal(
            interpreter,
            ordered.parent.field(lane.downcast_truncate()),
            inputs.expected_parent.field(lane.downcast_truncate()),
        )
        lane = lane + 1
    }
    MerkleNodeRelationPlan { interpreter: interpreter, parent: ordered.parent }
}

pub fn merkle_node_relation_witness(
    _ inputs: MerkleNodeRelationInputs,
) -> MerkleNodeRelationWitness {
    merkle_node_relation_plan(
        inputs,
        QuadraticRelationWitnessInterpreter<
            BabyBear,
            MERKLE_NODE_PRODUCTS,
            MERKLE_NODE_ASSERTIONS,
        >::new(),
    )
        .interpreter
        .finish()
}

pub fn merkle_node_relation_residuals(
    _ inputs: MerkleNodeRelationInputs,
    _ witness: MerkleNodeRelationWitness,
) -> MerkleNodeRelationResiduals {
    merkle_node_relation_plan(
        inputs,
        QuadraticRelationConstraintInterpreter<
            BabyBear,
            MERKLE_NODE_PRODUCTS,
            MERKLE_NODE_ASSERTIONS,
        >::new(witness),
    )
        .interpreter
        .finish()
}

pub fn evaluate_merkle_node_relation(_ inputs: MerkleNodeRelationInputs) -> bool {
    merkle_node_relation_plan(inputs, QuadraticRelationValueInterpreter::new()).interpreter.finish()
}

/// One conventional bottom-up binary path. Direction bits remain explicit
/// witness values, while a linear reconstruction binds them to the canonical
/// little-endian path index.
pub struct BinaryMerklePathRelationInputs<const DEPTH: usize> {
    pub leaf: Poseidon2Digest,
    pub siblings: [Poseidon2Digest; DEPTH],
    pub directions: [BabyBear; DEPTH],
    pub path_index: BabyBear,
    pub expected_root: Poseidon2Digest,
}
impl<const DEPTH: usize> core::marker::Copy for BinaryMerklePathRelationInputs<DEPTH> {}

pub struct BinaryMerklePathRelationPlan<I: QuadraticRelationInterpreter<BabyBear>> {
    pub interpreter: I,
    pub root: Poseidon2Digest,
}
impl<I: QuadraticRelationInterpreter<BabyBear>> core::marker::Copy for BinaryMerklePathRelationPlan<
    I,
> {}

pub fn binary_merkle_path_relation_plan<
    I: QuadraticRelationInterpreter<BabyBear>,
    const DEPTH: usize,
>(
    _ inputs: BinaryMerklePathRelationInputs<DEPTH>,
    _ interpreter: I,
) -> BinaryMerklePathRelationPlan<I> {
    let mut interpreter = interpreter
    let mut node = inputs.leaf
    let mut reconstructed = BabyBear::zero()
    let mut weight = BabyBear::one()
    let mut level: usize = 0
    while level < DEPTH {
        let planned = ordered_merkle_node_plan(
            OrderedMerkleNodeInputs {
                child: node,
                sibling: inputs.siblings[level],
                direction: inputs.directions[level],
            },
            interpreter,
        )
        interpreter = planned.interpreter
        node = planned.parent
        reconstructed = reconstructed + inputs.directions[level] * weight
        weight = weight + weight
        level = level + 1
    }
    interpreter = constrain_equal(interpreter, reconstructed, inputs.path_index)
    let mut lane: usize = 0
    while lane < 8 {
        interpreter = constrain_equal(
            interpreter,
            node.field(lane.downcast_truncate()),
            inputs.expected_root.field(lane.downcast_truncate()),
        )
        lane = lane + 1
    }
    BinaryMerklePathRelationPlan { interpreter: interpreter, root: node }
}

/// Nominal value semantics required by `merkle_core` while the stateful
/// interpreter below supplies the recursive relation placement.
pub struct RecursiveVerifierPoseidonHasher {}
impl TwoToOneHasher<Poseidon2Digest> for RecursiveVerifierPoseidonHasher {
    fn zero() -> Poseidon2Digest { Poseidon2Digest::zero() }

    fn equal(_ left: Poseidon2Digest, _ right: Poseidon2Digest) -> bool {
        left.equals(right)
    }

    fn hash2(
        _ left: Poseidon2Digest,
        _ right: Poseidon2Digest,
    ) -> Poseidon2Digest {
        compress(left, right)
    }
}

/// Quadratic placement of each typed task emitted by the canonical
/// deduplicated multipath traversal. The traversal owns level, index, pairing,
/// sibling position, and direction policy; this interpreter owns only the
/// ordered arithmetic dependency.
pub struct QuadraticMerkleMultiPathInterpreter<
    I: QuadraticRelationInterpreter<BabyBear>,
> {
    pub relation: I,
}
impl<I: QuadraticRelationInterpreter<BabyBear>> core::marker::Copy
    for QuadraticMerkleMultiPathInterpreter<I> {}

impl<I: QuadraticRelationInterpreter<BabyBear>> MerkleMultiPathInterpreter<
    Poseidon2Digest,
    RecursiveVerifierPoseidonHasher,
> for QuadraticMerkleMultiPathInterpreter<I> {
    fn compress(
        self,
        _ task: MerkleMultiPathTask,
        _ child: Poseidon2Digest,
        _ sibling: Poseidon2Digest,
    ) -> MerkleMultiPathStep<Self, Poseidon2Digest> {
        let planned = ordered_merkle_node_plan(
            OrderedMerkleNodeInputs {
                child: child,
                sibling: sibling,
                direction: BabyBear::from_u32(task.direction),
            },
            self.relation,
        )
        MerkleMultiPathStep {
            interpreter: Self { relation: planned.interpreter },
            value: planned.parent,
        }
    }
}

pub struct MerkleMultiPathRelationInputs<
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> {
    pub opened_leaves: [Poseidon2Digest; MAX_LEAVES],
    pub path: MerkleMultiPath<
        Poseidon2Digest,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
    pub expected_root: Poseidon2Digest,
}
impl<const MAX_LEAVES: usize, const MAX_SIBLINGS: usize>
    core::marker::Copy
    for MerkleMultiPathRelationInputs<MAX_LEAVES, MAX_SIBLINGS> {}

pub struct MerkleMultiPathRelationPlan<
    I: QuadraticRelationInterpreter<BabyBear>,
> {
    pub interpreter: I,
    pub root: Poseidon2Digest,
    pub valid: bool,
    pub hashes: u32,
    pub used_siblings: u32,
}
impl<I: QuadraticRelationInterpreter<BabyBear>> core::marker::Copy
    for MerkleMultiPathRelationPlan<I> {}

/// Reconstruct one canonical deduplicated root through the shared topology
/// interpreter. The product and assertion counts depend on the authenticated
/// leaf set, so callers use the bounded relation stream and replay its exact
/// runtime length through this same function.
pub fn merkle_multi_path_relation_plan<
    I: QuadraticRelationInterpreter<BabyBear>,
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ inputs: MerkleMultiPathRelationInputs<MAX_LEAVES, MAX_SIBLINGS>,
    _ interpreter: I,
) -> MerkleMultiPathRelationPlan<I>
where
    N > 1,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
    MAX_LEAVES > 0,
{
    let interpreted: MerkleMultiPathInterpretation<
        QuadraticMerkleMultiPathInterpreter<I>,
        Poseidon2Digest,
    > = interpret_multi_root<
        Poseidon2Digest,
        RecursiveVerifierPoseidonHasher,
        QuadraticMerkleMultiPathInterpreter<I>,
        N,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(
        inputs.opened_leaves,
        inputs.path,
        QuadraticMerkleMultiPathInterpreter { relation: interpreter },
    )
    let mut interpreter = constrain_one(
        interpreted.interpreter.relation,
        bool_field(interpreted.root.valid),
    )
    interpreter = constrain_digest(
        interpreter,
        interpreted.root.value,
        inputs.expected_root,
    )
    MerkleMultiPathRelationPlan {
        interpreter: interpreter,
        root: interpreted.root.value,
        valid: interpreted.root.valid,
        hashes: interpreted.hashes,
        used_siblings: interpreted.used_siblings,
    }
}

/// Canonical production base-LDE leaf. Shape words are derived from the
/// production receipt type rather than accepted as witnesses.
pub struct ProductionBaseLdeLeafRelationInputs {
    pub index: BabyBear,
    pub values: [BabyBear; SPARSE_BASE_AIR_FIELDS],
    pub expected_commitment: Poseidon2Digest,
}
impl core::marker::Copy for ProductionBaseLdeLeafRelationInputs {}

/// Canonical production interaction-LDE leaf. The already authenticated base
/// root is part of the nominal leaf schema and therefore the hash relation.
pub struct ProductionInteractionLdeLeafRelationInputs {
    pub index: BabyBear,
    pub base_lde_root: Poseidon2Digest,
    pub values: [BabyBear; SPARSE_INTERACTION_AIR_FIELDS],
    pub expected_commitment: Poseidon2Digest,
}
impl core::marker::Copy for ProductionInteractionLdeLeafRelationInputs {}

pub struct ProductionLdeLeafRelationPlan<I: QuadraticRelationInterpreter<BabyBear>> {
    pub interpreter: I,
    pub commitment: Poseidon2Digest,
    pub codec_valid: bool,
}
impl<I: QuadraticRelationInterpreter<BabyBear>> core::marker::Copy
    for ProductionLdeLeafRelationPlan<I> {}

fn constrain_digest<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreter: I,
    _ actual: Poseidon2Digest,
    _ expected: Poseidon2Digest,
) -> I {
    let mut interpreter = interpreter
    let mut lane: u32 = 0
    while lane < 8 {
        interpreter = constrain_equal(
            interpreter,
            actual.field(lane),
            expected.field(lane),
        )
        lane = lane + 1
    }
    interpreter
}

pub fn production_base_lde_leaf_relation_plan<
    I: QuadraticRelationInterpreter<BabyBear>,
>(
    _ inputs: ProductionBaseLdeLeafRelationInputs,
    _ interpreter: I,
) -> ProductionLdeLeafRelationPlan<I> {
    let leaf = SparseBaseLdeLeaf<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    > {
        limb_count: BabyBear::from_u32(PRODUCTION_LIMBS.downcast_truncate()),
        trace_length: BabyBear::from_u32(PRODUCTION_TRACE_LENGTH.downcast_truncate()),
        lde_length: BabyBear::from_u32(PRODUCTION_LDE_LENGTH.downcast_truncate()),
        index: inputs.index,
        values: inputs.values,
    }
    let planned = sparse_base_lde_leaf_commitment_plan(interpreter, leaf)
    let codec_valid = planned.is_valid()
    ProductionLdeLeafRelationPlan {
        interpreter: constrain_digest(
            planned.interpreter,
            planned.digest(),
            inputs.expected_commitment,
        ),
        commitment: planned.digest(),
        codec_valid: codec_valid,
    }
}

pub fn production_interaction_lde_leaf_relation_plan<
    I: QuadraticRelationInterpreter<BabyBear>,
>(
    _ inputs: ProductionInteractionLdeLeafRelationInputs,
    _ interpreter: I,
) -> ProductionLdeLeafRelationPlan<I> {
    let leaf = SparseInteractionLdeLeaf<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    > {
        limb_count: BabyBear::from_u32(PRODUCTION_LIMBS.downcast_truncate()),
        trace_length: BabyBear::from_u32(PRODUCTION_TRACE_LENGTH.downcast_truncate()),
        lde_length: BabyBear::from_u32(PRODUCTION_LDE_LENGTH.downcast_truncate()),
        index: inputs.index,
        base_lde_root: inputs.base_lde_root,
        values: inputs.values,
    }
    let planned = sparse_interaction_lde_leaf_commitment_plan(interpreter, leaf)
    let codec_valid = planned.is_valid()
    ProductionLdeLeafRelationPlan {
        interpreter: constrain_digest(
            planned.interpreter,
            planned.digest(),
            inputs.expected_commitment,
        ),
        commitment: planned.digest(),
        codec_valid: codec_valid,
    }
}
