//! Quadratic relations for the production BabyBear child verifier.
//!
//! This begins with the exact receipt-header task. The stored task result is
//! witness, not authority: one authored plan constrains receipt validity, both
//! typed roots, trace shape, the nonzero evaluation shift, and the accepted
//! result. Later verifier stages extend this same relation vocabulary rather
//! than treating a trace boolean as proof of its computation.

use mandelbrot_proof_fixed_air_receipt_baby_bear::{
    PRODUCTION_LDE_LOG,
    PRODUCTION_LDE_LENGTH,
    PRODUCTION_LIMBS,
    PRODUCTION_SECURITY_AIR_MAX_LEAVES,
    PRODUCTION_SECURITY_AIR_MAX_SIBLINGS,
    PRODUCTION_TRACE_LENGTH,
    ProductionSecuritySparseBabyBearReceipt,
    ProductionSecurityVerifierTrace,
    bind_sparse_air_security_profile_plan,
    production_recursive_security_profile,
    sparse_air_security_profile_permutations,
}
use mandelbrot_proof_fixed_air_baby_bear::{
    SPARSE_BASE_AIR_FIELDS,
    SPARSE_INTERACTION_AIR_FIELDS,
    SparseBaseLdeMultiOpening,
    SparseBaseLdeLeaf,
    SparseBaseLdeDigest,
    SparseInteractionLdeMultiOpening,
    SparseInteractionLdeLeaf,
    SparseInteractionLdeDigest,
    SparseCompositionTranscriptDigest,
    bind_sparse_air_lde_transcript_plan,
    sparse_air_lde_transcript_permutations,
    sparse_base_lde_leaf_commitment_permutations,
    sparse_base_lde_leaf_commitment_plan,
    sparse_interaction_lde_leaf_commitment_permutations,
    sparse_interaction_lde_leaf_commitment_plan,
}
use mandelbrot_proof_recursive_baby_bear::RecursiveCommittedInterval
use core::{BrowserPtr, alloc_browser_object}
use merkle_core::{
    MerkleMultiPath,
    MerkleMultiPathInterpretation,
    MerkleMultiPathInterpreter,
    MerkleMultiPathStep,
    MerkleMultiPathTask,
    TwoToOneHasher,
    interpret_multi_root,
}
use merkle_browser::interpret_multi_root_in_browser
use precision::baby_bear::BabyBear
use precision::polynomial::Radix2Field
use poseidon_baby_bear::{
    POSEIDON2_PERMUTATION_MULTIPLICATIONS,
    Poseidon2Digest,
    compress,
    compress_plan,
}
use quadratic_plan::{
    QuadraticRelationConstraintInterpreter,
    QuadraticRelationInterpreter,
    QuadraticRelationResiduals,
    QuadraticRelationValueInterpreter,
    QuadraticRelationWitness,
    QuadraticRelationWitnessInterpreter,
}

pub const RECEIPT_HEADER_PRODUCTS: usize = 8
pub const RECEIPT_HEADER_ASSERTIONS: usize = 10
pub const MERKLE_NODE_PRODUCTS: usize = POSEIDON2_PERMUTATION_MULTIPLICATIONS + 9
pub const MERKLE_NODE_ASSERTIONS: usize = 9
pub const PRODUCTION_BASE_LEAF_PRODUCTS: usize = sparse_base_lde_leaf_commitment_permutations<
        {
            PRODUCTION_LIMBS
        },
        {
            PRODUCTION_TRACE_LENGTH
        },
        {
            PRODUCTION_LDE_LENGTH
        },
    >()
    * POSEIDON2_PERMUTATION_MULTIPLICATIONS
pub const PRODUCTION_INTERACTION_LEAF_PRODUCTS: usize = sparse_interaction_lde_leaf_commitment_permutations<
        {
            PRODUCTION_LIMBS
        },
        {
            PRODUCTION_TRACE_LENGTH
        },
        {
            PRODUCTION_LDE_LENGTH
        },
    >()
    * POSEIDON2_PERMUTATION_MULTIPLICATIONS
pub const PRODUCTION_LEAF_ASSERTIONS: usize = 8

pub const fn merkle_multi_path_max_hashes(_ maximum_leaves: usize, _ depth: usize) -> usize {
    maximum_leaves * depth
}

pub const fn merkle_multi_path_max_products(_ maximum_leaves: usize, _ depth: usize) -> usize {
    merkle_multi_path_max_hashes(maximum_leaves, depth) * MERKLE_NODE_PRODUCTS
}

pub const fn merkle_multi_path_max_assertions(_ maximum_leaves: usize, _ depth: usize) -> usize {
    merkle_multi_path_max_hashes(maximum_leaves, depth) + 9
}

pub const PRODUCTION_AIR_MULTIPATH_MAX_HASHES: usize = PRODUCTION_SECURITY_AIR_MAX_LEAVES
    * PRODUCTION_LDE_LOG
pub const PRODUCTION_AIR_MULTIPATH_MAX_PRODUCTS: usize = PRODUCTION_AIR_MULTIPATH_MAX_HASHES
    * MERKLE_NODE_PRODUCTS
pub const PRODUCTION_AIR_MULTIPATH_MAX_ASSERTIONS: usize = PRODUCTION_AIR_MULTIPATH_MAX_HASHES + 9
pub const PRODUCTION_BASE_OPENING_MAX_PRODUCTS: usize = PRODUCTION_SECURITY_AIR_MAX_LEAVES
        * PRODUCTION_BASE_LEAF_PRODUCTS
    + PRODUCTION_AIR_MULTIPATH_MAX_PRODUCTS
pub const PRODUCTION_INTERACTION_OPENING_MAX_PRODUCTS: usize = PRODUCTION_SECURITY_AIR_MAX_LEAVES
        * PRODUCTION_INTERACTION_LEAF_PRODUCTS
    + PRODUCTION_AIR_MULTIPATH_MAX_PRODUCTS
pub const PRODUCTION_OPENING_MAX_ASSERTIONS: usize = PRODUCTION_AIR_MULTIPATH_MAX_ASSERTIONS + 1
pub const PRODUCTION_SECURITY_TRANSCRIPT_PERMUTATIONS: usize = sparse_air_lde_transcript_permutations<
        {
            PRODUCTION_LIMBS
        },
    >()
    + sparse_air_security_profile_permutations()
pub const PRODUCTION_SECURITY_TRANSCRIPT_PRODUCTS: usize = PRODUCTION_SECURITY_TRANSCRIPT_PERMUTATIONS
    * POSEIDON2_PERMUTATION_MULTIPLICATIONS
pub const PRODUCTION_SECURITY_TRANSCRIPT_ASSERTIONS: usize = 27

/// Base and interaction commitments intentionally occupy different nominal
/// arenas. Their physical payloads are identical, but crossing the roles
/// would change the leaf schema and therefore the authenticated statement.
struct ProductionBaseLdeCommitmentArena {
    commitments: [Poseidon2Digest; PRODUCTION_SECURITY_AIR_MAX_LEAVES],
}

struct ProductionInteractionLdeCommitmentArena {
    commitments: [Poseidon2Digest; PRODUCTION_SECURITY_AIR_MAX_LEAVES],
}

type ProductionBaseOpening = SparseBaseLdeMultiOpening<
    {
        PRODUCTION_LIMBS
    },
    {
        PRODUCTION_TRACE_LENGTH
    },
    {
        PRODUCTION_LDE_LENGTH
    },
    {
        PRODUCTION_SECURITY_AIR_MAX_LEAVES
    },
    {
        PRODUCTION_SECURITY_AIR_MAX_SIBLINGS
    },
>

type ProductionInteractionOpening = SparseInteractionLdeMultiOpening<
    {
        PRODUCTION_LIMBS
    },
    {
        PRODUCTION_TRACE_LENGTH
    },
    {
        PRODUCTION_LDE_LENGTH
    },
    {
        PRODUCTION_SECURITY_AIR_MAX_LEAVES
    },
    {
        PRODUCTION_SECURITY_AIR_MAX_SIBLINGS
    },
>

type ProductionBaseRoot = SparseBaseLdeDigest<
    {
        PRODUCTION_LIMBS
    },
    {
        PRODUCTION_TRACE_LENGTH
    },
    {
        PRODUCTION_LDE_LENGTH
    },
>

type ProductionInteractionRoot = SparseInteractionLdeDigest<
    {
        PRODUCTION_LIMBS
    },
    {
        PRODUCTION_TRACE_LENGTH
    },
    {
        PRODUCTION_LDE_LENGTH
    },
>

type ProductionAirMultiPath = MerkleMultiPath<
    Poseidon2Digest,
    {
        PRODUCTION_SECURITY_AIR_MAX_LEAVES
    },
    {
        PRODUCTION_SECURITY_AIR_MAX_SIBLINGS
    },
>

/// Field projection of the exact receipt-header verifier task. The trace row
/// is selected by its semantic position, so no caller-authored task opcode
/// enters the relation.
pub struct ReceiptHeaderRelationInputs {
    pub receipt_valid: BabyBear,
    pub base_root_valid: BabyBear,
    pub interaction_root_valid: BabyBear,
    pub shift: BabyBear,
    pub accepted: BabyBear,
    pub trace_valid: BabyBear,
    pub task_valid: BabyBear,
}
impl core::marker::Copy for ReceiptHeaderRelationInputs {}

/// Private nonzero witness for the public evaluation shift.
pub struct ReceiptHeaderRelationAuxiliary { pub shift_inverse: BabyBear }
impl core::marker::Copy for ReceiptHeaderRelationAuxiliary {}

pub type ReceiptHeaderRelationWitness = QuadraticRelationWitness<
    BabyBear,
    RECEIPT_HEADER_PRODUCTS,
    RECEIPT_HEADER_ASSERTIONS,
>

pub type ReceiptHeaderRelationResiduals = QuadraticRelationResiduals<
    BabyBear,
    RECEIPT_HEADER_PRODUCTS,
    RECEIPT_HEADER_ASSERTIONS,
>

fn bool_field(_ value: bool) -> BabyBear {
    BabyBear::from_u32(if value { 1 } else { 0 })
}

/// Project the live receipt and the canonical first trace row into the shared
/// relation input. This is the only production adapter for this stage.
pub fn production_receipt_header_relation_inputs(
    _ shift: BabyBear,
    _ receipt: ref ProductionSecuritySparseBabyBearReceipt,
    _ trace: ProductionSecurityVerifierTrace,
) -> ReceiptHeaderRelationInputs {
    let row = trace.row(0)
    ReceiptHeaderRelationInputs {
        receipt_valid: bool_field(receipt.valid),
        base_root_valid: bool_field(receipt.base_root.valid),
        interaction_root_valid: bool_field(receipt.interaction_root.valid),
        shift: shift,
        accepted: bool_field(row.accepted),
        trace_valid: bool_field(trace.shape_valid()),
        task_valid: bool_field(trace.task_matches(0)),
    }
}

pub fn derive_receipt_header_relation_auxiliary(
    _ inputs: ReceiptHeaderRelationInputs,
) -> ReceiptHeaderRelationAuxiliary {
    ReceiptHeaderRelationAuxiliary { shift_inverse: inputs.shift.inverse_or_zero() }
}

fn constrain_zero<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreter: I,
    _ value: BabyBear,
) -> I {
    interpreter.constrain_zero(value).interpreter
}

fn constrain_equal<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreter: I,
    _ left: BabyBear,
    _ right: BabyBear,
) -> I {
    constrain_zero(interpreter, left - right)
}

fn constrain_one<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreter: I,
    _ value: BabyBear,
) -> I {
    constrain_equal(interpreter, value, BabyBear::one())
}

fn constrain_boolean<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreter: I,
    _ value: BabyBear,
) -> I {
    let product = interpreter.multiply(value, value - BabyBear::one())
    constrain_zero(product.interpreter, product.value)
}

struct ReceiptHeaderRelationPlan<I: QuadraticRelationInterpreter<BabyBear>> { interpreter: I }
impl<I: QuadraticRelationInterpreter<BabyBear>> core::marker::Copy for ReceiptHeaderRelationPlan<
    I,
> {}

/// The sole authored receipt-header relation. Every interpretation must
/// consume exactly eight products and nine assertions.
fn receipt_header_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ inputs: ReceiptHeaderRelationInputs,
    _ auxiliary: ReceiptHeaderRelationAuxiliary,
    _ interpreter: I,
) -> ReceiptHeaderRelationPlan<I> {
    let mut interpreter = interpreter
    interpreter = constrain_boolean(interpreter, inputs.receipt_valid)
    interpreter = constrain_boolean(interpreter, inputs.base_root_valid)
    interpreter = constrain_boolean(interpreter, inputs.interaction_root_valid)
    interpreter = constrain_boolean(interpreter, inputs.accepted)
    interpreter = constrain_boolean(interpreter, inputs.trace_valid)

    let nonzero = interpreter.multiply(inputs.shift, auxiliary.shift_inverse)
    interpreter = constrain_one(nonzero.interpreter, nonzero.value)

    let receipt_and_base = interpreter.multiply(inputs.receipt_valid, inputs.base_root_valid)
    let complete = receipt_and_base
        .interpreter
        .multiply(receipt_and_base.value, inputs.interaction_root_valid)
    interpreter = constrain_equal(complete.interpreter, complete.value, inputs.accepted)
    interpreter = constrain_one(interpreter, inputs.accepted)
    interpreter = constrain_one(interpreter, inputs.trace_valid)
    interpreter = constrain_one(interpreter, inputs.task_valid)
    ReceiptHeaderRelationPlan { interpreter: interpreter }
}

pub fn receipt_header_relation_witness(
    _ inputs: ReceiptHeaderRelationInputs,
) -> ReceiptHeaderRelationWitness {
    let auxiliary = derive_receipt_header_relation_auxiliary(inputs)
    receipt_header_relation_plan(
        inputs,
        auxiliary,
        QuadraticRelationWitnessInterpreter<
            BabyBear,
            RECEIPT_HEADER_PRODUCTS,
            RECEIPT_HEADER_ASSERTIONS,
        >::new(),
    )
        .interpreter
        .finish()
}

pub fn receipt_header_relation_residuals(
    _ inputs: ReceiptHeaderRelationInputs,
    _ auxiliary: ReceiptHeaderRelationAuxiliary,
    _ witness: ReceiptHeaderRelationWitness,
) -> ReceiptHeaderRelationResiduals {
    receipt_header_relation_plan(
        inputs,
        auxiliary,
        QuadraticRelationConstraintInterpreter<
            BabyBear,
            RECEIPT_HEADER_PRODUCTS,
            RECEIPT_HEADER_ASSERTIONS,
        >::new(witness),
    )
        .interpreter
        .finish()
}

pub fn evaluate_receipt_header_relation(_ inputs: ReceiptHeaderRelationInputs) -> bool {
    let auxiliary = derive_receipt_header_relation_auxiliary(inputs)
    receipt_header_relation_plan(
        inputs,
        auxiliary,
        QuadraticRelationValueInterpreter::new(),
    )
        .interpreter
        .finish()
}

/// One ordered binary Merkle dependency. `direction = 0` places the current
/// digest on the left; `direction = 1` places its sibling on the left. The
/// direction is a constrained field value, not a host branch.
pub struct MerkleNodeRelationInputs {
    pub child: Poseidon2Digest,
    pub sibling: Poseidon2Digest,
    pub direction: BabyBear,
    pub expected_parent: Poseidon2Digest,
}
impl core::marker::Copy for MerkleNodeRelationInputs {}

pub struct OrderedMerkleNodeInputs {
    pub child: Poseidon2Digest,
    pub sibling: Poseidon2Digest,
    pub direction: BabyBear,
}
impl core::marker::Copy for OrderedMerkleNodeInputs {}

pub type MerkleNodeRelationWitness = QuadraticRelationWitness<
    BabyBear,
    MERKLE_NODE_PRODUCTS,
    MERKLE_NODE_ASSERTIONS,
>

pub type MerkleNodeRelationResiduals = QuadraticRelationResiduals<
    BabyBear,
    MERKLE_NODE_PRODUCTS,
    MERKLE_NODE_ASSERTIONS,
>

pub struct MerkleNodeRelationPlan<I: QuadraticRelationInterpreter<BabyBear>> {
    pub interpreter: I,
    pub parent: Poseidon2Digest,
}
impl<I: QuadraticRelationInterpreter<BabyBear>> core::marker::Copy for MerkleNodeRelationPlan<I> {}

/// Interpret one ordered compression without asserting its parent. This is
/// the compositional kernel used by path and multipath relations.
pub fn ordered_merkle_node_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ inputs: OrderedMerkleNodeInputs,
    _ interpreter: I,
) -> MerkleNodeRelationPlan<I> {
    let mut interpreter = constrain_boolean(interpreter, inputs.direction)
    let mut left_fields = [BabyBear::zero(); 8]
    let mut right_fields = [BabyBear::zero(); 8]
    let mut lane: usize = 0
    while lane < 8 {
        let child = inputs.child.field(lane.downcast_truncate())
        let sibling = inputs.sibling.field(lane.downcast_truncate())
        let selected = interpreter.multiply(inputs.direction, sibling - child)
        interpreter = selected.interpreter
        left_fields[lane] = child + selected.value
        right_fields[lane] = child + sibling - left_fields[lane]
        lane = lane + 1
    }
    let compressed = compress_plan(
        interpreter,
        Poseidon2Digest::from_fields(left_fields),
        Poseidon2Digest::from_fields(right_fields),
    )
    MerkleNodeRelationPlan { interpreter: compressed.interpreter, parent: compressed.value }
}

/// Interpret the ordered node through one shared arithmetic dependency plan.
/// Eight selection products place the children without branching, then the
/// production Poseidon2 compression plan contributes its complete 564-product
/// permutation.
pub fn merkle_node_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ inputs: MerkleNodeRelationInputs,
    _ interpreter: I,
) -> MerkleNodeRelationPlan<I> {
    let ordered = ordered_merkle_node_plan(
        OrderedMerkleNodeInputs {
            child: inputs.child,
            sibling: inputs.sibling,
            direction: inputs.direction,
        },
        interpreter,
    )
    let mut interpreter = ordered.interpreter
    let mut lane: usize = 0
    while lane < 8 {
        interpreter = constrain_equal(
            interpreter,
            ordered.parent.field(lane.downcast_truncate()),
            inputs.expected_parent.field(lane.downcast_truncate()),
        )
        lane = lane + 1
    }
    MerkleNodeRelationPlan { interpreter: interpreter, parent: ordered.parent }
}

pub fn merkle_node_relation_witness(
    _ inputs: MerkleNodeRelationInputs,
) -> MerkleNodeRelationWitness {
    merkle_node_relation_plan(
        inputs,
        QuadraticRelationWitnessInterpreter<
            BabyBear,
            MERKLE_NODE_PRODUCTS,
            MERKLE_NODE_ASSERTIONS,
        >::new(),
    )
        .interpreter
        .finish()
}

pub fn merkle_node_relation_residuals(
    _ inputs: MerkleNodeRelationInputs,
    _ witness: MerkleNodeRelationWitness,
) -> MerkleNodeRelationResiduals {
    merkle_node_relation_plan(
        inputs,
        QuadraticRelationConstraintInterpreter<
            BabyBear,
            MERKLE_NODE_PRODUCTS,
            MERKLE_NODE_ASSERTIONS,
        >::new(witness),
    )
        .interpreter
        .finish()
}

pub fn evaluate_merkle_node_relation(_ inputs: MerkleNodeRelationInputs) -> bool {
    merkle_node_relation_plan(inputs, QuadraticRelationValueInterpreter::new()).interpreter.finish()
}

/// One conventional bottom-up binary path. Direction bits remain explicit
/// witness values, while a linear reconstruction binds them to the canonical
/// little-endian path index.
pub struct BinaryMerklePathRelationInputs<const DEPTH: usize> {
    pub leaf: Poseidon2Digest,
    pub siblings: [Poseidon2Digest; DEPTH],
    pub directions: [BabyBear; DEPTH],
    pub path_index: BabyBear,
    pub expected_root: Poseidon2Digest,
}
impl<const DEPTH: usize> core::marker::Copy for BinaryMerklePathRelationInputs<DEPTH> {}

pub struct BinaryMerklePathRelationPlan<I: QuadraticRelationInterpreter<BabyBear>> {
    pub interpreter: I,
    pub root: Poseidon2Digest,
}
impl<I: QuadraticRelationInterpreter<BabyBear>> core::marker::Copy for BinaryMerklePathRelationPlan<
    I,
> {}

pub fn binary_merkle_path_relation_plan<
    I: QuadraticRelationInterpreter<BabyBear>,
    const DEPTH: usize,
>(
    _ inputs: BinaryMerklePathRelationInputs<DEPTH>,
    _ interpreter: I,
) -> BinaryMerklePathRelationPlan<I> {
    let mut interpreter = interpreter
    let mut node = inputs.leaf
    let mut reconstructed = BabyBear::zero()
    let mut weight = BabyBear::one()
    let mut level: usize = 0
    while level < DEPTH {
        let planned = ordered_merkle_node_plan(
            OrderedMerkleNodeInputs {
                child: node,
                sibling: inputs.siblings[level],
                direction: inputs.directions[level],
            },
            interpreter,
        )
        interpreter = planned.interpreter
        node = planned.parent
        reconstructed = reconstructed + inputs.directions[level] * weight
        weight = weight + weight
        level = level + 1
    }
    interpreter = constrain_equal(interpreter, reconstructed, inputs.path_index)
    let mut lane: usize = 0
    while lane < 8 {
        interpreter = constrain_equal(
            interpreter,
            node.field(lane.downcast_truncate()),
            inputs.expected_root.field(lane.downcast_truncate()),
        )
        lane = lane + 1
    }
    BinaryMerklePathRelationPlan { interpreter: interpreter, root: node }
}

/// Nominal value semantics required by `merkle_core` while the stateful
/// interpreter below supplies the recursive relation placement.
pub struct RecursiveVerifierPoseidonHasher {}
impl TwoToOneHasher<Poseidon2Digest> for RecursiveVerifierPoseidonHasher {
    fn zero() -> Poseidon2Digest {
        Poseidon2Digest::zero()
    }

    fn equal(_ left: Poseidon2Digest, _ right: Poseidon2Digest) -> bool {
        left.equals(right)
    }

    fn hash2(_ left: Poseidon2Digest, _ right: Poseidon2Digest) -> Poseidon2Digest {
        compress(left, right)
    }
}

/// Quadratic placement of each typed task emitted by the canonical
/// deduplicated multipath traversal. The traversal owns level, index, pairing,
/// sibling position, and direction policy; this interpreter owns only the
/// ordered arithmetic dependency.
pub struct QuadraticMerkleMultiPathInterpreter<I: QuadraticRelationInterpreter<BabyBear>> {
    pub relation: I,
}
impl<
    I: QuadraticRelationInterpreter<BabyBear>,
> core::marker::Copy for QuadraticMerkleMultiPathInterpreter<I> {}

impl<I: QuadraticRelationInterpreter<BabyBear>> MerkleMultiPathInterpreter<
    Poseidon2Digest,
    RecursiveVerifierPoseidonHasher,
> for QuadraticMerkleMultiPathInterpreter<I> {
    fn compress(
        self,
        _ task: MerkleMultiPathTask,
        _ child: Poseidon2Digest,
        _ sibling: Poseidon2Digest,
    ) -> MerkleMultiPathStep<Self, Poseidon2Digest> {
        let planned = ordered_merkle_node_plan(
            OrderedMerkleNodeInputs {
                child: child,
                sibling: sibling,
                direction: BabyBear::from_u32(task.direction),
            },
            self.relation,
        )
        MerkleMultiPathStep {
            interpreter: Self { relation: planned.interpreter },
            value: planned.parent,
        }
    }
}

pub struct MerkleMultiPathRelationInputs<const MAX_LEAVES: usize, const MAX_SIBLINGS: usize> {
    pub opened_leaves: [Poseidon2Digest; MAX_LEAVES],
    pub path: MerkleMultiPath<Poseidon2Digest, MAX_LEAVES, MAX_SIBLINGS>,
    pub expected_root: Poseidon2Digest,
}
impl<
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> core::marker::Copy for MerkleMultiPathRelationInputs<MAX_LEAVES, MAX_SIBLINGS> {}

pub struct MerkleMultiPathRelationPlan<I: QuadraticRelationInterpreter<BabyBear>> {
    pub interpreter: I,
    pub root: Poseidon2Digest,
    pub valid: bool,
    pub hashes: u32,
    pub used_siblings: u32,
}
impl<I: QuadraticRelationInterpreter<BabyBear>> core::marker::Copy for MerkleMultiPathRelationPlan<
    I,
> {}

/// Reconstruct one canonical deduplicated root through the shared topology
/// interpreter. The product and assertion counts depend on the authenticated
/// leaf set, so callers use the bounded relation stream and replay its exact
/// runtime length through this same function.
pub fn merkle_multi_path_relation_plan<
    I: QuadraticRelationInterpreter<BabyBear>,
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ inputs: MerkleMultiPathRelationInputs<MAX_LEAVES, MAX_SIBLINGS>,
    _ interpreter: I,
) -> MerkleMultiPathRelationPlan<I>
where N > 1, N <= 2147483648, { (N & (N - 1)) == 0 }, MAX_LEAVES > 0
{
    let interpreted: MerkleMultiPathInterpretation<
        QuadraticMerkleMultiPathInterpreter<I>,
        Poseidon2Digest,
    > = interpret_multi_root<
        Poseidon2Digest,
        RecursiveVerifierPoseidonHasher,
        QuadraticMerkleMultiPathInterpreter<I>,
        N,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(
        inputs.opened_leaves,
        inputs.path,
        QuadraticMerkleMultiPathInterpreter { relation: interpreter },
    )
    finish_merkle_multi_path_relation_plan(interpreted, inputs.expected_root)
}

fn finish_merkle_multi_path_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreted: MerkleMultiPathInterpretation<
        QuadraticMerkleMultiPathInterpreter<I>,
        Poseidon2Digest,
    >,
    _ expected_root: Poseidon2Digest,
) -> MerkleMultiPathRelationPlan<I> {
    let mut interpreter = constrain_one(
        interpreted.interpreter.relation,
        bool_field(interpreted.root.valid),
    )
    interpreter = constrain_digest(interpreter, interpreted.root.value, expected_root)
    MerkleMultiPathRelationPlan {
        interpreter: interpreter,
        root: interpreted.root.value,
        valid: interpreted.root.valid,
        hashes: interpreted.hashes,
        used_siblings: interpreted.used_siblings,
    }
}

/// Place the shared canonical multipath traversal in Fe-owned browser memory.
/// The opened-leaf and path carriers remain borrowed, so production policy
/// sizes do not cross this boundary as flattened by-value aggregates.
pub fn merkle_multi_path_relation_plan_in_browser<
    I: QuadraticRelationInterpreter<BabyBear>,
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ opened_leaves: ref [Poseidon2Digest; MAX_LEAVES],
    _ path: ref MerkleMultiPath<Poseidon2Digest, MAX_LEAVES, MAX_SIBLINGS>,
    _ expected_root: Poseidon2Digest,
    _ interpreter: I,
) -> MerkleMultiPathRelationPlan<I>
where N > 1, N <= 2147483648, { (N & (N - 1)) == 0 }, MAX_LEAVES > 0
{
    let interpreted: MerkleMultiPathInterpretation<
        QuadraticMerkleMultiPathInterpreter<I>,
        Poseidon2Digest,
    > = interpret_multi_root_in_browser<
        Poseidon2Digest,
        RecursiveVerifierPoseidonHasher,
        QuadraticMerkleMultiPathInterpreter<I>,
        N,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(
        opened_leaves,
        path,
        QuadraticMerkleMultiPathInterpreter { relation: interpreter },
    )
    finish_merkle_multi_path_relation_plan(interpreted, expected_root)
}

/// Canonical production base-LDE leaf. Shape words are derived from the
/// production receipt type rather than accepted as witnesses.
pub struct ProductionBaseLdeLeafRelationInputs {
    pub index: BabyBear,
    pub values: [BabyBear; SPARSE_BASE_AIR_FIELDS],
    pub expected_commitment: Poseidon2Digest,
}
impl core::marker::Copy for ProductionBaseLdeLeafRelationInputs {}

/// Canonical production interaction-LDE leaf. The already authenticated base
/// root is part of the nominal leaf schema and therefore the hash relation.
pub struct ProductionInteractionLdeLeafRelationInputs {
    pub index: BabyBear,
    pub base_lde_root: Poseidon2Digest,
    pub values: [BabyBear; SPARSE_INTERACTION_AIR_FIELDS],
    pub expected_commitment: Poseidon2Digest,
}
impl core::marker::Copy for ProductionInteractionLdeLeafRelationInputs {}

pub struct ProductionLdeLeafRelationPlan<I: QuadraticRelationInterpreter<BabyBear>> {
    pub interpreter: I,
    pub commitment: Poseidon2Digest,
    pub codec_valid: bool,
}
impl<
    I: QuadraticRelationInterpreter<BabyBear>,
> core::marker::Copy for ProductionLdeLeafRelationPlan<I> {}

fn constrain_digest<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreter: I,
    _ actual: Poseidon2Digest,
    _ expected: Poseidon2Digest,
) -> I {
    let mut interpreter = interpreter
    let mut lane: u32 = 0
    while lane < 8 {
        interpreter = constrain_equal(interpreter, actual.field(lane), expected.field(lane))
        lane = lane + 1
    }
    interpreter
}

/// Public inputs consumed by the exact `SecurityTranscript` verifier task.
/// The committed interval is the recursive statement carrier. Its raw orbit
/// witness remains outside this stage, while the two roots are the outputs of
/// the preceding authenticated opening relations.
pub struct ProductionSecurityTranscriptRelationInputs {
    pub statement: RecursiveCommittedInterval<{ PRODUCTION_LIMBS }>,
    pub base_root: SparseBaseLdeDigest<
        {
            PRODUCTION_LIMBS
        },
        {
            PRODUCTION_TRACE_LENGTH
        },
        {
            PRODUCTION_LDE_LENGTH
        },
    >,
    pub interaction_root: SparseInteractionLdeDigest<
        {
            PRODUCTION_LIMBS
        },
        {
            PRODUCTION_TRACE_LENGTH
        },
        {
            PRODUCTION_LDE_LENGTH
        },
    >,
    pub base_opening_accepted: BabyBear,
    pub interaction_opening_accepted: BabyBear,
    pub accepted: BabyBear,
    pub trace_valid: BabyBear,
    pub base_task_valid: BabyBear,
    pub interaction_task_valid: BabyBear,
    pub transcript_task_valid: BabyBear,
}
impl core::marker::Copy for ProductionSecurityTranscriptRelationInputs {}

pub struct ProductionSecurityTranscriptRelationPlan<I: QuadraticRelationInterpreter<BabyBear>> {
    pub interpreter: I,
    pub composition: SparseCompositionTranscriptDigest<
        {
            PRODUCTION_LIMBS
        },
        {
            PRODUCTION_TRACE_LENGTH
        },
        {
            PRODUCTION_LDE_LENGTH
        },
    >,
}
impl<
    I: QuadraticRelationInterpreter<BabyBear>,
> core::marker::Copy for ProductionSecurityTranscriptRelationPlan<I> {}

/// Project the exact scalar verifier rows into the transcript relation. Task
/// order remains compiler-derived: rows one, two, and three are respectively
/// the base opening, interaction opening, and security transcript stages.
pub fn production_security_transcript_relation_inputs(
    _ statement: RecursiveCommittedInterval<{ PRODUCTION_LIMBS }>,
    _ receipt: ref ProductionSecuritySparseBabyBearReceipt,
    _ trace: ProductionSecurityVerifierTrace,
) -> ProductionSecurityTranscriptRelationInputs {
    ProductionSecurityTranscriptRelationInputs {
        statement: statement,
        base_root: receipt.base_root,
        interaction_root: receipt.interaction_root,
        base_opening_accepted: bool_field(trace.row(1).accepted),
        interaction_opening_accepted: bool_field(trace.row(2).accepted),
        accepted: bool_field(trace.row(3).accepted),
        trace_valid: bool_field(trace.shape_valid()),
        base_task_valid: bool_field(trace.task_matches(1)),
        interaction_task_valid: bool_field(trace.task_matches(2)),
        transcript_task_valid: bool_field(trace.task_matches(3)),
    }
}

/// The sole authored production security-transcript relation. The interval
/// commitment, ordered roots, packed security profile, and final transcript
/// extension all consume the same Poseidon2 multiplication plan as the scalar
/// verifier. Later FRI and AIR relations consume the returned typed digest.
pub fn production_security_transcript_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ inputs: ProductionSecurityTranscriptRelationInputs,
    _ interpreter: I,
) -> ProductionSecurityTranscriptRelationPlan<I> {
    let mut interpreter = interpreter
    interpreter = constrain_one(interpreter, bool_field(inputs.statement.valid))
    interpreter = constrain_equal(
        interpreter,
        BabyBear::from_u32(inputs.statement.leaves),
        BabyBear::one(),
    )
    interpreter = constrain_one(interpreter, bool_field(inputs.statement.statement.valid))
    interpreter = constrain_one(interpreter, bool_field(inputs.statement.start.valid))
    interpreter = constrain_one(interpreter, bool_field(inputs.statement.end.valid))
    interpreter = constrain_equal(
        interpreter,
        BabyBear::from_u32(inputs.statement.end_iteration),
        BabyBear::from_u32(inputs.statement.start_iteration) + BabyBear::one(),
    )
    interpreter = constrain_one(interpreter, bool_field(inputs.base_root.valid))
    interpreter = constrain_one(interpreter, bool_field(inputs.interaction_root.valid))
    interpreter = constrain_one(
        interpreter,
        bool_field(inputs.interaction_root.base.valid),
    )
    interpreter = constrain_digest(
        interpreter,
        inputs.interaction_root.base.value,
        inputs.base_root.value,
    )
    interpreter = constrain_one(interpreter, inputs.base_opening_accepted)
    interpreter = constrain_one(interpreter, inputs.interaction_opening_accepted)
    interpreter = constrain_one(interpreter, inputs.accepted)
    interpreter = constrain_one(interpreter, inputs.trace_valid)
    interpreter = constrain_one(interpreter, inputs.base_task_valid)
    interpreter = constrain_one(interpreter, inputs.interaction_task_valid)
    interpreter = constrain_one(interpreter, inputs.transcript_task_valid)

    let air = bind_sparse_air_lde_transcript_plan<
        I,
        {
            PRODUCTION_LIMBS
        },
        {
            PRODUCTION_TRACE_LENGTH
        },
        {
            PRODUCTION_LDE_LENGTH
        },
    >(
        inputs.statement,
        inputs.base_root,
        inputs.interaction_root,
        interpreter,
    )
    interpreter = constrain_one(air.interpreter, bool_field(air.value.valid))
    interpreter = constrain_one(interpreter, bool_field(air.value.transcript.valid))
    let composition = bind_sparse_air_security_profile_plan(
        air.value,
        production_recursive_security_profile(),
        interpreter,
    )
    interpreter = constrain_one(
        composition.interpreter,
        bool_field(composition.value.is_valid()),
    )
    ProductionSecurityTranscriptRelationPlan {
        interpreter: interpreter,
        composition: composition.value,
    }
}

/// Commit one production base opening through the exact plan shared by the
/// scalar leaf verifier and the policy-sized arena placement.
pub fn production_base_lde_leaf_commitment_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ index: BabyBear,
    _ values: [BabyBear; SPARSE_BASE_AIR_FIELDS],
    _ interpreter: I,
) -> ProductionLdeLeafRelationPlan<I> {
    let leaf = SparseBaseLdeLeaf<
        {
            PRODUCTION_LIMBS
        },
        {
            PRODUCTION_TRACE_LENGTH
        },
        {
            PRODUCTION_LDE_LENGTH
        },
    > {
        limb_count: BabyBear::from_u32(PRODUCTION_LIMBS.downcast_truncate()),
        trace_length: BabyBear::from_u32(PRODUCTION_TRACE_LENGTH.downcast_truncate()),
        lde_length: BabyBear::from_u32(PRODUCTION_LDE_LENGTH.downcast_truncate()),
        index: index,
        values: values,
    }
    let planned = sparse_base_lde_leaf_commitment_plan(interpreter, leaf)
    let codec_valid = planned.is_valid()
    ProductionLdeLeafRelationPlan {
        interpreter: planned.interpreter,
        commitment: planned.digest(),
        codec_valid: codec_valid,
    }
}

pub fn production_base_lde_leaf_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ inputs: ProductionBaseLdeLeafRelationInputs,
    _ interpreter: I,
) -> ProductionLdeLeafRelationPlan<I> {
    let planned = production_base_lde_leaf_commitment_relation_plan(
        inputs.index,
        inputs.values,
        interpreter,
    )
    ProductionLdeLeafRelationPlan {
        interpreter: constrain_digest(
            planned.interpreter,
            planned.commitment,
            inputs.expected_commitment,
        ),
        commitment: planned.commitment,
        codec_valid: planned.codec_valid,
    }
}

/// Commit one production interaction opening through the exact plan shared by
/// the scalar leaf verifier and the policy-sized arena placement.
pub fn production_interaction_lde_leaf_commitment_relation_plan<
    I: QuadraticRelationInterpreter<BabyBear>,
>(
    _ index: BabyBear,
    _ base_lde_root: Poseidon2Digest,
    _ values: [BabyBear; SPARSE_INTERACTION_AIR_FIELDS],
    _ interpreter: I,
) -> ProductionLdeLeafRelationPlan<I> {
    let leaf = SparseInteractionLdeLeaf<
        {
            PRODUCTION_LIMBS
        },
        {
            PRODUCTION_TRACE_LENGTH
        },
        {
            PRODUCTION_LDE_LENGTH
        },
    > {
        limb_count: BabyBear::from_u32(PRODUCTION_LIMBS.downcast_truncate()),
        trace_length: BabyBear::from_u32(PRODUCTION_TRACE_LENGTH.downcast_truncate()),
        lde_length: BabyBear::from_u32(PRODUCTION_LDE_LENGTH.downcast_truncate()),
        index: index,
        base_lde_root: base_lde_root,
        values: values,
    }
    let planned = sparse_interaction_lde_leaf_commitment_plan(interpreter, leaf)
    let codec_valid = planned.is_valid()
    ProductionLdeLeafRelationPlan {
        interpreter: planned.interpreter,
        commitment: planned.digest(),
        codec_valid: codec_valid,
    }
}

pub fn production_interaction_lde_leaf_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ inputs: ProductionInteractionLdeLeafRelationInputs,
    _ interpreter: I,
) -> ProductionLdeLeafRelationPlan<I> {
    let planned = production_interaction_lde_leaf_commitment_relation_plan(
        inputs.index,
        inputs.base_lde_root,
        inputs.values,
        interpreter,
    )
    ProductionLdeLeafRelationPlan {
        interpreter: constrain_digest(
            planned.interpreter,
            planned.commitment,
            inputs.expected_commitment,
        ),
        commitment: planned.commitment,
        codec_valid: planned.codec_valid,
    }
}

fn unavailable_production_opening_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ interpreter: I,
) -> MerkleMultiPathRelationPlan<I> {
    MerkleMultiPathRelationPlan {
        interpreter: constrain_one(interpreter, BabyBear::zero()),
        root: Poseidon2Digest::zero(),
        valid: false,
        hashes: 0,
        used_siblings: 0,
    }
}

fn initialize_production_base_commitment_arena()
uses (arena: mut ProductionBaseLdeCommitmentArena)
{
    let mut index: usize = 0
    while index < PRODUCTION_SECURITY_AIR_MAX_LEAVES {
        arena.commitments[index] = Poseidon2Digest::zero()
        index = index + 1
    }
}

fn write_production_base_commitment(_ index: usize, _ value: Poseidon2Digest)
uses (arena: mut ProductionBaseLdeCommitmentArena)
{
    if index < PRODUCTION_SECURITY_AIR_MAX_LEAVES {
        arena.commitments[index] = value
    }
}

fn initialize_production_interaction_commitment_arena()
uses (arena: mut ProductionInteractionLdeCommitmentArena)
{
    let mut index: usize = 0
    while index < PRODUCTION_SECURITY_AIR_MAX_LEAVES {
        arena.commitments[index] = Poseidon2Digest::zero()
        index = index + 1
    }
}

fn write_production_interaction_commitment(_ index: usize, _ value: Poseidon2Digest)
uses (arena: mut ProductionInteractionLdeCommitmentArena)
{
    if index < PRODUCTION_SECURITY_AIR_MAX_LEAVES {
        arena.commitments[index] = value
    }
}

fn production_base_commitment_arena_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ path: ref ProductionAirMultiPath,
    _ expected_root: Poseidon2Digest,
    _ interpreter: I,
) -> MerkleMultiPathRelationPlan<I>
uses (arena: mut ProductionBaseLdeCommitmentArena)
{
    merkle_multi_path_relation_plan_in_browser<
        I,
        {
            PRODUCTION_LDE_LENGTH
        },
        {
            PRODUCTION_SECURITY_AIR_MAX_LEAVES
        },
        {
            PRODUCTION_SECURITY_AIR_MAX_SIBLINGS
        },
    >(ref arena.commitments, path, expected_root, interpreter)
}

fn production_interaction_commitment_arena_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ path: ref ProductionAirMultiPath,
    _ expected_root: Poseidon2Digest,
    _ interpreter: I,
) -> MerkleMultiPathRelationPlan<I>
uses (arena: mut ProductionInteractionLdeCommitmentArena)
{
    merkle_multi_path_relation_plan_in_browser<
        I,
        {
            PRODUCTION_LDE_LENGTH
        },
        {
            PRODUCTION_SECURITY_AIR_MAX_LEAVES
        },
        {
            PRODUCTION_SECURITY_AIR_MAX_SIBLINGS
        },
    >(ref arena.commitments, path, expected_root, interpreter)
}

fn production_base_opening_tail_is_zero(
    _ opening: ref ProductionBaseOpening,
    _ start: usize,
) -> bool {
    let mut leaf = start
    while leaf < PRODUCTION_SECURITY_AIR_MAX_LEAVES {
        let mut field: usize = 0
        while field < SPARSE_BASE_AIR_FIELDS {
            if !opening.values[leaf][field].is_zero() {
                return false
            }
            field = field + 1
        }
        leaf = leaf + 1
    }
    true
}

fn production_interaction_opening_tail_is_zero(
    _ opening: ref ProductionInteractionOpening,
    _ start: usize,
) -> bool {
    let mut leaf = start
    while leaf < PRODUCTION_SECURITY_AIR_MAX_LEAVES {
        let mut field: usize = 0
        while field < SPARSE_INTERACTION_AIR_FIELDS {
            if !opening.values[leaf][field].is_zero() {
                return false
            }
            field = field + 1
        }
        leaf = leaf + 1
    }
    true
}

/// Authenticate the complete production base opening without materializing
/// its 456 commitments as a compiler-owned aggregate. One runtime loop derives
/// each leaf through the canonical commitment plan, stores it in the base-only
/// arena, and hands a borrow to the shared multipath traversal.
pub fn production_base_lde_multi_opening_relation_plan<I: QuadraticRelationInterpreter<BabyBear>>(
    _ opening: ref ProductionBaseOpening,
    _ root: ProductionBaseRoot,
    _ interpreter: I,
) -> MerkleMultiPathRelationPlan<I> {
    let commitments: BrowserPtr<ProductionBaseLdeCommitmentArena> = alloc_browser_object<
        ProductionBaseLdeCommitmentArena,
    >()
    if commitments.address() == 0 {
        return unavailable_production_opening_relation_plan(interpreter)
    }
    let count: usize = opening.path.leaf_count as usize
    let bounded = count > 0 && count <= PRODUCTION_SECURITY_AIR_MAX_LEAVES
    let mut shape_valid = opening.valid && root.valid && bounded
    if bounded {
        shape_valid = shape_valid && production_base_opening_tail_is_zero(opening, count)
    }
    let mut interpreter = interpreter
    with (commitments) {
        initialize_production_base_commitment_arena()
        let mut leaf: usize = 0
        while leaf < count && leaf < PRODUCTION_SECURITY_AIR_MAX_LEAVES {
            let planned = production_base_lde_leaf_commitment_relation_plan(
                BabyBear::from_u32(opening.path.leaf_indices[leaf]),
                opening.values[leaf],
                interpreter,
            )
            interpreter = planned.interpreter
            shape_valid = shape_valid && planned.codec_valid
            write_production_base_commitment(leaf, planned.commitment)
            leaf = leaf + 1
        }
        interpreter = constrain_one(interpreter, bool_field(shape_valid))
        production_base_commitment_arena_relation_plan(ref opening.path, root.value, interpreter)
    }
}

/// Interaction commitments use a distinct arena and absorb the exact base
/// root into every canonical leaf. This makes an accidental base/interaction
/// arena swap ill typed before either relation reaches the Merkle topology.
pub fn production_interaction_lde_multi_opening_relation_plan<
    I: QuadraticRelationInterpreter<BabyBear>,
>(
    _ opening: ref ProductionInteractionOpening,
    _ root: ProductionInteractionRoot,
    _ interpreter: I,
) -> MerkleMultiPathRelationPlan<I> {
    let commitments: BrowserPtr<ProductionInteractionLdeCommitmentArena> = alloc_browser_object<
        ProductionInteractionLdeCommitmentArena,
    >()
    if commitments.address() == 0 {
        return unavailable_production_opening_relation_plan(interpreter)
    }
    let count: usize = opening.path.leaf_count as usize
    let bounded = count > 0 && count <= PRODUCTION_SECURITY_AIR_MAX_LEAVES
    let mut shape_valid = opening.valid && root.valid && root.base.valid && bounded
    if bounded {
        shape_valid = shape_valid && production_interaction_opening_tail_is_zero(opening, count)
    }
    let mut interpreter = interpreter
    with (commitments) {
        initialize_production_interaction_commitment_arena()
        let mut leaf: usize = 0
        while leaf < count && leaf < PRODUCTION_SECURITY_AIR_MAX_LEAVES {
            let planned = production_interaction_lde_leaf_commitment_relation_plan(
                BabyBear::from_u32(opening.path.leaf_indices[leaf]),
                root.base.value,
                opening.values[leaf],
                interpreter,
            )
            interpreter = planned.interpreter
            shape_valid = shape_valid && planned.codec_valid
            write_production_interaction_commitment(leaf, planned.commitment)
            leaf = leaf + 1
        }
        interpreter = constrain_one(interpreter, bool_field(shape_valid))
        production_interaction_commitment_arena_relation_plan(
            ref opening.path,
            root.value,
            interpreter,
        )
    }
}
