    pub limb_count: BabyBear,
    pub task_count: BabyBear,
    pub trace_length: BabyBear,
    pub index: BabyBear,
    pub active: BabyBear,
    pub control: SparseTraceControl,
    pub row: SparseTraceRow,
}
impl<const L: usize> core::marker::Copy for SparseTraceLeaf<L> {}
derive CanonicalWords for SparseTraceLeaf<L> using CanonicalWordsProvider

/// Limb-branded root for one complete power-of-two sparse base trace.
pub struct SparseTraceDigest<const L: usize> {
    pub valid: bool,
    pub value: Poseidon2Digest,
}
impl<const L: usize> core::marker::Copy for SparseTraceDigest<L> {}
derive CanonicalWords for SparseTraceDigest<L> using CanonicalWordsProvider

/// Fiat-Shamir challenges for all committed sparse copy interactions. Every
/// bus and role has an independent domain, and every value lives in the
/// quartic BabyBear challenge field.
pub struct SparseInteractionChallenges {
    pub valid: bool,
    pub product: SparseCopyChallenges<BabyBearExt4>,
    pub round: SparseCopyChallenges<BabyBearExt4>,
    pub linear: SparseCopyChallenges<BabyBearExt4>,
    pub boundary: SparseCopyChallenges<BabyBearExt4>,
}
impl core::marker::Copy for SparseInteractionChallenges {}

/// All four copy buses evaluated over the quartic challenge field. These are
/// prover witness columns, not precomputed constants: the same typed Fe port
/// descriptions used by the AIR generate every inverse and accumulator.
pub struct SparseInteractionTraceRow {
    pub product_accumulator: BabyBearExt4,
    pub product_inverses: [BabyBearExt4; 2],
    pub round_accumulator: BabyBearExt4,
    pub round_inverses: [BabyBearExt4; 5],
    pub linear_accumulator: BabyBearExt4,
    pub linear_inverses: [BabyBearExt4; 8],
    pub boundary_accumulator: BabyBearExt4,
    pub boundary_inverses: [BabyBearExt4; 2],
}
impl core::marker::Copy for SparseInteractionTraceRow {}
derive CanonicalWords for SparseInteractionTraceRow using CanonicalWordsProvider

/// One nominal interaction-trace leaf. The base root is absorbed in every
/// leaf, making the transcript dependency explicit and preventing an
/// interaction path from being replayed against a different base trace.
pub struct SparseInteractionTraceLeaf<const L: usize> {
    pub limb_count: BabyBear,
    pub task_count: BabyBear,
    pub trace_length: BabyBear,
    pub index: BabyBear,
    pub active: BabyBear,
    pub base_root: Poseidon2Digest,
    pub row: SparseInteractionTraceRow,
}
impl<const L: usize> core::marker::Copy for SparseInteractionTraceLeaf<L> {}
derive CanonicalWords for SparseInteractionTraceLeaf<L> using CanonicalWordsProvider

/// Limb-branded interaction commitment paired with the exact base commitment
/// from which its quartic challenges were derived.
pub struct SparseInteractionTraceDigest<const L: usize> {
    pub valid: bool,
    pub base: SparseTraceDigest<L>,
    pub value: Poseidon2Digest,
}
impl<const L: usize> core::marker::Copy for SparseInteractionTraceDigest<L> {}
derive CanonicalWords for SparseInteractionTraceDigest<L> using CanonicalWordsProvider

pub fn sparse_interaction_challenges<const L: usize>(
    _ root: SparseTraceDigest<L>,
) -> SparseInteractionChallenges {
    if !root.valid {
        let zero = BabyBearExt4::zero()
        let challenges = SparseCopyChallenges { beta: zero, gamma: zero }
        return SparseInteractionChallenges {
            valid: false,
            product: challenges,
            round: challenges,
            linear: challenges,
            boundary: challenges,
        }
    }
    SparseInteractionChallenges {
        valid: true,
        product: SparseCopyChallenges {
            beta: squeeze_ext4<MandelbrotSparseProductBetaBabyBearV1>(root.value),
            gamma: squeeze_ext4<MandelbrotSparseProductGammaBabyBearV1>(root.value),
        },
        round: SparseCopyChallenges {
            beta: squeeze_ext4<MandelbrotSparseRoundBetaBabyBearV1>(root.value),
            gamma: squeeze_ext4<MandelbrotSparseRoundGammaBabyBearV1>(root.value),
        },
        linear: SparseCopyChallenges {
            beta: squeeze_ext4<MandelbrotSparseLinearBetaBabyBearV1>(root.value),
            gamma: squeeze_ext4<MandelbrotSparseLinearGammaBabyBearV1>(root.value),
        },
        boundary: SparseCopyChallenges {
            beta: squeeze_ext4<MandelbrotSparseBoundaryBetaBabyBearV1>(root.value),
            gamma: squeeze_ext4<MandelbrotSparseBoundaryGammaBabyBearV1>(root.value),
        },
    }
}

pub fn sparse_interaction_trace_leaf_commitment<const L: usize>(
    _ leaf: SparseInteractionTraceLeaf<L>,
) -> Poseidon2Digest {
    commit_canonical<
        MandelbrotSparseInteractionLeafBabyBearV1,
        SparseInteractionTraceLeaf<L>,
    >(ref leaf).digest()
}

fn invalid_sparse_interaction_trace_digest<const L: usize>(
    _ base: SparseTraceDigest<L>,
) -> SparseInteractionTraceDigest<L> {
    SparseInteractionTraceDigest {
        valid: false,
        base: base,
        value: Poseidon2Digest::zero(),
    }
}

/// Interpret one row of the interaction dependency plan into caller-owned
/// state. Keeping this boundary row-local lets scalar Wasm reclaim all
/// temporary quartic values after the step, while packed and GPU placements
/// can interpret the same control, port, and commitment expressions.
fn write_sparse_interaction_trace_step<const L: usize>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
    _ challenges: SparseInteractionChallenges,
    _ base_root: Poseidon2Digest,
    _ tasks: u32,
    _ trace_length: u32,
    _ position: u32,
    _ product_accumulator: mut BabyBearExt4,
    _ round_accumulator: mut BabyBearExt4,
    _ linear_accumulator: mut BabyBearExt4,
    _ boundary_accumulator: mut BabyBearExt4,
    _ product: mut SparseCopyInteractionRow<BabyBearExt4, 2>,
    _ round: mut SparseCopyInteractionRow<BabyBearExt4, 5>,
    _ linear: mut SparseCopyInteractionRow<BabyBearExt4, 8>,
    _ boundary: mut SparseCopyInteractionRow<BabyBearExt4, 2>,
    _ commitment: mut Poseidon2Digest,
) -> bool
where L > 1,
{
    let control = sparse_control_row_at<BabyBearExt4, L>(position)
    let next_control = sparse_control_row_at<BabyBearExt4, L>(position + 1)
    let row = sparse_transition_row_from_witness<BabyBearExt4, L>(
        position,
        point,
        current,
        next,
        witness,
    )

    write_sparse_product_interaction_row<BabyBearExt4, L>(
        challenges.product,
        control,
        row,
        product_accumulator,
        mut product,
    )
    write_sparse_round_interaction_row<BabyBearExt4, L>(
        challenges.round,
        control,
        next_control,
        row,
        round_accumulator,
        mut round,
    )
    write_sparse_linear_interaction_row<BabyBearExt4, L>(
        challenges.linear,
        control,
        next_control,
        row,
        linear_accumulator,
        mut linear,
    )
    write_sparse_boundary_interaction_row<BabyBearExt4, L>(
        challenges.boundary,
        control,
        row,
        boundary_accumulator,
        mut boundary,
    )

    let local_challenge = BabyBearExt4::one()
    let product_evaluation = evaluate_sparse_product_interaction_row<
        BabyBearExt4,
        L,
    >(local_challenge, challenges.product, control, row, product)
    let round_evaluation = evaluate_sparse_round_interaction_row<
        BabyBearExt4,
        L,
    >(
        local_challenge,
        challenges.round,
        control,
        next_control,
        row,
        round,
    )
    let linear_evaluation = evaluate_sparse_linear_interaction_row<
        BabyBearExt4,
        L,
    >(
        local_challenge,
        challenges.linear,
        control,
        next_control,
        row,
        linear,
    )
    let boundary_evaluation = evaluate_sparse_boundary_interaction_row<
        BabyBearExt4,
        L,
    >(local_challenge, challenges.boundary, control, row, boundary)
    if !product_evaluation.valid || !product_evaluation.folded.is_zero()
        || !round_evaluation.valid || !round_evaluation.folded.is_zero()
        || !linear_evaluation.valid || !linear_evaluation.folded.is_zero()
        || !boundary_evaluation.valid || !boundary_evaluation.folded.is_zero() {
        return false
    }

    let interaction = SparseInteractionTraceRow {
        product_accumulator: product.accumulator,
        product_inverses: product.inverses,
        round_accumulator: round.accumulator,
        round_inverses: round.inverses,
        linear_accumulator: linear.accumulator,
        linear_inverses: linear.inverses,
        boundary_accumulator: boundary.accumulator,
        boundary_inverses: boundary.inverses,
    }
    let leaf = SparseInteractionTraceLeaf<L> {
        limb_count: BabyBear::from_u32(L.downcast_truncate()),
        task_count: BabyBear::from_u32(tasks),
        trace_length: BabyBear::from_u32(trace_length),
        index: BabyBear::from_u32(position),
        active: BabyBear::from_u32(if position < tasks { 1 } else { 0 }),
        base_root: base_root,
        row: interaction,
    }
    commitment = sparse_interaction_trace_leaf_commitment(leaf)
    product_accumulator = product_accumulator + product_evaluation.delta
    round_accumulator = round_accumulator + round_evaluation.delta
    linear_accumulator = linear_accumulator + linear_evaluation.delta
    boundary_accumulator = boundary_accumulator + boundary_evaluation.delta
    true
}

/// Generate and commit the quartic interaction trace for one already
/// committed sparse base trace. The base root alone supplies all copy-bus
/// challenges. Each row is produced by the same Fe port expressions consumed
/// by the AIR, checked locally, and accumulated before the next row is built.
pub fn sparse_interaction_trace_root_power_of_two<
    const L: usize,
    const N: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
    _ base: SparseTraceDigest<L>,
) -> SparseInteractionTraceDigest<L>
where
    L > 1,
    N > 1,
    N <= MAX_SPARSE_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
{
    let trace_length: u32 = N.downcast_truncate()
    let challenges = sparse_interaction_challenges(base)
    if trace_length != sparse_transition_trace_length<L>()
        || !base.valid
        || !challenges.valid {
        return invalid_sparse_interaction_trace_digest(base)
    }

    let mut frontier = empty_frontier<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_TRACE_FRONTIER_LEVELS,
    >()
    let mut product_accumulator = BabyBearExt4::zero()
    let mut round_accumulator = BabyBearExt4::zero()
    let mut linear_accumulator = BabyBearExt4::zero()
    let mut boundary_accumulator = BabyBearExt4::zero()
    let tasks = sparse_transition_task_count<L>()
    let zero = BabyBearExt4::zero()
    let mut product = SparseCopyInteractionRow {
        accumulator: zero,
        inverses: [zero; 2],
    }
    let mut round = SparseCopyInteractionRow {
        accumulator: zero,
        inverses: [zero; 5],
    }
    let mut linear = SparseCopyInteractionRow {
        accumulator: zero,
        inverses: [zero; 8],
    }
    let mut boundary = SparseCopyInteractionRow {
        accumulator: zero,
        inverses: [zero; 2],
    }
    let mut commitment = Poseidon2Digest::zero()

    let mut index: usize = 0
    while index < N {
        let position: u32 = index.downcast_truncate()
        if !write_sparse_interaction_trace_step<L>(
            point,
            current,
            next,
            witness,
            challenges,
            base.value,
            tasks,
            trace_length,
            position,
            mut product_accumulator,
            mut round_accumulator,
            mut linear_accumulator,
            mut boundary_accumulator,
            mut product,
            mut round,
            mut linear,
            mut boundary,
            mut commitment,
        ) {
            return invalid_sparse_interaction_trace_digest(base)
        }
        frontier = push_frontier<
            Poseidon2Digest,
            SparseDigestHasher,
            SPARSE_TRACE_FRONTIER_LEVELS,
        >(frontier, commitment)
        index = index + 1
    }

    if !product_accumulator.is_zero()
        || !round_accumulator.is_zero()
        || !linear_accumulator.is_zero()
        || !boundary_accumulator.is_zero() {
        return invalid_sparse_interaction_trace_digest(base)
    }
    let root = complete_frontier_root<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_TRACE_FRONTIER_LEVELS,
    >(frontier)
    SparseInteractionTraceDigest {
        valid: root.valid,
        base: base,
        value: root.value,
    }
}

/// Canonical variable-size opening for sorted, deduplicated sparse leaves.
pub struct SparseTraceMultiOpening<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> {
    pub valid: bool,
    pub leaves: [SparseTraceLeaf<L>; MAX_LEAVES],
    pub path: MerkleMultiPath<Poseidon2Digest, MAX_LEAVES, MAX_SIBLINGS>,
}
impl<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> core::marker::Copy for SparseTraceMultiOpening<L, MAX_LEAVES, MAX_SIBLINGS> {}

impl<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> CanonicalWordStream for SparseTraceMultiOpening<L, MAX_LEAVES, MAX_SIBLINGS> {
    fn word_count(ref self) -> u32 {
        if self.path.leaf_count > MAX_LEAVES.downcast_truncate() { return 0 }
        self.valid.word_count()
            + self.path.word_count()
            + canonical_prefix_word_count(ref self.leaves, self.path.leaf_count)
    }

    fn encode_stream<W: WordSink>(ref self, _ writer: W) -> W {
        if self.path.leaf_count > MAX_LEAVES.downcast_truncate() {
            return writer.reject()
        }
        let writer = self.valid.encode_stream(writer)
        let writer = self.path.encode_stream(writer)
        encode_canonical_prefix(ref self.leaves, self.path.leaf_count, writer)
    }

    fn decode_stream<R: WordSource>(mut self, _ reader: R) -> R {
        let reader = self.valid.decode_stream(reader)
        let reader = self.path.decode_stream(reader)
        if self.path.leaf_count > MAX_LEAVES.downcast_truncate() {
            self.valid = false
            return reader.reject()
        }
        decode_canonical_prefix(mut self.leaves, self.path.leaf_count, reader)
    }
}

/// One complete base-trace authentication carrier. The root and sparse path
/// are produced by the same Merkle traversal, eliminating duplicate hashing
/// in scalar interpreters while leaving room for a retained GPU tree later.
pub struct SparseTraceAuthentication<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> {
    pub valid: bool,
    pub root: SparseTraceDigest<L>,
    pub opening: SparseTraceMultiOpening<L, MAX_LEAVES, MAX_SIBLINGS>,
}
impl<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> core::marker::Copy for SparseTraceAuthentication<L, MAX_LEAVES, MAX_SIBLINGS> {}
derive CanonicalWordStream for SparseTraceAuthentication<
    L,
    MAX_LEAVES,
    MAX_SIBLINGS,
> using CanonicalWordStreamProvider

struct SparseDigestHasher {}

impl TwoToOneHasher<Poseidon2Digest> for SparseDigestHasher {
    fn zero() -> Poseidon2Digest { Poseidon2Digest::zero() }

    fn equal(_ left: Poseidon2Digest, _ right: Poseidon2Digest) -> bool {
        left.equals(right)
    }

    fn hash2(_ left: Poseidon2Digest, _ right: Poseidon2Digest) -> Poseidon2Digest {
        poseidon_compress(left, right)
    }
}

fn zero_sparse_trace_row() -> SparseTraceRow {
    SparseTraceRow {
        value: BabyBear::zero(),
        auxiliary: BabyBear::zero(),
        accumulator_before: BabyBear::zero(),
        accumulator_after: BabyBear::zero(),
        state_before: BabyBear::zero(),
        state_after: BabyBear::zero(),
    }
}

fn zero_sparse_trace_control() -> SparseTraceControl {
    SparseTraceControl {
        selectors: SparseTraceTaskSelectors {
            radix_bit: BabyBear::zero(),
            radix_limb: BabyBear::zero(),
            radix_finish: BabyBear::zero(),
            carry_bit: BabyBear::zero(),
            carry_finish: BabyBear::zero(),
            product_term: BabyBear::zero(),
            product_coefficient: BabyBear::zero(),
            product_round: BabyBear::zero(),
            product_finish: BabyBear::zero(),
            linear_limb: BabyBear::zero(),
            linear_finish: BabyBear::zero(),
            boundary_sign: BabyBear::zero(),
            boundary_limb: BabyBear::zero(),
            transition_finish: BabyBear::zero(),
            padding: BabyBear::zero(),
        },
        linear_roles: SparseTraceLinearRoles {
            sum: BabyBear::zero(),
            left_difference: BabyBear::zero(),
            right_difference: BabyBear::zero(),
            select: BabyBear::zero(),
        },
        range_roles: SparseTraceRangeRoles {
            coordinate: BabyBear::zero(),
            product_low: BabyBear::zero(),
            product_high: BabyBear::zero(),
            product_output: BabyBear::zero(),
            linear_sum: BabyBear::zero(),
            linear_left_difference: BabyBear::zero(),
            linear_right_difference: BabyBear::zero(),
            linear_output: BabyBear::zero(),
        },
        limb_positions: SparseTraceLimbPositions {
            penultimate: BabyBear::zero(),
            last: BabyBear::zero(),
        },
        major: BabyBear::zero(),
        minor: BabyBear::zero(),
        step: BabyBear::zero(),
        flag: BabyBear::zero(),
        width: BabyBear::zero(),
        weight: BabyBear::zero(),
    }
}

fn sparse_trace_control_at<const L: usize>(_ index: u32) -> SparseTraceControl {
    let control = sparse_control_row_at<BabyBear, L>(index)
    SparseTraceControl {
        selectors: SparseTraceTaskSelectors {
            radix_bit: control.selectors.radix_bit,
            radix_limb: control.selectors.radix_limb,
            radix_finish: control.selectors.radix_finish,
            carry_bit: control.selectors.carry_bit,
            carry_finish: control.selectors.carry_finish,
            product_term: control.selectors.product_term,
            product_coefficient: control.selectors.product_coefficient,
            product_round: control.selectors.product_round,
            product_finish: control.selectors.product_finish,
            linear_limb: control.selectors.linear_limb,
            linear_finish: control.selectors.linear_finish,
            boundary_sign: control.selectors.boundary_sign,
            boundary_limb: control.selectors.boundary_limb,
            transition_finish: control.selectors.transition_finish,
            padding: control.selectors.padding,
        },
        linear_roles: SparseTraceLinearRoles {
            sum: control.linear_roles.sum,
            left_difference: control.linear_roles.left_difference,
            right_difference: control.linear_roles.right_difference,
            select: control.linear_roles.select,
        },
        range_roles: SparseTraceRangeRoles {
            coordinate: control.range_roles.coordinate,
            product_low: control.range_roles.product_low,
            product_high: control.range_roles.product_high,
            product_output: control.range_roles.product_output,
            linear_sum: control.range_roles.linear_sum,
            linear_left_difference: control.range_roles.linear_left_difference,
            linear_right_difference: control.range_roles.linear_right_difference,
            linear_output: control.range_roles.linear_output,
        },
        limb_positions: SparseTraceLimbPositions {
            penultimate: control.limb_positions.penultimate,
            last: control.limb_positions.last,
        },
        major: control.major,
        minor: control.minor,
        step: control.step,
        flag: control.flag,
        width: control.width,
        weight: control.weight,
    }
}

pub fn zero_sparse_trace_leaf<const L: usize>() -> SparseTraceLeaf<L> {
    SparseTraceLeaf {
        limb_count: BabyBear::zero(),
        task_count: BabyBear::zero(),
        trace_length: BabyBear::zero(),
        index: BabyBear::zero(),
        active: BabyBear::zero(),
        control: zero_sparse_trace_control(),
        row: zero_sparse_trace_row(),
    }
}

fn invalid_sparse_multi_path<
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>() -> MerkleMultiPath<Poseidon2Digest, MAX_LEAVES, MAX_SIBLINGS> {
    MerkleMultiPath {
        valid: false,
        leaf_count: 0,
        leaf_indices: [0; MAX_LEAVES],
        sibling_count: 0,
        siblings: [Poseidon2Digest::zero(); MAX_SIBLINGS],
    }
}

pub fn empty_sparse_trace_multi_opening<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>() -> SparseTraceMultiOpening<L, MAX_LEAVES, MAX_SIBLINGS> {
    SparseTraceMultiOpening {
        valid: false,
        leaves: [zero_sparse_trace_leaf<L>(); MAX_LEAVES],
        path: invalid_sparse_multi_path<MAX_LEAVES, MAX_SIBLINGS>(),
    }
}

pub fn empty_sparse_trace_authentication<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>() -> SparseTraceAuthentication<L, MAX_LEAVES, MAX_SIBLINGS> {
    SparseTraceAuthentication {
        valid: false,
        root: invalid_sparse_trace_digest<L>(),
        opening: empty_sparse_trace_multi_opening<L, MAX_LEAVES, MAX_SIBLINGS>(),
    }
}

fn invalid_sparse_trace_digest<const L: usize>() -> SparseTraceDigest<L> {
    SparseTraceDigest { valid: false, value: Poseidon2Digest::zero() }
}

pub fn sparse_trace_leaf_from_witness<const L: usize>(
    _ index: u32,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTraceLeaf<L> {
    let tasks = sparse_transition_task_count<L>()
    let trace = sparse_transition_trace_length<L>()
    if L < 2 || index >= trace { return zero_sparse_trace_leaf<L>() }
    let row = sparse_transition_row_from_witness<BabyBear, L>(
        index,
        point,
        current,
        next,
        witness,
    )
    SparseTraceLeaf {
        limb_count: BabyBear::from_u32(L.downcast_truncate()),
        task_count: BabyBear::from_u32(tasks),
        trace_length: BabyBear::from_u32(trace),
        index: BabyBear::from_u32(index),
        active: BabyBear::from_u32(if index < tasks { 1 } else { 0 }),
        control: sparse_trace_control_at<L>(index),
        row: SparseTraceRow {
            value: row.value,
            auxiliary: row.auxiliary,
            accumulator_before: row.accumulator_before,
            accumulator_after: row.accumulator_after,
            state_before: row.state_before,
            state_after: row.state_after,
        },
    }
}

pub fn sparse_trace_leaf_commitment<const L: usize>(
    _ leaf: SparseTraceLeaf<L>,
) -> Poseidon2Digest {
    commit_canonical<
        MandelbrotSparseTraceLeafBabyBearV3,
        SparseTraceLeaf<L>,
    >(ref leaf).digest()
}

fn sparse_trace_row_is_zero(_ row: SparseTraceRow) -> bool {
    row.value.is_zero()
        && row.auxiliary.is_zero()
        && row.accumulator_before.is_zero()
        && row.accumulator_after.is_zero()
        && row.state_before.is_zero()
        && row.state_after.is_zero()
}

fn sparse_trace_control_is_canonical<const L: usize>(
    _ position: u32,
    _ control: SparseTraceControl,
) -> bool {
    control.eq(sparse_trace_control_at<L>(position))
}

pub fn sparse_trace_leaf_is_canonical<const L: usize>(
    _ position: u32,
    _ leaf: SparseTraceLeaf<L>,
) -> bool {
    let tasks = sparse_transition_task_count<L>()
    let trace = sparse_transition_trace_length<L>()
    if L < 2 || position >= trace
        || leaf.limb_count.to_u32() != L.downcast_truncate()
        || leaf.task_count.to_u32() != tasks
        || leaf.trace_length.to_u32() != trace
        || leaf.index.to_u32() != position
        || !sparse_trace_control_is_canonical<L>(position, leaf.control) {
        return false
    }
    let expected_active = position < tasks
    if leaf.active.to_u32() != if expected_active { 1 } else { 0 } {
        return false
    }
    expected_active || sparse_trace_row_is_zero(leaf.row)
}

pub fn sparse_trace_root_power_of_two<
    const L: usize,
    const N: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTraceDigest<L>
where
    L > 1,
    N > 1,
    N <= MAX_SPARSE_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
{
    let trace_length: u32 = N.downcast_truncate()
    if trace_length != sparse_transition_trace_length<L>() {
        return invalid_sparse_trace_digest<L>()
    }
    let mut frontier = empty_frontier<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_TRACE_FRONTIER_LEVELS,
    >()
    let mut index: usize = 0
    while index < N {
        let leaf = sparse_trace_leaf_from_witness<L>(
            index.downcast_truncate(),
            point,
            current,
            next,
            witness,
        )
        frontier = push_frontier<
            Poseidon2Digest,
            SparseDigestHasher,
            SPARSE_TRACE_FRONTIER_LEVELS,
        >(frontier, sparse_trace_leaf_commitment(leaf))
        index = index + 1
    }
    let root = complete_frontier_root<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_TRACE_FRONTIER_LEVELS,
    >(frontier)
    SparseTraceDigest { valid: root.valid, value: root.value }
}

fn reset_sparse_trace_authentication<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ authentication: mut SparseTraceAuthentication<L, MAX_LEAVES, MAX_SIBLINGS>,
) {
    authentication = empty_sparse_trace_authentication<
        L,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >()
}

/// Authenticate requested base rows with the shared zk-kit-derived sparse
/// Merkle carrier. Request normalization is owned by `merkle_core`, while Fe
/// regenerates each opened nominal leaf from the same transition witness.
pub fn write_sparse_trace_authentication_power_of_two<
    const L: usize,
    const N: usize,
    const REQUESTS: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
    _ requested: own [u32; REQUESTS],
    _ authentication: mut SparseTraceAuthentication<
        L,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
) -> bool
where
    L > 1,
    N > 1,
    N <= MAX_SPARSE_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
    REQUESTS > 0,
    MAX_LEAVES > 0,
{
    reset_sparse_trace_authentication(mut authentication)
    let trace_length: u32 = N.downcast_truncate()
    if trace_length != sparse_transition_trace_length<L>() {
        return false
    }
    let mut commitments = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        let leaf = sparse_trace_leaf_from_witness<L>(
            index.downcast_truncate(),
            point,
            current,
            next,
            witness,
        )
        commitments[index] = sparse_trace_leaf_commitment(leaf)
        index = index + 1
    }
    let mut path = invalid_sparse_multi_path<MAX_LEAVES, MAX_SIBLINGS>()
    let mut root = MerkleRoot {
        valid: false,
        value: Poseidon2Digest::zero(),
    }
    if !write_multi_path_and_root_from_leaves<
        Poseidon2Digest,
        SparseDigestHasher,
        N,
        REQUESTS,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(ref commitments, requested, mut path, mut root) {
        return false
    }
    authentication.root = SparseTraceDigest {
        valid: root.valid,
        value: root.value,
    }
    authentication.opening.path = path
    index = 0
    while index < path.leaf_count as usize {
        authentication.opening.leaves[index] = sparse_trace_leaf_from_witness<L>(
            path.leaf_indices[index],
            point,
            current,
            next,
            witness,
        )
        index = index + 1
    }
    authentication.opening.valid = true
    authentication.valid = true
    true
}

pub fn verify_sparse_trace_multi_opening<
    const L: usize,
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ opening: ref SparseTraceMultiOpening<L, MAX_LEAVES, MAX_SIBLINGS>,
    _ root: SparseTraceDigest<L>,
) -> bool
where
    L > 1,
    N > 1,
    N <= MAX_SPARSE_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
    MAX_LEAVES > 0,
{
    let trace_length: u32 = N.downcast_truncate()
    if !opening.valid || !root.valid
        || trace_length != sparse_transition_trace_length<L>() {
        return false
    }
    let count: usize = opening.path.leaf_count as usize
    if count == 0 || count > MAX_LEAVES { return false }
    let mut commitments = [Poseidon2Digest::zero(); MAX_LEAVES]
    let mut index: usize = 0
    while index < count {
        if !sparse_trace_leaf_is_canonical<L>(
            opening.path.leaf_indices[index],
            opening.leaves[index],
        ) {
            return false
        }
        commitments[index] = sparse_trace_leaf_commitment(opening.leaves[index])
        index = index + 1
    }
    while index < MAX_LEAVES {
        let leaf = opening.leaves[index]
        if !leaf.limb_count.is_zero()
            || !leaf.task_count.is_zero()
            || !leaf.trace_length.is_zero()
            || !leaf.index.is_zero()
            || !leaf.active.is_zero()
            || !sparse_trace_row_is_zero(leaf.row) {
            return false
        }
        index = index + 1
    }
    multi_verify<
        Poseidon2Digest,
        SparseDigestHasher,
        N,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(root.value, commitments, opening.path)
}

pub fn verify_sparse_trace_authentication<
    const L: usize,
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ authentication: ref SparseTraceAuthentication<
        L,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
) -> bool
where
    L > 1,
    N > 1,
    N <= MAX_SPARSE_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
    MAX_LEAVES > 0,
{
    authentication.valid && verify_sparse_trace_multi_opening<
        L,
        N,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(ref authentication.opening, authentication.root)
}
