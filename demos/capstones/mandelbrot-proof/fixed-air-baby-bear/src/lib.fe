}
struct MandelbrotSparseRoundGammaBabyBearV1 {}
impl Poseidon2FieldDomain for MandelbrotSparseRoundGammaBabyBearV1 {
    const TAG: u32 = protocol_tag("RG01")
}
struct MandelbrotSparseLinearBetaBabyBearV1 {}
impl Poseidon2FieldDomain for MandelbrotSparseLinearBetaBabyBearV1 {
