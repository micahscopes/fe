    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> core::marker::Copy for SparseBaseLdeDigest<L, TRACE, LDE> {}
derive CanonicalWords for SparseBaseLdeDigest<L, TRACE, LDE> using CanonicalWordsProvider

/// Interaction placement exists only after the source-branded challenge set
