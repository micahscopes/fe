/// One nominal committed base-trace leaf. Protocol metadata is carried in
/// every leaf so a path cannot be replayed across limb counts or trace shapes.
/// The six witness lanes retain the readable structure of `SparseTaskRow`.
pub struct SparseTraceRow {
    pub value: BabyBear,
    pub auxiliary: BabyBear,
    pub accumulator_before: BabyBear,
    pub accumulator_after: BabyBear,
    pub state_before: BabyBear,
    pub state_after: BabyBear,
}
impl core::marker::Copy for SparseTraceRow {}
derive CanonicalWords for SparseTraceRow using CanonicalWordsProvider

