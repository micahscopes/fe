/// The authenticated trace reuses the exact generic records consumed by the
/// AIR. These aliases keep the public commitment vocabulary readable without
/// introducing a second set of field declarations or conversion code.
pub type SparseTraceTaskSelectors = SparseControlSelectors<BabyBear>
pub type SparseTraceLinearRoles = SparseLinearRoleSelectors<BabyBear>
pub type SparseTraceRangeRoles = SparseRangeRoleSelectors<BabyBear>
pub type SparseTraceLimbPositions = SparseLimbPositionSelectors<BabyBear>
pub type SparseTraceControl = SparseControlRow<BabyBear>
pub type SparseTraceRow = SparseTaskRow<BabyBear>

/// The exact polynomial base-row schema. Control and witness fields are the
/// nominal records committed by `SparseTraceLeaf`; the derived arithmetic plan
/// is constrained back to those fields by its shared interpreter. Reflection
/// gives LDE consumers one field order without a parallel column-number table.
pub struct SparseBaseAirRow<F: Radix2Field> {
    pub control: SparseControlRow<F>,
    pub control_plan: SparseControlPlanWitness<F>,
    pub control_link_plan: SparseControlLinkPlanWitness<F>,
    pub witness: SparseTaskRow<F>,
    pub arithmetic_plan: SparseArithmeticPlanWitness<F>,
    pub arithmetic_link_plan: SparseArithmeticLinkPlanWitness<F>,
    pub round_plan: SparseRoundPlanWitness<F>,
    pub linear_plan: SparseLinearPlanWitness<F>,
    pub boundary_plan: SparseBoundaryPlanWitness<F>,
}
impl<F: Radix2Field> core::marker::Copy
    for SparseBaseAirRow<F> {}
derive CanonicalWords for SparseBaseAirRow<F> using CanonicalWordsProvider

/// Shared semantic inputs for one sparse base AIR row. Scalar construction and
/// GPU partition interpreters consume this same nominal context; a placement
/// policy selects which derived subrecord to evaluate without introducing a
/// second witness formula or column schema.
pub struct SparseBaseAirInputs<const L: usize> {
    pub index: u32,
    pub point: ComplexFixed<L>,
    pub current: ComplexFixed<L>,
    pub next: ComplexFixed<L>,
    pub witness: FixedMandelbrotTransitionWitness<L>,
}
impl<const L: usize> core::marker::Copy for SparseBaseAirInputs<L> {}

pub struct SparseTraceLeaf<const L: usize> {
    pub limb_count: BabyBear,
    pub task_count: BabyBear,
    pub trace_length: BabyBear,
    pub index: BabyBear,
    pub active: BabyBear,
    pub control: SparseControlRow<BabyBear>,
    pub row: SparseTaskRow<BabyBear>,
}
impl<const L: usize> core::marker::Copy for SparseTraceLeaf<L> {}
derive CanonicalWords for SparseTraceLeaf<L> using CanonicalWordsProvider

/// Limb-branded root for one complete power-of-two sparse base trace.
pub struct SparseTraceDigest<const L: usize> {
    pub valid: bool,
    pub value: Poseidon2Digest,
}
impl<const L: usize> core::marker::Copy for SparseTraceDigest<L> {}
derive CanonicalWords for SparseTraceDigest<L> using CanonicalWordsProvider

/// Fiat-Shamir challenges for all committed sparse copy interactions. Every
/// bus and role has an independent domain, and every value lives in the
/// quartic BabyBear challenge field.
pub struct SparseInteractionChallenges {
    pub valid: bool,
    pub product: SparseCopyChallenges<BabyBearExt4>,
    pub round: SparseCopyChallenges<BabyBearExt4>,
    pub linear: SparseCopyChallenges<BabyBearExt4>,
    pub boundary: SparseCopyChallenges<BabyBearExt4>,
}
impl core::marker::Copy for SparseInteractionChallenges {}
derive CanonicalWords for SparseInteractionChallenges using CanonicalWordsProvider

/// Source-branded production challenges. Its payload is private so code
/// outside this ingot cannot repackage raw-checkpoint challenges as though
/// they followed the base-LDE commitment.
pub struct SparseLdeInteractionChallenges<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> {
    value: SparseInteractionChallenges,
}
impl<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> core::marker::Copy for SparseLdeInteractionChallenges<L, TRACE, LDE> {}
derive CanonicalWords for SparseLdeInteractionChallenges<L, TRACE, LDE> using CanonicalWordsProvider

/// All four copy buses evaluated over the quartic challenge field. These are
/// prover witness columns, not precomputed constants: the same typed Fe port
/// descriptions used by the AIR generate every inverse and accumulator.
pub struct SparseInteractionTraceRow<F: Radix2Field> {
    pub product: SparseProductInteractionRow<F>,
    pub round: SparseRoundInteractionRow<F>,
    pub linear: SparseLinearInteractionRow<F>,
    pub boundary: SparseBoundaryInteractionRow<F>,
}
impl<F: Radix2Field> core::marker::Copy
    for SparseInteractionTraceRow<F> {}
derive CanonicalWords for SparseInteractionTraceRow<F> using CanonicalWordsProvider

/// Polynomial column counts are derived from the nominal row codecs. They are
/// public so LDE, commitment, query, and verifier carriers can share the exact
/// schema without copying numeric column declarations.
pub const SPARSE_BASE_AIR_FIELDS: usize =
    <SparseBaseAirRow<BabyBear> as CanonicalWords>::WORDS as usize
pub const SPARSE_INTERACTION_AIR_FIELDS: usize =
    <SparseInteractionTraceRow<BabyBearExt4> as CanonicalWords>::WORDS as usize

pub struct SparseBaseAirFields {
    pub valid: bool,
    pub values: [BabyBear; SPARSE_BASE_AIR_FIELDS],
}
impl core::marker::Copy for SparseBaseAirFields {}
derive CanonicalWords for SparseBaseAirFields using CanonicalWordsProvider

pub struct SparseInteractionAirFields {
    pub valid: bool,
    pub values: [BabyBear; SPARSE_INTERACTION_AIR_FIELDS],
}
impl core::marker::Copy for SparseInteractionAirFields {}
derive CanonicalWords for SparseInteractionAirFields using CanonicalWordsProvider

pub fn sparse_base_air_fields(
    _ row: ref SparseBaseAirRow<BabyBear>,
) -> SparseBaseAirFields {
    let encoded = encode_canonical_word_array<
        SparseBaseAirRow<BabyBear>,
        SPARSE_BASE_AIR_FIELDS,
    >(row)
    let mut values = [BabyBear::zero(); SPARSE_BASE_AIR_FIELDS]
    if !encoded.valid { return SparseBaseAirFields { valid: false, values: values } }
    let mut index: usize = 0
    while index < SPARSE_BASE_AIR_FIELDS {
        values[index] = BabyBear::from_u32(encoded.words[index])
        index = index + 1
    }
    SparseBaseAirFields { valid: true, values: values }
}

pub fn sparse_interaction_air_fields(
    _ row: ref SparseInteractionTraceRow<BabyBearExt4>,
) -> SparseInteractionAirFields {
    let encoded = encode_canonical_word_array<
        SparseInteractionTraceRow<BabyBearExt4>,
        SPARSE_INTERACTION_AIR_FIELDS,
    >(row)
    let mut values = [BabyBear::zero(); SPARSE_INTERACTION_AIR_FIELDS]
    if !encoded.valid {
        return SparseInteractionAirFields { valid: false, values: values }
    }
    let mut index: usize = 0
    while index < SPARSE_INTERACTION_AIR_FIELDS {
        values[index] = BabyBear::from_u32(encoded.words[index])
        index = index + 1
    }
    SparseInteractionAirFields { valid: true, values: values }
}

/// Row-major base-field evaluations on the original trace subgroup. The
/// numeric widths are derived from the nominal Fe rows above; this carrier is
/// only a placement for the generated schema.
pub struct SparseAirEvaluationTrace<const N: usize> {
    pub valid: bool,
    pub base: [[BabyBear; SPARSE_BASE_AIR_FIELDS]; N],
    pub interaction: [[BabyBear; SPARSE_INTERACTION_AIR_FIELDS]; N],
}
impl<const N: usize> core::marker::Copy for SparseAirEvaluationTrace<N> {}
derive CanonicalWords for SparseAirEvaluationTrace<N> using CanonicalWordsProvider

/// Row-major disjoint-coset evaluations consumed by commitments, composition,
/// and authenticated query openings.
pub struct SparseAirLdeCodeword<const N: usize> {
    pub valid: bool,
    pub base: [[BabyBear; SPARSE_BASE_AIR_FIELDS]; N],
    pub interaction: [[BabyBear; SPARSE_INTERACTION_AIR_FIELDS]; N],
}
impl<const N: usize> core::marker::Copy for SparseAirLdeCodeword<N> {}
derive CanonicalWords for SparseAirLdeCodeword<N> using CanonicalWordsProvider

/// Base-only placement used before interaction challenges exist. Splitting
/// this phase is a protocol property: the base LDE root must be fixed before
/// any quartic interaction witness is generated.
pub struct SparseBaseAirEvaluationTrace<const N: usize> {
    pub valid: bool,
    pub values: [[BabyBear; SPARSE_BASE_AIR_FIELDS]; N],
}
impl<const N: usize> core::marker::Copy for SparseBaseAirEvaluationTrace<N> {}

pub struct SparseBaseAirLdeCodeword<const N: usize> {
    pub valid: bool,
    pub values: [[BabyBear; SPARSE_BASE_AIR_FIELDS]; N],
}
impl<const N: usize> core::marker::Copy for SparseBaseAirLdeCodeword<N> {}

/// Nominal commitment leaf for one base-LDE evaluation. Trace and LDE sizes
/// are part of every leaf, so roots cannot be replayed across proof shapes.
pub struct SparseBaseLdeLeaf<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> {
    pub limb_count: BabyBear,
    pub trace_length: BabyBear,
    pub lde_length: BabyBear,
    pub index: BabyBear,
    pub values: [BabyBear; SPARSE_BASE_AIR_FIELDS],
}
impl<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> core::marker::Copy for SparseBaseLdeLeaf<L, TRACE, LDE> {}
derive CanonicalWords for SparseBaseLdeLeaf<L, TRACE, LDE> using CanonicalWordsProvider

/// Shape- and limb-branded base-LDE root. This, not the raw `SL03`
/// checkpoint, is the Fiat-Shamir source for production interaction columns.
pub struct SparseBaseLdeDigest<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> {
    pub valid: bool,
    pub value: Poseidon2Digest,
}
