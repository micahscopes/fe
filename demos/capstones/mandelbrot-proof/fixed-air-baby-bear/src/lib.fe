//! BabyBear authentication for the generated high-precision sparse AIR trace.
//!
//! This layer commits the exact base rows, canonical padding, and quartic copy
//! interactions emitted by `mandelbrot_proof_fixed_air_core`. It deliberately
//! does not call the result an AIR or FRI receipt: LDE, composition, queries,
//! and FRI still have to bind these columns before sparse authentication
//! becomes a proof.

use canonical_words::{
    CanonicalWordStream,
    CanonicalWordStreamProvider,
    CanonicalWords,
    CanonicalWordsProvider,
    WordSink,
    WordSource,
    canonical_prefix_word_count,
    decode_canonical_prefix,
    encode_canonical_prefix,
}
use mandelbrot_proof_fixed_air::FixedMandelbrotTransitionWitness
use mandelbrot_proof_fixed_air_core::{
    SparseCopyChallenges,
    SparseCopyInteractionRow,
    evaluate_sparse_boundary_interaction_row,
    evaluate_sparse_linear_interaction_row,
    evaluate_sparse_product_interaction_row,
    evaluate_sparse_round_interaction_row,
    sparse_control_row_at,
    sparse_transition_row_from_witness,
    sparse_transition_task_count,
    sparse_transition_trace_length,
    write_sparse_boundary_interaction_row,
    write_sparse_linear_interaction_row,
    write_sparse_product_interaction_row,
    write_sparse_round_interaction_row,
}
use mandelbrot_proof_recursive::ComplexFixed
use merkle_core::{
    MerkleMultiPath,
    MerkleRoot,
    TwoToOneHasher,
    complete_frontier_root,
    empty_frontier,
    multi_verify,
    push_frontier,
    write_multi_path_and_root_from_leaves,
}
use poseidon_baby_bear::{
    Poseidon2Digest,
    Poseidon2FieldDomain,
    commit_canonical,
    compress as poseidon_compress,
    squeeze_ext4,
}
use precision::baby_bear::{BabyBear, BabyBearExt4}
use core::ops::Eq

const SPARSE_TRACE_FRONTIER_LEVELS: usize = 23
const MAX_SPARSE_TRACE_LENGTH: usize = 4194304

const fn protocol_tag(_ label: String<4>) -> u32 {
    let bytes = label.as_bytes()
    ((bytes[0] as u32) << 24)
        | ((bytes[1] as u32) << 16)
        | ((bytes[2] as u32) << 8)
        | (bytes[3] as u32)
}

struct MandelbrotSparseTraceLeafBabyBearV3 {}

impl Poseidon2FieldDomain for MandelbrotSparseTraceLeafBabyBearV3 {
    const TAG: u32 = protocol_tag("SL03")
}

struct MandelbrotSparseInteractionLeafBabyBearV1 {}

impl Poseidon2FieldDomain for MandelbrotSparseInteractionLeafBabyBearV1 {
    const TAG: u32 = protocol_tag("SI01")
}

