derive CanonicalWords for SparseInteractionLdeDigest<L, TRACE, LDE> using CanonicalWordsProvider

/// Recursive-leaf statement plus the exact production LDE roots it challenges.
/// The nested generic transcript is the established BabyBear input consumed by
/// composition and FRI, while this wrapper retains enough nominal evidence to
/// prevent swapping either sparse commitment at the application boundary.
pub struct SparseAirLdeTranscriptDigest<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> {
    pub valid: bool,
    pub statement: RecursiveCommittedInterval<L>,
    pub base: SparseBaseLdeDigest<L, TRACE, LDE>,
    pub interaction: SparseInteractionLdeDigest<L, TRACE, LDE>,
    pub transcript: AirLdeTranscriptDigest,
}
impl<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> core::marker::Copy for SparseAirLdeTranscriptDigest<L, TRACE, LDE> {}

/// One authenticated extension of the canonical statement-and-root AIR
/// transcript. Protocol layers may append a nominally separated commitment,
/// while composition keeps the original statement and roots available for
/// exact rebinding checks. Private fields prevent callers from presenting an
/// arbitrary challenge digest as an authenticated extension.
pub struct SparseCompositionTranscriptDigest<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> {
    valid: bool,
    air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
    transcript: AirLdeTranscriptDigest,
}
impl<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> core::marker::Copy for SparseCompositionTranscriptDigest<L, TRACE, LDE> {}

impl<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> SparseCompositionTranscriptDigest<L, TRACE, LDE> {
    pub fn is_valid(self) -> bool {
        self.valid && self.air.valid && self.transcript.valid
    }
    pub fn transcript(self) -> AirLdeTranscriptDigest { self.transcript }
}

/// One full quartic composition codeword. The values use the same canonical
/// BabyBear composition commitment and FRI interpreters as the smaller proof
/// protocol; only their sparse-AIR producer is new.
pub struct SparseCompositionAirCodeword<const N: usize> {
    pub valid: bool,
    pub values: [BabyBearExt4; N],
}
impl<const N: usize> core::marker::Copy for SparseCompositionAirCodeword<N> {}

/// Independent Fiat-Shamir lanes for fixed-position public constraints. The
/// fold challenge separates public values from the internal AIR fold, while
/// the mix challenge prevents cancellation between their rational composition
/// and the ordinary four-family quotient.
pub struct SparsePublicConstraintChallenges {
    pub valid: bool,
    pub fold: BabyBearExt4,
    pub mix: BabyBearExt4,
}
impl core::marker::Copy for SparsePublicConstraintChallenges {}

/// A composition root branded by the exact statement and pair of sparse LDE
/// roots from which its codeword was generated.
pub struct SparseCompositionLdeDigest<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> {
    pub valid: bool,
    pub air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
    pub value: CompositionDigest,
}
impl<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> core::marker::Copy for SparseCompositionLdeDigest<L, TRACE, LDE> {}

/// Typed extension-field view of one pair of base-field LDE rows. The view is
/// reconstructed through the same reflection-derived codecs that define the
/// committed column order. No column number or parallel field list appears at
/// the verifier boundary.
pub struct SparseOpenedAirRow {
    pub valid: bool,
    pub base: SparseBaseAirRow<BabyBearExt4>,
    pub interaction: SparseInteractionTraceRow<BabyBearExt4>,
}
impl core::marker::Copy for SparseOpenedAirRow {}

pub struct SparseBaseLdeTreeRole<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> {}
pub struct SparseInteractionLdeTreeRole<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> {}

pub type SparseBaseLdeMultiOpening<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> = MerkleMultiOpening<
    SparseBaseLdeTreeRole<L, TRACE, LDE>,
    [BabyBear; SPARSE_BASE_AIR_FIELDS],
    Poseidon2Digest,
    MAX_LEAVES,
    MAX_SIBLINGS,
>

pub type SparseInteractionLdeMultiOpening<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> = MerkleMultiOpening<
    SparseInteractionLdeTreeRole<L, TRACE, LDE>,
    [BabyBear; SPARSE_INTERACTION_AIR_FIELDS],
    Poseidon2Digest,
    MAX_LEAVES,
    MAX_SIBLINGS,
>

/// A field-native canonical reader over one authenticated BabyBear row.
/// `embedded` expands every base-field column to `(value, 0, 0, 0)` while
/// `extension` preserves the four coefficient columns already present in the
/// interaction trace. The generic codecs provide all record traversal.
struct SparseLdeWordReader<const N: usize> {
    values: [BabyBear; N],
    cursor: u32,
    coefficients: u32,
    valid: bool,
}
impl<const N: usize> core::marker::Copy for SparseLdeWordReader<N> {}

impl<const N: usize> SparseLdeWordReader<N> {
    fn embedded(_ values: [BabyBear; N]) -> Self {
        Self { values: values, cursor: 0, coefficients: 4, valid: true }
    }

    fn extension(_ values: [BabyBear; N]) -> Self {
        Self { values: values, cursor: 0, coefficients: 1, valid: true }
    }

    fn complete(self) -> bool {
        let fields: u32 = N.downcast_truncate()
        self.valid
            && self.cursor == fields * self.coefficients
    }
}

impl<const N: usize> WordSource for SparseLdeWordReader<N> {
    fn read(self) -> WordRead<Self> {
        let fields: u32 = N.downcast_truncate()
        let words = fields * self.coefficients
        if !self.valid
            || (self.coefficients != 1 && self.coefficients != 4)
            || self.cursor >= words {
            return WordRead {
                source: Self {
                    values: self.values,
                    cursor: self.cursor,
                    coefficients: self.coefficients,
                    valid: false,
                },
                value: 0,
            }
        }
        let field = self.cursor / self.coefficients
        let coefficient = self.cursor - field * self.coefficients
        WordRead {
            source: Self {
                values: self.values,
                cursor: self.cursor + 1,
                coefficients: self.coefficients,
                valid: true,
            },
            value: if coefficient == 0 {
                self.values[field as usize].to_u32()
            } else {
                0
            },
        }
    }

    fn reject(self) -> Self {
        Self {
            values: self.values,
            cursor: self.cursor,
            coefficients: self.coefficients,
            valid: false,
        }
    }
}

pub fn sparse_opened_air_row(
    _ base_fields: [BabyBear; SPARSE_BASE_AIR_FIELDS],
    _ interaction_fields: [BabyBear; SPARSE_INTERACTION_AIR_FIELDS],
) -> SparseOpenedAirRow {
    let mut base = zero_sparse_base_air_row_field<BabyBearExt4>()
    let base_reader = base.decode(
        SparseLdeWordReader<SPARSE_BASE_AIR_FIELDS>::embedded(base_fields),
    )
    let mut interaction = zero_sparse_interaction_trace_row_field<BabyBearExt4>()
    let interaction_reader = interaction.decode(
        SparseLdeWordReader<SPARSE_INTERACTION_AIR_FIELDS>::extension(
            interaction_fields,
        ),
    )
    SparseOpenedAirRow {
        valid: base_reader.complete() && interaction_reader.complete(),
        base: base,
        interaction: interaction,
    }
}

/// Semantic zero constructor for focused composition interpreters. Callers
/// can set named fields directly without depending on the generated canonical
/// column positions used by committed codewords.
pub fn zero_sparse_opened_air_row() -> SparseOpenedAirRow {
    SparseOpenedAirRow {
        valid: true,
        base: zero_sparse_base_air_row_field<BabyBearExt4>(),
        interaction: zero_sparse_interaction_trace_row_field<BabyBearExt4>(),
    }
}

enum SparseConstraintFamily {
    AllRows,
    PairRows,
    FirstRow,
    LastRow,
}
impl core::marker::Copy for SparseConstraintFamily {}

/// Lightweight interpretation of one AIR expression as a polynomial-degree
/// upper bound. Trace columns enter as degree-one variables; transcript
/// challenges and field constants enter at degree zero. Addition preserves
/// the larger bound and multiplication adds bounds, so the exact authored
/// constraint body can be interpreted without lowering BabyBear arithmetic.
/// Inversion is accepted only for constants and otherwise fails closed.
struct AirPolynomialDegree {
    valid: bool,
    degree: u32,
}
impl core::marker::Copy for AirPolynomialDegree {}

impl AirPolynomialDegree {
    fn constant() -> Self { Self { valid: true, degree: 0 } }
    fn variable() -> Self { Self { valid: true, degree: 1 } }
    fn invalid() -> Self { Self { valid: false, degree: 0 } }

    fn maximum(self, _ other: Self) -> Self {
        if !self.valid || !other.valid { return Self::invalid() }
        Self {
            valid: true,
            degree: if self.degree > other.degree {
                self.degree
            } else {
                other.degree
            },
        }
    }

    fn product(self, _ other: Self) -> Self {
        if !self.valid || !other.valid
            || self.degree > 2147483647 - other.degree {
            return Self::invalid()
        }
        Self { valid: true, degree: self.degree + other.degree }
    }
}

impl Radix2Field for AirPolynomialDegree {
    const TWO_ADICITY: u32 = 0

    fn radix2_zero() -> Self { Self::constant() }
    fn radix2_is_zero(self) -> bool { false }
    fn radix2_add(self, _ other: Self) -> Self { self.maximum(other) }
    fn radix2_sub(self, _ other: Self) -> Self { self.maximum(other) }
    fn radix2_mul(self, _ other: Self) -> Self { self.product(other) }
    fn radix2_pow(self, _ exponent: u32) -> Self {
        if !self.valid || (exponent != 0 && self.degree > 2147483647 / exponent) {
            return Self::invalid()
        }
        Self { valid: true, degree: self.degree * exponent }
    }
    fn radix2_inverse_or_zero(self) -> Self {
        if self.valid && self.degree == 0 {
            Self::constant()
        } else {
            Self::invalid()
        }
    }
    fn radix2_root(_ log_order: u32) -> Self { Self::constant() }
}

/// Honest one-word schema used only to let the existing reflection traversal
/// populate every field of a symbolic row. Bit zero is validity and the upper
/// 31 bits hold the bounded degree, so encode/decode remains a true roundtrip.
impl CanonicalWords for AirPolynomialDegree {
    const WORDS: u32 = 1

    fn encode<W: WordSink>(ref self, _ writer: W) -> W {
        let word = if self.valid && self.degree <= 2147483647 {
            (self.degree << 1) | 1
        } else {
            0
        }
        writer.write(word)
    }

    fn decode<R: WordSource>(mut self, _ reader: R) -> R {
        let next = reader.read()
        self = if (next.value & 1) == 1 {
            Self { valid: true, degree: next.value >> 1 }
        } else {
            Self::invalid()
        }
        next.source
    }
}

struct AirPolynomialVariableSource {
    cursor: u32,
    valid: bool,
}
impl core::marker::Copy for AirPolynomialVariableSource {}

impl AirPolynomialVariableSource {
    fn new() -> Self { Self { cursor: 0, valid: true } }
}

impl WordSource for AirPolynomialVariableSource {
    fn read(self) -> WordRead<Self> {
        WordRead {
            source: Self { cursor: self.cursor + 1, valid: self.valid },
            value: 3,
        }
    }

    fn reject(self) -> Self {
        Self { cursor: self.cursor, valid: false }
    }
}

/// Structural count produced by the exact sparse composition fold.
/// Evaluators and security-policy gates therefore observe one authored
/// constraint sequence rather than maintaining a copied count table.
pub struct SparseAirConstraintShape {
    pub valid: bool,
    pub all_rows: u32,
    pub pair_rows: u32,
    pub first_row: u32,
    pub last_row: u32,
    pub total: u32,
    pub all_rows_degree: u32,
    pub pair_rows_degree: u32,
    pub first_row_degree: u32,
    pub last_row_degree: u32,
    pub maximum_degree: u32,
}
impl core::marker::Copy for SparseAirConstraintShape {}
derive CanonicalWords for SparseAirConstraintShape using CanonicalWordsProvider

/// Component-level degree interpretation for the six all-row evaluators.
/// This is derived from the same symbolic rows and exact production evaluator
/// bodies as `SparseAirConstraintShape`; it is an audit surface for locating
/// the next quadratic-lowering slice, not a copied degree table.
pub struct SparseAirAllRowsDegreeShape {
    pub valid: bool,
    pub control: u32,
    pub arithmetic: u32,
    pub product: u32,
    pub round: u32,
    pub linear: u32,
    pub boundary: u32,
    pub maximum: u32,
}
impl core::marker::Copy for SparseAirAllRowsDegreeShape {}
derive CanonicalWords for SparseAirAllRowsDegreeShape using CanonicalWordsProvider

/// Component-level degree interpretation for the six pair-row evaluators.
/// It separates control-state adjacency from arithmetic and copy-interaction
/// adjacency while executing the exact production evaluator bodies.
pub struct SparseAirPairRowsDegreeShape {
    pub valid: bool,
    pub control: u32,
    pub arithmetic: u32,
    pub product: u32,
    pub round: u32,
    pub linear: u32,
    pub boundary: u32,
    pub maximum: u32,
}
impl core::marker::Copy for SparseAirPairRowsDegreeShape {}
derive CanonicalWords for SparseAirPairRowsDegreeShape using CanonicalWordsProvider

/// Degree attribution for one exact authored copy-bus port. The report keeps
/// the port expression, inverse relation, and accumulator contribution
/// separate so a lowering plan can target the actual peak instead of copying
/// or approximating the production port arithmetic.
pub struct SparseCopyPortDegreeShape {
    pub valid: bool,
    pub selector: u32,
    pub coefficient: u32,
    pub address: u32,
    pub value: u32,
    pub compressed: u32,
    pub inverse_relation: u32,
    pub delta: u32,
    pub maximum: u32,
}
impl core::marker::Copy for SparseCopyPortDegreeShape {}
derive CanonicalWords for SparseCopyPortDegreeShape using CanonicalWordsProvider

/// Consecutive composition powers continue across zerofier families, matching
/// the established AIR composition convention while allowing each generic
/// fixed-air evaluator to retain its own readable constraint fold.
struct SparseCompositionFold<F: Radix2Field> {
    valid: bool,
    challenge: F,
    power: F,
    all_rows: F,
    pair_rows: F,
    first_row: F,
    last_row: F,
    all_rows_constraints: u32,
    pair_rows_constraints: u32,
    first_row_constraints: u32,
    last_row_constraints: u32,
}
impl<F: Radix2Field> core::marker::Copy for SparseCompositionFold<F> {}

impl<F: Radix2Field> SparseCompositionFold<F> {
    fn new(_ challenge: F) -> Self {
        Self {
            valid: true,
            challenge: challenge,
            power: F::radix2_root(0),
            all_rows: F::radix2_zero(),
            pair_rows: F::radix2_zero(),
            first_row: F::radix2_zero(),
            last_row: F::radix2_zero(),
            all_rows_constraints: 0,
            pair_rows_constraints: 0,
            first_row_constraints: 0,
            last_row_constraints: 0,
        }
    }

    fn absorb(
        mut self,
        _ family: SparseConstraintFamily,
        _ valid: bool,
        _ constraints: u32,
        _ value: F,
    ) -> Self {
        self.valid = self.valid && valid
        let contribution = self.power.radix2_mul(value)
        match family {
            SparseConstraintFamily::AllRows => {
                self.all_rows = self.all_rows.radix2_add(contribution)
                self.all_rows_constraints = self.all_rows_constraints + constraints
            }
            SparseConstraintFamily::PairRows => {
                self.pair_rows = self.pair_rows.radix2_add(contribution)
                self.pair_rows_constraints = self.pair_rows_constraints + constraints
            }
            SparseConstraintFamily::FirstRow => {
                self.first_row = self.first_row.radix2_add(contribution)
                self.first_row_constraints = self.first_row_constraints + constraints
            }
            SparseConstraintFamily::LastRow => {
                self.last_row = self.last_row.radix2_add(contribution)
                self.last_row_constraints = self.last_row_constraints + constraints
            }
        }
        self.power = self.power.radix2_mul(self.challenge.radix2_pow(constraints))
        self
    }

    fn absorb_fixed(
        self,
        _ family: SparseConstraintFamily,
        _ evaluation: FixedAirConstraintEvaluation<F>,
    ) -> Self {
        self.absorb(
            family,
            evaluation.valid,
            evaluation.constraints,
            evaluation.folded,
        )
    }

    fn numerators(self) -> AirConstraintNumerators<F> {
        if !self.valid {
            return AirConstraintNumerators {
                all_rows: F::radix2_zero(),
                pair_rows: F::radix2_zero(),
                first_row: F::radix2_zero(),
                last_row: F::radix2_zero(),
            }
        }
        AirConstraintNumerators {
            all_rows: self.all_rows,
            pair_rows: self.pair_rows,
            first_row: self.first_row,
            last_row: self.last_row,
        }
    }

}

fn sparse_composition_fold_fields<F: Radix2Field, const L: usize>(
    _ challenge: F,
    _ product_challenges: SparseCopyChallenges<F>,
    _ round_challenges: SparseCopyChallenges<F>,
    _ linear_challenges: SparseCopyChallenges<F>,
    _ boundary_challenges: SparseCopyChallenges<F>,
    _ control: SparseControlRow<F>,
    _ next_control: SparseControlRow<F>,
    _ control_plan: SparseControlPlanWitness<F>,
    _ control_link_plan: SparseControlLinkPlanWitness<F>,
    _ witness: SparseTaskRow<F>,
    _ next_witness: SparseTaskRow<F>,
    _ arithmetic_plan: SparseArithmeticPlanWitness<F>,
    _ arithmetic_link_plan: SparseArithmeticLinkPlanWitness<F>,
    _ round_plan: SparseRoundPlanWitness<F>,
    _ linear_plan: SparseLinearPlanWitness<F>,
    _ boundary_plan: SparseBoundaryPlanWitness<F>,
    _ interaction: SparseInteractionTraceRow<F>,
    _ next_interaction: SparseInteractionTraceRow<F>,
) -> SparseCompositionFold<F>
where L > 1,
{
    let mut fold = SparseCompositionFold<F>::new(challenge)

    fold = fold.absorb_fixed(
        SparseConstraintFamily::AllRows,
        evaluate_sparse_control_row(challenge, control, control_plan),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::AllRows,
        evaluate_sparse_arithmetic_row<F, L>(
            challenge, control, witness, arithmetic_plan,
        ),
    )
    let product = evaluate_sparse_product_interaction_row<F, L>(
        challenge,
        product_challenges,
        control,
        witness,
        interaction.product,
    )
    fold = fold.absorb(
        SparseConstraintFamily::AllRows,
        product.valid,
        product.constraints,
        product.folded,
    )
    let round = evaluate_sparse_round_interaction_row<F, L>(
        challenge,
        round_challenges,
        control,
        next_control,
        witness,
        round_plan,
        interaction.round,
    )
    fold = fold.absorb(
        SparseConstraintFamily::AllRows,
        round.valid,
        round.constraints,
        round.folded,
    )
    let linear = evaluate_sparse_linear_interaction_row<F, L>(
        challenge,
        linear_challenges,
        control,
        next_control,
        witness,
        arithmetic_plan,
        linear_plan,
        interaction.linear,
    )
    fold = fold.absorb(
        SparseConstraintFamily::AllRows,
        linear.valid,
        linear.constraints,
        linear.folded,
    )
    let boundary = evaluate_sparse_boundary_interaction_row<F, L>(
        challenge,
        boundary_challenges,
        control,
        witness,
        boundary_plan,
        interaction.boundary,
    )
    fold = fold.absorb(
        SparseConstraintFamily::AllRows,
        boundary.valid,
        boundary.constraints,
        boundary.folded,
    )

    fold = fold.absorb_fixed(
        SparseConstraintFamily::PairRows,
        evaluate_sparse_control_link<F, L>(
            challenge, control, next_control, control_link_plan,
        ),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::PairRows,
        evaluate_sparse_arithmetic_link(
            challenge,
            control,
            witness,
            next_control,
            next_witness,
            arithmetic_link_plan,
        ),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::PairRows,
        evaluate_sparse_product_interaction_link<F, L>(
            challenge,
            control,
            witness,
            interaction.product,
            next_interaction.product,
        ),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::PairRows,
        evaluate_sparse_round_interaction_link<F, L>(
            challenge,
            control,
            next_control,
            witness,
            round_plan,
            interaction.round,
            next_interaction.round,
        ),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::PairRows,
        evaluate_sparse_linear_interaction_link<F, L>(
            challenge,
            control,
            next_control,
            witness,
            arithmetic_plan,
            linear_plan,
            interaction.linear,
            next_interaction.linear,
        ),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::PairRows,
        evaluate_sparse_boundary_interaction_link<F, L>(
            challenge,
            control,
            witness,
            boundary_plan,
            interaction.boundary,
            next_interaction.boundary,
        ),
    )

    fold = fold.absorb_fixed(
        SparseConstraintFamily::FirstRow,
        evaluate_sparse_control_initial<F, L>(challenge, control),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::FirstRow,
        evaluate_sparse_arithmetic_initial(challenge, witness),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::FirstRow,
        evaluate_sparse_product_interaction_initial(
            challenge, interaction.product,
        ),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::FirstRow,
        evaluate_sparse_round_interaction_initial(
            challenge, interaction.round,
        ),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::FirstRow,
        evaluate_sparse_linear_interaction_initial(
            challenge, interaction.linear,
        ),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::FirstRow,
        evaluate_sparse_boundary_interaction_initial(
            challenge, interaction.boundary,
        ),
    )

    fold = fold.absorb_fixed(
        SparseConstraintFamily::LastRow,
        evaluate_sparse_control_terminal(challenge, control),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::LastRow,
        evaluate_sparse_product_interaction_terminal<F, L>(
            challenge, control, witness, interaction.product,
        ),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::LastRow,
        evaluate_sparse_round_interaction_terminal<F, L>(
            challenge,
            control,
            next_control,
            witness,
            round_plan,
            interaction.round,
        ),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::LastRow,
        evaluate_sparse_linear_interaction_terminal<F, L>(
            challenge,
            control,
            next_control,
            witness,
            arithmetic_plan,
            linear_plan,
            interaction.linear,
        ),
    )
    fold = fold.absorb_fixed(
        SparseConstraintFamily::LastRow,
        evaluate_sparse_boundary_interaction_terminal<F, L>(
            challenge,
            control,
            witness,
            boundary_plan,
            interaction.boundary,
        ),
    )
    fold
}

fn sparse_composition_fold_opened<const L: usize>(
    _ challenge: BabyBearExt4,
    _ interaction_challenges: SparseInteractionChallenges,
    _ row: ref SparseOpenedAirRow,
    _ next: ref SparseOpenedAirRow,
) -> SparseCompositionFold<BabyBearExt4>
where L > 1,
{
    sparse_composition_fold_fields<BabyBearExt4, L>(
        challenge,
        interaction_challenges.product,
        interaction_challenges.round,
        interaction_challenges.linear,
        interaction_challenges.boundary,
        row.base.control,
        next.base.control,
        row.base.control_plan,
        row.base.control_link_plan,
        row.base.witness,
        next.base.witness,
        row.base.arithmetic_plan,
        row.base.arithmetic_link_plan,
        row.base.round_plan,
        row.base.linear_plan,
        row.base.boundary_plan,
        row.interaction,
        next.interaction,
    )
}

pub fn sparse_constraint_numerators_opened<const L: usize>(
    _ challenge: BabyBearExt4,
    _ interaction_challenges: SparseInteractionChallenges,
    _ row: ref SparseOpenedAirRow,
    _ next: ref SparseOpenedAirRow,
) -> AirConstraintNumerators<BabyBearExt4>
where L > 1,
{
    sparse_composition_fold_opened<L>(
        challenge,
        interaction_challenges,
        row,
        next,
    ).numerators()
}

fn maximum_degree(_ left: u32, _ right: u32) -> u32 {
    if left > right { left } else { right }
}

fn quotient_degree_bound(
    _ trace_length: u32,
    _ expression_degree: u32,
    _ zerofier_degree: u32,
) -> u32 {
    if trace_length <= 1 || expression_degree == 0 { return 0 }
    let trace_degree = trace_length - 1
    if expression_degree > 4294967295 / trace_degree { return 4294967295 }
    let numerator = expression_degree * trace_degree
    if numerator > zerofier_degree {
        numerator - zerofier_degree
    } else {
        0
    }
}

/// Derive the maximum composition-polynomial degree after applying the four
/// trace zerofiers. This consumes the family-specific degrees because a
/// quadratic all-row relation and a quadratic boundary relation have very
/// different quotient bounds.
pub fn sparse_composition_degree_bound(
    _ shape: SparseAirConstraintShape,
    _ trace_length: u32,
) -> u32 {
    if !shape.valid || trace_length <= 1 { return 4294967295 }
    let all_rows = quotient_degree_bound(
        trace_length,
        shape.all_rows_degree,
        trace_length,
    )
    let pair_rows = quotient_degree_bound(
        trace_length,
        shape.pair_rows_degree,
        trace_length - 1,
    )
    let first_row = quotient_degree_bound(
        trace_length,
        shape.first_row_degree,
        1,
    )
    let last_row = quotient_degree_bound(
        trace_length,
        shape.last_row_degree,
        1,
    )
    maximum_degree(
        maximum_degree(all_rows, pair_rows),
        maximum_degree(first_row, last_row),
    )
}

/// Interpret the exact composition fold as structural counts and polynomial
/// degrees. Reflection fills every committed base and interaction column with
/// a degree-one symbolic variable, while challenges remain degree-zero
/// constants. The evaluator sequence is shared with ordinary BabyBear
/// execution, so no copied constraint table or field list is involved.
pub fn sparse_constraint_shape<const L: usize>() -> SparseAirConstraintShape
where L > 1,
{
    let mut base = zero_sparse_base_air_row_field<AirPolynomialDegree>()
    let base_source = base.decode(AirPolynomialVariableSource::new())
    let mut interaction =
        zero_sparse_interaction_trace_row_field<AirPolynomialDegree>()
    let interaction_source = interaction.decode(
        AirPolynomialVariableSource::new(),
    )
    let challenges = SparseCopyChallenges {
        beta: AirPolynomialDegree::constant(),
        gamma: AirPolynomialDegree::constant(),
    }
    let fold = sparse_composition_fold_fields<AirPolynomialDegree, L>(
        AirPolynomialDegree::constant(),
        challenges,
        challenges,
        challenges,
        challenges,
        base.control,
        base.control,
        base.control_plan,
        base.control_link_plan,
        base.witness,
        base.witness,
        base.arithmetic_plan,
        base.arithmetic_link_plan,
        base.round_plan,
        base.linear_plan,
        base.boundary_plan,
        interaction,
        interaction,
    )
    let all_rows_degree = fold.all_rows.degree
    let pair_rows_degree = fold.pair_rows.degree
    let first_row_degree = fold.first_row.degree
    let last_row_degree = fold.last_row.degree
    SparseAirConstraintShape {
        valid: fold.valid
            && base_source.valid
            && interaction_source.valid
            && base_source.cursor
                == <SparseBaseAirRow<AirPolynomialDegree>
                    as CanonicalWords>::WORDS
            && interaction_source.cursor
                == <SparseInteractionTraceRow<AirPolynomialDegree>
                    as CanonicalWords>::WORDS
            && fold.all_rows.valid
            && fold.pair_rows.valid
            && fold.first_row.valid
            && fold.last_row.valid,
        all_rows: fold.all_rows_constraints,
        pair_rows: fold.pair_rows_constraints,
        first_row: fold.first_row_constraints,
        last_row: fold.last_row_constraints,
        total: fold.all_rows_constraints
            + fold.pair_rows_constraints
            + fold.first_row_constraints
            + fold.last_row_constraints,
        all_rows_degree: all_rows_degree,
        pair_rows_degree: pair_rows_degree,
        first_row_degree: first_row_degree,
        last_row_degree: last_row_degree,
        maximum_degree: maximum_degree(
            maximum_degree(all_rows_degree, pair_rows_degree),
            maximum_degree(first_row_degree, last_row_degree),
        ),
    }
}

/// Interpret each production all-row evaluator separately. The ordinary
/// composition fold intentionally retains only the family maximum; this
/// companion keeps enough provenance to choose and gate the next lowering
/// target without maintaining a second constraint implementation.
pub fn sparse_all_rows_degree_shape<const L: usize>()
    -> SparseAirAllRowsDegreeShape
where L > 1,
{
    let mut base = zero_sparse_base_air_row_field<AirPolynomialDegree>()
    let base_source = base.decode(AirPolynomialVariableSource::new())
    let mut interaction =
        zero_sparse_interaction_trace_row_field<AirPolynomialDegree>()
    let interaction_source = interaction.decode(
        AirPolynomialVariableSource::new(),
    )
    let challenge = AirPolynomialDegree::constant()
    let challenges = SparseCopyChallenges {
        beta: AirPolynomialDegree::constant(),
        gamma: AirPolynomialDegree::constant(),
    }
    let control = evaluate_sparse_control_row(
        challenge,
        base.control,
        base.control_plan,
    )
    let arithmetic = evaluate_sparse_arithmetic_row<AirPolynomialDegree, L>(
        challenge,
        base.control,
        base.witness,
        base.arithmetic_plan,
    )
    let product = evaluate_sparse_product_interaction_row<
        AirPolynomialDegree,
        L,
    >(
        challenge,
        challenges,
        base.control,
        base.witness,
        interaction.product,
    )
    let round = evaluate_sparse_round_interaction_row<
        AirPolynomialDegree,
        L,
    >(
        challenge,
        challenges,
        base.control,
        base.control,
        base.witness,
        base.round_plan,
        interaction.round,
    )
    let linear = evaluate_sparse_linear_interaction_row<
        AirPolynomialDegree,
        L,
    >(
        challenge,
        challenges,
        base.control,
        base.control,
        base.witness,
        base.arithmetic_plan,
        base.linear_plan,
        interaction.linear,
    )
    let boundary = evaluate_sparse_boundary_interaction_row<
        AirPolynomialDegree,
        L,
    >(
        challenge,
        challenges,
        base.control,
        base.witness,
        base.boundary_plan,
        interaction.boundary,
    )
    let maximum = maximum_degree(
        maximum_degree(control.folded.degree, arithmetic.folded.degree),
        maximum_degree(
            maximum_degree(product.folded.degree, round.folded.degree),
            maximum_degree(linear.folded.degree, boundary.folded.degree),
        ),
    )
    SparseAirAllRowsDegreeShape {
        valid: base_source.valid
            && interaction_source.valid
            && base_source.cursor
                == <SparseBaseAirRow<AirPolynomialDegree>
                    as CanonicalWords>::WORDS
            && interaction_source.cursor
                == <SparseInteractionTraceRow<AirPolynomialDegree>
                    as CanonicalWords>::WORDS
            && control.valid && control.folded.valid
            && arithmetic.valid && arithmetic.folded.valid
            && product.valid && product.folded.valid
            && round.valid && round.folded.valid
            && linear.valid && linear.folded.valid
            && boundary.valid && boundary.folded.valid,
        control: control.folded.degree,
        arithmetic: arithmetic.folded.degree,
        product: product.folded.degree,
        round: round.folded.degree,
        linear: linear.folded.degree,
        boundary: boundary.folded.degree,
        maximum: maximum,
    }
}

/// Interpret each production pair-row evaluator separately. The same symbolic
/// current and next rows are decoded from the reflection-derived schemas, so
/// this report cannot drift into a parallel transition implementation.
pub fn sparse_pair_rows_degree_shape<const L: usize>()
    -> SparseAirPairRowsDegreeShape
where L > 1,
{
    let mut base = zero_sparse_base_air_row_field<AirPolynomialDegree>()
    let base_source = base.decode(AirPolynomialVariableSource::new())
    let mut next_base = zero_sparse_base_air_row_field<AirPolynomialDegree>()
    let next_base_source = next_base.decode(base_source)
    let mut interaction =
        zero_sparse_interaction_trace_row_field<AirPolynomialDegree>()
    let interaction_source = interaction.decode(next_base_source)
    let mut next_interaction =
        zero_sparse_interaction_trace_row_field<AirPolynomialDegree>()
    let next_interaction_source = next_interaction.decode(interaction_source)
    let challenge = AirPolynomialDegree::constant()
    let control = evaluate_sparse_control_link<AirPolynomialDegree, L>(
        challenge,
        base.control,
        next_base.control,
        base.control_link_plan,
    )
    let arithmetic = evaluate_sparse_arithmetic_link(
        challenge,
        base.control,
        base.witness,
        next_base.control,
        next_base.witness,
        base.arithmetic_link_plan,
    )
    let product = evaluate_sparse_product_interaction_link<
        AirPolynomialDegree,
        L,
    >(
        challenge,
        base.control,
        base.witness,
        interaction.product,
        next_interaction.product,
    )
    let round = evaluate_sparse_round_interaction_link<
        AirPolynomialDegree,
        L,
    >(
        challenge,
        base.control,
        next_base.control,
        base.witness,
        base.round_plan,
        interaction.round,
        next_interaction.round,
    )
    let linear = evaluate_sparse_linear_interaction_link<
        AirPolynomialDegree,
        L,
    >(
        challenge,
        base.control,
        next_base.control,
        base.witness,
        base.arithmetic_plan,
        base.linear_plan,
        interaction.linear,
        next_interaction.linear,
    )
    let boundary = evaluate_sparse_boundary_interaction_link<
        AirPolynomialDegree,
        L,
    >(
        challenge,
        base.control,
        base.witness,
        base.boundary_plan,
        interaction.boundary,
        next_interaction.boundary,
    )
    let maximum = maximum_degree(
        maximum_degree(control.folded.degree, arithmetic.folded.degree),
        maximum_degree(
            maximum_degree(product.folded.degree, round.folded.degree),
            maximum_degree(linear.folded.degree, boundary.folded.degree),
        ),
    )
    SparseAirPairRowsDegreeShape {
        valid: next_interaction_source.valid
            && next_interaction_source.cursor
                == <SparseBaseAirRow<AirPolynomialDegree>
                    as CanonicalWords>::WORDS * 2
                    + <SparseInteractionTraceRow<AirPolynomialDegree>
                        as CanonicalWords>::WORDS * 2
            && control.valid && control.folded.valid
            && arithmetic.valid && arithmetic.folded.valid
            && product.valid && product.folded.valid
            && round.valid && round.folded.valid
            && linear.valid && linear.folded.valid
            && boundary.valid && boundary.folded.valid,
        control: control.folded.degree,
        arithmetic: arithmetic.folded.degree,
        product: product.folded.degree,
        round: round.folded.degree,
        linear: linear.folded.degree,
        boundary: boundary.folded.degree,
        maximum: maximum,
    }
}

fn invalid_sparse_copy_port_degree_shape() -> SparseCopyPortDegreeShape {
    SparseCopyPortDegreeShape {
        valid: false,
        selector: 0,
        coefficient: 0,
        address: 0,
        value: 0,
        compressed: 0,
        inverse_relation: 0,
        delta: 0,
        maximum: 0,
    }
}

fn sparse_degree_copy_port() -> SparseCopyPort<AirPolynomialDegree> {
    let constant = AirPolynomialDegree::constant()
    SparseCopyPort {
        selector: constant,
        coefficient: constant,
        address: constant,
        value: constant,
    }
}

fn sparse_copy_port_degree_shape(
    _ port: SparseCopyPort<AirPolynomialDegree>,
    _ inverse: AirPolynomialDegree,
    _ schema_valid: bool,
) -> SparseCopyPortDegreeShape {
    let constant = AirPolynomialDegree::constant()
    let compressed = constant.radix2_add(
        port.address.radix2_add(constant.radix2_mul(port.value)),
    )
    let selected_inverse = compressed.radix2_mul(inverse).radix2_sub(
        port.selector,
    )
    let zero_inverse = constant.radix2_sub(port.selector).radix2_mul(inverse)
    let inverse_relation = selected_inverse.maximum(zero_inverse)
    let delta = port.coefficient.radix2_mul(inverse)
    let maximum = port.selector
        .maximum(port.coefficient)
        .maximum(port.address)
        .maximum(port.value)
        .maximum(compressed)
        .maximum(inverse_relation)
        .maximum(delta)
    SparseCopyPortDegreeShape {
        valid: schema_valid && maximum.valid,
        selector: port.selector.degree,
        coefficient: port.coefficient.degree,
        address: port.address.degree,
        value: port.value.degree,
        compressed: compressed.degree,
        inverse_relation: inverse_relation.degree,
        delta: delta.degree,
        maximum: maximum.degree,
    }
}

fn sparse_degree_rows_valid(
    _ base_source: AirPolynomialVariableSource,
    _ interaction_source: AirPolynomialVariableSource,
) -> bool {
    base_source.valid
        && interaction_source.valid
        && base_source.cursor
            == <SparseBaseAirRow<AirPolynomialDegree>
                as CanonicalWords>::WORDS
        && interaction_source.cursor
            == <SparseInteractionTraceRow<AirPolynomialDegree>
                as CanonicalWords>::WORDS
}

/// Attribute one of the five exact round copy ports by interpreting the
/// production port writer over the degree semiring.
pub fn sparse_round_port_degree_shape<const L: usize>(
    _ index: u32,
) -> SparseCopyPortDegreeShape
where L > 1,
{
    if index >= 5 { return invalid_sparse_copy_port_degree_shape() }
    let mut base = zero_sparse_base_air_row_field<AirPolynomialDegree>()
    let base_source = base.decode(AirPolynomialVariableSource::new())
    let mut interaction =
        zero_sparse_interaction_trace_row_field<AirPolynomialDegree>()
    let interaction_source = interaction.decode(
        AirPolynomialVariableSource::new(),
    )
    let mut ports = [sparse_degree_copy_port(); 5]
    write_sparse_round_interaction_ports<AirPolynomialDegree, L>(
        base.control,
        base.control,
        base.witness,
        mut ports,
    )
    sparse_copy_port_degree_shape(
        ports[index as usize],
        interaction.round.inverses[index as usize],
        sparse_degree_rows_valid(base_source, interaction_source),
    )
}

/// Attribute one of the eight exact signed-linear copy ports by interpreting
/// the production port writer over the degree semiring.
pub fn sparse_linear_port_degree_shape<const L: usize>(
    _ index: u32,
) -> SparseCopyPortDegreeShape
where L > 1,
{
    if index >= 8 { return invalid_sparse_copy_port_degree_shape() }
    let mut base = zero_sparse_base_air_row_field<AirPolynomialDegree>()
    let base_source = base.decode(AirPolynomialVariableSource::new())
    let mut interaction =
        zero_sparse_interaction_trace_row_field<AirPolynomialDegree>()
    let interaction_source = interaction.decode(
        AirPolynomialVariableSource::new(),
    )
    let mut ports = [sparse_degree_copy_port(); 8]
    write_sparse_linear_interaction_ports<AirPolynomialDegree, L>(
        base.control,
        base.control,
        base.witness,
        base.arithmetic_plan,
        mut ports,
    )
    sparse_copy_port_degree_shape(
        ports[index as usize],
        interaction.linear.inverses[index as usize],
        sparse_degree_rows_valid(base_source, interaction_source),
    )
}

/// Attribute one of the two exact public-boundary copy ports by interpreting
/// the production port writer over the degree semiring.
pub fn sparse_boundary_port_degree_shape<const L: usize>(
    _ index: u32,
) -> SparseCopyPortDegreeShape
where L > 1,
{
    if index >= 2 { return invalid_sparse_copy_port_degree_shape() }
    let mut base = zero_sparse_base_air_row_field<AirPolynomialDegree>()
    let base_source = base.decode(AirPolynomialVariableSource::new())
    let mut interaction =
        zero_sparse_interaction_trace_row_field<AirPolynomialDegree>()
    let interaction_source = interaction.decode(
        AirPolynomialVariableSource::new(),
    )
    let mut ports = [sparse_degree_copy_port(); 2]
    write_sparse_boundary_interaction_ports<AirPolynomialDegree, L>(
        base.control,
        base.witness,
        mut ports,
    )
    sparse_copy_port_degree_shape(
        ports[index as usize],
        interaction.boundary.inverses[index as usize],
        sparse_degree_rows_valid(base_source, interaction_source),
    )
}

/// Evaluate the complete sparse high-precision AIR composition at one opened
/// LDE point. All record traversal is derived from the nominal Fe types, and
/// all constraint arithmetic remains in the shared field-generic AIR core.
pub fn evaluate_sparse_composition_opened<
    const L: usize,
    const TRACE: usize,
>(
    _ point: BabyBearExt4,
    _ challenge: BabyBearExt4,
    _ interaction_challenges: SparseInteractionChallenges,
    _ row: ref SparseOpenedAirRow,
    _ next: ref SparseOpenedAirRow,
) -> AirCompositionValue<BabyBearExt4>
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
{
    if !interaction_challenges.valid || !row.valid || !next.valid {
        return AirCompositionValue {
            valid: false,
            value: BabyBearExt4::zero(),
        }
    }
    air_composition_value<BabyBearExt4, TRACE>(
        point,
        sparse_constraint_numerators_opened<L>(
            challenge, interaction_challenges, row, next,
        ),
    )
}

pub fn write_sparse_base_air_evaluation_trace<const N: usize>(
    _ rows: ref [SparseBaseAirRow<BabyBear>; N],
    _ output: mut SparseBaseAirEvaluationTrace<N>,
) -> bool
where N > 0,
{
    output.valid = false
    let mut row: usize = 0
    while row < N {
        let fields = sparse_base_air_fields(ref rows[row])
        if !fields.valid { return false }
        output.values[row] = fields.values
        row = row + 1
    }
    output.valid = true
    true
}

/// Place the base LDE before any interaction challenge is available. This is
/// intentionally separate from `write_sparse_air_lde`, whose combined form is
/// retained only for semantic checkpoint and small differential gates.
pub fn write_sparse_base_air_lde<
    const TRACE: usize,
    const LDE: usize,
>(
    _ trace: ref SparseBaseAirEvaluationTrace<TRACE>,
    _ shift: BabyBear,
    _ output: mut SparseBaseAirLdeCodeword<LDE>,
) -> bool
where
    TRACE > 0,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
    LDE > 0,
    LDE > TRACE,
    { (LDE & (LDE - 1)) == 0 },
    { radix2_field_domain_supported<LDE, BabyBear>() },
    { (LDE % TRACE) == 0 },
{
    output.valid = false
    if !trace.valid { return false }
    let zero = BabyBear::zero()
    let mut source = [zero; TRACE]
    let mut extended = [zero; LDE]
    let mut column: usize = 0
    while column < SPARSE_BASE_AIR_FIELDS {
        let mut row: usize = 0
        while row < TRACE {
            source[row] = trace.values[row][column]
            row = row + 1
        }
        if !write_radix2_coset_lde<TRACE, LDE, BabyBear>(
            ref source,
            shift,
            mut extended,
        ) {
            return false
        }
        row = 0
        while row < LDE {
            output.values[row][column] = extended[row]
            row = row + 1
        }
        column = column + 1
    }
    output.valid = true
    true
}

pub fn write_sparse_air_evaluation_trace<const N: usize>(
    _ base_rows: ref [SparseBaseAirRow<BabyBear>; N],
    _ interaction_rows: ref [SparseInteractionTraceRow<BabyBearExt4>; N],
    _ output: mut SparseAirEvaluationTrace<N>,
) -> bool
where N > 0,
{
    output.valid = false
    let mut row: usize = 0
    while row < N {
        let base = sparse_base_air_fields(ref base_rows[row])
        let interaction = sparse_interaction_air_fields(ref interaction_rows[row])
        if !base.valid || !interaction.valid { return false }
        output.base[row] = base.values
        output.interaction[row] = interaction.values
        row = row + 1
    }
    output.valid = true
    true
}

pub fn sparse_base_lde_leaf_commitment<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ leaf: SparseBaseLdeLeaf<L, TRACE, LDE>,
) -> Poseidon2Digest {
    sparse_base_lde_leaf_commitment_plan(
        QuadraticValueInterpreter::new(),
        leaf,
    ).digest()
}

pub const fn sparse_base_lde_leaf_commitment_permutations<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>() -> usize {
    canonical_commitment_permutations(
        <SparseBaseLdeLeaf<L, TRACE, LDE> as CanonicalWords>::WORDS,
    )
}

pub fn sparse_base_lde_leaf_commitment_plan<
    I: QuadraticPlanInterpreter<BabyBear>,
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ interpreter: I,
    _ leaf: SparseBaseLdeLeaf<L, TRACE, LDE>,
) -> Poseidon2CanonicalCommitmentPlan<I> {
    commit_canonical_plan<
        I,
        MandelbrotSparseBaseLdeLeafBabyBearV1,
        SparseBaseLdeLeaf<L, TRACE, LDE>,
    >(interpreter, ref leaf)
}

fn sparse_base_lde_leaf_at<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ index: u32,
    _ values: [BabyBear; SPARSE_BASE_AIR_FIELDS],
) -> SparseBaseLdeLeaf<L, TRACE, LDE> {
    SparseBaseLdeLeaf {
        limb_count: BabyBear::from_u32(L.downcast_truncate()),
        trace_length: BabyBear::from_u32(TRACE.downcast_truncate()),
        lde_length: BabyBear::from_u32(LDE.downcast_truncate()),
        index: BabyBear::from_u32(index),
        values: values,
    }
}

fn invalid_sparse_base_lde_digest<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>() -> SparseBaseLdeDigest<L, TRACE, LDE> {
    SparseBaseLdeDigest { valid: false, value: Poseidon2Digest::zero() }
}

/// Commit a complete base LDE before deriving any interaction challenge.
/// Every leaf absorbs its proof shape and position through one nominal Fe
/// record, while `merkle_core` supplies the backend-neutral tree reduction.
pub fn sparse_base_lde_root_power_of_two<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ codeword: ref SparseBaseAirLdeCodeword<LDE>,
) -> SparseBaseLdeDigest<L, TRACE, LDE>
where
    L > 1,
    TRACE > 0,
    { (TRACE & (TRACE - 1)) == 0 },
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    LDE <= 2147483648,
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
{
    if !codeword.valid {
        return invalid_sparse_base_lde_digest<L, TRACE, LDE>()
    }
    let mut frontier = empty_frontier<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_LDE_FRONTIER_LEVELS,
    >()
    let mut index: usize = 0
    while index < LDE {
        let leaf = sparse_base_lde_leaf_at<L, TRACE, LDE>(
            index.downcast_truncate(),
            codeword.values[index],
        )
        frontier = push_frontier<
            Poseidon2Digest,
            SparseDigestHasher,
            SPARSE_LDE_FRONTIER_LEVELS,
        >(frontier, sparse_base_lde_leaf_commitment(leaf))
        index = index + 1
    }
    let root = complete_frontier_root<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_LDE_FRONTIER_LEVELS,
    >(frontier)
    SparseBaseLdeDigest { valid: root.valid, value: root.value }
}

/// Interpret the same field-generic radix-2 plan once per FCO-derived column.
/// There is no authored column identifier or copied semantic field table.
pub fn write_sparse_air_lde<
    const TRACE: usize,
    const LDE: usize,
>(
    _ trace: ref SparseAirEvaluationTrace<TRACE>,
    _ shift: BabyBear,
    _ output: mut SparseAirLdeCodeword<LDE>,
) -> bool
where
    TRACE > 0,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
    LDE > 0,
    LDE > TRACE,
    { (LDE & (LDE - 1)) == 0 },
    { radix2_field_domain_supported<LDE, BabyBear>() },
    { (LDE % TRACE) == 0 },
{
    output.valid = false
    if !trace.valid { return false }
    let zero = BabyBear::zero()
    let mut source = [zero; TRACE]
    let mut extended = [zero; LDE]

    let mut column: usize = 0
    while column < SPARSE_BASE_AIR_FIELDS {
        let mut row: usize = 0
        while row < TRACE {
            source[row] = trace.base[row][column]
            row = row + 1
        }
        if !write_radix2_coset_lde<TRACE, LDE, BabyBear>(
            ref source,
            shift,
            mut extended,
        ) {
            return false
        }
        row = 0
        while row < LDE {
            output.base[row][column] = extended[row]
            row = row + 1
        }
        column = column + 1
    }

    column = 0
    while column < SPARSE_INTERACTION_AIR_FIELDS {
        let mut row: usize = 0
        while row < TRACE {
            source[row] = trace.interaction[row][column]
            row = row + 1
        }
        if !write_radix2_coset_lde<TRACE, LDE, BabyBear>(
            ref source,
            shift,
            mut extended,
        ) {
            return false
        }
        row = 0
        while row < LDE {
            output.interaction[row][column] = extended[row]
            row = row + 1
        }
        column = column + 1
    }
    output.valid = true
    true
}

pub fn write_sparse_interaction_air_evaluation_trace<const N: usize>(
    _ rows: ref [SparseInteractionTraceRow<BabyBearExt4>; N],
    _ output: mut SparseInteractionAirEvaluationTrace<N>,
) -> bool
where N > 0,
{
    output.valid = false
    let mut row: usize = 0
    while row < N {
        let fields = sparse_interaction_air_fields(ref rows[row])
        if !fields.valid { return false }
        output.values[row] = fields.values
        row = row + 1
    }
    output.valid = true
    true
}

pub fn write_sparse_interaction_air_lde<
    const TRACE: usize,
    const LDE: usize,
>(
    _ trace: ref SparseInteractionAirEvaluationTrace<TRACE>,
    _ shift: BabyBear,
    _ output: mut SparseInteractionAirLdeCodeword<LDE>,
) -> bool
where
    TRACE > 0,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
    LDE > 0,
    LDE > TRACE,
    { (LDE & (LDE - 1)) == 0 },
    { radix2_field_domain_supported<LDE, BabyBear>() },
    { (LDE % TRACE) == 0 },
{
    output.valid = false
    if !trace.valid { return false }
    let zero = BabyBear::zero()
    let mut source = [zero; TRACE]
    let mut extended = [zero; LDE]
    let mut column: usize = 0
    while column < SPARSE_INTERACTION_AIR_FIELDS {
        let mut row: usize = 0
        while row < TRACE {
            source[row] = trace.values[row][column]
            row = row + 1
        }
        if !write_radix2_coset_lde<TRACE, LDE, BabyBear>(
            ref source,
            shift,
            mut extended,
        ) {
            return false
        }
        row = 0
        while row < LDE {
            output.values[row][column] = extended[row]
            row = row + 1
        }
        column = column + 1
    }
    output.valid = true
    true
}

pub fn sparse_interaction_lde_leaf_commitment<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ leaf: SparseInteractionLdeLeaf<L, TRACE, LDE>,
) -> Poseidon2Digest {
    sparse_interaction_lde_leaf_commitment_plan(
        QuadraticValueInterpreter::new(),
        leaf,
    ).digest()
}

pub const fn sparse_interaction_lde_leaf_commitment_permutations<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>() -> usize {
    canonical_commitment_permutations(
        <SparseInteractionLdeLeaf<L, TRACE, LDE> as CanonicalWords>::WORDS,
    )
}

pub fn sparse_interaction_lde_leaf_commitment_plan<
    I: QuadraticPlanInterpreter<BabyBear>,
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ interpreter: I,
    _ leaf: SparseInteractionLdeLeaf<L, TRACE, LDE>,
) -> Poseidon2CanonicalCommitmentPlan<I> {
    commit_canonical_plan<
        I,
        MandelbrotSparseInteractionLdeLeafBabyBearV1,
        SparseInteractionLdeLeaf<L, TRACE, LDE>,
    >(interpreter, ref leaf)
}

fn sparse_interaction_lde_leaf_at<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ base: SparseBaseLdeDigest<L, TRACE, LDE>,
    _ index: u32,
    _ values: [BabyBear; SPARSE_INTERACTION_AIR_FIELDS],
) -> SparseInteractionLdeLeaf<L, TRACE, LDE> {
    SparseInteractionLdeLeaf {
        limb_count: BabyBear::from_u32(L.downcast_truncate()),
        trace_length: BabyBear::from_u32(TRACE.downcast_truncate()),
        lde_length: BabyBear::from_u32(LDE.downcast_truncate()),
        index: BabyBear::from_u32(index),
        base_lde_root: base.value,
        values: values,
    }
}

fn invalid_sparse_interaction_lde_digest<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ base: SparseBaseLdeDigest<L, TRACE, LDE>,
) -> SparseInteractionLdeDigest<L, TRACE, LDE> {
    SparseInteractionLdeDigest {
        valid: false,
        base: base,
        value: Poseidon2Digest::zero(),
    }
}

pub fn sparse_interaction_lde_root_power_of_two<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ base: SparseBaseLdeDigest<L, TRACE, LDE>,
    _ codeword: ref SparseInteractionAirLdeCodeword<LDE>,
) -> SparseInteractionLdeDigest<L, TRACE, LDE>
where
    L > 1,
    TRACE > 0,
    { (TRACE & (TRACE - 1)) == 0 },
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    LDE <= 2147483648,
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
{
    if !base.valid || !codeword.valid {
        return invalid_sparse_interaction_lde_digest(base)
    }
    let mut frontier = empty_frontier<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_LDE_FRONTIER_LEVELS,
    >()
    let mut index: usize = 0
    while index < LDE {
        let leaf = sparse_interaction_lde_leaf_at<L, TRACE, LDE>(
            base,
            index.downcast_truncate(),
            codeword.values[index],
        )
        frontier = push_frontier<
            Poseidon2Digest,
            SparseDigestHasher,
            SPARSE_LDE_FRONTIER_LEVELS,
        >(frontier, sparse_interaction_lde_leaf_commitment(leaf))
        index = index + 1
    }
    let root = complete_frontier_root<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_LDE_FRONTIER_LEVELS,
    >(frontier)
    SparseInteractionLdeDigest {
        valid: root.valid,
        base: base,
        value: root.value,
    }
}

fn invalid_sparse_air_lde_transcript<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ statement: RecursiveCommittedInterval<L>,
    _ base: SparseBaseLdeDigest<L, TRACE, LDE>,
    _ interaction: SparseInteractionLdeDigest<L, TRACE, LDE>,
) -> SparseAirLdeTranscriptDigest<L, TRACE, LDE> {
    SparseAirLdeTranscriptDigest {
        valid: false,
        statement: statement,
        base: base,
        interaction: interaction,
        transcript: AirLdeTranscriptDigest {
            valid: false,
            value: Poseidon2Digest::zero(),
        },
    }
}

/// Bind the exact one-step recursive statement and both production LDE roots
/// into the shared BabyBear AIR transcript. The interaction root must retain
/// this exact base root; matching only its shape is insufficient.
pub struct SparseAirLdeTranscriptPlan<
    I: QuadraticPlanInterpreter<BabyBear>,
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> {
    pub interpreter: I,
    pub value: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
}
impl<
    I: QuadraticPlanInterpreter<BabyBear>,
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> core::marker::Copy for SparseAirLdeTranscriptPlan<I, L, TRACE, LDE> {}

pub const fn sparse_air_lde_transcript_permutations<const L: usize>() -> usize {
    canonical_commitment_permutations(
        <RecursiveCommittedInterval<L> as CanonicalWords>::WORDS,
    ) + BINDING_PERMUTATIONS + BINDING_PERMUTATIONS
}

pub fn bind_sparse_air_lde_transcript_plan<
    I: QuadraticPlanInterpreter<BabyBear>,
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ statement: RecursiveCommittedInterval<L>,
    _ base: SparseBaseLdeDigest<L, TRACE, LDE>,
    _ interaction: SparseInteractionLdeDigest<L, TRACE, LDE>,
    _ interpreter: I,
) -> SparseAirLdeTranscriptPlan<I, L, TRACE, LDE> {
    let statement_valid = statement.valid
        && statement.leaves == 1
        && statement.statement.valid
        && statement.start.valid
        && statement.end.valid
        && statement.start_iteration < statement.end_iteration
        && statement.end_iteration - statement.start_iteration == 1
    let roots_valid = base.valid
        && interaction.valid
        && interaction.base.valid
        && interaction.base.value.equals(base.value)
    let statement_commitment = commit_canonical_plan<
        I,
        MandelbrotSparseLeafStatementBabyBearV1,
        RecursiveCommittedInterval<L>,
    >(interpreter, ref statement)
    let roots = poseidon_bind_plan<
        I,
        MandelbrotSparseAirRootsBabyBearV1,
    >(
        statement_commitment.interpreter,
        base.value,
        interaction.value,
    )
    let transcript = poseidon_bind_plan<
        I,
        MandelbrotSparseAirTranscriptBabyBearV1,
    >(
        roots.interpreter,
        statement_commitment.digest(),
        roots.value,
    )
    if !statement_valid || !roots_valid || !statement_commitment.is_valid() {
        return SparseAirLdeTranscriptPlan {
            interpreter: transcript.interpreter,
            value: invalid_sparse_air_lde_transcript(statement, base, interaction),
        }
    }
    SparseAirLdeTranscriptPlan {
        interpreter: transcript.interpreter,
        value: SparseAirLdeTranscriptDigest {
            valid: true,
            statement: statement,
            base: base,
            interaction: interaction,
            transcript: AirLdeTranscriptDigest {
                valid: true,
                value: transcript.value,
            },
        },
    }
}

pub fn bind_sparse_air_lde_transcript<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ statement: RecursiveCommittedInterval<L>,
    _ base: SparseBaseLdeDigest<L, TRACE, LDE>,
    _ interaction: SparseInteractionLdeDigest<L, TRACE, LDE>,
) -> SparseAirLdeTranscriptDigest<L, TRACE, LDE> {
    bind_sparse_air_lde_transcript_plan<QuadraticValueInterpreter, L, TRACE, LDE>(
        statement,
        base,
        interaction,
        QuadraticValueInterpreter::new(),
    ).value
}

fn recursive_committed_interval_equals<const L: usize>(
    _ left: RecursiveCommittedInterval<L>,
    _ right: RecursiveCommittedInterval<L>,
) -> bool {
    left.valid == right.valid
        && left.leaves == right.leaves
        && left.statement.valid == right.statement.valid
        && left.statement.value.equals(right.statement.value)
        && left.start_iteration == right.start_iteration
        && left.end_iteration == right.end_iteration
        && left.start.valid == right.start.valid
        && left.start.value.equals(right.start.value)
        && left.end.valid == right.end.valid
        && left.end.value.equals(right.end.value)
}

fn sparse_air_lde_transcript_equals<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ left: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
    _ right: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
) -> bool {
    left.valid == right.valid
        && recursive_committed_interval_equals(left.statement, right.statement)
        && left.base.valid == right.base.valid
        && left.base.value.equals(right.base.value)
        && left.interaction.valid == right.interaction.valid
        && left.interaction.base.valid == right.interaction.base.valid
        && left.interaction.base.value.equals(right.interaction.base.value)
        && left.interaction.value.equals(right.interaction.value)
        && left.transcript.valid == right.transcript.valid
        && left.transcript.value.equals(right.transcript.value)
}

fn sparse_air_lde_transcript_is_canonical<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
) -> bool {
    let rebound = bind_sparse_air_lde_transcript(
        air.statement,
        air.base,
        air.interaction,
    )
    air.valid && air.transcript.valid && rebound.valid
        && sparse_air_lde_transcript_equals(air, rebound)
}

fn invalid_sparse_composition_transcript<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
) -> SparseCompositionTranscriptDigest<L, TRACE, LDE> {
    SparseCompositionTranscriptDigest {
        valid: false,
        air: air,
        transcript: AirLdeTranscriptDigest {
            valid: false,
            value: Poseidon2Digest::zero(),
        },
    }
}

/// Lift the canonical AIR transcript into the composition stage without an
/// extension. Existing scalar checkpoints use this identity interpretation.
pub fn sparse_composition_transcript<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
) -> SparseCompositionTranscriptDigest<L, TRACE, LDE> {
    if !sparse_air_lde_transcript_is_canonical(air) {
        return invalid_sparse_composition_transcript(air)
    }
    SparseCompositionTranscriptDigest {
        valid: true,
        air: air,
        transcript: air.transcript,
    }
}

/// Extend a canonical AIR transcript with one valid typed commitment. The
/// nominal field domain is selected by the protocol at compile time, and the
/// base statement and roots remain attached for later composition checks.
pub struct SparseCompositionTranscriptPlan<
    I: QuadraticPlanInterpreter<BabyBear>,
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> {
    pub interpreter: I,
    pub value: SparseCompositionTranscriptDigest<L, TRACE, LDE>,
}
impl<
    I: QuadraticPlanInterpreter<BabyBear>,
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
> core::marker::Copy for SparseCompositionTranscriptPlan<I, L, TRACE, LDE> {}

pub fn bind_sparse_composition_extension_plan<
    I: QuadraticPlanInterpreter<BabyBear>,
    D: Poseidon2FieldDomain,
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
    _ extension: PackedCommitment,
    _ interpreter: I,
) -> SparseCompositionTranscriptPlan<I, L, TRACE, LDE> {
    let valid = sparse_air_lde_transcript_is_canonical(air)
        && extension.is_valid()
    let transcript = poseidon_bind_plan<I, D>(
        interpreter,
        air.transcript.value,
        extension.digest(),
    )
    if !valid {
        return SparseCompositionTranscriptPlan {
            interpreter: transcript.interpreter,
            value: invalid_sparse_composition_transcript(air),
        }
    }
    SparseCompositionTranscriptPlan {
        interpreter: transcript.interpreter,
        value: SparseCompositionTranscriptDigest {
            valid: true,
            air: air,
            transcript: AirLdeTranscriptDigest {
                valid: true,
                value: transcript.value,
            },
        },
    }
}

pub fn bind_sparse_composition_extension<
    D: Poseidon2FieldDomain,
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
    _ extension: PackedCommitment,
) -> SparseCompositionTranscriptDigest<L, TRACE, LDE> {
    bind_sparse_composition_extension_plan<
        QuadraticValueInterpreter,
        D,
        L,
        TRACE,
        LDE,
    >(air, extension, QuadraticValueInterpreter::new()).value
}

fn sparse_public_fixed_at<const L: usize>(
    _ interval: OrbitInterval<L>,
    _ coordinate: SparsePublicCoordinate,
) -> Fixed<L> {
    match coordinate {
        SparsePublicCoordinate::PointReal => interval.claim.point.real,
        SparsePublicCoordinate::PointImaginary => interval.claim.point.imaginary,
        SparsePublicCoordinate::CurrentReal => interval.start.z.real,
        SparsePublicCoordinate::CurrentImaginary => interval.start.z.imaginary,
        SparsePublicCoordinate::NextReal => interval.end.z.real,
        SparsePublicCoordinate::NextImaginary => interval.end.z.imaginary,
        SparsePublicCoordinate::Invalid => Fixed::zero(),
    }
}

/// Derive public-constraint folding and mixing challenges from the same bound
/// AIR transcript used by the ordinary composition challenge. Both values are
/// required to be nonzero because zero would erase later public constraints or
/// the entire public contribution.
fn sparse_public_constraint_challenges_from_transcript(
    _ transcript: AirLdeTranscriptDigest,
) -> SparsePublicConstraintChallenges {
    if !transcript.valid {
        return SparsePublicConstraintChallenges {
            valid: false,
            fold: BabyBearExt4::zero(),
            mix: BabyBearExt4::zero(),
        }
    }
    let fold = squeeze_ext4<MandelbrotSparsePublicConstraintBabyBearV1>(
        transcript.value,
    )
    let mix = squeeze_ext4<MandelbrotSparsePublicMixBabyBearV1>(
        transcript.value,
    )
    SparsePublicConstraintChallenges {
        valid: !fold.is_zero() && !mix.is_zero(),
        fold: fold,
        mix: mix,
    }
}

pub fn sparse_public_constraint_challenges<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
) -> SparsePublicConstraintChallenges {
    if !air.valid {
        return SparsePublicConstraintChallenges {
            valid: false,
            fold: BabyBearExt4::zero(),
            mix: BabyBearExt4::zero(),
        }
    }
    sparse_public_constraint_challenges_from_transcript(air.transcript)
}

fn sparse_public_inputs_match_air<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
    _ interval: OrbitInterval<L>,
) -> bool
where
    Limbs<L>: TruncRows<Limbs<L>> + Mac + ShiftAppend + Head + Carry
              + Zero + SubBorrow + Select + Top + OrLower
              + core::marker::Copy,
{
    let statement = commit_recursive_leaf_statement(interval)
    sparse_air_lde_transcript_is_canonical(air)
        && recursive_committed_interval_equals(statement, air.statement)
}

fn sparse_public_composition_at<
    const L: usize,
    const TRACE: usize,
>(
    _ interval: OrbitInterval<L>,
    _ challenges: SparsePublicConstraintChallenges,
    _ point: BabyBearExt4,
    _ row: ref SparseOpenedAirRow,
) -> AirCompositionValue<BabyBearExt4>
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
{
    let zero: BabyBearExt4 = BabyBearExt4::zero()
    let trace_length: u32 = TRACE.downcast_truncate()
    let limb_count: u32 = L.downcast_truncate()
    if !challenges.valid
        || !row.valid
        || trace_length != sparse_transition_trace_length<L>()
        || !sparse_public_positions_follow_task_plan<L>()
        || point.pow_u32(trace_length).equals(BabyBearExt4::one())
    {
        return AirCompositionValue { valid: false, value: zero }
    }
    let trace_root: BabyBear = BabyBear::two_adic_root(radix2_log<TRACE>())
    let mut folded: BabyBearExt4 = zero
    let mut power: BabyBearExt4 = BabyBearExt4::one()
    let mut absorbed: u32 = 0
    let mut coordinate_index: u32 = 0
    while coordinate_index < sparse_public_coordinate_count() {
        let coordinate: SparsePublicCoordinate =
            sparse_public_coordinate_at(coordinate_index)
        let public_value: Fixed<L> = sparse_public_fixed_at(interval, coordinate)
        let mut limb: u32 = 0
        while limb < limb_count {
            let trace_row: u32 = sparse_public_limb_trace_row<L>(coordinate, limb)
            if trace_row >= trace_length {
                return AirCompositionValue { valid: false, value: zero }
            }
            let trace_point: BabyBearExt4 = BabyBearExt4::from_base(
                trace_root.pow_u32(trace_row),
            )
            let denominator: BabyBearExt4 = point - trace_point
            if denominator.is_zero() {
                return AirCompositionValue { valid: false, value: zero }
            }
            let expected: BabyBearExt4 = BabyBearExt4::from_base(
                BabyBear::from_u32(public_value.limbs[limb as usize]),
            )
            folded = folded
                + power
                    * (row.base.witness.value - expected)
                    * denominator.inverse_or_zero()
            power = power * challenges.fold
            absorbed = absorbed + 1
            limb = limb + 1
        }
        let sign_row: u32 = sparse_public_sign_trace_row<L>(coordinate)
        if sign_row >= trace_length {
            return AirCompositionValue { valid: false, value: zero }
        }
        let sign_point: BabyBearExt4 = BabyBearExt4::from_base(
            trace_root.pow_u32(sign_row),
        )
        let sign_denominator: BabyBearExt4 = point - sign_point
        if sign_denominator.is_zero() {
            return AirCompositionValue { valid: false, value: zero }
        }
        let expected_sign_base: BabyBear = if public_value.negative {
            BabyBear::one()
        } else {
            BabyBear::zero()
        }
        let expected_sign: BabyBearExt4 =
            BabyBearExt4::from_base(expected_sign_base)
        folded = folded
            + power
                * (row.base.witness.auxiliary - expected_sign)
                * sign_denominator.inverse_or_zero()
        power = power * challenges.fold
        absorbed = absorbed + 1
        coordinate_index = coordinate_index + 1
    }
    AirCompositionValue {
        valid: absorbed == sparse_public_constraint_count<L>(),
        value: folded * challenges.mix,
    }
}

/// Evaluate the fixed-position public-input contribution at one authenticated
/// LDE opening. The raw interval is recommitted and compared with the exact
/// transcript statement before any rational constraint is accepted.
pub fn evaluate_sparse_public_composition_opened<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
    _ interval: OrbitInterval<L>,
    _ point: BabyBearExt4,
    _ row: ref SparseOpenedAirRow,
) -> AirCompositionValue<BabyBearExt4>
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
    LDE > TRACE,
    { (LDE & (LDE - 1)) == 0 },
    Limbs<L>: TruncRows<Limbs<L>> + Mac + ShiftAppend + Head + Carry
              + Zero + SubBorrow + Select + Top + OrLower
              + core::marker::Copy,
{
    if !sparse_public_inputs_match_air(air, interval) {
        return AirCompositionValue {
            valid: false,
            value: BabyBearExt4::zero(),
        }
    }
    sparse_public_composition_at<L, TRACE>(
        interval,
        sparse_public_constraint_challenges(air),
        point,
        row,
    )
}

fn evaluate_sparse_bound_public_composition_opened<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ composition: SparseCompositionTranscriptDigest<L, TRACE, LDE>,
    _ interval: OrbitInterval<L>,
    _ point: BabyBearExt4,
    _ row: ref SparseOpenedAirRow,
) -> AirCompositionValue<BabyBearExt4>
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
    LDE > TRACE,
    { (LDE & (LDE - 1)) == 0 },
    Limbs<L>: TruncRows<Limbs<L>> + Mac + ShiftAppend + Head + Carry
              + Zero + SubBorrow + Select + Top + OrLower
              + core::marker::Copy,
{
    if !composition.is_valid()
        || !sparse_public_inputs_match_air(composition.air, interval) {
        return AirCompositionValue {
            valid: false,
            value: BabyBearExt4::zero(),
        }
    }
    sparse_public_composition_at<L, TRACE>(
        interval,
        sparse_public_constraint_challenges_from_transcript(
            composition.transcript,
        ),
        point,
        row,
    )
}

/// Recompute the exact production composition at one opened LDE point. This
/// is the verifier counterpart of `write_sparse_composition_air_codeword`:
/// the internal sparse AIR and the public fixed-position relation use the
/// same transcript and are added before comparison with an opened BC02 value.
pub fn evaluate_sparse_bound_composition_opened<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ composition: SparseCompositionTranscriptDigest<L, TRACE, LDE>,
    _ interval: OrbitInterval<L>,
    _ point: BabyBearExt4,
    _ row: ref SparseOpenedAirRow,
    _ next: ref SparseOpenedAirRow,
) -> AirCompositionValue<BabyBearExt4>
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
    LDE > 1,
    LDE > TRACE,
    { (LDE & (LDE - 1)) == 0 },
    Limbs<L>: TruncRows<Limbs<L>> + Mac + ShiftAppend + Head + Carry
              + Zero + SubBorrow + Select + Top + OrLower
              + core::marker::Copy,
{
    let challenge = composition_challenge(composition.transcript)
    let interactions = sparse_lde_interaction_challenges(composition.air.base)
    let internal = evaluate_sparse_composition_opened<L, TRACE>(
        point,
        challenge.value,
        interactions.value,
        row,
        next,
    )
    let public = evaluate_sparse_bound_public_composition_opened<L, TRACE, LDE>(
        composition,
        interval,
        point,
        row,
    )
    AirCompositionValue {
        valid: challenge.valid && internal.valid && public.valid,
        value: internal.value + public.value,
    }
}

/// Evaluate the sparse constraint numerators using only interaction challenges
/// derived from this exact base-LDE root. This keeps the semantic audit entry
/// point from accepting a raw checkpoint challenge set.
pub fn sparse_lde_constraint_numerators_opened<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ challenge: BabyBearExt4,
    _ base: SparseBaseLdeDigest<L, TRACE, LDE>,
    _ row: ref SparseOpenedAirRow,
    _ next: ref SparseOpenedAirRow,
) -> AirConstraintNumerators<BabyBearExt4>
where L > 1, TRACE > 0, LDE > TRACE,
{
    let zero = BabyBearExt4::zero()
    if !base.valid {
        return AirConstraintNumerators {
            all_rows: zero,
            pair_rows: zero,
            first_row: zero,
            last_row: zero,
        }
    }
    sparse_constraint_numerators_opened<L>(
        challenge,
        sparse_lde_interaction_challenges(base).value,
        row,
        next,
    )
}

/// Produce the internal sparse-AIR quotient from the exact committed inputs.
/// Public fixed-position constraints are deliberately added only by the
/// production wrapper below.
fn write_sparse_bound_internal_composition_air_codeword<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ composition: SparseCompositionTranscriptDigest<L, TRACE, LDE>,
    _ base_codeword: ref SparseBaseAirLdeCodeword<LDE>,
    _ interaction_codeword: ref SparseInteractionAirLdeCodeword<LDE>,
    _ shift: BabyBear,
    _ output: mut SparseCompositionAirCodeword<LDE>,
) -> bool
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
    LDE > 0,
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    LDE <= 2147483648,
    { (LDE & (LDE - 1)) == 0 },
    { radix2_field_domain_supported<LDE, BabyBear>() },
    { (LDE % TRACE) == 0 },
{
    output.valid = false
    if !composition.is_valid()
        || !base_codeword.valid
        || !interaction_codeword.valid
        || shift.is_zero()
        || shift.pow_u32(TRACE.downcast_truncate()).equals(BabyBear::one())
    {
        return false
    }
    let challenge: CompositionChallenge =
        composition_challenge(composition.transcript)
    if !challenge.valid { return false }
    let interaction_challenges =
        sparse_lde_interaction_challenges(composition.air.base).value
    let root = BabyBear::two_adic_root(radix2_log<LDE>())
    let stride: usize = LDE / TRACE
    let mut index: usize = 0
    while index < LDE {
        let mut next_index = index + stride
        if next_index >= LDE { next_index = next_index - LDE }
        let row = sparse_opened_air_row(
            base_codeword.values[index],
            interaction_codeword.values[index],
        )
        let next = sparse_opened_air_row(
            base_codeword.values[next_index],
            interaction_codeword.values[next_index],
        )
        let point = BabyBearExt4::from_base(
            shift * root.pow_u32(index.downcast_truncate()),
        )
        let value = evaluate_sparse_composition_opened<L, TRACE>(
            point,
            challenge.value,
            interaction_challenges,
            ref row,
            ref next,
        )
        if !value.valid { return false }
        output.values[index] = value.value
        index = index + 1
    }
    output.valid = true
    true
}

fn write_sparse_internal_composition_air_codeword<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ statement: RecursiveCommittedInterval<L>,
    _ base_codeword: ref SparseBaseAirLdeCodeword<LDE>,
    _ interaction_codeword: ref SparseInteractionAirLdeCodeword<LDE>,
    _ shift: BabyBear,
    _ output: mut SparseCompositionAirCodeword<LDE>,
) -> SparseAirLdeTranscriptDigest<L, TRACE, LDE>
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
    LDE > 0,
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    LDE <= 2147483648,
    { (LDE & (LDE - 1)) == 0 },
    { radix2_field_domain_supported<LDE, BabyBear>() },
    { (LDE % TRACE) == 0 },
{
    output.valid = false
    let base = sparse_base_lde_root_power_of_two<L, TRACE, LDE>(base_codeword)
    let interaction = sparse_interaction_lde_root_power_of_two<L, TRACE, LDE>(
        base,
        interaction_codeword,
    )
    let transcript = bind_sparse_air_lde_transcript(
        statement,
        base,
        interaction,
    )
    let composition = sparse_composition_transcript(transcript)
    if !write_sparse_bound_internal_composition_air_codeword<
        L,
        TRACE,
        LDE,
    >(
        composition,
        base_codeword,
        interaction_codeword,
        shift,
        mut output,
    ) {
        return invalid_sparse_air_lde_transcript(statement, base, interaction)
    }
    transcript
}

/// Small placement checkpoint for independent scalar oracles. This evaluates
/// the complete internal AIR but intentionally omits fixed-position public
/// constraints because its four-row trace cannot contain the generated sparse
/// transition plan. It must never be accepted as a recursive leaf receipt.
pub fn write_sparse_composition_checkpoint_air_codeword<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ statement: RecursiveCommittedInterval<L>,
    _ base_codeword: ref SparseBaseAirLdeCodeword<LDE>,
    _ interaction_codeword: ref SparseInteractionAirLdeCodeword<LDE>,
    _ shift: BabyBear,
    _ output: mut SparseCompositionAirCodeword<LDE>,
) -> SparseAirLdeTranscriptDigest<L, TRACE, LDE>
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
    LDE > 0,
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    LDE <= 2147483648,
    { (LDE & (LDE - 1)) == 0 },
    { radix2_field_domain_supported<LDE, BabyBear>() },
    { (LDE % TRACE) == 0 },
{
    write_sparse_internal_composition_air_codeword<L, TRACE, LDE>(
        statement,
        base_codeword,
        interaction_codeword,
        shift,
        mut output,
    )
}

fn add_sparse_bound_public_composition<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ interval: OrbitInterval<L>,
    _ composition: SparseCompositionTranscriptDigest<L, TRACE, LDE>,
    _ base_codeword: ref SparseBaseAirLdeCodeword<LDE>,
    _ interaction_codeword: ref SparseInteractionAirLdeCodeword<LDE>,
    _ shift: BabyBear,
    _ output: mut SparseCompositionAirCodeword<LDE>,
) -> bool
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
    LDE > 0,
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    LDE <= 2147483648,
    { (LDE & (LDE - 1)) == 0 },
    { radix2_field_domain_supported<LDE, BabyBear>() },
    { (LDE % TRACE) == 0 },
    Limbs<L>: TruncRows<Limbs<L>> + Mac + ShiftAppend + Head + Carry
              + Zero + SubBorrow + Select + Top + OrLower
              + core::marker::Copy,
{
    let challenges = sparse_public_constraint_challenges_from_transcript(
        composition.transcript,
    )
    let trace_length: u32 = TRACE.downcast_truncate()
    if !composition.is_valid()
        || !sparse_public_inputs_match_air(composition.air, interval)
        || !challenges.valid
        || trace_length != sparse_transition_trace_length<L>()
        || !sparse_public_positions_follow_task_plan<L>()
    {
        output.valid = false
        return false
    }
    let root = BabyBear::two_adic_root(radix2_log<LDE>())
    let mut index: usize = 0
    while index < LDE {
        let row = sparse_opened_air_row(
            base_codeword.values[index],
            interaction_codeword.values[index],
        )
        let point = BabyBearExt4::from_base(
            shift * root.pow_u32(index.downcast_truncate()),
        )
        let public = sparse_public_composition_at<L, TRACE>(
            interval,
            challenges,
            point,
            ref row,
        )
        if !public.valid {
            output.valid = false
            return false
        }
        output.values[index] = output.values[index] + public.value
        index = index + 1
    }
    true
}

/// Production sparse composition from an already authenticated extension of
/// the canonical AIR transcript. The writer rederives both codeword roots and
/// requires exact equality with the retained base transcript before using the
/// extension's challenges.
pub fn write_sparse_bound_composition_air_codeword<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ interval: OrbitInterval<L>,
    _ composition: SparseCompositionTranscriptDigest<L, TRACE, LDE>,
    _ base_codeword: ref SparseBaseAirLdeCodeword<LDE>,
    _ interaction_codeword: ref SparseInteractionAirLdeCodeword<LDE>,
    _ shift: BabyBear,
    _ output: mut SparseCompositionAirCodeword<LDE>,
) -> SparseCompositionTranscriptDigest<L, TRACE, LDE>
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
    LDE > 0,
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    LDE <= 2147483648,
    { (LDE & (LDE - 1)) == 0 },
    { radix2_field_domain_supported<LDE, BabyBear>() },
    { (LDE % TRACE) == 0 },
    Limbs<L>: TruncRows<Limbs<L>> + Mac + ShiftAppend + Head + Carry
              + Zero + SubBorrow + Select + Top + OrLower
              + core::marker::Copy,
{
    output.valid = false
    let base = sparse_base_lde_root_power_of_two<L, TRACE, LDE>(base_codeword)
    let interaction = sparse_interaction_lde_root_power_of_two<L, TRACE, LDE>(
        base,
        interaction_codeword,
    )
    let actual = bind_sparse_air_lde_transcript(
        composition.air.statement,
        base,
        interaction,
    )
    if !composition.is_valid()
        || !actual.valid
        || !sparse_air_lde_transcript_equals(composition.air, actual)
        || !write_sparse_bound_internal_composition_air_codeword<
            L,
            TRACE,
            LDE,
        >(
            composition,
            base_codeword,
            interaction_codeword,
            shift,
            mut output,
        )
        || !add_sparse_bound_public_composition<L, TRACE, LDE>(
            interval,
            composition,
            base_codeword,
            interaction_codeword,
            shift,
            mut output,
        )
    {
        output.valid = false
        return invalid_sparse_composition_transcript(composition.air)
    }
    output.valid = true
    composition
}

/// Production sparse composition. The raw public interval is committed into
/// the transcript and every fixed-point limb and sign is constrained at the
/// semantic row derived by the sparse task plan. The internal AIR and public
/// rational terms then share one BC02 codeword and one FRI path.
pub fn write_sparse_composition_air_codeword<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ interval: OrbitInterval<L>,
    _ base_codeword: ref SparseBaseAirLdeCodeword<LDE>,
    _ interaction_codeword: ref SparseInteractionAirLdeCodeword<LDE>,
    _ shift: BabyBear,
    _ output: mut SparseCompositionAirCodeword<LDE>,
) -> SparseAirLdeTranscriptDigest<L, TRACE, LDE>
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    { radix2_field_domain_supported<TRACE, BabyBear>() },
    LDE > 0,
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    LDE <= 2147483648,
    { (LDE & (LDE - 1)) == 0 },
    { radix2_field_domain_supported<LDE, BabyBear>() },
    { (LDE % TRACE) == 0 },
    Limbs<L>: TruncRows<Limbs<L>> + Mac + ShiftAppend + Head + Carry
              + Zero + SubBorrow + Select + Top + OrLower
              + core::marker::Copy,
{
    let statement = commit_recursive_leaf_statement(interval)
    let air = write_sparse_internal_composition_air_codeword<L, TRACE, LDE>(
        statement,
        base_codeword,
        interaction_codeword,
        shift,
        mut output,
    )
    let composition = sparse_composition_transcript(air)
    if !add_sparse_bound_public_composition<L, TRACE, LDE>(
        interval,
        composition,
        base_codeword,
        interaction_codeword,
        shift,
        mut output,
    ) {
        return invalid_sparse_air_lde_transcript(
            statement,
            air.base,
            air.interaction,
        )
    }
    output.valid = true
    air
}

fn sparse_composition_lde_root_for_air<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
    _ codeword: ref SparseCompositionAirCodeword<LDE>,
) -> SparseCompositionLdeDigest<L, TRACE, LDE>
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    LDE > 0,
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    { (LDE & (LDE - 1)) == 0 },
{
    let invalid = CompositionDigest {
        valid: false,
        value: Poseidon2Digest::zero(),
    }
    if !air.valid || !codeword.valid {
        return SparseCompositionLdeDigest {
            valid: false,
            air: air,
            value: invalid,
        }
    }
    let mut frontier = empty_frontier<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_LDE_FRONTIER_LEVELS,
    >()
    let mut index: usize = 0
    while index < LDE {
        let leaf = composition_row_commitment(codeword.values[index])
        if !leaf.valid {
            return SparseCompositionLdeDigest {
                valid: false,
                air: air,
                value: invalid,
            }
        }
        frontier = push_frontier<
            Poseidon2Digest,
            SparseDigestHasher,
            SPARSE_LDE_FRONTIER_LEVELS,
        >(frontier, leaf.value)
        index = index + 1
    }
    let committed = complete_frontier_root<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_LDE_FRONTIER_LEVELS,
    >(frontier)
    let root = CompositionDigest {
        valid: committed.valid,
        value: committed.value,
    }
    SparseCompositionLdeDigest {
        valid: root.valid,
        air: air,
        value: root,
    }
}

pub fn sparse_composition_lde_root_power_of_two<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ air: SparseAirLdeTranscriptDigest<L, TRACE, LDE>,
    _ codeword: ref SparseCompositionAirCodeword<LDE>,
) -> SparseCompositionLdeDigest<L, TRACE, LDE>
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    LDE > 0,
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    { (LDE & (LDE - 1)) == 0 },
{
    sparse_composition_lde_root_for_air<L, TRACE, LDE>(air, codeword)
}

/// Commit a composition codeword only under the exact authenticated extension
/// that supplied its challenges. The root carrier retains the canonical base
/// AIR transcript, while the caller continues the extended transcript.
pub fn sparse_bound_composition_lde_root_power_of_two<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ composition: SparseCompositionTranscriptDigest<L, TRACE, LDE>,
    _ codeword: ref SparseCompositionAirCodeword<LDE>,
) -> SparseCompositionLdeDigest<L, TRACE, LDE>
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    LDE > 0,
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    { (LDE & (LDE - 1)) == 0 },
{
    if !composition.is_valid() {
        return SparseCompositionLdeDigest {
            valid: false,
            air: composition.air,
            value: CompositionDigest {
                valid: false,
                value: Poseidon2Digest::zero(),
            },
        }
    }
    sparse_composition_lde_root_for_air<L, TRACE, LDE>(
        composition.air,
        codeword,
    )
}

/// Sequential state of the four log-derivative copy buses.
pub struct SparseInteractionAccumulators {
    pub product: BabyBearExt4,
    pub round: BabyBearExt4,
    pub linear: BabyBearExt4,
    pub boundary: BabyBearExt4,
}
impl core::marker::Copy for SparseInteractionAccumulators {}
derive CanonicalWords for SparseInteractionAccumulators using CanonicalWordsProvider

/// Reusable row-local inverse storage for one interaction-plan placement.
pub struct SparseInteractionScratch {
    pub product: SparseProductInteractionRow<BabyBearExt4>,
    pub round: SparseCopyInteractionRow<BabyBearExt4, 5>,
    pub linear: SparseCopyInteractionRow<BabyBearExt4, 8>,
    pub boundary: SparseCopyInteractionRow<BabyBearExt4, 2>,
}
impl core::marker::Copy for SparseInteractionScratch {}

pub fn zero_sparse_interaction_trace_row()
    -> SparseInteractionTraceRow<BabyBearExt4> {
    zero_sparse_interaction_trace_row_field<BabyBearExt4>()
}

pub fn zero_sparse_interaction_accumulators() -> SparseInteractionAccumulators {
    let zero = BabyBearExt4::zero()
    SparseInteractionAccumulators {
        product: zero,
        round: zero,
        linear: zero,
        boundary: zero,
    }
}

pub fn zero_sparse_interaction_scratch() -> SparseInteractionScratch {
    let zero = BabyBearExt4::zero()
    SparseInteractionScratch {
        product: zero_sparse_product_interaction_row<BabyBearExt4>(),
        round: SparseCopyInteractionRow {
            accumulator: zero,
            inverses: [zero; 5],
        },
        linear: SparseCopyInteractionRow {
            accumulator: zero,
            inverses: [zero; 8],
        },
        boundary: SparseCopyInteractionRow {
            accumulator: zero,
            inverses: [zero; 2],
        },
    }
}

/// One nominal interaction-trace leaf. The base root is absorbed in every
/// leaf, making the transcript dependency explicit and preventing an
/// interaction path from being replayed against a different base trace.
pub struct SparseInteractionTraceLeaf<const L: usize> {
    pub limb_count: BabyBear,
    pub task_count: BabyBear,
    pub trace_length: BabyBear,
    pub index: BabyBear,
    pub active: BabyBear,
    pub base_root: Poseidon2Digest,
    pub row: SparseInteractionTraceRow<BabyBearExt4>,
}
impl<const L: usize> core::marker::Copy for SparseInteractionTraceLeaf<L> {}
derive CanonicalWords for SparseInteractionTraceLeaf<L> using CanonicalWordsProvider

/// Limb-branded interaction commitment paired with the exact base commitment
/// from which its quartic challenges were derived.
pub struct SparseInteractionTraceDigest<const L: usize> {
    pub valid: bool,
    pub base: SparseTraceDigest<L>,
    pub value: Poseidon2Digest,
}
impl<const L: usize> core::marker::Copy for SparseInteractionTraceDigest<L> {}
derive CanonicalWords for SparseInteractionTraceDigest<L> using CanonicalWordsProvider

/// Roots emitted while materializing base and interaction evaluations on the
/// original trace subgroup. The potentially large row tables stay in
/// caller-owned arrays and never cross a function boundary as one aggregate.
pub struct SparseAirTraceDigest<const L: usize> {
    pub valid: bool,
    pub base: SparseTraceDigest<L>,
    pub interaction: SparseInteractionTraceDigest<L>,
}
impl<const L: usize> core::marker::Copy for SparseAirTraceDigest<L> {}

pub fn sparse_interaction_challenges<const L: usize>(
    _ root: SparseTraceDigest<L>,
) -> SparseInteractionChallenges {
    if !root.valid {
        let zero = BabyBearExt4::zero()
        let challenges = SparseCopyChallenges { beta: zero, gamma: zero }
        return SparseInteractionChallenges {
            valid: false,
            product: challenges,
            round: challenges,
            linear: challenges,
            boundary: challenges,
        }
    }
    SparseInteractionChallenges {
        valid: true,
        product: SparseCopyChallenges {
            beta: squeeze_ext4<MandelbrotSparseProductBetaBabyBearV1>(root.value),
            gamma: squeeze_ext4<MandelbrotSparseProductGammaBabyBearV1>(root.value),
        },
        round: SparseCopyChallenges {
            beta: squeeze_ext4<MandelbrotSparseRoundBetaBabyBearV1>(root.value),
            gamma: squeeze_ext4<MandelbrotSparseRoundGammaBabyBearV1>(root.value),
        },
        linear: SparseCopyChallenges {
            beta: squeeze_ext4<MandelbrotSparseLinearBetaBabyBearV1>(root.value),
            gamma: squeeze_ext4<MandelbrotSparseLinearGammaBabyBearV1>(root.value),
        },
        boundary: SparseCopyChallenges {
            beta: squeeze_ext4<MandelbrotSparseBoundaryBetaBabyBearV1>(root.value),
            gamma: squeeze_ext4<MandelbrotSparseBoundaryGammaBabyBearV1>(root.value),
        },
    }
}

/// Production interaction challenges are sampled only after the base LDE
/// commitment is fixed. The distinct `*02` domains prevent a raw-trace
/// checkpoint from being substituted at this protocol boundary.
pub fn sparse_lde_interaction_challenges<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ root: SparseBaseLdeDigest<L, TRACE, LDE>,
) -> SparseLdeInteractionChallenges<L, TRACE, LDE> {
    if !root.valid {
        let zero = BabyBearExt4::zero()
        let challenges = SparseCopyChallenges { beta: zero, gamma: zero }
        return SparseLdeInteractionChallenges {
            value: SparseInteractionChallenges {
                valid: false,
                product: challenges,
                round: challenges,
                linear: challenges,
                boundary: challenges,
            },
        }
    }
    SparseLdeInteractionChallenges {
        value: SparseInteractionChallenges {
            valid: true,
            product: SparseCopyChallenges {
                beta: squeeze_ext4<MandelbrotSparseLdeProductBetaBabyBearV1>(
                    root.value,
                ),
                gamma: squeeze_ext4<MandelbrotSparseLdeProductGammaBabyBearV1>(
                    root.value,
                ),
            },
            round: SparseCopyChallenges {
                beta: squeeze_ext4<MandelbrotSparseLdeRoundBetaBabyBearV1>(
                    root.value,
                ),
                gamma: squeeze_ext4<MandelbrotSparseLdeRoundGammaBabyBearV1>(
                    root.value,
                ),
            },
            linear: SparseCopyChallenges {
                beta: squeeze_ext4<MandelbrotSparseLdeLinearBetaBabyBearV1>(
                    root.value,
                ),
                gamma: squeeze_ext4<MandelbrotSparseLdeLinearGammaBabyBearV1>(
                    root.value,
                ),
            },
            boundary: SparseCopyChallenges {
                beta: squeeze_ext4<MandelbrotSparseLdeBoundaryBetaBabyBearV1>(
                    root.value,
                ),
                gamma: squeeze_ext4<MandelbrotSparseLdeBoundaryGammaBabyBearV1>(
                    root.value,
                ),
            },
        },
    }
}

pub fn sparse_interaction_trace_leaf_commitment<const L: usize>(
    _ leaf: SparseInteractionTraceLeaf<L>,
) -> Poseidon2Digest {
    commit_canonical<
        MandelbrotSparseInteractionLeafBabyBearV1,
        SparseInteractionTraceLeaf<L>,
    >(ref leaf).digest()
}

fn invalid_sparse_interaction_trace_digest<const L: usize>(
    _ base: SparseTraceDigest<L>,
) -> SparseInteractionTraceDigest<L> {
    SparseInteractionTraceDigest {
        valid: false,
        base: base,
        value: Poseidon2Digest::zero(),
    }
}

/// Interpret one row of the interaction dependency plan into caller-owned
/// state. Keeping this boundary row-local lets scalar Wasm reclaim all
/// temporary quartic values after the step, while packed and GPU placements
/// can interpret the same control and port expressions.
pub fn write_sparse_interaction_air_row<const L: usize>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
    _ challenges: SparseInteractionChallenges,
    _ position: u32,
    _ accumulators: mut SparseInteractionAccumulators,
    _ scratch: mut SparseInteractionScratch,
    _ interaction: mut SparseInteractionTraceRow<BabyBearExt4>,
) -> bool
where L > 1,
{
    let control = sparse_control_row_at<BabyBearExt4, L>(position)
    let next_control = sparse_control_row_at<BabyBearExt4, L>(position + 1)
    let row = sparse_transition_row_from_witness<BabyBearExt4, L>(
        position,
        point,
        current,
        next,
        witness,
    )

    write_sparse_product_interaction_row<BabyBearExt4, L>(
        challenges.product,
        control,
        row,
        accumulators.product,
        mut scratch.product,
    )
    write_sparse_round_interaction_row<BabyBearExt4, L>(
        challenges.round,
        control,
        next_control,
        row,
        accumulators.round,
        mut scratch.round,
    )
    write_sparse_linear_interaction_row<BabyBearExt4, L>(
        challenges.linear,
        control,
        next_control,
        row,
        accumulators.linear,
        mut scratch.linear,
    )
    write_sparse_boundary_interaction_row<BabyBearExt4, L>(
        challenges.boundary,
        control,
        row,
        accumulators.boundary,
        mut scratch.boundary,
    )

    let local_challenge = BabyBearExt4::one()
    let local_arithmetic_plan = sparse_arithmetic_plan_witness(control, row)
    let local_linear_plan = sparse_linear_plan_witness<BabyBearExt4, L>(
        control,
        next_control,
        row,
        local_arithmetic_plan,
    )
    let product_evaluation = evaluate_sparse_product_interaction_row<
        BabyBearExt4,
        L,
    >(local_challenge, challenges.product, control, row, scratch.product)
    let round_evaluation = evaluate_sparse_round_interaction_row<
        BabyBearExt4,
        L,
    >(
        local_challenge,
        challenges.round,
        control,
        next_control,
        row,
        sparse_round_plan_witness<BabyBearExt4, L>(
            control,
            next_control,
            row,
        ),
        scratch.round,
    )
    let linear_evaluation = evaluate_sparse_linear_interaction_row<
        BabyBearExt4,
        L,
    >(
        local_challenge,
        challenges.linear,
        control,
        next_control,
        row,
        local_arithmetic_plan,
        local_linear_plan,
        scratch.linear,
    )
    let boundary_evaluation = evaluate_sparse_boundary_interaction_row<
        BabyBearExt4,
        L,
    >(
        local_challenge,
        challenges.boundary,
        control,
        row,
        sparse_boundary_plan_witness<BabyBearExt4, L>(control, row),
        scratch.boundary,
    )
    if !product_evaluation.valid || !product_evaluation.folded.is_zero()
        || !round_evaluation.valid || !round_evaluation.folded.is_zero()
        || !linear_evaluation.valid || !linear_evaluation.folded.is_zero()
        || !boundary_evaluation.valid || !boundary_evaluation.folded.is_zero() {
        return false
    }

    interaction = SparseInteractionTraceRow {
        product: scratch.product,
        round: scratch.round,
        linear: scratch.linear,
        boundary: scratch.boundary,
    }
    accumulators.product = accumulators.product + product_evaluation.delta
    accumulators.round = accumulators.round + round_evaluation.delta
    accumulators.linear = accumulators.linear + linear_evaluation.delta
    accumulators.boundary = accumulators.boundary + boundary_evaluation.delta
    true
}

fn write_sparse_interaction_air_rows_with_challenges<
    const L: usize,
    const N: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
    _ challenges: SparseInteractionChallenges,
    _ start: u32,
    _ accumulators: mut SparseInteractionAccumulators,
    _ rows: mut [SparseInteractionTraceRow<BabyBearExt4>; N],
) -> bool
where
    L > 1,
    N > 0,
    N <= MAX_SPARSE_TRACE_LENGTH,
{
    let trace_length = sparse_transition_trace_length<L>()
    let count: u32 = N.downcast_truncate()
    if !challenges.valid
        || start > trace_length
        || count > trace_length - start {
        return false
    }
    let mut scratch = zero_sparse_interaction_scratch()
    let mut interaction = zero_sparse_interaction_trace_row()
    let mut index: usize = 0
    while index < N {
        if !write_sparse_interaction_air_row<L>(
            point,
            current,
            next,
            witness,
            challenges,
            start + index.downcast_truncate(),
            mut accumulators,
            mut scratch,
            mut interaction,
        ) {
            return false
        }
        rows[index] = interaction
        index = index + 1
    }
    true
}

/// Place a semantic-checkpoint interaction tile derived from the raw `SL03`
/// root. Production proof code must use the LDE-branded entry below.
pub fn write_sparse_interaction_air_rows<
    const L: usize,
    const N: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
    _ base: SparseTraceDigest<L>,
    _ start: u32,
    _ accumulators: mut SparseInteractionAccumulators,
    _ rows: mut [SparseInteractionTraceRow<BabyBearExt4>; N],
) -> bool
where
    L > 1,
    N > 0,
    N <= MAX_SPARSE_TRACE_LENGTH,
{
    write_sparse_interaction_air_rows_with_challenges<L, N>(
        point,
        current,
        next,
        witness,
        sparse_interaction_challenges(base),
        start,
        mut accumulators,
        mut rows,
    )
}

/// Place a production interaction tile. The private payload of `challenges`
/// proves that its eight quartic values were derived after the branded base
/// LDE commitment, not repackaged from a raw semantic checkpoint.
pub fn write_sparse_lde_interaction_air_rows<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const N: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
    _ challenges: SparseLdeInteractionChallenges<L, TRACE, LDE>,
    _ start: u32,
    _ accumulators: mut SparseInteractionAccumulators,
    _ rows: mut [SparseInteractionTraceRow<BabyBearExt4>; N],
) -> bool
where
    L > 1,
    TRACE > 0,
    LDE > 1,
    LDE > TRACE,
    N > 0,
    N <= MAX_SPARSE_TRACE_LENGTH,
{
    write_sparse_interaction_air_rows_with_challenges<L, N>(
        point,
        current,
        next,
        witness,
        challenges.value,
        start,
        mut accumulators,
        mut rows,
    )
}

fn write_sparse_interaction_trace_step<const L: usize>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
    _ challenges: SparseInteractionChallenges,
    _ base_root: Poseidon2Digest,
    _ tasks: u32,
    _ trace_length: u32,
    _ position: u32,
    _ accumulators: mut SparseInteractionAccumulators,
    _ scratch: mut SparseInteractionScratch,
    _ interaction: mut SparseInteractionTraceRow<BabyBearExt4>,
    _ commitment: mut Poseidon2Digest,
) -> bool
where L > 1,
{
    if !write_sparse_interaction_air_row<L>(
        point,
        current,
        next,
        witness,
        challenges,
        position,
        mut accumulators,
        mut scratch,
        mut interaction,
    ) {
        return false
    }
    let leaf = SparseInteractionTraceLeaf<L> {
        limb_count: BabyBear::from_u32(L.downcast_truncate()),
        task_count: BabyBear::from_u32(tasks),
        trace_length: BabyBear::from_u32(trace_length),
        index: BabyBear::from_u32(position),
        active: BabyBear::from_u32(if position < tasks { 1 } else { 0 }),
        base_root: base_root,
        row: interaction,
    }
    commitment = sparse_interaction_trace_leaf_commitment(leaf)
    true
}

/// Generate and commit the quartic interaction trace for one already
/// committed sparse base trace. The base root alone supplies all copy-bus
/// challenges. Each row is produced by the same Fe port expressions consumed
/// by the AIR, checked locally, and accumulated before the next row is built.
pub fn sparse_interaction_trace_root_power_of_two<
    const L: usize,
    const N: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
    _ base: SparseTraceDigest<L>,
) -> SparseInteractionTraceDigest<L>
where
    L > 1,
    N > 1,
    N <= MAX_SPARSE_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
{
    let trace_length: u32 = N.downcast_truncate()
    let challenges = sparse_interaction_challenges(base)
    if trace_length != sparse_transition_trace_length<L>()
        || !base.valid
        || !challenges.valid {
        return invalid_sparse_interaction_trace_digest(base)
    }

    let mut frontier = empty_frontier<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_TRACE_FRONTIER_LEVELS,
    >()
    let mut accumulators = zero_sparse_interaction_accumulators()
    let tasks = sparse_transition_task_count<L>()
    let mut scratch = zero_sparse_interaction_scratch()
    let mut interaction = zero_sparse_interaction_trace_row()
    let mut commitment = Poseidon2Digest::zero()

    let mut index: usize = 0
    while index < N {
        let position: u32 = index.downcast_truncate()
        if !write_sparse_interaction_trace_step<L>(
            point,
            current,
            next,
            witness,
            challenges,
            base.value,
            tasks,
            trace_length,
            position,
            mut accumulators,
            mut scratch,
            mut interaction,
            mut commitment,
        ) {
            return invalid_sparse_interaction_trace_digest(base)
        }
        frontier = push_frontier<
            Poseidon2Digest,
            SparseDigestHasher,
            SPARSE_TRACE_FRONTIER_LEVELS,
        >(frontier, commitment)
        index = index + 1
    }

    if !accumulators.product.is_zero()
        || !accumulators.round.is_zero()
        || !accumulators.linear.is_zero()
        || !accumulators.boundary.is_zero() {
        return invalid_sparse_interaction_trace_digest(base)
    }
    let root = complete_frontier_root<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_TRACE_FRONTIER_LEVELS,
    >(frontier)
    SparseInteractionTraceDigest {
        valid: root.valid,
        base: base,
        value: root.value,
    }
}

/// Materialize both authenticated trace tables in caller-owned storage. The
/// base pass must precede the interaction pass because its `SL03` root is the
/// Fiat-Shamir source for every quartic copy challenge. No host witness or
/// column-number vocabulary enters this boundary.
pub fn write_sparse_air_trace_power_of_two<
    const L: usize,
    const N: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
    _ base_rows: mut [SparseBaseAirRow<BabyBear>; N],
    _ interaction_rows: mut [SparseInteractionTraceRow<BabyBearExt4>; N],
    _ output: mut SparseAirTraceDigest<L>,
) -> bool
where
    L > 1,
    N > 0,
    N > 1,
    N <= MAX_SPARSE_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
{
    output = empty_sparse_air_trace_digest<L>()
    let trace_length: u32 = N.downcast_truncate()
    if trace_length != sparse_transition_trace_length<L>() { return false }
    let tasks = sparse_transition_task_count<L>()

    let mut base_frontier = empty_frontier<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_TRACE_FRONTIER_LEVELS,
    >()
    let mut index: usize = 0
    while index < N {
        let position: u32 = index.downcast_truncate()
        let leaf = sparse_trace_leaf_from_witness<L>(
            position, point, current, next, witness,
        )
        let next_control = sparse_control_row_at<BabyBear, L>(position + 1)
        let arithmetic_plan = sparse_arithmetic_plan_witness(
            leaf.control,
            leaf.row,
        )
        let next_row = sparse_transition_row_from_witness<BabyBear, L>(
            position + 1,
            point,
            current,
            next,
            witness,
        )
        base_rows[index] = SparseBaseAirRow {
            control: leaf.control,
            control_plan: sparse_control_plan_witness(leaf.control),
            control_link_plan: sparse_control_link_plan_witness(
                leaf.control,
                next_control,
            ),
            witness: leaf.row,
            arithmetic_plan: arithmetic_plan,
            arithmetic_link_plan: sparse_arithmetic_link_plan_witness(
                leaf.control,
                leaf.row,
                next_control,
                next_row,
            ),
            round_plan: sparse_round_plan_witness<BabyBear, L>(
                leaf.control,
                next_control,
                leaf.row,
            ),
            linear_plan: sparse_linear_plan_witness<BabyBear, L>(
                leaf.control,
                next_control,
                leaf.row,
                arithmetic_plan,
            ),
            boundary_plan: sparse_boundary_plan_witness<
                BabyBear,
                L,
            >(leaf.control, leaf.row),
        }
        base_frontier = push_frontier<
            Poseidon2Digest,
            SparseDigestHasher,
            SPARSE_TRACE_FRONTIER_LEVELS,
        >(base_frontier, sparse_trace_leaf_commitment(leaf))
        index = index + 1
    }
    let base_root = complete_frontier_root<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_TRACE_FRONTIER_LEVELS,
    >(base_frontier)
    if !base_root.valid { return false }
    let base = SparseTraceDigest<L> {
        valid: true,
        value: base_root.value,
    }
    let mut interaction_frontier = empty_frontier<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_TRACE_FRONTIER_LEVELS,
    >()
    let mut accumulators = zero_sparse_interaction_accumulators()
    if !write_sparse_interaction_air_rows<L, N>(
        point,
        current,
        next,
        witness,
        base,
        0,
        mut accumulators,
        mut interaction_rows,
    ) {
        return false
    }
    index = 0
    while index < N {
        let position: u32 = index.downcast_truncate()
        let leaf = SparseInteractionTraceLeaf<L> {
            limb_count: BabyBear::from_u32(L.downcast_truncate()),
            task_count: BabyBear::from_u32(tasks),
            trace_length: BabyBear::from_u32(trace_length),
            index: BabyBear::from_u32(position),
            active: BabyBear::from_u32(if position < tasks { 1 } else { 0 }),
            base_root: base.value,
            row: interaction_rows[index],
        }
        interaction_frontier = push_frontier<
            Poseidon2Digest,
            SparseDigestHasher,
            SPARSE_TRACE_FRONTIER_LEVELS,
        >(interaction_frontier, sparse_interaction_trace_leaf_commitment(leaf))
        index = index + 1
    }
    if !accumulators.product.is_zero()
        || !accumulators.round.is_zero()
        || !accumulators.linear.is_zero()
        || !accumulators.boundary.is_zero() {
        return false
    }
    let interaction_root = complete_frontier_root<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_TRACE_FRONTIER_LEVELS,
    >(interaction_frontier)
    if !interaction_root.valid { return false }
    output.base = base
    output.interaction = SparseInteractionTraceDigest {
        valid: true,
        base: base,
        value: interaction_root.value,
    }
    output.valid = true
    true
}

pub struct SparseTraceTreeRole<const L: usize> {}

/// Canonical variable-size opening for sorted, deduplicated sparse leaves.
pub type SparseTraceMultiOpening<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> = MerkleMultiOpening<
    SparseTraceTreeRole<L>,
    SparseTraceLeaf<L>,
    Poseidon2Digest,
    MAX_LEAVES,
    MAX_SIBLINGS,
>

/// One complete base-trace authentication carrier. The root and sparse path
/// are produced by the same Merkle traversal, eliminating duplicate hashing
/// in scalar interpreters while leaving room for a retained GPU tree later.
pub struct SparseTraceAuthentication<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> {
    pub valid: bool,
    pub root: SparseTraceDigest<L>,
    pub opening: SparseTraceMultiOpening<L, MAX_LEAVES, MAX_SIBLINGS>,
}
impl<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> core::marker::Copy for SparseTraceAuthentication<L, MAX_LEAVES, MAX_SIBLINGS> {}
derive CanonicalWordStream for SparseTraceAuthentication<
    L,
    MAX_LEAVES,
    MAX_SIBLINGS,
> using CanonicalWordStreamProvider

struct SparseDigestHasher {}

impl TwoToOneHasher<Poseidon2Digest> for SparseDigestHasher {
    fn zero() -> Poseidon2Digest { Poseidon2Digest::zero() }

    fn equal(_ left: Poseidon2Digest, _ right: Poseidon2Digest) -> bool {
        left.equals(right)
    }

    fn hash2(_ left: Poseidon2Digest, _ right: Poseidon2Digest) -> Poseidon2Digest {
        poseidon_compress(left, right)
    }
}

fn zero_sparse_trace_row_field<F: Radix2Field>() -> SparseTaskRow<F> {
    let zero = F::radix2_zero()
    SparseTaskRow {
        value: zero,
        auxiliary: zero,
        accumulator_before: zero,
        accumulator_after: zero,
        state_before: zero,
        state_after: zero,
    }
}

fn zero_sparse_trace_control_field<F: Radix2Field>() -> SparseControlRow<F> {
    let zero = F::radix2_zero()
    SparseControlRow {
        selectors: SparseControlSelectors {
            radix_bit: zero,
            radix_limb: zero,
            radix_finish: zero,
            carry_bit: zero,
            carry_finish: zero,
            product_term: zero,
            product_coefficient: zero,
            product_round: zero,
            product_finish: zero,
            linear_limb: zero,
            linear_finish: zero,
            boundary_sign: zero,
            boundary_limb: zero,
            transition_finish: zero,
            padding: zero,
        },
        linear_roles: SparseLinearRoleSelectors {
            sum: zero,
            left_difference: zero,
            right_difference: zero,
            select: zero,
        },
        range_roles: SparseRangeRoleSelectors {
            coordinate: zero,
            point_coordinate: zero,
            current_coordinate: zero,
            next_coordinate: zero,
            product_low: zero,
            product_high: zero,
            product_output: zero,
            linear_sum: zero,
            linear_left_difference: zero,
            linear_right_difference: zero,
            linear_output: zero,
        },
        limb_positions: SparseLimbPositionSelectors {
            penultimate: zero,
            last: zero,
        },
        major: zero,
        minor: zero,
        step: zero,
        flag: zero,
        width: zero,
        weight: zero,
    }
}

fn zero_sparse_base_air_row_field<F: Radix2Field>() -> SparseBaseAirRow<F> {
    SparseBaseAirRow {
        control: zero_sparse_trace_control_field<F>(),
        control_plan: zero_sparse_control_plan_witness<F>(),
        control_link_plan: zero_sparse_control_link_plan_witness<F>(),
        witness: zero_sparse_trace_row_field<F>(),
        arithmetic_plan: zero_sparse_arithmetic_plan_witness<F>(),
        arithmetic_link_plan: zero_sparse_arithmetic_link_plan_witness<F>(),
        round_plan: zero_sparse_round_plan_witness<F>(),
        linear_plan: zero_sparse_linear_plan_witness<F>(),
        boundary_plan: zero_sparse_boundary_plan_witness<F>(),
    }
}

fn zero_sparse_interaction_trace_row_field<F: Radix2Field>()
    -> SparseInteractionTraceRow<F> {
    let zero = F::radix2_zero()
    SparseInteractionTraceRow {
        product: zero_sparse_product_interaction_row<F>(),
        round: SparseCopyInteractionRow {
            accumulator: zero,
            inverses: [zero; 5],
        },
        linear: SparseCopyInteractionRow {
            accumulator: zero,
            inverses: [zero; 8],
        },
        boundary: SparseCopyInteractionRow {
            accumulator: zero,
            inverses: [zero; 2],
        },
    }
}

fn zero_sparse_trace_row() -> SparseTraceRow {
    zero_sparse_trace_row_field<BabyBear>()
}

fn zero_sparse_trace_control() -> SparseTraceControl {
    zero_sparse_trace_control_field<BabyBear>()
}

pub fn zero_sparse_base_air_row() -> SparseBaseAirRow<BabyBear> {
    zero_sparse_base_air_row_field<BabyBear>()
}

fn sparse_trace_control_at<const L: usize>(_ index: u32) -> SparseTraceControl {
    sparse_control_row_at<BabyBear, L>(index)
}

pub fn zero_sparse_trace_leaf<const L: usize>() -> SparseTraceLeaf<L> {
    SparseTraceLeaf {
        limb_count: BabyBear::zero(),
        task_count: BabyBear::zero(),
        trace_length: BabyBear::zero(),
        index: BabyBear::zero(),
        active: BabyBear::zero(),
        control: zero_sparse_trace_control(),
        row: zero_sparse_trace_row(),
    }
}

fn invalid_sparse_multi_path<
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>() -> MerkleMultiPath<Poseidon2Digest, MAX_LEAVES, MAX_SIBLINGS> {
    MerkleMultiPath {
        valid: false,
        leaf_count: 0,
        leaf_indices: [0; MAX_LEAVES],
        sibling_count: 0,
        siblings: [Poseidon2Digest::zero(); MAX_SIBLINGS],
    }
}

fn reset_sparse_multi_path<const MAX_LEAVES: usize, const MAX_SIBLINGS: usize>(
    _ path: mut MerkleMultiPath<Poseidon2Digest, MAX_LEAVES, MAX_SIBLINGS>,
) {
    path.valid = false
    path.leaf_count = 0
    path.sibling_count = 0
    let mut cursor: usize = 0
    while cursor < MAX_LEAVES {
        path.leaf_indices[cursor] = 0
        cursor = cursor + 1
    }
    cursor = 0
    while cursor < MAX_SIBLINGS {
        path.siblings[cursor] = Poseidon2Digest::zero()
        cursor = cursor + 1
    }
}

fn write_sparse_multi_path_from_browser_leaves<
    const N: usize,
    const REQUESTS: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ requested: ref [u32; REQUESTS],
    _ path: mut MerkleMultiPath<Poseidon2Digest, MAX_LEAVES, MAX_SIBLINGS>,
) -> bool
uses (leaves: mut MerkleLeafArena<Poseidon2Digest, N>)
where
    N > 1,
    N <= MAX_SPARSE_LDE_LENGTH,
    N <= 2147483648,
    {
        (N & (N - 1)) == 0
    },
    REQUESTS > 0,
    MAX_LEAVES > 0
{
    write_browser_multi_path<
        Poseidon2Digest,
        SparseDigestHasher,
        N,
        REQUESTS,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(ref leaves.values, requested, mut path, mut leaves.root)
}

pub fn empty_sparse_trace_multi_opening<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>() -> SparseTraceMultiOpening<L, MAX_LEAVES, MAX_SIBLINGS> {
    MerkleMultiOpening {
        valid: false,
        values: [zero_sparse_trace_leaf<L>(); MAX_LEAVES],
        path: invalid_sparse_multi_path<MAX_LEAVES, MAX_SIBLINGS>(),
    }
}

pub fn empty_sparse_trace_authentication<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>() -> SparseTraceAuthentication<L, MAX_LEAVES, MAX_SIBLINGS> {
    SparseTraceAuthentication {
        valid: false,
        root: invalid_sparse_trace_digest<L>(),
        opening: empty_sparse_trace_multi_opening<L, MAX_LEAVES, MAX_SIBLINGS>(),
    }
}

fn invalid_sparse_trace_digest<const L: usize>() -> SparseTraceDigest<L> {
    SparseTraceDigest { valid: false, value: Poseidon2Digest::zero() }
}

pub fn empty_sparse_air_trace_digest<const L: usize>() -> SparseAirTraceDigest<L> {
    let base = invalid_sparse_trace_digest<L>()
    SparseAirTraceDigest {
        valid: false,
        base: base,
        interaction: invalid_sparse_interaction_trace_digest(base),
    }
}

pub fn sparse_trace_leaf_from_witness<const L: usize>(
    _ index: u32,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTraceLeaf<L> {
    let tasks = sparse_transition_task_count<L>()
    let trace = sparse_transition_trace_length<L>()
    if L < 2 || index >= trace { return zero_sparse_trace_leaf<L>() }
    let row = sparse_transition_row_from_witness<BabyBear, L>(
        index,
        point,
        current,
        next,
        witness,
    )
    SparseTraceLeaf {
        limb_count: BabyBear::from_u32(L.downcast_truncate()),
        task_count: BabyBear::from_u32(tasks),
        trace_length: BabyBear::from_u32(trace),
        index: BabyBear::from_u32(index),
        active: BabyBear::from_u32(if index < tasks { 1 } else { 0 }),
        control: sparse_trace_control_at<L>(index),
        row: row,
    }
}

pub fn sparse_base_air_inputs<const L: usize>(
    _ index: u32,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseBaseAirInputs<L> {
    SparseBaseAirInputs {
        index: index,
        point: point,
        current: current,
        next: next,
        witness: witness,
    }
}

pub fn sparse_base_air_control<const L: usize>(
    _ input: ref SparseBaseAirInputs<L>,
) -> SparseControlRow<BabyBear> {
    sparse_base_air_control_at<L>(input.index)
}

pub fn sparse_base_air_control_at<const L: usize>(
    _ index: u32,
) -> SparseControlRow<BabyBear> {
    sparse_control_row_at<BabyBear, L>(index)
}

pub fn sparse_base_air_control_plan<const L: usize>(
    _ input: ref SparseBaseAirInputs<L>,
) -> SparseControlPlanWitness<BabyBear> {
    sparse_base_air_control_plan_at<L>(input.index)
}

pub fn sparse_base_air_control_plan_at<const L: usize>(
    _ index: u32,
) -> SparseControlPlanWitness<BabyBear> {
    sparse_control_plan_witness(sparse_base_air_control_at<L>(index))
}

pub fn sparse_base_air_control_link_plan<const L: usize>(
    _ input: ref SparseBaseAirInputs<L>,
) -> SparseControlLinkPlanWitness<BabyBear> {
    sparse_base_air_control_link_plan_at<L>(input.index)
}

pub fn sparse_base_air_control_link_plan_at<const L: usize>(
    _ index: u32,
) -> SparseControlLinkPlanWitness<BabyBear> {
    sparse_control_link_plan_witness(
        sparse_base_air_control_at<L>(index),
        sparse_control_row_at<BabyBear, L>(index + 1),
    )
}

pub fn sparse_base_air_witness<const L: usize>(
    _ input: ref SparseBaseAirInputs<L>,
) -> SparseTaskRow<BabyBear> {
    sparse_transition_row_from_witness<BabyBear, L>(
        input.index,
        input.point,
        input.current,
        input.next,
        input.witness,
    )
}

pub fn sparse_base_air_arithmetic_plan<const L: usize>(
    _ input: ref SparseBaseAirInputs<L>,
) -> SparseArithmeticPlanWitness<BabyBear> {
    sparse_arithmetic_plan_witness(
        sparse_base_air_control(input),
        sparse_base_air_witness(input),
    )
}

pub fn sparse_base_air_arithmetic_link_plan<const L: usize>(
    _ input: ref SparseBaseAirInputs<L>,
) -> SparseArithmeticLinkPlanWitness<BabyBear> {
    sparse_arithmetic_link_plan_witness(
        sparse_base_air_control(input),
        sparse_base_air_witness(input),
        sparse_control_row_at<BabyBear, L>(input.index + 1),
        sparse_transition_row_from_witness<BabyBear, L>(
            input.index + 1,
            input.point,
            input.current,
            input.next,
            input.witness,
        ),
    )
}

pub fn sparse_base_air_round_plan<const L: usize>(
    _ input: ref SparseBaseAirInputs<L>,
) -> SparseRoundPlanWitness<BabyBear>
where L > 1,
{
    let control = sparse_base_air_control(input)
    sparse_round_plan_witness<BabyBear, L>(
        control,
        sparse_control_row_at<BabyBear, L>(input.index + 1),
        sparse_base_air_witness(input),
    )
}

pub fn sparse_base_air_linear_plan<const L: usize>(
    _ input: ref SparseBaseAirInputs<L>,
) -> SparseLinearPlanWitness<BabyBear>
where L > 1,
{
    let control = sparse_base_air_control(input)
    let row = sparse_base_air_witness(input)
    sparse_linear_plan_witness<BabyBear, L>(
        control,
        sparse_control_row_at<BabyBear, L>(input.index + 1),
        row,
        sparse_arithmetic_plan_witness(control, row),
    )
}

pub fn sparse_base_air_boundary_plan<const L: usize>(
    _ input: ref SparseBaseAirInputs<L>,
) -> SparseBoundaryPlanWitness<BabyBear>
where L > 1,
{
    sparse_boundary_plan_witness<BabyBear, L>(
        sparse_base_air_control(input),
        sparse_base_air_witness(input),
    )
}

pub fn sparse_base_air_row_from_witness<const L: usize>(
    _ index: u32,
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseBaseAirRow<BabyBear>
where L > 1,
{
    let leaf = sparse_trace_leaf_from_witness<L>(
        index, point, current, next, witness,
    )
    let next_control = sparse_control_row_at<BabyBear, L>(index + 1)
    let arithmetic_plan = sparse_arithmetic_plan_witness(
        leaf.control,
        leaf.row,
    )
    let next_row = sparse_transition_row_from_witness<BabyBear, L>(
        index + 1,
        point,
        current,
        next,
        witness,
    )
    SparseBaseAirRow {
        control: leaf.control,
        control_plan: sparse_control_plan_witness(leaf.control),
        control_link_plan: sparse_control_link_plan_witness(
            leaf.control,
            next_control,
        ),
        witness: leaf.row,
        arithmetic_plan: arithmetic_plan,
        arithmetic_link_plan: sparse_arithmetic_link_plan_witness(
            leaf.control,
            leaf.row,
            next_control,
            next_row,
        ),
        round_plan: sparse_round_plan_witness<BabyBear, L>(
            leaf.control,
            next_control,
            leaf.row,
        ),
        linear_plan: sparse_linear_plan_witness<BabyBear, L>(
            leaf.control,
            next_control,
            leaf.row,
            arithmetic_plan,
        ),
        boundary_plan: sparse_boundary_plan_witness<BabyBear, L>(
            leaf.control,
            leaf.row,
        ),
    }
}

pub fn sparse_trace_leaf_commitment<const L: usize>(
    _ leaf: SparseTraceLeaf<L>,
) -> Poseidon2Digest {
    commit_canonical<
        MandelbrotSparseTraceLeafBabyBearV3,
        SparseTraceLeaf<L>,
    >(ref leaf).digest()
}

fn sparse_trace_row_is_zero(_ row: SparseTraceRow) -> bool {
    row.value.is_zero()
        && row.auxiliary.is_zero()
        && row.accumulator_before.is_zero()
        && row.accumulator_after.is_zero()
        && row.state_before.is_zero()
        && row.state_after.is_zero()
}

fn sparse_trace_control_is_canonical<const L: usize>(
    _ position: u32,
    _ control: SparseTraceControl,
) -> bool {
    control.eq(sparse_trace_control_at<L>(position))
}

pub fn sparse_trace_leaf_is_canonical<const L: usize>(
    _ position: u32,
    _ leaf: SparseTraceLeaf<L>,
) -> bool {
    let tasks = sparse_transition_task_count<L>()
    let trace = sparse_transition_trace_length<L>()
    if L < 2 || position >= trace
        || leaf.limb_count.to_u32() != L.downcast_truncate()
        || leaf.task_count.to_u32() != tasks
        || leaf.trace_length.to_u32() != trace
        || leaf.index.to_u32() != position
        || !sparse_trace_control_is_canonical<L>(position, leaf.control) {
        return false
    }
    let expected_active = position < tasks
    if leaf.active.to_u32() != if expected_active { 1 } else { 0 } {
        return false
    }
    expected_active || sparse_trace_row_is_zero(leaf.row)
}

pub fn sparse_trace_root_power_of_two<
    const L: usize,
    const N: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
) -> SparseTraceDigest<L>
where
    L > 1,
    N > 1,
    N <= MAX_SPARSE_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
{
    let trace_length: u32 = N.downcast_truncate()
    if trace_length != sparse_transition_trace_length<L>() {
        return invalid_sparse_trace_digest<L>()
    }
    let mut frontier = empty_frontier<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_TRACE_FRONTIER_LEVELS,
    >()
    let mut index: usize = 0
    while index < N {
        let leaf = sparse_trace_leaf_from_witness<L>(
            index.downcast_truncate(),
            point,
            current,
            next,
            witness,
        )
        frontier = push_frontier<
            Poseidon2Digest,
            SparseDigestHasher,
            SPARSE_TRACE_FRONTIER_LEVELS,
        >(frontier, sparse_trace_leaf_commitment(leaf))
        index = index + 1
    }
    let root = complete_frontier_root<
        Poseidon2Digest,
        SparseDigestHasher,
        SPARSE_TRACE_FRONTIER_LEVELS,
    >(frontier)
    SparseTraceDigest { valid: root.valid, value: root.value }
}

fn reset_sparse_trace_authentication<
    const L: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ authentication: mut SparseTraceAuthentication<L, MAX_LEAVES, MAX_SIBLINGS>,
) {
    authentication = empty_sparse_trace_authentication<
        L,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >()
}

/// Authenticate requested base rows with the shared zk-kit-derived sparse
/// Merkle carrier. Request normalization is owned by `merkle_core`, while Fe
/// regenerates each opened nominal leaf from the same transition witness.
pub fn write_sparse_trace_authentication_power_of_two<
    const L: usize,
    const N: usize,
    const REQUESTS: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ point: ComplexFixed<L>,
    _ current: ComplexFixed<L>,
    _ next: ComplexFixed<L>,
    _ witness: FixedMandelbrotTransitionWitness<L>,
    _ requested: own [u32; REQUESTS],
    _ authentication: mut SparseTraceAuthentication<
        L,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
) -> bool
where
    L > 1,
    N > 1,
    N <= MAX_SPARSE_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
    REQUESTS > 0,
    MAX_LEAVES > 0,
{
    reset_sparse_trace_authentication(mut authentication)
    let trace_length: u32 = N.downcast_truncate()
    if trace_length != sparse_transition_trace_length<L>() {
        return false
    }
    let mut commitments = [Poseidon2Digest::zero(); N]
    let mut index: usize = 0
    while index < N {
        let leaf = sparse_trace_leaf_from_witness<L>(
            index.downcast_truncate(),
            point,
            current,
            next,
            witness,
        )
        commitments[index] = sparse_trace_leaf_commitment(leaf)
        index = index + 1
    }
    let mut path = invalid_sparse_multi_path<MAX_LEAVES, MAX_SIBLINGS>()
    let mut root = MerkleRoot {
        valid: false,
        value: Poseidon2Digest::zero(),
    }
    if !write_multi_path_and_root_from_leaves<
        Poseidon2Digest,
        SparseDigestHasher,
        N,
        REQUESTS,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(ref commitments, ref requested, mut path, mut root) {
        return false
    }
    authentication.root = SparseTraceDigest {
        valid: root.valid,
        value: root.value,
    }
    authentication.opening.path = path
    index = 0
    while index < path.leaf_count as usize {
        authentication.opening.values[index] = sparse_trace_leaf_from_witness<L>(
            path.leaf_indices[index],
            point,
            current,
            next,
            witness,
        )
        index = index + 1
    }
    authentication.opening.valid = true
    authentication.valid = true
    true
}

pub fn verify_sparse_trace_multi_opening<
    const L: usize,
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ opening: ref SparseTraceMultiOpening<L, MAX_LEAVES, MAX_SIBLINGS>,
    _ root: SparseTraceDigest<L>,
) -> bool
where
    L > 1,
    N > 1,
    N <= MAX_SPARSE_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
    MAX_LEAVES > 0,
{
    let trace_length: u32 = N.downcast_truncate()
    if !opening.valid || !root.valid
        || trace_length != sparse_transition_trace_length<L>() {
        return false
    }
    let count: usize = opening.path.leaf_count as usize
    if count == 0 || count > MAX_LEAVES { return false }
    let mut commitments = [Poseidon2Digest::zero(); MAX_LEAVES]
    let mut index: usize = 0
    while index < count {
        if !sparse_trace_leaf_is_canonical<L>(
            opening.path.leaf_indices[index],
            opening.values[index],
        ) {
            return false
        }
        commitments[index] = sparse_trace_leaf_commitment(opening.values[index])
        index = index + 1
    }
    while index < MAX_LEAVES {
        let leaf = opening.values[index]
        if !leaf.limb_count.is_zero()
            || !leaf.task_count.is_zero()
            || !leaf.trace_length.is_zero()
            || !leaf.index.is_zero()
            || !leaf.active.is_zero()
            || !sparse_trace_row_is_zero(leaf.row) {
            return false
        }
        index = index + 1
    }
    multi_verify<
        Poseidon2Digest,
        SparseDigestHasher,
        N,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(root.value, commitments, opening.path)
}

pub fn verify_sparse_trace_authentication<
    const L: usize,
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ authentication: ref SparseTraceAuthentication<
        L,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
) -> bool
where
    L > 1,
    N > 1,
    N <= MAX_SPARSE_TRACE_LENGTH,
    N <= 2147483648,
    { (N & (N - 1)) == 0 },
    MAX_LEAVES > 0,
{
    authentication.valid && verify_sparse_trace_multi_opening<
        L,
        N,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(ref authentication.opening, authentication.root)
}

pub fn empty_sparse_base_lde_multi_opening<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>() -> SparseBaseLdeMultiOpening<
    L,
    TRACE,
    LDE,
    MAX_LEAVES,
    MAX_SIBLINGS,
> {
    MerkleMultiOpening {
        valid: false,
        values: [[BabyBear::zero(); SPARSE_BASE_AIR_FIELDS]; MAX_LEAVES],
        path: invalid_sparse_multi_path<MAX_LEAVES, MAX_SIBLINGS>(),
    }
}

pub fn empty_sparse_interaction_lde_multi_opening<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>() -> SparseInteractionLdeMultiOpening<
    L,
    TRACE,
    LDE,
    MAX_LEAVES,
    MAX_SIBLINGS,
> {
    MerkleMultiOpening {
        valid: false,
        values: [[BabyBear::zero(); SPARSE_INTERACTION_AIR_FIELDS]; MAX_LEAVES],
        path: invalid_sparse_multi_path<MAX_LEAVES, MAX_SIBLINGS>(),
    }
}

fn reset_sparse_base_lde_multi_opening<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ opening: mut SparseBaseLdeMultiOpening<
        L,
        TRACE,
        LDE,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
) {
    opening.valid = false
    let mut leaf: usize = 0
    while leaf < MAX_LEAVES {
        let mut column: usize = 0
        while column < SPARSE_BASE_AIR_FIELDS {
            opening.values[leaf][column] = BabyBear::zero()
            column = column + 1
        }
        leaf = leaf + 1
    }
    reset_sparse_multi_path<MAX_LEAVES, MAX_SIBLINGS>(mut opening.path)
}

fn reset_sparse_interaction_lde_multi_opening<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ opening: mut SparseInteractionLdeMultiOpening<
        L,
        TRACE,
        LDE,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
) {
    opening.valid = false
    let mut leaf: usize = 0
    while leaf < MAX_LEAVES {
        let mut column: usize = 0
        while column < SPARSE_INTERACTION_AIR_FIELDS {
            opening.values[leaf][column] = BabyBear::zero()
            column = column + 1
        }
        leaf = leaf + 1
    }
    reset_sparse_multi_path<MAX_LEAVES, MAX_SIBLINGS>(mut opening.path)
}

fn write_sparse_base_lde_commitment_leaves<const L: usize, const TRACE: usize, const LDE: usize>(
    _ codeword: ref SparseBaseAirLdeCodeword<LDE>,
) -> bool
uses (leaves: mut MerkleLeafArena<Poseidon2Digest, LDE>)
where L > 1, TRACE > 1, LDE > TRACE, LDE <= MAX_SPARSE_LDE_LENGTH
{
    let mut index: usize = 0
    while index < LDE {
        leaves.values[index] = sparse_base_lde_leaf_commitment(
            sparse_base_lde_leaf_at<L, TRACE, LDE>(
                index.downcast_truncate(),
                codeword.values[index],
            ),
        )
        index = index + 1
    }
    true
}

fn write_sparse_interaction_lde_commitment_leaves<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
>(
    _ codeword: ref SparseInteractionAirLdeCodeword<LDE>,
    _ expected: SparseInteractionLdeDigest<L, TRACE, LDE>,
) -> bool
uses (leaves: mut MerkleLeafArena<Poseidon2Digest, LDE>)
where L > 1, TRACE > 1, LDE > TRACE, LDE <= MAX_SPARSE_LDE_LENGTH
{
    let mut index: usize = 0
    while index < LDE {
        leaves.values[index] = sparse_interaction_lde_leaf_commitment(
            sparse_interaction_lde_leaf_at<L, TRACE, LDE>(
                expected.base,
                index.downcast_truncate(),
                codeword.values[index],
            ),
        )
        index = index + 1
    }
    true
}

fn sparse_browser_root_matches<const N: usize>(_ expected: Poseidon2Digest) -> bool
uses (leaves: MerkleLeafArena<Poseidon2Digest, N>)
where N > 1, N <= MAX_SPARSE_LDE_LENGTH
{
    leaves.root.valid && leaves.root.value.equals(expected)
}

/// Open requested `LD01` rows and require the reconstructed root to equal the
/// exact root already bound into the AIR transcript. Request normalization and
/// path generation remain the shared `merkle_core` interpretation.
pub fn write_sparse_base_lde_multi_opening_power_of_two<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const REQUESTS: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ codeword: ref SparseBaseAirLdeCodeword<LDE>,
    _ expected: SparseBaseLdeDigest<L, TRACE, LDE>,
    _ requested: own [u32; REQUESTS],
    _ opening: mut SparseBaseLdeMultiOpening<
        L,
        TRACE,
        LDE,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
) -> bool
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    LDE <= 2147483648,
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
    REQUESTS > 0,
    MAX_LEAVES > 0,
{
    reset_sparse_base_lde_multi_opening(mut opening)
    if !codeword.valid || !expected.valid { return false }
    let commitments: BrowserPtr<MerkleLeafArena<Poseidon2Digest, LDE>> = alloc_browser_object<
        MerkleLeafArena<Poseidon2Digest, LDE>,
    >()
    if commitments.address() == 0
        || !with (commitments) {
            write_sparse_base_lde_commitment_leaves<L, TRACE, LDE>(codeword)
        }
    {
        return false
    }
    if !with (commitments) {
        write_sparse_multi_path_from_browser_leaves<LDE, REQUESTS, MAX_LEAVES, MAX_SIBLINGS>(
            ref requested,
            mut opening.path,
        )
    }
        || !with (commitments) { sparse_browser_root_matches<LDE>(expected.value) }
    {
        return false
    }
    let mut index: usize = 0
    while index < opening.path.leaf_count as usize {
        opening.values[index] = codeword.values[opening.path.leaf_indices[index] as usize]
        index = index + 1
    }
    opening.valid = true
    true
}

/// Open requested `LD02` rows under the exact base root retained by the
/// interaction digest. This prevents an interaction row from being moved
/// across independently committed base codewords.
pub fn write_sparse_interaction_lde_multi_opening_power_of_two<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const REQUESTS: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ codeword: ref SparseInteractionAirLdeCodeword<LDE>,
    _ expected: SparseInteractionLdeDigest<L, TRACE, LDE>,
    _ requested: own [u32; REQUESTS],
    _ opening: mut SparseInteractionLdeMultiOpening<
        L,
        TRACE,
        LDE,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
) -> bool
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    LDE <= 2147483648,
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
    REQUESTS > 0,
    MAX_LEAVES > 0,
{
    reset_sparse_interaction_lde_multi_opening(mut opening)
    if !codeword.valid || !expected.valid || !expected.base.valid {
        return false
    }
    let commitments: BrowserPtr<MerkleLeafArena<Poseidon2Digest, LDE>> = alloc_browser_object<
        MerkleLeafArena<Poseidon2Digest, LDE>,
    >()
    if commitments.address() == 0
        || !with (commitments) {
            write_sparse_interaction_lde_commitment_leaves<L, TRACE, LDE>(codeword, expected)
        }
    {
        return false
    }
    if !with (commitments) {
        write_sparse_multi_path_from_browser_leaves<LDE, REQUESTS, MAX_LEAVES, MAX_SIBLINGS>(
            ref requested,
            mut opening.path,
        )
    }
        || !with (commitments) { sparse_browser_root_matches<LDE>(expected.value) }
    {
        return false
    }
    let mut index: usize = 0
    while index < opening.path.leaf_count as usize {
        opening.values[index] = codeword.values[opening.path.leaf_indices[index] as usize]
        index = index + 1
    }
    opening.valid = true
    true
}

pub fn verify_sparse_base_lde_multi_opening<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ opening: ref SparseBaseLdeMultiOpening<
        L,
        TRACE,
        LDE,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
    _ root: SparseBaseLdeDigest<L, TRACE, LDE>,
) -> bool
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    LDE <= 2147483648,
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
    MAX_LEAVES > 0,
{
    if !opening.valid || !opening.path.valid || !root.valid { return false }
    let count: usize = opening.path.leaf_count as usize
    if count == 0 || count > MAX_LEAVES { return false }
    let mut commitments = [Poseidon2Digest::zero(); MAX_LEAVES]
    let mut index: usize = 0
    while index < count {
        commitments[index] = sparse_base_lde_leaf_commitment(
            sparse_base_lde_leaf_at<L, TRACE, LDE>(
                opening.path.leaf_indices[index],
                opening.values[index],
            ),
        )
        index = index + 1
    }
    while index < MAX_LEAVES {
        let mut field: usize = 0
        while field < SPARSE_BASE_AIR_FIELDS {
            if !opening.values[index][field].is_zero() { return false }
            field = field + 1
        }
        index = index + 1
    }
    multi_verify<
        Poseidon2Digest,
        SparseDigestHasher,
        LDE,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(root.value, commitments, opening.path)
}

pub fn verify_sparse_interaction_lde_multi_opening<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ opening: ref SparseInteractionLdeMultiOpening<
        L,
        TRACE,
        LDE,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
    _ root: SparseInteractionLdeDigest<L, TRACE, LDE>,
) -> bool
where
    L > 1,
    TRACE > 0,
    TRACE > 1,
    { (TRACE & (TRACE - 1)) == 0 },
    LDE > 1,
    LDE > TRACE,
    LDE <= MAX_SPARSE_LDE_LENGTH,
    LDE <= 2147483648,
    { (LDE & (LDE - 1)) == 0 },
    { (LDE % TRACE) == 0 },
    MAX_LEAVES > 0,
{
    if !opening.valid || !opening.path.valid || !root.valid || !root.base.valid {
        return false
    }
    let count: usize = opening.path.leaf_count as usize
    if count == 0 || count > MAX_LEAVES { return false }
    let mut commitments = [Poseidon2Digest::zero(); MAX_LEAVES]
    let mut index: usize = 0
    while index < count {
        commitments[index] = sparse_interaction_lde_leaf_commitment(
            sparse_interaction_lde_leaf_at<L, TRACE, LDE>(
                root.base,
                opening.path.leaf_indices[index],
                opening.values[index],
            ),
        )
        index = index + 1
    }
    while index < MAX_LEAVES {
        let mut field: usize = 0
        while field < SPARSE_INTERACTION_AIR_FIELDS {
            if !opening.values[index][field].is_zero() { return false }
            field = field + 1
        }
        index = index + 1
    }
    multi_verify<
        Poseidon2Digest,
        SparseDigestHasher,
        LDE,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >(root.value, commitments, opening.path)
}

fn sparse_multi_path_position<
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ path: ref MerkleMultiPath<Poseidon2Digest, MAX_LEAVES, MAX_SIBLINGS>,
    _ index: u32,
) -> usize {
    if !path.valid || path.leaf_count == 0
        || path.leaf_count > MAX_LEAVES.downcast_truncate() {
        return MAX_LEAVES
    }
    let mut cursor: usize = 0
    while cursor < path.leaf_count as usize {
        if path.leaf_indices[cursor] == index { return cursor }
        cursor = cursor + 1
    }
    MAX_LEAVES
}

/// Recover one typed AIR row from a pair of already authenticated `LD01` and
/// `LD02` multipaths. Both paths must contain the same requested evaluation.
pub fn sparse_lde_opened_air_row<
    const L: usize,
    const TRACE: usize,
    const LDE: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ base: ref SparseBaseLdeMultiOpening<
        L,
        TRACE,
        LDE,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
    _ interaction: ref SparseInteractionLdeMultiOpening<
        L,
        TRACE,
        LDE,
        MAX_LEAVES,
        MAX_SIBLINGS,
    >,
    _ index: u32,
) -> (bool, SparseOpenedAirRow)
where MAX_LEAVES > 0,
{
    if !base.valid || !interaction.valid {
        return (false, zero_sparse_opened_air_row())
    }
    let base_position = sparse_multi_path_position(ref base.path, index)
    let interaction_position = sparse_multi_path_position(ref interaction.path, index)
    if base_position == MAX_LEAVES || interaction_position == MAX_LEAVES {
        return (false, zero_sparse_opened_air_row())
    }
    let row = sparse_opened_air_row(
        base.values[base_position],
        interaction.values[interaction_position],
    )
    (row.valid, row)
}
