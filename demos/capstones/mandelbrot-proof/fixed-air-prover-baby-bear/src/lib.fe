//! Fe-owned staged workspace for the production sparse BabyBear leaf prover.
//!
//! Inside one canonical arena epoch, Fe retains typed pointers to its interval,
//! stage order, codewords, receipt, and verification policy. Only the final
//! canonical receipt bytes cross the browser boundary. The scalar stage bodies
//! are the reference interpreter that the Conal/CTFE WebGPU placement must
//! preserve, not a host-side alternative prover.

use core::{BrowserBytes, BrowserPtr, alloc_browser_object}
use mandelbrot_proof_fixed_air::{
    derive_fixed_mandelbrot_transition_witness,
    fixed_mandelbrot_transition_output,
    fixed_mandelbrot_transition_witness_holds,
}
use mandelbrot_proof_fixed_air_baby_bear::{
    SPARSE_BASE_AIR_FIELDS,
    SPARSE_INTERACTION_AIR_FIELDS,
    SparseBaseLdeDigest,
    SparseBaseAirEvaluationTrace,
    SparseBaseAirLdeCodeword,
    SparseCompositionAirCodeword,
    SparseInteractionAirEvaluationTrace,
    SparseInteractionAirLdeCodeword,
    SparseLdeInteractionChallenges,
    bind_sparse_air_lde_transcript,
    sparse_base_air_fields,
    sparse_base_air_row_from_witness,
    sparse_base_lde_root_power_of_two,
    sparse_interaction_air_fields,
    sparse_interaction_lde_root_power_of_two,
    sparse_lde_interaction_challenges,
    write_sparse_base_air_lde,
    write_sparse_bound_composition_air_codeword,
    write_sparse_interaction_air_lde,
    write_sparse_lde_interaction_air_rows,
    zero_sparse_interaction_accumulators,
    zero_sparse_interaction_trace_row,
}
use mandelbrot_proof_fixed_air_core::sparse_transition_trace_length
use mandelbrot_proof_fixed_air_receipt_baby_bear::{
    PRODUCTION_LDE_LENGTH,
    PRODUCTION_LIMBS,
    PRODUCTION_TRACE_LENGTH,
    ProductionSecuritySparseBabyBearReceipt,
    ProductionSparseBabyBearReceipt,
    ProductionSparseFriProof,
    SparseDirectFriTranscriptProfile,
    bind_sparse_air_security_profile,
    encode_production_security_sparse_baby_bear_receipt,
    encode_production_sparse_baby_bear_receipt,
    production_checkpoint_security_profile,
    production_recursive_security_profile,
    write_production_security_sparse_baby_bear_receipt,
    write_production_sparse_baby_bear_receipt,
}
use mandelbrot_proof_recursive::{OrbitInterval, certify_leaf, complex_equals}
use mandelbrot_proof_recursive_baby_bear::commit_recursive_leaf_statement
use precision::baby_bear::BabyBear

pub enum ProductionSparseProverStage {
    Empty,
    BaseLde,
    InteractionLde,
    Composition,
}
impl core::marker::Copy for ProductionSparseProverStage {}

type ProductionBaseCodeword =
    SparseBaseAirLdeCodeword<{PRODUCTION_LDE_LENGTH}>
type ProductionBaseEvaluations =
    SparseBaseAirEvaluationTrace<{PRODUCTION_TRACE_LENGTH}>
type ProductionBaseDigest = SparseBaseLdeDigest<
    {PRODUCTION_LIMBS},
    {PRODUCTION_TRACE_LENGTH},
    {PRODUCTION_LDE_LENGTH},
>
type ProductionInteractionCodeword =
    SparseInteractionAirLdeCodeword<{PRODUCTION_LDE_LENGTH}>
type ProductionInteractionEvaluations =
    SparseInteractionAirEvaluationTrace<{PRODUCTION_TRACE_LENGTH}>
type ProductionInteractionChallenges = SparseLdeInteractionChallenges<
    {PRODUCTION_LIMBS},
    {PRODUCTION_TRACE_LENGTH},
    {PRODUCTION_LDE_LENGTH},
>
type ProductionCompositionCodeword =
    SparseCompositionAirCodeword<{PRODUCTION_LDE_LENGTH}>

pub struct ProductionSparseProverWorkspace {
    valid: bool,
    stage: ProductionSparseProverStage,
    interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    shift: BabyBear,
    base_evaluations: BrowserPtr<ProductionBaseEvaluations>,
    base: BrowserPtr<ProductionBaseCodeword>,
    interaction_evaluations: BrowserPtr<ProductionInteractionEvaluations>,
    interaction: BrowserPtr<ProductionInteractionCodeword>,
    composition: BrowserPtr<ProductionCompositionCodeword>,
    profile: SparseDirectFriTranscriptProfile,
}

fn stage_is_empty(_ stage: ProductionSparseProverStage) -> bool {
    match stage {
        ProductionSparseProverStage::Empty => true,
        _ => false,
    }
}

fn stage_is_base_lde(_ stage: ProductionSparseProverStage) -> bool {
    match stage {
        ProductionSparseProverStage::BaseLde => true,
        _ => false,
    }
}

fn stage_is_interaction_lde(_ stage: ProductionSparseProverStage) -> bool {
    match stage {
        ProductionSparseProverStage::InteractionLde => true,
        _ => false,
    }
}

fn stage_is_composition(_ stage: ProductionSparseProverStage) -> bool {
    match stage {
        ProductionSparseProverStage::Composition => true,
        _ => false,
    }
}

fn production_leaf_input_is_valid(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
) -> bool {
    if interval.end.iteration <= interval.start.iteration
        || interval.end.iteration - interval.start.iteration != 1 {
        return false
    }
    let certified = certify_leaf(interval)
    let witness = derive_fixed_mandelbrot_transition_witness(
        interval.claim.point,
        interval.start.z,
    )
    let next = fixed_mandelbrot_transition_output(witness)
    certified.valid
        && complex_equals(next, interval.end.z)
        && fixed_mandelbrot_transition_witness_holds(
            interval.claim.point,
            interval.start.z,
            interval.end.z,
            witness,
        )
}

fn initialize_production_sparse_prover(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
    _ base_evaluations: BrowserPtr<ProductionBaseEvaluations>,
    _ base: BrowserPtr<ProductionBaseCodeword>,
    _ interaction_evaluations: BrowserPtr<ProductionInteractionEvaluations>,
    _ interaction: BrowserPtr<ProductionInteractionCodeword>,
    _ composition: BrowserPtr<ProductionCompositionCodeword>,
    _ profile: SparseDirectFriTranscriptProfile,
) -> bool
    uses (workspace: mut ProductionSparseProverWorkspace)
{
    workspace.valid = false
    workspace.stage = ProductionSparseProverStage::Empty
    workspace.interval = interval
    workspace.shift = shift
    workspace.base_evaluations = base_evaluations
    workspace.base = base
    workspace.interaction_evaluations = interaction_evaluations
    workspace.interaction = interaction
    workspace.composition = composition
    workspace.profile = profile
    workspace.valid = true
    true
}

fn invalidate_production_sparse_prover()
    uses (workspace: mut ProductionSparseProverWorkspace)
{
    workspace.valid = false
}

fn write_production_sparse_base_evaluations(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
) -> bool
    uses (evaluations: mut ProductionBaseEvaluations)
{
    evaluations.valid = false
    let witness = derive_fixed_mandelbrot_transition_witness(
        interval.claim.point,
        interval.start.z,
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let mut row: usize = 0
    while row < PRODUCTION_TRACE_LENGTH {
        let placed = sparse_base_air_row_from_witness<
            {PRODUCTION_LIMBS},
        >(
            row.downcast_truncate(),
            interval.claim.point,
            interval.start.z,
            next,
            witness,
        )
        let fields = sparse_base_air_fields(ref placed)
        if !fields.valid { return false }
        evaluations.values[row] = fields.values
        row = row + 1
    }
    evaluations.valid = true
    true
}

fn write_production_sparse_base_codeword(_ shift: BabyBear) -> bool
    uses (
        evaluations: ProductionBaseEvaluations,
        codeword: mut ProductionBaseCodeword,
    )
{
    write_sparse_base_air_lde<
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(
        ref evaluations,
        shift,
        mut codeword,
    )
}

fn write_zero_production_sparse_base_evaluations()
    uses (evaluations: mut ProductionBaseEvaluations)
{
    evaluations.valid = false
    let zero = BabyBear::zero()
    let mut row: usize = 0
    while row < PRODUCTION_TRACE_LENGTH {
        let mut column: usize = 0
        while column < SPARSE_BASE_AIR_FIELDS {
            evaluations.values[row][column] = zero
            column = column + 1
        }
        row = row + 1
    }
    evaluations.valid = true
}

/// Execute the production-size base LDE in isolation. This is an exact stage
/// checkpoint for the scalar interpreter and a bounded compiler/backend gate
/// for arena-owned provider reborrows, independent of receipt and FRI work.
pub fn production_zero_base_lde_checkpoint() -> bool {
    let evaluations = alloc_browser_object<ProductionBaseEvaluations>()
    let codeword = alloc_browser_object<ProductionBaseCodeword>()
    if evaluations.address() == 0 || codeword.address() == 0 { return false }
    with (evaluations) { write_zero_production_sparse_base_evaluations() }
    with (evaluations, codeword) {
        write_production_sparse_base_codeword(BabyBear::from_u32(7))
    }
}

fn write_production_sparse_base_stage() -> bool
    uses (workspace: mut ProductionSparseProverWorkspace)
{
    if !workspace.valid || !stage_is_empty(workspace.stage) { return false }
    let interval = workspace.interval
    let shift = workspace.shift
    let evaluations = workspace.base_evaluations
    let codeword = workspace.base
    if !with (evaluations) {
        write_production_sparse_base_evaluations(interval)
    } || !with (evaluations, codeword) {
        write_production_sparse_base_codeword(shift)
    } {
        invalidate_production_sparse_prover()
        return false
    }
    workspace.stage = ProductionSparseProverStage::BaseLde
    true
}

fn production_sparse_base_root() -> ProductionBaseDigest
    uses (codeword: ProductionBaseCodeword)
{
    sparse_base_lde_root_power_of_two<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(ref codeword)
}

fn write_production_sparse_interaction_evaluations(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ challenges: ProductionInteractionChallenges,
) -> bool
    uses (evaluations: mut ProductionInteractionEvaluations)
{
    evaluations.valid = false
    let witness = derive_fixed_mandelbrot_transition_witness(
        interval.claim.point,
        interval.start.z,
    )
    let next = fixed_mandelbrot_transition_output(witness)
    let mut accumulators = zero_sparse_interaction_accumulators()
    let mut tile = [zero_sparse_interaction_trace_row(); 1]
    let mut row: usize = 0
    while row < PRODUCTION_TRACE_LENGTH {
        if !write_sparse_lde_interaction_air_rows<
            {PRODUCTION_LIMBS},
            {PRODUCTION_TRACE_LENGTH},
            {PRODUCTION_LDE_LENGTH},
            1,
        >(
            interval.claim.point,
            interval.start.z,
            next,
            witness,
            challenges,
            row.downcast_truncate(),
            mut accumulators,
            mut tile,
        ) {
            return false
        }
        let fields = sparse_interaction_air_fields(ref tile[0])
        if !fields.valid { return false }
        evaluations.values[row] = fields.values
        row = row + 1
    }
    if !accumulators.product.is_zero()
        || !accumulators.round.is_zero()
        || !accumulators.linear.is_zero()
        || !accumulators.boundary.is_zero() {
        return false
    }
    evaluations.valid = true
    true
}

fn write_production_sparse_interaction_codeword(_ shift: BabyBear) -> bool
    uses (
        evaluations: ProductionInteractionEvaluations,
        codeword: mut ProductionInteractionCodeword,
    )
{
    write_sparse_interaction_air_lde<
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(
        ref evaluations,
        shift,
        mut codeword,
    )
}

fn write_production_sparse_interaction_stage() -> bool
    uses (workspace: mut ProductionSparseProverWorkspace)
{
    if !workspace.valid || !stage_is_base_lde(workspace.stage) { return false }
    let interval = workspace.interval
    let shift = workspace.shift
    let base = workspace.base
    let evaluations = workspace.interaction_evaluations
    let codeword = workspace.interaction
    let base_root = with (base) { production_sparse_base_root() }
    let challenges = sparse_lde_interaction_challenges(base_root)
    if !with (evaluations) {
        write_production_sparse_interaction_evaluations(interval, challenges)
    } || !with (evaluations, codeword) {
        write_production_sparse_interaction_codeword(shift)
    } {
        invalidate_production_sparse_prover()
        return false
    }
    workspace.stage = ProductionSparseProverStage::InteractionLde
    true
}

fn write_production_sparse_composition(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
    _ profile: SparseDirectFriTranscriptProfile,
) -> bool
    uses (
        base: ProductionBaseCodeword,
        interaction: ProductionInteractionCodeword,
        composition: mut ProductionCompositionCodeword,
    )
{
    let base_root = sparse_base_lde_root_power_of_two<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(ref base)
    let interaction_root = sparse_interaction_lde_root_power_of_two<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(base_root, ref interaction)
    let air = bind_sparse_air_lde_transcript<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(
        commit_recursive_leaf_statement(interval),
        base_root,
        interaction_root,
    )
    let transcript = bind_sparse_air_security_profile(
        air,
        profile,
    )
    let transcript = write_sparse_bound_composition_air_codeword<
        {PRODUCTION_LIMBS},
        {PRODUCTION_TRACE_LENGTH},
        {PRODUCTION_LDE_LENGTH},
    >(
        interval,
        transcript,
        ref base,
        ref interaction,
        shift,
        mut composition,
    )
    transcript.is_valid() && composition.valid
}

fn write_production_sparse_composition_stage() -> bool
    uses (workspace: mut ProductionSparseProverWorkspace)
{
    if !workspace.valid || !stage_is_interaction_lde(workspace.stage) {
        return false
    }
    let interval = workspace.interval
    let shift = workspace.shift
    let profile = workspace.profile
    let base = workspace.base
    let interaction = workspace.interaction
    let composition = workspace.composition
    if !with (base, interaction, composition) {
        write_production_sparse_composition(interval, shift, profile)
    } {
        invalidate_production_sparse_prover()
        return false
    }
    workspace.stage = ProductionSparseProverStage::Composition
    true
}

struct ProductionSparseProverArtifacts {
    valid: bool,
    base: BrowserPtr<ProductionBaseCodeword>,
    interaction: BrowserPtr<ProductionInteractionCodeword>,
    composition: BrowserPtr<ProductionCompositionCodeword>,
}

fn write_production_checkpoint_receipt(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
) -> bool
    uses (
        base: ProductionBaseCodeword,
        interaction: ProductionInteractionCodeword,
        composition: ProductionCompositionCodeword,
        complete: mut ProductionSparseFriProof,
        receipt: mut ProductionSparseBabyBearReceipt,
    )
{
    write_production_sparse_baby_bear_receipt(
        interval,
        ref base,
        ref interaction,
        ref composition,
        shift,
        mut complete,
        mut receipt,
    )
}

fn encode_production_checkpoint_receipt() -> BrowserBytes
    uses (receipt: ProductionSparseBabyBearReceipt)
{
    encode_production_sparse_baby_bear_receipt(ref receipt)
}

fn write_production_security_receipt(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
) -> bool
    uses (
        base: ProductionBaseCodeword,
        interaction: ProductionInteractionCodeword,
        composition: ProductionCompositionCodeword,
        complete: mut ProductionSparseFriProof,
        receipt: mut ProductionSecuritySparseBabyBearReceipt,
    )
{
    write_production_security_sparse_baby_bear_receipt(
        interval,
        ref base,
        ref interaction,
        ref composition,
        shift,
        mut complete,
        mut receipt,
    )
}

fn encode_production_security_receipt() -> BrowserBytes
    uses (receipt: ProductionSecuritySparseBabyBearReceipt)
{
    encode_production_security_sparse_baby_bear_receipt(ref receipt)
}

/// Execute the scalar reference interpretation inside one canonical arena
/// epoch. Each phase remains separately named and stage-checked so the future
/// Conal/CTFE WebGPU interpreter can place the same dependency graph without
/// duplicating proof semantics. The concrete checkpoint and security receipt
/// boundaries below remain deliberately small because generic receipt effects
/// currently trigger a compiler dependency cycle.
fn prove_production_sparse_artifacts(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
    _ profile: SparseDirectFriTranscriptProfile,
) -> ProductionSparseProverArtifacts
{
    let workspace: BrowserPtr<ProductionSparseProverWorkspace> =
        alloc_browser_object<ProductionSparseProverWorkspace>()
    let base_evaluations: BrowserPtr<ProductionBaseEvaluations> =
        alloc_browser_object<ProductionBaseEvaluations>()
    let base: BrowserPtr<ProductionBaseCodeword> =
        alloc_browser_object<ProductionBaseCodeword>()
    let interaction_evaluations: BrowserPtr<ProductionInteractionEvaluations> =
        alloc_browser_object<ProductionInteractionEvaluations>()
    let interaction: BrowserPtr<ProductionInteractionCodeword> =
        alloc_browser_object<ProductionInteractionCodeword>()
    let composition: BrowserPtr<ProductionCompositionCodeword> =
        alloc_browser_object<ProductionCompositionCodeword>()
    if workspace.address() == 0
        || base_evaluations.address() == 0
        || base.address() == 0
        || interaction_evaluations.address() == 0
        || interaction.address() == 0
        || composition.address() == 0 {
        return ProductionSparseProverArtifacts {
            valid: false,
            base: base,
            interaction: interaction,
            composition: composition,
        }
    }
    if shift.is_zero()
        || sparse_transition_trace_length<{PRODUCTION_LIMBS}>()
            != PRODUCTION_TRACE_LENGTH.downcast_truncate()
        || !production_leaf_input_is_valid(interval) {
        return ProductionSparseProverArtifacts {
            valid: false,
            base: base,
            interaction: interaction,
            composition: composition,
        }
    }
    // Every stage writer marks its destination invalid before work, initializes
    // every readable field before success, and no failed destination is ever
    // observed. Keep these arena objects uninitialized until their owning Fe
    // stage writes them instead of constructing a second giant empty proof.
    if !with (workspace) {
        initialize_production_sparse_prover(
            interval,
            shift,
            base_evaluations,
            base,
            interaction_evaluations,
            interaction,
            composition,
            profile,
        )
    } || !with (workspace) { write_production_sparse_base_stage() }
        || !with (workspace) { write_production_sparse_interaction_stage() }
        || !with (workspace) { write_production_sparse_composition_stage() } {
        return ProductionSparseProverArtifacts {
            valid: false,
            base: base,
            interaction: interaction,
            composition: composition,
        }
    }
    ProductionSparseProverArtifacts {
        valid: true,
        base: base,
        interaction: interaction,
        composition: composition,
    }
}

pub fn prove_production_sparse_interval(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
) -> BrowserBytes {
    let artifacts = prove_production_sparse_artifacts(
        interval,
        shift,
        production_checkpoint_security_profile(),
    )
    let receipt = alloc_browser_object<ProductionSparseBabyBearReceipt>()
    let complete = alloc_browser_object<ProductionSparseFriProof>()
    if !artifacts.valid || receipt.address() == 0 || complete.address() == 0 {
        return BrowserBytes { ptr: 0, len: 0 }
    }
    let base = artifacts.base
    let interaction = artifacts.interaction
    let composition = artifacts.composition
    if !with (base, interaction, composition, complete, receipt) {
        write_production_checkpoint_receipt(interval, shift)
    } {
        return BrowserBytes { ptr: 0, len: 0 }
    }
    with (receipt) { encode_production_checkpoint_receipt() }
}

/// Execute the same staged scalar prover with the CTFE-selected 114-query
/// recursive security profile and its independently typed receipt carrier.
pub fn prove_production_security_sparse_interval(
    _ interval: OrbitInterval<{PRODUCTION_LIMBS}>,
    _ shift: BabyBear,
) -> BrowserBytes {
    let artifacts = prove_production_sparse_artifacts(
        interval,
        shift,
        production_recursive_security_profile(),
    )
    let receipt = alloc_browser_object<ProductionSecuritySparseBabyBearReceipt>()
    let complete = alloc_browser_object<ProductionSparseFriProof>()
    if !artifacts.valid || receipt.address() == 0 || complete.address() == 0 {
        return BrowserBytes { ptr: 0, len: 0 }
    }
    let base = artifacts.base
    let interaction = artifacts.interaction
    let composition = artifacts.composition
    if !with (base, interaction, composition, complete, receipt) {
        write_production_security_receipt(interval, shift)
    } {
        return BrowserBytes { ptr: 0, len: 0 }
    }
    with (receipt) { encode_production_security_receipt() }
}
