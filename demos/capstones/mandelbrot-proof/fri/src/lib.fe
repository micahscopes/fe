//! First Fe-native FRI fold for the bounded Mandelbrot composition polynomial.
//!
//! Evaluations at `x` and `-x` are folded into an evaluation at `x^2` using
//! the transcript-derived `FC01` challenge. The eight resulting values are
//! committed before `FC02` is derived.

use mandelbrot_proof_composition::{
    AirLdeCommitment16,
    AirLdeQuartetOpening4x16,
    CompositionProof,
    compose4x16,
    EMPTY_AIR_LDE_COMMITMENT16,
    INVALID_AIR_LDE_QUARTET_OPENING4X16,
    open_air_lde_quartet4x16,
    verify_air_lde_quartet4x16,
}
use mandelbrot_proof_commitment::{
    AuxiliaryLdeDigest,
    AuxiliaryDigest,
    CompositionDigest,
    CompositionPairPath,
    FriFoldChallenge,
    FriLayerDigest,
    FriLayerPairPath,
    FriLayerTranscriptDigest,
    MainLdeDigest,
    TraceDigest,
    bind_auxiliary_lde,
    bind_auxiliary_trace,
    bind_composition,
    bind_fri_layer,
    bind_main_lde,
    bind_next_fri_layer,
    bind_statement,
    composition_challenge,
    composition_pair_path_power_of_two,
    fri_fold_challenge,
    fri_layer_row_commitment,
    fri_layer_pair_path_power_of_two,
    fri_layer_pair_path_two,
    fri_layer_root_power_of_two,
    fri_next_fold_challenge,
    fri_query_challenge,
    stream_statement_q12,
    verify_composition_pair_path,
    verify_fri_layer_pair_path,
    verify_fri_layer_pair_path_two,
}
use mandelbrot_proof_field_air::Fr
use mandelbrot_proof_kernel::{
    EscapesByQ12Public,
    MAX_PADDED_TRACE_LENGTH,
    encode_signed_word,
    escape_public_proof_domain_holds_q12,
}
use poseidon_bn254::plain_words
use poseidon_merkle::field_values_equal
use precision::bn254_fr::Bn254Fr
use precision::field::FieldElement
use precision::polynomial::radix2_log
use canonical_words::{CanonicalWords, CanonicalWordsProvider}

type Field = FieldElement<20, Bn254Fr>

pub struct FriProof8 {
    pub valid: bool,
    pub composition: CompositionProof<16>,
    pub evaluations: [Fr; 8],
    pub root: FriLayerDigest<1>,
    pub transcript: FriLayerTranscriptDigest<1>,
    pub next_challenge: FriFoldChallenge<2>,
}

impl core::marker::Copy for FriProof8 {}

pub struct FriFoldEvaluations<const N: usize> { pub valid: bool, pub evaluations: [Fr; N] }
impl<const N: usize> core::marker::Copy for FriFoldEvaluations<N> {}

pub struct FriRound<const ROUND: u32, const N: usize, const NEXT: u32> {
    pub valid: bool,
    pub evaluations: [Fr; N],
    pub root: FriLayerDigest<ROUND>,
    pub transcript: FriLayerTranscriptDigest<ROUND>,
    pub next_challenge: FriFoldChallenge<NEXT>,
}
impl<const ROUND: u32, const N: usize, const NEXT: u32> core::marker::Copy for FriRound<
    ROUND,
    N,
    NEXT,
> {}

pub struct FriFinalRound<const ROUND: u32> {
    pub valid: bool,
    pub evaluation: Fr,
    pub root: FriLayerDigest<ROUND>,
    pub transcript: FriLayerTranscriptDigest<ROUND>,
}
impl<const ROUND: u32> core::marker::Copy for FriFinalRound<ROUND> {}

pub struct FriProofComplete {
    pub valid: bool,
    pub first: FriProof8,
    pub second: FriRound<2, 4, 3>,
    pub third: FriRound<3, 2, 4>,
    pub final_round: FriFinalRound<4>,
}
impl core::marker::Copy for FriProofComplete {}

pub struct CompositionQueryPair<const DEPTH: usize> {
    pub positive: Fr,
    pub negative: Fr,
    pub path: CompositionPairPath<DEPTH>,
}
impl<const DEPTH: usize> core::marker::Copy for CompositionQueryPair<DEPTH> {}
impl<const DEPTH: usize> CanonicalWords for CompositionQueryPair<DEPTH> {
    const WORDS: u32 = <Fr as CanonicalWords>::WORDS * 2
        + <CompositionPairPath<DEPTH> as CanonicalWords>::WORDS

    fn encode<W: canonical_words::WordSink>(self, _ writer: W) -> W {
        let writer = self.positive.encode(writer)
        let writer = self.negative.encode(writer)
        self.path.encode(writer)
    }

    fn decode<R: canonical_words::WordSource>(mut self, _ reader: R) -> R {
        let reader = self.positive.decode(reader)
        let reader = self.negative.decode(reader)
        self.path.decode(reader)
    }
}

pub struct FriQueryPair<const ROUND: u32, const DEPTH: usize> {
    pub positive: Fr,
    pub negative: Fr,
    pub path: FriLayerPairPath<ROUND, DEPTH>,
}
impl<const ROUND: u32, const DEPTH: usize> core::marker::Copy for FriQueryPair<ROUND, DEPTH> {}
impl<const ROUND: u32, const DEPTH: usize> CanonicalWords for FriQueryPair<ROUND, DEPTH> {
    const WORDS: u32 = <Fr as CanonicalWords>::WORDS * 2
        + <FriLayerPairPath<ROUND, DEPTH> as CanonicalWords>::WORDS

    fn encode<W: canonical_words::WordSink>(self, _ writer: W) -> W {
        let writer = self.positive.encode(writer)
        let writer = self.negative.encode(writer)
        self.path.encode(writer)
    }

    fn decode<R: canonical_words::WordSource>(mut self, _ reader: R) -> R {
        let reader = self.positive.decode(reader)
        let reader = self.negative.decode(reader)
        self.path.decode(reader)
    }
}

/// Public commitments and one transcript-derived FRI query for the current
/// four-row, sixteen-point executable slice. It authenticates both the FRI
/// fold chain and the four main/auxiliary LDE rows needed to recompute the two
/// queried composition evaluations.
pub struct FriCommitmentQuery4x16 {
    pub valid: bool,
    pub terminal_step: u32,
    pub trace_length: u32,
    pub padded_length: u32,
    pub trace: TraceDigest,
    pub auxiliary: AuxiliaryDigest,
    pub main_lde_root: MainLdeDigest,
    pub auxiliary_lde_root: AuxiliaryLdeDigest,
    pub composition_root: CompositionDigest,
    pub first_root: FriLayerDigest<1>,
    pub second_root: FriLayerDigest<2>,
    pub third_root: FriLayerDigest<3>,
    pub final_root: FriLayerDigest<4>,
    pub query_index: u32,
    pub air_lde: AirLdeQuartetOpening4x16,
    pub composition: CompositionQueryPair<3>,
    pub first: FriQueryPair<1, 2>,
    pub second: FriQueryPair<2, 1>,
    pub third: FriQueryPair<3, 0>,
    pub final_evaluation: Fr,
}
impl core::marker::Copy for FriCommitmentQuery4x16 {}
derive CanonicalWords for FriCommitmentQuery4x16 using CanonicalWordsProvider

fn invalid_fold<const N: usize>() -> FriFoldEvaluations<N> {
    FriFoldEvaluations { valid: false, evaluations: [Fr::zero(); N] }
}

fn invalid_round<const ROUND: u32, const N: usize, const NEXT: u32>() -> FriRound<ROUND, N, NEXT> {
    FriRound {
        valid: false,
        evaluations: [Fr::zero(); N],
        root: FriLayerDigest { value: Fr::zero() },
        transcript: FriLayerTranscriptDigest { value: Fr::zero() },
        next_challenge: FriFoldChallenge { value: Fr::zero() },
    }
}

fn invalid_final<const ROUND: u32>() -> FriFinalRound<ROUND> {
    FriFinalRound {
        valid: false,
        evaluation: Fr::zero(),
        root: FriLayerDigest { value: Fr::zero() },
        transcript: FriLayerTranscriptDigest { value: Fr::zero() },
    }
}

fn invalid_complete(_ first: FriProof8) -> FriProofComplete {
    FriProofComplete {
        valid: false,
        first: first,
        second: invalid_round<2, 4, 3>(),
        third: invalid_round<3, 2, 4>(),
        final_round: invalid_final<4>(),
    }
}

const fn invalid_composition_pair<const DEPTH: usize>() -> CompositionQueryPair<DEPTH> {
    CompositionQueryPair {
        positive: Fr::zero(),
        negative: Fr::zero(),
        path: CompositionPairPath {
            valid: false,
            index: 0,
            positive_siblings: [Fr::zero(); DEPTH],
            negative_siblings: [Fr::zero(); DEPTH],
        },
    }
}

const fn invalid_query_pair<const ROUND: u32, const DEPTH: usize>() -> FriQueryPair<ROUND, DEPTH> {
    FriQueryPair {
        positive: Fr::zero(),
        negative: Fr::zero(),
        path: FriLayerPairPath {
            valid: false,
            index: 0,
            positive_siblings: [Fr::zero(); DEPTH],
            negative_siblings: [Fr::zero(); DEPTH],
        },
    }
}

/// Compile-time initializer for the caller-owned query workspace. A runtime
/// constructor would expose the complete authenticated opening as a flattened
/// Wasm multi-value result.
pub const INVALID_COMMITMENT_QUERY4X16: FriCommitmentQuery4x16 =
    FriCommitmentQuery4x16 {
        valid: false,
        terminal_step: 0,
        trace_length: 0,
        padded_length: 0,
        trace: TraceDigest { value: Fr::zero() },
        auxiliary: AuxiliaryDigest { value: Fr::zero() },
        main_lde_root: MainLdeDigest { value: Fr::zero() },
        auxiliary_lde_root: AuxiliaryLdeDigest { value: Fr::zero() },
        composition_root: CompositionDigest { value: Fr::zero() },
        first_root: FriLayerDigest { value: Fr::zero() },
        second_root: FriLayerDigest { value: Fr::zero() },
        third_root: FriLayerDigest { value: Fr::zero() },
        final_root: FriLayerDigest { value: Fr::zero() },
        query_index: 0,
        air_lde: INVALID_AIR_LDE_QUARTET_OPENING4X16,
        composition: invalid_composition_pair<3>(),
        first: invalid_query_pair<1, 2>(),
        second: invalid_query_pair<2, 1>(),
        third: invalid_query_pair<3, 0>(),
        final_evaluation: Fr::zero(),
    }

fn invalid_fri(_ composition: CompositionProof<16>) -> FriProof8 {
    FriProof8 {
        valid: false,
        composition: composition,
        evaluations: [Fr::zero(); 8],
        root: FriLayerDigest { value: Fr::zero() },
        transcript: FriLayerTranscriptDigest { value: Fr::zero() },
        next_challenge: FriFoldChallenge { value: Fr::zero() },
    }
}

/// One reusable FRI binary fold. `shift * H_N` is mapped to
/// `shift^2 * H_OUT`, where `OUT = N / 2`.
pub fn fold_fri_evaluations<const N: usize, const OUT: usize>(
    _ evaluations: own [Fr; N],
    _ challenge: Fr,
    _ shift: Fr,
) -> FriFoldEvaluations<OUT>
where N > 0, N > 1, { (N & (N - 1)) == 0 }, OUT > 0, { OUT + OUT == N }
{
    if shift.is_zero() {
        return invalid_fold<OUT>()
    }
    let inverse_two = Fr::from_u32(2).inverse_or_zero()
    let root = Field::two_adic_root(radix2_log<N>())
    let mut point = shift
    let mut folded = [Fr::zero(); OUT]
    let mut index: usize = 0
    while index < OUT {
        let positive = evaluations[index]
        let negative = evaluations[index + OUT]
        let even = (positive + negative) * inverse_two
        let odd = (positive - negative) * inverse_two * point.inverse_or_zero()
        folded[index] = even + challenge * odd
        point = point * root
        index = index + 1
    }
    FriFoldEvaluations { valid: true, evaluations: folded }
}

/// Fold a 16-point composition codeword to the squared eight-point domain.
/// For each pair `(f(x), f(-x))`, the next value is
/// `even(x^2) + challenge * odd(x^2)`.
pub fn fold_composition4x16(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ bound: u32,
    _ air_lde: mut AirLdeCommitment16,
) -> FriProof8 {
    let composition = compose4x16(c_re_q12, c_im_q12, bound, mut air_lde)
    if !composition.valid {
        return invalid_fri(composition)
    }

    let folded = fold_fri_evaluations<16, 8>(
        composition.evaluations,
        composition.fri.value,
        Fr::from_u32(5),
    )
    if !folded.valid {
        return invalid_fri(composition)
    }

    let layer_root = fri_layer_root_power_of_two<1, 8>(folded.evaluations)
    let transcript = bind_fri_layer(composition.transcript, layer_root)
    FriProof8 {
        valid: true,
        composition: composition,
        evaluations: folded.evaluations,
        root: layer_root,
        transcript: transcript,
        next_challenge: fri_next_fold_challenge<1, 2>(transcript),
    }
}

pub fn fold_next_fri_round<
    const PREVIOUS: u32,
    const ROUND: u32,
    const N: usize,
    const OUT: usize,
    const NEXT: u32,
>(
    _ evaluations: own [Fr; N],
    _ transcript: FriLayerTranscriptDigest<PREVIOUS>,
    _ challenge: FriFoldChallenge<ROUND>,
    _ shift: Fr,
) -> FriRound<ROUND, OUT, NEXT>
where
    {
        PREVIOUS > 0
    },
    {
        ROUND > 0
    },
    {
        ROUND == PREVIOUS + 1
    },
    {
        ROUND < 100
    },
    {
        NEXT == ROUND + 1
    },
    {
        NEXT < 100
    },
    N > 0,
    N > 1,
    {
        (N & (N - 1)) == 0
    },
    OUT > 0,
    OUT <= MAX_PADDED_TRACE_LENGTH,
    {
        (OUT & (OUT - 1)) == 0
    },
    {
        OUT + OUT == N
    }
{
    let folded = fold_fri_evaluations<N, OUT>(evaluations, challenge.value, shift)
    if !folded.valid {
        return invalid_round<ROUND, OUT, NEXT>()
    }
    let root = fri_layer_root_power_of_two<ROUND, OUT>(folded.evaluations)
    let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, root)
    FriRound {
        valid: true,
        evaluations: folded.evaluations,
        root: root,
        transcript: next_transcript,
        next_challenge: fri_next_fold_challenge<ROUND, NEXT>(next_transcript),
    }
}

pub fn fold_final_fri_round<const PREVIOUS: u32, const ROUND: u32>(
    _ evaluations: own [Fr; 2],
    _ transcript: FriLayerTranscriptDigest<PREVIOUS>,
    _ challenge: FriFoldChallenge<ROUND>,
    _ shift: Fr,
) -> FriFinalRound<ROUND>
where { PREVIOUS > 0 }, { ROUND > 0 }, { ROUND == PREVIOUS + 1 }, { ROUND < 100 }
{
    let folded = fold_fri_evaluations<2, 1>(evaluations, challenge.value, shift)
    if !folded.valid {
        return invalid_final<ROUND>()
    }
    let root = fri_layer_row_commitment<ROUND>(folded.evaluations[0])
    let next_transcript = bind_next_fri_layer<PREVIOUS, ROUND>(transcript, root)
    FriFinalRound {
        valid: true,
        evaluation: folded.evaluations[0],
        root: root,
        transcript: next_transcript,
    }
}

/// Materialize the complete 16-to-1 FRI commitment chain. Query openings and
/// verification remain separate protocol layers.
pub fn fold_all_composition4x16(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ bound: u32,
    _ air_lde: mut AirLdeCommitment16,
) -> FriProofComplete {
    let first = fold_composition4x16(c_re_q12, c_im_q12, bound, mut air_lde)
    if !first.valid {
        return invalid_complete(first)
    }
    let shift1 = Fr::from_u32(5)
    let shift2 = shift1.square()
    let second = fold_next_fri_round<1, 2, 8, 4, 3>(
        first.evaluations,
        first.transcript,
        first.next_challenge,
        shift2,
    )
    if !second.valid {
        return invalid_complete(first)
    }
    let shift3 = shift2.square()
    let third = fold_next_fri_round<2, 3, 4, 2, 4>(
        second.evaluations,
        second.transcript,
        second.next_challenge,
        shift3,
    )
    if !third.valid {
        return invalid_complete(first)
    }
    let final_round = fold_final_fri_round<3, 4>(
        third.evaluations,
        third.transcript,
        third.next_challenge,
        shift3.square(),
    )
    if !final_round.valid {
        return invalid_complete(first)
    }
    FriProofComplete {
        valid: true,
        first: first,
        second: second,
        third: third,
        final_round: final_round,
    }
}

/// Commit the complete fold chain and open the transcript-selected pair in
/// every layer. The paired positions are `index` and `index + N / 2`, which
/// are evaluations at `x` and `-x` on each radix-two domain.
pub fn open_fri_commitment_query4x16(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ bound: u32,
    _ complete: FriProofComplete,
    _ air_lde: AirLdeCommitment16,
    _ proof: mut FriCommitmentQuery4x16,
) -> bool {
    proof.valid = false
    if !complete.valid {
        return false
    }
    let commitments = stream_statement_q12(c_re_q12, c_im_q12, bound)
    if !commitments.valid || commitments.padded_length != 4 {
        return false
    }

    let query = fri_query_challenge<4, 1>(complete.final_round.transcript)
    let query_index = plain_words(query.value)[0] & 7
    let first_index = query_index & 3
    let second_index = first_index & 1

    let composition_path = composition_pair_path_power_of_two<16, 8, 3>(
        complete.first.composition.evaluations,
        query_index,
    )
    let first_path = fri_layer_pair_path_power_of_two<1, 8, 4, 2>(
        complete.first.evaluations,
        first_index,
    )
    let second_path = fri_layer_pair_path_power_of_two<2, 4, 2, 1>(
        complete.second.evaluations,
        second_index,
    )
    let third_path = fri_layer_pair_path_two<3>(complete.third.evaluations)
    let air_opened = open_air_lde_quartet4x16(
        c_re_q12,
        c_im_q12,
        bound,
        query_index,
        air_lde.main_leaves,
        air_lde.auxiliary_leaves,
        mut proof.air_lde,
    )
    if !composition_path.valid
        || !first_path.valid
        || !second_path.valid
        || !third_path.valid
        || !air_opened {
        return false
    }

    let composition_index: usize = query_index as usize
    let first_position: usize = first_index as usize
    let second_position: usize = second_index as usize
    proof.terminal_step = commitments.terminal_step
    proof.trace_length = commitments.trace_length
    proof.padded_length = commitments.padded_length
    proof.trace = commitments.trace
    proof.auxiliary = commitments.auxiliary
    proof.main_lde_root = air_lde.main_root
    proof.auxiliary_lde_root = air_lde.auxiliary_root
    proof.composition_root = complete.first.composition.root
    proof.first_root = complete.first.root
    proof.second_root = complete.second.root
    proof.third_root = complete.third.root
    proof.final_root = complete.final_round.root
    proof.query_index = query_index
    proof.composition = CompositionQueryPair {
        positive: complete.first.composition.evaluations[composition_index],
        negative: complete.first.composition.evaluations[composition_index + 8],
        path: composition_path,
    }
    proof.first = FriQueryPair {
        positive: complete.first.evaluations[first_position],
        negative: complete.first.evaluations[first_position + 4],
        path: first_path,
    }
    proof.second = FriQueryPair {
        positive: complete.second.evaluations[second_position],
        negative: complete.second.evaluations[second_position + 2],
        path: second_path,
    }
    proof.third = FriQueryPair {
        positive: complete.third.evaluations[0],
        negative: complete.third.evaluations[1],
        path: third_path,
    }
    proof.final_evaluation = complete.final_round.evaluation
    proof.valid = true
    true
}

pub fn prove_fri_commitment_query4x16(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ bound: u32,
    _ proof: mut FriCommitmentQuery4x16,
) -> bool {
    let mut air_lde = EMPTY_AIR_LDE_COMMITMENT16
    let complete = fold_all_composition4x16(c_re_q12, c_im_q12, bound, mut air_lde)
    open_fri_commitment_query4x16(c_re_q12, c_im_q12, bound, complete, air_lde, mut proof)
}

fn fold_pair_at<const N: usize>(
    _ positive: Fr,
    _ negative: Fr,
    _ challenge: Fr,
    _ shift: Fr,
    _ index: u32,
) -> Fr
where N > 0, N > 1, { (N & (N - 1)) == 0 }
{
    let root = Field::two_adic_root(radix2_log<N>())
    let point = shift * root.pow_u32(index)
    let folded = fold_fri_evaluations<2, 1>([positive, negative], challenge, point)
    folded.evaluations[0]
}

/// Verify the transcript, authenticated main and auxiliary AIR rows, the two
/// recomputed composition values, compact Merkle openings, and all four binary
/// FRI folds without regenerating the committed trace or composition codeword.
/// The Fe-derived canonical receipt decoder supplies this typed boundary and
/// rejects malformed words before the proof reaches these checks.
pub fn verify_fri_commitment_query4x16(
    _ c_re_q12: i32,
    _ c_im_q12: i32,
    _ bound: u32,
    _ proof: FriCommitmentQuery4x16,
) -> bool {
    if !proof.valid || proof.padded_length != 4 {
        return false
    }
    if escape_public_proof_domain_holds_q12(
            c_re_q12,
            c_im_q12,
            bound,
            proof.terminal_step,
            proof.trace_length,
            proof.padded_length,
        )
        == 0 {
        return false
    }

    let public = EscapesByQ12Public {
        c_re: encode_signed_word(c_re_q12),
        c_im: encode_signed_word(c_im_q12),
        bound: bound,
        terminal_step: proof.terminal_step,
        trace_length: proof.trace_length,
        padded_length: proof.padded_length,
    }
    let statement = bind_statement(public, proof.trace)
    let proof_transcript = bind_auxiliary_trace(statement, proof.auxiliary)
    let main_lde_transcript = bind_main_lde(proof_transcript, proof.main_lde_root)
    let air_lde_transcript = bind_auxiliary_lde(main_lde_transcript, proof.auxiliary_lde_root)
    let composition = composition_challenge(air_lde_transcript)
    let composition_transcript = bind_composition(air_lde_transcript, proof.composition_root)
    let first_challenge = fri_fold_challenge(composition_transcript)
    let first_transcript = bind_fri_layer(composition_transcript, proof.first_root)
    let second_challenge = fri_next_fold_challenge<1, 2>(first_transcript)
    let second_transcript = bind_next_fri_layer<1, 2>(first_transcript, proof.second_root)
    let third_challenge = fri_next_fold_challenge<2, 3>(second_transcript)
    let third_transcript = bind_next_fri_layer<2, 3>(second_transcript, proof.third_root)
    let fourth_challenge = fri_next_fold_challenge<3, 4>(third_transcript)
    let fourth_transcript = bind_next_fri_layer<3, 4>(third_transcript, proof.final_root)
    let query = fri_query_challenge<4, 1>(fourth_transcript)
    let query_index = plain_words(query.value)[0] & 7
    let first_index = query_index & 3
    let second_index = first_index & 1

    if proof.query_index != query_index
        || proof.composition.path.index != query_index
        || proof.first.path.index != first_index
        || proof.second.path.index != second_index
        || proof.third.path.index != 0 {
        return false
    }
    if !verify_composition_pair_path<3>(
            proof.composition.positive,
            proof.composition.negative,
            proof.composition.path,
            proof.composition_root,
        )
        || !verify_fri_layer_pair_path<1, 2>(
            proof.first.positive,
            proof.first.negative,
            proof.first.path,
            proof.first_root,
        )
        || !verify_fri_layer_pair_path<2, 1>(
            proof.second.positive,
            proof.second.negative,
            proof.second.path,
            proof.second_root,
        )
        || !verify_fri_layer_pair_path_two<3>(
            proof.third.positive,
            proof.third.negative,
            proof.third.path,
            proof.third_root,
        ) {
        return false
    }
    if !field_values_equal(
        fri_layer_row_commitment<4>(proof.final_evaluation).value,
        proof.final_root.value,
    ) {
        return false
    }
    if !verify_air_lde_quartet4x16(
        c_re_q12,
        c_im_q12,
        composition.value,
        query_index,
        proof.air_lde,
        proof.main_lde_root,
        proof.auxiliary_lde_root,
        proof.composition.positive,
        proof.composition.negative,
    ) {
        return false
    }

    let first_fold = fold_pair_at<16>(
        proof.composition.positive,
        proof.composition.negative,
        first_challenge.value,
        Fr::from_u32(5),
        query_index,
    )
    let expected_first = if query_index < 4 {
        proof.first.positive
    } else {
        proof.first.negative
    }
    if !field_values_equal(first_fold, expected_first) {
        return false
    }

    let shift2 = Fr::from_u32(5).square()
    let second_fold = fold_pair_at<8>(
        proof.first.positive,
        proof.first.negative,
        second_challenge.value,
        shift2,
        first_index,
    )
    let expected_second = if first_index < 2 {
        proof.second.positive
    } else {
        proof.second.negative
    }
    if !field_values_equal(second_fold, expected_second) {
        return false
    }

    let shift3 = shift2.square()
    let third_fold = fold_pair_at<4>(
        proof.second.positive,
        proof.second.negative,
        third_challenge.value,
        shift3,
        second_index,
    )
    let expected_third = if second_index == 0 {
        proof.third.positive
    } else {
        proof.third.negative
    }
    if !field_values_equal(third_fold, expected_third) {
        return false
    }

    let final_fold = fold_pair_at<2>(
        proof.third.positive,
        proof.third.negative,
        fourth_challenge.value,
        shift3.square(),
        0,
    )
    field_values_equal(final_fold, proof.final_evaluation)
}
