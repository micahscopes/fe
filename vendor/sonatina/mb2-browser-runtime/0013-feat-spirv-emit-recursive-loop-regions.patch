+    let header = fb.append_block();
+    let latch = fb.append_block();
+    let exit = fb.append_block();
+
+    fb.switch_to_block(entry);
+    let zero = fb.make_imm_value(0i32);
+    let eleven = fb.make_imm_value(11i32);
