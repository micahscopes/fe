             for ty in sig.args() {
-                match sonatina_to_waffle_type(*ty) {
+                match sonatina_to_waffle_type_in_ctx(&module.ctx, *ty) {
                     Some(wty) => params.push(wty),
                     None => {
                         return Err(format!(
@@ -148,7 +189,7 @@ pub(super) fn translate_module(
