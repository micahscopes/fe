---
 crates/codegen/src/isa/wasm/translate.rs | 56 +++++++++++++++++--
 crates/codegen/tests/wasm_backend.rs     | 71 ++++++++++++++++++++++++
 2 files changed, 122 insertions(+), 5 deletions(-)

diff --git a/crates/codegen/src/isa/wasm/translate.rs b/crates/codegen/src/isa/wasm/translate.rs
