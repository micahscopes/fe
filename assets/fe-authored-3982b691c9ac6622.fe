//! A small, genuinely useful Fe-authored colour surface.
//!
//! `GradientSurface` is a shader program declared as an `actor`: its uniform
//! state is the actor's fields, its one `FragmentSurface` behavior is the
//! per-pixel stage, and the compiler derives its render entry and mode. Drag
//! horizontally to rotate the gradient, vertically to move its centre, and
//! use the wheel to change its spread. The same typed
//! Fe parameter declaration owns the controls and transition policy.
//!
//! Software rendering (lavapipe/SwiftShader) in the sandbox; no performance
//! claim, no parallelism claim (VISION 3.1).

use std::webgpu::{
    FragmentSurface, GpuProgram, LatestPerFrame, ResponsiveBacking,
    SurfaceQuality, SurfaceScheduling, SurfaceTransition, WebGpuBackend,
}
use std::web::view::{
    ApplyParamBindings, Extent, Param, ParamBindingsProvider, Surface,
    SurfaceEvent, SurfaceState,
}
use fmath::{clamp01, cos, from_i32, mix, rgba, sin, smoothstep}
use gallery_palette::{electric_blue, spring_green}

/// The per-demo params record: field names bind, by name identity, to the
/// actor's state fields (checked at projection time).
struct GradientParams {
    angle: Param,
    offset: Param,
    spread: Param,
    res: Param,
}

struct GradientViewState {
    angle: f32,
    offset: f32,
    spread: f32,
    res: f32,
}

impl SurfaceState for GradientViewState {
    type Params = GradientParams
}

derive ApplyParamBindings for GradientViewState using ParamBindingsProvider

const fn gradient_params() -> GradientParams {
    GradientParams {
        angle: Param::angle(init: 0.55).drag_x(per_px: 0.01),
        offset: Param::range(min: -0.5, max: 0.5, init: 0.0)
            .drag_y(per_px: -0.002),
        spread: Param::range(min: 0.5, max: 4.0, init: 1.4)
            .wheel_scale(in_factor: 0.875, out_factor: 1.125),
        res: Param::extent_x(),
    }
}

actor GradientSurface uses (
    GpuProgram<WebGpuBackend>, SurfaceQuality<ResponsiveBacking>,
) {
    angle: f32,
    offset: f32,
    spread: f32,
    res: f32,

    /// The surface declaration: CTFE-evaluated at bundle time and projected
    /// into the manifest `surface` section. Never lowered to wasm or WGSL.
    const fn view() -> Surface<GradientParams> {
        Surface {
            extent: Extent::square(512),
            params: gradient_params(),
        }
    }

    fn navigate(self, event: own SurfaceEvent) -> GradientViewState
        uses (SurfaceTransition, SurfaceScheduling<LatestPerFrame>)
    {
        GradientViewState {
            angle: self.angle,
            offset: self.offset,
            spread: self.spread,
            res: self.res,
        }.apply_param_bindings(gradient_params(), event)
    }

    /// The fragment behavior: pixel coordinate in, packed RGBA8 word out. The
    /// uniform record is the actor's own fields, reached as `self.*`.
    fn shade(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        let u: f32 = (from_i32(px) + 0.5) / self.res - 0.5
        let v: f32 = (from_i32(py) + 0.5) / self.res - 0.5
        let axis: f32 = u * cos(self.angle) + v * sin(self.angle)
        let t: f32 = smoothstep(
            0.0, 1.0, clamp01(0.5 + self.offset + axis * self.spread),
        )
        let low = electric_blue()
        let high = spring_green()
        rgba(
            mix(low.red, high.red, t),
            mix(low.green, high.green, t),
            mix(low.blue, high.blue, t),
        )
    }
}
