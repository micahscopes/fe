//! Event Studio: a resident Fe component driven by typed browser streams.
//!
//! The browser owns standards listeners only while an observation is pending.
//! Affine subscriptions and Fe tasks own iteration, quantization, failure
//! policy, actor delivery, state, and DOM projection. There is no JavaScript
//! application callback or hidden host-side reactive graph.

use core::actor::{ActorSink, ScopedTask}
use core::Fn
use core::pending::{Suspend, TaskOutcome, Timer}
use std::actor::{ActorMessage, BrowserActorSink, forward_to_actor}
use std::reactive::{BoundedQueue, Event, EventSource, Latest, OverflowPolicy, Stream, latest}
use std::host::{HostTimer, Resumable, sleep}
use std::wasm::WasmBackend
use std::web::component_events::{
    BrowserPointerEvents,
    BrowserWheelEvents,
    PointerSample,
    WheelSample,
}
use std::web::document_events::{BrowserVisibilityEvents, DocumentVisibility}
use std::web::window_events::{
    AnimationFrame,
    BrowserAnimationFrames,
    BrowserViewportEvents,
    Viewport,
}
use std::web::component::{
    BrowserBytes,
    ComponentEvent,
    ComponentEventKind,
    ComponentPatch,
    ComponentWriter,
    InitialState,
    ProjectState,
    ResidentTransition,
    allocate_component_buffer,
}
use std::web::identity::{
    ComponentAction,
    ComponentActionProvider,
    ComponentSchema,
    ComponentSchemaProvider,
    Part,
    Text,
}
use std::web::page::{
    ComponentComposition,
    ComponentView,
    PageAttribute,
    PageBuilder,
    PageElement,
    PageText,
}

const PATCH_CAPACITY: u32 = 1024
const VIEW_CAPACITY: usize = 184
const FRAME_PACE_MS: u64 = 500

extern {
    fn __i32_from_f32(_: f32) -> i32
}

const fn ui_text(value: String<31>) -> PageText {
    PageText::one(value: value)
}

enum StudioAction {
    Unknown,
    ViewportObserved,
    PointerObserved,
    WheelObserved,
    StreamFailed,
    VisibilityObserved,
    FrameObserved,
    TimerElapsed,
}

impl Copy for StudioAction {}

/// One nominal mailbox payload. The compiler derives its scalar Wasm shape;
/// neither the task nor the fixed browser boundary assigns field IDs or packs
/// values into an application-specific integer protocol.
struct StudioTask {
    viewport_width: f32,
    viewport_height: f32,
    viewport_device_pixel_ratio: f32,
    pointer_id: u32,
    pointer_x: f32,
    pointer_y: f32,
    pointer_buttons: u32,
    wheel_delta_y: f32,
    document_hidden: bool,
    frame_timestamp: f32,
    error: u32,
    bounded_drops: u32,
    latest_value: u32,
}

impl Copy for StudioTask {}

derive ComponentAction for StudioAction using ComponentActionProvider

struct StudioParts {
    width: Part<Text>,
    height: Part<Text>,
    pixel_ratio: Part<Text>,
    observations: Part<Text>,
    pointer_x: Part<Text>,
    pointer_y: Part<Text>,
    pointer_events: Part<Text>,
    wheel_events: Part<Text>,
    visible: Part<Text>,
    visibility_events: Part<Text>,
    frame_events: Part<Text>,
    timer_events: Part<Text>,
    frame_timestamp: Part<Text>,
    bounded_drops: Part<Text>,
    latest_value: Part<Text>,
    failures: Part<Text>,
}

derive ComponentSchema for StudioParts using ComponentSchemaProvider

pub struct StudioState {
    pub patch_ptr: u32,
    pub width: u32,
    pub height: u32,
    pub pixel_ratio_percent: u32,
    pub observations: u32,
    pub pointer_x: u32,
    pub pointer_y: u32,
    pub pointer_events: u32,
    pub wheel_events: u32,
    pub visible: bool,
    pub visibility_events: u32,
    pub frame_events: u32,
    pub timer_events: u32,
    pub frame_timestamp: u32,
    pub bounded_drops: u32,
    pub latest_value: u32,
    pub failures: u32,
    pub connected: bool,
}

fn bounded_dimension(value: f32) -> u32 {
    let bounded = if value >= 0.0 && value <= 100000.0 {
        value
    } else {
        100000.0
    }
    __i32_from_f32(bounded).downcast_unchecked()
}

fn bounded_pixel_ratio(value: f32) -> u32 {
    let percent = value * 100.0
    let bounded = if percent >= 0.0 && percent <= 10000.0 {
        percent
    } else {
        10000.0
    }
    __i32_from_f32(bounded).downcast_unchecked()
}

fn bounded_position(value: f32) -> u32 {
    let bounded = if value < 0.0 {
        0.0
    } else {
        if value <= 100000.0 { value } else { 100000.0 }
    }
    __i32_from_f32(bounded).downcast_unchecked()
}

fn viewport_task(viewport: Viewport) -> StudioTask {
    StudioTask {
        viewport_width: viewport.width,
        viewport_height: viewport.height,
        viewport_device_pixel_ratio: viewport.device_pixel_ratio,
        pointer_id: 0,
        pointer_x: 0.0,
        pointer_y: 0.0,
        pointer_buttons: 0,
        wheel_delta_y: 0.0,
        document_hidden: false,
        frame_timestamp: 0.0,
        error: 0,
        bounded_drops: 0,
        latest_value: 0,
    }
}

fn pointer_task(sample: PointerSample) -> StudioTask {
    StudioTask {
        viewport_width: 0.0,
        viewport_height: 0.0,
        viewport_device_pixel_ratio: 0.0,
        pointer_id: sample.pointer_id,
        pointer_x: sample.client_x,
        pointer_y: sample.client_y,
        pointer_buttons: sample.buttons,
        wheel_delta_y: 0.0,
        document_hidden: false,
        frame_timestamp: 0.0,
        error: 0,
        bounded_drops: 0,
        latest_value: 0,
    }
}

fn wheel_task(sample: WheelSample) -> StudioTask {
    StudioTask {
        viewport_width: 0.0,
        viewport_height: 0.0,
        viewport_device_pixel_ratio: 0.0,
        pointer_id: 0,
        pointer_x: sample.client_x,
        pointer_y: sample.client_y,
        pointer_buttons: 0,
        wheel_delta_y: sample.delta_y,
        document_hidden: false,
        frame_timestamp: 0.0,
        error: 0,
        bounded_drops: 0,
        latest_value: 0,
    }
}

fn visibility_task(visibility: DocumentVisibility) -> StudioTask {
    StudioTask {
        viewport_width: 0.0,
        viewport_height: 0.0,
        viewport_device_pixel_ratio: 0.0,
        pointer_id: 0,
        pointer_x: 0.0,
        pointer_y: 0.0,
        pointer_buttons: 0,
        wheel_delta_y: 0.0,
        document_hidden: match visibility {
            DocumentVisibility::Visible => false,
            DocumentVisibility::Hidden => true,
        },
        frame_timestamp: 0.0,
        error: 0,
        bounded_drops: 0,
        latest_value: 0,
    }
}

fn frame_task(frame: AnimationFrame) -> StudioTask {
    StudioTask {
        viewport_width: 0.0,
        viewport_height: 0.0,
        viewport_device_pixel_ratio: 0.0,
        pointer_id: 0,
        pointer_x: 0.0,
        pointer_y: 0.0,
        pointer_buttons: 0,
        wheel_delta_y: 0.0,
        document_hidden: false,
        frame_timestamp: frame.timestamp,
        error: 0,
        bounded_drops: 0,
        latest_value: 0,
    }
}

fn timer_task(sequence: u32) -> StudioTask {
    // A deterministic four-value producer burst enters a three-slot Fe queue.
    // This is an explicit acceptance probe for policy semantics, not a claim
    // that browser pointer delivery is already concurrently buffered in Fe.
    let base = sequence * 4
    let mut queue: BoundedQueue<u32> = BoundedQueue::new(initial: 0, capacity: 3)
    queue = queue.offer(value: base + 1, overflow: OverflowPolicy::DropNewest)
    queue = queue.offer(value: base + 2, overflow: OverflowPolicy::DropNewest)
    queue = queue.offer(value: base + 3, overflow: OverflowPolicy::DropNewest)
    queue = queue.offer(value: base + 4, overflow: OverflowPolicy::DropNewest)
    let mut newest: Latest<u32> = latest(initial: 0)
    newest = newest.offer(value: base + 1, overflow: OverflowPolicy::KeepLatest)
    newest = newest.offer(value: base + 4, overflow: OverflowPolicy::KeepLatest)
    StudioTask {
        viewport_width: 0.0,
        viewport_height: 0.0,
        viewport_device_pixel_ratio: 0.0,
        pointer_id: 0,
        pointer_x: 0.0,
        pointer_y: 0.0,
        pointer_buttons: 0,
        wheel_delta_y: 0.0,
        document_hidden: false,
        frame_timestamp: 0.0,
        error: 0,
        bounded_drops: queue.dropped(),
        latest_value: newest.front().value_or(fallback: 0),
    }
}

fn failed_task(error: u32) -> StudioTask {
    StudioTask {
        viewport_width: 0.0,
        viewport_height: 0.0,
        viewport_device_pixel_ratio: 0.0,
        pointer_id: 0,
        pointer_x: 0.0,
        pointer_y: 0.0,
        pointer_buttons: 0,
        wheel_delta_y: 0.0,
        document_hidden: false,
        frame_timestamp: 0.0,
        error: error,
        bounded_drops: 0,
        latest_value: 0,
    }
}

fn task_message(target: StudioAction, payload: StudioTask) -> ComponentEvent<
    StudioAction,
    StudioTask,
> {
    ComponentEvent<StudioAction, StudioTask>::task_payload(target: target, payload: payload)
}

struct ViewportMessage {}
struct PointerMessage {}
struct WheelMessage {}
struct VisibilityMessage {}
struct FailureMessage {}

impl Copy for ViewportMessage {}
impl Copy for PointerMessage {}
impl Copy for WheelMessage {}
impl Copy for VisibilityMessage {}
impl Copy for FailureMessage {}

impl Fn<Viewport, ComponentEvent<StudioAction, StudioTask>> for ViewportMessage {
    fn call(self, _ viewport: own Viewport) -> ComponentEvent<StudioAction, StudioTask> {
        task_message(
            target: StudioAction::ViewportObserved,
            payload: viewport_task(viewport),
        )
    }
}

impl Fn<PointerSample, ComponentEvent<StudioAction, StudioTask>> for PointerMessage {
    fn call(self, _ sample: own PointerSample) -> ComponentEvent<StudioAction, StudioTask> {
        task_message(
            target: StudioAction::PointerObserved,
            payload: pointer_task(sample),
        )
    }
}

impl Fn<WheelSample, ComponentEvent<StudioAction, StudioTask>> for WheelMessage {
    fn call(self, _ sample: own WheelSample) -> ComponentEvent<StudioAction, StudioTask> {
        task_message(
            target: StudioAction::WheelObserved,
            payload: wheel_task(sample),
        )
    }
}

impl Fn<DocumentVisibility, ComponentEvent<StudioAction, StudioTask>> for VisibilityMessage {
    fn call(self, _ visibility: own DocumentVisibility) -> ComponentEvent<
        StudioAction,
        StudioTask,
    > {
        task_message(
            target: StudioAction::VisibilityObserved,
            payload: visibility_task(visibility),
        )
    }
}

impl Fn<u32, ComponentEvent<StudioAction, StudioTask>> for FailureMessage {
    fn call(self, _ error: own u32) -> ComponentEvent<StudioAction, StudioTask> {
        task_message(
            target: StudioAction::StreamFailed,
            payload: failed_task(error),
        )
    }
}

fn report(target: StudioAction, payload: StudioTask) -> bool
uses (
    sink: mut ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>>,
    suspend: Suspend<WasmBackend, u32>,
)
{
    let event = task_message(target: target, payload: payload)
    let outcome: TaskOutcome<u32, ()> = ActorMessage::new(event).send()
    match outcome {
        TaskOutcome::Success(_,) => true,
        TaskOutcome::Failure(_,) => false,
        TaskOutcome::Cancelled => false,
    }
}

fn observe_viewports() -> u32
uses (
    viewport_events: mut EventSource<Viewport>,
    sink: mut ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>>,
    suspend: Suspend<WasmBackend, u32>,
)
{
    forward_to_actor(map: ViewportMessage {}, map_failure: FailureMessage {}).delivered
}

fn observe_pointers() -> u32
uses (
    pointer_events: mut EventSource<PointerSample>,
    sink: mut ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>>,
    suspend: Suspend<WasmBackend, u32>,
)
{
    forward_to_actor(map: PointerMessage {}, map_failure: FailureMessage {}).delivered
}

fn observe_wheels() -> u32
uses (
    wheel_events: mut EventSource<WheelSample>,
    sink: mut ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>>,
    suspend: Suspend<WasmBackend, u32>,
)
{
    forward_to_actor(map: WheelMessage {}, map_failure: FailureMessage {}).delivered
}

fn observe_visibility() -> u32
uses (
    visibility_events: mut EventSource<DocumentVisibility>,
    sink: mut ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>>,
    suspend: Suspend<WasmBackend, u32>,
)
{
    forward_to_actor(map: VisibilityMessage {}, map_failure: FailureMessage {}).delivered
}

/// Pull one animation frame only after the Fe timer interval has elapsed.
/// Browser callbacks realize the two raw clocks; this loop owns their ordering,
/// rate, cancellation, failure policy, and actor delivery.
fn observe_paced_frames() -> u32
uses (
    frame_events: mut EventSource<AnimationFrame>,
    timer: mut Timer<WasmBackend>,
    sink: mut ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>>,
    suspend: Suspend<WasmBackend, u32>,
)
{
    let stream: Stream<AnimationFrame> = Stream::new()
    let mut subscription = stream.subscribe()
    let mut observations: u32 = 0
    let mut running = true
    while running {
        match sleep(milliseconds: FRAME_PACE_MS) {
            TaskOutcome::Success(_,) => {
                running = report(
                    target: StudioAction::TimerElapsed,
                    payload: timer_task(sequence: observations),
                )
                if running {
                    let next = stream.next_ready(subscription)
                    subscription = next.0
                    match next.1 {
                        Event::Occurrence(frame,) => {
                            running = report(
                                target: StudioAction::FrameObserved,
                                payload: frame_task(frame),
                            )
                            if running {
                                observations = observations + 1
                            }
                        },
                        Event::Absent => {},
                        Event::End => {
                            running = false
                        },
                        Event::Failure(error,) => {
                            report(
                                target: StudioAction::StreamFailed,
                                payload: failed_task(error),
                            )
                            running = false
                        },
                        Event::Cancelled => {
                            stream.cancel(subscription)
                            return observations
                        },
                    }
                }
            },
            TaskOutcome::Failure(error,) => {
                report(
                    target: StudioAction::StreamFailed,
                    payload: failed_task(error),
                )
                running = false
            },
            TaskOutcome::Cancelled => {
                stream.cancel(subscription)
                return observations
            },
        }
    }
    stream.cancel(subscription)
    observations
}

actor EventStudio {
    patch_ptr: u32,
    width: u32,
    height: u32,
    pixel_ratio_percent: u32,
    observations: u32,
    pointer_x: u32,
    pointer_y: u32,
    pointer_events: u32,
    wheel_events: u32,
    visible: bool,
    visibility_events: u32,
    frame_events: u32,
    timer_events: u32,
    frame_timestamp: u32,
    bounded_drops: u32,
    latest_value: u32,
    failures: u32,
    connected: bool,

    const fn view() -> ComponentView<VIEW_CAPACITY> uses (ComponentComposition) {
        let ui = <StudioParts as ComponentSchema>::component_parts()
        PageBuilder::new()
            .open(element: PageElement::Section)
            .attribute(value: PageAttribute::class(value: "event-studio-panel"))
            .open(element: PageElement::Heading2)
            .text(value: ui_text(value: "Event Studio"))
            .close()
            .open(element: PageElement::Paragraph)
            .attribute(value: PageAttribute::class(value: "event-studio-copy"))
            .text(value: ui_text(value: "Resize, point, touch, or "))
            .text(value: ui_text(value: "wheel: typed Fe streams own "))
            .text(value: ui_text(value: "update."))
            .close()
            .open(element: PageElement::Paragraph)
            .attribute(value: PageAttribute::class(value: "event-studio-copy"))
            .text(value: ui_text(value: "A deterministic Fe burst makes "))
            .text(value: ui_text(value: "bounded drops and latest-value "))
            .text(value: ui_text(value: "replacement visible."))
            .close()
            .open(element: PageElement::Div)
            .attribute(value: PageAttribute::class(value: "event-studio-grid"))
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "width · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.width))
            .text(value: ui_text(value: "0"))
            .close()
            .text(value: ui_text(value: " css px"))
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "height · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.height))
            .text(value: ui_text(value: "0"))
            .close()
            .text(value: ui_text(value: " css px"))
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "dpr × 100 · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.pixel_ratio))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "pointer x · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.pointer_x))
            .text(value: ui_text(value: "0"))
            .close()
            .text(value: ui_text(value: " css px"))
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "pointer y · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.pointer_y))
            .text(value: ui_text(value: "0"))
            .close()
            .text(value: ui_text(value: " css px"))
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "pointer events · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.pointer_events))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "wheel events · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.wheel_events))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "document visible · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.visible))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "visibility events · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.visibility_events))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "paced frames · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.frame_events))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "timer ticks · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.timer_events))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "last frame ms · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.frame_timestamp))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "bounded drops · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.bounded_drops))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "latest sample · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.latest_value))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "observations · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.observations))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "failures · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.failures))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .close()
            .close()
            .finish_component()
    }

    fn initial() -> StudioState uses (InitialState) {
        let patch = allocate_component_buffer(capacity: PATCH_CAPACITY)
        StudioState {
            patch_ptr: patch.ptr,
            width: 0,
            height: 0,
            pixel_ratio_percent: 0,
            observations: 0,
            pointer_x: 0,
            pointer_y: 0,
            pointer_events: 0,
            wheel_events: 0,
            visible: false,
            visibility_events: 0,
            frame_events: 0,
            timer_events: 0,
            frame_timestamp: 0,
            bounded_drops: 0,
            latest_value: 0,
            failures: 0,
            connected: false,
        }
    }

    fn watch_viewport() -> u32 uses (ScopedTask) {
        with (
            EventSource<Viewport> = BrowserViewportEvents::new(),
            ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>> = BrowserActorSink {},
            Suspend<WasmBackend, u32> = Resumable {},
        ) {
            observe_viewports()
        }
    }

    fn watch_pointer() -> u32 uses (ScopedTask) {
        with (
            EventSource<PointerSample> = BrowserPointerEvents::new(),
            ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>> = BrowserActorSink {},
            Suspend<WasmBackend, u32> = Resumable {},
        ) {
            observe_pointers()
        }
    }

    fn watch_wheel() -> u32 uses (ScopedTask) {
        with (
            EventSource<WheelSample> = BrowserWheelEvents::new(),
            ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>> = BrowserActorSink {},
            Suspend<WasmBackend, u32> = Resumable {},
        ) {
            observe_wheels()
        }
    }

    fn watch_visibility() -> u32 uses (ScopedTask) {
        with (
            EventSource<DocumentVisibility> = BrowserVisibilityEvents::new(),
            ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>> = BrowserActorSink {},
            Suspend<WasmBackend, u32> = Resumable {},
        ) {
            observe_visibility()
        }
    }

    fn watch_frame_clock() -> u32 uses (ScopedTask) {
        with (
            EventSource<AnimationFrame> = BrowserAnimationFrames::new(),
            Timer<WasmBackend> = HostTimer {},
            ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>> = BrowserActorSink {},
            Suspend<WasmBackend, u32> = Resumable {},
        ) {
            observe_paced_frames()
        }
    }

    fn receive(self, event: own ComponentEvent<StudioAction, StudioTask>) -> StudioState
        uses (ResidentTransition)
    {
        let mut width = self.width
        let mut height = self.height
        let mut pixel_ratio_percent = self.pixel_ratio_percent
        let mut observations = self.observations
        let mut pointer_x = self.pointer_x
        let mut pointer_y = self.pointer_y
        let mut pointer_events = self.pointer_events
        let mut wheel_events = self.wheel_events
        let mut visible = self.visible
        let mut visibility_events = self.visibility_events
        let mut frame_events = self.frame_events
        let mut timer_events = self.timer_events
        let mut frame_timestamp = self.frame_timestamp
        let mut bounded_drops = self.bounded_drops
        let mut latest_value = self.latest_value
        let mut failures = self.failures
        let mut connected = self.connected
        match event.kind {
            ComponentEventKind::Connected => { connected = true }
            ComponentEventKind::Disconnected => { connected = false }
            ComponentEventKind::TaskMessage => {
                if connected {
                    match event.target {
                        StudioAction::ViewportObserved => {
                            width = bounded_dimension(value: event.task.viewport_width)
                            height = bounded_dimension(value: event.task.viewport_height)
                            pixel_ratio_percent = bounded_pixel_ratio(
                                value: event.task.viewport_device_pixel_ratio,
                            )
                            observations = observations + 1
                        }
                        StudioAction::PointerObserved => {
                            pointer_x = bounded_position(value: event.task.pointer_x)
                            pointer_y = bounded_position(value: event.task.pointer_y)
                            pointer_events = pointer_events + 1
                        }
                        StudioAction::WheelObserved => {
                            pointer_x = bounded_position(value: event.task.pointer_x)
                            pointer_y = bounded_position(value: event.task.pointer_y)
                            wheel_events = wheel_events + 1
                        }
                        StudioAction::VisibilityObserved => {
                            visible = !event.task.document_hidden
                            visibility_events = visibility_events + 1
                        }
                        StudioAction::FrameObserved => {
                            frame_timestamp = bounded_dimension(value: event.task.frame_timestamp)
                            frame_events = frame_events + 1
                        }
                        StudioAction::TimerElapsed => {
                            timer_events = timer_events + 1
                            bounded_drops = bounded_drops + event.task.bounded_drops
                            latest_value = event.task.latest_value
                        }
                        StudioAction::StreamFailed => { failures = failures + 1 }
                        _ => {}
                    }
                }
            }
            _ => {}
        }
        StudioState {
            patch_ptr: self.patch_ptr,
            width: width,
            height: height,
            pixel_ratio_percent: pixel_ratio_percent,
            observations: observations,
            pointer_x: pointer_x,
            pointer_y: pointer_y,
            pointer_events: pointer_events,
            wheel_events: wheel_events,
            visible: visible,
            visibility_events: visibility_events,
            frame_events: frame_events,
            timer_events: timer_events,
            frame_timestamp: frame_timestamp,
            bounded_drops: bounded_drops,
            latest_value: latest_value,
            failures: failures,
            connected: connected,
        }
    }

    fn project(self) -> ComponentPatch uses (ProjectState) {
        let ui = <StudioParts as ComponentSchema>::component_parts()
        let writer = ComponentWriter::new(
            buffer: BrowserBytes { ptr: self.patch_ptr, len: PATCH_CAPACITY },
        )
            .set_u32_text(target: ui.width, value: self.width)
            .set_u32_text(target: ui.height, value: self.height)
            .set_u32_text(target: ui.pixel_ratio, value: self.pixel_ratio_percent)
            .set_u32_text(target: ui.observations, value: self.observations)
            .set_u32_text(target: ui.pointer_x, value: self.pointer_x)
            .set_u32_text(target: ui.pointer_y, value: self.pointer_y)
            .set_u32_text(target: ui.pointer_events, value: self.pointer_events)
            .set_u32_text(target: ui.wheel_events, value: self.wheel_events)
            .set_u32_text(target: ui.visible, value: if self.visible { 1 } else { 0 })
            .set_u32_text(target: ui.visibility_events, value: self.visibility_events)
            .set_u32_text(target: ui.frame_events, value: self.frame_events)
            .set_u32_text(target: ui.timer_events, value: self.timer_events)
            .set_u32_text(target: ui.frame_timestamp, value: self.frame_timestamp)
            .set_u32_text(target: ui.bounded_drops, value: self.bounded_drops)
            .set_u32_text(target: ui.latest_value, value: self.latest_value)
            .set_u32_text(target: ui.failures, value: self.failures)
        ComponentPatch::new(
            visible_mask: 0,
            focus_target: StudioAction::Unknown,
            prevent_default: false,
            commands: writer.finish(),
        )
    }
}
