//! The smallest visible typed WebGPU pass graph.
//!
//! `seed` writes one POD record in a 1x1x1 compute dispatch. `paint` reads the
//! same record in the fragment stage and turns its two words into a fixed
//! color. Every stage, resource, record field, load, and store is Fe-authored.

use std::webgpu::{
    ComputeSurface as Kernel,
    FixedDispatch as Once,
    FragmentSurface as Pixel,
    GpuProgram as Program,
    ResponsiveBacking,
    StandardSurfaceRecovery,
    StorageBuffer as Shared,
    SurfaceQuality,
    SurfaceRecovery,
    Workgroup as Threads,
    WebGpuBackend,
}

pub struct ComplexF32Bits {
    pub re_bits: u32,
    pub im_bits: u32,
}

actor KnownColor uses (
    Program<WebGpuBackend>, SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    orbit: Shared<ComplexF32Bits, 1>,

    fn seed(self) uses (Kernel<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        self.orbit.store(
            index: 0,
            value: ComplexF32Bits {
                re_bits: 1065353216,
                im_bits: 3221225472,
            },
        )
    }

    fn paint(self, px: i32, py: i32) -> i32 uses (Pixel) {
        let sample: ComplexF32Bits = self.orbit.load(index: 0)
        (sample.re_bits ^ sample.im_bits).downcast_truncate()
    }
}
