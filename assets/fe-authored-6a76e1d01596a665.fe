//! Canonical gallery composition, authored as one const Fe page actor.
//!
//! `GalleryBuilder` is application code: its compact tile/component helpers
//! expand into the general `std::web::page` operation vocabulary during CTFE.
//! The HTML precompiler only knows standards nodes plus generic render and
//! resident-program declarations; it contains no gallery titles, paths, tile
//! structure, Todo markup, or SourceInspector policy.

use std::web::page::{
    Page, PageAttribute, PageBuilder, PageComposition, PageElement, PageText,
}

const CAPACITY: usize = 512

const fn t(_ value: String<31>) -> PageText {
    PageText::one(value: value)
}

const fn t2(_ first: String<31>, _ second: String<31>) -> PageText {
    PageText::two(first: first, second: second)
}

const fn t3(_ first: String<31>, _ second: String<31>, _ third: String<31>) -> PageText {
    PageText::three(first: first, second: second, third: third)
}

struct GalleryBuilder {
    page: PageBuilder<CAPACITY>,
}

impl GalleryBuilder {
    const fn new() -> Self {
        let page = PageBuilder::new()
            .component(
                source: t2("sketches/source_inspector/", "src/lib.fe"),
                mount: "gallery-shell",
            )
            .open(element: PageElement::FeComponent)
            .attribute(value: PageAttribute::id(value: "gallery-shell"))
            .attribute(value: PageAttribute::class(value: "gallery-shell"))
            .open(element: PageElement::Header)
            .attribute(value: PageAttribute::class(value: "gallery-head"))
            .open(element: PageElement::Heading1)
            .text(value: t("fe web · gallery"))
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: t("Fe-authored GPU, control, "))
            .text(value: t("resident component, and page "))
            .text(value: t("programs, with generated WGSL/"))
            .text(value: t("Wasm hosted by fixed demo-"))
            .text(value: t("blind browser adapters. Serve "))
            .text(value: t("with "))
            .open(element: PageElement::Code)
            .text(value: t("fe web dev demos/gallery.html"))
            .close()
            .text(value: t("."))
            .close()
            .open(element: PageElement::Anchor)
            .attribute(value: PageAttribute::href(value: t2("sketches/gallery_page/", "src/lib.fe")))
            .attribute(value: PageAttribute::publish())
            .attribute(value: PageAttribute::action(value: 100))
            .text(value: t("page source"))
            .close()
            .close()
            .open(element: PageElement::Div)
            .attribute(value: PageAttribute::class(value: "grid"))
        Self { page: page }
    }

    const fn caption(
        self,
        title: PageText,
        description: PageText,
        source: PageText,
    ) -> Self {
        let page = self.page
            .open(element: PageElement::Figcaption)
            .open(element: PageElement::Bold)
            .text(value: title)
            .close()
            .open(element: PageElement::Span)
            .attribute(value: PageAttribute::class(value: "desc"))
            .text(value: description)
            .close()
            .open(element: PageElement::Anchor)
            .attribute(value: PageAttribute::href(value: source))
            .attribute(value: PageAttribute::publish())
            .attribute(value: PageAttribute::action(value: 100))
            .text(value: t("source"))
            .close()
            .close()
        Self { page: page }
    }

    const fn render_tile(
        self,
        title: PageText,
        description: PageText,
        source: PageText,
        program: PageText,
    ) -> Self {
        let builder = Self {
            page: self.page.open(element: PageElement::Figure),
        }.caption(title: title, description: description, source: source)
        let page = builder.page
            .render(
                source: program,
                wgsl_action: 101,
                wasm_action: 102,
                manifest_action: 103,
            )
            .close()
        Self { page: page }
    }

    const fn todo_tile(self) -> Self {
        let builder = Self {
            page: self.page.open(element: PageElement::Figure),
        }.caption(
            title: t("TodoMVC"),
            description: t2("resident Fe state → keyed ", "DOM effects"),
            source: t("sketches/todomvc/src/lib.fe"),
        )
        let page = builder.page
            .component(source: t("sketches/todomvc/src/lib.fe"), mount: "gallery-todomvc")
            .open(element: PageElement::FeComponent)
            .attribute(value: PageAttribute::id(value: "gallery-todomvc"))
            .attribute(value: PageAttribute::class(value: "todo-app"))
            .open(element: PageElement::Heading2)
            .attribute(value: PageAttribute::class(value: "todo-heading"))
            .text(value: t("todos"))
            .close()
            .open(element: PageElement::Header)
            .open(element: PageElement::Input)
            .attribute(value: PageAttribute::class(value: "new-todo"))
            .attribute(value: PageAttribute::node(value: 5))
            .attribute(value: PageAttribute::action(value: 1))
            .attribute(value: PageAttribute::placeholder(value: "What needs to be done?"))
            .attribute(value: PageAttribute::autocomplete(value: "off"))
            .close()
            .close()
            .open(element: PageElement::Section)
            .attribute(value: PageAttribute::class(value: "main"))
            .attribute(value: PageAttribute::node(value: 1))
            .attribute(value: PageAttribute::hidden())
            .open(element: PageElement::Input)
            .attribute(value: PageAttribute::id(value: "gallery-toggle-all"))
            .attribute(value: PageAttribute::class(value: "toggle-all"))
            .attribute(value: PageAttribute::node(value: 6))
            .attribute(value: PageAttribute::action(value: 2))
            .attribute(value: PageAttribute::input_type(value: "checkbox"))
            .attribute(value: PageAttribute::aria_label(value: "Mark all as complete"))
            .close()
            .open(element: PageElement::Label)
            .attribute(value: PageAttribute::class(value: "toggle-all-label"))
            .attribute(value: PageAttribute::for_id(value: "gallery-toggle-all"))
            .attribute(value: PageAttribute::title(value: "Mark all as complete"))
            .text(value: t("⌄"))
            .close()
            .open(element: PageElement::UnorderedList)
            .attribute(value: PageAttribute::class(value: "todo-list"))
            .attribute(value: PageAttribute::node(value: 3))
            .close()
            .close()
            .open(element: PageElement::Footer)
            .attribute(value: PageAttribute::class(value: "footer"))
            .attribute(value: PageAttribute::node(value: 2))
            .attribute(value: PageAttribute::hidden())
            .open(element: PageElement::Span)
            .attribute(value: PageAttribute::class(value: "todo-count"))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: 4))
            .text(value: t("0"))
            .close()
            .text(value: t(" items left"))
            .close()
            .open(element: PageElement::UnorderedList)
            .attribute(value: PageAttribute::class(value: "filters"))
            .open(element: PageElement::ListItem)
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::node(value: 7))
            .attribute(value: PageAttribute::action(value: 4))
            .attribute(value: PageAttribute::class_token(slot: 1, value: "selected"))
            .text(value: t("All"))
            .close()
            .close()
            .open(element: PageElement::ListItem)
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::node(value: 8))
            .attribute(value: PageAttribute::action(value: 5))
            .attribute(value: PageAttribute::class_token(slot: 1, value: "selected"))
            .text(value: t("Active"))
            .close()
            .close()
            .open(element: PageElement::ListItem)
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::node(value: 9))
            .attribute(value: PageAttribute::action(value: 6))
            .attribute(value: PageAttribute::class_token(slot: 1, value: "selected"))
            .text(value: t("Completed"))
            .close()
            .close()
            .close()
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::class(value: "clear-completed"))
            .attribute(value: PageAttribute::action(value: 3))
            .text(value: t("Clear completed"))
            .close()
            .close()
            .open(element: PageElement::Template)
            .attribute(value: PageAttribute::template(value: 1))
            .open(element: PageElement::ListItem)
            .attribute(value: PageAttribute::class_token(slot: 1, value: "completed"))
            .attribute(value: PageAttribute::class_token(slot: 2, value: "editing"))
            .open(element: PageElement::Div)
            .attribute(value: PageAttribute::class(value: "view"))
            .open(element: PageElement::Input)
            .attribute(value: PageAttribute::class(value: "toggle"))
            .attribute(value: PageAttribute::node(value: 10))
            .attribute(value: PageAttribute::action(value: 10))
            .attribute(value: PageAttribute::input_type(value: "checkbox"))
            .close()
            .open(element: PageElement::Label)
            .attribute(value: PageAttribute::node(value: 11))
            .attribute(value: PageAttribute::action(value: 11))
            .close()
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::class(value: "edit-button"))
            .attribute(value: PageAttribute::action(value: 14))
            .attribute(value: PageAttribute::aria_label(value: "Edit todo"))
            .attribute(value: PageAttribute::title(value: "Edit"))
            .text(value: t("✎"))
            .close()
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::class(value: "destroy"))
            .attribute(value: PageAttribute::action(value: 12))
            .attribute(value: PageAttribute::aria_label(value: "Delete todo"))
            .close()
            .close()
            .open(element: PageElement::Input)
            .attribute(value: PageAttribute::class(value: "edit"))
            .attribute(value: PageAttribute::node(value: 13))
            .attribute(value: PageAttribute::action(value: 13))
            .close()
            .close()
            .close()
            .close()
            .close()
        Self { page: page }
    }

    const fn inspector(self) -> Self {
        let page = self.page
            .open(element: PageElement::Section)
            .attribute(value: PageAttribute::class(value: "source-inspector"))
            .attribute(value: PageAttribute::view(value: 0))
            .attribute(value: PageAttribute::hidden())
            .attribute(value: PageAttribute::role(value: "dialog"))
            .attribute(value: PageAttribute::aria_modal())
            .attribute(value: PageAttribute::aria_label(value: "Source inspector"))
            .open(element: PageElement::Header)
            .attribute(value: PageAttribute::class(value: "inspector-head"))
            .open(element: PageElement::Span)
            .attribute(value: PageAttribute::class(value: "inspector-title"))
            .attribute(value: PageAttribute::view(value: 5))
            .text(value: t("Fe source"))
            .close()
            .open(element: PageElement::Span)
            .attribute(value: PageAttribute::class(value: "inspector-title"))
            .attribute(value: PageAttribute::view(value: 6))
            .text(value: t("Compiler-generated WGSL"))
            .close()
            .open(element: PageElement::Span)
            .attribute(value: PageAttribute::class(value: "inspector-title"))
            .attribute(value: PageAttribute::view(value: 7))
            .text(value: t("Compiler-generated Wasm"))
            .close()
            .open(element: PageElement::Span)
            .attribute(value: PageAttribute::class(value: "inspector-title"))
            .attribute(value: PageAttribute::view(value: 8))
            .text(value: t("Transitional audit manifest"))
            .close()
            .open(element: PageElement::Anchor)
            .attribute(value: PageAttribute::class(value: "raw"))
            .attribute(value: PageAttribute::node(value: 102))
            .attribute(value: PageAttribute::target(value: "_blank"))
            .attribute(value: PageAttribute::rel(value: "noopener"))
            .text(value: t("Raw"))
            .close()
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::class(value: "close"))
            .attribute(value: PageAttribute::action(value: 104))
            .attribute(value: PageAttribute::input_type(value: "button"))
            .attribute(value: PageAttribute::aria_label(value: "Close"))
            .text(value: t("×"))
            .close()
            .close()
            .open(element: PageElement::Div)
            .attribute(value: PageAttribute::class(value: "inspector-body"))
            .open(element: PageElement::Paragraph)
            .attribute(value: PageAttribute::class(value: "message"))
            .attribute(value: PageAttribute::view(value: 3))
            .text(value: t("Loading…"))
            .close()
            .open(element: PageElement::Pre)
            .attribute(value: PageAttribute::view(value: 1))
            .attribute(value: PageAttribute::node(value: 100))
            .close()
            .open(element: PageElement::Paragraph)
            .attribute(value: PageAttribute::class(value: "message"))
            .attribute(value: PageAttribute::view(value: 2))
            .text(value: t("Compiled binary module · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: 101))
            .text(value: t("0"))
            .close()
            .text(value: t(" bytes."))
            .close()
            .open(element: PageElement::Pre)
            .attribute(value: PageAttribute::class(value: "error"))
            .attribute(value: PageAttribute::view(value: 4))
            .attribute(value: PageAttribute::node(value: 103))
            .close()
            .close()
            .close()
        Self { page: page }
    }

    const fn end_grid(self) -> Self {
        Self { page: self.page.close() }
    }

    const fn finish(self) -> Page<CAPACITY> {
        self.page
            .close()
            .finish(title: t("Fe · GPU gallery"))
    }
}

actor GalleryPage {
    version: u32,

    const fn compose() -> Page<CAPACITY> uses (PageComposition) {
        GalleryBuilder::new()
            .render_tile(
                title: t("known color"),
                description: t2("typed compute → fragment ", "resource"),
                source: t2("sketches/known_color/", "src/lib.fe"),
                program: t("sketches/known_color"),
            )
            .render_tile(
                title: t("rollcall pipeline"),
                description: t2("compute → private tree fold ", "→ fragment"),
                source: t2("sketches/rollcall_pipeline/", "src/lib.fe"),
                program: t("sketches/rollcall_pipeline"),
            )
            .render_tile(
                title: t("cga3d"),
                description: t("sparse Clifford sphere pencil"),
                source: t("sketches/cga3d/src/lib.fe"),
                program: t("sketches/cga3d"),
            )
            .render_tile(
                title: t("qcga"),
                description: t("quadric conformal surface"),
                source: t("sketches/qcga/src/lib.fe"),
                program: t("sketches/qcga"),
            )
            .render_tile(
                title: t("desargues"),
                description: t("projective incidence"),
                source: t("sketches/desargues/src/lib.fe"),
                program: t("sketches/desargues"),
            )
            .render_tile(
                title: t("plasma"),
                description: t("branch-free field"),
                source: t("sketches/plasma/src/lib.fe"),
                program: t("sketches/plasma"),
            )
            .render_tile(
                title: t("mandelbrot"),
                description: t("escape-time set"),
                source: t("sketches/mandelbrot/src/lib.fe"),
                program: t("sketches/mandelbrot"),
            )
            .render_tile(
                title: t("perturbation mandelbrot"),
                description: t2("Fixed reference → f32 delta ", "pixels"),
                source: t3("sketches/", "perturbational_mandelbrot/", "src/lib.fe"),
                program: t2("sketches/", "perturbational_mandelbrot"),
            )
            .render_tile(
                title: t("dec"),
                description: t("discrete exterior calculus"),
                source: t("sketches/dec/src/lib.fe"),
                program: t("sketches/dec"),
            )
            .render_tile(
                title: t("gradient"),
                description: t("runtime-default surface"),
                source: t("sketches/gradient/src/lib.fe"),
                program: t("sketches/gradient"),
            )
            .todo_tile()
            .end_grid()
            .inspector()
            .finish()
    }
}
