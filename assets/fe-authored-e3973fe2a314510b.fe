//! TodoMVC as one resident Fe web-component actor.
//!
//! The browser adapter transports standards events and applies a fixed DOM
//! effect vocabulary. Todo identity, UTF-8 retention, filtering, lifecycle,
//! reducer policy, keyed row order, and every projected effect live here.

use std::web::component::{
    BrowserBytes, BrowserString, ComponentEvent, ComponentEventKind, ComponentPatch,
    BrowserPtr, ComponentWriter, InitialState, KeyboardKey, ProjectState, ResidentTransition,
    allocate_component_buffer, component_string,
}
use std::web::page::{
    ComponentComposition, ComponentView, PageAttribute, PageBuilder, PageElement, PageText,
}
use std::web::identity::{
    ComponentAction, ComponentActionProvider,
    Checkbox, Class, ComponentSchema, ComponentSchemaProvider,
    Element, Input, Part, Repeat, Text,
}

const MAX_TODOS: u32 = 32
const TITLE_CAPACITY: u32 = 96
const TODO_HEADER_BYTES: u32 = 12
const TODO_STRIDE: u32 = TODO_HEADER_BYTES + TITLE_CAPACITY
const TODO_STORAGE_BYTES: u32 = MAX_TODOS * TODO_STRIDE
const PATCH_CAPACITY: u32 = 32768
const VIEW_CAPACITY: usize = 160

const fn ui_text(value: String<31>) -> PageText {
    PageText::one(value: value)
}

/// TodoMVC policy vocabulary. FCO derives the compact browser correlation
/// handle from declaration order; application code never maintains an ID map.
enum TodoAction {
    Unknown,
    NewTodo,
    ToggleAll,
    ClearCompleted,
    ShowAll,
    ShowActive,
    ShowCompleted,
    ToggleTodo,
    BeginEdit,
    DestroyTodo,
    EditInput,
    EditButton,
}

impl Copy for TodoAction {}

derive ComponentAction for TodoAction using ComponentActionProvider

/// The component's Lit-like typed part schema. FCO fills every opaque handle;
/// declaration order is not an authored wire protocol. Operation-specific
/// types make invalid projections (text to a checkbox, href to an input, …)
/// fail during Fe checking.
struct TodoParts {
    current_row: Part<Element>,
    main: Part<Element>,
    footer: Part<Element>,
    list: Part<Repeat<TodoRow>>,
    count: Part<Text>,
    new_todo: Part<Input>,
    toggle_all: Part<Checkbox>,
    filter_all: Part<Element>,
    filter_active: Part<Element>,
    filter_completed: Part<Element>,
    row_toggle: Part<Checkbox>,
    row_title: Part<Text>,
    row_edit: Part<Input>,
    selected: Part<Class<Selected>>,
    completed: Part<Class<Completed>>,
    editing: Part<Class<Editing>>,
}

struct TodoRow {}
struct Selected {}
struct Completed {}
struct Editing {}

derive ComponentSchema for TodoParts using ComponentSchemaProvider

enum TodoFilter {
    All,
    Active,
    Completed,
}

impl Copy for TodoFilter {}

impl TodoFilter {
    fn includes(self, is_completed: bool) -> bool {
        match self {
            Self::All => true,
            Self::Active => is_completed == false,
            Self::Completed => is_completed,
        }
    }

    fn is_all(self) -> bool { match self { Self::All => true, _ => false } }
    fn is_active(self) -> bool { match self { Self::Active => true, _ => false } }
    fn is_completed(self) -> bool { match self { Self::Completed => true, _ => false } }
}

pub struct TodoState {
    pub todos_ptr: u32,
    pub patch_ptr: u32,
    pub draft_ptr: u32,
    pub count: u32,
    pub next_id: u32,
    pub filter: TodoFilter,
    pub editing: u32,
    pub draft_len: u32,
    pub connected: bool,
    pub prevent_default: bool,
    pub clear_input: bool,
    pub focus_edit: bool,
    pub revision: u32,
}

fn byte_at(ptr: u32, index: u32) -> BrowserPtr<u32> {
    BrowserPtr::from_u32(ptr + index)
}

fn word_at(ptr: u32, index: u32) -> BrowserPtr<u32> {
    BrowserPtr::from_u32(ptr + index)
}

fn read_word(ptr: u32, index: u32) -> u32 {
    word_at(ptr: ptr, index: index).read()
}

fn write_word(ptr: u32, index: u32, value: u32) {
    word_at(ptr: ptr, index: index).write(value)
}

fn clear_bytes(ptr: u32, len: u32) {
    let mut index: u32 = 0
    while index < len {
        byte_at(ptr: ptr, index: index).write(0)
        index = index + 1
    }
}

fn slot_offset(index: u32) -> u32 {
    index * TODO_STRIDE
}

fn occupied(todos: u32, index: u32) -> bool {
    read_word(ptr: todos, index: slot_offset(index: index)) != 0
}

fn todo_id(todos: u32, index: u32) -> u32 {
    read_word(ptr: todos, index: slot_offset(index: index) + 4)
}

fn completed(todos: u32, index: u32) -> bool {
    read_word(ptr: todos, index: slot_offset(index: index) + 8) != 0
}

fn set_completed(todos: u32, index: u32, value: bool) {
    write_word(
        ptr: todos,
        index: slot_offset(index: index) + 8,
        value: if value { 1 } else { 0 },
    )
}

fn title_len(todos: u32, index: u32) -> u32 {
    read_word(ptr: todos, index: slot_offset(index: index)) >> 1
}

fn title_ptr(todos: u32, index: u32) -> u32 {
    todos + slot_offset(index: index) + TODO_HEADER_BYTES
}

fn title(todos: u32, index: u32) -> BrowserString {
    component_string(ptr: title_ptr(todos: todos, index: index), len: title_len(todos: todos, index: index))
}

fn is_space(value: u32) -> bool {
    value == 32 || value == 9 || value == 10 || value == 13
}

fn trim(value: own BrowserString) -> BrowserString {
    let mut start: u32 = 0
    let mut end: u32 = value.len
    while start < end {
        let source: BrowserPtr<u32> = BrowserPtr::from_u32(value.ptr + start)
        if is_space(value: source.read() & 255) == false { break }
        start = start + 1
    }
    while end > start {
        let source: BrowserPtr<u32> = BrowserPtr::from_u32(value.ptr + end - 1)
        if is_space(value: source.read() & 255) == false { break }
        end = end - 1
    }
    component_string(ptr: value.ptr + start, len: end - start)
}

fn utf8_prefix_len(value: own BrowserString, capacity: u32) -> u32 {
    let mut len = value.len
    if len <= capacity { return len }
    len = capacity
    // Host input is valid UTF-8. If the first excluded byte is a continuation
    // byte, retreat to the lead byte so the retained prefix stays valid.
    while len > 0 {
        let next: BrowserPtr<u32> = BrowserPtr::from_u32(value.ptr + len)
        if next.read() & 192 != 128 { break }
        len = len - 1
    }
    len
}

fn copy_text(destination: u32, capacity: u32, value: own BrowserString) -> u32 {
    let len = utf8_prefix_len(value: value, capacity: capacity)
    let mut index: u32 = 0
    while index < len {
        let source: BrowserPtr<u32> = BrowserPtr::from_u32(value.ptr + index)
        byte_at(ptr: destination, index: index).write(source.read() & 255)
        index = index + 1
    }
    len
}

fn set_title(todos: u32, index: u32, value: own BrowserString) -> u32 {
    let trimmed = trim(value: value)
    let len = copy_text(
        destination: title_ptr(todos: todos, index: index),
        capacity: TITLE_CAPACITY,
        value: trimmed,
    )
    let present: u32 = if occupied(todos: todos, index: index) { 1 } else { 0 }
    write_word(ptr: todos, index: slot_offset(index: index), value: (len << 1) | present)
    len
}

/// Seed one ordinary todo slot from a small fixed UTF-8/ASCII byte record.
/// These are real resident items: subsequent reducer operations do not know
/// or care that they came from initial state rather than a keyboard event.
fn seed_todo_header(todos: u32, index: u32, id: u32, len: u32) -> u32 {
    write_word(
        ptr: todos,
        index: slot_offset(index: index),
        value: (len << 1) | 1,
    )
    write_word(ptr: todos, index: slot_offset(index: index) + 4, value: id)
    write_word(ptr: todos, index: slot_offset(index: index) + 8, value: 0)
    title_ptr(todos: todos, index: index)
}

fn seed_byte(destination: u32, offset: u32, value: u32) {
    byte_at(ptr: destination, index: offset).write(value)
}

fn find_slot(todos: u32, key: u32) -> u32 {
    let mut index: u32 = 0
    while index < MAX_TODOS {
        if occupied(todos: todos, index: index) && todo_id(todos: todos, index: index) == key {
            return index
        }
        index = index + 1
    }
    MAX_TODOS
}

fn find_empty(todos: u32) -> u32 {
    let mut index: u32 = 0
    while index < MAX_TODOS {
        if occupied(todos: todos, index: index) == false { return index }
        index = index + 1
    }
    MAX_TODOS
}

fn remove_at(todos: u32, index: u32) {
    write_word(ptr: todos, index: slot_offset(index: index), value: 0)
}

fn active_count(todos: u32) -> u32 {
    let mut count: u32 = 0
    let mut index: u32 = 0
    while index < MAX_TODOS {
        if occupied(todos: todos, index: index) && completed(todos: todos, index: index) == false {
            count = count + 1
        }
        index = index + 1
    }
    count
}

actor TodoApp {
    todos_ptr: u32,
    patch_ptr: u32,
    draft_ptr: u32,
    count: u32,
    next_id: u32,
    filter: TodoFilter,
    editing: u32,
    draft_len: u32,
    connected: bool,
    prevent_default: bool,
    clear_input: bool,
    focus_edit: bool,
    revision: u32,

    const fn view() -> ComponentView<VIEW_CAPACITY> uses (ComponentComposition) {
        let ui = <TodoParts as ComponentSchema>::component_parts()
        PageBuilder::new()
            .open(element: PageElement::Heading2)
            .attribute(value: PageAttribute::class(value: "todo-heading"))
            .text(value: ui_text(value: "todos"))
            .close()
            .open(element: PageElement::Header)
            .attribute(value: PageAttribute::class(value: "header"))
            .open(element: PageElement::Input)
            .attribute(value: PageAttribute::class(value: "new-todo"))
            .attribute(value: PageAttribute::node(value: ui.new_todo))
            .attribute(value: PageAttribute::action(value: TodoAction::NewTodo))
            .attribute(value: PageAttribute::placeholder(value: "What needs to be done?"))
            .attribute(value: PageAttribute::autocomplete(value: "off"))
            .close()
            .close()
            .open(element: PageElement::Section)
            .attribute(value: PageAttribute::class(value: "main"))
            .attribute(value: PageAttribute::node(value: ui.main))
            .attribute(value: PageAttribute::hidden())
            .open(element: PageElement::Input)
            .attribute(value: PageAttribute::local_id(value: "toggle-all"))
            .attribute(value: PageAttribute::class(value: "toggle-all"))
            .attribute(value: PageAttribute::node(value: ui.toggle_all))
            .attribute(value: PageAttribute::action(value: TodoAction::ToggleAll))
            .attribute(value: PageAttribute::input_type(value: "checkbox"))
            .attribute(value: PageAttribute::aria_label(value: "Mark all as complete"))
            .close()
            .open(element: PageElement::Label)
            .attribute(value: PageAttribute::class(value: "toggle-all-label"))
            .attribute(value: PageAttribute::local_for(value: "toggle-all"))
            .attribute(value: PageAttribute::title(value: "Mark all as complete"))
            .text(value: ui_text(value: "⌄"))
            .close()
            .open(element: PageElement::UnorderedList)
            .attribute(value: PageAttribute::class(value: "todo-list"))
            .attribute(value: PageAttribute::node(value: ui.list))
            .close()
            .close()
            .open(element: PageElement::Footer)
            .attribute(value: PageAttribute::class(value: "footer"))
            .attribute(value: PageAttribute::node(value: ui.footer))
            .attribute(value: PageAttribute::hidden())
            .open(element: PageElement::Span)
            .attribute(value: PageAttribute::class(value: "todo-count"))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.count))
            .text(value: ui_text(value: "0"))
            .close()
            .text(value: ui_text(value: " items left"))
            .close()
            .open(element: PageElement::UnorderedList)
            .attribute(value: PageAttribute::class(value: "filters"))
            .open(element: PageElement::ListItem)
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::node(value: ui.filter_all))
            .attribute(value: PageAttribute::action(value: TodoAction::ShowAll))
            .attribute(value: PageAttribute::class_token(slot: ui.selected, value: "selected"))
            .text(value: ui_text(value: "All"))
            .close()
            .close()
            .open(element: PageElement::ListItem)
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::node(value: ui.filter_active))
            .attribute(value: PageAttribute::action(value: TodoAction::ShowActive))
            .attribute(value: PageAttribute::class_token(slot: ui.selected, value: "selected"))
            .text(value: ui_text(value: "Active"))
            .close()
            .close()
            .open(element: PageElement::ListItem)
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::node(value: ui.filter_completed))
            .attribute(value: PageAttribute::action(value: TodoAction::ShowCompleted))
            .attribute(value: PageAttribute::class_token(slot: ui.selected, value: "selected"))
            .text(value: ui_text(value: "Completed"))
            .close()
            .close()
            .close()
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::class(value: "clear-completed"))
            .attribute(value: PageAttribute::action(value: TodoAction::ClearCompleted))
            .text(value: ui_text(value: "Clear completed"))
            .close()
            .close()
            .open(element: PageElement::Template)
            .attribute(value: PageAttribute::template(value: ui.list))
            .open(element: PageElement::ListItem)
            .attribute(value: PageAttribute::class_token(slot: ui.completed, value: "completed"))
            .attribute(value: PageAttribute::class_token(slot: ui.editing, value: "editing"))
            .open(element: PageElement::Div)
            .attribute(value: PageAttribute::class(value: "view"))
            .open(element: PageElement::Input)
            .attribute(value: PageAttribute::class(value: "toggle"))
            .attribute(value: PageAttribute::node(value: ui.row_toggle))
            .attribute(value: PageAttribute::action(value: TodoAction::ToggleTodo))
            .attribute(value: PageAttribute::input_type(value: "checkbox"))
            .close()
            .open(element: PageElement::Label)
            .attribute(value: PageAttribute::node(value: ui.row_title))
            .attribute(value: PageAttribute::action(value: TodoAction::BeginEdit))
            .close()
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::class(value: "edit-button"))
            .attribute(value: PageAttribute::action(value: TodoAction::EditButton))
            .attribute(value: PageAttribute::aria_label(value: "Edit todo"))
            .attribute(value: PageAttribute::title(value: "Edit"))
            .text(value: ui_text(value: "✎"))
            .close()
            .open(element: PageElement::Button)
            .attribute(value: PageAttribute::class(value: "destroy"))
            .attribute(value: PageAttribute::action(value: TodoAction::DestroyTodo))
            .attribute(value: PageAttribute::aria_label(value: "Delete todo"))
            .close()
            .close()
            .open(element: PageElement::Input)
            .attribute(value: PageAttribute::class(value: "edit"))
            .attribute(value: PageAttribute::node(value: ui.row_edit))
            .attribute(value: PageAttribute::action(value: TodoAction::EditInput))
            .close()
            .close()
            .close()
            .finish_component()
    }

    fn initial() -> TodoState uses (InitialState) {
        let todos = allocate_component_buffer(capacity: TODO_STORAGE_BYTES)
        let patch = allocate_component_buffer(capacity: PATCH_CAPACITY)
        let draft = allocate_component_buffer(capacity: TITLE_CAPACITY)
        clear_bytes(ptr: todos.ptr, len: todos.len)
        let strings = seed_todo_header(todos: todos.ptr, index: 0, id: 1, len: 7)
        seed_byte(destination: strings, offset: 0, value: 115)
        seed_byte(destination: strings, offset: 1, value: 116)
        seed_byte(destination: strings, offset: 2, value: 114)
        seed_byte(destination: strings, offset: 3, value: 105)
        seed_byte(destination: strings, offset: 4, value: 110)
        seed_byte(destination: strings, offset: 5, value: 103)
        seed_byte(destination: strings, offset: 6, value: 115)

        let review = seed_todo_header(todos: todos.ptr, index: 1, id: 2, len: 11)
        seed_byte(destination: review, offset: 0, value: 114)
        seed_byte(destination: review, offset: 1, value: 101)
        seed_byte(destination: review, offset: 2, value: 118)
        seed_byte(destination: review, offset: 3, value: 105)
        seed_byte(destination: review, offset: 4, value: 101)
        seed_byte(destination: review, offset: 5, value: 119)
        seed_byte(destination: review, offset: 6, value: 32)
        seed_byte(destination: review, offset: 7, value: 99)
        seed_byte(destination: review, offset: 8, value: 111)
        seed_byte(destination: review, offset: 9, value: 100)
        seed_byte(destination: review, offset: 10, value: 101)

        let more = seed_todo_header(todos: todos.ptr, index: 2, id: 3, len: 14)
        seed_byte(destination: more, offset: 0, value: 109)
        seed_byte(destination: more, offset: 1, value: 117)
        seed_byte(destination: more, offset: 2, value: 99)
        seed_byte(destination: more, offset: 3, value: 104)
        seed_byte(destination: more, offset: 4, value: 32)
        seed_byte(destination: more, offset: 5, value: 109)
        seed_byte(destination: more, offset: 6, value: 117)
        seed_byte(destination: more, offset: 7, value: 99)
        seed_byte(destination: more, offset: 8, value: 104)
        seed_byte(destination: more, offset: 9, value: 32)
        seed_byte(destination: more, offset: 10, value: 109)
        seed_byte(destination: more, offset: 11, value: 111)
        seed_byte(destination: more, offset: 12, value: 114)
        seed_byte(destination: more, offset: 13, value: 101)
        TodoState {
            todos_ptr: todos.ptr,
            patch_ptr: patch.ptr,
            draft_ptr: draft.ptr,
            count: 3,
            next_id: 4,
            filter: TodoFilter::All,
            editing: 0,
            draft_len: 0,
            connected: false,
            prevent_default: false,
            clear_input: false,
            focus_edit: false,
            revision: 0,
        }
    }

    fn receive(self, event: own ComponentEvent<TodoAction>) -> TodoState uses (ResidentTransition) {
        let todos = self.todos_ptr
        let patch = self.patch_ptr
        let draft = self.draft_ptr
        let draft_capacity = TITLE_CAPACITY
        let mut count = self.count
        let mut next_id = self.next_id
        let mut filter = self.filter
        let mut editing = self.editing
        let mut draft_len = self.draft_len
        let mut connected = self.connected
        let mut prevent_default = false
        let mut clear_input = false
        let mut focus_edit = false
        let mut revision = self.revision
        let action = event.target

        match event.kind {
            ComponentEventKind::Connected => {
                connected = true
                revision = revision + 1
            }
            ComponentEventKind::Disconnected => {
                connected = false
                revision = revision + 1
            }
            ComponentEventKind::Activate => {
                if connected {
                    match action {
                        TodoAction::ClearCompleted => {
                            let mut index: u32 = 0
                            while index < MAX_TODOS {
                                if occupied(todos: todos, index: index) && completed(todos: todos, index: index) {
                                    remove_at(todos: todos, index: index)
                                    count = count - 1
                                }
                                index = index + 1
                            }
                        }
                        TodoAction::ShowAll => { filter = TodoFilter::All }
                        TodoAction::ShowActive => { filter = TodoFilter::Active }
                        TodoAction::ShowCompleted => { filter = TodoFilter::Completed }
                        TodoAction::DestroyTodo => {
                            let index = find_slot(todos: todos, key: event.key)
                            if index < MAX_TODOS {
                                remove_at(todos: todos, index: index)
                                count = count - 1
                                if editing == event.key { editing = 0 }
                            }
                        }
                        TodoAction::BeginEdit => {
                            let index = find_slot(todos: todos, key: event.key)
                            if event.click_count() >= 2 && index < MAX_TODOS {
                                draft_len = copy_text(
                                    destination: draft,
                                    capacity: draft_capacity,
                                    value: title(todos: todos, index: index),
                                )
                                editing = event.key
                                focus_edit = true
                            }
                        }
                        TodoAction::EditButton => {
                            let index = find_slot(todos: todos, key: event.key)
                            if index < MAX_TODOS {
                                draft_len = copy_text(
                                    destination: draft,
                                    capacity: draft_capacity,
                                    value: title(todos: todos, index: index),
                                )
                                editing = event.key
                                focus_edit = true
                            }
                        }
                        _ => {}
                    }
                    revision = revision + 1
                }
            }
            ComponentEventKind::Change => {
                if connected {
                    match action {
                        TodoAction::ToggleAll => {
                            let completion_word: u32 = if active_count(todos: todos) != 0 { 1 } else { 0 }
                            let mut index: u32 = 0
                            while index < MAX_TODOS {
                                if occupied(todos: todos, index: index) {
                                    write_word(
                                        ptr: todos,
                                        index: slot_offset(index: index) + 8,
                                        value: completion_word,
                                    )
                                }
                                index = index + 1
                            }
                        }
                        TodoAction::ToggleTodo => {
                            let index = find_slot(todos: todos, key: event.key)
                            if index < MAX_TODOS {
                                set_completed(
                                    todos: todos,
                                    index: index,
                                    value: completed(todos: todos, index: index) == false,
                                )
                            }
                        }
                        _ => {}
                    }
                    revision = revision + 1
                }
            }
            ComponentEventKind::Input => {
                match action {
                    TodoAction::EditInput => {
                        if connected && event.key == editing {
                            draft_len = copy_text(
                                destination: draft,
                                capacity: draft_capacity,
                                value: event.text,
                            )
                            revision = revision + 1
                        }
                    }
                    _ => {}
                }
            }
            ComponentEventKind::KeyDown => {
                if connected {
                    match event.keyboard_key() {
                        KeyboardKey::Enter => {
                            match action {
                                TodoAction::NewTodo => {
                                    let value = trim(value: event.text)
                                    let index = find_empty(todos: todos)
                                    if value.len > 0 && index < MAX_TODOS {
                                        write_word(ptr: todos, index: slot_offset(index: index), value: 1)
                                        write_word(ptr: todos, index: slot_offset(index: index) + 4, value: next_id)
                                        write_word(ptr: todos, index: slot_offset(index: index) + 8, value: 0)
                                        set_title(todos: todos, index: index, value: value)
                                        count = count + 1
                                        next_id = next_id + 1
                                        clear_input = true
                                    }
                                    prevent_default = true
                                }
                                TodoAction::EditInput => {
                                    if event.key == editing {
                                        let index = find_slot(todos: todos, key: event.key)
                                        let value = trim(value: component_string(ptr: draft, len: draft_len))
                                        if index < MAX_TODOS {
                                            if value.len == 0 {
                                                remove_at(todos: todos, index: index)
                                                count = count - 1
                                            } else {
                                                let _ = set_title(todos: todos, index: index, value: value)
                                            }
                                        }
                                        editing = 0
                                        prevent_default = true
                                    }
                                }
                                _ => {}
                            }
                        }
                        KeyboardKey::Escape => {
                            match action {
                                TodoAction::EditInput => {
                                    if event.key == editing {
                                        editing = 0
                                        prevent_default = true
                                    }
                                }
                                _ => {}
                            }
                        }
                        KeyboardKey::Other => {}
                    }
                    revision = revision + 1
                }
            }
            _ => {}
        }

        TodoState {
            todos_ptr: todos,
            patch_ptr: patch,
            draft_ptr: draft,
            count: count,
            next_id: next_id,
            filter: filter,
            editing: editing,
            draft_len: draft_len,
            connected: connected,
            prevent_default: prevent_default,
            clear_input: clear_input,
            focus_edit: focus_edit,
            revision: revision,
        }
    }

    fn project(self) -> ComponentPatch uses (ProjectState) {
        let todos = self.todos_ptr
        let active = active_count(todos: todos)
        let ui = <TodoParts as ComponentSchema>::component_parts()
        let mut writer = ComponentWriter::new(
            buffer: BrowserBytes { ptr: self.patch_ptr, len: PATCH_CAPACITY },
        )
        writer = writer.set_hidden(target: ui.main, hidden: self.count == 0)
        writer = writer.set_hidden(target: ui.footer, hidden: self.count == 0)
        writer = writer.set_small_u32_text(target: ui.count, value: active)
        writer = writer.set_checked(
            target: ui.toggle_all,
            checked: self.count > 0 && active == 0,
        )
        writer = writer.set_class(
            target: ui.filter_all,
            token: ui.selected,
            enabled: self.filter.is_all(),
        )
        writer = writer.set_class(
            target: ui.filter_active,
            token: ui.selected,
            enabled: self.filter.is_active(),
        )
        writer = writer.set_class(
            target: ui.filter_completed,
            token: ui.selected,
            enabled: self.filter.is_completed(),
        )
        if self.clear_input {
            writer = writer.set_value(target: ui.new_todo, value: component_string(ptr: 0, len: 0))
        }

        writer = writer.repeat_begin(region: ui.list)
        let mut index: u32 = 0
        while index < MAX_TODOS {
            if occupied(todos: todos, index: index) {
                let is_completed = completed(todos: todos, index: index)
                if self.filter.includes(is_completed: is_completed) {
                    let key = todo_id(todos: todos, index: index)
                    let value = title(todos: todos, index: index)
                    writer = writer.repeat_item(key: key)
                    writer = writer.set_text(target: ui.row_title, value: value)
                    writer = writer.set_checked(target: ui.row_toggle, checked: is_completed)
                    writer = writer.set_class(
                        target: ui.current_row,
                        token: ui.completed,
                        enabled: is_completed,
                    )
                    writer = writer.set_class(
                        target: ui.current_row,
                        token: ui.editing,
                        enabled: key == self.editing,
                    )
                    if key == self.editing {
                        writer = writer.set_value(
                            target: ui.row_edit,
                            value: component_string(ptr: self.draft_ptr, len: self.draft_len),
                        )
                        if self.focus_edit {
                            writer = writer.focus(target: ui.row_edit)
                        }
                    }
                }
            }
            index = index + 1
        }
        writer = writer.repeat_end()

        ComponentPatch::new(
            visible_mask: 0,
            focus_target: TodoAction::Unknown,
            prevent_default: self.prevent_default,
            commands: writer.finish(),
        )
    }
}
