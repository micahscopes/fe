//! A quadric pencil on a slice plane, drawn per pixel by a reflected QCGA
//! expression whose shader arithmetic is generated from ordinary Fe types.
//!
//! The division of labor, in one breath:
//!   - `QcgaBasis` names three positive generators and six typed null pairs;
//!   - coefficient record field names state each sparse vector's support; and
//!   - shared FCO derives pair routing, signs, support, and flat arithmetic.
//!
//! No hand-rolled sign table and no per-field `if field_index == N` dispatch:
//! the same reusable provider now serves this slice, the solved QCGA pencil,
//! classic CGA, and PGA. The demo contains no generator IDs, support masks, or
//! candidate-routing ladder.
//!
//! The picture: the y = 0 slice of the pencil member
//! Q(lambda) = cos(PI*lambda) * (x^2 + y^2 - 1/2) + sin(PI*lambda) * (z^2 - 1/2),
//! rotated by `theta` so the xz cross term is live. Every pixel evaluates the
//! field and its exact gradient through five generated incidence evaluations; the zero
//! set is drawn as a gradient-normalized curve over a signed-field wash.
//! Sweeping `lambda` deforms the conic through genuine topology changes
//! (ellipse -> circle -> hyperbola -> line pair).
//!
//! Software rendering (lavapipe/SwiftShader) in the sandbox; no performance or
//! parallelism claim (VISION 3.1).
//!
//!     fe web build demos/sketches/qcga --out <dir>

use core::marker::Copy
use std::webgpu::{
    FragmentSurface, GpuProgram, LatestPerFrame, ResponsiveBacking,
    StandardSurfaceRecovery, SurfaceQuality, SurfaceRecovery, SurfaceScheduling,
    SurfaceTransition, WebGpuBackend,
}
use std::web::view::{
    ApplyParamBindings, Extent, Param, ParamBindingsProvider, Surface,
    SurfaceEvent, SurfaceState,
}
use ga_expr::{
    BasisMetric, CompileNamedVectorDotF32, EvaluateVectorScalarF32,
    Null, Positive, Prime,
}
use fmath::{PI, abs, clamp01, cos, from_i32, mix, rgba, sin, smoothstep, sqrt}
use gallery_palette::{electric_blue, midnight, spring_green, theorem_gold}

// ---------------------------------------------------------------------------
// The complete QCGA authoring surface. The shared compiler derives dimension,
// sparse supports and every null pairing from these named records.
// ---------------------------------------------------------------------------

struct Pair1 {}
struct Pair2 {}
struct Pair3 {}
struct Pair4 {}
struct Pair5 {}
struct Pair6 {}
struct QcgaBasis {
    e1: Positive, e2: Positive, e3: Positive,
    eo1: Null<Pair1>, eo2: Null<Pair2>, eo3: Null<Pair3>,
    eo4: Null<Pair4>, eo5: Null<Pair5>, eo6: Null<Pair6>,
    ei1: Prime<Pair1>, ei2: Prime<Pair2>, ei3: Prime<Pair3>,
    ei4: Prime<Pair4>, ei5: Prime<Pair5>, ei6: Prime<Pair6>,
}
type QcgaMetric = BasisMetric<QcgaBasis>
struct PointCoefficients {
    e1: f32, e2: f32, e3: f32,
    eo1: f32, eo2: f32, eo3: f32,
    ei1: f32, ei2: f32, ei3: f32, ei4: f32, ei5: f32, ei6: f32,
}
struct QuadricCoefficients {
    e1: f32, e2: f32, e3: f32,
    eo1: f32, eo2: f32, eo3: f32, eo4: f32, eo5: f32, eo6: f32,
    ei1: f32, ei2: f32, ei3: f32,
}
struct SparseIncidenceOperands {
    point: PointCoefficients,
    quadric: QuadricCoefficients,
}
derive EvaluateVectorScalarF32 for SparseIncidenceOperands using CompileNamedVectorDotF32<
    PointCoefficients, QuadricCoefficients, QcgaMetric,
>

// ---------------------------------------------------------------------------
// The paper-normalized point embedding and dual-quadric packing (feasibility
// design section 4): the only other QCGA-specific code in this file.
// ---------------------------------------------------------------------------

pub fn qcga3d_incidence(
    x: f32, y: f32, z: f32,
    a: f32, b: f32, c: f32, d: f32, e: f32,
    f: f32, g: f32, h: f32, i: f32, j: f32,
) -> f32 {
    let half: f32 = 0.5
    let j_third: f32 = j / 3.0
    let negative_j_third: f32 = 0.0 - j_third
    <SparseIncidenceOperands as EvaluateVectorScalarF32>::scalar(SparseIncidenceOperands {
        point: PointCoefficients {
            e1: x, e2: y, e3: z,
            eo1: 1.0, eo2: 1.0, eo3: 1.0,
            ei1: x * x * half, ei2: y * y * half, ei3: z * z * half,
            ei4: x * y, ei5: x * z, ei6: y * z,
        },
        quadric: QuadricCoefficients {
            e1: g, e2: h, e3: i,
            eo1: -2.0 * a, eo2: -2.0 * b, eo3: -2.0 * c,
            eo4: -d, eo5: -e, eo6: -f,
            ei1: negative_j_third,
            ei2: negative_j_third,
            ei3: negative_j_third,
        },
    })
}

/// The ten coefficients of a dual quadric:
/// a x^2 + b y^2 + c z^2 + d xy + e xz + f yz + g x + h y + i z + j.
pub struct Quadric {
    pub a: f32, pub b: f32, pub c: f32, pub d: f32, pub e: f32,
    pub f: f32, pub g: f32, pub h: f32, pub i: f32, pub j: f32,
}
impl Copy for Quadric {}

/// Point/quadric incidence through the compiled named-vector dot. Every
/// "does this point lie on this surface" below flows through here; there is
/// no second evaluation path to drift from.
pub fn eval_quadric(_ q: Quadric, _ x: f32, _ y: f32, _ z: f32) -> f32 {
    qcga3d_incidence(
        x: x, y: y, z: z,
        a: q.a, b: q.b, c: q.c, d: q.d, e: q.e,
        f: q.f, g: q.g, h: q.h, i: q.i, j: q.j,
    )
}

// ---------------------------------------------------------------------------
// THE ACTOR: one program, one per-pixel behavior. The interactive boundary is
// DECLARED in `view()` (web v5): the runtime reads real slider ranges/init/
// kind and the dispatch extent from the projected manifest `surface` section,
// mirroring cga3d's `Cga3dSurface`. `res` is bound to the live canvas width,
// replacing the baked `const RESOLUTION`.
// ---------------------------------------------------------------------------

/// The per-demo params record: field names bind, by name identity, to the
/// actor's state fields (checked at projection time).
struct QcgaParams {
    lambda: Param,
    theta: Param,
    zoom: Param,
    res: Param,
}

struct QcgaViewState {
    lambda: f32,
    theta: f32,
    zoom: f32,
    res: f32,
}

impl SurfaceState for QcgaViewState {
    type Params = QcgaParams
}

derive ApplyParamBindings for QcgaViewState using ParamBindingsProvider

const fn qcga_params() -> QcgaParams {
    QcgaParams {
        lambda: Param::unit(init: 0.15).drag_x(per_px: 0.0025),
        theta: Param::angle(init: 0.6).drag_y(per_px: 0.01),
        zoom: Param::range(min: 0.5, max: 4.0, init: 1.6)
            .wheel_scale(in_factor: 0.875, out_factor: 1.125),
        res: Param::extent_x(),
    }
}

actor QcgaSurface uses (
    GpuProgram<WebGpuBackend>, SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    /// Pencil parameter: [0, 1] sweeps cylinder -> sphere-like -> plane pair.
    lambda: f32,
    /// Rotation of the member about the y axis; makes the xz cross term live.
    theta: f32,
    /// Half-extent of the visible slice in world units.
    zoom: f32,
    /// Surface extent in pixels (runtime-fed; replaces `const RESOLUTION`).
    res: f32,

    /// The surface declaration: CTFE-evaluated at bundle time and projected
    /// into the manifest `surface` section. Never lowered to wasm or WGSL.
    const fn view() -> Surface<QcgaParams> {
        Surface {
            extent: Extent::square(512),
            params: qcga_params(),
        }
    }

    /// Drag sweeps and rotates the quadric pencil; wheel changes slice scale.
    fn navigate(self, event: own SurfaceEvent) -> QcgaViewState
        uses (SurfaceTransition, SurfaceScheduling<LatestPerFrame>)
    {
        let current = QcgaViewState {
            lambda: self.lambda,
            theta: self.theta,
            zoom: self.zoom,
            res: self.res,
        }
        current.apply_param_bindings(qcga_params(), event)
    }

    /// Pixel coordinate in, packed RGBA8 word out. Five generated incidence
    /// per pixel: the field and its exact slice gradient (central differences
    /// with h = 1 are exact for a quadric).
    fn shade(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        // Pixel centre to the y = 0 slice plane: screen x -> world x, screen
        // y (up) -> world z.
        let u: f32 = ((from_i32(px) + 0.5) / self.res * 2.0 - 1.0) * self.zoom
        let v: f32 = (1.0 - (from_i32(py) + 0.5) / self.res * 2.0) * self.zoom

        // Pencil member Q(lambda) = cos(PI l) Q0 + sin(PI l) Q1 with
        // Q0 = x^2 + y^2 - 1/2 (cylinder), Q1 = z^2 - 1/2 (plane pair):
        // the same pencil qcga_pencil's nine points pin, held as constants.
        let w0: f32 = cos(PI * self.lambda)
        let w1: f32 = sin(PI * self.lambda)
        let a0: f32 = w0
        let b0: f32 = w0
        let c0: f32 = w1
        let j0: f32 = -0.5 * (w0 + w1)

        // Rotate the member about the y axis by theta: the xz cross term
        // (coefficient e) goes live, so the eo5/ei5 plan term carries real
        // data (the feasibility gate's "cross terms live" minimum).
        let ct: f32 = cos(self.theta)
        let st: f32 = sin(self.theta)
        let a: f32 = a0 * ct * ct + c0 * st * st
        let c: f32 = a0 * st * st + c0 * ct * ct
        let e: f32 = 2.0 * (a0 - c0) * st * ct
        let q: Quadric = Quadric {
            a: a, b: b0, c: c, d: 0.0, e: e,
            f: 0.0, g: 0.0, h: 0.0, i: 0.0, j: j0,
        }

        // One named-basis incidence evaluator, sampled for field and gradient.
        let f0: f32 = eval_quadric(q, u, 0.0, v)
        let gx: f32 = (eval_quadric(q, u + 1.0, 0.0, v) - eval_quadric(q, u - 1.0, 0.0, v)) * 0.5
        let gz: f32 = (eval_quadric(q, u, 0.0, v + 1.0) - eval_quadric(q, u, 0.0, v - 1.0)) * 0.5
        let gmag: f32 = sqrt(gx * gx + gz * gz) + 0.0000001

        // First-order distance to the zero set in world units, then a
        // resolution-aware curve mask.
        let dist: f32 = abs(f0) / gmag
        let pixel_w: f32 = self.zoom * 2.0 / self.res
        let curve: f32 = 1.0 - smoothstep(0.0, pixel_w * 1.5, dist)

        // Signed field in the original Desargues construction palette: blue
        // inside, green outside, and theorem gold on the zero set.
        let s: f32 = f0 / (1.0 + abs(f0))
        let inside: f32 = clamp01(0.0 - s)
        let outside: f32 = clamp01(s)
        let ground = midnight()
        let cool = electric_blue()
        let warm = spring_green()
        let zero = theorem_gold()
        let field_red: f32 = ground.red
            + inside * (cool.red - ground.red)
            + outside * (warm.red - ground.red)
        let field_green: f32 = ground.green
            + inside * (cool.green - ground.green)
            + outside * (warm.green - ground.green)
        let field_blue: f32 = ground.blue
            + inside * (cool.blue - ground.blue)
            + outside * (warm.blue - ground.blue)
        let red: f32 = mix(field_red, zero.red, curve)
        let grn: f32 = mix(field_green, zero.green, curve)
        let blu: f32 = mix(field_blue, zero.blue, curve)
        rgba(red, grn, blu)
    }
}
