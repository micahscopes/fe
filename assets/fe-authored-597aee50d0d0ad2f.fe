//! Event Studio: a resident Fe component driven by typed browser streams.
//!
//! The browser owns standards listeners only while an observation is pending.
//! Affine subscriptions and Fe tasks own iteration, quantization, failure
//! policy, actor delivery, state, and DOM projection. There is no JavaScript
//! application callback or hidden host-side reactive graph.

use core::actor::{ActorSink, ScopedTask}
use core::default::Default
use core::Fn
use core::pending::{Select, Suspend, TaskOutcome, Timer}
use std::actor::{
    ActorMessage, BrowserActorSink, MergePolicy, MergeSide,
    forward_to_actor, merge_buffer_to_actor,
}
use std::reactive::{
    AsyncEventSource, Event, EventSource, Latest, OverflowPolicy, Stream, latest,
}
use std::host::{HostTimer, Resumable, sleep}
use std::wasm::WasmBackend
use std::web::component_events::{
    BrowserPointerEvents,
    BrowserWheelEvents,
    PointerSample,
    WheelSample,
}
use std::web::document_events::{BrowserVisibilityEvents, DocumentVisibility}
use std::web::gpu_device_events::{
    BrowserGpuDeviceEvents,
    GpuDeviceEvent,
    GpuDeviceEventKind,
    GpuDeviceLossReason,
}
use std::web::window_events::{
    AnimationFrame,
    BrowserAnimationFrames,
    BrowserViewportEvents,
    Viewport,
}
use std::web::component::{
    BrowserBytes,
    BrowserString,
    ComponentEvent,
    ComponentEventKind,
    ComponentPatch,
    ComponentWriter,
    InitialState,
    ProjectState,
    ResidentTransition,
    allocate_component_buffer,
}
use std::web::identity::{
    ComponentAction,
    ComponentActionProvider,
    ComponentSchema,
    ComponentSchemaProvider,
    Part,
    Text,
}
use std::web::page::{
    ComponentComposition,
    ComponentView,
    PageAttribute,
    PageBuilder,
    PageElement,
    PageText,
}

const PATCH_CAPACITY: u32 = 1024
const VIEW_CAPACITY: usize = 232
const FRAME_PACE_MS: u64 = 500

extern {
    fn __i32_from_f32(_: f32) -> i32
}

const fn ui_text(value: String<31>) -> PageText {
    PageText::one(value: value)
}

enum StudioAction {
    Unknown,
    ViewportObserved,
    PointerObserved,
    WheelObserved,
    StreamFailed,
    VisibilityObserved,
    FrameObserved,
    TimerElapsed,
    DeviceObserved,
}

impl Copy for StudioAction {}

/// Pointer policy adds only the Fe-owned cumulative drop count to the complete
/// standards observation. Keeping this nominal pair avoids both parallel
/// scalar fields and an application-specific packed protocol.
#[derive(Default)]
struct BufferedPointer {
    sample: PointerSample,
    dropped: u32,
}

impl Copy for BufferedPointer {}

/// One nominal mailbox payload built from the actual browser fact types. The
/// compiler recursively derives its scalar Wasm shape; neither tasks nor the
/// fixed browser boundary assign field IDs or flatten these values by hand.
#[derive(Default)]
struct StudioTask {
    viewport: Viewport,
    pointer: BufferedPointer,
    wheel: WheelSample,
    visibility: DocumentVisibility,
    frame: AnimationFrame,
    error: u32,
    latest_value: u32,
    device: GpuDeviceEvent,
}

impl Copy for StudioTask {}

impl StudioTask {
    fn with_viewport(mut self, value: Viewport) -> Self {
        self.viewport = value
        self
    }

    fn with_pointer(mut self, sample: PointerSample, dropped: u32) -> Self {
        self.pointer = BufferedPointer { sample: sample, dropped: dropped }
        self
    }

    fn with_wheel(mut self, value: WheelSample, dropped: u32) -> Self {
        self.wheel = value
        self.pointer.dropped = dropped
        self
    }

    fn with_visibility(mut self, value: DocumentVisibility) -> Self {
        self.visibility = value
        self
    }

    fn with_frame(mut self, value: AnimationFrame) -> Self {
        self.frame = value
        self
    }

    fn with_error(mut self, value: u32) -> Self {
        self.error = value
        self
    }

    fn with_latest(mut self, value: u32) -> Self {
        self.latest_value = value
        self
    }

    fn with_device(mut self, value: GpuDeviceEvent) -> Self {
        self.device = value
        self
    }
}

derive ComponentAction for StudioAction using ComponentActionProvider

struct StudioParts {
    width: Part<Text>,
    height: Part<Text>,
    pixel_ratio: Part<Text>,
    observations: Part<Text>,
    pointer_x: Part<Text>,
    pointer_y: Part<Text>,
    pointer_events: Part<Text>,
    wheel_events: Part<Text>,
    visible: Part<Text>,
    visibility_events: Part<Text>,
    frame_events: Part<Text>,
    timer_events: Part<Text>,
    frame_timestamp: Part<Text>,
    bounded_drops: Part<Text>,
    latest_value: Part<Text>,
    failures: Part<Text>,
    device_kind: Part<Text>,
    device_reason: Part<Text>,
    device_generation: Part<Text>,
    device_events: Part<Text>,
    device_missed: Part<Text>,
}

derive ComponentSchema for StudioParts using ComponentSchemaProvider

pub struct StudioState {
    pub patch_ptr: u32,
    pub width: u32,
    pub height: u32,
    pub pixel_ratio_percent: u32,
    pub observations: u32,
    pub pointer_x: u32,
    pub pointer_y: u32,
    pub pointer_events: u32,
    pub wheel_events: u32,
    pub visible: bool,
    pub visibility_events: u32,
    pub frame_events: u32,
    pub timer_events: u32,
    pub frame_timestamp: u32,
    pub bounded_drops: u32,
    pub latest_value: u32,
    pub failures: u32,
    pub connected: bool,
    pub device_kind: GpuDeviceEventKind,
    pub device_reason: GpuDeviceLossReason,
    pub device_generation: u32,
    pub device_events: u32,
    pub device_missed: u32,
}

fn bounded_dimension(value: f32) -> u32 {
    let bounded = if value >= 0.0 && value <= 100000.0 {
        value
    } else {
        100000.0
    }
    __i32_from_f32(bounded).downcast_unchecked()
}

fn bounded_pixel_ratio(value: f32) -> u32 {
    let percent = value * 100.0
    let bounded = if percent >= 0.0 && percent <= 10000.0 {
        percent
    } else {
        10000.0
    }
    __i32_from_f32(bounded).downcast_unchecked()
}

fn bounded_position(value: f32) -> u32 {
    let bounded = if value < 0.0 {
        0.0
    } else {
        if value <= 100000.0 { value } else { 100000.0 }
    }
    __i32_from_f32(bounded).downcast_unchecked()
}

fn device_kind_tag(value: GpuDeviceEventKind) -> u32 {
    match value {
        GpuDeviceEventKind::Unknown => 0,
        GpuDeviceEventKind::Available => 1,
        GpuDeviceEventKind::Lost => 2,
        GpuDeviceEventKind::Unavailable => 3,
    }
}

fn device_reason_tag(value: GpuDeviceLossReason) -> u32 {
    match value {
        GpuDeviceLossReason::NotLost => 0,
        GpuDeviceLossReason::Unknown => 1,
        GpuDeviceLossReason::Destroyed => 2,
    }
}

fn timer_task(sequence: u32) -> StudioTask {
    let base = sequence * 4
    // Keep the deterministic one-slot probe as visible `Latest` evidence. The
    // bounded-drop counter now comes from the genuinely concurrent merged
    // pointer/wheel producer-consumer graph rather than this synthetic burst.
    let mut newest: Latest<u32> = latest(initial: 0)
    newest = newest.offer(value: base + 1, overflow: OverflowPolicy::KeepLatest)
    newest = newest.offer(value: base + 4, overflow: OverflowPolicy::KeepLatest)
    StudioTask::default().with_latest(value: newest.front().value_or(fallback: 0))
}

fn task_message(target: StudioAction, payload: own StudioTask) -> ComponentEvent<
    StudioAction,
    StudioTask,
> {
    ComponentEvent<StudioAction, StudioTask> {
        kind: ComponentEventKind::TaskMessage,
        target: target,
        request: 0,
        key: 0,
        detail: 0,
        value: 0.0,
        timestamp: 0.0,
        text: BrowserString { ptr: 0, len: 0 },
        task: payload,
    }
}

struct ViewportMessage {}
struct GestureMerge {}
struct VisibilityMessage {}
struct DeviceMessage {}
struct FailureMessage {}

impl Copy for ViewportMessage {}
impl Copy for GestureMerge {}
impl Copy for VisibilityMessage {}
impl Copy for DeviceMessage {}
impl Copy for FailureMessage {}

impl Fn<Viewport, ComponentEvent<StudioAction, StudioTask>> for ViewportMessage {
    fn call(self, _ viewport: own Viewport) -> ComponentEvent<StudioAction, StudioTask> {
        task_message(
            target: StudioAction::ViewportObserved,
            payload: StudioTask::default().with_viewport(value: viewport),
        )
    }
}

impl MergePolicy<
    PointerSample,
    WheelSample,
    ComponentEvent<StudioAction, StudioTask>,
> for GestureMerge {
    fn map_left(
        self,
        _ sample: own PointerSample,
        _ dropped: u32,
    ) -> ComponentEvent<StudioAction, StudioTask> {
        task_message(
            target: StudioAction::PointerObserved,
            payload: StudioTask::default().with_pointer(sample: sample, dropped: dropped),
        )
    }
    fn map_right(
        self,
        _ sample: own WheelSample,
        _ dropped: u32,
    ) -> ComponentEvent<StudioAction, StudioTask> {
        task_message(
            target: StudioAction::WheelObserved,
            payload: StudioTask::default().with_wheel(value: sample, dropped: dropped),
        )
    }

    fn map_failure(
        self,
        _ side: MergeSide,
        _ error: u32,
    ) -> ComponentEvent<StudioAction, StudioTask> {
        match side {
            MergeSide::Left => task_message(
                target: StudioAction::StreamFailed,
                payload: StudioTask::default().with_error(value: error),
            ),
            MergeSide::Right => task_message(
                target: StudioAction::StreamFailed,
                payload: StudioTask::default().with_error(value: error),
            ),
        }
    }
}

impl Fn<DocumentVisibility, ComponentEvent<StudioAction, StudioTask>> for VisibilityMessage {
    fn call(self, _ visibility: own DocumentVisibility) -> ComponentEvent<
        StudioAction,
        StudioTask,
    > {
        task_message(
            target: StudioAction::VisibilityObserved,
            payload: StudioTask::default().with_visibility(value: visibility),
        )
    }
}

impl Fn<GpuDeviceEvent, ComponentEvent<StudioAction, StudioTask>> for DeviceMessage {
    fn call(self, _ device: own GpuDeviceEvent) -> ComponentEvent<StudioAction, StudioTask> {
        task_message(
            target: StudioAction::DeviceObserved,
            payload: StudioTask::default().with_device(value: device),
        )
    }
}

impl Fn<u32, ComponentEvent<StudioAction, StudioTask>> for FailureMessage {
    fn call(self, _ error: own u32) -> ComponentEvent<StudioAction, StudioTask> {
        task_message(
            target: StudioAction::StreamFailed,
            payload: StudioTask::default().with_error(value: error),
        )
    }
}

fn report(target: StudioAction, payload: StudioTask) -> bool
uses (
    sink: mut ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>>,
    suspend: Suspend<WasmBackend, u32>,
)
{
    let event = task_message(target: target, payload: payload)
    let outcome: TaskOutcome<u32, ()> = ActorMessage::new(event).send()
    match outcome {
        TaskOutcome::Success(_,) => true,
        TaskOutcome::Failure(_,) => false,
        TaskOutcome::Cancelled => false,
    }
}

fn observe_viewports() -> u32
uses (
    viewport_events: mut EventSource<Viewport>,
    sink: mut ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>>,
    suspend: Suspend<WasmBackend, u32>,
)
{
    forward_to_actor(map: ViewportMessage {}, map_failure: FailureMessage {}).delivered
}

fn observe_gestures() -> u32
uses (
    pointer_events: mut AsyncEventSource<WasmBackend, PointerSample>,
    wheel_events: mut AsyncEventSource<WasmBackend, WheelSample>,
    sink: mut ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>>,
    select: mut Select<WasmBackend, u32>,
    suspend: Suspend<WasmBackend, u32>,
)
{
    merge_buffer_to_actor<
        PointerSample,
        WheelSample,
        ComponentEvent<StudioAction, StudioTask>,
        GestureMerge,
    >(
        initial: task_message(
            target: StudioAction::StreamFailed,
            payload: StudioTask::default(),
        ),
        capacity: 3,
        // Pointer and wheel listeners stay independently pending while one
        // actor delivery is in flight. The merged Fe queue preserves that
        // in-flight value and keeps the newest bounded shared backlog.
        overflow: OverflowPolicy::KeepLatest,
        policy: GestureMerge {},
    ).delivered
}

fn observe_visibility() -> u32
uses (
    visibility_events: mut EventSource<DocumentVisibility>,
    sink: mut ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>>,
    suspend: Suspend<WasmBackend, u32>,
)
{
    forward_to_actor(map: VisibilityMessage {}, map_failure: FailureMessage {}).delivered
}

fn observe_devices() -> u32
uses (
    device_events: mut EventSource<GpuDeviceEvent>,
    sink: mut ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>>,
    suspend: Suspend<WasmBackend, u32>,
)
{
    forward_to_actor(map: DeviceMessage {}, map_failure: FailureMessage {}).delivered
}

/// Pull one animation frame only after the Fe timer interval has elapsed.
/// Browser callbacks realize the two raw clocks; this loop owns their ordering,
/// rate, cancellation, failure policy, and actor delivery.
fn observe_paced_frames() -> u32
uses (
    frame_events: mut EventSource<AnimationFrame>,
    timer: mut Timer<WasmBackend>,
    sink: mut ActorSink<WasmBackend, ComponentEvent<StudioAction, StudioTask>>,
    suspend: Suspend<WasmBackend, u32>,
)
{
    let stream: Stream<AnimationFrame> = Stream::new()
    let mut subscription = stream.subscribe()
    let mut observations: u32 = 0
    let mut running = true
    while running {
        match sleep(milliseconds: FRAME_PACE_MS) {
            TaskOutcome::Success(_,) => {
                running = report(
                    target: StudioAction::TimerElapsed,
                    payload: timer_task(sequence: observations),
                )
                if running {
                    let next = stream.next_ready(subscription)
                    subscription = next.0
                    match next.1 {
                        Event::Occurrence(frame,) => {
                            running = report(
                                target: StudioAction::FrameObserved,
                                payload: StudioTask::default().with_frame(value: frame),
                            )
                            if running {
                                observations = observations + 1
                            }
                        },
                        Event::Absent => {},
                        Event::End => {
                            running = false
                        },
                        Event::Failure(error,) => {
                            report(
                                target: StudioAction::StreamFailed,
                                payload: StudioTask::default().with_error(value: error),
                            )
                            running = false
                        },
                        Event::Cancelled => {
                            stream.cancel(subscription)
                            return observations
                        },
                    }
                }
            },
            TaskOutcome::Failure(error,) => {
                report(
                    target: StudioAction::StreamFailed,
                    payload: StudioTask::default().with_error(value: error),
                )
                running = false
            },
            TaskOutcome::Cancelled => {
                stream.cancel(subscription)
                return observations
            },
        }
    }
    stream.cancel(subscription)
    observations
}

actor EventStudio {
    patch_ptr: u32,
    width: u32,
    height: u32,
    pixel_ratio_percent: u32,
    observations: u32,
    pointer_x: u32,
    pointer_y: u32,
    pointer_events: u32,
    wheel_events: u32,
    visible: bool,
    visibility_events: u32,
    frame_events: u32,
    timer_events: u32,
    frame_timestamp: u32,
    bounded_drops: u32,
    latest_value: u32,
    failures: u32,
    connected: bool,
    device_kind: GpuDeviceEventKind,
    device_reason: GpuDeviceLossReason,
    device_generation: u32,
    device_events: u32,
    device_missed: u32,

    const fn view() -> ComponentView<VIEW_CAPACITY> uses (ComponentComposition) {
        let ui = <StudioParts as ComponentSchema>::component_parts()
        PageBuilder::new()
            .open(element: PageElement::Section)
            .attribute(value: PageAttribute::class(value: "event-studio-panel"))
            .open(element: PageElement::Heading2)
            .text(value: ui_text(value: "Event Studio"))
            .close()
            .open(element: PageElement::Paragraph)
            .attribute(value: PageAttribute::class(value: "event-studio-copy"))
            .text(value: ui_text(value: "Resize, point, touch, or "))
            .text(value: ui_text(value: "wheel: typed Fe streams own "))
            .text(value: ui_text(value: "update."))
            .close()
            .open(element: PageElement::Paragraph)
            .attribute(value: PageAttribute::class(value: "event-studio-copy"))
            .text(value: ui_text(value: "Fe selects scoped capture; "))
            .text(value: ui_text(value: "pointer + wheel share one "))
            .text(value: ui_text(value: "bounded queue; paced clock "))
            .text(value: ui_text(value: "shared GPU lifecycle is Fe."))
            .close()
            .open(element: PageElement::Div)
            .attribute(value: PageAttribute::class(value: "event-studio-grid"))
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "width · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.width))
            .text(value: ui_text(value: "0"))
            .close()
            .text(value: ui_text(value: " css px"))
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "height · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.height))
            .text(value: ui_text(value: "0"))
            .close()
            .text(value: ui_text(value: " css px"))
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "dpr × 100 · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.pixel_ratio))
            .text(value: ui_text(value: "0"))
            .close()
            .close()
            .open(element: PageElement::Paragraph)
            .text(value: ui_text(value: "pointer x · "))
            .open(element: PageElement::Strong)
            .attribute(value: PageAttribute::node(value: ui.pointer_x))
            .text(value: ui_text(value: "0"))
            .close()
