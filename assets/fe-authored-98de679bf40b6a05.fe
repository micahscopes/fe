//! A pencil of spheres on a slice plane, drawn per pixel by a reflected
//! classic-CGA expression: the qcga demo's sibling, same generic compiler,
//! different named conformal basis.
//!
//! `Cga3Basis` states three positive generators and one typed null pair.
//! `Vector<Coefficients>` aligns coefficient records to that basis by reflected
//! field name; `CompileNamedVectorDotF32<Point, Sphere, Metric>` derives
//! support, pair routing, signs, and straight-line scalar arithmetic. No
//! numeric support, plan mask, candidate routing, or demo-local provider is
//! authored here.
//!
//! The resulting algebra is the familiar coordinate-free incidence
//!     X . S* = x.c - |x|^2/2 - (|c|^2 - r^2)/2 = -(|x - c|^2 - r^2)/2
//! for the point embedding X = x + eo1 + (|x|^2/2) ei1 and the dual sphere
//! S* = c + eo1 + ((|c|^2 - r^2)/2) ei1: incidence is zero exactly on the
//! sphere.
//!
//! The picture: the y = 0 slice of the pencil member
//! S(lambda) = cos(PI*lambda) * S1 + sin(PI*lambda) * S2, two fixed generator
//! spheres whose center axis `theta` rotates. Incidence is LINEAR in the dual
//! sphere, so the coefficient blend IS the classic pencil of spheres through
//! the generators' common circle; where the blended eo1 weight crosses zero
//! the member degenerates to the radical PLANE (a sphere through infinity),
//! the slice curve snapping from circles to a line and back. Five generated
//! incidence evaluations per pixel (field + exact gradient), zero set drawn as the
//! gradient-normalized curve over a signed-field wash, mirroring qcga.
//!
//! Software rendering (lavapipe/SwiftShader) in the sandbox; no performance or
//! parallelism claim (VISION 3.1).
//!
//!     fe web build demos/sketches/cga3d --out <dir>

use core::marker::Copy
use std::webgpu::{
    FragmentSurface, GpuProgram, LatestPerFrame, ResponsiveBacking,
    StandardSurfaceRecovery, SurfaceQuality, SurfaceRecovery, SurfaceScheduling,
    SurfaceTransition, WebGpuBackend,
}
use std::web::view::{
    ApplyParamBindings, Extent, Param, ParamBindingsProvider, Surface,
    SurfaceEvent, SurfaceState,
}
use ga_expr::{
    BasisMetric, CompileNamedVectorDotF32, EvaluateVectorScalarF32,
    Null, Positive, Prime,
}
use fmath::{PI, abs, clamp01, cos, from_i32, mix, rgba, sin, smoothstep, sqrt}
use gallery_palette::{electric_blue, midnight, spring_green, theorem_gold}

// ---------------------------------------------------------------------------
// The complete Cl(4,1) authoring surface. The shared compiler derives the
// dimension, sparse support, and eo/ei metric products from these named types.
// ---------------------------------------------------------------------------

struct CgaPair {}
struct Cga3Basis {
    e1: Positive, e2: Positive, e3: Positive,
    eo: Null<CgaPair>, ei: Prime<CgaPair>,
}
type Cga3Metric = BasisMetric<Cga3Basis>
struct CgaPointCoefficients {
    e1: f32, e2: f32, e3: f32, eo: f32, ei: f32,
}
struct DualSphereCoefficients {
    e1: f32, e2: f32, e3: f32, eo: f32, ei: f32,
}
struct SphereIncidenceOperands {
    point: CgaPointCoefficients,
    sphere: DualSphereCoefficients,
}
derive EvaluateVectorScalarF32 for SphereIncidenceOperands using CompileNamedVectorDotF32<
    CgaPointCoefficients, DualSphereCoefficients, Cga3Metric,
>

// ---------------------------------------------------------------------------
// The classic point embedding and dual-sphere values.
// ---------------------------------------------------------------------------

/// Embed a Euclidean point and contract it with a dual sphere's five
/// coefficients: X = x e1 + y e2 + z e3 + eo1 + (|x|^2 / 2) ei1.
pub fn cga3d_incidence(
    x: f32, y: f32, z: f32,
    sx: f32, sy: f32, sz: f32, so: f32, si: f32,
) -> f32 {
    let half: f32 = 0.5
    <SphereIncidenceOperands as EvaluateVectorScalarF32>::scalar(SphereIncidenceOperands {
        point: CgaPointCoefficients {
            e1: x, e2: y, e3: z, eo: 1.0,
            ei: (x * x + y * y + z * z) * half,
        },
        sphere: DualSphereCoefficients {
            e1: sx, e2: sy, e3: sz, eo: so, ei: si,
        },
    })
}

/// A dual sphere as a value: the five null-basis coefficients. Linear
/// combinations of these ARE the pencil of spheres, which is the whole demo.
pub struct DualSphere {
    pub x: f32, pub y: f32, pub z: f32,
    /// eo1 coefficient; zero means the "sphere" is a plane.
    pub o: f32,
    /// ei1 coefficient.
    pub i: f32,
}
impl Copy for DualSphere {}

/// S* = c + eo1 + ((|c|^2 - r^2) / 2) ei1.
pub fn dual_sphere(_ cx: f32, _ cy: f32, _ cz: f32, _ r: f32) -> DualSphere {
    DualSphere {
        x: cx, y: cy, z: cz,
        o: 1.0,
        i: 0.5 * (cx * cx + cy * cy + cz * cz - r * r),
    }
}

/// Point/sphere incidence through the compiled named-vector dot, rescaled by
/// -2 so a NORMALIZED sphere (o = 1) reads as |x - c|^2 - r^2: positive
/// outside, negative inside, zero on the surface. Every "is this point on the
/// sphere" below flows through here.
pub fn eval_sphere(_ s: DualSphere, _ x: f32, _ y: f32, _ z: f32) -> f32 {
    -2.0 * cga3d_incidence(
        x: x, y: y, z: z,
        sx: s.x, sy: s.y, sz: s.z, so: s.o, si: s.i,
    )
}

// ---------------------------------------------------------------------------
// THE ACTOR: one program, one per-pixel behavior, mirroring qcga's
// `QcgaSurface` so the two demos read as siblings. The interactive boundary is
// DECLARED in `view()` (web v5): the runtime reads real slider ranges/init/kind
// and the dispatch extent from the projected manifest `surface` section, so
// there is no `const RESOLUTION`, no `[0, 128]` slider guess, and no uniform
// search. `res` is bound to the live canvas width, replacing the baked size.
// ---------------------------------------------------------------------------

/// The per-demo params record: field names bind, by name identity, to the
/// actor's state fields (checked at projection time).
struct Cga3dParams {
    lambda: Param,
    theta: Param,
    zoom: Param,
    res: Param,
}

struct Cga3dViewState {
    lambda: f32,
    theta: f32,
    zoom: f32,
    res: f32,
}

impl SurfaceState for Cga3dViewState {
    type Params = Cga3dParams
}

derive ApplyParamBindings for Cga3dViewState using ParamBindingsProvider

/// One Fe declaration feeds both the projected sliders and the generated
/// pointer/wheel transition. Binding policy never enters the web manifest.
const fn cga3d_params() -> Cga3dParams {
    Cga3dParams {
        lambda: Param::unit(init: 0.15).drag_x(per_px: 0.0025),
        theta: Param::angle(init: 0.6).drag_y(per_px: 0.01),
        zoom: Param::range(min: 0.5, max: 4.0, init: 1.6)
            .wheel_scale(in_factor: 0.875, out_factor: 1.125),
        res: Param::extent_x(),
    }
}

actor Cga3dSurface uses (
    GpuProgram<WebGpuBackend>, SurfaceQuality<ResponsiveBacking>,
    SurfaceRecovery<StandardSurfaceRecovery>,
) {
    /// Pencil parameter: [0, 1] sweeps sphere -> sphere -> radical plane.
    lambda: f32,
    /// Rotation of the generator axis in the slice plane.
    theta: f32,
    /// Half-extent of the visible slice in world units.
    zoom: f32,
    /// Surface extent in pixels (runtime-fed; replaces `const RESOLUTION`).
    res: f32,

    /// The surface declaration: CTFE-evaluated at bundle time and projected
    /// into the manifest `surface` section. Never lowered to wasm or WGSL.
    const fn view() -> Surface<Cga3dParams> {
        Surface {
            extent: Extent::square(512),
            params: cga3d_params(),
        }
    }

    /// Drag sweeps and rotates the sphere pencil; wheel changes slice scale.
    fn navigate(self, event: own SurfaceEvent) -> Cga3dViewState
        uses (SurfaceTransition, SurfaceScheduling<LatestPerFrame>)
    {
        let current = Cga3dViewState {
            lambda: self.lambda,
            theta: self.theta,
            zoom: self.zoom,
            res: self.res,
        }
        current.apply_param_bindings(cga3d_params(), event)
    }

    /// Pixel coordinate in, packed RGBA8 word out. Five generated incidence
    /// per pixel: the field and its exact slice gradient (the field is
    /// quadratic in position, so h = 1 central differences are exact).
    fn shade(self, px: i32, py: i32) -> i32 uses (FragmentSurface) {
        // Pixel centre to the y = 0 slice plane: screen x -> world x, screen
        // y (up) -> world z.
        let u: f32 = ((from_i32(px) + 0.5) / self.res * 2.0 - 1.0) * self.zoom
        let v: f32 = (1.0 - (from_i32(py) + 0.5) / self.res * 2.0) * self.zoom

        // Two fixed generator spheres on an axis theta rotates; both centres
        // stay in the slice plane so their circles are real.
        let ct: f32 = cos(self.theta)
        let st: f32 = sin(self.theta)
        let dx: f32 = 0.55 * ct
        let dz: f32 = 0.55 * st
        let s1: DualSphere = dual_sphere(0.0 - dx, 0.0, 0.0 - dz, 0.8)
        let s2: DualSphere = dual_sphere(dx, 0.0, dz, 0.8)

        // The pencil member: incidence is linear in the dual sphere, so this
        // coefficient blend IS the pencil through the generators' common
        // circle. Where the eo1 weight w0 + w1 crosses zero (lambda = 0.75)
        // the member is the radical plane.
        let w0: f32 = cos(PI * self.lambda)
        let w1: f32 = sin(PI * self.lambda)
        let s: DualSphere = DualSphere {
            x: w0 * s1.x + w1 * s2.x,
            y: w0 * s1.y + w1 * s2.y,
            z: w0 * s1.z + w1 * s2.z,
            o: w0 * s1.o + w1 * s2.o,
            i: w0 * s1.i + w1 * s2.i,
        }

        // One named-basis incidence evaluator, sampled for field and gradient.
        let f0: f32 = eval_sphere(s, u, 0.0, v)
        let gx: f32 = (eval_sphere(s, u + 1.0, 0.0, v) - eval_sphere(s, u - 1.0, 0.0, v)) * 0.5
        let gz: f32 = (eval_sphere(s, u, 0.0, v + 1.0) - eval_sphere(s, u, 0.0, v - 1.0)) * 0.5
        let gmag: f32 = sqrt(gx * gx + gz * gz) + 0.0000001

        // First-order distance to the zero set in world units, then a
        // resolution-aware curve mask.
        let dist: f32 = abs(f0) / gmag
        let pixel_w: f32 = self.zoom * 2.0 / self.res
        let curve: f32 = 1.0 - smoothstep(0.0, pixel_w * 1.5, dist)

        // Signed field in the original Desargues construction palette: blue
        // inside, green outside, and theorem gold on the zero set.
        let sq: f32 = f0 / (1.0 + abs(f0))
        let inside: f32 = clamp01(0.0 - sq)
        let outside: f32 = clamp01(sq)
        let ground = midnight()
        let cool = electric_blue()
        let warm = spring_green()
        let zero = theorem_gold()
        let field_red: f32 = ground.red
            + inside * (cool.red - ground.red)
            + outside * (warm.red - ground.red)
        let field_green: f32 = ground.green
            + inside * (cool.green - ground.green)
            + outside * (warm.green - ground.green)
        let field_blue: f32 = ground.blue
            + inside * (cool.blue - ground.blue)
            + outside * (warm.blue - ground.blue)
        let red: f32 = mix(field_red, zero.red, curve)
        let grn: f32 = mix(field_green, zero.green, curve)
        let blu: f32 = mix(field_blue, zero.blue, curve)
        rgba(red, grn, blu)
    }
}
