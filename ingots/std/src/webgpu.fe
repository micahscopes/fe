use core::backend::{Backend, Supports, Global, Constant, Shared, Local}
use core::atomic::Atomic
use core::barrier::Barrier
use core::conal::Functor
use core::Fn
use core::MemPtr
use core::EffectHandle
use core::num::IntDowncast
use raw::{gpu_buffer_create, gpu_upload, gpu_dispatch, gpu_readback_begin, wait as async_wait}

/// A TYPE-LEVEL browser WebGPU backend (the WGSL device model under the browser's
/// PORTABLE limits).
///
/// This is NOT a code-generation backend on this branch: kernels are emitted by
/// the external schedule-walker harness (the mini-Garamon `emit-web` binary) until
/// B4 (fe-emitted WGSL) lands, and WebGPU EXECUTION is browser-only and never
/// sandbox-verifiable (no WebGPU secure context here). `WebGpuBackend` exists so
/// the browser demo's interface is a compiler-checked contract rather than a JS
/// convention: the Fe side pins the storage classes, the parallel envelope, and
/// the atomic/barrier grant matrix, and the JS host implements them op-for-op.
///
/// It is a DISTINCT backend, not a reuse of `GpuBackend`: the branch's whole
/// discipline is anti-conflation of backend FACTS, and the browser's facts
/// genuinely differ from the native-Vulkan posture `GpuBackend` carries. WGSL has
/// no 64-bit integer, and the PORTABLE barrier-synchronized envelope is 256
/// invocations per workgroup (`maxComputeInvocationsPerWorkgroup`, `2^8`), where
/// `GpuBackend` assumes the native dispatch-grid envelope (`2^24`). That single
/// distinguishing fact (`MAX_PAR_LOG2 = 8`) is what lets the type system reject a
/// fused schedule that exceeds the WebGPU workgroup limit; see the
/// `webgpu_envelope_rejection` jewel fixture. The anti-conflation matrix stays
/// four-way non-degenerate (two GPU-shaped backends that must not conflate).
pub struct WebGpuBackend {}

/// WebGPU class-typed reference: a bind-group BINDING INDEX, which is what a
/// WebGPU resource honestly is at the API boundary (not a pointer). `T` and `S`
/// are phantom (representation-only stand-in, like the other backends' refs); the
/// class marker `S` lives in the TYPE and keys the WGSL address space (see the
/// marker -> WGSL table below). NO methods/ops in this slice.
pub struct WebGpuRef<T, S> { binding: u32 }

impl Backend for WebGpuBackend {
    /// WGSL's numeric model is 32-bit; there is no u64 in the language.
    const WORD_BITS: usize = 32
    // WGSL defines wrapping integer arithmetic (same doc caveat as `GpuBackend`:
    // "wraps in practice, no trap exists" is a doc note, not a guarantee).
    const OVERFLOW_WRAPS: bool = true
    /// The PORTABLE single-workgroup envelope: `maxComputeInvocationsPerWorkgroup`
    /// is 256 on every WebGPU implementation, so `2^8` is the widest `Par` a
    /// BARRIER-SYNCHRONIZED (fused single-dispatch) schedule may assume. This is
    /// deliberately the workgroup envelope, not the dispatch grid (~`2^24`): v1
    /// providers fuse within one workgroup; the phase-per-dispatch provider that
    /// unlocks the grid envelope is a later, additive fact change. Opinionated
    /// default per guts-over-sugar: tunable, never blocking.
    const MAX_PAR_LOG2: usize = 8
    type Word = u32
    // Impl-side representation choice: a WebGPU device buffer honestly IS a
    // global-class storage binding, so the backend picks `WebGpuRef<T, Global>`
    // as its buffer, exactly the `GpuRef<T, Global>` posture. This is per-impl
    // representation, not trait doctrine, and it exercises marker substitution
    // through a GAT RHS.
    type Buffer<T> = WebGpuRef<T, Global>
    type Ref<T, S> = WebGpuRef<T, S>
}

/// The WebGPU backend's buffer container is a `Functor`, satisfying the D1
/// `type Buffer<T>: Functor<T>` bound on `core::Backend`. `WebGpuBackend::Buffer<T>`
/// is `WebGpuRef<T, Global>` (a global-class storage binding), so this impl
/// discharges the bound by SUBSTITUTING the class marker `Global` through the GAT
/// RHS. `map` is a type-level stub (`core::panic()`, never-typed): no WebGPU
/// pipeline exists on this branch (kernels are harness-emitted; execution is
/// browser-only), so this body is never lowered here, matching the
/// `GpuRef` / `WebGpuAtomics` / `WebGpuBarriers` stub posture.
impl<X> Functor<X> for WebGpuRef<X, Global> {
    type Out<Y> = WebGpuRef<Y, Global>

    fn map<Y, F: Fn<X, Y>>(self, _ f: F) -> WebGpuRef<Y, Global> {
        core::panic()
    }
}

// ---------------------------------------------------------------------------
// Storage-class grant matrix for WebGPU: the marker -> WGSL address space rule.
// ---------------------------------------------------------------------------
//
// WebGPU supports all four core storage classes (unlike EVM/wasm, which lack
// `Shared`). The normative mapping (design 2.2), extending the core markers'
// SPIR-V mapping into WGSL address spaces and the WebGPU binding surface:
//
//   | Fe marker | SPIR-V (core)   | WGSL address space          | WebGPU binding surface                          |
//   |-----------|-----------------|-----------------------------|-------------------------------------------------|
//   | Global    | StorageBuffer   | var<storage, read_write>    | "storage" / "read-only-storage" buffer binding  |
//   | Constant  | Uniform         | var<uniform>                | "uniform" binding (64 KiB portable size limit)  |
//   | Shared    | Workgroup       | var<workgroup>              | NOT bindable: module-scope only, no host traffic|
//   | Local     | Function        | function-scope var          | not visible at the host/device boundary         |
//
// The load-bearing rule this pins: only `Global` and `Constant` refs can appear
// in a kernel's host-visible signature, and the binding layout is DERIVED from
// the class-typed signature (bindings assigned in parameter declaration order
// within @group(0)). `Shared` state is module-scope in the kernel and never
// crosses the boundary; `Local` never appears at the boundary. A JS host cannot
// bind a `Shared` buffer wrongly because no such binding exists to construct, and
// the Fe side cannot pass a `WebGpuRef<T, Shared>` where a dispatch surface wants
// `Global` because the marker is in the type. `Supports<S>` gates the TYPE layer;
// the term-level capabilities (atomics/barriers below) gate operations.
impl Supports<Global> for WebGpuBackend {}
impl Supports<Constant> for WebGpuBackend {}
impl Supports<Shared> for WebGpuBackend {}
impl Supports<Local> for WebGpuBackend {}

// ---------------------------------------------------------------------------
// The WebGPU atomic capability (DECLARATION-LEVEL only), the B1 idiom.
// ---------------------------------------------------------------------------
//
// The grant matrix wants `Global` and `Shared` atomic witnesses (WGSL defines
// `atomic<T>` in both `var<storage>` and `var<workgroup>`), so `WebGpuAtomics`
// carries `Atomic<WebGpuBackend, Global>` and `Atomic<WebGpuBackend, Shared>`.
// `Constant`/`Local` have NO provider anywhere, so they compile nowhere, by
// construction: that IS the {Global, Shared} gate (no bespoke check, just
// provider absence + the ordinary obligation error).
//
// These are TYPE-LEVEL stubs: no WebGPU pipeline exists on this branch, so the
// bodies are never lowered here (the HARNESS kernels already execute their
// semantics: WGSL `atomicAdd` / `atomicExchange` / `atomicCompareExchangeWeak` in
// the phase and NTT kernels; fe-emitted WGSL is B4). The bodies call
// `core::panic()` (never-typed), exactly the `GpuAtomics` stub posture.
// `WebGpuBackend` supports both classes, so the `where WebGpuBackend: Supports<S>`
// op bound holds and is not restated here (Fe rejects concrete-type where-bounds,
// `6-0005`).
pub struct WebGpuAtomics {}

impl Atomic<WebGpuBackend, Global> for WebGpuAtomics {
    fn add(mut self, _ r: WebGpuRef<u32, Global>, _ v: u32) -> u32 {
        core::panic()
    }
    fn exchange(mut self, _ r: WebGpuRef<u32, Global>, _ v: u32) -> u32 {
        core::panic()
    }
    fn cas(mut self, _ r: WebGpuRef<u32, Global>, old: u32, new: u32) -> u32 {
        core::panic()
    }
}

impl Atomic<WebGpuBackend, Shared> for WebGpuAtomics {
    fn add(mut self, _ r: WebGpuRef<u32, Shared>, _ v: u32) -> u32 {
        core::panic()
    }
    fn exchange(mut self, _ r: WebGpuRef<u32, Shared>, _ v: u32) -> u32 {
        core::panic()
    }
    fn cas(mut self, _ r: WebGpuRef<u32, Shared>, old: u32, new: u32) -> u32 {
        core::panic()
    }
}

// ---------------------------------------------------------------------------
// The WebGPU barrier capability (DECLARATION-LEVEL only), the B2 idiom.
// ---------------------------------------------------------------------------
//
// Barriers, like atomics, live over `Global` and `Shared`, so `WebGpuBarriers`
// carries `Barrier<WebGpuBackend, Global>` (WGSL `storageBarrier()`) and
// `Barrier<WebGpuBackend, Shared>` (WGSL `workgroupBarrier()`); `Constant`/`Local`
// have none. TYPE-LEVEL stubs: no WebGPU pipeline exists on this branch, so the
// bodies are never lowered here (the harness NTT kernel already executes the
// `workgroupBarrier()` semantics, `log2(n) + 1` of them, one per `BarrierAt`
// wrapper). The bodies are no-ops (barrier returns nothing), the `GpuBarriers`
// posture. `WebGpuBackend` supports both classes, so the
// `where WebGpuBackend: Supports<S>` op bound holds and is not restated (`6-0005`).
pub struct WebGpuBarriers {}

impl Barrier<WebGpuBackend, Global> for WebGpuBarriers {
    fn barrier(mut self) {}
}

impl Barrier<WebGpuBackend, Shared> for WebGpuBarriers {
    fn barrier(mut self) {}
}

// ===========================================================================
// mb2 R3.4a: the compute-dispatch entry model, RATIFIED (arch 4.3 with
// Amendments 1-3a; interop 3.2). The A6-deferred host-side entry model is now the
// FIRST extern-backed provider: the `WorkerGpu` bodies below ARE the raw
// `fe:webgpu` / `fe:async` import calls (`std::webgpu::raw`), so "the import table
// IS the op set" becomes literal, type-checked code. WebGPU EXECUTION stays
// browser-only and is never sandbox-verifiable; this surface is the
// compiler-checked contract the broker mirrors op-for-op (the wasmtime
// fake-device run is R3.4b).
// ===========================================================================

/// A compiled-kernel identity (arch 4.3's `Kernel`, pinned to the concrete
/// `KernelId` per Amendment 3a). v1: an index into the page's pipeline table,
/// pinned by `layout.json`; later, a compiler-emitted identity. A `u32` newtype,
/// sibling of `PendingId` and the buffer-handle `WebGpuRef`: three u32-represented
/// types that cannot cross-contaminate (a kernel id, a pending token, and a
/// binding are distinct Fe types, so none can be passed where another is wanted).
///
/// Pinned to a concrete type rather than left as a `type Kernel` associated type,
/// because the capability is consumed through an ABSTRACT `uses (gpu: mut
/// Dispatch<WebGpuBackend>)` clause, where a provider-associated `Self::Kernel`
/// would be opaque and a concrete `KernelId` argument could not be admitted. This
/// realizes arch 4.3's ratified `Kernel = KernelId`.
pub struct KernelId { id: u32 }

impl KernelId {
    /// Name a pinned pipeline-table kernel by its `layout.json` index.
    pub fn new(_ id: u32) -> KernelId {
        KernelId { id: id }
    }
}

/// A pending host/device operation token (Amendment 3a). `Dispatch::readback_begin`
/// mints one; `Wait::wait` consumes it. A `u32` newtype, distinct from `KernelId`
/// and the buffer-handle, so a token can never stand in for a kernel id or a
/// binding.
pub struct PendingId { id: u32 }

/// Host-side capability over a device backend `B`: the authority to allocate
/// on-device storage, move words across the boundary, and launch kernels (arch
/// 4.3, RATIFIED with Amendments 1-2). What `ContractHost` is to a chain target,
/// `Dispatch` is to a compute target. Gated the house way (the `Atomic` / `Barrier`
/// idiom): a `uses (gpu: mut Dispatch<B>)` obligation, authority-only, discharged
/// by a provider; a missing provider is the ordinary `8-0036` obligation error.
/// Each op additionally demands `B: Supports<Global>` at the call site: host
/// traffic is `Global`-class only (the 2.2 grant matrix), so a backend without the
/// class carries no dispatch surface.
pub trait Dispatch<B: Backend> {
    /// AMENDMENT 1: allocation is an op. The JS broker cannot be implemented
    /// op-for-op without `createBuffer`, so the capability carries it. Returns a
    /// `Global`-class device binding.
    fn create(mut self, _ len_words: u32) -> B::Ref<B::Word, Global>
        where B: Supports<Global>

    /// Move `len_words` words from linear memory at `src` into the device buffer
    /// `dst`.
    fn upload(mut self, _ src: MemPtr<B::Word>, _ len_words: u32,
              _ dst: B::Ref<B::Word, Global>)
        where B: Supports<Global>

    /// Launch `kernel` over `groups` workgroups; bindings are DERIVED from the
    /// kernel's class-typed signature (the 2.2 rule: `Global` / `Constant` refs
    /// only, declaration order within `@group(0)`).
    fn dispatch(mut self, _ kernel: KernelId, _ groups: u32)
        where B: Supports<Global>

    /// AMENDMENT 2 + 3a: readback is a begin/complete pair, because WebGPU
    /// readback (`mapAsync`) is genuinely asynchronous and the capability must not
    /// lie about it. `readback_begin` requests the copy and returns a `PendingId`;
    /// the holder later blocks on it through `Wait`, or the host calls the exported
    /// `on_ready(token)` continuation in degraded mode.
    fn readback_begin(mut self, _ src: B::Ref<B::Word, Global>,
                      _ len_words: u32, _ dst: MemPtr<B::Word>) -> PendingId
        where B: Supports<Global>
}

/// AMENDMENT 3: the authority to BLOCK the current agent until a pending
/// host/device operation is resident. Blocking is an AUTHORITY (legal only where
/// the agent may block), so it is its own capability, gated the house way by
/// provider absence. The worker-side provider realizes it as `Atomics.wait` in the
/// trampoline; NO main-thread provider exists, so Fe code demanding `Wait` cannot
/// be composed into a main-thread entry: the type system enforces the spec's "no
/// `Atomics.wait` on the main thread" rule by construction.
pub trait Wait<B: Backend> {
    /// Block until `pending` is resident.
    fn wait(mut self, _ pending: PendingId)
}

// ---------------------------------------------------------------------------
// The `WorkerGpu` provider: the FIRST extern-backed provider (arch 4.3's
// `BrowserGpu`, worker-seated per interop 2.1). Its method bodies ARE the raw
// `fe:webgpu` / `fe:async` import calls: the compiler now type-checks the exact op
// set the broker services, and the class-typed / newtype surface is unwrapped to
// the boundary `u32`s at the single point where authority meets the import table.
//
// These bodies are REAL calls (not `core::panic()` stubs like the type-level
// atomic / barrier witnesses): they lower to wasm imports (R3.1-R3.3) and EXECUTE
// against the broker (browser) or a wasmtime fake device (R3.4b). The trait
// methods' `where B: Supports<Global>` bounds instantiate here to the CONCRETE
// `WebGpuBackend: Supports<Global>` (which holds by the grant matrix above) and
// are therefore NOT restated on these impl methods (Fe rejects a where-bound on a
// concrete type, `6-0005`); they discharge automatically.
pub struct WorkerGpu {}

impl Dispatch<WebGpuBackend> for WorkerGpu {
    fn create(mut self, _ len_words: u32) -> WebGpuRef<u32, Global> {
        WebGpuRef { binding: gpu_buffer_create(len_words) }
    }

    fn upload(mut self, _ src: MemPtr<u32>, _ len_words: u32, _ dst: WebGpuRef<u32, Global>) {
        gpu_upload(mem_word_addr(src), len_words, dst.binding)
    }

    fn dispatch(mut self, _ kernel: KernelId, _ groups: u32) {
        gpu_dispatch(kernel.id, groups)
    }

    fn readback_begin(mut self, _ src: WebGpuRef<u32, Global>, _ len_words: u32, _ dst: MemPtr<u32>) -> PendingId {
        PendingId { id: gpu_readback_begin(src.binding, len_words, mem_word_addr(dst)) }
    }
}

impl Wait<WebGpuBackend> for WorkerGpu {
    fn wait(mut self, _ pending: PendingId) {
        async_wait(pending.id)
    }
}

/// Narrow a linear-memory `MemPtr<u32>` to the boundary `u32` offset the wasm
/// import table speaks (linear-memory offsets are `u32`). Private to the provider:
/// the raw offset never surfaces in the capability's typed API.
fn mem_word_addr(_ p: MemPtr<u32>) -> u32 {
    let raw_addr: u256 = p.raw()
    let offset: u32 = raw_addr.downcast_truncate()
    offset
}

/// The synchronous-looking `readback` facade over the TWO capabilities (interop
/// 3.2): a `PendingId` minted by `Dispatch::readback_begin` is immediately
/// consumed by `Wait::wait`, so from Fe the words are resident when `readback`
/// returns. No compiler magic: the facade simply DEMANDS both capabilities in one
/// `uses` clause and threads them, the C3 / N2 multi-capability precedent
/// (`uses (evm: mut Evm, par: mut Par<EvmBackend>)`) lifted to two trait-keyed
/// device capabilities. The doc writes this `... |> w.wait`; Fe has no pipe
/// operator, so it is the equivalent two-statement body.
pub fn readback(_ src: WebGpuRef<u32, Global>, _ len_words: u32, _ dst: MemPtr<u32>)
    uses (gpu: mut Dispatch<WebGpuBackend>, w: mut Wait<WebGpuBackend>)
{
    let pending = gpu.readback_begin(src, len_words, dst)
    w.wait(pending)
}
