// mb2 CE-3: the completion-cell control-effects vocabulary now lives
// backend-generic in `core::pending`. Re-export it here for source
// compatibility (the keystone fixtures and WebGPU code keep naming
// `std::webgpu::{Pending, Wait, ...}`); the `WorkerGpu` provider below stays
// DOWNSTREAM in std (provider-placement rule) and realizes `Wait<WebGpuBackend>`
// over `Pending<WebGpuBackend, T>`.
pub use core::pending::{Pending, Wait, Notify, Spawn, TaskId}

/// A TYPE-LEVEL browser WebGPU backend (the WGSL device model under the browser's
/// PORTABLE limits).
///
/// Fe kernels placed on this backend lower through the compiler's portable MIR
/// and SPIR-V path into generated WGSL. WebGPU execution remains browser-only in
/// environments without a secure GPU context. The Fe side pins storage classes,
/// the parallel envelope, and the atomic/barrier grant matrix, while the fixed
/// browser runtime materializes the generated binding and pass manifests.
///
/// It is a DISTINCT backend, not a reuse of `GpuBackend`: the branch's whole
/// discipline is anti-conflation of backend FACTS, and the browser's facts
/// genuinely differ from the native-Vulkan posture `GpuBackend` carries. WGSL has
/// no 64-bit integer, and the PORTABLE barrier-synchronized envelope is 256
/// invocations per workgroup (`maxComputeInvocationsPerWorkgroup`, `2^8`), where
/// `GpuBackend` assumes the native dispatch-grid envelope (`2^24`). That single
/// distinguishing fact (`MAX_PAR_LOG2 = 8`) is what lets the type system reject a
/// fused schedule that exceeds the WebGPU workgroup limit; see the
/// `webgpu_envelope_rejection` jewel fixture. The anti-conflation matrix stays
/// four-way non-degenerate (two GPU-shaped backends that must not conflate).
#[host_capability_backend(webgpu_dispatch)]
pub struct WebGpuBackend {}

// ---------------------------------------------------------------------------
// GPU actor placement, stage, dispatch, and resource vocabulary.
// ---------------------------------------------------------------------------
//
// These name the boundary shape of an `actor` (`GpuProgram<B>`: a surface
// program placed on backend `B`) and the role of a behavior (`FragmentSurface`:
// the per-pixel fragment stage). `fe web` resolves their nominal types and reads
// the compiler attributes below, so aliases work and no source spelling is
// privileged. No trait obligation is raised and the flattened kernel carries
// no placement effect. The `Cx`/`Out`-checked `Stage` vocabulary (layering 2.2)
// that types these roles follows in the typed slice; here they are pure carriers.

/// The boundary shape of a GPU program on backend `B`.
#[gpu_program]
pub struct GpuProgram<B> {}

/// The per-pixel fragment stage role of an actor behavior.
///
/// GPU-stage behaviors execute in Fe declaration order. The first render stage
/// establishes the presentation target; later render stages preserve its
/// colour and update the pixels they cover. An adjacent `VertexStage` /
/// `FragmentStage` pair is one authored raster pass, so a fullscreen field and
/// a small geometric overlay compose without a host-side pass table.
#[gpu_stage(fragment)]
pub struct FragmentSurface {}

/// An authored raster vertex behavior. `V` is the nominal payload the
/// rasterizer interpolates and `D` is its Fe-authored draw policy; the behavior
/// returns `RasterVertex<V>` so clip position is never inferred from
/// application field names or ordering.
#[gpu_stage(vertex)]
pub struct VertexStage<V, D> {}

/// An authored raster fragment behavior consuming the same nominal payload
/// `V` emitted by its program's `VertexStage<V>` behavior.
#[gpu_stage(raster_fragment)]
pub struct FragmentStage<V> {}

/// Clip-space position with an explicit standard meaning. The rasterizer
/// performs the perspective divide by `w`.
#[gpu_clip_position]
pub struct ClipPosition {
    pub x: f32,
    pub y: f32,
    pub z: f32,
    pub w: f32,
}

impl Copy for ClipPosition {}

/// Standard vertex-stage result. The compiler derives locations recursively
/// from `varying`; applications do not assign numeric locations or maintain a
/// parallel interface declaration.
#[gpu_vertex_output]
pub struct RasterVertex<V> {
    pub position: ClipPosition,
    pub varying: V,
}

impl<V: Copy> Copy for RasterVertex<V> {}

/// A compute-stage role with a workgroup shape and dispatch policy in its type.
#[gpu_stage(compute)]
pub struct ComputeSurface<W, D> {}

/// Compile-time WebGPU workgroup dimensions.
#[gpu_workgroup]
pub struct Workgroup<const X: usize, const Y: usize, const Z: usize> {}

/// One three-dimensional index in WebGPU's portable compute invocation model.
pub struct InvocationId {
    pub x: u32,
    pub y: u32,
    pub z: u32,
}

impl Copy for InvocationId {}

/// Complete context of one compute invocation. The compiler maps this nominal
/// Fe value directly onto WebGPU builtins, with no host-populated parameter
/// buffer. Its nested shape keeps related axes together while still flattening
/// to the target's exact scalar interface.
#[gpu_compute_invocation]
pub struct ComputeInvocation {
    pub global: InvocationId,
    pub local: InvocationId,
    pub workgroup: InvocationId,
    pub workgroups: InvocationId,
    pub local_index: u32,
}

impl Copy for ComputeInvocation {}

/// A fixed dispatch grid executed once whenever the pass graph runs.
#[gpu_dispatch(fixed)]
pub struct FixedDispatch<const X: usize, const Y: usize, const Z: usize> {}

/// A fixed dispatch grid executed `N` times in strict queue order through one
/// compiled pipeline. Storage written by one dispatch is visible to the next.
/// This is the type-driven placement for bounded iterative kernels such as
/// cryptographic rounds. The fixed host submits the derived count but owns no
/// application cursor, branch, or protocol decision.
#[gpu_dispatch(repeated)]
pub struct RepeatedDispatch<
    const X: usize,
    const Y: usize,
    const Z: usize,
    const N: usize,
> {}

/// Contract an inner dispatch as its enclosing actor cycle advances.
///
/// Each shift divides the corresponding workgroup dimension by two per cycle
/// iteration, rounding up to one. `REPEAT_DECREMENT` removes that many inner
/// repetitions per iteration and may reach zero on the final iteration. This
/// changes physical placement only. The enclosing `CycledDispatch` still fixes
/// semantic phase order, and the host receives no application cursor or table.
#[gpu_dispatch(tapered)]
pub struct TaperedDispatch<
    Dispatch,
    const X_SHIFT: usize,
    const Y_SHIFT: usize,
    const Z_SHIFT: usize,
    const REPEAT_DECREMENT: usize,
> {}

/// Bound one dispatch's queued repeat work before yielding GPU ownership.
///
/// The fixed browser adapter submits at most `REPEAT_BATCH` repetitions, waits
/// for that queue prefix to complete, then resumes the same ordered dispatch.
/// This is a physical pacing interpretation only. It does not alter values,
/// phase order, cycle order, or the authored dependency graph.
#[gpu_dispatch(cooperative)]
pub struct CooperativeDispatch<
    Dispatch,
    const REPEAT_BATCH: usize,
> {}

/// Place one dispatch policy inside a repeated, ordered actor pass cycle.
///
/// Consecutive compute behaviors carrying the same `Group` are one cycle body.
/// The compiler and fixed host execute that complete body `N` times. This lets
/// Fe express a dependency such as challenge, fold, commit, and bind once,
/// while a typed protocol schedule supplies its round count.
#[gpu_dispatch(cycled)]
pub struct CycledDispatch<Group, Dispatch, const N: usize> {}

/// Repeat one draw policy over a compile-time number of instances.
///
/// The vertex behavior receives `vertex_index` followed by `instance_index`.
/// Keeping instancing as a compositional policy lets the same primitive
/// topology acquire per-instance transforms, LoD keys, or material identity
/// without expanding those values into one flattened vertex stream.
#[gpu_draw(instanced)]
pub struct Instanced<Draw, const INSTANCES: usize> {}

/// The gesture-driven control-state role of an actor behavior (R3 param
/// gestures): a `self`-taking behavior that maps raw gesture deltas (pan
/// `dx`/`dy`, wheel `dzoom`, cursor `mx`/`my`; the reserved gesture-argument
/// vocabulary) plus the actor's own current state onto the next state, e.g.
/// `fn update_view(self, dx: f32, dy: f32, dzoom: f32, mx: f32, my: f32) ->
/// (f32, f32, f32) uses (UpdateSurface)`. Consumed STRUCTURALLY, exactly like
/// `FragmentSurface` above: `fe web` resolves its attributed nominal identity
/// to recover the control export and project the manifest `control`
/// section (gesture -> arg bindings, return -> state-field bindings), so no
/// trait obligation is raised here either. Fe owns ALL gesture math (pan
/// sensitivity, the zoom curve, clamps); the runtime delivers only raw deltas
/// and blits the returned state (no gesture math in JS).
#[gpu_control(surface)]
pub struct UpdateSurface {}

/// Typed replacement for `UpdateSurface`. A behavior using this role takes one
/// `std::web::SurfaceEvent` context record and returns one named record equal to
/// the actor's complete non-resource state. The compiler validates the types
/// and publishes a fixed Wasm surface-transition export; the source function
/// name and record parameter name remain ordinary Fe.
#[gpu_control(typed_surface)]
pub struct SurfaceTransition {}

/// Process at most one coalesced raw surface-input batch per browser
/// presentation opportunity. A separate resident Fe policy consumes typed
/// animation-frame, GPU-completion, visibility, and device facts and returns
/// the present/request-frame decisions. When it permits presentation, the
/// compiler-lowered transition accumulates movement/wheel deltas, keeps the
/// newest remaining input facts, and calls the authored `SurfaceTransition`
/// exactly once. Complete non-resource application and policy state remain in
/// private Wasm globals. The fixed host seeds or explicitly replaces only
/// application state at initialization, extent, and restoration boundaries;
/// frame calls carry raw inputs plus inert external resource slots.
pub struct LatestPerFrame {}

/// Present every browser animation frame while the surface is visible and the
/// device is usable. Application input remains an independent typed queue;
/// the presentation clock itself is also delivered to the surface transition,
/// allowing animation state to be derived in Fe without a browser-side timer.
pub struct ContinuousFrames {}

/// Sample the newest raw input record at the next available presentation
/// frame. Older queued records are discarded by an explicit Fe effect.
pub struct SampleLatest {}

/// Retain input but admit at most one presentation every 32 milliseconds.
/// This concrete standard policy is intentionally ordinary Fe; future policy
/// constructors can generate additional nominal configurations without a new
/// compiler or host vocabulary.
pub struct Throttle {}

/// Retain input until it has been quiet for 80 milliseconds, then present the
/// complete batch. Animation-frame facts provide the clock.
pub struct Debounce {}

/// Accumulate four raw records, or wait at most 64 milliseconds from the first
/// one, before presenting one generated-Wasm batch.
pub struct Accumulate {}

/// Apply strict backpressure: raw input arriving during an in-flight GPU
/// submission is explicitly dropped by Fe.
pub struct DropWhilePresenting {}

/// Select a resident presentation policy on a surface transition. The compiler
/// finds the policy type's unique public inherent function by its nominal
/// `SurfaceScheduleEvent`/`SurfaceScheduleState`/`SurfaceScheduleStep` shape;
/// neither a wrapper behavior nor a reserved function name is required.
#[gpu_control(surface_schedule)]
pub struct SurfaceScheduling<P> {}

/// Select a Fe policy for the surface's physical backing extent. The browser
/// reports raw CSS/device facts through one fixed typed export and realizes the
/// returned extent. Policy identity and implementation remain Fe type data;
/// no quality tier or browser rule is projected into the render manifest.
#[gpu_control(surface_quality)]
pub struct SurfaceQuality<P> {}

/// Actor-level shared-device recovery policy. Placement beside
/// `GpuProgram<WebGpuBackend>` keeps the decision available to pure GPU pass
/// graphs that have no application transition or presentation scheduler.
#[gpu_control(surface_recovery)]
pub struct SurfaceRecovery<P> {}

/// Select a pure Fe policy that decides whether the adorned GPU stage belongs
/// to the current presentation subgraph. `P` must provide exactly one public
/// inherent function from the owning actor's complete non-resource state to
/// `bool`. The compiler memoizes every physical pipeline, evaluates each
/// distinct policy once per presentation, and omits inactive command encoding.
/// No application-specific selector or threshold is projected into the host.
#[gpu_control(pass_activation)]
pub struct PassActivation<P> {}

/// Decide when one compiled pass should become resident. `Lazy` preserves
/// first-use realization, `VisibleIdle` prepares without blocking readiness
/// once the surface is visible, and `Eager` completes preparation before the
/// first presentation. The enum is returned by an ordinary pure Fe policy;
/// the browser never infers preparation from an application mode or name.
#[web_pass_preparation_mode]
pub enum PassPreparationMode {
    Lazy,
    VisibleIdle,
    Eager,
}

impl Copy for PassPreparationMode {}

/// Select a pure Fe pass-preparation policy. `P` must provide exactly one
/// public inherent function from the owning actor's complete non-resource
/// state to `PassPreparationMode`. Preparation changes only physical pipeline
/// residency; `PassActivation` remains the sole authority over execution.
#[gpu_control(pass_preparation)]
pub struct PassPreparation<P> {}

/// Request raw uncaptured primary-pointer motion for this GPU actor while
/// retaining the standard captured primary drag lifecycle. Without this
/// capability, surfaces receive pointer down, captured move, and pointer up
/// only. The fixed browser host reports coordinates and button state; all
/// hover interpretation, coalescing, and application state remain in Fe.
#[gpu_control(surface_pointer_motion)]
pub struct SurfacePointerMotion {}

/// Deliver one completed GPU message `M` into the owning actor. The compiler
/// matches `M` against exactly one `ReadbackWords<M, N>` resource, derives its
/// canonical Wasm value layout, and invokes the authored behavior over the
/// actor's existing resident state. No function name, binding index, or message
/// schema is authored outside Fe.
#[gpu_control(readback)]
pub struct ReadbackTransition<M> {}

/// Raw lifecycle/capability facts for one surface affected by the page's
/// shared WebGPU device. Browser objects remain opaque host authorities.
#[web_surface_recovery_event]
pub struct SurfaceRecoveryEvent {
    pub kind: GpuDeviceEventKind,
    pub reason: GpuDeviceLossReason,
    pub device_required: bool,
    pub software_fallback: bool,
    pub generation: u32,
}

impl Copy for SurfaceRecoveryEvent {}

/// Private Fe supervision state for one loss episode.
#[web_surface_recovery_state]
pub struct SurfaceRecoveryState {
    pub device_lost: bool,
    pub attempts: u32,
}

impl Copy for SurfaceRecoveryState {}

pub enum SurfaceRecoveryAction {
    NoAction,
    RetryDevice,
    DegradeToWasm,
    FailSurface,
}

impl Copy for SurfaceRecoveryAction {}

#[web_surface_recovery_step]
pub struct SurfaceRecoveryStep {
    pub state: SurfaceRecoveryState,
    pub action: SurfaceRecoveryAction,
}

impl Copy for SurfaceRecoveryStep {}

/// Default gallery policy: spend at most two replacement-device requests for
/// an authoritative unknown loss, never retry an explicitly destroyed device,
/// then use a generated Wasm fallback when one exists or fail visibly.
pub struct StandardSurfaceRecovery {}

impl StandardSurfaceRecovery {
    pub fn decide(
        _ event: own SurfaceRecoveryEvent,
        _ state: own SurfaceRecoveryState,
    ) -> SurfaceRecoveryStep {
        let mut device_lost: bool = state.device_lost
        let mut attempts: u32 = state.attempts
        let mut action: SurfaceRecoveryAction = SurfaceRecoveryAction::NoAction

        match event.kind {
            GpuDeviceEventKind::Lost => {
                device_lost = true
                if event.device_required {
                    match event.reason {
                        GpuDeviceLossReason::Destroyed => {
                            action = recovery_terminal(
                                software_fallback: event.software_fallback,
                            )
                        }
                        _ => {
                            if attempts < 2 {
                                attempts = attempts + 1
                                action = SurfaceRecoveryAction::RetryDevice
                            } else {
                                action = recovery_terminal(
                                    software_fallback: event.software_fallback,
                                )
                            }
                        }
                    }
                }
            }
            GpuDeviceEventKind::Unavailable => {
                let recovering: bool = device_lost || attempts > 0
                device_lost = true
                if event.device_required {
                    if recovering && attempts < 2 {
                        attempts = attempts + 1
                        action = SurfaceRecoveryAction::RetryDevice
                    } else {
                        action = recovery_terminal(
                            software_fallback: event.software_fallback,
                        )
                    }
                }
            }
            GpuDeviceEventKind::Available => {
                device_lost = false
                attempts = 0
            }
            GpuDeviceEventKind::Unknown => {}
        }

        SurfaceRecoveryStep {
            state: SurfaceRecoveryState { device_lost, attempts },
            action,
        }
    }
}

/// Raw standards/device facts available when a surface backing store is
/// chosen. Width-like values are f32 because browser CSS geometry and DPR are
/// floating point; WebGPU texture limits are exactly representable at this
/// scale. The browser does not clamp or classify these values first.
#[web_surface_quality_facts]
pub struct SurfaceQualityFacts {
    pub css_width: f32,
    pub css_height: f32,
    pub device_pixel_ratio: f32,
    pub declared_width: f32,
    pub declared_height: f32,
    pub max_texture_dimension_2d: f32,
    pub coarse_pointer: bool,
    pub gpu_available: bool,
}

impl Copy for SurfaceQualityFacts {}

/// Fe's complete backing-store decision. Values are integral f32s at this
/// fixed browser boundary; the host validates that property before assigning
/// them to the standards canvas width/height integers.
#[web_surface_backing_extent]
pub struct SurfaceBackingExtent {
    pub width: f32,
    pub height: f32,
}

impl Copy for SurfaceBackingExtent {}

/// The canonical responsive gallery policy. The numerical ceilings that used
/// to live in JavaScript are ordinary Fe policy here: coarse GPU surfaces use
/// at most 256 pixels on their longer edge, CPU fallbacks use 128 on coarse
/// pointers and 256 otherwise, and all GPU choices respect the reported device
/// texture limit. Aspect is preserved when a ceiling applies.
pub struct ResponsiveBacking {}

fn quality_min(_ left: f32, _ right: f32) -> f32 {
    if left < right { left } else { right }
}

fn quality_max(_ left: f32, _ right: f32) -> f32 {
    if left > right { left } else { right }
}

fn quality_axis(_ css: f32, _ dpr: f32, _ declared: f32) -> f32 {
    let mut css_extent: f32 = css
    if css_extent > 0.0 == false { css_extent = declared }
    let mut ratio: f32 = dpr
    if ratio > 0.0 == false { ratio = 1.0 }
    quality_max(1.0, quality_min(declared, (css_extent * ratio).round()))
}

impl ResponsiveBacking {
    pub fn choose(_ facts: own SurfaceQualityFacts) -> SurfaceBackingExtent {
        let mut width: f32 = quality_axis(
            facts.css_width, facts.device_pixel_ratio, facts.declared_width,
        )
        let mut height: f32 = quality_axis(
            facts.css_height, facts.device_pixel_ratio, facts.declared_height,
        )
        let mut ceiling: f32 = quality_max(facts.declared_width, facts.declared_height)
        if facts.gpu_available {
            if facts.max_texture_dimension_2d > 0.0 {
                ceiling = quality_min(ceiling, facts.max_texture_dimension_2d)
            }
            if facts.coarse_pointer { ceiling = quality_min(ceiling, 256.0) }
        } else {
            ceiling = if facts.coarse_pointer { 128.0 } else { 256.0 }
        }
        let longest: f32 = quality_max(width, height)
        if longest > ceiling {
            let scale: f32 = ceiling / longest
            width = quality_max(1.0, (width * scale).round())
            height = quality_max(1.0, (height * scale).round())
        }
        SurfaceBackingExtent { width: width, height: height }
    }
}

fn frame_schedule(
    _ state: SurfaceScheduleState,
    _ event: SurfaceScheduleEvent,
    _ continuous: bool,
) -> SurfaceScheduleStep {
    let mut presenting: bool = state.presenting
    let mut visible: bool = state.visible
    let mut device_lost: bool = state.device_lost
    let mut present: bool = false
    let mut request_frame: bool = false
    let mut last_presented_at: f32 = state.last_presented_at
    let deadline: f32 = state.deadline
    let mut observed_inputs: u32 = state.observed_inputs
    let demand = continuous || event.pending_events > 0

    if event.kind.is_application_input() {
        observed_inputs = observed_inputs + 1
        request_frame = visible && device_lost == false && presenting == false && demand
    }

    match event.kind {
        SurfaceEventKind::AnimationFrame => {
            if visible && device_lost == false && presenting == false && demand {
                presenting = true
                present = true
                last_presented_at = event.timestamp
            }
        }
        SurfaceEventKind::GpuComplete => {
            presenting = false
            request_frame = visible && device_lost == false && demand
        }
        SurfaceEventKind::Visible => {
            visible = true
            request_frame = device_lost == false && presenting == false && demand
        }
        SurfaceEventKind::Hidden => {
            visible = false
        }
        SurfaceEventKind::DeviceLost => {
            device_lost = true
            presenting = false
        }
        SurfaceEventKind::DeviceRecovered => {
            device_lost = false
            request_frame = visible && presenting == false && demand
        }
        _ => {}
    }

    SurfaceScheduleStep {
        state: SurfaceScheduleState {
            presenting: presenting,
            visible: visible,
            device_lost: device_lost,
            last_presented_at: last_presented_at,
            deadline: deadline,
            observed_inputs: observed_inputs,
        },
        present: present,
        request_frame: request_frame,
        queue: SurfaceQueueAction::Retain,
    }
}

impl LatestPerFrame {
    /// Keep at most one presentation in flight. Browser input remains raw and
    /// queued until an animation-frame fact arrives while the surface is
    /// visible and usable. GPU completion releases backpressure and requests
    /// another frame exactly when more input accumulated in the meantime.
    pub fn decide(
        _ state: own SurfaceScheduleState,
        _ event: own SurfaceScheduleEvent,
    ) -> SurfaceScheduleStep {
        frame_schedule(state, event, false)
    }
}

impl ContinuousFrames {
    /// Keep at most one presentation in flight and request its successor only
    /// after the GPU completes. Visibility and device facts stop and resume the
    /// chain without moving animation policy into the browser host.
    pub fn decide(
        _ state: own SurfaceScheduleState,
        _ event: own SurfaceScheduleEvent,
    ) -> SurfaceScheduleStep {
        frame_schedule(state, event, true)
    }
}

fn recovery_terminal(software_fallback: bool) -> SurfaceRecoveryAction {
    if software_fallback {
        SurfaceRecoveryAction::DegradeToWasm
    } else {
        SurfaceRecoveryAction::FailSurface
    }
}

impl SampleLatest {
    pub fn decide(
        _ event: own SurfaceScheduleEvent,
        _ state: own SurfaceScheduleState,
    ) -> SurfaceScheduleStep {
        let step: SurfaceScheduleStep = LatestPerFrame::decide(state: state, event: event)
        let mut queue: SurfaceQueueAction = SurfaceQueueAction::Retain
        match event.kind {
            SurfaceEventKind::Gesture => { queue = SurfaceQueueAction::KeepLatest }
            SurfaceEventKind::ParamEdit => { queue = SurfaceQueueAction::KeepLatest }
            _ => {}
        }
        step.with_queue(queue: queue)
    }
}

impl Throttle {
    pub fn decide(
        _ state: own SurfaceScheduleState,
        _ event: own SurfaceScheduleEvent,
    ) -> SurfaceScheduleStep {
        let step: SurfaceScheduleStep = LatestPerFrame::decide(state: state, event: event)
        match event.kind {
            SurfaceEventKind::AnimationFrame => {
                if step.present {
                    let first: bool = state.observed_inputs == 0
                    if first == false && event.timestamp < state.last_presented_at + 32.0 {
                        return step.defer(previous: state)
                    }
                }
            }
            _ => {}
        }
        step
    }
}

impl Debounce {
    pub fn decide(
        _ state: own SurfaceScheduleState,
        _ event: own SurfaceScheduleEvent,
    ) -> SurfaceScheduleStep {
        let step: SurfaceScheduleStep = LatestPerFrame::decide(state: state, event: event)
        if event.kind.is_application_input() {
            return step.with_deadline(deadline: event.timestamp + 80.0)
        }
        match event.kind {
            SurfaceEventKind::AnimationFrame => {
                if step.present && event.timestamp < state.deadline {
                    return step.defer(previous: state)
                }
            }
            _ => {}
        }
        step
    }
}

impl Accumulate {
    pub fn decide(
        _ state: own SurfaceScheduleState,
        _ event: own SurfaceScheduleEvent,
    ) -> SurfaceScheduleStep {
        let step: SurfaceScheduleStep = LatestPerFrame::decide(state: state, event: event)
        if event.kind.is_application_input() && state.deadline == 0.0 {
            return step.with_deadline(deadline: event.timestamp + 64.0)
        }
        match event.kind {
            SurfaceEventKind::AnimationFrame => {
                if step.present {
                    if event.pending_events < 4 && event.timestamp < state.deadline {
                        return step.defer(previous: state)
                    } else {
                        return step.with_deadline(deadline: 0.0)
                    }
                }
            }
            _ => {}
        }
        step
    }
}

impl DropWhilePresenting {
    pub fn decide(
        _ event: own SurfaceScheduleEvent,
        _ state: own SurfaceScheduleState,
    ) -> SurfaceScheduleStep {
        let step: SurfaceScheduleStep = LatestPerFrame::decide(state: state, event: event)
        let mut queue: SurfaceQueueAction = SurfaceQueueAction::Retain
        if state.presenting {
            if event.kind.is_application_input() {
                queue = SurfaceQueueAction::Drop
            }
        }
        step.with_queue(queue: queue)
    }
}

/// WebGPU class-typed reference: a bind-group BINDING INDEX, which is what a
/// WebGPU resource honestly is at the API boundary (not a pointer). `T` and `S`
/// are phantom (representation-only stand-in, like the other backends' refs); the
/// class marker `S` lives in the TYPE and keys the WGSL address space (see the
/// marker -> WGSL table below). NO methods/ops in this slice.
pub struct WebGpuRef<T, S> { binding: u32 }

impl Backend for WebGpuBackend {
    /// WGSL's numeric model is 32-bit; there is no u64 in the language.
    const WORD_BITS: usize = 32
    // WGSL defines wrapping integer arithmetic (same doc caveat as `GpuBackend`:
    // "wraps in practice, no trap exists" is a doc note, not a guarantee).
    const OVERFLOW_WRAPS: bool = true
    /// The PORTABLE single-workgroup envelope: `maxComputeInvocationsPerWorkgroup`
    /// is 256 on every WebGPU implementation, so `2^8` is the widest `Par` a
    /// BARRIER-SYNCHRONIZED (fused single-dispatch) schedule may assume. This is
    /// deliberately the workgroup envelope, not the dispatch grid (~`2^24`): v1
    /// providers fuse within one workgroup; the phase-per-dispatch provider that
    /// unlocks the grid envelope is a later, additive fact change. Opinionated
    /// default per guts-over-sugar: tunable, never blocking.
    const MAX_PAR_LOG2: usize = 8
    type Word = u32
    // Impl-side representation choice: a WebGPU device buffer honestly IS a
    // global-class storage binding, so the backend picks `WebGpuRef<T, Global>`
    // as its buffer, exactly the `GpuRef<T, Global>` posture. This is per-impl
    // representation, not trait doctrine, and it exercises marker substitution
    // through a GAT RHS.
    type Buffer<T> = WebGpuRef<T, Global>
    type Ref<T, S> = WebGpuRef<T, S>
}

/// The WebGPU backend's buffer container is a `Functor`, satisfying the D1
/// `type Buffer<T>: Functor<T>` bound on `core::Backend`. `WebGpuBackend::Buffer<T>`
/// is `WebGpuRef<T, Global>` (a global-class storage binding), so this impl
/// discharges the bound by SUBSTITUTING the class marker `Global` through the GAT
/// RHS. `map` is a type-level stub (`core::panic()`, never-typed): this
/// implementation does not execute as ordinary Fe code, so this body is never
/// lowered as a kernel operation, matching the
/// `GpuRef` / `WebGpuAtomics` / `WebGpuBarriers` stub posture.
impl<X> Functor<X> for WebGpuRef<X, Global> {
    type Out<Y> = WebGpuRef<Y, Global>

    fn map<Y, F: Fn<X, Y>>(self, _ f: F) -> WebGpuRef<Y, Global> {
        core::panic()
    }
}

// ---------------------------------------------------------------------------
// Storage-class grant matrix for WebGPU: the marker -> WGSL address space rule.
// ---------------------------------------------------------------------------
//
// WebGPU supports all four core storage classes (unlike EVM/wasm, which lack
// `Shared`). The normative mapping (design 2.2), extending the core markers'
// SPIR-V mapping into WGSL address spaces and the WebGPU binding surface:
//
//   | Fe marker | SPIR-V (core)   | WGSL address space          | WebGPU binding surface                          |
//   |-----------|-----------------|-----------------------------|-------------------------------------------------|
//   | Global    | StorageBuffer   | var<storage, read_write>    | "storage" / "read-only-storage" buffer binding  |
//   | Constant  | Uniform         | var<uniform>                | "uniform" binding (64 KiB portable size limit)  |
//   | Shared    | Workgroup       | var<workgroup>              | NOT bindable: module-scope only, no host traffic|
//   | Local     | Function        | function-scope var          | not visible at the host/device boundary         |
//
// The load-bearing rule this pins: only `Global` and `Constant` refs can appear
// in a kernel's host-visible signature, and the binding layout is DERIVED from
// the class-typed signature (bindings assigned in parameter declaration order
// within @group(0)). `Shared` state is module-scope in the kernel and never
// crosses the boundary; `Local` never appears at the boundary. A JS host cannot
// bind a `Shared` buffer wrongly because no such binding exists to construct, and
// the Fe side cannot pass a `WebGpuRef<T, Shared>` where a dispatch surface wants
// `Global` because the marker is in the type. `Supports<S>` gates the TYPE layer;
// the term-level capabilities (atomics/barriers below) gate operations.
impl Supports<Global> for WebGpuBackend {}
impl Supports<Constant> for WebGpuBackend {}
impl Supports<Shared> for WebGpuBackend {}
impl Supports<Local> for WebGpuBackend {}

// ---------------------------------------------------------------------------
// The WebGPU capability root (`impl Target for WebGpuTarget`).
// ---------------------------------------------------------------------------
//
// The third per-target capability root, and the one the tree could not write
// while `Target::RootEffect` was bound to `ContractHost`: a compute target is
// not a contract host, so the target had to be deferred rather than stated. With
// the bound gone the statement is direct, and the two deliberate ABSENCES below
// are the honest content.
pub struct WebGpuTarget {}

struct WebGpuTargetPrivate {}

/// The WebGPU target's root effect: the queue-shaped outermost handler frame.
/// Carries NO entry interface (no `ContractHost`: a compute target does not host
/// chain-contract selector dispatch with slot storage) and NO
/// `core::contracts::StorageIntrinsic` (the second cross-target negative, so an
/// EVM-storage intrinsic under `#[target(webgpu)]` is rejected as `8-0036`). The
/// queue host interface it will carry is the compute-entry work, additive here.
pub struct WebGpuHost { seal: WebGpuTargetPrivate }

/// The WebGPU target's intrinsic-capability carrier
/// (`<WebGpuTarget as Target>::Intrinsics`). Names the per-target intrinsic
/// family (design #93); the WebGPU intrinsic families are added by later slices.
pub struct WebGpuIntrinsics { seal: WebGpuTargetPrivate }

impl Target for WebGpuTarget {
    type RootEffect = WebGpuHost
    type Intrinsics = WebGpuIntrinsics
}

// DELIBERATELY NO `impl AbiTarget for WebGpuTarget`: no byte-stream codec exists
// at this boundary. The binding layout is the analogue and it is not an `Abi`.
// This absence is the honest statement the old bound made impossible.

// ---------------------------------------------------------------------------
// The WebGPU atomic capability (DECLARATION-LEVEL only), the B1 idiom.
// ---------------------------------------------------------------------------
//
// The grant matrix wants `Global` and `Shared` atomic witnesses (WGSL defines
// `atomic<T>` in both `var<storage>` and `var<workgroup>`), so `WebGpuAtomics`
// carries `Atomic<WebGpuBackend, Global>` and `Atomic<WebGpuBackend, Shared>`.
// `Constant`/`Local` have NO provider anywhere, so they compile nowhere, by
// construction: that IS the {Global, Shared} gate (no bespoke check, just
// provider absence + the ordinary obligation error).
//
// These are TYPE-LEVEL stubs: no WebGPU pipeline exists on this branch, so the
// bodies are never lowered here (the HARNESS kernels already execute their
// semantics: WGSL `atomicAdd` / `atomicExchange` / `atomicCompareExchangeWeak` in
// the phase and NTT kernels; fe-emitted WGSL is B4). The bodies call
// `core::panic()` (never-typed), exactly the `GpuAtomics` stub posture.
// `WebGpuBackend` supports both classes, so the `where WebGpuBackend: Supports<S>`
// op bound holds and is not restated here (Fe rejects concrete-type where-bounds,
// `6-0005`).
pub struct WebGpuAtomics {}

impl Atomic<WebGpuBackend, Global> for WebGpuAtomics {
    fn add(mut self, _ r: WebGpuRef<u32, Global>, _ v: u32) -> u32 {
        core::panic()
    }
    fn exchange(mut self, _ r: WebGpuRef<u32, Global>, _ v: u32) -> u32 {
        core::panic()
    }
    fn cas(mut self, _ r: WebGpuRef<u32, Global>, old: u32, new: u32) -> u32 {
        core::panic()
    }
}

impl Atomic<WebGpuBackend, Shared> for WebGpuAtomics {
    fn add(mut self, _ r: WebGpuRef<u32, Shared>, _ v: u32) -> u32 {
        core::panic()
    }
    fn exchange(mut self, _ r: WebGpuRef<u32, Shared>, _ v: u32) -> u32 {
        core::panic()
    }
    fn cas(mut self, _ r: WebGpuRef<u32, Shared>, old: u32, new: u32) -> u32 {
        core::panic()
    }
}

// ---------------------------------------------------------------------------
// The WebGPU barrier capability (DECLARATION-LEVEL only), the B2 idiom.
// ---------------------------------------------------------------------------
//
// Barriers, like atomics, live over `Global` and `Shared`, so `WebGpuBarriers`
// carries `Barrier<WebGpuBackend, Global>` (WGSL `storageBarrier()`) and
// `Barrier<WebGpuBackend, Shared>` (WGSL `workgroupBarrier()`); `Constant`/`Local`
// have none. TYPE-LEVEL stubs: no WebGPU pipeline exists on this branch, so the
// bodies are never lowered here (the harness NTT kernel already executes the
// `workgroupBarrier()` semantics, `log2(n) + 1` of them, one per `BarrierAt`
// wrapper). The bodies are no-ops (barrier returns nothing), the `GpuBarriers`
// posture. `WebGpuBackend` supports both classes, so the
// `where WebGpuBackend: Supports<S>` op bound holds and is not restated (`6-0005`).
pub struct WebGpuBarriers {}

impl Barrier<WebGpuBackend, Global> for WebGpuBarriers {
    fn barrier(mut self) {}
}

impl Barrier<WebGpuBackend, Shared> for WebGpuBarriers {
    fn barrier(mut self) {}
}

// ===========================================================================
// mb2 R3.4a: the compute-dispatch entry model, RATIFIED (arch 4.3 with
// Amendments 1-3a; interop 3.2). The A6-deferred host-side entry model is now the
// FIRST extern-backed provider: the `WorkerGpu` bodies below ARE the raw
// `fe:webgpu` / `fe:async` import calls (`std::webgpu::raw`), so "the import table
// IS the op set" becomes literal, type-checked code. WebGPU EXECUTION stays
// browser-only and is never sandbox-verifiable; this surface is the
// compiler-checked contract the broker mirrors op-for-op (the wasmtime
// fake-device run is R3.4b).
// ===========================================================================

/// A compiled-kernel identity (arch 4.3's `Kernel`, pinned to the concrete
/// `KernelId` per Amendment 3a). v1: an index into the page's pipeline table,
/// pinned by `layout.json`; later, a compiler-emitted identity. A `u32` newtype,
/// sibling of `Pending<T>` and the buffer-handle `WebGpuRef`: three u32-represented
/// types that cannot cross-contaminate (a kernel id, a pending token, and a
/// binding are distinct Fe types, so none can be passed where another is wanted).
///
/// Pinned to a concrete type rather than left as a `type Kernel` associated type,
/// because the capability is consumed through an ABSTRACT `uses (gpu: mut
/// Dispatch<WebGpuBackend>)` clause, where a provider-associated `Self::Kernel`
/// would be opaque and a concrete `KernelId` argument could not be admitted. This
/// realizes arch 4.3's ratified `Kernel = KernelId`.
pub struct KernelId { id: u32 }

impl KernelId {
    /// Name a pinned pipeline-table kernel by its `layout.json` index.
    pub fn new(_ id: u32) -> KernelId {
        KernelId { id: id }
    }
}

/// Host-side capability over a device backend `B`: the authority to allocate
/// on-device storage, move words across the boundary, and launch kernels (arch
/// 4.3, RATIFIED with Amendments 1-2). What `ContractHost` is to a chain target,
/// `Dispatch` is to a compute target. Gated the house way (the `Atomic` / `Barrier`
/// idiom): a `uses (gpu: mut Dispatch<B>)` obligation, authority-only, discharged
/// by a provider; a missing provider is the ordinary `8-0036` obligation error.
/// Each op additionally demands `B: Supports<Global>` at the call site: host
/// traffic is `Global`-class only (the 2.2 grant matrix), so a backend without the
/// class carries no dispatch surface.
#[host_capability(webgpu_dispatch)]
pub trait Dispatch<B: Backend> {
    /// AMENDMENT 1: allocation is an op. The JS broker cannot be implemented
    /// op-for-op without `createBuffer`, so the capability carries it. Returns a
    /// `Global`-class device binding.
    fn create(mut self, _ len_words: u32) -> B::Ref<B::Word, Global>
        where B: Supports<Global>

    /// Move `len_words` words from linear memory at `src` into the device buffer
    /// `dst`.
    fn upload(mut self, _ src: MemPtr<B::Word>, _ len_words: u32,
              _ dst: B::Ref<B::Word, Global>)
        where B: Supports<Global>

    /// Launch `kernel` over `groups` workgroups; bindings are DERIVED from the
    /// kernel's class-typed signature (the 2.2 rule: `Global` / `Constant` refs
    /// only, declaration order within `@group(0)`).
    fn dispatch(mut self, _ kernel: KernelId, _ groups: u32)
        where B: Supports<Global>

    /// AMENDMENT 2 + 3a: readback is a begin/complete pair, because WebGPU
    /// readback (`mapAsync`) is genuinely asynchronous and the capability must not
    /// lie about it. `readback_begin` requests the copy and returns a
    /// `Pending<B, ()>`; the readback token's payload is UNIT (residency IS the
    /// value: the words land in `dst`, not in the token). The holder later blocks
    /// on it through `Wait`, delivering the unit, or the host calls the exported
    /// `on_ready(token)` continuation in degraded mode.
    fn readback_begin(mut self, _ src: B::Ref<B::Word, Global>,
                      _ len_words: u32, _ dst: MemPtr<B::Word>) -> Pending<B, ()>
        where B: Supports<Global>
}

// AMENDMENT 3: the authority to BLOCK the current agent until a pending
// host/device operation is resident (`Wait<B>`) now lives backend-generic in
// `core::pending` (CE-3) and is re-exported at the top of this module. The
// worker-side WebGPU provider (`WorkerGpu`) realizes it just below; NO
// main-thread provider exists, so Fe code demanding `Wait` cannot be composed
// into a main-thread entry (the spec's "no `Atomics.wait` on the main thread"
// rule enforced by construction).

// ---------------------------------------------------------------------------
// The `WorkerGpu` provider: the FIRST extern-backed provider (arch 4.3's
// `BrowserGpu`, worker-seated per interop 2.1). Its method bodies ARE the raw
// `fe:webgpu` / `fe:async` import calls: the compiler now type-checks the exact op
// set the broker services. Per Amendment 4's transport-newtype extension the raw
// externs now take the capability newtypes WHOLE (`WebGpuRef<u32, Global>`,
// `KernelId`, `Pending<()>`), each transported as its single `u32` word by the ABI, so
// these bodies are PURE PASS-THROUGH: no `.binding` / `.id` field read, no re-wrap,
// no place/`Load`. The class-typed / newtype surface stays intact end-to-end and is
// unwrapped to its word only by the transport ABI at the boundary itself.
//
// These bodies are REAL calls (not `core::panic()` stubs like the type-level
// atomic / barrier witnesses): they lower to wasm imports (R3.1-R3.3) and EXECUTE
// against the broker (browser) or a wasmtime fake device (R3.4b). The trait
// methods' `where B: Supports<Global>` bounds instantiate here to the CONCRETE
// `WebGpuBackend: Supports<Global>` (which holds by the grant matrix above) and
// are therefore NOT restated on these impl methods (Fe rejects a where-bound on a
// concrete type, `6-0005`); they discharge automatically.
pub struct WorkerGpu {}

impl Dispatch<WebGpuBackend> for WorkerGpu {
    fn create(mut self, _ len_words: u32) -> WebGpuRef<u32, Global> {
        gpu_buffer_create(len_words)
    }

    fn upload(mut self, _ src: MemPtr<u32>, _ len_words: u32, _ dst: WebGpuRef<u32, Global>) {
        gpu_upload(src, len_words, dst)
    }

    fn dispatch(mut self, _ kernel: KernelId, _ groups: u32) {
        gpu_dispatch(kernel, groups)
    }

    fn readback_begin(mut self, _ src: WebGpuRef<u32, Global>, _ len_words: u32, _ dst: MemPtr<u32>) -> Pending<WebGpuBackend, ()> {
        gpu_readback_begin(src, len_words, dst)
    }
}

impl Wait<WebGpuBackend> for WorkerGpu {
    // The readback token's payload is unit (`T = ()`): the raw blocking `wait(token)`
    // import returns once the readback is resident, and the typed wait delivers unit
    // (residency IS the value). The token transports WHOLE as its one `u32` word
    // (Amendment 4), so the body is pure pass-through: no `.id` read, no re-wrap.
    fn wait<T>(mut self, _ pending: own Pending<WebGpuBackend, T>) -> T {
        async_wait(pending)
    }
}

/// The synchronous-looking `readback` facade over the TWO capabilities (interop
/// 3.2): a `Pending<()>` minted by `Dispatch::readback_begin` is immediately
/// consumed by `Wait::wait` (delivering unit), so from Fe the words are resident
/// when `readback` returns. No compiler magic: the facade simply DEMANDS both capabilities in one
/// `uses` clause and threads them, the C3 / N2 multi-capability precedent
/// (`uses (evm: mut Evm, par: mut Par<EvmBackend>)`) lifted to two trait-keyed
/// device capabilities. The doc writes this `... |> w.wait`; Fe has no pipe
/// operator, so it is the equivalent two-statement body.
pub fn readback(_ src: WebGpuRef<u32, Global>, _ len_words: u32, _ dst: MemPtr<u32>)
    uses (gpu: mut Dispatch<WebGpuBackend>, w: mut Wait<WebGpuBackend>)
{
    let pending = gpu.readback_begin(src, len_words, dst)
    w.wait(pending)
}
