//! Minimal safe Web facade over generated Web IDL bindings.
//!
//! This module is an ordinary Fe library. The raw declarations in `web/raw.fe`
//! are generated from `web-minimal.webidl` and use the target-neutral
//! `#[host_import]` attribute. Neither the compiler nor this facade contains a
//! DOM-specific lowering path.
//!
//! The current executable surface is intentionally small: borrowed resource
//! tokens plus `u32` and `bool` values. Resource wrappers are consumed by each
//! operation because generated v0 handles are not cloneable. Host code supplies
//! the initial `raw::Window`; converting it is unsafe because only the host
//! session can establish token provenance. Values returned by a safe operation
//! are provenance-preserving wrappers.
//!
//! Owned strings and unrestricted callbacks/promises are not exposed here.
//! The narrow asynchronous operations in `document_events` and `surface_task`
//! are interpreted through the canonical affine runtime-control rail: authored
//! Fe sees typed `EventSource<T>`/`Pending<B, T>` values, while the fixed host
//! realizes only the corresponding standards operation. Adding any broader
//! shape before its ownership protocol executes remains unsound and must fail
//! closed.

pub use component::{self, *}
pub use component_events::{self, *}
pub use document_events::{self, *}
pub use gpu_device_events::{self, *}
pub use page::{self, *}
pub use surface_task::{self, *}
pub use view::{self, *}
pub use window_events::{self, *}

use raw::{
    document_get_document_element,
    element_get_child_element_count,
    element_get_hidden,
    element_set_hidden,
    window_get_document,
    window_get_inner_width,
}

pub struct Window {
    raw: raw::Window,
}

pub struct Document {
    raw: raw::Document,
}

pub struct Element {
    raw: raw::Element,
}

impl Window {
    /// Admit a host-provided Window token.
    ///
    /// The caller must obtain `raw` from the generated adapter's resource
    /// session. Arbitrary integers are not valid resource tokens.
    pub unsafe fn from_raw(_ raw: own raw::Window) -> Self {
        Self { raw }
    }

    pub fn inner_width(own self) -> u32 {
        window_get_inner_width(self_: self.raw)
    }

    pub fn document(own self) -> Document {
        Document { raw: window_get_document(self_: self.raw) }
    }
}

impl Document {
    pub fn document_element(own self) -> Element {
        Element { raw: document_get_document_element(self_: self.raw) }
    }
}

impl Element {
    pub fn child_element_count(own self) -> u32 {
        element_get_child_element_count(self_: self.raw)
    }

    pub fn hidden(own self) -> bool {
        element_get_hidden(self_: self.raw)
    }

    pub fn set_hidden(own self, _ hidden: bool) {
        element_set_hidden(self_: self.raw, value: hidden)
    }
}
