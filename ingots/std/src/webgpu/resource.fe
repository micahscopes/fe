//! Typed logical WebGPU buffer families.
//!
//! A value of `GpuBuffer<...>` is a stage-local capability for one logical
//! actor resource. Its policy axes are type data; the browser handle remains
//! opaque and replaceable across device generations. `T` is deliberately the
//! final parameter so a partially applied family can be rebound without
//! pretending that changing element type executes a pure GPU map.

/// One Fe-authored logical GPU-resource plan. The compiler evaluates this
/// value for a concrete resource type, then derives target-specific bindings,
/// layouts, usages, and cache identities from it.
#[web_resource_plan]
pub struct ResourcePlan {
    kind: ResourceKind,
    access: ResourceAccess,
    residency: ResourceResidency,
    initialization: ResourceInitialization,
    recovery: ResourceRecovery,
    visibility: ResourceVisibility,
}

pub enum ResourceKind {
    Storage,
}

pub enum ResourceAccess {
    ReadOnly,
    WriteOnly,
    ReadWrite,
}

pub enum ResourceResidency {
    Immutable,
    ActorResident,
    FrameTransient,
    Imported,
}

pub struct ResourceDigest {
    words: [u32; 8],
}

pub enum ResourceInitialization {
    Zeroed,
    ContentAddressed(ResourceDigest),
    Derived,
}

pub enum ResourceRecovery {
    ReplayRecipe,
    RestoreCheckpoint,
    Regenerate,
    NonRecoverable,
}

pub enum ResourceVisibility {
    Compute,
    Vertex,
    Fragment,
    ComputeFragment,
    VertexFragment,
    All,
}

impl Copy for ResourcePlan {}
impl Copy for ResourceKind {}
impl Copy for ResourceAccess {}
impl Copy for ResourceResidency {}
impl Copy for ResourceDigest {}
impl Copy for ResourceInitialization {}
impl Copy for ResourceRecovery {}
impl Copy for ResourceVisibility {}

pub trait GpuResourcePolicy {
    const fn plan() -> ResourcePlan
}

pub trait ResourceKindPolicy {
    const fn kind() -> ResourceKind
}

pub trait ResourceAccessPolicy {
    const fn access() -> ResourceAccess
}

/// Residency is indexed by access so illegal custody/access combinations have
/// no evidence. In particular, immutable storage is read-only by construction.
pub trait ResourceResidencyPolicy<Access> {
    const fn residency() -> ResourceResidency
}

pub trait ResourceInitializationPolicy<Access, Residency, Recovery> {
    const fn initialization() -> ResourceInitialization
}

pub trait ResourceRecoveryPolicy {
    const fn recovery() -> ResourceRecovery
}

pub trait ResourceVisibilityPolicy {
    const fn visibility() -> ResourceVisibility
}

/// Storage-buffer logical role. Vertex, index, uniform, indirect, and staging
/// roles join this family in their own implementation slices.
pub struct StorageKind {}

impl ResourceKindPolicy for StorageKind {
    const fn kind() -> ResourceKind { ResourceKind::Storage }
}

/// Shader reads are admitted and stores are rejected by missing evidence.
pub struct ReadOnly {}

/// Shader stores are admitted and loads are rejected by missing evidence.
pub struct WriteOnly {}

/// Both shader loads and stores are admitted.
pub struct ReadWrite {}

impl ResourceAccessPolicy for ReadOnly {
    const fn access() -> ResourceAccess { ResourceAccess::ReadOnly }
}

impl ResourceAccessPolicy for WriteOnly {
    const fn access() -> ResourceAccess { ResourceAccess::WriteOnly }
}

impl ResourceAccessPolicy for ReadWrite {
    const fn access() -> ResourceAccess { ResourceAccess::ReadWrite }
}

pub trait GpuReadable {}
pub trait GpuWritable {}

impl GpuReadable for ReadOnly {}
impl GpuReadable for ReadWrite {}
impl GpuWritable for WriteOnly {}
impl GpuWritable for ReadWrite {}

/// Immutable logical bytes may share one physical realization per device.
pub struct Immutable {}

/// Mutable logical state retained for the lifetime of its owning actor.
pub struct ActorResident {}

/// Pass-graph-local storage whose lifetime can be derived from graph use.
pub struct FrameTransient {}

/// A resource imported from an explicitly authorized external owner.
pub struct Imported {}

impl ResourceResidencyPolicy<ReadOnly> for Immutable {
    const fn residency() -> ResourceResidency { ResourceResidency::Immutable }
}

impl<Access> ResourceResidencyPolicy<Access> for ActorResident {
    const fn residency() -> ResourceResidency { ResourceResidency::ActorResident }
}

impl<Access> ResourceResidencyPolicy<Access> for FrameTransient {
    const fn residency() -> ResourceResidency { ResourceResidency::FrameTransient }
}

impl<Access> ResourceResidencyPolicy<Access> for Imported {
    const fn residency() -> ResourceResidency { ResourceResidency::Imported }
}

/// Deterministic all-zero initialization.
pub struct Zeroed {}

/// Exact immutable bytes addressed by their SHA-256 digest.
///
/// Digest words are written in display order (big-endian within each word), so
/// the eight constants concatenate to the ordinary 64-character SHA-256 hex
/// identity. The artifact byte length is independently derived from `N` and
/// `GpuLayout<StorageLayout, T>`.
pub struct ContentAddressed<
    const H0: u32,
    const H1: u32,
    const H2: u32,
    const H3: u32,
    const H4: u32,
    const H5: u32,
    const H6: u32,
    const H7: u32,
> {}

/// Contents are produced by an authored GPU pass rather than host bytes.
pub struct Derived {}

impl<Access, Residency, Recovery> ResourceInitializationPolicy<Access, Residency, Recovery>
    for Zeroed
{
    const fn initialization() -> ResourceInitialization {
        ResourceInitialization::Zeroed
    }
}

impl<
    const H0: u32,
    const H1: u32,
    const H2: u32,
    const H3: u32,
    const H4: u32,
    const H5: u32,
    const H6: u32,
    const H7: u32,
> ResourceInitializationPolicy<ReadOnly, Immutable, ReplayRecipe>
    for ContentAddressed<H0, H1, H2, H3, H4, H5, H6, H7>
{
    const fn initialization() -> ResourceInitialization {
        ResourceInitialization::ContentAddressed(ResourceDigest {
            words: [H0, H1, H2, H3, H4, H5, H6, H7],
        })
    }
}

impl<Access: GpuWritable, Residency, Recovery>
    ResourceInitializationPolicy<Access, Residency, Recovery> for Derived
{
    const fn initialization() -> ResourceInitialization {
        ResourceInitialization::Derived
    }
}

/// Recreate the physical resource by replaying its deterministic recipe.
pub struct ReplayRecipe {}

/// Restore the newest explicit actor checkpoint after device replacement.
pub struct RestoreCheckpoint {}

/// Ask an authored producer to regenerate contents after device replacement.
pub struct Regenerate {}

/// Device loss terminates this logical resource instead of manufacturing data.
pub struct NonRecoverable {}

impl ResourceRecoveryPolicy for ReplayRecipe {
    const fn recovery() -> ResourceRecovery { ResourceRecovery::ReplayRecipe }
}

impl ResourceRecoveryPolicy for RestoreCheckpoint {
    const fn recovery() -> ResourceRecovery { ResourceRecovery::RestoreCheckpoint }
}

impl ResourceRecoveryPolicy for Regenerate {
    const fn recovery() -> ResourceRecovery { ResourceRecovery::Regenerate }
}

impl ResourceRecoveryPolicy for NonRecoverable {
    const fn recovery() -> ResourceRecovery { ResourceRecovery::NonRecoverable }
}

pub struct ComputeOnly {}

pub struct VertexOnly {}

pub struct FragmentOnly {}

pub struct ComputeFragment {}

pub struct VertexFragment {}

pub struct AllShaderStages {}

impl ResourceVisibilityPolicy for ComputeOnly {
    const fn visibility() -> ResourceVisibility { ResourceVisibility::Compute }
}

impl ResourceVisibilityPolicy for VertexOnly {
    const fn visibility() -> ResourceVisibility { ResourceVisibility::Vertex }
}

impl ResourceVisibilityPolicy for FragmentOnly {
    const fn visibility() -> ResourceVisibility { ResourceVisibility::Fragment }
}

impl ResourceVisibilityPolicy for ComputeFragment {
    const fn visibility() -> ResourceVisibility { ResourceVisibility::ComputeFragment }
}

impl ResourceVisibilityPolicy for VertexFragment {
    const fn visibility() -> ResourceVisibility { ResourceVisibility::VertexFragment }
}

impl ResourceVisibilityPolicy for AllShaderStages {
    const fn visibility() -> ResourceVisibility { ResourceVisibility::All }
}

/// Element-rebinding evidence for a logical GPU resource family.
///
/// Unlike `Functor`, this trait has no executable `map`: a physical transform
/// is a typed compute pass plus queue effects, not a pure container operation.
pub trait GpuResourceFamily<X> {
    type Rebind<Y>
}

/// One actor-owned logical buffer and one stage-local binding capability.
///
/// The compiler validates the marker evidence and projects the physical recipe
/// into the bundle. The sole word is an inert lowering carrier, never an
/// application-visible WebGPU binding number.
#[gpu_resource(storage_family)]
pub struct GpuBuffer<
    Kind,
    Access,
    Residency,
    Init,
    Recovery,
    Visibility,
    const N: usize,
    T,
> {
    binding: u32,
}

impl<Kind, Access, Residency, Init, Recovery, Visibility, const N: usize, T>
    core::marker::Copy for
    GpuBuffer<Kind, Access, Residency, Init, Recovery, Visibility, N, T>
{}

impl<Kind, Access, Residency, Init, Recovery, Visibility, const N: usize, X>
    GpuResourceFamily<X> for
    GpuBuffer<Kind, Access, Residency, Init, Recovery, Visibility, N, X>
{
    type Rebind<Y> =
        GpuBuffer<Kind, Access, Residency, Init, Recovery, Visibility, N, Y>
}

impl<Kind, Access, Residency, Init, Recovery, Visibility, const N: usize, T>
    GpuResourcePolicy for
    GpuBuffer<Kind, Access, Residency, Init, Recovery, Visibility, N, T>
    where Kind: ResourceKindPolicy,
          Access: ResourceAccessPolicy,
          Residency: ResourceResidencyPolicy<Access>,
          Init: ResourceInitializationPolicy<Access, Residency, Recovery>,
          Recovery: ResourceRecoveryPolicy,
          Visibility: ResourceVisibilityPolicy
{
    const fn plan() -> ResourcePlan {
        ResourcePlan {
            kind: Kind::kind(),
            access: Access::access(),
            residency: Residency::residency(),
            initialization: Init::initialization(),
            recovery: Recovery::recovery(),
            visibility: Visibility::visibility(),
        }
    }
}

/// Evaluate the complete logical plan for one concrete resource family. The
/// compiler supplies `R`; application authors never add a redundant behavior.
pub const fn resource_plan<R: GpuResourcePolicy>() -> ResourcePlan {
    R::plan()
}

impl<Kind, Access, Residency, Init, Recovery, Visibility, const N: usize, T>
    GpuBuffer<Kind, Access, Residency, Init, Recovery, Visibility, N, T>
    where Access: GpuReadable
{
    #[gpu_intrinsic(storage_load)]
    pub fn load(self, index: u32) -> T {
        core::panic()
    }
}

impl<Kind, Access, Residency, Init, Recovery, Visibility, const N: usize, T>
    GpuBuffer<Kind, Access, Residency, Init, Recovery, Visibility, N, T>
    where Access: GpuWritable
{
    #[gpu_intrinsic(storage_store)]
    pub fn store(self, index: u32, value: T) {
        core::panic()
    }
}

/// Source-compatible mutable storage with deterministic zero initialization.
pub type StorageBuffer<T, const N: usize> = GpuBuffer<
    StorageKind,
    ReadWrite,
    ActorResident,
    Zeroed,
    ReplayRecipe,
    ComputeFragment,
    N,
    T,
>

/// Immutable storage initialized from one verified bundle artifact.
pub type ImmutableStorageBuffer<Init, const N: usize, T> = GpuBuffer<
    StorageKind,
    ReadOnly,
    Immutable,
    Init,
    ReplayRecipe,
    AllShaderStages,
    N,
    T,
>

/// Actor-resident storage with explicit access, initialization, recovery, and
/// stage visibility policies.
pub type DynamicStorageBuffer<
    Access,
    Init,
    Recovery,
    Visibility,
    const N: usize,
    T,
> = GpuBuffer<
    StorageKind,
    Access,
    ActorResident,
    Init,
    Recovery,
    Visibility,
    N,
    T,
>
