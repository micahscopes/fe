// std::webgpu::raw (mb2 R3.4a): the PRIVATE wasm-import surface for the browser
// WebGPU broker. User code never touches these; the `WorkerGpu` provider in the
// parent `std::webgpu` module is the only caller, and the std `readback` facade
// is the public entry. Each block names its wasm import module via the R3.3
// `#[wasm_import(module = "...")]` attribute, so the import table IS the op set
// (interop 4.1/4.2, normative). WebGPU EXECUTION is browser-only and never
// sandbox-verifiable; these declarations are the compiler-checked contract the
// broker mirrors op-for-op (the wasmtime fake-device run is R3.4b).
//
// Boundary discipline, FORCED by the wasm boundary: single-word transport only.
// Every handle, token, pointer, and length crosses as one `u32` word; results as
// `u32` or `u64`. No MULTI-word aggregate crosses by value. Per Amendment 4 (below)
// the typed Fe newtypes (`Pending<()>`, `KernelId`, and the class-typed `WebGpuRef`
// binding) now cross the boundary WHOLE: each is a single-`u32`-field newtype (the
// phantom `T` on `Pending<T>` adds no field), and
// the transport ABI unwraps it to its one word (i32 on wasm32) at the boundary, so
// the wire shape is byte-identical to passing the bare `u32` while the Fe types stay
// intact end-to-end. This is what lets the `WorkerGpu` provider bodies be pure
// pass-through: no `.binding` / `.id` field read, no re-wrap, no place/`Load`.
//
// Module `fe:worker` (`task_begin` / `task_result`) is DELIBERATELY absent: the
// worker task surface and its `Par<WasmBackend>` provider are a later slice.
//
// AMENDMENT 4 (R3.4b memory ruling, interop section 8; transport-newtype extension):
// the REGION-POINTER params speak `MemPtr<u32>` (the `WebGpuBackend` word) DIRECTLY,
// not a pre-narrowed `u32`, and the CAPABILITY NEWTYPES (`WebGpuRef<u32, Global>`,
// `KernelId`, `Pending<()>`) cross the boundary WHOLE on the same footing. The transport
// ABI lowers each across the extern boundary as its single word (i32 on wasm32) - for
// `MemPtr` exactly the linear-memory offset the JS broker already sees, for the
// newtypes exactly their one `u32` field - so every import's wire shape is unchanged.
// This DELETES the `mem_word_addr` / `raw() -> u256` / `downcast_truncate` u256 detour
// (an EVM-word leak into the wasm path) AND the provider-side `.binding` / `.id`
// unwrap/re-wrap, making the `WorkerGpu` bodies pure pass-through: authority meets the
// import table with no Fe-side address arithmetic and no field projection. Region
// handles are host-minted (the `main` entry receives its `MemPtr`s as parameters), so
// no `from_raw` and no u256 ever reach the executed wasm.

use core::MemPtr
use core::backend::Global
use super::{WebGpuRef, KernelId, Pending, WebGpuBackend}

/// Module `fe:webgpu` (broker-serviced): allocate, upload, launch, begin-readback.
#[wasm_import(module = "fe:webgpu")]
extern {
    /// Allocate a device storage buffer of `len_words` u32 words; return its
    /// client-assigned binding handle (interop 4.1: `device.createBuffer`).
    /// Amendment 4: the handle crosses WHOLE as `WebGpuRef<u32, Global>`, transported
    /// as its single `u32` binding word (i32).
    pub unsafe fn gpu_buffer_create(_ len_words: u32) -> WebGpuRef<u32, Global>

    /// Copy `len_words` words out of linear memory at `src` into the device buffer
    /// bound at `dst` (interop 4.1: `queue.writeBuffer`). Amendment 4: `src` is a
    /// `MemPtr<u32>` region pointer (wasm32 memory offset, i32) and `dst` is the
    /// `WebGpuRef<u32, Global>` handle (its single `u32` binding word, i32).
    pub unsafe fn gpu_upload(_ src: MemPtr<u32>, _ len_words: u32, _ dst: WebGpuRef<u32, Global>)

    /// Launch `kernel` over `groups` workgroups; bindings are derived from the
    /// kernel's class-typed signature (interop 4.1: encode + submit a compute pass).
    /// Amendment 4: `kernel` crosses WHOLE as `KernelId`, transported as its single
    /// `u32` id word (i32).
    pub unsafe fn gpu_dispatch(_ kernel: KernelId, _ groups: u32)

    /// Begin an asynchronous readback of `len_words` words from the buffer bound at
    /// `src` into linear memory at `dst`; return a fresh pending token (interop 4.1:
    /// copy-to-staging + submit + `mapAsync`, completion signalled via `fe:async`).
    /// Amendment 4: `src` is the `WebGpuRef<u32, Global>` handle, `dst` is the
    /// `MemPtr<u32>` region pointer, and the returned token crosses WHOLE as
    /// `Pending<()>` (its single `u32` id word, i32; the phantom payload adds no
    /// field). The readback payload is unit: the words land in `dst`, not the token.
    pub unsafe fn gpu_readback_begin(_ src: WebGpuRef<u32, Global>, _ len_words: u32, _ dst: MemPtr<u32>) -> Pending<WebGpuBackend, ()>
}

/// Module `fe:async`: the one genuinely-async data-path op's blocking completion.
#[wasm_import(module = "fe:async")]
extern {
    /// Block the calling agent until the pending operation `pending` is resident
    /// (interop 4.1: `Atomics.wait` on the token's status slot). In the degraded,
    /// no-isolation mode this import is not provided at all; completions arrive as
    /// the exported `on_ready(token)` continuation instead. Amendment 4: `pending`
    /// crosses WHOLE as `Pending<T>`, transported as its single `u32` id word (i32).
    /// The import BLOCKS until resident and DELIVERS the payload `T` (this is what
    /// lets the generic `Wait::wait<T>` provider body type-check abstractly: delivery
    /// returns `T`). For the readback token (`T = ()`) the payload is unit, so this
    /// monomorphizes to today's `wait(i32)` void import (wire-identical). CE-2 PROBE
    /// PENDING FABLE RATIFICATION: the ratified text keeps this extern "as today"
    /// (`wait(_ pending: Pending<()>)` void); that non-generic form CANNOT type-check
    /// the abstract `wait<T> -> T` provider body (delivery returns unit, not `T`), so
    /// this generic form is the measured resolution awaiting a seat ruling.
    pub unsafe fn wait<T>(_ pending: Pending<WebGpuBackend, T>) -> T
}

/// Module `fe:host` (unchanged from arch 4.2): logging and a monotonic clock.
#[wasm_import(module = "fe:host")]
extern {
    /// Log `len` utf8 bytes at linear-memory `ptr` (interop 4.1: `console.log`).
    pub unsafe fn host_log(_ ptr: u32, _ len: u32)

    /// Milliseconds since the epoch (interop 4.1: `BigInt(Date.now())`; the i64
    /// import surfaces as BigInt in JS, the trampoline owns the conversion).
    pub unsafe fn host_now_ms() -> u64
}
