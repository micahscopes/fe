//! The Conal parallel library (mb2 A9.1, the first minimal slice).
//!
//! This is a MINIMAL, real first slice of Conal Elliott's generic-parallelism
//! technique expressed over the multi-backend `core::backend::Backend`
//! abstraction. It provides exactly ONE typeclass and ONE generic algorithm:
//!
//!  - `Functor<X>`: a *-kinded, APPLIED-FORM, element-changing functor. `map`
//!    transforms `X -> Y`; the result container is named by the associated type
//!    `Out<Y>`. It is deliberately bound on the APPLIED container (`Buf<X>`), not
//!    on the `* -> *` constructor, because that is the shape the built substrate
//!    discharges: a bare GAT head stays opaque (A3), so a consumer bound
//!    `where B::Buffer<X>: Functor<X>` rides the A7.2 applied-subject route, and a
//!    method returning `Self::Out<Y>` projects through the impl by ordinary
//!    trait solving. (This is a distinct trait from the HKT `core::functional::
//!    Functor`, whose `Self: * -> *` constructor bound the built machinery does
//!    NOT resolve for an abstract backend; see the A9.1 BUILD_LOG entry.)
//!
//!  - `par_map`: the ONE generic algorithm, a default method dispatching through
//!    `map`. It is the design's trivially-parallel warm-up map kernel (zero
//!    phases). At the type level a parallel map IS a map; the parallelism is the
//!    `Par` provider's concern (B2), not the type's, so `par_map` forwards to
//!    `map` and the schedule shows up as the buffer's element type.
//!
//! "The type is the schedule": a caller instantiates the buffer's element at a
//! schedule shape (e.g. `RBin<Pair, N>`, a `recursive type fn`), so
//! `EvmBackend::Buffer<RBin<Pair, 3>>` normalizes to
//! `StorPtr<Comp<Comp<Comp<Par, Pair>, Pair>, Pair>>` and `par_map` runs over
//! that shape. As of mb2 A9.3 the schedule builder `RBin` is LIBRARY-RESIDENT
//! (surfaced from this module alongside the `Par`/`Pair`/`Comp` combinator
//! vocabulary it composes), the tree-sitter ingot grammar having learned the
//! `recursive type fn` surface; a caller need only `use std::conal::RBin`.
//!
//! Scope of this slice (minimal on purpose): ONE instance, for the EVM backend's
//! buffer container (`StorPtr<X>`). The `map` body is a type-level stub
//! (`todo()`); an EXECUTED instance on EVM (real load/apply/store over storage)
//! is the next A9 slice. Combinators-as-functors (the deeper Conal structure,
//! `Par`/`Comp` themselves `Functor`) and a structure-recursing `scan` (needs the
//! S2.3 goal-set induction, not built) are later slices too.

use core::Fn
use core::StorPtr
use core::EffectHandle
use core::effect_ref::{read, write}

/// Schedule combinator vocabulary. In this slice these are `*`-kinded shape
/// tokens: a schedule type such as `RBin<Pair, N>` normalizes to a nest of these,
/// and that nest is used as a buffer's element type ("the type is the schedule").
/// A later slice makes `Par`/`Comp` themselves `Functor` (the structure-carrying
/// Conal reading).
pub struct Par {}
pub struct Pair {}
pub struct Comp<A, B> {}

/// The canonical balanced-binary schedule builder (mb2 A9.3), now LIBRARY-RESIDENT
/// (moved out of the fixtures once the tree-sitter ingot grammar learned the
/// `recursive type fn` surface). Recursion is on the const depth `N` (the count of
/// `Comp` phase boundaries), threading the symbolic element `T` at each leaf:
///
///   RBin<T, 0> = Par
///   RBin<T, N> = Comp<RBin<T, N-1>, T>
///
/// so `RBin<Pair, 3>` normalizes to `Comp<Comp<Comp<Par, Pair>, Pair>, Pair>`.
/// "The type is the schedule": a caller instantiates a backend buffer's element at
/// `RBin<_, N>`, so `EvmBackend::Buffer<RBin<Pair, 3>>` normalizes to
/// `StorPtr<Comp<Comp<Comp<Par, Pair>, Pair>, Pair>>` and `par_map` runs over that
/// shape (the same depth `N` drives the B2 barrier derivation). This is the CLOSED
/// combinator set: `RBin` composes the `Par`/`Comp` vocabulary above, adding no new
/// combinator.
pub recursive type fn RBin<T, const N: usize>() -> (*) {
    match N {
        0 => Par
        _ => Comp<RBin<T, {N - 1}>, T>
    }
}

/// A `*`-kinded, applied-form, element-changing functor over a backend container.
///
/// `Self` is the APPLIED container (e.g. `B::Buffer<X>`), `X` its element type.
/// `map` transforms the element `X -> Y`, producing the container named by the
/// associated type `Out<Y>`. Discharged through the A7.2 applied-subject route:
/// a consumer with `B: Backend` in scope can carry `where B::Buffer<X>: Functor<X>`
/// and it resolves per concrete backend.
pub trait Functor<X> {
    /// The container that results from mapping the element to `Y`.
    type Out<Y>

    /// Map the callable `f: X -> Y` over the container.
    fn map<Y, F: Fn<X, Y>>(self, _ f: F) -> Self::Out<Y>

    /// The ONE generic parallel-map algorithm, written once and dispatching
    /// through `map`. Trivially parallel (the design's warm-up map kernel): at
    /// the type level a parallel map is a map, so this forwards to `map`; the
    /// actual parallel execution is the `Par` provider's concern (B2). The
    /// `Self::Out<Y>` return is nameable via the Self-projection.
    fn par_map<Y, F: Fn<X, Y>>(self, _ f: F) -> Self::Out<Y> {
        self.map<Y, F>(f)
    }
}

/// The EVM backend's buffer container is a `Functor`. `EvmBackend::Buffer<T>` is
/// `StorPtr<T>` (a persistent-storage handle, the representation-only stand-in of
/// the A5 slices), so this instance is what makes `EvmBackend::Buffer<X>:
/// Functor<X>` hold. `map` is a type-level stub in this slice; the executed
/// instance (real per-element load/apply/store over storage) is the next A9 slice.
impl<X> Functor<X> for StorPtr<X> {
    type Out<Y> = StorPtr<Y>

    fn map<Y, F: Fn<X, Y>>(self, _ f: F) -> StorPtr<Y> {
        todo()
    }
}

// -----------------------------------------------------------------------------
// mb2 A9.2: the EXECUTED element model (the library RUNS on EVM).
// -----------------------------------------------------------------------------
//
// `StorWordBuf` is a MINIMAL fixed-length word buffer over consecutive EVM
// storage slots (`base`, `base+1`, ..., `base+len-1`), and its `Functor<u256>`
// instance's `map` body is REAL: it loads each element (`sload` via the B1
// storage idiom, reached through `StorPtr`'s `Storage`-space effect lowering),
// applies `f`, and stores the result to the output buffer's slot (`sstore`). So
// `par_map` (the default, forwarding to `map`) EXECUTES element-wise over EVM
// storage. Proven by `crates/fe/tests/fixtures/fe_test/conal_par_map_exec.fe`
// under revm.
//
// WHY a distinct buffer type rather than replacing the `StorPtr<X>` instance's
// `todo()`: the generic `impl<X> Functor<X> for StorPtr<X>` above is the A9.1
// TYPE-LEVEL keystone (`EvmBackend::Buffer<T> = StorPtr<T>`, mapped over schedule
// shapes like `Comp<..>` that carry no runtime value). Its `map` cannot execute
// while staying generic over `X`: a real load returns a `u256` word, which only
// type-checks when the element is a word, and Fe coherence forbids a specialized
// overlapping `impl Functor<u256> for StorPtr<X>`. So the executed proof lives on
// a concrete word buffer, coherent alongside the generic type-level instance,
// leaving the A9.1 keystone byte-identical. Element = `u256`; the mapped result
// type `Y` is stored via the layout-generic `write` (no `Copy` needed on `Y`),
// so the instance is a faithful `Functor<u256>` for any result `Y`, executed at
// `Y = u256`.

/// A minimal fixed-length buffer of `u256` words over consecutive EVM storage
/// slots. Element `i` lives at storage slot `base + i`. This is the A9.2
/// EXECUTED element model for the Conal library (a small fixed-length buffer is
/// the minimal shape; the full bulk-storage/iteration library is a later slice).
pub struct StorWordBuf {
    base: u256,
    len: u256,
}

impl Copy for StorWordBuf {}

impl StorWordBuf {
    /// A buffer of `len` words based at storage slot `base`.
    pub fn new(base: u256, len: u256) -> Self {
        Self { base, len }
    }

    /// First storage slot of the buffer's region.
    pub fn base(self) -> u256 {
        self.base
    }

    /// Number of word elements.
    pub fn len(self) -> u256 {
        self.len
    }

    /// Load the word at index `i` (an `sload` of slot `base + i`).
    pub fn get(self, _ i: u256) -> u256 {
        let p: StorPtr<u256> = StorPtr::from_raw(self.base + i)
        with (p) { read(p) }
    }

    /// Store `value` at index `i` (an `sstore` to slot `base + i`).
    pub fn set(self, _ i: u256, _ value: u256) {
        let p: StorPtr<u256> = StorPtr::from_raw(self.base + i)
        with (p) { write(p, value) }
    }
}

/// The EXECUTED Conal instance: `par_map` runs element-wise over EVM storage.
///
/// `map` loads each of the `len` input words, applies `f: u256 -> Y`, and stores
/// each result to the output buffer (placed contiguously after the input at
/// `base + len`). The result type `Y` is stored through the layout-generic
/// `write`, so this is a real `Functor<u256>` for any `Y`; it EXECUTES on EVM at
/// `Y = u256` (see the A9.2 fe test). `par_map` is the inherited default
/// forwarding to `map` (parallelism is structural; EVM is single-threaded).
impl Functor<u256> for StorWordBuf {
    type Out<Y> = StorWordBuf

    fn map<Y, F: Fn<u256, Y>>(self, _ f: F) -> StorWordBuf {
        let out = StorWordBuf { base: self.base + self.len, len: self.len }
        let mut i: u256 = 0
        while i < self.len {
            let src: StorPtr<u256> = StorPtr::from_raw(self.base + i)
            let x: u256 = with (src) { read(src) }
            let y: Y = f.call(x)
            let dst: StorPtr<Y> = StorPtr::from_raw(out.base + i)
            with (dst) { write(dst, y) }
            i += 1
        }
        out
    }
}
