use core::backend::{Backend, Supports, Global, Constant, Shared, Local}
use core::atomic::Atomic
use core::barrier::Barrier

/// A TYPE-LEVEL GPU backend.
///
/// This is NOT a code-generation backend: NO GPU pipeline exists on this branch.
/// SPIR-V generation is seam-GO-gated (Sonatina seam port, owner-ratified,
/// outside this branch's autonomy); GPU EXECUTION is never sandbox-testable (no
/// GPU here). `GpuBackend` exists purely as the positive `Supports<Shared>`
/// witness so the storage-class discipline is non-degenerate in BOTH directions:
/// with zero `Supports<Shared>` impls in-tree, the negative test could not
/// distinguish "these backends lack the class" from "the discharge machinery
/// cannot prove `Supports<Shared>` at all". Mirrors `wasm.fe`'s posture exactly.
///
/// Its facts genuinely differ from both existing backends (32-bit words, wrapping
/// arithmetic, a 24-log2 parallel envelope), so the anti-conflation matrix stays
/// three-way non-degenerate.
pub struct GpuBackend {}

/// GPU class-typed reference: a uniform `u32` opaque handle. `T` and `S` are
/// phantom (representation-only stand-in, like the other backends' refs); the
/// class marker `S` lives in the TYPE and, in the B-track, keys the SPIR-V
/// storage-class decoration on the lowered pointer. NO methods/ops in this slice.
pub struct GpuRef<T, S> { handle: u32 }

impl Backend for GpuBackend {
    const WORD_BITS: usize = 32
    // WGSL defines wrapping arithmetic; SPIR-V has no overflow detection (this
    // "wraps in practice, no trap exists" is a doc caveat, not a guarantee).
    const OVERFLOW_WRAPS: bool = true
    const MAX_PAR_LOG2: usize = 24
    type Word = u32
    // Impl-side representation choice: a GPU buffer honestly IS a global-class
    // device allocation, so the backend picks `GpuRef<T, Global>` as its buffer.
    // This is per-impl representation, not trait doctrine, and it exercises marker
    // substitution through a GAT RHS.
    type Buffer<T> = GpuRef<T, Global>
    type Ref<T, S> = GpuRef<T, S>
}

// Storage-class grant matrix for GPU (see `core::backend`): all four classes.
// `Shared` (SPIR-V `Workgroup`) is the class no other backend supports; this is
// the positive witness that keeps the discipline non-degenerate.
impl Supports<Global> for GpuBackend {}
impl Supports<Constant> for GpuBackend {}
impl Supports<Shared> for GpuBackend {}
impl Supports<Local> for GpuBackend {}

// ---------------------------------------------------------------------------
// mb2 B1: the GPU atomic capability (DECLARATION-LEVEL only).
// ---------------------------------------------------------------------------
//
// The grant matrix wants a `Shared` atomic witness (SPIR-V defines atomics on
// both `StorageBuffer`/`Global` and `Workgroup`/`Shared`), and only the GPU
// backend supports `Shared`. `GpuAtomics` carries `Atomic<GpuBackend, Global>`
// and `Atomic<GpuBackend, Shared>` so the {Global, Shared} grant set is
// non-degenerate (Shared has a provider that exists SOMEWHERE), while
// `Constant`/`Local` still have none anywhere.
//
// These are TYPE-LEVEL stubs: no GPU pipeline exists on this branch, so the
// bodies are never lowered (SPIR-V atomics lowering is B5, seam-GO-gated; GPU
// execution is B6, environment-blocked). The bodies call `core::panic()`
// (never-typed), exactly the `WasmHost` `ContractHost` stub posture. `GpuBackend`
// supports both classes, so the `where GpuBackend: Supports<S>` op bound holds.
pub struct GpuAtomics {}

// As with the EVM impl, the trait method's `where B: Supports<S>` instantiates
// to a CONCRETE `GpuBackend: Supports<{Global,Shared}>` (both hold by the grant
// matrix above) and is not restated here (Fe rejects concrete-type where-bounds,
// `6-0005`); it discharges automatically.
impl Atomic<GpuBackend, Global> for GpuAtomics {
    fn add(mut self, _ r: GpuRef<u32, Global>, _ v: u32) -> u32 {
        core::panic()
    }
    fn exchange(mut self, _ r: GpuRef<u32, Global>, _ v: u32) -> u32 {
        core::panic()
    }
    fn cas(mut self, _ r: GpuRef<u32, Global>, old: u32, new: u32) -> u32 {
        core::panic()
    }
}

impl Atomic<GpuBackend, Shared> for GpuAtomics {
    fn add(mut self, _ r: GpuRef<u32, Shared>, _ v: u32) -> u32 {
        core::panic()
    }
    fn exchange(mut self, _ r: GpuRef<u32, Shared>, _ v: u32) -> u32 {
        core::panic()
    }
    fn cas(mut self, _ r: GpuRef<u32, Shared>, old: u32, new: u32) -> u32 {
        core::panic()
    }
}

// ---------------------------------------------------------------------------
// mb2 B2: the GPU barrier capability (DECLARATION-LEVEL only).
// ---------------------------------------------------------------------------
//
// Barriers, like atomics, live over `Global` (SPIR-V `StorageBuffer`) and `Shared`
// (SPIR-V `Workgroup`), and only the GPU backend supports `Shared`. `GpuBarriers`
// carries `Barrier<GpuBackend, Global>` and `Barrier<GpuBackend, Shared>` so the
// {Global, Shared} barrier grant set is non-degenerate (the `Shared` barrier has a
// provider that exists SOMEWHERE), while `Constant`/`Local` still have none.
//
// TYPE-LEVEL stubs: no GPU pipeline exists on this branch, so the bodies are never
// lowered here. On GPU a `Shared` barrier lowers to `OpControlBarrier` at a
// provider-inserted fork-join (B5, seam-GO-gated); GPU execution is B6
// (environment-blocked). The bodies are no-ops (barrier returns nothing), the same
// posture as the EVM impl; on GPU they become the real `OpControlBarrier` in B5.
// `GpuBackend` supports both classes, so the `where GpuBackend: Supports<S>` op
// bound holds and is not restated here (`6-0005`).
pub struct GpuBarriers {}

impl Barrier<GpuBackend, Global> for GpuBarriers {
    fn barrier(mut self) {}
}

impl Barrier<GpuBackend, Shared> for GpuBarriers {
    fn barrier(mut self) {}
}
