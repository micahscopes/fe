use core::backend::{Backend, Supports, Global, Constant, Local}
use core::MemPtr
use core::contracts::{AbiTarget, Target}
use super::abi::Sol

/// A TYPE-LEVEL wasm backend.
///
/// This is NOT a code-generation backend: no wasm pipeline exists on this branch
/// (wasm EXECUTION is blocked on the Sonatina seam port, not on anything here).
/// `WasmBackend` exists purely so the `Backend` abstraction is non-degenerate
/// from day one: its facts genuinely differ from `EvmBackend` (64-bit words,
/// trapping arithmetic, a linear-memory `Buffer`), so anti-conflation
/// (`EvmBackend::Buffer<T>` vs `WasmBackend::Buffer<T>`) is observable.
///
/// It lives at the `std` root rather than under `evm/` precisely because it is
/// not the EVM target. `Buffer<T>` is a representation-only stand-in
/// (`MemPtr<T>`, a linear-memory handle from `core`).
pub struct WasmBackend {}

/// wasm class-typed reference: a uniform `u32` linear-memory offset. `T` and `S`
/// are phantom (representation-only stand-in, like `WasmBackend::Buffer`): the
/// class marker `S` lives in the TYPE. NO methods/ops in this slice.
pub struct WasmRef<T, S> { addr: u32 }

impl Backend for WasmBackend {
    const WORD_BITS: usize = 64
    const OVERFLOW_WRAPS: bool = false
    const MAX_PAR_LOG2: usize = 20
    type Word = u64
    type Buffer<T> = MemPtr<T>
    type Ref<T, S> = WasmRef<T, S>
}

// Storage-class grant matrix for wasm (see `core::backend`). Mirrors EVM's honest
// degradation: `Global` (linear-memory heap), `Constant` (data segment /
// immutable region), `Local` (shadow stack / locals). `Shared` is ABSENT in v1:
// no workgroup concept exists yet. The wasm-threads + shared-memory proposal plus
// a `WasmWorkers` `Par` provider could later make `Supports<Shared> for
// WasmBackend` true; adding it is one additive line.
impl Supports<Global> for WasmBackend {}
impl Supports<Constant> for WasmBackend {}
impl Supports<Local> for WasmBackend {}

// ---------------------------------------------------------------------------
// A6 root-mint: the wasm capability root (`impl Target for WasmTarget`).
// ---------------------------------------------------------------------------
//
// This is the second per-target capability root alongside `std::evm::EvmTarget`,
// making the single hardcoded default target selectable (A6 root-mint
// generalization). It is a TYPE-LEVEL stub: no wasm code-generation pipeline
// exists on this branch (wasm EXECUTION is blocked on the Sonatina seam port).
// The type-level surface is what matters: selecting this target seeds `WasmHost`
// as the program root, and `WasmHost` deliberately does NOT implement
// `core::contracts::StorageIntrinsic`, so an EVM-storage intrinsic used under the
// wasm target is rejected (`8-0036`), the honest cross-target negative.
//
// `WasmHost` carries NO entry interface here. A wasm SMART-CONTRACT shape
// (CosmWasm / Stylus / Soroban) genuinely is a `ContractHost`, and the impl that
// says so belongs with the wasm contract entry generator that needs it, not with
// the target: `Target::RootEffect` is unbounded, so an entry interface is
// demanded by the entries placed on the root, never by the trait definition.
// What used to stand here was six never-typed panicking stubs written only to
// satisfy that bound, plus the note apologizing for them.
//
// The message codec is a separate face (`AbiTarget` below), because a
// wasm CHAIN shape does have a byte-stream codec even though the target as such
// carries no host interface.
pub struct WasmTarget {}

struct WasmPrivate {}

/// The wasm target's root effect. Seeded at the program root when the wasm
/// target is selected; carries neither an entry interface nor
/// `StorageIntrinsic`.
pub struct WasmHost { seal: WasmPrivate }

/// The wasm target's intrinsic-capability carrier (`<WasmTarget as Target>::Intrinsics`).
/// Names the per-target intrinsic capability family (design #93); the wasm
/// intrinsic families are added by later B-track slices.
pub struct WasmIntrinsics { seal: WasmPrivate }

impl Target for WasmTarget {
    type RootEffect = WasmHost
    type Intrinsics = WasmIntrinsics
}

impl AbiTarget for WasmTarget {
    type DefaultAbi = Sol
}

// DELIBERATELY NO `impl StorageIntrinsic for WasmHost`: the wasm target's root
// effect lacks the EVM-storage intrinsic capability, so `sload`/`sstore`-shaped
// obligations (`uses (_t: StorageIntrinsic)`) raised in a wasm-targeted unit are
// left `Missing` and reported as `8-0036`. This is the cross-target gate.
