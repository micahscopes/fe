use core::abi::AbiSize
use core::meta::{Code, Expr, Field, Item, Record, field, field_count, field_type}

/// One step of a fold over the fields of a record, written as code.
///
/// A deriver builds the code for a whole record by folding its fields in
/// declaration order, so the result follows the record's shape. `unit` is the
/// code for a record with no fields. `step` extends the code built from the
/// earlier fields by one more field. `fold_fields` runs the fold.
pub trait FieldStep {
    const fn unit() -> Code<Expr>
    const fn step(_ acc: Code<Expr>, _ field: Field) -> Code<Expr>
}

/// Fold the fields of `record` with the step `S`, in declaration order:
/// `step(.. step(step(unit, f0), f1) .., fn)`. Takes a struct, or an enum
/// payload chosen with `variant`. The result is code for the caller to splice
/// into the item it generates.
pub const fn fold_fields<S: FieldStep>(_ record: Record) -> Code<Expr> {
    var acc = S::unit()
    var i: usize = 0
    while i < field_count(record) {
        acc = S::step(acc, field(record, i))
        i += 1
    }
    acc
}

/// Whether the ABI encoding of `T` has a dynamic part.
pub const fn abi_is_dynamic<T: AbiSize>() -> bool {
    <T as AbiSize>::IS_DYNAMIC
}

/// Sum of the fields' head sizes: the head size of an ABI record. A dynamic
/// field counts as the one word that points to its tail.
pub struct AbiHeadSize {}
impl FieldStep for AbiHeadSize {
    const fn unit() -> Code<Expr> {
        quote { 0 }
    }
    const fn step(_ acc: Code<Expr>, _ field: Field) -> Code<Expr> {
        let ty = field_type(field)
        quote { ${acc} + core::abi::abi_field_head_size<${ty}>() }
    }
}

/// Whether any field is dynamic: whether the ABI record is dynamic.
pub struct AbiIsDynamic {}
impl FieldStep for AbiIsDynamic {
    const fn unit() -> Code<Expr> {
        quote { false }
    }
    const fn step(_ acc: Code<Expr>, _ field: Field) -> Code<Expr> {
        let ty = field_type(field)
        quote { ${acc} || ingot::derive::abi_is_dynamic<${ty}>() }
    }
}

/// Sum of the fields' dynamic tail payload sizes on `self`.
pub struct AbiPayloadSize {}
impl FieldStep for AbiPayloadSize {
    const fn unit() -> Code<Expr> {
        quote { 0 }
    }
    const fn step(_ acc: Code<Expr>, _ field: Field) -> Code<Expr> {
        let ty = field_type(field)
        quote { ${acc} + core::abi::dynamic_payload_size<${ty}>(self.${field}) }
    }
}

/// Generate ABI layout metadata and exact payload sizing for a record.
/// Field prerequisites are checked on the complete generated implementation.
pub const fn abi_size(_ record: Record) -> Code<Item> {
    let head = fold_fields<AbiHeadSize>(record)
    let dynamic = fold_fields<AbiIsDynamic>(record)
    let payload = fold_fields<AbiPayloadSize>(record)
    quote {
        impl core::abi::AbiSize for ${record} {
            const HEAD_SIZE: u256 = ${head}
            const IS_DYNAMIC: bool = ${dynamic}

            fn payload_size(self) -> u256 {
                <Self as core::abi::AbiSize>::HEAD_SIZE + ${payload}
            }
        }
    }
}

/// Encode fields in declaration order, advancing the head and tail positions.
pub struct AbiEncodeStep {}
impl FieldStep for AbiEncodeStep {
    const fn unit() -> Code<Expr> {
        quote { () }
    }
    const fn step(_ acc: Code<Expr>, _ field: Field) -> Code<Expr> {
        let ty = field_type(field)
        quote(out, head_pos, tails) {
            {
                ${acc}
                tails = core::abi::encode_field<ingot::abi::Sol, ${ty}>(
                    self.${field}, out, head_pos: head_pos, tails: tails,
                )
                head_pos += core::abi::abi_field_head_size<${ty}>()
            }
        }
    }
}

/// Generate Solidity ABI encoding using the record's shared layout metadata.
pub const fn abi_encode(_ record: Record) -> Code<Item> {
    let steps = fold_fields<AbiEncodeStep>(record)
    quote(out, head_pos, tails) {
        impl core::abi::Encode<ingot::abi::Sol> for ${record} {
            fn encode(own self, _ out: core::abi::AbiFrame) {
                var tails = out.tail(<Self as core::abi::AbiSize>::HEAD_SIZE)
                var head_pos: u256 = 0
                let _ = tails
                let _ = head_pos
                ${steps}
            }
        }
    }
}

/// Solidity tuple signature of the record's fields, for selector hashing.
pub const fn sol_tuple_type(_ record: Record) -> Code<Expr> {
    let n = field_count(record)
    if n == 0 {
        return quote { "()" }
    }
    let ty0 = field_type(field(record, 0))
    var acc: Code<Expr> = quote { ("(", <${ty0} as ingot::abi::SolCompat>::SOL_TYPE) }
    var i: usize = 1
    while i < n {
        let ty = field_type(field(record, i))
        acc = quote { (${acc}, ",", <${ty} as ingot::abi::SolCompat>::SOL_TYPE) }
        i += 1
    }
    quote { (${acc}, ")") }
}

/// Generate the ordinary error selector implementation for a record.
pub const fn error_variant(_ record: Record) -> Code<Item> {
    let tuple_ty = sol_tuple_type(record)
    quote {
        impl core::error::ErrorVariant<ingot::abi::Sol> for ${record} {
            const SELECTOR: u32 = ingot::abi::sol((${record}, ${tuple_ty}))
        }
    }
}

/// Generate an error's selector, layout and encoding implementations together.
pub const fn error_struct(_ record: Record) -> Code<Item> {
    let variant = error_variant(record)
    let size = abi_size(record)
    let encode = abi_encode(record)
    quote {
        ${variant}
        ${size}
        ${encode}
    }
}
