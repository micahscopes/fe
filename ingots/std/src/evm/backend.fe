use core::backend::{Backend, Supports, Global, Constant, Local}
use core::StorPtr

/// The EVM code-generation backend, the one backend with a real in-tree pipeline
/// behind it.
///
/// Co-located with the EVM target carriers (`EvmTarget`/`EvmIntrinsics`): its
/// facts are EVM-specific (256-bit words, wrapping arithmetic). `Buffer<T>` is a
/// representation-only stand-in here (`StorPtr<T>`, a persistent-storage handle
/// from `core`); the real bulk-storage type arrives with the codegen slices.
pub struct EvmBackend {}

/// EVM class-typed reference: a uniform `u256` slot/offset handle. `T` and `S`
/// are phantom (representation-only stand-in, exactly the `Buffer` posture): the
/// class marker `S` lives in the TYPE, not the value. NO methods, NO read/write,
/// NO `EffectHandle` impl in this slice; operations arrive effect-gated in the
/// B-track.
pub struct EvmRef<T, S> { raw: u256 }

impl<T, S> Copy for EvmRef<T, S> {}

impl<T, S> EvmRef<T, S> {
    /// Construct an EVM class-typed reference from a raw `u256` slot/offset
    /// handle. The B1 atomics slice is the first consumer: a contract forms a
    /// `Global`-class ref at a storage slot (`EvmRef::from_raw(slot)`) and hands
    /// it to the `Atomic` capability's read-modify-write ops.
    pub fn from_raw(_ raw: u256) -> Self {
        Self { raw }
    }

    /// The raw `u256` slot/offset handle this reference names.
    pub fn raw(self) -> u256 {
        self.raw
    }
}

impl Backend for EvmBackend {
    const WORD_BITS: usize = 256
    const OVERFLOW_WRAPS: bool = true
    const MAX_PAR_LOG2: usize = 14
    type Word = u256
    type Buffer<T> = StorPtr<T>
    type Ref<T, S> = EvmRef<T, S>
}

// Storage-class grant matrix for EVM (see `core::backend`). EVM degrades
// HONESTLY: it supports the three classes it genuinely has -- `Global` (persistent
// storage, SLOAD/SSTORE), `Constant` (calldata/code, read-only), `Local`
// (transient memory) -- and denies `Shared` (no workgroup concept exists on EVM).
impl Supports<Global> for EvmBackend {}
impl Supports<Constant> for EvmBackend {}
impl Supports<Local> for EvmBackend {}
