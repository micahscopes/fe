//! Browser handler selection for one structured child scope.
//!
//! The fixed host realizes only Worker lifecycle mechanics. The parent module's
//! target-neutral Fe loop owns policy, epochs, timers, and terminal meaning.

use core::actor::{ActorMailbox, Handles}
use core::pending::{Pending, PendingCancellation, Select, Suspend, Timer}
use ingot::wasm::WasmBackend
use super::{
    ChildPlacement,
    ChildRuntimeFailure,
    ChildScopeExit,
    ChildStarted,
    RestartWindow,
    supervise_child,
}
use super::super::host::{HostTimer, Resumable}
use super::raw::{
    ask_begin as raw_ask_begin,
    close as raw_close,
    failure_begin as raw_failure_begin,
    spawn_begin as raw_spawn_begin,
}

/// Browser interpretation of one nominal structured child's typed mailbox.
///
/// `C` never becomes a host-authored child identifier. It stays in the
/// monomorphized Fe operation so the compiler can select exactly one authored
/// child behavior from the request and response types.
pub struct BrowserActorMailbox<C> {}

impl<C> ActorMailbox<WasmBackend, C> for BrowserActorMailbox<C> {
    fn ask<M, R>(mut self, _ message: own M) -> Pending<WasmBackend, R>
        where C: Handles<M, R>
    {
        raw_ask_begin<C, M, R>(message)
    }
}

pub struct BrowserChildPlacement<C> {}

impl<C> ChildPlacement<WasmBackend, C> for BrowserChildPlacement<C> {
    fn spawn_begin(mut self, _ epoch: u32) -> Pending<WasmBackend, ChildStarted<C>> {
        raw_spawn_begin(epoch)
    }

    fn failure_begin(
        mut self,
        _ epoch: u32,
    ) -> Pending<WasmBackend, ChildRuntimeFailure<C>> {
        raw_failure_begin(epoch)
    }

    fn close(mut self, _ epoch: u32) {
        raw_close<C>(epoch)
    }
}

/// Select the standard browser handlers while retaining the complete policy in
/// the target-neutral Fe loop.
pub fn supervise_browser_child<C>(
    child: C,
    max_restarts: u32,
    window_ms: u64,
    backoff_ms: u64,
    startup_timeout_ms: u64,
) -> ChildScopeExit {
    with (
        ChildPlacement<WasmBackend, C> = BrowserChildPlacement<C> {},
        Timer<WasmBackend> = HostTimer {},
        Select<WasmBackend, u32> = Resumable {},
        PendingCancellation<WasmBackend> = Resumable {},
        Suspend<WasmBackend, u32> = Resumable {},
    ) {
        supervise_child(
            child: child,
            policy: RestartWindow::bounded(
                max_restarts: max_restarts,
                window_ms: window_ms,
                backoff_ms: backoff_ms,
                startup_timeout_ms: startup_timeout_ms,
            ),
        )
    }
}
