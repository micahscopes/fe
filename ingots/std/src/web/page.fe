//! Typed, const-projectable page composition.
//!
//! A page actor returns `Page<N>` from a behavior using `PageComposition`.
//! Build tooling evaluates that behavior and realizes this closed operation
//! vocabulary through an HTML5 parser before discovering render/component
//! programs. Application structure and artifact choices therefore live in Fe;
//! HTML syntax, escaping, and standards validation remain fixed host concerns.

pub use core::actor::PageComposition
pub use core::actor::ComponentComposition
use core::marker::Copy
use super::identity::{
    ComponentAction, ComponentClassToken, ComponentNode, ComponentTemplate, ComponentVisibility,
}

/// CTFE-only page text assembled from ordinary inline Fe string words. This
/// keeps authored code within Fe's current 31-byte runtime string limit while
/// allowing build-time page labels and URLs to span several readable pieces.
pub struct PageText {
    first: String<31>,
    second: String<31>,
    third: String<31>,
    length: u32,
}

impl Copy for PageText {}

impl PageText {
    pub const fn one(value: String<31>) -> Self {
        Self { first: value, second: "", third: "", length: 1 }
    }

    pub const fn two(first: String<31>, second: String<31>) -> Self {
        Self { first: first, second: second, third: "", length: 2 }
    }

    pub const fn three(first: String<31>, second: String<31>, third: String<31>) -> Self {
        Self { first: first, second: second, third: third, length: 3 }
    }

    const fn empty() -> Self {
        Self { first: "", second: "", third: "", length: 0 }
    }
}

/// Standards-derived element vocabulary admitted by the first page slice.
/// It is intentionally small and append-only; adding a normal element does not
/// add application knowledge to the host.
pub enum PageElement {
    Header,
    Main,
    Div,
    Figure,
    Figcaption,
    Span,
    Bold,
    Paragraph,
    Code,
    Section,
    Footer,
    Heading1,
    Heading2,
    Input,
    Label,
    UnorderedList,
    ListItem,
    Button,
    Template,
    Strong,
    Pre,
    Anchor,
    FeComponent,
}

impl Copy for PageElement {}

/// Standard attributes plus the fixed Fe host's declarative identities.
pub enum PageAttributeKind {
    Id,
    LocalId,
    Class,
    Role,
    AriaLabel,
    AriaModal,
    InputType,
    For,
    LocalFor,
    Title,
    Placeholder,
    Autocomplete,
    Target,
    Rel,
    Href,
    Hidden,
    Action,
    Node,
    View,
    Template,
    ClassToken,
    Publish,
}

impl Copy for PageAttributeKind {}

/// One typed attribute operation. Fields are private so constructors establish
/// which payload lane is meaningful for each kind.
pub struct PageAttribute {
    kind: PageAttributeKind,
    text: PageText,
    number: u32,
    enabled: bool,
}

impl Copy for PageAttribute {}

impl PageAttribute {
    const fn text_attr(kind: PageAttributeKind, text: PageText) -> Self {
        Self { kind: kind, text: text, number: 0, enabled: false }
    }

    const fn number_attr(kind: PageAttributeKind, number: u32) -> Self {
        Self { kind: kind, text: PageText::empty(), number: number, enabled: false }
    }

    pub const fn id(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::Id, text: PageText::one(value: value)) }
    pub const fn local_id(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::LocalId, text: PageText::one(value: value)) }
    pub const fn class(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::Class, text: PageText::one(value: value)) }
    pub const fn role(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::Role, text: PageText::one(value: value)) }
    pub const fn aria_label(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::AriaLabel, text: PageText::one(value: value)) }
    pub const fn input_type(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::InputType, text: PageText::one(value: value)) }
    pub const fn for_id(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::For, text: PageText::one(value: value)) }
    pub const fn local_for(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::LocalFor, text: PageText::one(value: value)) }
    pub const fn title(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::Title, text: PageText::one(value: value)) }
    pub const fn placeholder(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::Placeholder, text: PageText::one(value: value)) }
    pub const fn autocomplete(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::Autocomplete, text: PageText::one(value: value)) }
    pub const fn target(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::Target, text: PageText::one(value: value)) }
    pub const fn rel(value: String<31>) -> Self { Self::text_attr(kind: PageAttributeKind::Rel, text: PageText::one(value: value)) }
    pub const fn href(value: PageText) -> Self { Self::text_attr(kind: PageAttributeKind::Href, text: value) }
    pub const fn aria_modal() -> Self {
        Self { kind: PageAttributeKind::AriaModal, text: PageText::empty(), number: 0, enabled: true }
    }
    pub const fn hidden() -> Self {
        Self { kind: PageAttributeKind::Hidden, text: PageText::empty(), number: 0, enabled: true }
    }
    pub const fn action<A: ComponentAction>(value: A) -> Self {
        Self::number_attr(kind: PageAttributeKind::Action, number: value.component_action_id())
    }
    pub const fn node<N: ComponentNode>(value: N) -> Self {
        Self::number_attr(kind: PageAttributeKind::Node, number: value.component_node_id())
    }
    pub const fn view<V: ComponentVisibility>(value: V) -> Self {
        Self::number_attr(kind: PageAttributeKind::View, number: value.component_visibility_id())
    }
    pub const fn template<T: ComponentTemplate>(value: T) -> Self {
        Self::number_attr(kind: PageAttributeKind::Template, number: value.component_template_id())
    }
    pub const fn class_token<C: ComponentClassToken>(slot: C, value: String<31>) -> Self {
        Self {
            kind: PageAttributeKind::ClassToken,
            text: PageText::one(value),
            number: slot.component_class_token_id(),
            enabled: false,
        }
    }
    pub const fn publish() -> Self {
        Self { kind: PageAttributeKind::Publish, text: PageText::empty(), number: 0, enabled: true }
    }
}

/// One render program chosen by the Fe page. Empty `entry` requests the
/// render actor's derived entry point.
pub struct PageRender {
    source: PageText,
    entry: String<31>,
    wgsl_action: u32,
    wasm_action: u32,
    manifest_action: u32,
}

impl Copy for PageRender {}

/// One resident component program chosen by the Fe page.
pub struct PageComponent {
    source: PageText,
    mount: String<31>,
}

impl Copy for PageComponent {}

/// A balanced stream of typed page operations. Attributes apply to the most
/// recently opened element and must precede its content. `Render` and
/// `Component` are semantic leaf operations so artifact discovery never has
/// to reverse-engineer application intent from arbitrary markup.
pub enum PageOp {
    Open(PageElement),
    Attribute(PageAttribute),
    Text(PageText),
    Close,
    Render(PageRender),
    Component(PageComponent),
}

impl Copy for PageOp {}

impl PageOp {
    pub const fn open(element: PageElement) -> Self { Self::Open(element) }
    pub const fn attribute(value: PageAttribute) -> Self { Self::Attribute(value) }
    pub const fn text(value: PageText) -> Self { Self::Text(value) }
    pub const fn close() -> Self { Self::Close }

    pub const fn render<A: ComponentAction>(
        source: PageText,
        wgsl_action: A,
        wasm_action: A,
        manifest_action: A,
    ) -> Self {
        Self::Render(PageRender {
            source: source,
            entry: "",
            wgsl_action: wgsl_action.component_action_id(),
            wasm_action: wasm_action.component_action_id(),
            manifest_action: manifest_action.component_action_id(),
        })
    }

    pub const fn render_entry<A: ComponentAction>(
        source: PageText,
        entry: String<31>,
        wgsl_action: A,
        wasm_action: A,
        manifest_action: A,
    ) -> Self {
        Self::Render(PageRender {
            source: source,
            entry: entry,
            wgsl_action: wgsl_action.component_action_id(),
            wasm_action: wasm_action.component_action_id(),
            manifest_action: manifest_action.component_action_id(),
        })
    }

    pub const fn component(source: PageText, mount: String<31>) -> Self {
        Self::Component(PageComponent { source: source, mount: mount })
    }
}

/// A complete static page projection. The theme is selected by ordinary HTML
/// shell/CSS for now; `title` and every body operation are Fe-authored.
pub struct Page<const N: usize> {
    pub title: PageText,
    pub length: usize,
    pub body: [PageOp; N],
}

/// A resident component's initial light-DOM fragment. Unlike `Page`, a
/// component fragment has no document title and is projected into the mount
/// selected by the ordinary component declaration.
pub struct ComponentView<const N: usize> {
    pub length: usize,
    pub body: [PageOp; N],
}

impl<const N: usize> ComponentView<N> {
    pub const fn exact(body: [PageOp; N]) -> Self {
        Self { length: N, body: body }
    }
}

impl<const N: usize> Page<N> {
    pub const fn exact(title: PageText, body: [PageOp; N]) -> Self {
        Self { title: title, length: N, body: body }
    }
}

/// Fe-side fluent construction with a statically bounded operation buffer.
/// The compiler projects only `length` entries; unused capacity never reaches
/// HTML or a runtime artifact.
pub struct PageBuilder<const N: usize> {
    body: [PageOp; N],
    length: usize,
}

impl<const N: usize> PageBuilder<N> {
    pub const fn new() -> Self {
        Self { body: [PageOp::Close; N], length: 0 }
    }

    pub const fn push(self, operation: PageOp) -> Self {
        let mut body = self.body
        // The checked array write is the const-valid capacity assertion.
        body[self.length] = operation
        Self { body: body, length: self.length + 1 }
    }

    pub const fn open(self, element: PageElement) -> Self {
        self.push(operation: PageOp::open(element: element))
    }

    pub const fn attribute(self, value: PageAttribute) -> Self {
        self.push(operation: PageOp::attribute(value: value))
    }

    pub const fn text(self, value: PageText) -> Self {
        self.push(operation: PageOp::text(value: value))
    }

    pub const fn close(self) -> Self {
        self.push(operation: PageOp::close())
    }

    pub const fn render<A: ComponentAction>(
        self,
        source: PageText,
        wgsl_action: A,
        wasm_action: A,
        manifest_action: A,
    ) -> Self {
        self.push(operation: PageOp::render(
            source: source,
            wgsl_action: wgsl_action,
            wasm_action: wasm_action,
            manifest_action: manifest_action,
        ))
    }

    pub const fn component(self, source: PageText, mount: String<31>) -> Self {
        self.push(operation: PageOp::component(source: source, mount: mount))
    }

    pub const fn finish(self, title: PageText) -> Page<N> {
        Page { title: title, length: self.length, body: self.body }
    }

    pub const fn finish_component(self) -> ComponentView<N> {
        ComponentView { length: self.length, body: self.body }
    }
}
