//! Typed runtime-control authorities for compiler-correlated render surfaces.
//!
//! The browser reports opaque declaration-order tokens through the standard
//! reactive `EventSource<T>` effect and realizes one poster-only load through
//! `SurfaceLoader<B>`. Fe owns iteration, timeout/race, failure, cancellation,
//! and retry policy inside an actor `ScopedTask`; the fixed host owns only DOM
//! observation and the standards operation.

use core::backend::Backend
use core::marker::Copy
use core::pending::{Pending, Suspend, TaskOutcome}
use ingot::wasm::WasmBackend
use super::super::host::Resumable
use super::super::reactive::{Cancelled, Event, EventSource, Subscription}
use raw::{load_begin as raw_load_begin, next_begin as raw_next_begin}

/// Opaque one-based correlation token. Zero means the fixed declaration source
/// is exhausted. Application code never constructs or numerically interprets
/// this value.
pub struct SurfaceToken { raw: u64 }

impl Copy for SurfaceToken {}

impl SurfaceToken {
    pub fn is_end(self) -> bool {
        self.raw == 0
    }
}

/// Standards authority used by a resident actor task after it receives a
/// compiler-correlated declaration from `EventSource<SurfaceToken>`.
/// `load_begin` consumes no application URL or selector and completes after
/// the declaration's poster is ready.
pub trait SurfaceLoader<B: Backend> {
    fn load_begin(mut self, _ surface: SurfaceToken) -> Pending<B, u64>
}

/// Browser event handler over compiler-correlated render declarations. The
/// provider is the runtime-control interpreter: its `next` operation suspends
/// through the same generated continuation machinery as timers and receives.
/// The zero host token becomes typed `End`; failure and cancellation remain
/// distinct typed observations rather than application-reserved integers.
pub struct BrowserSurfaceEvents {}

impl EventSource<SurfaceToken> for BrowserSurfaceEvents {
    fn subscribe(mut self) -> Subscription<SurfaceToken> {
        Subscription::new()
    }

    fn next(
        mut self,
        _ subscription: own Subscription<SurfaceToken>,
    ) -> (Subscription<SurfaceToken>, Event<SurfaceToken>) {
        let successor = subscription.advance().0
        let outcome: TaskOutcome<u32, SurfaceToken> =
            <Resumable as Suspend<WasmBackend, u32>>::suspend(
                Resumable {}, raw_next_begin(),
            )
        let event = match outcome {
            TaskOutcome::Success(surface) => {
                if surface.is_end() { Event::end() }
                else { Event::occurrence(value: surface) }
            }
            TaskOutcome::Failure(error) => Event::failure(error: error)
            TaskOutcome::Cancelled => Event::cancelled()
        }
        (successor, event)
    }

    fn cancel(
        mut self,
        _ subscription: own Subscription<SurfaceToken>,
    ) -> Cancelled {
        Cancelled { consumed: subscription.cursor() }
    }
}

/// Browser realization of poster loading. It is capability evidence only; the
/// fixed host owns `<fe-surface>.load()`, never ordering/timeout policy.
pub struct BrowserSurfaceLoader {}

impl SurfaceLoader<WasmBackend> for BrowserSurfaceLoader {
    fn load_begin(mut self, _ surface: SurfaceToken) -> Pending<WasmBackend, u64> {
        raw_load_begin(surface)
    }
}
