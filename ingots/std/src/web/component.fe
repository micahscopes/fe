//! Fe-facing web component events.
//!
//! This is application vocabulary layered over core's target-neutral resident
//! actor transition. A fixed host adapter translates standards events into
//! these raw facts; Fe owns lifecycle and application state transitions. The
//! numeric target is a declarative action identity chosen by Fe page
//! composition, never a DOM selector interpreted as application policy by JS.

pub use core::{BrowserBytes, BrowserPtr, BrowserString}
pub use core::actor::{InitialState, ProjectState, ResidentTransition}
pub use core::marker::Copy as ComponentCopy
use core::marker::Copy
use core::browser::alloc_browser_bytes
use super::identity::{
    Checkbox, ComponentAction, ComponentClassToken, ComponentNode, ComponentRepeat,
    ComponentTarget, Input, Link, Text,
}

/// Version-1 event kinds at the fixed component boundary. Variants are append-
/// only within this ABI version because their fieldless-enum tags cross Wasm.
pub enum ComponentEventKind {
    Connected,
    Disconnected,
    Adopted,
    Activate,
    Input,
    Change,
    Submit,
    KeyDown,
    /// Completion of a Fe-requested browser resource effect. `request` is the
    /// opaque correlation identity chosen by Fe, `key` is the HTTP status (zero
    /// for a transport failure), `detail` is the byte length, and `text`
    /// carries a UTF-8 body or failure description.
    ResourceLoaded,
}

impl Copy for ComponentEventKind {}

/// Standards keyboard keys understood by the fixed component event lane.
/// The browser boundary remains an append-only scalar ABI, while application
/// actors match this vocabulary instead of repeating legacy key-code numbers.
pub enum KeyboardKey {
    Enter,
    Escape,
    Other,
}

impl Copy for KeyboardKey {}

/// One untouched event delivered to a resident Fe component actor. Scalars
/// cross as ordinary Wasm values; `text` crosses through the canonical
/// `(pointer, length)` UTF-8 descriptor owned by the fixed host boundary.
pub struct ComponentEvent<A = u32> {
    pub kind: ComponentEventKind,
    /// Fe-declared action identity attached by generated page composition.
    pub target: A,
    /// Opaque correlation identity for a completed Fe-requested resource
    /// effect. Ordinary standards events carry zero; this lane is deliberately
    /// separate from the typed action vocabulary.
    pub request: u32,
    /// Stable key of the nearest generated repeated item, or zero outside one.
    pub key: u32,
    /// Raw event detail or key code, with interpretation owned by Fe.
    pub detail: u32,
    /// Raw scalar value for controls whose standards value is numeric.
    pub value: f32,
    /// Host monotonic event timestamp in milliseconds.
    pub timestamp: f32,
    /// Untouched UTF-8 control value in Wasm memory. The fixed host reuses one
    /// bounded scratch allocation; Fe decides whether and how to retain it.
    pub text: BrowserString,
}

impl<A: Copy> Copy for ComponentEvent<A> {}

impl<A: Copy> ComponentEvent<A> {
    pub fn is_lifecycle(self) -> bool {
        match self.kind {
            ComponentEventKind::Connected => true,
            ComponentEventKind::Disconnected => true,
            ComponentEventKind::Adopted => true,
            _ => false,
        }
    }

    /// Interpret `detail` as a standards keyboard key for `KeyDown` events.
    /// Non-key events and keys outside the closed vocabulary return `Other`.
    pub fn keyboard_key(self) -> KeyboardKey {
        match self.kind {
            ComponentEventKind::KeyDown => {
                if self.detail == 13 { return KeyboardKey::Enter }
                if self.detail == 27 { return KeyboardKey::Escape }
                KeyboardKey::Other
            }
            _ => KeyboardKey::Other,
        }
    }

    /// Untouched click count for an activation event.
    pub fn click_count(self) -> u32 {
        match self.kind {
            ComponentEventKind::Activate => self.detail,
            _ => 0,
        }
    }
}

/// Component projection consumed by the fixed, demo-blind host.
/// Bit `n` in `visible_mask` controls generated view slot `n`; zero
/// `focus_target` means no focus request, while a nonzero value names a
/// Fe-declared action target. Bit zero of `flags` requests `preventDefault`
/// for the transported standards event; all higher bits are reserved in v1.
/// `commands` is an optional Fe-authored binary effect stream built through
/// `ComponentWriter`; JavaScript applies its fixed structural vocabulary but
/// contains no component-specific reducer or rendering policy.
pub struct ComponentPatch {
    pub visible_mask: u32,
    pub focus_target: u32,
    pub flags: u32,
    pub commands: BrowserBytes,
}

impl ComponentPatch {
    /// Construct one complete projection without exposing the fixed ABI's
    /// prevent-default flag bit to application code.
    pub fn new<A: ComponentAction>(
        visible_mask: u32,
        focus_target: A,
        prevent_default: bool,
        commands: own BrowserBytes,
    ) -> Self {
        Self {
            visible_mask: visible_mask,
            focus_target: focus_target.component_action_id(),
            flags: if prevent_default { 1 } else { 0 },
            commands: commands,
        }
    }
}

/// Allocate persistent Wasm memory for an actor's reusable projection buffer.
/// Resident components should allocate this once in their Fe initializer,
/// retain the descriptor in actor state, and overwrite it on each projection.
pub fn allocate_component_buffer(capacity: u32) -> BrowserBytes {
    // Writers use overlapping unaligned u32 stores to publish one byte at a
    // time while staying in Wasm's native i32 register class. Four bytes of
    // tail slack keep the final store inside the owned allocation.
    let allocation = alloc_browser_bytes(capacity + 4)
    BrowserBytes { ptr: allocation.address(), len: capacity }
}

/// Borrow UTF-8 bytes already held in resident Wasm memory.
pub fn component_string(ptr: u32, len: u32) -> BrowserString {
    BrowserString { ptr: ptr, len: len }
}

/// A compact Fe-side builder for the fixed component effect vocabulary.
/// Commands are deliberately defined here in Fe so application code remains
/// readable and the browser host only transports and applies typed effects.
pub struct ComponentWriter {
    pub buffer: BrowserBytes,
    pub cursor: u32,
    pub failed: bool,
}

struct DecimalStep {
    writer: ComponentWriter,
    remaining: u32,
}

impl Copy for ComponentWriter {}

impl ComponentWriter {
    pub fn new(buffer: own BrowserBytes) -> Self {
        Self { buffer: buffer, cursor: 0, failed: false }
    }

    fn byte(self, value: u32) -> Self {
        if self.cursor >= self.buffer.len {
            return Self { buffer: self.buffer, cursor: self.cursor, failed: true }
        }
        let cell: BrowserPtr<u32> = BrowserPtr::from_u32(self.buffer.ptr + self.cursor)
        cell.write(value & 255)
        Self { buffer: self.buffer, cursor: self.cursor + 1, failed: self.failed }
    }

    fn word(self, value: u32) -> Self {
        let mut writer = self.byte(value: value)
        writer = writer.byte(value: value >> 8)
        writer = writer.byte(value: value >> 16)
        writer.byte(value: value >> 24)
    }

    fn bytes(self, value: own BrowserString) -> Self {
        let mut writer = self
        let mut index: u32 = 0
        while index < value.len {
            let source: BrowserPtr<u32> = BrowserPtr::from_u32(value.ptr + index)
            writer = writer.byte(value: source.read())
            index = index + 1
        }
        writer
    }

    fn decimal_digit(self, value: u32, place: u32) -> DecimalStep {
        let mut remaining = value
        let mut digit: u32 = 0
        while remaining >= place {
            remaining = remaining - place
            digit = digit + 1
        }
        DecimalStep {
            writer: self.byte(value: 48 + digit),
            remaining: remaining,
        }
    }

    /// Begin one keyed reconciliation region. `container` names a
    /// `data-fe-node`; `template` names a `data-fe-template`.
    pub fn repeat_begin<R: ComponentRepeat>(self, region: R) -> Self {
        let writer = self.byte(value: 1)
        let id = <R as ComponentRepeat>::component_repeat_id(region)
        let writer = writer.word(value: id)
        writer.word(value: id)
    }

    /// Select/create one stable key and make its cloned row the command scope.
    pub fn repeat_item(self, key: u32) -> Self {
        if key == 0 { core::panic() }
        self.byte(value: 2).word(value: key)
    }

    /// Finish the current reconciliation region and remove absent keys.
    pub fn repeat_end(self) -> Self {
        self.byte(value: 3)
    }

    pub fn set_text<N: ComponentTarget<Text>>(self, target: N, value: own BrowserString) -> Self {
        let writer = self.byte(value: 4)
        let writer = writer.word(value: <N as ComponentTarget<Text>>::component_target_id(target))
        let writer = writer.word(value: value.len)
        writer.bytes(value: value)
    }

    /// Emit a bounded two-digit decimal without asking JavaScript to own
    /// number formatting. Values outside `[0, 99]` fail closed.
    pub fn set_small_u32_text<N: ComponentTarget<Text>>(self, target: N, value: u32) -> Self {
        if value >= 100 { core::panic() }
        let digits: u32 = if value >= 10 { 2 } else { 1 }
        let mut writer = self.byte(value: 4)
        writer = writer.word(value: <N as ComponentTarget<Text>>::component_target_id(target))
        writer = writer.word(value: digits)
        let mut remaining: u32 = value
        if value >= 10 {
            let mut tens: u32 = 0
            while remaining >= 10 {
                remaining = remaining - 10
                tens = tens + 1
            }
            writer = writer.byte(value: 48 + tens)
        }
        writer = writer.byte(value: 48 + remaining)
        writer
    }

    /// Emit an arbitrary `u32` as decimal text in Fe. The fixed host applies
    /// only the resulting bytes and owns no application number formatting.
    pub fn set_u32_text<N: ComponentTarget<Text>>(self, target: N, value: u32) -> Self {
        let digits: u32 = if value >= 1000000000 { 10 } else {
            if value >= 100000000 { 9 } else {
                if value >= 10000000 { 8 } else {
                    if value >= 1000000 { 7 } else {
                        if value >= 100000 { 6 } else {
                            if value >= 10000 { 5 } else {
                                if value >= 1000 { 4 } else {
                                    if value >= 100 { 3 } else {
                                        if value >= 10 { 2 } else { 1 }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        let mut writer = self.byte(value: 4)
        writer = writer.word(value: <N as ComponentTarget<Text>>::component_target_id(target))
        writer = writer.word(value: digits)
        let mut remaining = value
        if digits >= 10 {
            let step = writer.decimal_digit(value: remaining, place: 1000000000)
            writer = step.writer
            remaining = step.remaining
        }
        if digits >= 9 {
            let step = writer.decimal_digit(value: remaining, place: 100000000)
            writer = step.writer
            remaining = step.remaining
        }
        if digits >= 8 {
            let step = writer.decimal_digit(value: remaining, place: 10000000)
            writer = step.writer
            remaining = step.remaining
        }
        if digits >= 7 {
            let step = writer.decimal_digit(value: remaining, place: 1000000)
            writer = step.writer
            remaining = step.remaining
        }
        if digits >= 6 {
            let step = writer.decimal_digit(value: remaining, place: 100000)
            writer = step.writer
            remaining = step.remaining
        }
        if digits >= 5 {
            let step = writer.decimal_digit(value: remaining, place: 10000)
            writer = step.writer
            remaining = step.remaining
        }
        if digits >= 4 {
            let step = writer.decimal_digit(value: remaining, place: 1000)
            writer = step.writer
            remaining = step.remaining
        }
        if digits >= 3 {
            let step = writer.decimal_digit(value: remaining, place: 100)
            writer = step.writer
            remaining = step.remaining
        }
        if digits >= 2 {
            let step = writer.decimal_digit(value: remaining, place: 10)
            writer = step.writer
            remaining = step.remaining
        }
        writer.byte(value: 48 + remaining)
    }

    pub fn set_value<N: ComponentTarget<Input>>(self, target: N, value: own BrowserString) -> Self {
        let writer = self.byte(value: 5)
        let writer = writer.word(value: <N as ComponentTarget<Input>>::component_target_id(target))
        let writer = writer.word(value: value.len)
        writer.bytes(value: value)
    }

    pub fn set_checked<N: ComponentTarget<Checkbox>>(self, target: N, checked: bool) -> Self {
        let writer = self.byte(value: 6)
        let writer = writer.word(value: <N as ComponentTarget<Checkbox>>::component_target_id(target))
        writer.byte(value: if checked { 1 } else { 0 })
    }

    pub fn set_hidden<N: ComponentNode>(self, target: N, hidden: bool) -> Self {
        let writer = self.byte(value: 7)
        let writer = writer.word(value: target.component_node_id())
        writer.byte(value: if hidden { 1 } else { 0 })
    }

    /// Toggle the class named by `data-fe-class-{token}` on the target node.
    pub fn set_class<N: ComponentNode, C: ComponentClassToken>(self, target: N, token: C, enabled: bool) -> Self {
        let writer = self.byte(value: 8)
        let writer = writer.word(value: target.component_node_id())
        let writer = writer.word(value: token.component_class_token_id())
        writer.byte(value: if enabled { 1 } else { 0 })
    }

    pub fn focus<N: ComponentTarget<Input>>(self, target: N) -> Self {
        self.byte(value: 9).word(value: <N as ComponentTarget<Input>>::component_target_id(target))
    }

    pub fn set_disabled<N: ComponentNode>(self, target: N, disabled: bool) -> Self {
        let writer = self.byte(value: 10)
        let writer = writer.word(value: target.component_node_id())
        writer.byte(value: if disabled { 1 } else { 0 })
    }

    /// Set an anchor URL from Fe-authored state. The host validates and applies
    /// the standard `href` property but does not choose the destination.
    pub fn set_href<N: ComponentTarget<Link>>(self, target: N, value: own BrowserString) -> Self {
        let writer = self.byte(value: 11)
        let writer = writer.word(value: <N as ComponentTarget<Link>>::component_target_id(target))
        let writer = writer.word(value: value.len)
        writer.bytes(value: value)
    }

    /// Ask the fixed browser adapter to fetch one same-origin UTF-8 resource.
    /// Completion returns as `ComponentEventKind::ResourceLoaded`; request
    /// identity and stale-response policy remain Fe-owned.
    pub fn load_text(self, request: u32, value: own BrowserString) -> Self {
        let writer = self.byte(value: 12)
        let writer = writer.word(value: request)
        let writer = writer.word(value: value.len)
        writer.bytes(value: value)
    }

    /// Fetch a same-origin binary resource and report only its byte length.
    /// This keeps binary interpretation out of JavaScript while letting Fe
    /// decide how to present or otherwise act on the result.
    pub fn load_bytes(self, request: u32, value: own BrowserString) -> Self {
        let writer = self.byte(value: 13)
        let writer = writer.word(value: request)
        let writer = writer.word(value: value.len)
        writer.bytes(value: value)
    }

    pub fn finish(self) -> BrowserBytes {
        if self.failed { core::panic() }
        BrowserBytes { ptr: self.buffer.ptr, len: self.cursor }
    }
}
