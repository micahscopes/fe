//! The `view()` surface-declaration vocabulary (web v5, slice R1).
//!
//! A render `actor` declares its interactive boundary with one reserved const
//! behavior `const fn view() -> Surface<Params>`. The compiler CTFE-evaluates
//! that behavior at bundle time and projects the resulting value into the
//! fe-web-bundle manifest `surface` section (extent + per-param range / init /
//! kind); the fixed render runtime consumes it for real sliders, initial
//! uniforms, and dispatch size. Nothing here is known to the compiler as a
//! special type: these are ORDINARY const-constructible Fe library types (the
//! vocabulary lives in std, not the compiler; design 1.2 / 1.4). The only new
//! compiler capability is the generic const-projection seam that evaluates the
//! behavior and walks the record.
//!
//! `Param` also owns fluent input bindings. A params record and its ordinary
//! scalar state record are joined by `SurfaceState`; the
//! `ParamBindingsProvider` reflects the state fields once, projects the same
//! names from the params record, and emits a straight-line Fe transition. No
//! binding table is projected to JSON and the browser does not interpret these
//! values: the generated Wasm calls `Param::drive` below.

use core::derive::{Derive, Evidence, ImplBuilder, Reflect}
use core::num::{FloatRounding, IntDowncast}

/// Append-only identities for raw browser and presentation facts delivered to
/// a surface actor. The fieldless enum is the single Fe source of this fixed
/// Wasm lane's discriminants; application code matches variants rather than
/// repeating host integers.
pub enum SurfaceEventKind {
    Gesture,
    ParamEdit,
    AnimationFrame,
    GpuComplete,
    Visible,
    Hidden,
    DeviceLost,
    DeviceRecovered,
    /// Primary pointer contact began. The browser host supplies capture, raw
    /// coordinates, and buttons; selection policy remains in Fe.
    PointerDown,
    /// Primary-pointer motion. By default this is captured drag motion;
    /// `SurfacePointerMotion` additionally admits uncaptured hover motion with
    /// zero deltas. Homogeneous bursts may be accumulated by the generated
    /// Wasm wrapper, but never by application JavaScript.
    PointerMove,
    /// Primary pointer contact ended or was cancelled.
    PointerUp,
}

impl Copy for SurfaceEventKind {}

impl SurfaceEventKind {
    /// True only for raw browser facts admitted to the pending application
    /// input queue. Presentation-clock and lifecycle facts reach the resident
    /// scheduler directly; a permitted frame may additionally deliver its
    /// typed clock fact to the surface transition.
    pub fn is_application_input(self) -> bool {
        match self {
            SurfaceEventKind::Gesture => true,
            SurfaceEventKind::ParamEdit => true,
            SurfaceEventKind::PointerDown => true,
            SurfaceEventKind::PointerMove => true,
            SurfaceEventKind::PointerUp => true,
            _ => false,
        }
    }
}

/// The fixed browser-to-Fe input transport record. The marker declares nominal
/// host-boundary intent; the compiler verifies this complete field shape before
/// admitting a `SurfaceTransition` export, so no argument names or JSON binding
/// table participate in dispatch. It is deliberately flat: handlers read raw
/// facts directly, and the value-only Wasm lane never needs addressable nested
/// transport objects.
#[web_surface_event]
pub struct SurfaceEvent {
    pub pointer_x: f32,
    pub pointer_y: f32,
    pub delta_x: f32,
    pub delta_y: f32,
    /// Raw `WheelEvent.deltaY`; Fe owns its sign and scale policy.
    pub wheel_delta: f32,
    /// Raw `WheelEvent.deltaMode`.
    pub wheel_mode: u32,
    pub buttons: u32,
    pub timestamp: f32,
    pub width: f32,
    pub height: f32,
    /// Typed identity of the raw browser or presentation boundary fact.
    pub event_kind: SurfaceEventKind,
    /// Declaration-order parameter index for a direct edit.
    pub param_index: u32,
    /// Untouched browser/script value proposed by a direct edit.
    pub param_value: f32,
}

impl Copy for SurfaceEvent {}

impl SurfaceEvent {
    pub fn is_param_edit(self) -> bool {
        match self.event_kind { SurfaceEventKind::ParamEdit => true, _ => false }
    }

    pub fn is_animation_frame(self) -> bool {
        match self.event_kind { SurfaceEventKind::AnimationFrame => true, _ => false }
    }

    pub fn is_gpu_complete(self) -> bool {
        match self.event_kind { SurfaceEventKind::GpuComplete => true, _ => false }
    }

    pub fn is_pointer_down(self) -> bool {
        match self.event_kind { SurfaceEventKind::PointerDown => true, _ => false }
    }

    pub fn is_pointer_move(self) -> bool {
        match self.event_kind { SurfaceEventKind::PointerMove => true, _ => false }
    }

    pub fn is_pointer_up(self) -> bool {
        match self.event_kind { SurfaceEventKind::PointerUp => true, _ => false }
    }
}

/// Presentation-clock and lifecycle facts supplied by the fixed browser host
/// to a resident Fe scheduling policy. `pending_events` describes untouched
/// application input waiting at the host boundary; it is a fact, not a request
/// to present. The policy alone returns that decision.
#[web_surface_schedule_event]
pub struct SurfaceScheduleEvent {
    pub kind: SurfaceEventKind,
    pub timestamp: f32,
    pub pending_events: u32,
}

impl Copy for SurfaceScheduleEvent {}

/// Private state of a resident presentation policy. The all-zero value is the
/// deliberate initial state: hidden, idle, with no observed device loss and no
/// timing/count history. The latter fields are general policy memory rather
/// than host state; generated Wasm retains them without exposing a manifest.
#[web_surface_schedule_state]
pub struct SurfaceScheduleState {
    pub presenting: bool,
    pub visible: bool,
    pub device_lost: bool,
    pub last_presented_at: f32,
    pub deadline: f32,
    pub observed_inputs: u32,
}

impl Copy for SurfaceScheduleState {}

/// Fe-owned disposition of the untouched raw input queue. The fixed browser
/// adapter realizes this small standards-boundary effect without knowing which
/// policy selected it.
pub enum SurfaceQueueAction {
    /// Preserve every queued record. The generated transition decides how a
    /// homogeneous gesture burst is accumulated.
    Retain,
    /// Preserve only the newest raw record, implementing sampling rather than
    /// accumulation without moving that choice into JavaScript.
    KeepLatest,
    /// Discard the pending batch, implementing explicit drop/backpressure.
    Drop,
}

impl Copy for SurfaceQueueAction {}

/// One Fe-authored scheduling result. Generated Wasm retains `state`; only the
/// three host decisions cross the fixed binary boundary.
#[web_surface_schedule_step]
pub struct SurfaceScheduleStep {
    pub state: SurfaceScheduleState,
    pub present: bool,
    pub request_frame: bool,
    pub queue: SurfaceQueueAction,
}

impl Copy for SurfaceScheduleStep {}

impl SurfaceScheduleStep {
    /// Preserve every decision while changing only the raw-queue effect.
    pub fn with_queue(self, queue: SurfaceQueueAction) -> Self {
        SurfaceScheduleStep {
            state: self.state,
            present: self.present,
            request_frame: self.request_frame,
            queue: queue,
        }
    }

    /// Preserve every decision while updating one timing deadline.
    pub fn with_deadline(self, deadline: f32) -> Self {
        SurfaceScheduleStep {
            state: SurfaceScheduleState {
                presenting: self.state.presenting,
                visible: self.state.visible,
                device_lost: self.state.device_lost,
                last_presented_at: self.state.last_presented_at,
                deadline: deadline,
                observed_inputs: self.state.observed_inputs,
            },
            present: self.present,
            request_frame: self.request_frame,
            queue: self.queue,
        }
    }

    /// Reject a provisional presentation and request another browser frame,
    /// retaining policy history from before that provisional decision.
    pub fn defer(self, previous: SurfaceScheduleState) -> Self {
        SurfaceScheduleStep {
            state: SurfaceScheduleState {
                presenting: false,
                visible: self.state.visible,
                device_lost: self.state.device_lost,
                last_presented_at: previous.last_presented_at,
                deadline: self.state.deadline,
                observed_inputs: self.state.observed_inputs,
            },
            present: false,
            request_frame: true,
            queue: self.queue,
        }
    }
}

/// How Fe drives a parameter's semantic value. The variant NAME is retained as
/// an opaque projected diagnostic; `ParamPresentation` independently denotes
/// how a view displays it, so the host never infers presentation from this
/// enum.
pub enum ParamKind {
    /// A linear slider over `[min, max]`.
    Range,
    /// A linear slider over `[0, 1]`.
    Unit,
    /// An angle in radians, slider over `[0, TAU]`, wrapping.
    Angle,
    /// A logarithmic slider over `[min, max]`.
    Log,
    /// An integer slider over `[min, max]`, whole steps.
    Int,
    /// A projected-but-not-user-visible constant.
    Fixed,
    /// Bound to the live canvas width in pixels (replaces `const RESOLUTION`).
    ExtentX,
    /// Bound to the live canvas height in pixels.
    ExtentY,
    /// Boolean semantics transported as canonical `0.0 | 1.0` scalar state.
    /// Its checkbox presentation is independently explicit below.
    Toggle,
}

impl Copy for ParamKind {}

/// Where a surface parameter obtains its current host fact. The fixed browser
/// adapter realizes these sources; it does not infer them from `ParamKind`.
pub enum ParamValueSource {
    Initial,
    SurfaceWidth,
    SurfaceHeight,
}

/// Browser-neutral control shape requested by the Fe surface declaration.
pub enum ParamWidget {
    Hidden,
    Range,
    Checkbox,
    /// A finite integral choice, realized by browser hosts as a native select.
    Select,
}

/// Mapping between a range widget's normalized visual axis and its semantic
/// value. This remains independent of `ParamKind`: applications may introduce
/// new drive semantics while reusing an existing presentation mapping.
pub enum ParamScale {
    Linear,
    Logarithmic,
}

/// Formatting semantics for the current value shown beside a control.
pub enum ParamReadout {
    Scalar,
    Integer,
    Toggle,
}

impl Copy for ParamValueSource {}
impl Copy for ParamWidget {}
impl Copy for ParamScale {}
impl Copy for ParamReadout {}

/// One const-packed choice label. Four ordinary `u64` lanes keep the generic
/// surface transition's params record recursively scalar on wasm32; the
/// compiler reconstructs the original Fe-authored `String<31>` only while
/// projecting the target-neutral presentation plan.
struct ChoiceLabel {
    low_0: u64,
    low_1: u64,
    low_2: u64,
    low_3: u64,
}

impl Copy for ChoiceLabel {}

impl ChoiceLabel {
    const fn empty() -> Self {
        Self { low_0: 0, low_1: 0, low_2: 0, low_3: 0 }
    }

    const fn from_string(value: String<31>) -> Self {
        let word: u256 = value as u256
        Self {
            low_0: word.downcast_truncate(),
            low_1: (word >> 64).downcast_truncate(),
            low_2: (word >> 128).downcast_truncate(),
            low_3: (word >> 192).downcast_truncate(),
        }
    }
}

/// A small, explicitly ordered set of human-readable choice labels. The
/// scalar state remains the zero-based ordinal expected by shaders and Wasm;
/// these packed lanes exist only to carry Fe-authored const data into the
/// compiler-projected presentation plan.
pub struct ChoiceOptions {
    first: ChoiceLabel,
    second: ChoiceLabel,
    third: ChoiceLabel,
    fourth: ChoiceLabel,
    count: u32,
    max: f32,
}

impl Copy for ChoiceOptions {}

impl ChoiceOptions {
    const fn empty() -> Self {
        Self {
            first: ChoiceLabel::empty(),
            second: ChoiceLabel::empty(),
            third: ChoiceLabel::empty(),
            fourth: ChoiceLabel::empty(),
            count: 0,
            max: 0.0,
        }
    }

    pub const fn two(first: String<31>, second: String<31>) -> Self {
        Self {
            first: ChoiceLabel::from_string(value: first),
            second: ChoiceLabel::from_string(value: second),
            third: ChoiceLabel::empty(),
            fourth: ChoiceLabel::empty(),
            count: 2,
            max: 1.0,
        }
    }

    pub const fn three(
        first: String<31>, second: String<31>, third: String<31>,
    ) -> Self {
        Self {
            first: ChoiceLabel::from_string(value: first),
            second: ChoiceLabel::from_string(value: second),
            third: ChoiceLabel::from_string(value: third),
            fourth: ChoiceLabel::empty(),
            count: 3,
            max: 2.0,
        }
    }

    pub const fn four(
        first: String<31>, second: String<31>, third: String<31>, fourth: String<31>,
    ) -> Self {
        Self {
            first: ChoiceLabel::from_string(value: first),
            second: ChoiceLabel::from_string(value: second),
            third: ChoiceLabel::from_string(value: third),
            fourth: ChoiceLabel::from_string(value: fourth),
            count: 4,
            max: 3.0,
        }
    }
}

/// A complete Fe-authored control presentation. This is target-neutral data:
/// Leptos, a Web Component, or another view may realize the same denotation.
pub struct ParamPresentation {
    widget: ParamWidget,
    scale: ParamScale,
    readout: ParamReadout,
    visible: bool,
    options: ChoiceOptions,
}

impl Copy for ParamPresentation {}

/// One declared interactive parameter. `min`/`max`/`init` are plain data; range
/// sanity (min < max, init in range) is checked at the projection boundary, not
/// in the type (ranges are data). Fields are private: a `Param` is only ever
/// built through the const constructors below.
pub struct Param {
    kind: ParamKind,
    min: f32,
    max: f32,
    init: f32,
    /// Whether this declaration carries an inclusive range. This is authored
    /// by the Fe constructors and projected as data; the compiler does not
    /// infer presentation policy from `ParamKind`.
    bounded: bool,
    /// Whether `init` participates in initial surface state.
    initialized: bool,
    source: ParamValueSource,
    presentation: ParamPresentation,
    drag_x_per_px: f32,
    drag_y_per_px: f32,
    wheel_per_notch: f32,
    wheel_in_factor: f32,
    wheel_out_factor: f32,
}

impl Param {
    const fn control(
        _ kind: ParamKind,
        _ min: f32,
        _ max: f32,
        _ init: f32,
        _ widget: ParamWidget,
        _ scale: ParamScale,
        _ readout: ParamReadout,
    ) -> Param {
        Param {
            kind: kind, min: min, max: max, init: init,
            bounded: true, initialized: true,
            source: ParamValueSource::Initial,
            presentation: ParamPresentation {
                widget: widget, scale: scale, readout: readout, visible: true,
                options: ChoiceOptions::empty(),
            },
            drag_x_per_px: 0.0, drag_y_per_px: 0.0, wheel_per_notch: 0.0,
            wheel_in_factor: 1.0, wheel_out_factor: 1.0,
        }
    }

    const fn binding(
        _ kind: ParamKind,
        _ value: f32,
        _ initialized: bool,
        _ source: ParamValueSource,
    ) -> Param {
        Param {
            kind: kind, min: value, max: value, init: value,
            bounded: false, initialized: initialized, source: source,
            presentation: ParamPresentation {
                widget: ParamWidget::Hidden,
                scale: ParamScale::Linear,
                readout: ParamReadout::Scalar,
                visible: false,
                options: ChoiceOptions::empty(),
            },
            drag_x_per_px: 0.0, drag_y_per_px: 0.0, wheel_per_notch: 0.0,
            wheel_in_factor: 1.0, wheel_out_factor: 1.0,
        }
    }

    /// A linear slider over `[min, max]`, starting at `init`.
    pub const fn range(min: f32, max: f32, init: f32) -> Param {
        Param::control(
            ParamKind::Range, min, max, init,
            ParamWidget::Range, ParamScale::Linear, ParamReadout::Scalar,
        )
    }

    /// A linear slider over `[0, 1]`, starting at `init`.
    pub const fn unit(init: f32) -> Param {
        Param::control(
            ParamKind::Unit, 0.0, 1.0, init,
            ParamWidget::Range, ParamScale::Linear, ParamReadout::Scalar,
        )
    }

    /// An angle in radians over `[0, TAU]`, starting at `init`.
    pub const fn angle(init: f32) -> Param {
        Param::control(
            ParamKind::Angle, 0.0, 6.2831855, init,
            ParamWidget::Range, ParamScale::Linear, ParamReadout::Scalar,
        )
    }

    /// A logarithmic slider over `[min, max]`, starting at `init`.
    pub const fn log(min: f32, max: f32, init: f32) -> Param {
        Param::control(
            ParamKind::Log, min, max, init,
            ParamWidget::Range, ParamScale::Logarithmic, ParamReadout::Scalar,
        )
    }

    /// An integer slider over `[min, max]`, starting at `init`.
    pub const fn int(min: f32, max: f32, init: f32) -> Param {
        Param::control(
            ParamKind::Int, min, max, init,
            ParamWidget::Range, ParamScale::Linear, ParamReadout::Integer,
        )
    }

    /// A finite named choice transported as a zero-based scalar ordinal.
    ///
    /// The value remains the same GPU-friendly scalar carried by `int`; only
    /// its target-neutral presentation differs. Browser hosts realize this as
    /// a native `<select>` instead of a scrubber.
    pub const fn choice(options: ChoiceOptions, init: f32) -> Param {
        let result = Param::control(
            ParamKind::Int, 0.0, options.max, init,
            ParamWidget::Select, ParamScale::Linear, ParamReadout::Integer,
        )
        Param {
            kind: result.kind, min: result.min, max: result.max, init: result.init,
            bounded: result.bounded, initialized: result.initialized,
            source: result.source,
            presentation: ParamPresentation {
                widget: result.presentation.widget,
                scale: result.presentation.scale,
                readout: result.presentation.readout,
                visible: result.presentation.visible,
                options: options,
            },
            drag_x_per_px: result.drag_x_per_px,
            drag_y_per_px: result.drag_y_per_px,
            wheel_per_notch: result.wheel_per_notch,
            wheel_in_factor: result.wheel_in_factor,
            wheel_out_factor: result.wheel_out_factor,
        }
    }

    /// A checkbox starting either unchecked or checked. Its scalar carrier is
    /// deliberate: it remains compatible with GPU uniforms while application
    /// code can immediately interpret it as an enum or boolean policy.
    pub const fn toggle(init: bool) -> Param {
        let value: f32 = if init { 1.0 } else { 0.0 }
        Param::control(
            ParamKind::Toggle, 0.0, 1.0, value,
            ParamWidget::Checkbox, ParamScale::Linear, ParamReadout::Toggle,
        )
    }

    /// A constant value carried into the uniform record but not shown as a
    /// control.
    pub const fn fixed(_ value: f32) -> Param {
        Param::binding(ParamKind::Fixed, value, true, ParamValueSource::Initial)
    }

    /// Bound to the live canvas width in pixels. The runtime writes the actual
    /// backing-store width into this member each configure, so the kernel is
    /// resolution-exact with no `const RESOLUTION` and no ABI change.
    pub const fn extent_x() -> Param {
        Param::binding(ParamKind::ExtentX, 0.0, false, ParamValueSource::SurfaceWidth)
    }

    /// Bound to the live canvas height in pixels.
    pub const fn extent_y() -> Param {
        Param::binding(ParamKind::ExtentY, 0.0, false, ParamValueSource::SurfaceHeight)
    }

    /// Add `delta_x * per_px` to this value for each captured drag event.
    pub const fn drag_x(self, per_px: f32) -> Param {
        Param {
            kind: self.kind, min: self.min, max: self.max, init: self.init,
            bounded: self.bounded, initialized: self.initialized,
            source: self.source, presentation: self.presentation,
            drag_x_per_px: per_px, drag_y_per_px: self.drag_y_per_px,
            wheel_per_notch: self.wheel_per_notch,
            wheel_in_factor: self.wheel_in_factor,
            wheel_out_factor: self.wheel_out_factor,
        }
    }

    /// Add `delta_y * per_px` to this value for each captured drag event.
    pub const fn drag_y(self, per_px: f32) -> Param {
        Param {
            kind: self.kind, min: self.min, max: self.max, init: self.init,
            bounded: self.bounded, initialized: self.initialized,
            source: self.source, presentation: self.presentation,
            drag_x_per_px: self.drag_x_per_px, drag_y_per_px: per_px,
            wheel_per_notch: self.wheel_per_notch,
            wheel_in_factor: self.wheel_in_factor,
            wheel_out_factor: self.wheel_out_factor,
        }
    }

    /// Add one signed `per_notch` step for each raw wheel event. Deliberately
    /// choosing the sign-only policy here makes browser delta units irrelevant;
    /// applications needing a continuous trackpad curve can provide an authored
    /// transition instead of changing the host transport.
    pub const fn wheel(self, per_notch: f32) -> Param {
        Param {
            kind: self.kind, min: self.min, max: self.max, init: self.init,
            bounded: self.bounded, initialized: self.initialized,
            source: self.source, presentation: self.presentation,
            drag_x_per_px: self.drag_x_per_px,
            drag_y_per_px: self.drag_y_per_px,
            wheel_per_notch: per_notch,
            wheel_in_factor: self.wheel_in_factor,
            wheel_out_factor: self.wheel_out_factor,
        }
    }

    /// Scale inward/outward wheel events by explicit factors. This is the
    /// reusable form of the gallery's former handwritten `wheel_zoom` helper.
    pub const fn wheel_scale(self, in_factor: f32, out_factor: f32) -> Param {
        Param {
            kind: self.kind, min: self.min, max: self.max, init: self.init,
            bounded: self.bounded, initialized: self.initialized,
            source: self.source, presentation: self.presentation,
            drag_x_per_px: self.drag_x_per_px,
            drag_y_per_px: self.drag_y_per_px,
            wheel_per_notch: self.wheel_per_notch,
            wheel_in_factor: in_factor, wheel_out_factor: out_factor,
        }
    }

    /// Apply this declaration to one current scalar and one untouched browser
    /// fact. This body is ordinary Fe and is what the provider-generated state
    /// transition calls in Wasm.
    pub fn drive(self, _ current: f32, _ event: SurfaceEvent, _ index: u32) -> f32 {
        let mut next: f32 = current
        if event.is_param_edit() {
            if event.param_index != index { return current }
            next = event.param_value
        } else {
            next = current
                + event.delta_x * self.drag_x_per_px
                + event.delta_y * self.drag_y_per_px
            if event.wheel_delta < 0.0 {
                next = (next - self.wheel_per_notch) * self.wheel_in_factor
            } else {
                if event.wheel_delta > 0.0 {
                    next = (next + self.wheel_per_notch) * self.wheel_out_factor
                }
            }
        }

        match self.kind {
            ParamKind::Range => next.clamp(self.min, self.max),
            ParamKind::Unit => next.clamp(self.min, self.max),
            ParamKind::Angle => {
                let span = self.max - self.min
                let offset = next - self.min
                self.min + offset - span * (offset / span).floor()
            },
            ParamKind::Log => next.clamp(self.min, self.max),
            ParamKind::Int => next.round().clamp(self.min, self.max),
            ParamKind::Fixed => current,
            ParamKind::ExtentX => event.width,
            ParamKind::ExtentY => event.height,
            ParamKind::Toggle => if next >= 0.5 { 1.0 } else { 0.0 },
        }
    }
}

/// Associates an ordinary scalar state record with the params record whose
/// fields have the same labels. The relation is authored in Fe, not inferred
/// from a manifest.
pub trait SurfaceState {
    type Params
}

/// A straight-line, field-complete input transition derived from `Param`
/// declarations. Rich coupled controls (for example cursor-anchored deep
/// Mandelbrot navigation) remain ordinary authored implementations.
pub trait ApplyParamBindings: SurfaceState {
    fn apply_param_bindings(
        self,
        _ params: <Self as SurfaceState>::Params,
        _ event: SurfaceEvent,
    ) -> Self
}

/// Generic derive provider for `ApplyParamBindings`. Reflection supplies only
/// state field labels; `Param::drive` supplies all application semantics.
pub struct ParamBindingsProvider {}

impl Derive<ApplyParamBindings> for ParamBindingsProvider {
    const fn derive<T>(ev: own Evidence<ApplyParamBindings<T>>) -> Evidence<ApplyParamBindings<T>>
        uses (
            reflect: Reflect<T>,
            builder: mut ImplBuilder<ApplyParamBindings<T>>,
        )
    {
        let state = builder.self_ref()
        let params = builder.arg_ref("params")
        let event = builder.arg_ref("event")
        let mut next = builder.struct_init()
        let mut index: u32 = 0
        for field in reflect.fields() {
            let current = builder.field_get(state, field)
            let param = builder.field_get(params, field)
            let driven = builder.call(param, "drive", current, event, builder.int(index))
            next = builder.with_field(next, field, driven)
            index = index + 1
        }
        builder.emit_method("apply_param_bindings", next)
        builder.finish()
        ev
    }
}

/// The dispatch/canvas extent in pixels. Built through the constructors so the
/// fields stay private; the page carries no sizes, the manifest does.
pub struct Extent {
    width: u32,
    height: u32,
}

impl Extent {
    /// A square extent of `n` by `n` pixels.
    pub const fn square(_ n: u32) -> Extent {
        Extent { width: n, height: n }
    }

    /// A rectangular extent, `width` by `height` pixels.
    pub const fn rect(_ width: u32, _ height: u32) -> Extent {
        Extent { width: width, height: height }
    }
}

/// The surface declaration: the extent plus a per-demo params record `V` whose
/// FIELD NAMES bind, by name identity, to the actor's state fields (checked at
/// projection time, erroring and naming all sources on any mismatch). Fields
/// are public so an actor's `view()` constructs one with an ordinary struct
/// literal.
pub struct Surface<V> {
    pub extent: Extent,
    pub params: V,
}
