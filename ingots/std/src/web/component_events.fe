//! Typed occurrence streams scoped to the owning resident web component.
//!
//! The fixed browser capability attaches listeners only while a Fe pull is
//! pending and returns untouched standards facts. Fe owns iteration,
//! scheduling, gesture interpretation, actor delivery, and state. Pointer
//! Events deliberately unify mouse, pen, and touch at the standards boundary.

use core::pending::{Suspend, TaskOutcome}
use core::default::Default
use ingot::wasm::WasmBackend
use super::super::host::Resumable
use super::super::reactive::{
    AsyncEventSource, Cancelled, Event, EventSource, Subscription,
}
use raw::{
    captured_pointer_begin as raw_captured_pointer_begin,
    pointer_begin as raw_pointer_begin,
    wheel_begin as raw_wheel_begin,
}

#[derive(Default)]
pub enum PointerPhase {
    Down,
    Move,
    Up,
    #[default]
    Cancel,
    /// The browser reported that an active pointer capture ended outside the
    /// ordinary up/cancel path. Appending this standards fact preserves all
    /// existing phase ordinals while letting Fe terminate gesture state.
    LostCapture,
}

impl Copy for PointerPhase {}

#[derive(Default)]
pub enum PointerDevice {
    Mouse,
    Pen,
    Touch,
    #[default]
    Other,
}

impl Copy for PointerDevice {}

#[derive(Default)]
pub struct PointerSample {
    pub phase: PointerPhase,
    pub device: PointerDevice,
    pub pointer_id: u32,
    pub client_x: f32,
    pub client_y: f32,
    pub buttons: u32,
    pub primary: bool,
    pub pressure: f32,
    pub timestamp: f32,
}

impl Copy for PointerSample {}

impl PointerSample {
    /// Well-typed storage for an unobserved subscription. No field is a
    /// sentinel; callers must still consult `Subscription::has_observation`.
    pub fn placeholder() -> Self {
        Self::default()
    }
}

#[derive(Default)]
pub enum WheelDeltaMode {
    #[default]
    Pixel,
    Line,
    Page,
    Other,
}

impl Copy for WheelDeltaMode {}

#[derive(Default)]
pub struct WheelSample {
    pub delta_x: f32,
    pub delta_y: f32,
    pub delta_z: f32,
    pub mode: WheelDeltaMode,
    pub client_x: f32,
    pub client_y: f32,
    pub control: bool,
    pub timestamp: f32,
}

impl Copy for WheelSample {}

impl WheelSample {
    pub fn placeholder() -> Self {
        Self::default()
    }
}

pub struct BrowserPointerEvents {}
/// Pointer Events with an explicit Fe-selected capture policy. The fixed host
/// captures the first primary pointer on `Down`, releases it on `Up`/`Cancel`,
/// reports unexpected loss as `PointerPhase::LostCapture`, and releases any
/// retained capture when the owning affine subscription is cancelled.
pub struct BrowserCapturedPointerEvents {}
pub struct BrowserWheelEvents {}

impl BrowserPointerEvents {
    pub fn new() -> Self {
        Self {}
    }

    /// Select primary-pointer capture as part of the typed Fe source graph.
    /// The raw source remains available when native browser targeting is the
    /// intended policy; JavaScript never chooses between the two.
    pub fn capture_primary(own self) -> BrowserCapturedPointerEvents {
        BrowserCapturedPointerEvents {}
    }
}

impl BrowserWheelEvents {
    pub fn new() -> Self {
        Self {}
    }
}

impl AsyncEventSource<WasmBackend, PointerSample> for BrowserPointerEvents {
    fn subscribe(mut self) -> Subscription<PointerSample> {
        Subscription::new(initial: PointerSample::placeholder())
    }

    fn next_begin(
        mut self,
        _ subscription: own Subscription<PointerSample>,
    ) -> (Subscription<PointerSample>, core::pending::Pending<WasmBackend, PointerSample>) {
        (subscription.advance().0, raw_pointer_begin())
    }

    fn cancel(mut self, _ subscription: own Subscription<PointerSample>) -> Cancelled {
        Cancelled { consumed: subscription.cursor() }
    }
}

impl AsyncEventSource<WasmBackend, PointerSample> for BrowserCapturedPointerEvents {
    fn subscribe(mut self) -> Subscription<PointerSample> {
        Subscription::new(initial: PointerSample::placeholder())
    }

    fn next_begin(
        mut self,
        _ subscription: own Subscription<PointerSample>,
    ) -> (Subscription<PointerSample>, core::pending::Pending<WasmBackend, PointerSample>) {
        (subscription.advance().0, raw_captured_pointer_begin())
    }

    fn cancel(mut self, _ subscription: own Subscription<PointerSample>) -> Cancelled {
        Cancelled { consumed: subscription.cursor() }
    }
}

impl AsyncEventSource<WasmBackend, WheelSample> for BrowserWheelEvents {
    fn subscribe(mut self) -> Subscription<WheelSample> {
        Subscription::new(initial: WheelSample::placeholder())
    }

    fn next_begin(
        mut self,
        _ subscription: own Subscription<WheelSample>,
    ) -> (Subscription<WheelSample>, core::pending::Pending<WasmBackend, WheelSample>) {
        (subscription.advance().0, raw_wheel_begin())
    }

    fn cancel(mut self, _ subscription: own Subscription<WheelSample>) -> Cancelled {
        Cancelled { consumed: subscription.cursor() }
    }
}

impl EventSource<PointerSample> for BrowserPointerEvents {
    fn subscribe(mut self) -> Subscription<PointerSample> {
        Subscription::new(initial: PointerSample::placeholder())
    }

    fn next(mut self, _ subscription: own Subscription<PointerSample>) -> (
        Subscription<PointerSample>,
        Event<PointerSample>,
    ) {
        let (successor, pending) = <BrowserPointerEvents as AsyncEventSource<
            WasmBackend,
            PointerSample,
        >>::next_begin(self, subscription)
        let outcome: TaskOutcome<u32, PointerSample> = <Resumable as Suspend<
            WasmBackend,
            u32,
        >>::suspend(Resumable {}, pending)
        let event = match outcome {
            TaskOutcome::Success(sample,) => Event::occurrence(value: sample),
            TaskOutcome::Failure(error,) => Event::failure(error: error),
            TaskOutcome::Cancelled => Event::cancelled(),
        }
        (successor, event)
    }

    fn cancel(mut self, _ subscription: own Subscription<PointerSample>) -> Cancelled {
        Cancelled { consumed: subscription.cursor() }
    }
}

