//! Reactive programming in Fe: pure value combinators over runtime control
//! effects.
//!
//! A `Signal` is a pure sample of time and an `Event<T>` is one typed discrete
//! occurrence. `EventSource<T>` is the small pull-shaped *handler authority*:
//! a handler creates a `Subscription<T>`, each `next` consumes that
//! subscription and returns its successor, and `cancel` consumes it finally. Imperative
//! consumers and `Stream` both request the same `mut EventSource` effect; they
//! cannot quietly acquire or drive a source through a second direct runtime.
//! A browser event target, deterministic tape, game loop, async iterator, or
//! channel may implement the handler without changing the combinator algebra.
//!
//! This module does not choose completion cells, blocking versus suspension,
//! placement, or a particular host. Those are interpretations of the
//! `EventSource` effect (and, for asynchronous handlers, the shared
//! `core::pending` rail). `Stream` is a zero-state vocabulary over that effect:
//! the source lives in the surrounding handler scope, never as a second
//! couriered field inside the stream. Synchronous tests use an ordinary Fe tape
//! as that handler; browser/Worker/WebGPU handlers may resume it from their
//! runtime control effects.
//!
//! ## Purity is a type fact, not a convention (the flagship property)
//!
//! `Signal::sample` carries NO `uses` row: a signal is a pure function of time
//! by construction. Because impl methods CANNOT WIDEN a trait method's effect
//! row (`6-0009`, "method has stricter bounds than trait", measured), no
//! `Signal` impl can add a `uses` clause to `sample`. Therefore NO behavior can
//! smuggle an effect through the sampling interface: behavior purity is a
//! compiler-checked TYPE FACT. The negative fixture
//! `reactive_signal_purity.fe` pins this: a `sample` impl that tries to widen
//! the row with `uses (w: mut Wait<WasmBackend>)` is rejected by `6-0009`.
//!
//! ## Layering (no new Functor)
//!
//! This layer sits ABOVE the shipped `core::conal::Functor` (the applied-form,
//! element-changing container functor) and reuses it as an element-mapping
//! LEAF; it invents no new Functor. Mapping a pure function over a signal's
//! sampled element is exactly the `F = identity` case of the applicative
//! combine below, and any element-level container mapping a leaf needs is
//! `core::conal::Functor::map`. The reactive layer contributes the time axis;
//! the element algebra is already shipped one floor down.
//!
//! ## Scope of this slice
//!
//! v1 `T` is compiler-flattenable `Copy` values, including closed records such
//! as a viewport observation (the sampled-value grammar). There is no
//! continuous-time interval reasoning, no push-pull optimization, and no
//! dynamic-network GC. `map_event`, `filter_event`, and `hold` are pure
//! transformations of occurrences. Acquisition, polling and cancellation are
//! visibly effectful at every consumer boundary, while `Signal::sample` remains
//! checked-pure.

use core::Fn
use core::backend::Backend
use core::pending::Pending

/// A Signal: denotationally `time -> T`, sampled. PURE BY CONSTRUCTION.
///
/// `sample` carries NO `uses` row, and since impl methods cannot widen a trait
/// method's effect row (`6-0009`), no impl can add one. That makes behavior
/// purity a type fact: a `Signal` can never perform an effect while sampling.
/// The industry-converged name (SolidJS/Angular/Preact/Vue, the TC39 signals
/// proposal) with honest FRP pedigree (Elm signals, Yampa SF); denotationally a
/// signal is a value over time you can `sample`. Concept-named trait with a verb
/// method, the `core::conal::Functor::map` pattern.
///
/// v1 `T` is a compiler-flattenable `Copy` value (the sampled-value grammar).
pub trait Signal<T> {
    /// Sample the signal at time `t_ms` (milliseconds). No `uses` row: sampling
    /// is pure, checked pure, by construction.
    fn sample(self, _ t_ms: u64) -> T
}

/// The constant signal: `sample(t) = value` for all `t`. The simplest leaf.
pub struct Const { pub value: u32 }

impl Signal<u32> for Const {
    fn sample(self, _ t_ms: u64) -> u32 {
        self.value
    }
}

/// The piecewise-constant stepper: the behavior holding an event's last value,
/// sampled as that held value regardless of time.
pub struct Stepped { pub held: u32 }

impl Signal<u32> for Stepped {
    fn sample(self, _ t_ms: u64) -> u32 {
        self.held
    }
}

/// The applicative combine, hand-defunctionalized: sample BOTH sub-signals at
/// the same instant and apply `f` to the pair. `map` is the `F = identity`
/// case; a `switch` v1 would be a `Stepped`-selected pair (rudimentary, R7a).
///
/// `f` is a plain `Fn`-typed field (`core::functional::Fn`), so the combinator
/// is generic over any callable value; measured to type-check and execute on
/// this substrate (CE-8), no effect-polymorphic-`Fn` horizon needed. Crucially,
/// `f: F` is an `Fn`, and an `Fn` impl cannot carry a `uses` row (`6-0009`
/// again), so the combine stays pure: `Combine2::sample` has no `uses` row and
/// nothing it calls can smuggle one either.
pub struct Combine2<A, B, F> { pub a: A, pub b: B, pub f: F }

impl<A: Signal<u32>, B: Signal<u32>, F: Fn<(u32, u32), u32>> Signal<u32> for Combine2<A, B, F> {
    fn sample(self, _ t_ms: u64) -> u32 {
        self.f.call((self.a.sample(t_ms), self.b.sample(t_ms)))
    }
}

/// One typed source observation. Absence is distinct from source exhaustion,
/// transport failure, and structured cancellation; no payload sentinel is
/// reserved and browser adapters cannot collapse those cases into a boolean.
#[must_use]
pub enum Event<T> {
    Occurrence(T,),
    Absent,
    End,
    Failure(u32,),
    Cancelled,
}

impl<T: Copy> Copy for Event<T> {}

impl<T> Event<T> {
    pub fn occurrence(_ value: T) -> Self {
        Self::Occurrence(value)
    }
    pub fn absent() -> Self {
        Self::Absent
    }
    pub fn end() -> Self {
        Self::End
    }
    pub fn failure(_ error: u32) -> Self {
        Self::Failure(error)
    }
    pub fn cancelled() -> Self {
        Self::Cancelled
    }
}

impl<T: Copy> Event<T> {
    pub fn is_occurrence(self) -> bool {
        match self {
            Self::Occurrence(_,) => true,
            _ => false,
        }
    }
    pub fn value_or(self, _ fallback: T) -> T {
        match self {
            Self::Occurrence(value,) => value,
            _ => fallback,
        }
    }
}

/// Linear ownership of one attachment to an event source.
///
/// `next` must consume the old value and return the successor; `cancel`
/// consumes the final value. Consequently a caller cannot accidentally retain
/// two live owners of one subscription.
pub struct Subscription<T> { cursor: u32, observed: bool, observation: T }

impl<T> Subscription<T> {
    /// Create an unobserved subscription with a well-typed source-defined
    /// initial value. `observation` is meaningful only after
    /// `has_observation` becomes true; no payload value is reserved as a
    /// sentinel.
    pub fn new(_ initial: T) -> Self {
        Self { cursor: 0, observed: false, observation: initial }
    }
    pub fn cursor(self) -> u32 {
        self.cursor
    }

    /// Whether this subscription has committed a source observation.
    pub fn has_observation(self) -> bool {
        self.observed
    }
    pub fn with_observation(own self, _ value: T) -> Self {
        Self { cursor: self.cursor, observed: true, observation: value }
    }

    /// Consume this position and return `(successor, old_cursor)`.
    pub fn advance(own self) -> (Self, u32) {
        (
            Self {
                cursor: self.cursor + 1,
                observed: self.observed,
                observation: self.observation,
            },
            self.cursor,
        )
    }
}

impl<T: Copy> Subscription<T> {
    /// The last typed state observed by this subscription. Callers use
    /// `has_observation` to distinguish the source-defined initial value from
    /// an actual occurrence. Copy is explicit because observing must not split
    /// the affine token's ownership of a non-Copy payload.
    pub fn observation(self) -> T {
        self.observation
    }
}

/// Observable cleanup result used by source-independent tests and adapters.
pub struct Cancelled { pub consumed: u32 }

/// Generic event/subscription runtime-control authority.
///
/// It is an ordinary Fe trait with no compiler-recognized source names. A
/// concrete tape or host adapter is installed through `with (EventSource =
/// handler)`, and consumers request it in their `uses` row. Mutable receivers
/// allow a handler to own cursor, wakeup and broker state without placing that
/// state in `Stream` or JavaScript application policy.
pub trait EventSource<T> {
    fn subscribe(mut self) -> Subscription<T>
    fn next(mut self, _ subscription: own Subscription<T>) -> (Subscription<T>, Event<T>)
    fn cancel(mut self, _ subscription: own Subscription<T>) -> Cancelled
}

/// Begin-shaped asynchronous source authority over the shared affine pending
/// rail.
///
/// `EventSource::next` is intentionally convenient for serialized consumers,
/// but it hides the pending pull inside its handler. A producer/consumer loop
/// must be able to keep that pull alive while independently awaiting a sink.
/// `AsyncEventSource` exposes exactly that control edge: `next_begin` consumes
/// the subscription, returns its sole successor, and mints one typed pending
/// observation. It does not select, buffer, schedule, or interpret failures;
/// those remain visible Fe policy in the consumer.
pub trait AsyncEventSource<B: Backend, T> {
    fn subscribe(mut self) -> Subscription<T>
    fn next_begin(
        mut self,
        _ subscription: own Subscription<T>,
    ) -> (Subscription<T>, Pending<B, T>)
    fn cancel(mut self, _ subscription: own Subscription<T>) -> Cancelled
}

/// Acquire one subscription through the current runtime effect handler.
pub fn subscribe_event<T>() -> Subscription<T> uses (source: mut EventSource<T>) {
    source.subscribe()
}

/// Consume one subscription position and retrieve its next occurrence through
/// the current handler. The returned successor is the only live owner.
pub fn next_event<T>(_ subscription: own Subscription<T>) -> (Subscription<T>, Event<T>)
uses (source: mut EventSource<T>)
{
    source.next(subscription)
}

/// Cancel the current subscription through its owning handler. Cancellation is
/// affine: this consumes the token, so a second cancellation cannot type-check.
pub fn cancel_event<T>(_ subscription: own Subscription<T>) -> Cancelled
uses (source: mut EventSource<T>)
{
    source.cancel(subscription)
}

/// Host-neutral stream vocabulary over the current `EventSource` effect.
///
/// The stream stores no source and introduces no runtime protocol. Its methods
/// forward to the same effectful functions used by imperative consumers, so
/// subscription state has exactly one handler and one affine ownership model.
pub struct Stream<T> {}

impl<T> Stream<T> {
    pub fn new() -> Self {
        Self {}
    }
    pub fn subscribe(self) -> Subscription<T> uses (source: mut EventSource<T>) {
        subscribe_event()
    }
    pub fn next(self, _ subscription: own Subscription<T>) -> (Subscription<T>, Event<T>)
    uses (source: mut EventSource<T>)
    {
        next_event(subscription)
    }

    /// Consume source positions until an occurrence or terminal observation is
    /// ready. Sources may use `Absent` for a synchronous empty poll; consumers
    /// that need a value-or-terminal boundary should not each reimplement this
    /// affine forwarding loop.
    pub fn next_ready(self, _ subscription: own Subscription<T>) -> (Subscription<T>, Event<T>)
    uses (source: mut EventSource<T>)
    {
        let mut current = subscription
        let mut ready: Event<T> = Event::absent()
        let mut waiting = true
        while waiting {
            let next = next_event(current)
            current = next.0
            match next.1 {
                Event::Occurrence(value,) => {
                    ready = Event::occurrence(value: value)
                    waiting = false
                },
                Event::Absent => {},
                Event::End => {
                    ready = Event::end()
                    waiting = false
                },
                Event::Failure(error,) => {
                    ready = Event::failure(error: error)
                    waiting = false
                },
                Event::Cancelled => {
                    ready = Event::cancelled()
                    waiting = false
                },
            }
        }
        (current, ready)
    }
    pub fn cancel(self, _ subscription: own Subscription<T>) -> Cancelled
    uses (source: mut EventSource<T>)
    {
        cancel_event(subscription)
    }
}

/// Overflow semantics for a bounded Fe-owned event queue.
///
/// `DropNewest` preserves every value already admitted. `KeepLatest` evicts
/// the oldest queued value and admits the new one, which is the useful policy
/// for pointer, viewport, and animation state where stale work has less value
/// than the newest observation. The policy is data, not host behavior.
pub enum OverflowPolicy {
    DropNewest,
    KeepLatest,
}

impl Copy for OverflowPolicy {}

/// A bounded, allocation-free queue for explicit backpressure policy.
///
/// The queue is a pure Fe value. An interpreter may schedule producers and
/// consumers however it likes, but admission, eviction, FIFO order, and the
/// observable dropped count remain application/library semantics. `initial`
/// initializes otherwise-unused slot storage and is never treated as an
/// occurrence. Today's resident-Wasm value ABI admits capacities one through
/// four; a const-generic array backing can remove that implementation ceiling
/// once nested arrays in returned aggregate values are scalarized.
pub struct BoundedQueue<T> {
    value0: T,
    value1: T,
    value2: T,
    value3: T,
    capacity: u32,
    head: u32,
    len: u32,
    dropped: u32,
    admitted: bool,
}

/// A `Latest` value is the same queue protocol initialized with one slot by
/// `latest`; the alias contributes no second implementation or host protocol.
pub type Latest<T> = BoundedQueue<T>

pub fn latest<T: Copy>(_ initial: T) -> Latest<T> {
    BoundedQueue::new(initial: initial, capacity: 1)
}

impl<T: Copy> BoundedQueue<T> {
    pub fn new(_ initial: T, _ capacity: u32) -> Self {
        if capacity == 0 || capacity > 4 {
            core::panic()
        }
        Self {
            value0: initial,
            value1: initial,
            value2: initial,
            value3: initial,
            capacity: capacity,
            head: 0,
            len: 0,
            dropped: 0,
            admitted: false,
        }
    }
    pub fn capacity(self) -> u32 {
        self.capacity
    }
    pub fn queued(self) -> u32 {
        self.len
    }
    pub fn dropped(self) -> u32 {
        self.dropped
    }
    pub fn last_offer_admitted(self) -> bool {
        self.admitted
    }

    /// Offer one value under the selected bounded-overflow policy. The returned
    /// queue records whether the new value itself was admitted through
    /// `last_offer_admitted`.
    pub fn offer(self, _ value: T, _ overflow: OverflowPolicy) -> Self {
        let mut value0 = self.value0
        let mut value1 = self.value1
        let mut value2 = self.value2
        let mut value3 = self.value3
        let mut head = self.head
        let mut len = self.len
        let mut dropped = self.dropped
        if len == self.capacity {
            dropped = dropped + 1
            match overflow {
                OverflowPolicy::DropNewest => {
                    return Self {
                        value0: value0,
                        value1: value1,
                        value2: value2,
                        value3: value3,
                        capacity: self.capacity,
                        head: head,
                        len: len,
                        dropped: dropped,
                        admitted: false,
                    }
                },
                OverflowPolicy::KeepLatest => {
                    head = (head + 1) % self.capacity
                    len = len - 1
                },
            }
        }
        let tail = (head + len) % self.capacity
        if tail == 0 {
            value0 = value
        } else if tail == 1 {
            value1 = value
        } else if tail == 2 {
            value2 = value
        } else {
            value3 = value
        }
        Self {
            value0: value0,
            value1: value1,
            value2: value2,
            value3: value3,
            capacity: self.capacity,
            head: head,
            len: len + 1,
            dropped: dropped,
            admitted: true,
        }
    }

    /// Observe the oldest admitted value, or report ordinary absence when the
    /// bounded queue is empty. Terminal source states remain the responsibility
    /// of the surrounding stream; the queue invents none.
    pub fn front(self) -> Event<T> {
        if self.len == 0 {
            Event::absent()
        } else {
            let value = if self.head == 0 {
                self.value0
            } else if self.head == 1 {
                self.value1
            } else if self.head == 2 {
                self.value2
            } else {
                self.value3
            }
            Event::occurrence(value: value)
        }
    }

    /// Consume the oldest slot. Splitting `front` from `consume` keeps this
    /// functional value API scalarizable on current Wasm lowering: no method
    /// needs a mutable aggregate receiver or a nested `(queue, event)` result.
    pub fn consume(self) -> Self {
        if self.len == 0 {
            return self
        }
        Self {
            value0: self.value0,
            value1: self.value1,
            value2: self.value2,
            value3: self.value3,
            capacity: self.capacity,
            head: (self.head + 1) % self.capacity,
            len: self.len - 1,
            dropped: self.dropped,
            admitted: self.admitted,
        }
    }
}

/// Stateful pure scan over typed observations.
///
/// Each present occurrence updates the accumulator; absence and terminal states
/// leave it unchanged without fabricating a step. `Event` is `Copy`, so callers
/// can independently propagate the original terminal observation. The
/// accumulator is held in Fe and the reducer remains a pure `Fn`, so neither a
/// JavaScript closure graph nor an effectful callback can hide behind `scan`.
pub struct Scan<S> { state: S, steps: u32 }

impl<S> Scan<S> {
    pub fn new(_ initial: S) -> Self {
        Self { state: initial, steps: 0 }
    }
}

impl<S: Copy> Scan<S> {
    pub fn state(self) -> S {
        self.state
    }
    pub fn steps(self) -> u32 {
        self.steps
    }
    pub fn step<T: Copy, F: Fn<(S, T), S>>(self, _ event: Event<T>, _ reducer: F) -> Self {
        match event {
            Event::Occurrence(value,) => {
                Self { state: reducer.call((self.state, value)), steps: self.steps + 1 }
            },
            _ => self,
        }
    }
}

/// Purely transform a present occurrence, preserving absence.
pub fn map_event<T: Copy, U, F: Fn<T, U>>(_ event: Event<T>, _ f: F) -> Event<U> {
    match event {
        Event::Occurrence(value,) => Event::occurrence(value: f.call(value)),
        Event::Absent => Event::absent(),
        Event::End => Event::end(),
        Event::Failure(error,) => Event::failure(error: error),
        Event::Cancelled => Event::cancelled(),
    }
}

/// Purely retain an occurrence when `predicate` accepts its value.
pub fn filter_event<T: Copy, P: Fn<T, bool>>(_ event: Event<T>, _ predicate: P) -> Event<T> {
    match event {
        Event::Occurrence(value,) => {
            if predicate.call(value) {
                Event::occurrence(value: value)
            } else {
                Event::absent()
            }
        },
        _ => event,
    }
}

/// Step a held signal from one occurrence. Absence preserves the old value.
pub fn hold(_ current: Stepped, _ event: Event<u32>) -> Stepped {
    match event {
        Event::Occurrence(value,) => Stepped { held: value },
        _ => current,
    }
}
