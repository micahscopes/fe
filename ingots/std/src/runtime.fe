//! Target-neutral structured-task lifecycle policy.
//!
//! Browser, native, and deterministic test handlers may realize child start,
//! timer, restart, and close effects. This module owns the decisions: rolling
//! restart admission, epoch advancement, backoff selection, terminal failure,
//! and parent-cancellation propagation are ordinary Fe values and functions.
//! No Worker object, clock, timer, error string, or JavaScript callback enters
//! the policy surface.

use core::Backend
pub use core::actor::{ActorMailbox, Handles, ScopedTask}
use core::pending::{
    Pending,
    PendingCancellation,
    Select,
    SelectOutcome,
    Suspend,
    TaskOutcome,
    Timer,
}

pub use browser::{BrowserActorMailbox, BrowserChildPlacement, supervise_browser_child}

pub enum ChildFailureKind {
    None,
    Startup,
    Runtime,
}

impl Copy for ChildFailureKind {}

/// Raw structured-child lifecycle facts are epoch-tagged payload variants.
/// This makes impossible payload combinations unrepresentable and lets Fe
/// reject stale readiness, failure, and timer delivery.
pub enum ChildLifecycleEvent {
    SpawnRequested,
    Ready(u32),
    Failed(u32, ChildFailureKind, u64),
    BackoffElapsed(u32),
    ParentCancelled,
}

impl Copy for ChildLifecycleEvent {}

/// One nominal phase replaces several independent booleans, so invalid states
/// such as active-and-cancelled or starting-and-in-backoff cannot be built.
pub enum ChildSupervisionPhase {
    Idle,
    Starting,
    Active,
    Backoff,
    Terminal,
    Cancelled,
}

impl Copy for ChildSupervisionPhase {}

/// State retained by the parent Fe scope.
pub struct ChildSupervisionState {
    pub epoch: u32,
    pub restarts_in_window: u32,
    pub window_started_ms: u64,
    pub phase: ChildSupervisionPhase,
    pub last_failure: ChildFailureKind,
}

impl Copy for ChildSupervisionState {}

impl ChildSupervisionState {
    pub fn initial() -> Self {
        Self {
            epoch: 0,
            restarts_in_window: 0,
            window_started_ms: 0,
            phase: ChildSupervisionPhase::Idle,
            last_failure: ChildFailureKind::None,
        }
    }
}

/// Mechanism command selected by Fe. A platform handler may realize these
/// commands, but it may not choose a different command or retry on its own.
pub enum ChildSupervisionAction {
    NoAction,
    Spawn,
    RestartAfter,
    Close,
    Fail,
}

impl Copy for ChildSupervisionAction {}

pub struct ChildSupervisionStep {
    pub state: ChildSupervisionState,
    pub action: ChildSupervisionAction,
    pub delay_ms: u64,
    pub startup_timeout_ms: u64,
}

impl Copy for ChildSupervisionStep {}

/// Target-neutral mechanics required by one structured child scope.
///
/// `spawn_begin` completes when the selected placement is ready. A failed
/// start is delivered through `TaskOutcome::Failure`. Once ready,
/// `failure_begin` completes only when that epoch's child fails. `close` is an
/// immediate, idempotent release command. None of these operations may choose
/// whether or when another epoch is started.
pub struct ChildStarted<C> {}
pub struct ChildRuntimeFailure<C> {}

pub trait ChildPlacement<B: Backend, C> {
    fn spawn_begin(mut self, _ epoch: u32) -> Pending<B, ChildStarted<C>>
    fn failure_begin(mut self, _ epoch: u32) -> Pending<B, ChildRuntimeFailure<C>>
    fn close(mut self, _ epoch: u32)
}

/// Terminal observation of an owning structured-child loop.
pub enum ChildScopeExit {
    Cancelled(u32),
    Exhausted(u32, ChildFailureKind),
    TransportFailure(u32, u32),
    InvariantViolation(u32, ChildSupervisionPhase),
}

pub struct RestartWindowBudget {
    pub max_restarts: u32,
    pub window_ms: u64,
    pub backoff_ms: u64,
    pub startup_timeout_ms: u64,
}

impl Copy for RestartWindowBudget {}

impl RestartWindowBudget {
    pub fn bounded(
        max_restarts: u32,
        window_ms: u64,
        backoff_ms: u64,
        startup_timeout_ms: u64,
    ) -> Self {
        Self {
            max_restarts: max_restarts,
            window_ms: if window_ms == 0 { 1 } else { window_ms },
            backoff_ms: backoff_ms,
            startup_timeout_ms: if startup_timeout_ms == 0 { 1 } else { startup_timeout_ms },
        }
    }
}

/// A supervision policy is a pure Fe reducer. Effect handlers consume the
/// returned action after the state has been committed by the owning scope.
pub trait ChildSupervisionPolicy {
    fn decide(
        self,
        event: own ChildLifecycleEvent,
        state: own ChildSupervisionState,
    ) -> ChildSupervisionStep
}

pub struct RestartWindow {
    pub budget: RestartWindowBudget,
}

impl Copy for RestartWindow {}

impl RestartWindow {
    pub fn bounded(
        max_restarts: u32,
        window_ms: u64,
        backoff_ms: u64,
        startup_timeout_ms: u64,
    ) -> Self {
        Self {
            budget: RestartWindowBudget::bounded(
                max_restarts: max_restarts,
                window_ms: window_ms,
                backoff_ms: backoff_ms,
                startup_timeout_ms: startup_timeout_ms,
            ),
        }
    }
}

fn within_window(now_ms: u64, started_ms: u64, window_ms: u64) -> bool {
    now_ms >= started_ms && now_ms - started_ms < window_ms
}

impl ChildSupervisionPolicy for RestartWindow {
    fn decide(
        self,
        event: own ChildLifecycleEvent,
        state: own ChildSupervisionState,
    ) -> ChildSupervisionStep {
        let mut epoch = state.epoch
        let mut restarts = state.restarts_in_window
        let mut window_started = state.window_started_ms
        let mut phase = state.phase
        let mut last_failure = state.last_failure
        let mut action = ChildSupervisionAction::NoAction
        let mut delay_ms: u64 = 0

        match phase {
            ChildSupervisionPhase::Terminal => {}
            ChildSupervisionPhase::Cancelled => {}
            _ => {
                match event {
                    ChildLifecycleEvent::SpawnRequested => {
                        match phase {
                            ChildSupervisionPhase::Idle => {
                                phase = ChildSupervisionPhase::Starting
                                action = ChildSupervisionAction::Spawn
                            }
                            _ => {}
                        }
                    }
                    ChildLifecycleEvent::Ready(observed_epoch) => {
                        match phase {
                            ChildSupervisionPhase::Starting => {
                                if observed_epoch == epoch {
                                    phase = ChildSupervisionPhase::Active
                                }
                            }
                            _ => {}
                        }
                    }
                    ChildLifecycleEvent::Failed(observed_epoch, failure, now_ms) => {
                        let current_child = match phase {
                            ChildSupervisionPhase::Starting => true,
                            ChildSupervisionPhase::Active => true,
                            _ => false,
                        }
                        if current_child && observed_epoch == epoch {
                            last_failure = failure
                            if restarts == 0 || !within_window(
                                now_ms: now_ms,
                                started_ms: window_started,
                                window_ms: self.budget.window_ms,
                            ) {
                                restarts = 0
                                window_started = now_ms
                            }
                            if restarts < self.budget.max_restarts && epoch < 4294967295 {
                                restarts = restarts + 1
                                epoch = epoch + 1
                                phase = ChildSupervisionPhase::Backoff
                                action = ChildSupervisionAction::RestartAfter
                                delay_ms = self.budget.backoff_ms
                            } else {
                                phase = ChildSupervisionPhase::Terminal
                                action = ChildSupervisionAction::Fail
                            }
                        }
                    }
                    ChildLifecycleEvent::BackoffElapsed(observed_epoch) => {
                        match phase {
                            ChildSupervisionPhase::Backoff => {
                                if observed_epoch == epoch {
                                    phase = ChildSupervisionPhase::Starting
                                    action = ChildSupervisionAction::Spawn
                                }
                            }
                            _ => {}
                        }
                    }
                    ChildLifecycleEvent::ParentCancelled => {
                        phase = ChildSupervisionPhase::Cancelled
                        action = ChildSupervisionAction::Close
                    }
                }
            }
        }

        ChildSupervisionStep {
            state: ChildSupervisionState {
                epoch: epoch,
                restarts_in_window: restarts,
                window_started_ms: window_started,
                phase: phase,
                last_failure: last_failure,
            },
            action: action,
            delay_ms: delay_ms,
            startup_timeout_ms: self.budget.startup_timeout_ms,
        }
    }
}

/// Run one child under an ordinary Fe supervision policy.
///
/// The handler realizes only spawn, failure observation, timer, and close
/// mechanics. Fe owns every lifecycle event, restart decision, epoch, delay,
/// exhaustion branch, and parent-cancellation cleanup. The loop is backend
/// generic and uses the same affine `Pending`/`Suspend` rail as browser events,
/// fetch, actor sends, and GPU completion.
pub fn supervise_child<B: Backend, C, P: ChildSupervisionPolicy + Copy>(
    _ child: C,
    _ policy: P,
) -> ChildScopeExit
uses (
    placement: mut ChildPlacement<B, C>,
    timer: mut Timer<B>,
    select: mut Select<B, u32>,
    cancellation: mut PendingCancellation<B>,
    suspend: Suspend<B, u32>,
)
{
    let mut state = ChildSupervisionState::initial()
    let mut event = ChildLifecycleEvent::SpawnRequested

    while true {
        let step = policy.decide(event: event, state: state)
        state = step.state

        match step.action {
            ChildSupervisionAction::NoAction => {
                match state.phase {
                    ChildSupervisionPhase::Active => {
                        let pending = placement.failure_begin(state.epoch)
                        let outcome: TaskOutcome<u32, ChildRuntimeFailure<C>> = suspend.suspend(pending)
                        match outcome {
                            TaskOutcome::Success(_) => {
                                event = ChildLifecycleEvent::Failed(
                                    state.epoch,
                                    ChildFailureKind::Runtime,
                                    timer.now(),
                                )
                            }
                            TaskOutcome::Failure(error) => {
                                placement.close(state.epoch)
                                return ChildScopeExit::TransportFailure(state.epoch, error)
                            }
                            TaskOutcome::Cancelled => {
                                event = ChildLifecycleEvent::ParentCancelled
                            }
                        }
                    }
                    _ => {
                        placement.close(state.epoch)
                        return ChildScopeExit::InvariantViolation(state.epoch, state.phase)
                    }
                }
            }
            ChildSupervisionAction::Spawn => {
                let spawning = placement.spawn_begin(state.epoch)
                let timeout = timer.sleep_begin(step.startup_timeout_ms)
                let selected = select.select(spawning, timeout)
                let outcome: TaskOutcome<
                    u32,
                    SelectOutcome<B, u32, ChildStarted<C>, u64>,
                > = suspend.suspend(selected)
                match outcome {
                    TaskOutcome::Success(selection) => {
                        match selection {
                            SelectOutcome::Left(winner,) => {
                                cancellation.cancel_pending(winner.right)
                                event = ChildLifecycleEvent::Ready(state.epoch)
                            }
                            SelectOutcome::Right(winner,) => {
                                cancellation.cancel_pending(winner.left)
                                event = ChildLifecycleEvent::Failed(
                                    state.epoch,
                                    ChildFailureKind::Startup,
                                    timer.now(),
                                )
                            }
                            SelectOutcome::LeftFailure(_) => {
                                event = ChildLifecycleEvent::Failed(
                                    state.epoch,
                                    ChildFailureKind::Startup,
                                    timer.now(),
                                )
                            }
                            SelectOutcome::RightFailure(error,) => {
                                placement.close(state.epoch)
                                return ChildScopeExit::TransportFailure(state.epoch, error)
                            }
                            SelectOutcome::LeftCancelled => {
                                placement.close(state.epoch)
                                return ChildScopeExit::TransportFailure(state.epoch, 1)
                            }
                            SelectOutcome::RightCancelled => {
                                placement.close(state.epoch)
                                return ChildScopeExit::TransportFailure(state.epoch, 1)
                            }
                        }
                    }
                    TaskOutcome::Failure(error) => {
                        placement.close(state.epoch)
                        return ChildScopeExit::TransportFailure(state.epoch, error)
                    }
                    TaskOutcome::Cancelled => {
                        event = ChildLifecycleEvent::ParentCancelled
                    }
                }
            }
            ChildSupervisionAction::RestartAfter => {
                let pending = timer.sleep_begin(step.delay_ms)
                let outcome: TaskOutcome<u32, u64> = suspend.suspend(pending)
                match outcome {
                    TaskOutcome::Success(_) => {
                        event = ChildLifecycleEvent::BackoffElapsed(state.epoch)
                    }
                    TaskOutcome::Failure(error) => {
                        placement.close(state.epoch)
                        return ChildScopeExit::TransportFailure(state.epoch, error)
                    }
                    TaskOutcome::Cancelled => {
                        event = ChildLifecycleEvent::ParentCancelled
                    }
                }
            }
            ChildSupervisionAction::Close => {
                placement.close(state.epoch)
                return ChildScopeExit::Cancelled(state.epoch)
            }
            ChildSupervisionAction::Fail => {
                placement.close(state.epoch)
                return ChildScopeExit::Exhausted(state.epoch, state.last_failure)
            }
        }
    }

    ChildScopeExit::InvariantViolation(state.epoch, state.phase)
}
