pub recursive type fn Canonical50TypedChunk24<const N: usize>() -> (*) {
    match N {
        0 => Zero
        _ => Add<
            Canonical50Term<
                {canonical50_chunk24_candidate(N - 1)},
                {canonical50_chunk24_left(N - 1)},
                {canonical50_chunk24_point(N - 1)},
                {canonical50_chunk24_right(N - 1)},
                {canonical50_chunk24_output(N - 1)},
                {canonical50_chunk24_magnitude(N - 1)},
                {canonical50_chunk24_negative(N - 1)},
            >,
            Canonical50TypedChunk24<{N - 1}>,
        >
    }
}

/// Exact ascending leaves in four fixed 8-term recursive chunks, pairwise
/// associated at the root. This changes IEEE-754 Add association relative to
/// Canonical50Schedule32; it is the browser kernel's explicit FP contract.
pub type Canonical50TypedBalancedSchedule32 =
    Add<
        Add<
            Canonical50TypedChunk0<8>,
            Canonical50TypedChunk8<8>,
        >,
        Add<
            Canonical50TypedChunk16<8>,
            Canonical50TypedChunk24<8>,
        >,
    >
