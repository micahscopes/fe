use sparse_clifford::{
    Add,
    Cl41Metric,
    CliffordCoefficient,
    CliffordCoefficientAccess,
    CliffordGp,
    CliffordMv,
    PlanLength,
    SparsePlan,
    Term,
    Zero,
    plan_mask_candidate,
}

// Bounded symbolic coefficient interpretation for one Cl(4,1) S*P*S
// specialization. The public Fuchs–Théry CliffordGp recurrence owns all blade
// signs and product decomposition. This coefficient algebra only canonicalizes
// commutative scalar monomials and combines their signed multiplicities.
//
// Four sphere seeds and five point seeds produce 20 S*P intermediates and 50
// Sym^2(S)*P final monomials. Each polynomial digit is an isolated signed
// five-bit lane in five u64 words: representable -16..=15, intentionally
// checked to -8..=8. Twelve lanes occupy each word (the last uses two).
// Arithmetic is digitwise; packed carries are never polynomial arithmetic.

const STAGE_ZERO: u32 = 0
const STAGE_SPHERE: u32 = 1
const STAGE_POINT: u32 = 2
const STAGE_SP: u32 = 3
const STAGE_SSP: u32 = 4
const STAGE_INVALID: u32 = 255

// Operand cardinalities. Every monomial count in this file is a consequence of
// these two and is written as that consequence: an S*P intermediate is one
// sphere seed times one point seed, and an S*P*S monomial is one unordered
// sphere pair times one point seed.
const SPHERE_COUNT: usize = 4
const POINT_COUNT: usize = 5
const SPHERE_PAIR_COUNT: usize = SPHERE_COUNT * (SPHERE_COUNT + 1) / 2
const SP_COUNT: usize = SPHERE_COUNT * POINT_COUNT
const SSP_COUNT: usize = SPHERE_PAIR_COUNT * POINT_COUNT

// Packed signed-digit lane geometry. LANE_BITS is a storage width, unrelated to
// POINT_COUNT and to the algebra dimension despite sharing their value; only
// PACKED_MASK and the lane shifts may be derived from it.
const LANE_BITS: usize = 5
const PACKED_MASK: u64 = ((1 as u64) << LANE_BITS.downcast_unchecked()) - 1

// Named seed decomposition. These are input support declarations, not an
// expansion table.
const SPHERE_E1: i32 = 1
const SPHERE_E2: i32 = 2
const SPHERE_E4: i32 = 8
const SPHERE_E5: i32 = 16
const POINT_E1: i32 = 1
const POINT_E2: i32 = 2
const POINT_E3: i32 = 4
const POINT_E4: i32 = 8
const POINT_E5: i32 = 16

struct Words {
    word0: u64,
    word1: u64,
    word2: u64,
    word3: u64,
    word4: u64,
}
impl Copy for Words {}

struct Packed {
    code: Words,
    valid: bool,
}
impl Copy for Packed {}

struct PackedWord {
    code: u64,
    valid: bool,
}
impl Copy for PackedWord {}

struct CanonicalNative {
    valid: bool,
    count: u32,
    maximum: i32,
    keep0: u32,
    keep1: u32,
    keep2: u32,
    mag0: u32,
    mag1: u32,
    mag2: u32,
    mag3: u32,
    sign0: u32,
    sign1: u32,
}
impl Copy for CanonicalNative {}

struct Canonical50Coefficient {
    stage: u32,
    index: usize,
    negative: bool,
    code: Words,
    valid: bool,
}
impl Copy for Canonical50Coefficient {}

const fn packed_zero(_ count: usize) -> Words {
    Words { word0: 0, word1: 0, word2: 0, word3: 0, word4: 0 }
}

const fn packed_word(_ code: Words, _ word: usize) -> u64 {
    match word {
        0 => code.word0
        1 => code.word1
        2 => code.word2
        3 => code.word3
        _ => code.word4
    }
}

const fn packed_with_word(_ code: Words, _ word: usize, _ value: u64) -> Words {
    match word {
        0 => Words { word0: value, word1: code.word1, word2: code.word2, word3: code.word3, word4: code.word4 }
        1 => Words { word0: code.word0, word1: value, word2: code.word2, word3: code.word3, word4: code.word4 }
        2 => Words { word0: code.word0, word1: code.word1, word2: value, word3: code.word3, word4: code.word4 }
        3 => Words { word0: code.word0, word1: code.word1, word2: code.word2, word3: value, word4: code.word4 }
        _ => Words { word0: code.word0, word1: code.word1, word2: code.word2, word3: code.word3, word4: value }
    }
}

const fn packed_coefficient(_ code: Words, _ bin: usize) -> i32 {
    let word = bin / 12
    let shift: u64 = ((bin % 12) * LANE_BITS).downcast_unchecked()
    let digit: usize =
        ((packed_word(code, word) >> shift) & PACKED_MASK).downcast_unchecked()
    if digit < 16 {
        digit.downcast_unchecked()
    } else {
        let signed: i32 = digit.downcast_unchecked()
        signed - 32
    }
}

const fn packed_set(
    _ code: Words,
    _ bin: usize,
    _ coefficient: i32,
) -> Words {
    let word = bin / 12
    let shift: u64 = ((bin % 12) * LANE_BITS).downcast_unchecked()
    let place: u64 = 1 << shift
    let old_word = packed_word(code, word)
    let old = (old_word >> shift) & PACKED_MASK
    let encoded = if coefficient < 0 { coefficient + 32 } else { coefficient }
    let digit: u64 = encoded.downcast_unchecked()
    packed_with_word(code, word, old_word - old * place + digit * place)
}

const fn packed_add(_ a: Words, _ b: Words, _ count: usize) -> Packed {
    let word0 = packed_add_word(a.word0, b.word0, if count < 12 { count } else { 12 })
    let word1 = packed_add_word(a.word1, b.word1, if count <= 12 { 0 } else if count < 24 { count - 12 } else { 12 })
    let word2 = packed_add_word(a.word2, b.word2, if count <= 24 { 0 } else if count < 36 { count - 24 } else { 12 })
    let word3 = packed_add_word(a.word3, b.word3, if count <= 36 { 0 } else if count < 48 { count - 36 } else { 12 })
    let word4 = packed_add_word(a.word4, b.word4, if count <= 48 { 0 } else if count < 60 { count - 48 } else { 12 })
    Packed {
        code: Words {
            word0: word0.code,
            word1: word1.code,
            word2: word2.code,
            word3: word3.code,
            word4: word4.code,
        },
        valid: word0.valid && word1.valid && word2.valid
            && word3.valid && word4.valid,
    }
}

const fn packed_add_word(_ a: u64, _ b: u64, _ count: usize) -> PackedWord {
    let mut code: u64 = 0
    let mut valid = true
    let mut bin: usize = 0
    while bin < count {
        let shift: u64 = (bin * LANE_BITS).downcast_unchecked()
        let a_digit: i32 = ((a >> shift) & PACKED_MASK).downcast_unchecked()
        let b_digit: i32 = ((b >> shift) & PACKED_MASK).downcast_unchecked()
        let a_value = if a_digit < 16 { a_digit } else { a_digit - 32 }
        let b_value = if b_digit < 16 { b_digit } else { b_digit - 32 }
        let coefficient = a_value + b_value
        if coefficient < -8 || 8 < coefficient {
            valid = false
        } else {
            let encoded = if coefficient < 0 { coefficient + 32 } else { coefficient }
            let digit: u64 = encoded.downcast_unchecked()
            code = code | (digit << shift)
        }
        bin = bin + 1
    }
    PackedWord { code: code, valid: valid }
}

const fn packed_neg(_ code: Words, _ count: usize) -> Packed {
    let word0 = packed_neg_word(code.word0, if count < 12 { count } else { 12 })
    let word1 = packed_neg_word(code.word1, if count <= 12 { 0 } else if count < 24 { count - 12 } else { 12 })
    let word2 = packed_neg_word(code.word2, if count <= 24 { 0 } else if count < 36 { count - 24 } else { 12 })
    let word3 = packed_neg_word(code.word3, if count <= 36 { 0 } else if count < 48 { count - 36 } else { 12 })
    let word4 = packed_neg_word(code.word4, if count <= 48 { 0 } else if count < 60 { count - 48 } else { 12 })
    Packed {
        code: Words {
            word0: word0,
            word1: word1,
            word2: word2,
            word3: word3,
            word4: word4,
        },
        valid: true,
    }
}

const fn packed_neg_word(_ code: u64, _ count: usize) -> u64 {
    let mut out: u64 = 0
    let mut bin: usize = 0
    while bin < count {
        let shift: u64 = (bin * LANE_BITS).downcast_unchecked()
        let digit: i32 = ((code >> shift) & PACKED_MASK).downcast_unchecked()
        let value = if digit < 16 { digit } else { digit - 32 }
        let negated = -value
        let encoded = if negated < 0 { negated + 32 } else { negated }
        let encoded_digit: u64 = encoded.downcast_unchecked()
        out = out | (encoded_digit << shift)
        bin = bin + 1
    }
    out
}

const fn packed_add_at(
    _ code: Words,
    _ bin: usize,
    _ delta: i32,
) -> Packed {
    let coefficient = packed_coefficient(code, bin) + delta
    if coefficient < -8 || 8 < coefficient {
        Packed { code: code, valid: false }
    } else {
        Packed {
            code: packed_set(code, bin, coefficient),
            valid: true,
        }
    }
}

const fn coefficient_zero() -> Canonical50Coefficient {
    Canonical50Coefficient {
        stage: STAGE_ZERO,
        index: 0,
        negative: false,
        code: packed_zero(SSP_COUNT),
        valid: true,
    }
}

const fn coefficient_invalid() -> Canonical50Coefficient {
    Canonical50Coefficient {
        stage: STAGE_INVALID,
        index: 0,
        negative: false,
        code: packed_zero(SSP_COUNT),
        valid: false,
    }
}

const fn sphere_seed(_ index: usize) -> Canonical50Coefficient {
    Canonical50Coefficient {
        stage: STAGE_SPHERE,
        index: index,
        negative: false,
        code: packed_zero(SSP_COUNT),
        valid: index < SPHERE_COUNT,
    }
}

const fn point_seed(_ index: usize) -> Canonical50Coefficient {
    Canonical50Coefficient {
        stage: STAGE_POINT,
        index: index,
        negative: false,
        code: packed_zero(SSP_COUNT),
        valid: index < POINT_COUNT,
    }
}

const fn polynomial_single(
    _ stage: u32,
    _ count: usize,
    _ bin: usize,
    _ negative: bool,
    _ valid: bool,
) -> Canonical50Coefficient {
    let code = if bin < count {
        packed_set(
            packed_zero(count),
            bin,
            if negative { -1 } else { 1 },
        )
    } else {
        packed_zero(count)
    }
    Canonical50Coefficient {
        stage: stage,
        index: 0,
        negative: false,
        code: code,
        valid: valid && bin < count,
    }
}

const fn sphere_pair_rank(_ a: usize, _ b: usize) -> usize {
    let lo = if a < b { a } else { b }
    let hi = if a < b { b } else { a }
    let mut rank: usize = 0
    let mut left: usize = 0
    while left < lo {
        rank = rank + (SPHERE_COUNT - left)
        left = left + 1
    }
    rank + hi - lo
}

const fn multiply_sp_sphere(
    _ sp: Canonical50Coefficient,
    _ sphere: Canonical50Coefficient,
) -> Canonical50Coefficient {
    let mut code = packed_zero(SSP_COUNT)
    let mut valid = sp.valid && sphere.valid
    let mut bin: usize = 0
    while bin < SP_COUNT {
        let mut coefficient = packed_coefficient(sp.code, bin)
        if sphere.negative { coefficient = -coefficient }
        if coefficient != 0 {
            let sphere_left = bin / POINT_COUNT
            let point = bin % POINT_COUNT
            let target =
                sphere_pair_rank(sphere_left, sphere.index) * POINT_COUNT
                    + point
            let updated = packed_add_at(code, target, coefficient)
            code = updated.code
            valid = valid && updated.valid
        }
        bin = bin + 1
    }
    Canonical50Coefficient {
        stage: STAGE_SSP,
        index: 0,
        negative: false,
        code: code,
        valid: valid,
    }
}

impl CliffordCoefficient for Canonical50Coefficient {
    const fn clifford_coefficient_add(self, other: Self) -> Self {
        if self.stage == STAGE_ZERO { return other }
        if other.stage == STAGE_ZERO { return self }
        if self.stage != other.stage { return coefficient_invalid() }
        if self.stage != STAGE_SP && self.stage != STAGE_SSP {
            return coefficient_invalid()
        }
        let count = if self.stage == STAGE_SP { SP_COUNT } else { SSP_COUNT }
        let sum = packed_add(self.code, other.code, count)
        Canonical50Coefficient {
            stage: self.stage,
            index: 0,
            negative: false,
            code: sum.code,
            valid: self.valid && other.valid && sum.valid,
        }
    }

    const fn clifford_coefficient_mul(self, other: Self) -> Self {
        if self.stage == STAGE_ZERO || other.stage == STAGE_ZERO {
            return coefficient_zero()
        }
        if self.stage == STAGE_SPHERE && other.stage == STAGE_POINT {
            return polynomial_single(
                STAGE_SP,
                SP_COUNT,
                self.index * POINT_COUNT + other.index,
                self.negative ^ other.negative,
                self.valid && other.valid,
            )
        }
        if self.stage == STAGE_POINT && other.stage == STAGE_SPHERE {
            return polynomial_single(
                STAGE_SP,
                SP_COUNT,
                other.index * POINT_COUNT + self.index,
                self.negative ^ other.negative,
                self.valid && other.valid,
            )
        }
        if self.stage == STAGE_SP && other.stage == STAGE_SPHERE {
            return multiply_sp_sphere(self, other)
        }
        if self.stage == STAGE_SPHERE && other.stage == STAGE_SP {
            return multiply_sp_sphere(other, self)
        }
        coefficient_invalid()
    }

    const fn clifford_coefficient_neg(self) -> Self {
        if self.stage == STAGE_ZERO { return self }
        if self.stage == STAGE_SPHERE || self.stage == STAGE_POINT {
            return Canonical50Coefficient {
                stage: self.stage,
                index: self.index,
                negative: !self.negative,
                code: self.code,
                valid: self.valid,
            }
        }
        if self.stage == STAGE_SP || self.stage == STAGE_SSP {
            let count =
                if self.stage == STAGE_SP { SP_COUNT } else { SSP_COUNT }
            let negated = packed_neg(self.code, count)
            return Canonical50Coefficient {
                stage: self.stage,
                index: 0,
                negative: false,
                code: negated.code,
                valid: self.valid && negated.valid,
            }
        }
        coefficient_invalid()
    }
}

type SymbolicMv5 = CliffordMv<Canonical50Coefficient, 5>

const fn symbolic_zero_mvt5() -> SymbolicMv5 {
    let zero = coefficient_zero()
    let z0: CliffordMv<Canonical50Coefficient, 0> =
        sparse_clifford::CliffordScalar { scalar: zero }
    let z1: CliffordMv<Canonical50Coefficient, 1> =
        sparse_clifford::CliffordNode { low: z0, high: z0 }
    let z2: CliffordMv<Canonical50Coefficient, 2> =
        sparse_clifford::CliffordNode { low: z1, high: z1 }
    let z3: CliffordMv<Canonical50Coefficient, 3> =
        sparse_clifford::CliffordNode { low: z2, high: z2 }
    let z4: CliffordMv<Canonical50Coefficient, 4> =
        sparse_clifford::CliffordNode { low: z3, high: z3 }
    sparse_clifford::CliffordNode { low: z4, high: z4 }
}

const fn symbolic_sandwich() -> SymbolicMv5 {
    let sphere0 = symbolic_zero_mvt5()
    let sphere1 = sphere0.clifford_set_coefficient(
        index: SPHERE_E1, size: 32, value: sphere_seed(0),
    )
    let sphere2 = sphere1.clifford_set_coefficient(
        index: SPHERE_E2, size: 32, value: sphere_seed(1),
    )
    let sphere3 = sphere2.clifford_set_coefficient(
        index: SPHERE_E4, size: 32, value: sphere_seed(2),
    )
    let sphere = sphere3.clifford_set_coefficient(
        index: SPHERE_E5, size: 32, value: sphere_seed(3),
    )

    let point0 = symbolic_zero_mvt5()
    let point1 = point0.clifford_set_coefficient(
        index: POINT_E1, size: 32, value: point_seed(0),
    )
    let point2 = point1.clifford_set_coefficient(
        index: POINT_E2, size: 32, value: point_seed(1),
    )
    let point3 = point2.clifford_set_coefficient(
        index: POINT_E3, size: 32, value: point_seed(2),
    )
    let point4 = point3.clifford_set_coefficient(
        index: POINT_E4, size: 32, value: point_seed(3),
    )
    let point = point4.clifford_set_coefficient(
        index: POINT_E5, size: 32, value: point_seed(4),
    )

    let metric = Cl41Metric {}
    let first = sphere.clifford_gp(
        other: point, metric: metric, level: 5,
    )
    first.clifford_gp(other: sphere, metric: metric, level: 5)
}

/// Sphere operand support: index -> blade. Public because consumers (including
/// the recursive-Clifford fixture) need the mapping without duplicating the
/// operand's blade literals. The signature is deliberately index-based so it
/// survives the support becoming derived rather than declared.
pub const fn sphere_seed_blade_i32(_ index: i32) -> i32 {
    match index {
        0 => SPHERE_E1
        1 => SPHERE_E2
        2 => SPHERE_E4
        _ => SPHERE_E5
    }
}

/// Point operand support: index -> blade. Public for the same reason as
/// `sphere_seed_blade_i32`, with the same index-based signature.
pub const fn point_seed_blade_i32(_ index: i32) -> i32 {
    match index {
        0 => POINT_E1
        1 => POINT_E2
        2 => POINT_E3
        3 => POINT_E4
        _ => POINT_E5
    }
}

const fn sphere_pair_left_i32(_ rank: i32) -> i32 {
    match rank {
        0 => 0
        1 => 0
        2 => 0
        3 => 0
        4 => 1
        5 => 1
        6 => 1
        7 => 2
        8 => 2
        _ => 3
    }
}

const fn sphere_pair_right_i32(_ rank: i32) -> i32 {
    match rank {
        0 => 0
        1 => 1
        2 => 2
        3 => 3
        4 => 1
        5 => 2
        6 => 3
        7 => 2
        8 => 3
        _ => 3
    }
}

pub const fn candidate_output_blade_i32(_ candidate: i32) -> i32 {
    let pair =
        if candidate < 5 { 0 }
        else if candidate < 10 { 1 }
        else if candidate < 15 { 2 }
        else if candidate < 20 { 3 }
        else if candidate < 25 { 4 }
        else if candidate < 30 { 5 }
        else if candidate < 35 { 6 }
        else if candidate < 40 { 7 }
        else if candidate < 45 { 8 }
        else { 9 }
    let point =
        if candidate < 5 { candidate }
        else if candidate < 10 { candidate - 5 }
        else if candidate < 15 { candidate - 10 }
        else if candidate < 20 { candidate - 15 }
        else if candidate < 25 { candidate - 20 }
        else if candidate < 30 { candidate - 25 }
        else if candidate < 35 { candidate - 30 }
        else if candidate < 40 { candidate - 35 }
        else if candidate < 45 { candidate - 40 }
        else { candidate - 45 }
    sphere_seed_blade_i32(sphere_pair_left_i32(pair))
        ^ point_seed_blade_i32(point)
        ^ sphere_seed_blade_i32(sphere_pair_right_i32(pair))
}

const fn canonical50_result() -> Packed {
    let sandwich = symbolic_sandwich()
    let mut code = packed_zero(SSP_COUNT)
    let mut valid = true
    let mut blade: i32 = 0
    while blade < 32 {
        let coefficient: Canonical50Coefficient =
            sandwich.clifford_get_coefficient(
            index: blade, size: 32,
        )
        if coefficient.stage != STAGE_ZERO {
            valid = valid
                && coefficient.stage == STAGE_SSP
                && coefficient.valid
            let mut candidate: usize = 0
            while candidate < SSP_COUNT {
                let value = packed_coefficient(
                    coefficient.code, candidate,
                )
                if value != 0 {
                    let candidate_i32: i32 = candidate.downcast_unchecked()
                    let expected =
                        candidate_output_blade_i32(candidate_i32)
                    valid = valid && expected == blade
                    let updated = packed_add_at(code, candidate, value)
                    code = updated.code
                    valid = valid && updated.valid
                }
                candidate = candidate + 1
            }
        }
        blade = blade + 1
    }
    Packed { code: code, valid: valid }
}

const fn canonical50_count(_ code: Words) -> usize {
    let mut count: usize = 0
    let mut candidate: usize = 0
    while candidate < SSP_COUNT {
        if packed_coefficient(code, candidate) != 0 {
            count = count + 1
        }
        candidate = candidate + 1
    }
    count
}

const fn canonical50_max_abs(_ code: Words) -> i32 {
    let mut maximum: i32 = 0
    let mut candidate: usize = 0
    while candidate < SSP_COUNT {
        let value = packed_coefficient(code, candidate)
        let magnitude = if value < 0 { -value } else { value }
        if maximum < magnitude { maximum = magnitude }
        candidate = candidate + 1
    }
    maximum
}

const fn canonical50_keep_word(
    _ code: Words,
    _ first: usize,
    _ last: usize,
) -> u32 {
    let mut candidate = first
    let mut bits: u32 = 0
    while candidate < last {
        if packed_coefficient(code, candidate) != 0 {
            bits = bits
                | ((1 as u32) << (candidate - first).downcast_truncate())
        }
        candidate = candidate + 1
    }
    bits
}

const fn canonical50_magnitude_word(
    _ code: Words,
    _ first: usize,
    _ last: usize,
) -> u32 {
    let mut candidate = first
    let mut bits: u32 = 0
    while candidate < last {
        let value = packed_coefficient(code, candidate)
        let magnitude: u32 =
            (if value < 0 { -value } else { value }).downcast_unchecked()
        bits = bits
            | (magnitude << ((candidate - first) * 2).downcast_truncate())
        candidate = candidate + 1
    }
    bits
}

const fn canonical50_sign_word(
    _ code: Words,
    _ first: usize,
    _ last: usize,
) -> u32 {
    let mut candidate = first
    let mut bits: u32 = 0
    while candidate < last {
        if packed_coefficient(code, candidate) < 0 {
            bits = bits
                | ((1 as u32) << (candidate - first).downcast_truncate())
        }
        candidate = candidate + 1
    }
    bits
}

const fn canonical50_native() -> CanonicalNative {
    let result = canonical50_result()
    let code = result.code
    CanonicalNative {
        valid: result.valid,
        count: canonical50_count(code).downcast_unchecked(),
        maximum: canonical50_max_abs(code),
        keep0: canonical50_keep_word(code, 0, 24),
        keep1: canonical50_keep_word(code, 24, 48),
        keep2: canonical50_keep_word(code, 48, SSP_COUNT),
        mag0: canonical50_magnitude_word(code, 0, 16),
        mag1: canonical50_magnitude_word(code, 16, 32),
        mag2: canonical50_magnitude_word(code, 32, 48),
        mag3: canonical50_magnitude_word(code, 48, SSP_COUNT),
        sign0: canonical50_sign_word(code, 0, 32),
        sign1: canonical50_sign_word(code, 32, SSP_COUNT),
    }
}

const fn canonical50_projection(_ selector: u32) -> u64 {
    let native = canonical50_native()
    if selector == 0 {
        let keep0: u64 = native.keep0.downcast_unchecked()
        let keep1: u64 = native.keep1.downcast_unchecked()
        let keep2: u64 = native.keep2.downcast_unchecked()
        keep0 | (keep1 << 24) | (keep2 << 48)
            | ((if native.valid { 1 as u64 } else { 0 as u64 }) << 63)
    } else {
        let keep0: u64 = native.keep0.downcast_unchecked()
        let keep1: u64 = native.keep1.downcast_unchecked()
        let keep2: u64 = native.keep2.downcast_unchecked()
        let keep = keep0 | (keep1 << 24) | (keep2 << 48)
        let mag0: u64 = native.mag0.downcast_unchecked()
        let mag1: u64 = native.mag1.downcast_unchecked()
        let mag2: u64 = native.mag2.downcast_unchecked()
        let mag3: u64 = native.mag3.downcast_unchecked()
        let sign0: u64 = native.sign0.downcast_unchecked()
        let sign1: u64 = native.sign1.downcast_unchecked()
        let candidate_count: u64 = SSP_COUNT.downcast_unchecked()
        let point_count: u64 = POINT_COUNT.downcast_unchecked()
        let mut candidate: u64 = 0
        let mut valid = native.valid
        while candidate < candidate_count {
            if ((keep >> candidate) & 1) == 1 {
                let magnitude = if candidate < 16 {
                    (mag0 >> (candidate * 2)) & 3
                } else if candidate < 32 {
                    (mag1 >> ((candidate - 16) * 2)) & 3
                } else if candidate < 48 {
                    (mag2 >> ((candidate - 32) * 2)) & 3
                } else {
                    (mag3 >> ((candidate - 48) * 2)) & 3
                }
                let pair = candidate / point_count
                let expected = if pair == 0 || pair == 4
                    || pair == 7 || pair == 9 { 1 } else { 2 }
                valid = valid && magnitude == expected
            }
            candidate = candidate + 1
        }
        sign0 | (sign1 << 32)
            | ((if valid { 1 as u64 } else { 0 as u64 }) << 63)
    }
}

pub const CANONICAL50_KEEP_VALID: u64 = canonical50_projection(0)
pub const CANONICAL50_COEFFICIENTS: u64 = canonical50_projection(1)

pub const fn canonical50_projected_count() -> usize {
    let candidate_count: u64 = SSP_COUNT.downcast_unchecked()
    let mut count: usize = 0
    let mut candidate: u64 = 0
    while candidate < candidate_count {
        if ((CANONICAL50_KEEP_VALID >> candidate) & 1) == 1 {
            count = count + 1
        }
        candidate = candidate + 1
    }
    count
}

static_assert(((CANONICAL50_KEEP_VALID >> 63) & 1) == 1)
static_assert(((CANONICAL50_COEFFICIENTS >> 63) & 1) == 1)
static_assert(canonical50_projected_count() == 32)

pub type Canonical50Schedule32 = SparsePlan<
    {(CANONICAL50_KEEP_VALID & 0xffffff).downcast_unchecked()},
    {((CANONICAL50_KEEP_VALID >> 24) & 0xffffff).downcast_unchecked()},
    {((CANONICAL50_KEEP_VALID >> 48) & 3).downcast_unchecked()},
    0, 0, 0, 0, 0,
    {SSP_COUNT},
    {canonical50_projected_count()},
>

// END_CANONICAL50_PROVIDER_METADATA

pub const fn canonical50_projected_sign(_ candidate: u64) -> i32 {
    ((CANONICAL50_COEFFICIENTS >> candidate) & 1).downcast_truncate()
}

/// Canonical pair-major candidate metadata exposed only to compile-time
/// providers. The public recursive plan remains the authority for survivor
/// selection and sign; these helpers decode its candidate identity.
pub const fn canonical50_candidate_left_slot(_ candidate: usize) -> usize {
    let pair_i32: i32 = (candidate / POINT_COUNT).downcast_unchecked()
    sphere_pair_left_i32(pair_i32).downcast_unchecked()
}

pub const fn canonical50_candidate_right_slot(_ candidate: usize) -> usize {
    let pair_i32: i32 = (candidate / POINT_COUNT).downcast_unchecked()
    sphere_pair_right_i32(pair_i32).downcast_unchecked()
}

pub const fn canonical50_candidate_point_slot(_ candidate: usize) -> usize {
    candidate % POINT_COUNT
}

pub const fn canonical50_candidate_output(_ candidate: usize) -> usize {
    let candidate_i32: i32 = candidate.downcast_unchecked()
    candidate_output_blade_i32(candidate_i32).downcast_unchecked()
}

pub const fn canonical50_candidate_magnitude(_ candidate: usize) -> usize {
    let pair = candidate / POINT_COUNT
    if pair == 0 || pair == 4 || pair == 7 || pair == 9 { 1 } else { 2 }
}

pub const fn canonical50_candidate_negative(_ candidate: usize) -> usize {
    let candidate_u64: u64 = candidate.downcast_unchecked()
    canonical50_projected_sign(candidate_u64).downcast_unchecked()
}

pub const fn canonical50_order_hash() -> usize {
    let candidate_count: u64 = SSP_COUNT.downcast_unchecked()
    let mut candidate: u64 = 0
    let mut hash: u64 = 17
    while candidate < candidate_count {
        if ((CANONICAL50_KEEP_VALID >> candidate) & 1) == 1 {
            hash = (hash * 83 + candidate + 1) % 1000003
        }
        candidate = candidate + 1
    }
    hash.downcast_unchecked()
}

/// Fully enriched leaf of the canonical Cl(4,1) S*P*S specialization.
/// Candidate identity comes from the exact CTFE keep mask; every other field
/// is a typed projection of that candidate through this ingot's canonical
/// decomposition and recurrence-derived coefficient result.
pub struct Canonical50Term<
    const Candidate: i32,
    const Left: i32,
    const Point: i32,
    const Right: i32,
    const Output: i32,
    const Magnitude: i32,
    const Negative: i32,
> {}

pub const fn canonical50_candidate_at_rank(_ rank: usize) -> usize {
    plan_mask_candidate(
        (CANONICAL50_KEEP_VALID & 0xffffff).downcast_unchecked(),
        ((CANONICAL50_KEEP_VALID >> 24) & 0xffffff).downcast_unchecked(),
        ((CANONICAL50_KEEP_VALID >> 48) & 3).downcast_unchecked(),
        0, 0, 0, 0, 0,
        SSP_COUNT,
        rank,
    )
}

const fn canonical50_chunk_rank(_ offset: usize, _ index: usize) -> usize {
    offset + (7 - index)
}

const fn canonical50_chunk_candidate(_ offset: usize, _ remaining: usize) -> i32 {
    canonical50_candidate_at_rank(
        canonical50_chunk_rank(offset, remaining),
    ).downcast_truncate()
}

const fn canonical50_chunk_left(_ offset: usize, _ remaining: usize) -> i32 {
    canonical50_candidate_left_slot(canonical50_candidate_at_rank(
        canonical50_chunk_rank(offset, remaining),
    )).downcast_truncate()
}

const fn canonical50_chunk_point(_ offset: usize, _ remaining: usize) -> i32 {
    canonical50_candidate_point_slot(canonical50_candidate_at_rank(
        canonical50_chunk_rank(offset, remaining),
    )).downcast_truncate()
}

const fn canonical50_chunk_right(_ offset: usize, _ remaining: usize) -> i32 {
    canonical50_candidate_right_slot(canonical50_candidate_at_rank(
        canonical50_chunk_rank(offset, remaining),
    )).downcast_truncate()
}

const fn canonical50_chunk_output(_ offset: usize, _ remaining: usize) -> i32 {
    canonical50_candidate_output(canonical50_candidate_at_rank(
        canonical50_chunk_rank(offset, remaining),
    )).downcast_truncate()
}

const fn canonical50_chunk_magnitude(_ offset: usize, _ remaining: usize) -> i32 {
    canonical50_candidate_magnitude(canonical50_candidate_at_rank(
        canonical50_chunk_rank(offset, remaining),
    )).downcast_truncate()
}

const fn canonical50_chunk_negative(_ offset: usize, _ remaining: usize) -> i32 {
    canonical50_candidate_negative(canonical50_candidate_at_rank(
        canonical50_chunk_rank(offset, remaining),
    )).downcast_truncate()
}

const fn canonical50_chunk0_candidate(_ n: usize) -> i32 { canonical50_chunk_candidate(0, n) }
const fn canonical50_chunk0_left(_ n: usize) -> i32 { canonical50_chunk_left(0, n) }
const fn canonical50_chunk0_point(_ n: usize) -> i32 { canonical50_chunk_point(0, n) }
const fn canonical50_chunk0_right(_ n: usize) -> i32 { canonical50_chunk_right(0, n) }
const fn canonical50_chunk0_output(_ n: usize) -> i32 { canonical50_chunk_output(0, n) }
const fn canonical50_chunk0_magnitude(_ n: usize) -> i32 { canonical50_chunk_magnitude(0, n) }
const fn canonical50_chunk0_negative(_ n: usize) -> i32 { canonical50_chunk_negative(0, n) }

const fn canonical50_chunk8_candidate(_ n: usize) -> i32 { canonical50_chunk_candidate(8, n) }
const fn canonical50_chunk8_left(_ n: usize) -> i32 { canonical50_chunk_left(8, n) }
const fn canonical50_chunk8_point(_ n: usize) -> i32 { canonical50_chunk_point(8, n) }
const fn canonical50_chunk8_right(_ n: usize) -> i32 { canonical50_chunk_right(8, n) }
const fn canonical50_chunk8_output(_ n: usize) -> i32 { canonical50_chunk_output(8, n) }
const fn canonical50_chunk8_magnitude(_ n: usize) -> i32 { canonical50_chunk_magnitude(8, n) }
const fn canonical50_chunk8_negative(_ n: usize) -> i32 { canonical50_chunk_negative(8, n) }

const fn canonical50_chunk16_candidate(_ n: usize) -> i32 { canonical50_chunk_candidate(16, n) }
const fn canonical50_chunk16_left(_ n: usize) -> i32 { canonical50_chunk_left(16, n) }
const fn canonical50_chunk16_point(_ n: usize) -> i32 { canonical50_chunk_point(16, n) }
const fn canonical50_chunk16_right(_ n: usize) -> i32 { canonical50_chunk_right(16, n) }
const fn canonical50_chunk16_output(_ n: usize) -> i32 { canonical50_chunk_output(16, n) }
const fn canonical50_chunk16_magnitude(_ n: usize) -> i32 { canonical50_chunk_magnitude(16, n) }
const fn canonical50_chunk16_negative(_ n: usize) -> i32 { canonical50_chunk_negative(16, n) }

const fn canonical50_chunk24_candidate(_ n: usize) -> i32 { canonical50_chunk_candidate(24, n) }
const fn canonical50_chunk24_left(_ n: usize) -> i32 { canonical50_chunk_left(24, n) }
const fn canonical50_chunk24_point(_ n: usize) -> i32 { canonical50_chunk_point(24, n) }
const fn canonical50_chunk24_right(_ n: usize) -> i32 { canonical50_chunk_right(24, n) }
const fn canonical50_chunk24_output(_ n: usize) -> i32 { canonical50_chunk_output(24, n) }
const fn canonical50_chunk24_magnitude(_ n: usize) -> i32 { canonical50_chunk_magnitude(24, n) }
const fn canonical50_chunk24_negative(_ n: usize) -> i32 { canonical50_chunk_negative(24, n) }

/// Four fixed-offset partitions keep recursion within today's accepted
/// single-subject `N -> N - 1` form. Each payload is one direct staged call.
pub recursive type fn Canonical50TypedChunk0<const N: usize>() -> (*) {
    match N {
        0 => Zero
        _ => Add<
            Canonical50Term<
                {canonical50_chunk0_candidate(N - 1)},
                {canonical50_chunk0_left(N - 1)},
                {canonical50_chunk0_point(N - 1)},
                {canonical50_chunk0_right(N - 1)},
                {canonical50_chunk0_output(N - 1)},
                {canonical50_chunk0_magnitude(N - 1)},
                {canonical50_chunk0_negative(N - 1)},
            >,
            Canonical50TypedChunk0<{N - 1}>,
        >
    }
}

pub recursive type fn Canonical50TypedChunk8<const N: usize>() -> (*) {
    match N {
        0 => Zero
        _ => Add<
            Canonical50Term<
                {canonical50_chunk8_candidate(N - 1)},
                {canonical50_chunk8_left(N - 1)},
                {canonical50_chunk8_point(N - 1)},
                {canonical50_chunk8_right(N - 1)},
                {canonical50_chunk8_output(N - 1)},
                {canonical50_chunk8_magnitude(N - 1)},
                {canonical50_chunk8_negative(N - 1)},
            >,
            Canonical50TypedChunk8<{N - 1}>,
        >
    }
}

