        _ => Add<
            Canonical50Term<
                {canonical50_chunk16_candidate(N - 1)},
                {canonical50_chunk16_left(N - 1)},
                {canonical50_chunk16_point(N - 1)},
                {canonical50_chunk16_right(N - 1)},
