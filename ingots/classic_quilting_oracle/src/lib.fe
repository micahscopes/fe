    patch,
    permutation_parity,
    remap_barycentric,
}
use quilting_atlas::{
    AtlasKey,
    EdgePermutation,
    DIRECT_16_LANE_SCHEDULE,
    atlas_job,
    canonical_key_at,
    canonicalize,
}
use quilting_atlas::sampling::{
    FixedBarycentric,
    boundary_seed,
    candidate_cell_count,
    candidate_cell_at_slot,
    candidate_conflicts_boundary,
    candidate_conflict_cell_span,
    candidate_density_bucket,
    candidate_grid_side,
    candidate_is_round_winner,
    candidate_precedes,
    candidate_slot_count,
    candidate_state_after_round,
    density_exponent_q8,
