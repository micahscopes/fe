pub fn atlas_candidate_valid(
    _ patch: u32,
    _ seed: u32,
    _ cell_b: u32,
    _ cell_c: u32,
    _ trial: u32,
) -> u32 {
    if interior_candidate(
        canonical_key_at(patch as usize),
        patch,
        seed,
        cell_b,
        cell_c,
        trial,
    )
        .valid {
        1
    } else {
        0
    }
}

pub fn atlas_initial_candidate_state(_ valid: u32, _ boundary_conflict: u32) -> u32 {
    initial_candidate_state(valid != 0, boundary_conflict != 0)
}

pub fn atlas_candidate_precedes(
    _ left_priority: u32,
    _ left_slot: u32,
    _ right_priority: u32,
    _ right_slot: u32,
) -> u32 {
    if candidate_precedes(left_priority, left_slot, right_priority, right_slot) {
        1
    } else {
        0
    }
}

pub fn atlas_candidate_is_round_winner(
    _ state: u32,
    _ accepted_conflict: u32,
    _ preceding_pending_conflict: u32,
) -> u32 {
    if candidate_is_round_winner(
        state,
        accepted_conflict != 0,
        preceding_pending_conflict != 0,
    ) {
        1
    } else {
        0
    }
}

pub fn atlas_candidate_state_after_round(
    _ state: u32,
    _ accepted_conflict: u32,
    _ winner: u32,
    _ winner_conflict: u32,
) -> u32 {
    candidate_state_after_round(
        state,
        accepted_conflict != 0,
        winner != 0,
        winner_conflict != 0,
    )
}

pub fn atlas_candidate_density_bucket(_ patch: u32, _ a: u32, _ b: u32, _ c: u32) -> u32 {
    candidate_density_bucket(
        canonical_key_at(patch as usize),
        fixed_barycentric(a, b, c),
    )
}

pub fn atlas_candidate_conflict_cell_span(
    _ patch: u32,
    _ left_bucket: u32,
    _ right_bucket: u32,
) -> u32 {
    candidate_conflict_cell_span(
        canonical_key_at(patch as usize),
        left_bucket,
        right_bucket,
    )
}

pub fn atlas_orientation(
    _ first_b: u32,
    _ first_c: u32,
    _ second_b: u32,
    _ second_c: u32,
    _ third_b: u32,
    _ third_c: u32,
) -> i32 {
    orientation(
        fixed_plane_point(first_b, first_c),
        fixed_plane_point(second_b, second_c),
        fixed_plane_point(third_b, third_c),
    )
}

pub fn atlas_incircle_sign(
    _ first_b: u32,
    _ first_c: u32,
    _ second_b: u32,
    _ second_c: u32,
    _ third_b: u32,
    _ third_c: u32,
    _ query_b: u32,
    _ query_c: u32,
) -> i32 {
    incircle_sign(
        fixed_plane_point(first_b, first_c),
        fixed_plane_point(second_b, second_c),
        fixed_plane_point(third_b, third_c),
        fixed_plane_point(query_b, query_c),
    )
}

pub fn atlas_should_flip_edge(
    _ current_first: u32,
    _ current_second: u32,
    _ proposed_first: u32,
    _ proposed_second: u32,
    _ normalized_incircle_sign: i32,
) -> u32 {
    if should_flip_edge(
        current_first,
        current_second,
        proposed_first,
        proposed_second,
        normalized_incircle_sign,
    ) {
        1
    } else {
        0
    }
}

pub fn atlas_is_constrained_boundary_edge(
    _ a: u32,
    _ b: u32,
    _ c: u32,
    _ first: u32,
    _ second: u32,
) -> u32 {
    if is_constrained_boundary_edge(AtlasKey { a: a, b: b, c: c }, first, second) {
        1
    } else {
        0
    }
}

pub fn atlas_point_triangle_relation(
    _ first_b: u32,
    _ first_c: u32,
    _ second_b: u32,
    _ second_c: u32,
    _ third_b: u32,
    _ third_c: u32,
    _ query_b: u32,
    _ query_c: u32,
) -> u32 {
    classify_point_in_triangle(
        fixed_plane_point(first_b, first_c),
        fixed_plane_point(second_b, second_c),
        fixed_plane_point(third_b, third_c),
        fixed_plane_point(query_b, query_c),
    )
}

fn topology_triangle() -> Triangle {
    Triangle { first: 10, second: 20, third: 30, valid: true }
}

pub fn atlas_interior_split_vertex(
    _ first_b: u32,
    _ first_c: u32,
    _ second_b: u32,
    _ second_c: u32,
    _ third_b: u32,
    _ third_c: u32,
    _ point_b: u32,
    _ point_c: u32,
    _ lane: u32,
) -> u32 {
    let split = split_triangle_interior(
        topology_triangle(),
        fixed_plane_point(first_b, first_c),
        fixed_plane_point(second_b, second_c),
        fixed_plane_point(third_b, third_c),
        40,
        fixed_plane_point(point_b, point_c),
    )
    if !split.valid { return 0xffffffff }
    if lane == 0 { split.first.first }
    else if lane == 1 { split.first.second }
    else if lane == 2 { split.first.third }
    else if lane == 3 { split.second.first }
    else if lane == 4 { split.second.second }
    else if lane == 5 { split.second.third }
    else if lane == 6 { split.third.first }
    else if lane == 7 { split.third.second }
    else if lane == 8 { split.third.third }
    else { 0xffffffff }
}

pub fn atlas_edge_split_vertex(
    _ edge: u32,
    _ first_b: u32,
    _ first_c: u32,
    _ second_b: u32,
    _ second_c: u32,
    _ opposite_b: u32,
    _ opposite_c: u32,
    _ point_b: u32,
    _ point_c: u32,
    _ lane: u32,
) -> u32 {
    let split = split_triangle_edge(
        topology_triangle(),
        edge,
        fixed_plane_point(first_b, first_c),
        fixed_plane_point(second_b, second_c),
        fixed_plane_point(opposite_b, opposite_c),
        40,
        fixed_plane_point(point_b, point_c),
    )
    if !split.valid { return 0xffffffff }
    if lane == 0 { split.first.first }
    else if lane == 1 { split.first.second }
    else if lane == 2 { split.first.third }
    else if lane == 3 { split.second.first }
    else if lane == 4 { split.second.second }
    else if lane == 5 { split.second.third }
    else { 0xffffffff }
}

fn atlas_flip_decision(
    _ u_b: u32,
    _ u_c: u32,
    _ v_b: u32,
    _ v_c: u32,
    _ first_opposite_b: u32,
    _ first_opposite_c: u32,
    _ second_opposite_b: u32,
    _ second_opposite_c: u32,
) -> quilting_atlas::topology::FlipDecision {
    interior_edge_flip_decision(
        10,
        fixed_plane_point(u_b, u_c),
        20,
        fixed_plane_point(v_b, v_c),
        5,
        fixed_plane_point(first_opposite_b, first_opposite_c),
        30,
        fixed_plane_point(second_opposite_b, second_opposite_c),
    )
}

pub fn atlas_topology_flip_flags(
    _ u_b: u32,
    _ u_c: u32,
    _ v_b: u32,
    _ v_c: u32,
    _ first_opposite_b: u32,
    _ first_opposite_c: u32,
    _ second_opposite_b: u32,
    _ second_opposite_c: u32,
) -> u32 {
    let decision = atlas_flip_decision(
        u_b,
        u_c,
        v_b,
        v_c,
        first_opposite_b,
        first_opposite_c,
        second_opposite_b,
        second_opposite_c,
    )
    (if decision.convex { 1 } else { 0 }) + (if decision.flip { 2 } else { 0 })
}

pub fn atlas_flipped_vertex(
    _ u_b: u32,
    _ u_c: u32,
    _ v_b: u32,
    _ v_c: u32,
    _ first_opposite_b: u32,
    _ first_opposite_c: u32,
    _ second_opposite_b: u32,
    _ second_opposite_c: u32,
    _ lane: u32,
) -> u32 {
    let decision = atlas_flip_decision(
        u_b,
        u_c,
        v_b,
        v_c,
        first_opposite_b,
        first_opposite_c,
        second_opposite_b,
        second_opposite_c,
    )
    let flipped = flipped_triangle_pair(
        decision,
        10,
        fixed_plane_point(u_b, u_c),
        20,
        fixed_plane_point(v_b, v_c),
        5,
        fixed_plane_point(first_opposite_b, first_opposite_c),
        30,
        fixed_plane_point(second_opposite_b, second_opposite_c),
    )
    if !flipped.valid { return 0xffffffff }
    if lane == 0 { flipped.first.first }
    else if lane == 1 { flipped.first.second }
    else if lane == 2 { flipped.first.third }
    else if lane == 3 { flipped.second.first }
    else if lane == 4 { flipped.second.second }
    else if lane == 5 { flipped.second.third }
    else { 0xffffffff }
}

fn flip_proposal(
    _ first_triangle: u32,
    _ second_triangle: u32,
    _ edge_low: u32,
    _ edge_high: u32,
    _ active: u32,
) -> FlipProposal {
    FlipProposal {
        first_triangle: first_triangle,
        second_triangle: second_triangle,
        edge_low: edge_low,
        edge_high: edge_high,
        active: active != 0,
    }
}

pub fn atlas_flip_proposals_conflict(
    _ left_first_triangle: u32,
    _ left_second_triangle: u32,
    _ left_edge_low: u32,
    _ left_edge_high: u32,
    _ left_active: u32,
    _ right_first_triangle: u32,
    _ right_second_triangle: u32,
    _ right_edge_low: u32,
    _ right_edge_high: u32,
    _ right_active: u32,
) -> u32 {
    let left = flip_proposal(
        left_first_triangle,
        left_second_triangle,
        left_edge_low,
        left_edge_high,
        left_active,
    )
    let right = flip_proposal(
        right_first_triangle,
        right_second_triangle,
        right_edge_low,
        right_edge_high,
        right_active,
    )
    if flip_proposals_conflict(left, right) { 1 } else { 0 }
}

pub fn atlas_flip_proposal_precedes(
    _ left_first_triangle: u32,
    _ left_second_triangle: u32,
    _ left_edge_low: u32,
    _ left_edge_high: u32,
    _ right_first_triangle: u32,
    _ right_second_triangle: u32,
    _ right_edge_low: u32,
    _ right_edge_high: u32,
) -> u32 {
    let left = flip_proposal(
        left_first_triangle,
        left_second_triangle,
        left_edge_low,
        left_edge_high,
        1,
    )
    let right = flip_proposal(
        right_first_triangle,
        right_second_triangle,
        right_edge_low,
        right_edge_high,
        1,
    )
    if flip_proposal_precedes(left, right) { 1 } else { 0 }
}

pub fn atlas_flip_proposal_is_round_winner(
    _ active: u32,
    _ has_preceding_face_conflict: u32,
) -> u32 {
    let proposal = flip_proposal(0, 1, 2, 3, active)
    if flip_proposal_is_round_winner(proposal, has_preceding_face_conflict != 0) {
        1
    } else {
        0
    }
}

fn permutation_code(_ permutation: EdgePermutation) -> u32 {
    match permutation {
        EdgePermutation::ABC => 0,
        EdgePermutation::ACB => 1,
        EdgePermutation::BAC => 2,
        EdgePermutation::BCA => 3,
        EdgePermutation::CAB => 4,
        EdgePermutation::CBA => 5,
    }
}

pub fn atlas_canonical_a(_ a: u32, _ b: u32, _ c: u32) -> u32 {
    canonicalize(AtlasKey { a: a, b: b, c: c }).key.a
}

pub fn atlas_canonical_b(_ a: u32, _ b: u32, _ c: u32) -> u32 {
    canonicalize(AtlasKey { a: a, b: b, c: c }).key.b
}

pub fn atlas_canonical_c(_ a: u32, _ b: u32, _ c: u32) -> u32 {
    canonicalize(AtlasKey { a: a, b: b, c: c }).key.c
}

pub fn atlas_permutation(_ a: u32, _ b: u32, _ c: u32) -> u32 {
    permutation_code(canonicalize(AtlasKey { a: a, b: b, c: c }).permutation)
}

fn input_bary(_ a: f32, _ b: f32, _ c: f32) -> Bary3F {
    bary3f(a, b, c)
}

pub fn domain_cartesian_x(_ a: f32, _ b: f32, _ c: f32) -> f32 {
    bary_to_cartesian(input_bary(a, b, c)).x
}
pub fn domain_cartesian_y(_ a: f32, _ b: f32, _ c: f32) -> f32 {
    bary_to_cartesian(input_bary(a, b, c)).y
}
pub fn domain_bary_a(_ x: f32, _ y: f32) -> f32 {
    cartesian_to_bary(vec2f(x, y)).a
}
pub fn domain_bary_b(_ x: f32, _ y: f32) -> f32 {
    cartesian_to_bary(vec2f(x, y)).b
}
pub fn domain_bary_c(_ x: f32, _ y: f32) -> f32 {
    cartesian_to_bary(vec2f(x, y)).c
}
pub fn domain_contains(_ a: f32, _ b: f32, _ c: f32, _ tolerance: f32) -> i32 {
    if contains(input_bary(a, b, c), tolerance) {
        1
    } else {
        0
    }
}
pub fn domain_edge_parameter(_ edge: u32, _ a: f32, _ b: f32, _ c: f32) -> f32 {
    match edge {
        0 => edge_parameter(EdgeId::BC, input_bary(a, b, c)),
        1 => edge_parameter(EdgeId::CA, input_bary(a, b, c)),
        _ => edge_parameter(EdgeId::AB, input_bary(a, b, c)),
    }
}
pub fn domain_admit_a(_ a: f32, _ b: f32, _ c: f32, _ epsilon: f32) -> f32 {
    admit_barycentric(input_bary(a, b, c), epsilon).value.a
}
pub fn domain_admit_b(_ a: f32, _ b: f32, _ c: f32, _ epsilon: f32) -> f32 {
    admit_barycentric(input_bary(a, b, c), epsilon).value.b
}
pub fn domain_admit_c(_ a: f32, _ b: f32, _ c: f32, _ epsilon: f32) -> f32 {
    admit_barycentric(input_bary(a, b, c), epsilon).value.c
}
pub fn domain_admit_valid(_ a: f32, _ b: f32, _ c: f32, _ epsilon: f32) -> i32 {
    if admit_barycentric(input_bary(a, b, c), epsilon).valid {
        1
    } else {
        0
    }
}

fn left_quat(_ w: f32, _ x: f32, _ y: f32, _ z: f32) -> QuatF {
    quatf(w, x, y, z)
}
fn right_quat(_ w: f32, _ x: f32, _ y: f32, _ z: f32) -> QuatF {
    quatf(w, x, y, z)
}
fn product(
    _ aw: f32,
    _ ax: f32,
    _ ay: f32,
    _ az: f32,
    _ bw: f32,
    _ bx: f32,
    _ by: f32,
    _ bz: f32,
) -> QuatF {
    multiply(left_quat(aw, ax, ay, az), right_quat(bw, bx, by, bz))
}
pub fn quaternion_multiply_w(
    _ aw: f32,
    _ ax: f32,
    _ ay: f32,
    _ az: f32,
    _ bw: f32,
    _ bx: f32,
    _ by: f32,
    _ bz: f32,
) -> f32 {
    product(aw, ax, ay, az, bw, bx, by, bz).w
}
pub fn quaternion_multiply_x(
    _ aw: f32,
    _ ax: f32,
    _ ay: f32,
    _ az: f32,
    _ bw: f32,
    _ bx: f32,
    _ by: f32,
    _ bz: f32,
) -> f32 {
    product(aw, ax, ay, az, bw, bx, by, bz).x
}
pub fn quaternion_multiply_y(
    _ aw: f32,
    _ ax: f32,
    _ ay: f32,
    _ az: f32,
    _ bw: f32,
    _ bx: f32,
    _ by: f32,
    _ bz: f32,
) -> f32 {
    product(aw, ax, ay, az, bw, bx, by, bz).y
}
pub fn quaternion_multiply_z(
    _ aw: f32,
    _ ax: f32,
    _ ay: f32,
    _ az: f32,
    _ bw: f32,
    _ bx: f32,
    _ by: f32,
    _ bz: f32,
) -> f32 {
    product(aw, ax, ay, az, bw, bx, by, bz).z
}

fn bounded_inverse(
    _ w: f32,
    _ x: f32,
    _ y: f32,
    _ z: f32,
    _ minimum: f32,
) -> quilting_quaternion::QuatInverse {
    inverse_bounded(quatf(w, x, y, z), minimum)
}
pub fn quaternion_inverse_w(_ w: f32, _ x: f32, _ y: f32, _ z: f32, _ minimum: f32) -> f32 {
    bounded_inverse(w, x, y, z, minimum).value.w
}
pub fn quaternion_inverse_x(_ w: f32, _ x: f32, _ y: f32, _ z: f32, _ minimum: f32) -> f32 {
    bounded_inverse(w, x, y, z, minimum).value.x
}
pub fn quaternion_inverse_y(_ w: f32, _ x: f32, _ y: f32, _ z: f32, _ minimum: f32) -> f32 {
    bounded_inverse(w, x, y, z, minimum).value.y
}
pub fn quaternion_inverse_z(_ w: f32, _ x: f32, _ y: f32, _ z: f32, _ minimum: f32) -> f32 {
    bounded_inverse(w, x, y, z, minimum).value.z
}
pub fn quaternion_inverse_valid(_ w: f32, _ x: f32, _ y: f32, _ z: f32, _ minimum: f32) -> i32 {
    if bounded_inverse(w, x, y, z, minimum).valid {
        1
    } else {
        0
    }
}

fn curved_patch() -> QbTriPatch {
    patch(
        control(vec3f(-0.75, -0.25, 0.1), quatf(1.0, 0.2, -0.1, 0.05)),
        control(vec3f(0.8, -0.15, -0.2), quatf(0.9, -0.15, 0.25, 0.1)),
        control(vec3f(0.05, 0.9, 0.35), quatf(1.1, 0.1, 0.05, -0.2)),
    )
}

fn flat_patch() -> QbTriPatch {
    let identity = quatf(1.0, 0.0, 0.0, 0.0)
    patch(
        control(vec3f(0.0, 0.0, 0.0), identity),
        control(vec3f(1.0, 0.0, 0.0), identity),
        control(vec3f(0.0, 1.0, 0.0), identity),
    )
}

fn zero_weight_patch() -> QbTriPatch {
    let weight = zero()
    patch(
        control(vec3f(0.0, 0.0, 0.0), weight),
        control(vec3f(1.0, 0.0, 0.0), weight),
        control(vec3f(0.0, 1.0, 0.0), weight),
    )
}

fn curved(_ u: f32, _ v: f32) -> quilting_qb::QbDifferential {
    evaluate_uv_differential(
        curved_patch(),
        u,
        v,
        0.00000000000000000001,
        0.000000000001,
    )
}
fn flat(_ u: f32, _ v: f32) -> quilting_qb::QbDifferential {
    evaluate_uv_differential(flat_patch(), u, v, 0.00000000000000000001, 0.000000000001)
}

pub fn qb_position_x(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).sample.position.x
}
pub fn qb_position_y(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).sample.position.y
}
pub fn qb_position_z(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).sample.position.z
}
pub fn qb_tangent_u_x(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).tangent_u.x
}
pub fn qb_tangent_u_y(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).tangent_u.y
}
pub fn qb_tangent_u_z(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).tangent_u.z
}
pub fn qb_tangent_v_x(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).tangent_v.x
}
pub fn qb_tangent_v_y(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).tangent_v.y
}
pub fn qb_tangent_v_z(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).tangent_v.z
}
pub fn qb_normal_x(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).normal.x
}
pub fn qb_normal_y(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).normal.y
}
pub fn qb_normal_z(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).normal.z
}
pub fn qb_denominator_norm_squared(_ u: f32, _ v: f32) -> f32 {
    curved(u, v).sample.denominator_norm_squared
}
pub fn qb_flat_position_x(_ u: f32, _ v: f32) -> f32 {
    flat(u, v).sample.position.x
}
pub fn qb_flat_position_y(_ u: f32, _ v: f32) -> f32 {
    flat(u, v).sample.position.y
}
pub fn qb_flat_position_z(_ u: f32, _ v: f32) -> f32 {
    flat(u, v).sample.position.z
}
pub fn qb_flat_normal_z(_ u: f32, _ v: f32) -> f32 {
    flat(u, v).normal.z
}
pub fn qb_zero_weight_conditioned(_ u: f32, _ v: f32) -> i32 {
    let value = evaluate_uv_differential(
        zero_weight_patch(),
        u,
        v,
        0.00000000000000000001,
        0.000000000001,
    )
    if value.sample.conditioned { 1 } else { 0 }
}
pub fn qb_zero_weight_position_x(_ u: f32, _ v: f32) -> f32 {
    evaluate_uv_differential(
        zero_weight_patch(),
        u,
        v,
        0.00000000000000000001,
        0.000000000001,
    )
        .sample
        .position
        .x
}

pub fn qb_remap_a(_ permutation: u32, _ a: f32, _ b: f32, _ c: f32) -> f32 {
    remap_barycentric(permutation, bary3f(a, b, c)).a
}
pub fn qb_remap_b(_ permutation: u32, _ a: f32, _ b: f32, _ c: f32) -> f32 {
    remap_barycentric(permutation, bary3f(a, b, c)).b
}
pub fn qb_remap_c(_ permutation: u32, _ a: f32, _ b: f32, _ c: f32) -> f32 {
    remap_barycentric(permutation, bary3f(a, b, c)).c
}
pub fn qb_permutation_parity(_ permutation: u32) -> f32 {
    permutation_parity(permutation)
}
pub fn qb_permuted_normal_z(_ permutation: u32, _ u: f32, _ v: f32) -> f32 {
    apply_normal_parity(curved(u, v).normal, permutation).z
}
