//! Reusable Hades Grain parameter derivation.
//!
//! The seed is described by the field bit width, permutation width, and round
//! counts. Consumers supply the prime only to rejection sampling, so BN254
//! Poseidon and word-field Poseidon2 share one authored LFSR and
//! self-shrinking implementation without sharing either field arithmetic or
//! permutation policy.

use core::num::IntDowncast
use bitpack::self_shrink_9

pub use bitpack

pub struct Grain80 { state: u128, outputs: u32, available: u32 }
impl core::marker::Copy for Grain80 {}

/// GPU-portable view of the canonical 80-bit Grain state.
///
/// The three words hold bits 0..31, 32..63, and 64..79. Runtime generation
/// uses only u32 operations, while `warm_word` derives this initial state from
/// the canonical u128 CTFE construction above.
pub struct Grain80Word {
    low: u32,
    middle: u32,
    high: u32,
    outputs: u32,
    available: u32,
}
impl core::marker::Copy for Grain80Word {}

const fn append_seed_bits(_ seed: u128, _ value: u128, _ width: u32) -> u128 {
    (seed << (width as u128)) | value
}

const fn seed(
    _ field_size: u32,
    _ width: u32,
    _ full_rounds: u32,
    _ partial_rounds: u32,
) -> Grain80 {
    let mut packed: u128 = 0
    packed = append_seed_bits(packed, 1, 2)                       // prime field
    packed = append_seed_bits(packed, 0, 4)                       // x^alpha S-box
    packed = append_seed_bits(packed, field_size as u128, 12)
    packed = append_seed_bits(packed, width as u128, 12)
    packed = append_seed_bits(packed, full_rounds as u128, 10)
    packed = append_seed_bits(packed, partial_rounds as u128, 10)
    packed = append_seed_bits(packed, (1 << 30) - 1, 30)

    let mut state: u128 = 0
    let mut index: u32 = 0
    while index < 80 {
        let source = 79 - index
        let bit = (packed >> (source as u128)) & 1
        state = state | (bit << (index as u128))
        index = index + 1
    }
    Grain80 { state: state, outputs: 0, available: 0 }
}

/// Advance by at most 18 bits. The recurrence's nearest tap is position 62,
/// so all bits in the block depend only on the current 80-bit state.
const fn advance(_ source: Grain80, _ count: u32) -> Grain80 {
    let shift = count as u128
    let mask = (1 << shift) - 1
    let bits = ((source.state >> 62)
        ^ (source.state >> 51)
        ^ (source.state >> 38)
        ^ (source.state >> 23)
        ^ (source.state >> 13)
        ^ source.state) & mask
    let raw: u32 = bits.downcast_truncate()
    let admitted = self_shrink_9(raw)
    Grain80 {
        state: (source.state >> shift) | (bits << ((80 - count) as u128)),
        outputs: admitted.0,
        available: admitted.1,
    }
}

/// Construct and burn in the canonical 80-bit Grain state.
pub const fn warm(
    _ field_size: u32,
    _ width: u32,
    _ full_rounds: u32,
    _ partial_rounds: u32,
) -> Grain80 {
    let mut grain = seed(field_size, width, full_rounds, partial_rounds)
    let mut block: u32 = 0
    while block < 8 {
        grain = advance(grain, 18)
        block = block + 1
    }
    grain = advance(grain, 16)
    grain.outputs = 0
    grain.available = 0
    grain
}

/// Construct the canonical warmed state as three GPU-native words.
pub const fn warm_word(
    _ field_size: u32,
    _ width: u32,
    _ full_rounds: u32,
    _ partial_rounds: u32,
) -> Grain80Word {
    let grain = warm(field_size, width, full_rounds, partial_rounds)
    Grain80Word {
        low: grain.state.downcast_truncate(),
        middle: (grain.state >> 32).downcast_truncate(),
        high: (grain.state >> 64).downcast_truncate(),
        outputs: 0,
        available: 0,
    }
}

impl Grain80Word {
    /// Advance one canonical 18-bit LFSR block using only u32 operations.
    #[inline(always)]
    fn advance(mut self) {
        let low = self.low
        let middle = self.middle
        let high = self.high
        let mask: u32 = 262143
        let tap0 = low
        let tap13 = (low >> 13) | (middle << 19)
        let tap23 = (low >> 23) | (middle << 9)
        let tap38 = middle >> 6
        let tap51 = (middle >> 19) | (high << 13)
        let tap62 = (middle >> 30) | (high << 2)
        let bits = (tap62 ^ tap51 ^ tap38 ^ tap23 ^ tap13 ^ tap0) & mask
        let admitted = self_shrink_9(bits)
        self.low = (low >> 18) | (middle << 14)
        self.middle = (middle >> 18) | (high << 14) | (bits << 30)
        self.high = bits >> 2
        self.outputs = admitted.0
        self.available = admitted.1
    }

    /// Read one big-endian self-shrunk string with at most 31 bits.
    pub fn random_bits(mut self, _ count: u32) -> u32 {
        let mut value: u32 = 0
        let mut consumed: u32 = 0
        while consumed < count {
            if self.available == 0 {
                self.advance()
            }
            let remaining = count - consumed
            let take = if self.available < remaining { self.available } else { remaining }
            let after = self.available - take
            let mask = (1 << take) - 1
            let batch = (self.outputs >> after) & mask
            value = (value << take) | batch
            self.outputs = self.outputs & ((1 << after) - 1)
            self.available = after
            consumed = consumed + take
        }
        value
    }

    /// Sample a canonical element of a prime below 2^31.
    pub fn field_element(mut self, _ field_size: u32, _ modulus: u32) -> u32 {
        let mut value = modulus
        while value >= modulus {
            value = self.random_bits(field_size)
        }
        value
    }
}

/// Read one big-endian self-shrunk bit string.
pub const fn random_bits(_ source: Grain80, _ count: u32) -> (Grain80, u256) {
    let mut grain = source
    let mut value: u256 = 0
    let mut consumed: u32 = 0
    while consumed < count {
        if grain.available == 0 {
            grain = advance(grain, 18)
        }
        let remaining = count - consumed
        let take = if grain.available < remaining { grain.available } else { remaining }
        let after = grain.available - take
        let mask = (1 << take) - 1
        let batch = (grain.outputs >> after) & mask
        value = (value << (take as u256)) | (batch as u256)
        grain.outputs = grain.outputs & ((1 << after) - 1)
        grain.available = after
        consumed = consumed + take
    }
    (grain, value)
}

/// Sample a uniform canonical prime-field element by rejection.
pub const fn field_element(
    _ source: Grain80,
    _ field_size: u32,
    _ modulus: u256,
) -> (Grain80, u256) {
    let mut grain = source
    let mut value = modulus
    while value >= modulus {
        let next = random_bits(grain, field_size)
        grain = next.0
        value = next.1
    }
    (grain, value)
}
