//! Portable WebGPU placement for an exact type-derived additive scan.
//!
//! One invocation owns the same row in every independent batch. Repeated
//! dispatches interpret a `StageGrid` factor tree as Hillis-Steele distances,
//! alternating two caller-owned buffers so no dispatch reads storage that a
//! sibling invocation may still be writing. The queue boundary between
//! repeated dispatches is the only global synchronization primitive.
//!
//! This is a portable exactness baseline. Its `O(n log n)` work deliberately
//! keeps the semantic factor plan separate from physical placement so a later
//! work-efficient or workgroup-fused interpreter can preserve the same scan.

use parallel_ntt::{Radix2Stage, portable_stage}
pub use parallel_ntt::StageGrid
use precision::word_field::{WordField, WordPrime31}
use std::webgpu::{ComputeInvocation, StorageBuffer}

/// Canonical one-word additive monoid used by storage-resident scans.
///
/// The operation is associative in the represented field. A different
/// associative carrier may implement this interface without changing the
/// factor-tree schedule or the actor that owns dispatch boundaries.
pub trait StorageAdditiveMonoid {
    fn storage_word_valid(_ word: u32) -> bool
    fn add_storage_words(_ left: u32, _ right: u32) -> u32
}

impl<M: WordPrime31> StorageAdditiveMonoid for WordField<M> {
    fn storage_word_valid(_ word: u32) -> bool { word < M::modulus() }

    fn add_storage_words(_ left: u32, _ right: u32) -> u32 {
        (Self::from_u32(left) + Self::from_u32(right)).to_u32()
    }
}

pub struct AdditiveScanStep {
    pub active: bool,
    pub valid: bool,
    pub stage: Radix2Stage,
}
impl core::marker::Copy for AdditiveScanStep {}

pub struct AdditiveScanValue {
    pub valid: bool,
    pub value: u32,
}
impl core::marker::Copy for AdditiveScanValue {}

fn inactive_stage() -> Radix2Stage {
    Radix2Stage {
        index: 0,
        width: 0,
        half: 0,
        blocks: 0,
        butterflies: 0,
        valid: false,
    }
}

fn inactive_step() -> AdditiveScanStep {
    AdditiveScanStep {
        active: false,
        valid: true,
        stage: inactive_stage(),
    }
}

/// Advance every batch by one inclusive-scan stage for one logical row.
///
/// `primary` contains stage-zero input. Even stages read `primary` and write
/// `secondary`; odd stages reverse the direction. Therefore an even-depth
/// plan finishes in `primary`, while an odd-depth plan finishes in
/// `secondary`. One progress word per row proves that every batch advances in
/// the same queue-ordered stage.
pub fn advance_batched_additive_scan_row<
    const BATCHES: usize,
    const N: usize,
    const PRIMARY_WORDS: usize,
    const SECONDARY_WORDS: usize,
    const PROGRESS_WORDS: usize,
    F: StorageAdditiveMonoid,
    Plan: StageGrid,
>(
    _ primary: StorageBuffer<u32, PRIMARY_WORDS>,
    _ secondary: StorageBuffer<u32, SECONDARY_WORDS>,
    _ progress: StorageBuffer<u32, PROGRESS_WORDS>,
    _ invocation: ComputeInvocation,
) -> AdditiveScanStep
where
    BATCHES > 0,
    N > 1,
    { (N & (N - 1)) == 0 },
    { PRIMARY_WORDS >= BATCHES * N },
    { SECONDARY_WORDS >= BATCHES * N },
    { PROGRESS_WORDS >= N },
    { Plan::POINTS == N },
{
    let row = invocation.global.x
    if row >= N.downcast_truncate() { return inactive_step() }

    let cursor = progress.load(index: row)
    let stage = portable_stage<N, Plan>(cursor)
    if !stage.valid || cursor >= Plan::FACTORS.downcast_truncate() {
        return AdditiveScanStep { active: true, valid: false, stage: stage }
    }

    let read_primary = (cursor & 1) == 0
    let distance = stage.half
    let rows: u32 = N.downcast_truncate()
    let mut batch: u32 = 0
    let mut valid = true
    while batch < BATCHES.downcast_truncate() {
        let index = batch * rows + row
        let word = if read_primary {
            primary.load(index: index)
        } else {
            secondary.load(index: index)
        }
        valid = valid && F::storage_word_valid(word)
        let mut sum = word
        if row >= distance {
            let prior_index = index - distance
            let prior = if read_primary {
                primary.load(index: prior_index)
            } else {
                secondary.load(index: prior_index)
            }
            valid = valid && F::storage_word_valid(prior)
            sum = F::add_storage_words(prior, word)
        }
        if read_primary {
            secondary.store(index: index, value: sum)
        } else {
            primary.store(index: index, value: sum)
        }
        batch = batch + 1
    }
    if valid { progress.store(index: row, value: cursor + 1) }
    AdditiveScanStep { active: true, valid: valid, stage: stage }
}

/// Read one inclusive result after the exact factor depth has completed.
pub fn batched_additive_scan_value<
    const BATCHES: usize,
    const N: usize,
    const PRIMARY_WORDS: usize,
    const SECONDARY_WORDS: usize,
    const PROGRESS_WORDS: usize,
    F: StorageAdditiveMonoid,
    Plan: StageGrid,
>(
    _ primary: StorageBuffer<u32, PRIMARY_WORDS>,
    _ secondary: StorageBuffer<u32, SECONDARY_WORDS>,
    _ progress: StorageBuffer<u32, PROGRESS_WORDS>,
    _ batch: u32,
    _ row: u32,
) -> AdditiveScanValue
where
    BATCHES > 0,
    N > 1,
    { (N & (N - 1)) == 0 },
{
    if batch >= BATCHES.downcast_truncate()
        || row >= N.downcast_truncate()
        || PRIMARY_WORDS < BATCHES * N
        || SECONDARY_WORDS < BATCHES * N
        || PROGRESS_WORDS < N
        || Plan::POINTS != N
    {
        return AdditiveScanValue { valid: false, value: 0 }
    }
    let index = batch * N.downcast_truncate() + row
    let word = if (Plan::FACTORS & 1) == 0 {
        primary.load(index: index)
    } else {
        secondary.load(index: index)
    }
    AdditiveScanValue {
        valid: progress.load(index: row) == Plan::FACTORS.downcast_truncate()
            && F::storage_word_valid(word),
        value: word,
    }
}
