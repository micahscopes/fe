//! Parallel, immutable-generation classic Quilting topology oracle.

use quilting_atlas::{AtlasKey, boundary_vertices}
use quilting_atlas_webgpu::{
    advance_parallel_topology_generation,
    arbitrate_parallel_topology_point_lane,
    initialize_parallel_topology_lane,
    locate_parallel_topology_point_lane,
    parallel_topology_progress,
    plan_parallel_topology_face_lane,
    rebuild_parallel_topology_face_lane,
    retire_parallel_topology_point_lane,
    scan_parallel_topology_face_plan,
}
use std::webgpu::{
    ComputeInvocation,
    ComputeSurface as Kernel,
    CycledDispatch as Cycle,
    FixedDispatch as Once,
    GpuProgram as Program,
    StorageBuffer as Shared,
    WebGpuBackend,
    Workgroup as Threads,
}

const POINTS: usize = 286
const POINT_WORDS: usize = POINTS * 3
const TRIANGLES: usize = 556
const TRIANGLE_WORDS: usize = TRIANGLES * 4
const WORKSPACE_WORDS: usize = POINTS * 7 + TRIANGLES * 3 + 8
const THREADS: usize = 128
const WORKGROUPS: usize = 5
const INSERTION_ROUNDS: usize = 64

pub struct InsertionRound {}

fn key() -> AtlasKey {
    AtlasKey { a: 1, b: 2, c: 3 }
}

actor ClassicQuiltingParallelConstructionOracle uses (Program<WebGpuBackend>) {
    points: Shared<u32, POINT_WORDS>,
    source: Shared<u32, 2>,
    triangles_a: Shared<u32, TRIANGLE_WORDS>,
    triangles_b: Shared<u32, TRIANGLE_WORDS>,
    workspace: Shared<u32, WORKSPACE_WORDS>,
    receipt: Shared<u32, 8>,

    fn initialize(self, invocation: ComputeInvocation)
        uses (Kernel<Threads<THREADS, 1, 1>, Once<WORKGROUPS, 1, 1>>)
    {
        initialize_parallel_topology_lane<
            POINTS,
            POINT_WORDS,
            TRIANGLES,
            TRIANGLE_WORDS,
            WORKSPACE_WORDS,
        >(
            key(),
            self.source.load(index: 0) != 0,
            self.source.load(index: 1),
            self.points,
            self.triangles_a,
            self.triangles_b,
            self.workspace,
            invocation,
        )
    }

    fn locate(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        locate_parallel_topology_point_lane<
            POINTS,
            POINT_WORDS,
            TRIANGLES,
            TRIANGLE_WORDS,
            WORKSPACE_WORDS,
        >(
            self.points,
            self.triangles_a,
            self.triangles_b,
            self.workspace,
            invocation,
        )
    }

    fn arbitrate(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        arbitrate_parallel_topology_point_lane<POINTS, TRIANGLES, WORKSPACE_WORDS>(
            self.workspace,
            invocation,
        )
    }

    fn plan(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        plan_parallel_topology_face_lane<
            POINTS,
            POINT_WORDS,
            TRIANGLES,
            TRIANGLE_WORDS,
            WORKSPACE_WORDS,
        >(
            self.points,
            self.triangles_a,
            self.triangles_b,
            self.workspace,
            invocation,
        )
    }

    fn scan(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        scan_parallel_topology_face_plan<POINTS, TRIANGLES, WORKSPACE_WORDS>(
            self.workspace,
            invocation,
        )
    }

    fn rebuild(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        rebuild_parallel_topology_face_lane<
            POINTS,
            POINT_WORDS,
            TRIANGLES,
            TRIANGLE_WORDS,
            WORKSPACE_WORDS,
        >(
            self.points,
            self.triangles_a,
            self.triangles_b,
            self.workspace,
            invocation,
        )
    }

    fn retire(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        retire_parallel_topology_point_lane<POINTS, TRIANGLES, WORKSPACE_WORDS>(
            self.workspace,
            invocation,
        )
    }

    fn advance(self, invocation: ComputeInvocation)
        uses (
            Kernel<
                Threads<THREADS, 1, 1>,
                Cycle<InsertionRound, Once<WORKGROUPS, 1, 1>, INSERTION_ROUNDS>,
            >
        )
    {
        advance_parallel_topology_generation<POINTS, TRIANGLES, WORKSPACE_WORDS>(
            self.workspace,
            invocation,
        )
    }

    fn seal(self) uses (Kernel<Threads<1, 1, 1>, Once<1, 1, 1>>) {
        let source_valid = self.source.load(index: 0) != 0
        let resident = self.source.load(index: 1)
        let boundary = boundary_vertices(key())
        let triangle_count = parallel_topology_progress<POINTS, TRIANGLES, WORKSPACE_WORDS>(
            self.workspace,
            2,
        )
        let pending = parallel_topology_progress<POINTS, TRIANGLES, WORKSPACE_WORDS>(
            self.workspace,
            3,
        )
        let location_failures = parallel_topology_progress<
            POINTS,
            TRIANGLES,
            WORKSPACE_WORDS,
        >(self.workspace, 6)
        let invariant_failures = parallel_topology_progress<
            POINTS,
            TRIANGLES,
            WORKSPACE_WORDS,
        >(self.workspace, 7)
        let expected_triangles = if resident + resident > boundary + 2 {
            resident + resident - boundary - 2
        } else {
            0
        }
        let valid = source_valid
            && resident >= boundary
            && triangle_count == expected_triangles
            && pending == 0
            && location_failures == 0
            && invariant_failures == 0
        self.receipt.store(index: 0, value: if valid { 1 } else { 0 })
        self.receipt.store(index: 1, value: resident)
        self.receipt.store(index: 2, value: boundary)
        self.receipt.store(index: 3, value: triangle_count)
        self.receipt.store(index: 4, value: pending)
        self.receipt.store(index: 5, value: location_failures)
        self.receipt.store(index: 6, value: invariant_failures)
        self.receipt.store(
            index: 7,
            value: parallel_topology_progress<POINTS, TRIANGLES, WORKSPACE_WORDS>(
                self.workspace,
                0,
            ),
        )
    }
}
