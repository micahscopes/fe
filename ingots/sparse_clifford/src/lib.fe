// Package-like sparse Clifford prelude.
//
// This is a real Fe ingot with a public API. The current browser generators
// also prepend this canonical source to their self-contained published
// `kernel.fe` artifact; ordinary Fe applications can instead import the ingot.
// It deliberately owns only reusable representation and access semantics:
//   - fixed-capacity BladeSet support algebra for diagonal metrics;
//   - Zero/Term/Add sparse operator plans and their length witness;
//   - support-sized scalar storage with default-zero and present-only access.
//
// Domain code still owns its candidate enumeration, survivor ordering,
// coefficient provider, and operator evaluator. Metric FAMILIES are library
// vocabulary (`support_gp`'s diagonal model; `null_vector_pairing`'s conformal
// null-basis pairing below); the domain picks the instantiation.
//
// A support bit at position B denotes basis blade mask B.
//
// Five basis vectors / 32 blades fit an explicit portable u32. Operations fail
// closed above that bound. This is composed into domain fixtures by the Rust
// single-file harness as well as through the ingot API.
pub struct BladeSet { pub bits: u32, pub dimension: u32 }
impl Copy for BladeSet {}

pub const fn support_dimension_valid(_ dimension: u32) -> bool {
    dimension < 6
}

pub const fn support_capacity_mask(_ dimension: u32) -> u32 {
    match dimension {
        0 => 1
        1 => 3
        2 => 15
        3 => 255
        4 => 65535
        5 => 4294967295
        _ => 0
    }
}

pub const fn blade_set(_ bits: u32, _ dimension: u32) -> BladeSet {
    BladeSet {
        bits: bits & support_capacity_mask(dimension),
        dimension: dimension,
    }
}

pub const fn support_contains(_ support: BladeSet, _ blade: u32) -> bool {
    if !support_dimension_valid(support.dimension) { return false }
    if blade < (1 << support.dimension) {
    } else {
        return false
    }
    ((support.bits >> blade) & 1) == 1
}

pub const fn blade_grade(_ blade: u32) -> u32 {
    let mut value: u32 = blade
    let mut count: u32 = 0
    while 0 < value {
        count = count + (value & 1)
        value = value >> 1
    }
    count
}

pub const fn support_grade(_ support: BladeSet, _ grade: u32) -> BladeSet {
    if !support_dimension_valid(support.dimension) {
        return blade_set(0, support.dimension)
    }
    let blade_count: u32 = 1 << support.dimension
    let mut blade: u32 = 0
    let mut bits: u32 = 0
    while blade < blade_count {
        if ((support.bits >> blade) & 1) == 1 && blade_grade(blade) == grade {
            bits = bits | (1 << blade)
        }
        blade = blade + 1
    }
    blade_set(bits, support.dimension)
}

// Conservative geometric-product support in an orthogonal basis. A shared
// generator outside `nonzero_square_generators` annihilates the pair.
// Coefficient cancellation is intentionally a later normalization step.
pub const fn support_gp(
    _ left: BladeSet,
    _ right: BladeSet,
    _ nonzero_square_generators: u32,
) -> BladeSet {
    if left.dimension == right.dimension {
    } else {
        return blade_set(0, left.dimension)
    }
    if !support_dimension_valid(left.dimension) {
        return blade_set(0, left.dimension)
    }
    let blade_count: u32 = 1 << left.dimension
    let mut l: u32 = 0
    let mut output: u32 = 0
    while l < blade_count {
        if ((left.bits >> l) & 1) == 1 {
            let mut r: u32 = 0
            while r < blade_count {
                if ((right.bits >> r) & 1) == 1 {
                    let shared: u32 = l & r
                    if (shared & nonzero_square_generators) == shared {
                        output = output | (1 << (l ^ r))
                    }
                }
                r = r + 1
            }
        }
        l = l + 1
    }
    blade_set(output, left.dimension)
}

pub const fn support_cardinality(_ support: BladeSet) -> u32 {
    let mut value: u32 = support.bits
    let mut count: u32 = 0
    while 0 < value {
        count = count + (value & 1)
        value = value >> 1
    }
    count
}

// Finite sparse-operator plan vocabulary. A domain planner supplies its own
// CTFE candidate enumeration and constructs a ground
// Add<Term<Candidate>, ... Zero> tree.

pub struct Zero {}
pub struct Term<const Candidate: usize> {}
pub struct Add<L, R> {}

pub struct NatZ {}
pub struct NatS<N> {}

pub recursive type fn Nat<const N: usize>() -> (*) {
    match N {
        0 => NatZ
        _ => NatS<Nat<{N - 1}>>
    }
}

pub trait PlanLength { type Out }

impl PlanLength for Zero {
    type Out = NatZ
}

impl<const Candidate: usize, Tail: PlanLength> PlanLength
    for Add<Term<Candidate>, Tail>
{
    type Out = NatS<<Tail as PlanLength>::Out>
}

// Bounded candidate-set planner. A domain encodes its surviving candidate
// identities in eight 24-bit browser-profile u32 words, while this shared layer owns
// cardinality, canonical ascending selection, and materialization of the
// ground plan type. The 192-candidate ceiling is explicit; this is not an
// unbounded sparse operator compiler.

pub const fn plan_mask_contains(
    _ keep0: u32, _ keep1: u32, _ keep2: u32, _ keep3: u32,
    _ keep4: u32, _ keep5: u32, _ keep6: u32, _ keep7: u32,
    _ candidate: usize,
) -> bool {
    if candidate < 24 {
        ((keep0 >> candidate.downcast_truncate()) & 1) == 1
    } else if candidate < 48 {
        ((keep1 >> (candidate - 24).downcast_truncate()) & 1) == 1
    } else if candidate < 72 {
        ((keep2 >> (candidate - 48).downcast_truncate()) & 1) == 1
    } else if candidate < 96 {
        ((keep3 >> (candidate - 72).downcast_truncate()) & 1) == 1
    } else if candidate < 120 {
        ((keep4 >> (candidate - 96).downcast_truncate()) & 1) == 1
    } else if candidate < 144 {
        ((keep5 >> (candidate - 120).downcast_truncate()) & 1) == 1
    } else if candidate < 168 {
        ((keep6 >> (candidate - 144).downcast_truncate()) & 1) == 1
    } else if candidate < 192 {
        ((keep7 >> (candidate - 168).downcast_truncate()) & 1) == 1
    } else {
        false
    }
}

pub const fn plan_mask_cardinality(
    _ keep0: u32, _ keep1: u32, _ keep2: u32, _ keep3: u32,
    _ keep4: u32, _ keep5: u32, _ keep6: u32, _ keep7: u32,
    _ candidate_count: usize,
) -> usize {
    let mut candidate: usize = 0
    let mut count: usize = 0
    while candidate < candidate_count && candidate < 192 {
        if plan_mask_contains(
            keep0, keep1, keep2, keep3, keep4, keep5, keep6, keep7, candidate,
        ) {
            count = count + 1
        }
        candidate = candidate + 1
    }
    count
}

pub const fn plan_mask_candidate(
    _ keep0: u32, _ keep1: u32, _ keep2: u32, _ keep3: u32,
    _ keep4: u32, _ keep5: u32, _ keep6: u32, _ keep7: u32,
    _ candidate_count: usize,
    _ target: usize,
) -> usize {
    let mut candidate: usize = 0
    let mut seen: usize = 0
    while candidate < candidate_count && candidate < 192 {
        if plan_mask_contains(
            keep0, keep1, keep2, keep3, keep4, keep5, keep6, keep7, candidate,
        ) {
            if seen == target { return candidate }
            seen = seen + 1
        }
        candidate = candidate + 1
    }
    candidate_count
}

pub const fn plan_mask_candidate_ascending(
    _ keep0: u32, _ keep1: u32, _ keep2: u32, _ keep3: u32,
    _ keep4: u32, _ keep5: u32, _ keep6: u32, _ keep7: u32,
    _ candidate_count: usize,
    _ remaining: usize,
) -> usize {
    // SparsePlan's public invariant is `remaining <= cardinality(mask within
    // candidate_count)`; its canonical entry point uses equality. Subtracting
    // remaining therefore enumerates the retained candidates from low to high
    // while preserving the evaluator's `Add<Term, Tail>` cons shape.
    plan_mask_candidate(
        keep0, keep1, keep2, keep3, keep4, keep5, keep6, keep7,
        candidate_count,
        plan_mask_cardinality(
            keep0, keep1, keep2, keep3, keep4, keep5, keep6, keep7,
            candidate_count,
        ) - remaining,
    )
}

/// A candidate's LEFT operand slot under the row-major candidate numbering
/// `candidate = left * right_terms + right` shared by the mask planner above
/// and every plan-driven provider.
pub const fn plan_candidate_left(_ candidate: usize, _ right_terms: usize) -> usize {
    candidate / right_terms
}

/// A candidate's RIGHT operand slot under the same numbering.
pub const fn plan_candidate_right(_ candidate: usize, _ right_terms: usize) -> usize {
    candidate % right_terms
}

static_assert(plan_candidate_left(19, 5) == 3)
static_assert(plan_candidate_right(19, 5) == 4)
static_assert(plan_candidate_left(140, 12) == 11)
static_assert(plan_candidate_right(140, 12) == 8)

// ---------------------------------------------------------------------------
// Conformal null-basis metric pairing.
//
// The scalar pairing <l . r> between two grade-1 basis vectors of the standard
// conformal-style null basis
//     [e_1 .. e_E,  eo_1 .. eo_N,  ei_1 .. ei_N]
// with e_i . e_i = +1, eo_k . ei_k = ei_k . eo_k = -1, and everything else
// (including eo^2 and ei^2) zero. E = 3, N = 1 is classic CGA Cl(4,1);
// E = 3, N = 6 is QCGA R(9,6). This is the OFF-DIAGONAL metric family
// `support_gp`'s diagonal model (shared-generator annihilation) cannot state,
// which is why the QCGA fixtures used to carry a hand-written sign table.
//
// Encoding matches the plan-mask sign convention used by plan-driven
// providers: 0 = annihilated, 1 = +1, 2 = -1.
// ---------------------------------------------------------------------------

pub const fn null_vector_pairing(
    _ left: usize, _ right: usize, _ euclidean: usize, _ pairs: usize,
) -> usize {
    if left < euclidean {
        if left == right { 1 } else { 0 }
    } else if left < euclidean + pairs {
        // left is eo_k: pairs only with ei_k.
        if right == left + pairs { 2 } else { 0 }
    } else if left < euclidean + 2 * pairs {
        // left is ei_k: pairs only with eo_k.
        if right + pairs == left { 2 } else { 0 }
    } else {
        0
    }
}

// Cl(4,1): e1.e1 = +1, eo1.ei1 = ei1.eo1 = -1, eo1.eo1 = ei1.ei1 = 0.
static_assert(null_vector_pairing(0, 0, 3, 1) == 1)
static_assert(null_vector_pairing(0, 1, 3, 1) == 0)
static_assert(null_vector_pairing(3, 4, 3, 1) == 2)
static_assert(null_vector_pairing(4, 3, 3, 1) == 2)
static_assert(null_vector_pairing(3, 3, 3, 1) == 0)
static_assert(null_vector_pairing(4, 4, 3, 1) == 0)
// R(9,6): eo2(4) pairs with ei2(10) only; ei1(9) pairs with eo1(3) only.
static_assert(null_vector_pairing(4, 10, 3, 6) == 2)
static_assert(null_vector_pairing(4, 3, 3, 6) == 0)
static_assert(null_vector_pairing(9, 3, 3, 6) == 2)
static_assert(null_vector_pairing(15, 15, 3, 6) == 0)

// ---------------------------------------------------------------------------
// Outer (wedge) product reordering sign.
//
// The OUTER product keeps only DISJOINT-support blade pairs (no shared
// generator), so it never consults a squared generator: it is
// metric-INDEPENDENT. That makes it the same planning as `support_gp` with an
// empty `nonzero_square_generators` mask — `support_gp(l, r, 0)` keeps a pair
// iff `(l & r) == 0`, which is exactly the outer product's support. The only
// thing the geometric-product support layer does NOT carry is the coefficient
// SIGN; `blade_merge_sign` supplies it, in the same 0/1/2 convention as
// `null_vector_pairing` (0 = annihilated, 1 = +1, 2 = -1).
//
// For two orthogonal basis blades given as generator bitmasks, the outer
// product e_L ^ e_R = (-1)^inversions * e_(L | R), where `inversions` counts
// the pairs (i in L, j in R) with i > j: the transposition parity of merging
// two ascending generator lists into one. A shared generator (L & R != 0)
// annihilates the pair, since e_g ^ e_g = 0.
//
// This is the second pairing predicate the `SparsePlan` machinery admits with
// no compiler change: the regressive (join) product is the dual of the outer
// product, so a single planned kernel serves both meet and join.
pub const fn blade_merge_sign(_ left: u32, _ right: u32) -> usize {
    if (left & right) != 0 { return 0 }
    let mut inversions: u32 = 0
    let mut i: u32 = 0
    while i < 32 {
        if ((left >> i) & 1) == 1 {
            let mut j: u32 = 0
            while j < i {
                inversions = inversions + ((right >> j) & 1)
                j = j + 1
            }
        }
        i = i + 1
    }
    if (inversions & 1) == 0 { 1 } else { 2 }
}

// Grade-1 wedges over three generators {e0, e1, e2} (PGA 2D's vector space):
// e0^e1 = +e01, e1^e0 = -e01, e0^e2 = +e02, e2^e0 = -e02, e1^e2 = +e12,
// e2^e1 = -e12; a repeated generator annihilates.
static_assert(blade_merge_sign(1, 2) == 1)
static_assert(blade_merge_sign(2, 1) == 2)
static_assert(blade_merge_sign(1, 4) == 1)
static_assert(blade_merge_sign(4, 1) == 2)
static_assert(blade_merge_sign(2, 4) == 1)
static_assert(blade_merge_sign(4, 2) == 2)
static_assert(blade_merge_sign(2, 2) == 0)
// Higher-grade merges: e01 ^ e2 = +e012 (already sorted), e12 ^ e0 = +e012
// (two transpositions), e2 ^ e01 = +e012, and any shared generator kills it.
static_assert(blade_merge_sign(3, 4) == 1)
static_assert(blade_merge_sign(6, 1) == 1)
static_assert(blade_merge_sign(4, 3) == 1)
static_assert(blade_merge_sign(3, 6) == 0)

pub recursive type fn SparsePlan<
    const Keep0: u32, const Keep1: u32, const Keep2: u32, const Keep3: u32,
    const Keep4: u32, const Keep5: u32, const Keep6: u32, const Keep7: u32,
    const CandidateCount: usize,
    const N: usize,
>() -> (*) {
    match N {
        0 => Zero
        _ => Add<
            Term<{plan_mask_candidate_ascending(
                Keep0, Keep1, Keep2, Keep3, Keep4, Keep5, Keep6, Keep7,
                CandidateCount, N,
            )}>,
            SparsePlan<
                Keep0, Keep1, Keep2, Keep3, Keep4, Keep5, Keep6, Keep7,
                CandidateCount, {N - 1},
            >,
        >
    }
}

// Sparse runtime values selected from the 32 blades of Cl(p,q), p+q <= 5.
// Runtime storage contains exactly popcount(Support) scalars. A recursive
// rank-to-Here/Next type covers the whole bounded support. Missing coefficient
// reads specialize to zero; `sparse_present_coefficient` has no missing-blade
// implementation and therefore rejects absent access during type checking.

pub struct SparseNil {}
pub struct SparseCell<T> { pub head: f32, pub tail: T }
impl Copy for SparseNil {}
impl<T: Copy> Copy for SparseCell<T> {}

pub recursive type fn SparseStorage<const N: usize>() -> (*) {
    match N {
        0 => SparseNil
        _ => SparseCell<SparseStorage<{N - 1}>>
    }
}

pub const fn sparse_rank(_ support: usize, _ blade: usize) -> usize {
    let mut cursor: usize = 0
    let mut rank: usize = 0
    while cursor < blade && cursor < 32 {
        rank = rank + ((support >> cursor) & 1)
        cursor = cursor + 1
    }
    rank
}

pub const fn sparse_present(_ support: usize, _ blade: usize) -> usize {
    if blade < 32 {
        (support >> blade) & 1
    } else {
        0
    }
}

pub struct SparseMissing {}
pub struct SparseHere {}
pub struct SparseNext<I> {}
pub struct SparseSelect<const Present: usize, const Rank: usize> {}

pub recursive type fn SparseIndex<const Rank: usize>() -> (*) {
    match Rank {
        0 => SparseHere
        _ => SparseNext<SparseIndex<{Rank - 1}>>
    }
}

pub trait SparseSelectOut { type Out }
impl<const Rank: usize> SparseSelectOut for SparseSelect<0, Rank> {
    type Out = SparseMissing
}
impl<const Rank: usize> SparseSelectOut for SparseSelect<1, Rank> {
    type Out = SparseIndex<Rank>
}

pub trait SparseCoefficient<S> { fn read(value: S) -> f32 }
impl SparseCoefficient<SparseNil> for SparseMissing {
    fn read(value: SparseNil) -> f32 { 0.0 }
}
impl<T> SparseCoefficient<SparseCell<T>> for SparseMissing {
    fn read(value: SparseCell<T>) -> f32 { 0.0 }
}
impl<T> SparseCoefficient<SparseCell<T>> for SparseHere {
    fn read(value: SparseCell<T>) -> f32 { value.head }
}
impl<I, T> SparseCoefficient<SparseCell<T>> for SparseNext<I>
    where I: SparseCoefficient<T>
{
    fn read(value: SparseCell<T>) -> f32 {
        <I as SparseCoefficient<T>>::read(value: value.tail)
    }
}

// Deliberately lacks a SparseMissing implementation.
pub trait SparsePresentCoefficient<S> { fn read_present(value: S) -> f32 }
impl<T> SparsePresentCoefficient<SparseCell<T>> for SparseHere {
    fn read_present(value: SparseCell<T>) -> f32 { value.head }
}
impl<I, T> SparsePresentCoefficient<SparseCell<T>> for SparseNext<I>
    where I: SparsePresentCoefficient<T>
{
    fn read_present(value: SparseCell<T>) -> f32 {
        <I as SparsePresentCoefficient<T>>::read_present(value: value.tail)
    }
}

pub fn sparse_coefficient<I: SparseCoefficient<S>, S>(value: S) -> f32
{
    <I as SparseCoefficient<S>>::read(value: value)
}

pub fn sparse_present_coefficient<I: SparsePresentCoefficient<S>, S>(value: S) -> f32
{
    <I as SparsePresentCoefficient<S>>::read_present(value: value)
}

// Dense recursive semantic baseline for authored Clifford products.
//
// This is the Fuchs–Théry binary decomposition, represented directly as an Fe
// recursive type. SparsePlan remains the optimized execution representation;
// this recurrence is the independent authored algebra from which specialized
// plans can be checked.

pub struct CliffordScalar<C> { pub scalar: C }
pub struct CliffordNode<A> { pub low: A, pub high: A }
impl<C: Copy> Copy for CliffordScalar<C> {}
impl<A: Copy> Copy for CliffordNode<A> {}

pub recursive type fn CliffordMv<C, const N: usize>() -> (*) {
    match N {
        0 => CliffordScalar<C>
        _ => CliffordNode<CliffordMv<C, {N - 1}>>
    }
}

pub type CliffordScalarF32 = CliffordScalar<f32>
pub type CliffordNodeF32<A> = CliffordNode<A>
pub recursive type fn CliffordMvF32<const N: usize>() -> (*) {
    match N {
        0 => CliffordScalar<f32>
        _ => CliffordNode<CliffordMvF32<{N - 1}>>
    }
}

/// Coefficient algebra interpreted by the recursive Clifford construction.
///
/// `add` and `mul` supply the two semiring-like operations used by the
/// Fuchs–Théry decomposition; `neg` supplies its metric/involution sign.
/// Implementations used for exact values should preserve the usual additive
/// and multiplicative identities. Abstract interpretations may intentionally
/// weaken those laws, for example, CliffordSupport makes addition idempotent
/// and sign-insensitive in order to conservatively retain possible support.
pub trait CliffordCoefficient {
    const fn clifford_coefficient_add(self, other: Self) -> Self
    const fn clifford_coefficient_mul(self, other: Self) -> Self
    const fn clifford_coefficient_neg(self) -> Self
}
impl CliffordCoefficient for f32 {
    #[inline(always)]
    const fn clifford_coefficient_add(self, other: Self) -> Self {
        self + other
    }
    #[inline(always)]
    const fn clifford_coefficient_mul(self, other: Self) -> Self {
        self * other
    }
    #[inline(always)]
    const fn clifford_coefficient_neg(self) -> Self { -self }
}

/// A type-level policy for an orthogonal metric. `level` is the one-based
/// generator introduced by the current recursive node.
pub trait OrthogonalMetric {
    const fn square_is_negative(self, level: i32) -> bool
}

/// Cl(4,1), with the fifth recursive generator squaring to -1.
pub struct Cl41Metric {}
impl Copy for Cl41Metric {}
impl OrthogonalMetric for Cl41Metric {
    #[inline(always)]
    const fn square_is_negative(self, level: i32) -> bool {
        level == 5
    }
}

pub trait CliffordApplySign {
    const fn clifford_apply_sign(self, negative: bool) -> Self
}
impl<C: CliffordCoefficient + Copy> CliffordApplySign for CliffordScalar<C> {
    #[inline(always)]
    const fn clifford_apply_sign(self, negative: bool) -> Self {
        CliffordScalar {
            scalar: if negative {
                self.scalar.clifford_coefficient_neg()
            } else {
                self.scalar
            },
        }
    }
}
impl<A: CliffordApplySign> CliffordApplySign for CliffordNode<A> {
    #[inline(always)]
    const fn clifford_apply_sign(self, negative: bool) -> Self {
        CliffordNode {
            low: self.low.clifford_apply_sign(negative: negative),
            high: self.high.clifford_apply_sign(negative: negative),
        }
    }
}

pub trait CliffordInvolution {
    const fn clifford_involution(self) -> Self
}
impl<C> CliffordInvolution for CliffordScalar<C> {
    #[inline(always)]
    const fn clifford_involution(self) -> Self { self }
}
impl<A: CliffordInvolution + CliffordApplySign> CliffordInvolution
    for CliffordNode<A>
{
    #[inline(always)]
    const fn clifford_involution(self) -> Self {
        CliffordNode {
            low: self.low.clifford_involution(),
            high: self.high.clifford_involution()
                .clifford_apply_sign(negative: true),
        }
    }
}

pub trait CliffordAdd {
    const fn clifford_add(self, other: Self) -> Self
}
impl<C: CliffordCoefficient> CliffordAdd for CliffordScalar<C> {
    #[inline(always)]
    const fn clifford_add(self, other: Self) -> Self {
        CliffordScalar {
            scalar: self.scalar.clifford_coefficient_add(other: other.scalar),
        }
    }
}
impl<A: CliffordAdd> CliffordAdd for CliffordNode<A> {
    #[inline(always)]
    const fn clifford_add(self, other: Self) -> Self {
        CliffordNode {
            low: self.low.clifford_add(other: other.low),
            high: self.high.clifford_add(other: other.high),
        }
    }
}

/// Authored generic Clifford product. The carrier and metric are independent
/// type parameters; closing them at `CliffordMvF32<5>, Cl41Metric` specializes
/// the recurrence to Cl(4,1).
pub trait CliffordGp<M> {
    const fn clifford_gp(self, other: Self, metric: M, level: i32) -> Self
}
impl<C: CliffordCoefficient, M> CliffordGp<M> for CliffordScalar<C> {
    #[inline(always)]
    const fn clifford_gp(
        self,
        other: Self,
        metric: M,
        level: i32,
    ) -> Self {
        CliffordScalar {
            scalar: self.scalar.clifford_coefficient_mul(other: other.scalar),
        }
    }
}
impl<
    A: CliffordGp<M> + CliffordInvolution + CliffordAdd
        + CliffordApplySign + Copy,
    M: OrthogonalMetric + Copy,
> CliffordGp<M> for CliffordNode<A> {
    #[inline(always)]
    const fn clifford_gp(
        self,
        other: Self,
        metric: M,
        level: i32,
    ) -> Self {
        let aa = self.low.clifford_gp(
            other: other.low, metric: metric, level: level - 1,
        )
        let bhb = self.high.clifford_gp(
            other: other.high.clifford_involution(),
            metric: metric,
            level: level - 1,
        )
        let ab = self.low.clifford_gp(
            other: other.high, metric: metric, level: level - 1,
        )
        let bha = self.high.clifford_gp(
            other: other.low.clifford_involution(),
            metric: metric,
            level: level - 1,
        )
        CliffordNode {
            low: aa.clifford_add(other: bhb.clifford_apply_sign(
                negative: metric.square_is_negative(level: level),
            )),
            high: ab.clifford_add(other: bha),
        }
    }
}

// A conservative coefficient interpretation for the same authored recurrence.
// Multiplication intersects term presence, addition unions it, and sign changes
// cannot remove support. Consequently this deliberately does not model
// coefficient cancellation; callers may grade-project or normalize afterward.
pub struct CliffordSupport { pub present: bool }
impl Copy for CliffordSupport {}
impl CliffordCoefficient for CliffordSupport {
    const fn clifford_coefficient_add(self, other: Self) -> Self {
        CliffordSupport { present: self.present | other.present }
    }
    const fn clifford_coefficient_mul(self, other: Self) -> Self {
        CliffordSupport { present: self.present & other.present }
    }
    const fn clifford_coefficient_neg(self) -> Self { self }
}

pub type CliffordSupportMv<const N: usize> = CliffordMv<CliffordSupport, N>

/// Uniform coefficient access for every recursive Clifford carrier.
///
/// Domain-specific coefficient interpretations use this one traversal rather
/// than defining another scalar/node setter and getter pair.
pub trait CliffordCoefficientAccess<C> {
    const fn clifford_set_coefficient(
        self,
        index: i32,
        size: i32,
        value: C,
    ) -> Self
    const fn clifford_get_coefficient(
        self,
        index: i32,
        size: i32,
    ) -> C
}
impl<C: Copy> CliffordCoefficientAccess<C> for CliffordScalar<C> {
    #[inline(always)]
    const fn clifford_set_coefficient(
        self,
        index: i32,
        size: i32,
        value: C,
    ) -> Self {
        CliffordScalar { scalar: value }
    }
    #[inline(always)]
    const fn clifford_get_coefficient(
        self,
        index: i32,
        size: i32,
    ) -> C {
        self.scalar
    }
}
impl<C: Copy, A: CliffordCoefficientAccess<C> + Copy>
    CliffordCoefficientAccess<C> for CliffordNode<A>
{
    #[inline(always)]
    const fn clifford_set_coefficient(
        self,
        index: i32,
        size: i32,
        value: C,
    ) -> Self {
        let half: i32 = size >> 1
        if index < half {
            CliffordNode {
                low: self.low.clifford_set_coefficient(
                    index: index, size: half, value: value,
                ),
                high: self.high,
            }
        } else {
            CliffordNode {
                low: self.low,
                high: self.high.clifford_set_coefficient(
                    index: index - half, size: half, value: value,
                ),
            }
        }
    }
    #[inline(always)]
    const fn clifford_get_coefficient(
        self,
        index: i32,
        size: i32,
    ) -> C {
        let half: i32 = size >> 1
        if index < half {
            self.low.clifford_get_coefficient(index: index, size: half)
        } else {
            self.high.clifford_get_coefficient(
                index: index - half, size: half,
            )
        }
    }
}

// Compatibility names retained for the first public support API.
pub trait CliffordSetSupportLeaf {
    const fn clifford_set_support_leaf(
        self,
        index: i32,
        size: i32,
        value: CliffordSupport,
    ) -> Self
}
impl CliffordSetSupportLeaf for CliffordScalar<CliffordSupport> {
    #[inline(always)]
    const fn clifford_set_support_leaf(
        self,
        index: i32,
        size: i32,
        value: CliffordSupport,
    ) -> Self {
        self.clifford_set_coefficient(
            index: index, size: size, value: value,
        )
    }
}
impl<A: CliffordCoefficientAccess<CliffordSupport> + Copy>
    CliffordSetSupportLeaf for CliffordNode<A>
{
    #[inline(always)]
    const fn clifford_set_support_leaf(
        self,
        index: i32,
        size: i32,
        value: CliffordSupport,
    ) -> Self {
        self.clifford_set_coefficient(
            index: index, size: size, value: value,
        )
    }
}

pub trait CliffordGetSupportLeaf {
    const fn clifford_get_support_leaf(
        self,
        index: i32,
        size: i32,
    ) -> CliffordSupport
}
impl CliffordGetSupportLeaf for CliffordScalar<CliffordSupport> {
    #[inline(always)]
    const fn clifford_get_support_leaf(
        self,
        index: i32,
        size: i32,
    ) -> CliffordSupport {
        self.clifford_get_coefficient(index: index, size: size)
    }
}
impl<A: CliffordCoefficientAccess<CliffordSupport> + Copy>
    CliffordGetSupportLeaf for CliffordNode<A>
{
    #[inline(always)]
    const fn clifford_get_support_leaf(
        self,
        index: i32,
        size: i32,
    ) -> CliffordSupport {
        self.clifford_get_coefficient(index: index, size: size)
    }
}

pub const fn clifford_support_mvt5(_ bits: u32) -> CliffordSupportMv<5> {
    let absent = CliffordSupport { present: false }
    let z0: CliffordSupportMv<0> = CliffordScalar { scalar: absent }
    let z1: CliffordSupportMv<1> = CliffordNode { low: z0, high: z0 }
    let z2: CliffordSupportMv<2> = CliffordNode { low: z1, high: z1 }
    let z3: CliffordSupportMv<3> = CliffordNode { low: z2, high: z2 }
    let z4: CliffordSupportMv<4> = CliffordNode { low: z3, high: z3 }
    let mut value: CliffordSupportMv<5> = CliffordNode { low: z4, high: z4 }
    let mut blade: i32 = 0
    while blade < 32 {
        if ((bits >> blade.downcast_truncate()) & 1) == 1 {
            value = value.clifford_set_support_leaf(
                index: blade,
                size: 32,
                value: CliffordSupport { present: true },
            )
        }
        blade = blade + 1
    }
    value
}

pub const fn clifford_support_bits_mvt5(
    _ value: CliffordSupportMv<5>,
) -> u32 {
    let mut blade: i32 = 0
    let mut bits: u32 = 0
    while blade < 32 {
        if value.clifford_get_support_leaf(index: blade, size: 32).present {
            bits = bits | ((1 as u32) << blade.downcast_truncate())
        }
        blade = blade + 1
    }
    bits
}

pub trait CliffordSetLeaf {
    const fn clifford_set_leaf(
        self,
        index: i32,
        size: i32,
        value: f32,
    ) -> Self
}
impl CliffordSetLeaf for CliffordScalar<f32> {
    #[inline(always)]
    const fn clifford_set_leaf(
        self,
        index: i32,
        size: i32,
        value: f32,
    ) -> Self {
        self.clifford_set_coefficient(
            index: index, size: size, value: value,
        )
    }
}
impl<A: CliffordCoefficientAccess<f32> + Copy> CliffordSetLeaf
    for CliffordNode<A>
{
    #[inline(always)]
    const fn clifford_set_leaf(
        self,
        index: i32,
        size: i32,
        value: f32,
    ) -> Self {
        self.clifford_set_coefficient(
            index: index, size: size, value: value,
        )
    }
}

pub trait CliffordGetLeaf {
    const fn clifford_get_leaf(self, index: i32, size: i32) -> f32
}
impl CliffordGetLeaf for CliffordScalar<f32> {
    #[inline(always)]
    const fn clifford_get_leaf(self, index: i32, size: i32) -> f32 {
        self.clifford_get_coefficient(index: index, size: size)
    }
}
impl<A: CliffordCoefficientAccess<f32> + Copy> CliffordGetLeaf
    for CliffordNode<A>
{
    #[inline(always)]
    const fn clifford_get_leaf(self, index: i32, size: i32) -> f32 {
        self.clifford_get_coefficient(index: index, size: size)
    }
}

/// Closed zero constructor used by the first reusable Cl(4,1) consumer.
#[inline(always)]
pub fn clifford_zero_mvt5(_ zero: f32) -> CliffordMvF32<5> {
    let z0: CliffordMvF32<0> = CliffordScalar { scalar: zero }
    let z1: CliffordMvF32<1> = CliffordNode { low: z0, high: z0 }
    let z2: CliffordMvF32<2> = CliffordNode { low: z1, high: z1 }
    let z3: CliffordMvF32<3> = CliffordNode { low: z2, high: z2 }
    let z4: CliffordMvF32<4> = CliffordNode { low: z3, high: z3 }
    CliffordNode { low: z4, high: z4 }
}
