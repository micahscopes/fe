//! Field-generic Merkle proof shapes and placement-neutral traversals.
//!
//! This is the portable part of zk-kit.fe's `TwoToOneHasher` design. A nominal
//! hasher supplies zero, equality, and ordered two-to-one hashing; the semantic
//! tree algorithms contain no field, permutation, EVM, Wasm, or WebGPU
//! assumptions. Large traversals select physical storage through a typed
//! interpreter while retaining the same topology. The same little-endian path
//! convention is used throughout: bit zero of the index chooses the leaf side,
//! then successive bits choose successive levels.

use core::marker::Copy
use canonical_words::{
    CanonicalWordStream,
    WordSink,
    WordSource,
    canonical_prefix_word_count,
    decode_canonical_prefix,
    encode_canonical_prefix,
}

/// Pure ordered compression used by binary Merkle constructions.
pub trait TwoToOneHasher<F: Copy> {
    fn zero() -> F
    fn equal(_ left: F, _ right: F) -> bool
    fn hash2(_ left: F, _ right: F) -> F
}

/// One exact hash task in a canonical deduplicated multipath reduction.
/// `paired` selects another opened node at the same level; otherwise the
/// sibling comes from `sibling_position` in the canonical authentication
/// frontier. `direction` remains the low bit of `index`.
pub struct MerkleMultiPathTask {
    pub level: u32,
    pub index: u32,
    pub paired: bool,
    pub sibling_position: u32,
    pub direction: u32,
}
impl core::marker::Copy for MerkleMultiPathTask {}

pub struct MerkleMultiPathStep<I: core::marker::Copy, F: Copy> { pub interpreter: I, pub value: F }
impl<I: core::marker::Copy, F: Copy> core::marker::Copy for MerkleMultiPathStep<I, F> {}

/// Stateful interpretation of the fixed semantic multipath topology. Value,
/// trace, quadratic-relation, and GPU placements can consume these same
/// ordered tasks without reimplementing request normalization or sibling
/// consumption.
pub trait MerkleMultiPathInterpreter<F: Copy, H: TwoToOneHasher<F>>: core::marker::Copy {
    fn compress(self, _ task: MerkleMultiPathTask, _ child: F, _ sibling: F) -> MerkleMultiPathStep<
        Self,
        F,
    >
}

pub struct MerkleMultiPathValueInterpreter { marker: u32 }
impl core::marker::Copy for MerkleMultiPathValueInterpreter {}

impl MerkleMultiPathValueInterpreter {
    pub fn new() -> Self {
        Self { marker: 0 }
    }
}

impl<F: Copy, H: TwoToOneHasher<F>> MerkleMultiPathInterpreter<
    F,
    H,
> for MerkleMultiPathValueInterpreter {
    fn compress(self, _ task: MerkleMultiPathTask, _ child: F, _ sibling: F) -> MerkleMultiPathStep<
        Self,
        F,
    > {
        MerkleMultiPathStep {
            interpreter: self,
            value: if task.direction == 0 {
                H::hash2(child, sibling)
            } else {
                H::hash2(sibling, child)
            },
        }
    }
}

pub struct MerkleMultiPathInterpretation<I: core::marker::Copy, F: Copy> {
    pub interpreter: I,
    pub root: MerkleRoot<F>,
    pub hashes: u32,
    pub used_siblings: u32,
}
impl<I: core::marker::Copy, F: Copy> core::marker::Copy for MerkleMultiPathInterpretation<I, F> {}

pub struct MerkleRoot<F: Copy> { pub valid: bool, pub value: F }
impl<F: Copy> Copy for MerkleRoot<F> {}

pub struct MerkleFrontier<F: Copy, const LEVELS: usize> {
    pub valid: bool,
    pub count: u32,
    pub nodes: [F; LEVELS],
}
impl<F: Copy, const LEVELS: usize> Copy for MerkleFrontier<F, LEVELS> {}

pub struct MerklePairPath<F: Copy, const DEPTH: usize> {
    pub valid: bool,
    pub index: u32,
    pub positive_siblings: [F; DEPTH],
    pub negative_siblings: [F; DEPTH],
}
impl<F: Copy, const DEPTH: usize> Copy for MerklePairPath<F, DEPTH> {}

/// Compact authentication data for one common local position in each quarter
/// of a power-of-two tree.
pub struct MerkleQuartetPath<F: Copy, const DEPTH: usize> {
    pub valid: bool,
    pub index: u32,
    pub first_siblings: [F; DEPTH],
    pub second_siblings: [F; DEPTH],
    pub third_siblings: [F; DEPTH],
    pub fourth_siblings: [F; DEPTH],
}
impl<F: Copy, const DEPTH: usize> Copy for MerkleQuartetPath<F, DEPTH> {}

/// Canonical authentication frontier for a sorted set of distinct leaves.
/// Indices are encoded in ascending order. Siblings are encoded bottom-up and
/// left-to-right, but only when the sibling node is not already derivable from
/// another opened leaf. Fixed capacities keep the carrier backend-portable;
/// unused slots must remain canonical zeroes.
pub struct MerkleMultiPath<F: Copy, const MAX_LEAVES: usize, const MAX_SIBLINGS: usize> {
    pub valid: bool,
    pub leaf_count: u32,
    pub leaf_indices: [u32; MAX_LEAVES],
    pub sibling_count: u32,
    pub siblings: [F; MAX_SIBLINGS],
}
impl<F: Copy, const MAX_LEAVES: usize, const MAX_SIBLINGS: usize> Copy for MerkleMultiPath<
    F,
    MAX_LEAVES,
    MAX_SIBLINGS,
> {}

/// Variable canonical encoding for sparse authentication frontiers. Capacity
/// remains a compile-time storage fact; only the sorted leaves and siblings
/// identified by the two checked counts enter the receipt.
impl<
    F: Copy + CanonicalWordStream,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
> CanonicalWordStream for MerkleMultiPath<F, MAX_LEAVES, MAX_SIBLINGS> {
    fn word_count(ref self) -> u32 {
        if self.leaf_count > MAX_LEAVES.downcast_truncate()
            || self.sibling_count > MAX_SIBLINGS.downcast_truncate() {
            return 0
        }
        self.valid.word_count()
            + self.leaf_count.word_count()
            + canonical_prefix_word_count(ref self.leaf_indices, self.leaf_count)
            + self.sibling_count.word_count()
            + canonical_prefix_word_count(ref self.siblings, self.sibling_count)
    }

    fn encode_stream<W: WordSink>(ref self, _ writer: W) -> W {
        if self.leaf_count > MAX_LEAVES.downcast_truncate()
            || self.sibling_count > MAX_SIBLINGS.downcast_truncate() {
            return writer.reject()
        }
        let writer = self.valid.encode_stream(writer)
        let writer = self.leaf_count.encode_stream(writer)
        let writer = encode_canonical_prefix(ref self.leaf_indices, self.leaf_count, writer)
        let writer = self.sibling_count.encode_stream(writer)
        encode_canonical_prefix(ref self.siblings, self.sibling_count, writer)
    }

    fn decode_stream<R: WordSource>(mut self, _ reader: R) -> R {
        let reader = self.valid.decode_stream(reader)
        let reader = self.leaf_count.decode_stream(reader)
        if self.leaf_count > MAX_LEAVES.downcast_truncate() {
            self.valid = false
            return reader.reject()
        }
        let reader = decode_canonical_prefix(mut self.leaf_indices, self.leaf_count, reader)
        let reader = self.sibling_count.decode_stream(reader)
        if self.sibling_count > MAX_SIBLINGS.downcast_truncate() {
            self.valid = false
            return reader.reject()
        }
        decode_canonical_prefix(mut self.siblings, self.sibling_count, reader)
    }
}

fn invalid_root<F: Copy, H: TwoToOneHasher<F>>() -> MerkleRoot<F> {
    MerkleRoot { valid: false, value: H::zero() }
}

fn invalid_frontier<F: Copy, H: TwoToOneHasher<F>, const LEVELS: usize>() -> MerkleFrontier<
    F,
    LEVELS,
> {
    MerkleFrontier { valid: false, count: 0, nodes: [H::zero(); LEVELS] }
}

fn invalid_pair_path<F: Copy, H: TwoToOneHasher<F>, const DEPTH: usize>() -> MerklePairPath<
    F,
    DEPTH,
> {
    MerklePairPath {
        valid: false,
        index: 0,
        positive_siblings: [H::zero(); DEPTH],
        negative_siblings: [H::zero(); DEPTH],
    }
}

fn invalid_quartet_path<F: Copy, H: TwoToOneHasher<F>, const DEPTH: usize>() -> MerkleQuartetPath<
    F,
    DEPTH,
> {
    MerkleQuartetPath {
        valid: false,
        index: 0,
        first_siblings: [H::zero(); DEPTH],
        second_siblings: [H::zero(); DEPTH],
        third_siblings: [H::zero(); DEPTH],
        fourth_siblings: [H::zero(); DEPTH],
    }
}

fn invalid_multi_path<
    F: Copy,
    H: TwoToOneHasher<F>,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>() -> MerkleMultiPath<F, MAX_LEAVES, MAX_SIBLINGS> {
    MerkleMultiPath {
        valid: false,
        leaf_count: 0,
        leaf_indices: [0; MAX_LEAVES],
        sibling_count: 0,
        siblings: [H::zero(); MAX_SIBLINGS],
    }
}

/// Fold a conventional bottom-up sibling path.
pub fn binary_root<F: Copy, H: TwoToOneHasher<F>, const MAX_DEPTH: usize>(
    _ leaf: F,
    _ depth: usize,
    _ path_index: u32,
    _ siblings: own [F; MAX_DEPTH],
) -> MerkleRoot<F> {
    if depth > MAX_DEPTH || depth >= 32 {
        return invalid_root<F, H>()
    }
    let mut capacity: u32 = 1
    let mut shape_level: usize = 0
    while shape_level < depth {
        capacity = capacity + capacity
        shape_level = shape_level + 1
    }
    if path_index >= capacity {
        return invalid_root<F, H>()
    }

    let mut node = leaf
    let mut index = path_index
    let mut level: usize = 0
    while level < depth {
        let sibling = siblings[level]
        node = if (index & 1) == 0 {
            H::hash2(node, sibling)
        } else {
            H::hash2(sibling, node)
        }
        index = index / 2
        level = level + 1
    }
    MerkleRoot { valid: true, value: node }
}

pub fn binary_verify<F: Copy, H: TwoToOneHasher<F>, const MAX_DEPTH: usize>(
    _ expected: F,
    _ leaf: F,
    _ depth: usize,
    _ path_index: u32,
    _ siblings: own [F; MAX_DEPTH],
) -> bool {
    let opened = binary_root<F, H, MAX_DEPTH>(leaf, depth, path_index, siblings)
    opened.valid && H::equal(opened.value, expected)
}

/// Empty streaming state for a tree with at most `2^LEVELS` leaves.
pub fn empty_frontier<F: Copy, H: TwoToOneHasher<F>, const LEVELS: usize>() -> MerkleFrontier<
    F,
    LEVELS,
> {
    MerkleFrontier { valid: true, count: 0, nodes: [H::zero(); LEVELS] }
}

/// Push one leaf while retaining only the binary carry frontier.
pub fn push_frontier<F: Copy, H: TwoToOneHasher<F>, const LEVELS: usize>(
    _ frontier: own MerkleFrontier<F, LEVELS>,
    _ leaf: F,
) -> MerkleFrontier<F, LEVELS> {
    let mut frontier = frontier
    if !frontier.valid {
        return invalid_frontier<F, H, LEVELS>()
    }

    let mut carry = leaf
    let mut occupied = frontier.count
    let mut level: usize = 0
    while (occupied & 1) == 1 {
        if level >= LEVELS {
            return invalid_frontier<F, H, LEVELS>()
        }
        carry = H::hash2(frontier.nodes[level], carry)
        occupied = occupied >> 1
        level = level + 1
    }
    if level >= LEVELS {
        return invalid_frontier<F, H, LEVELS>()
    }
    frontier.nodes[level] = carry
    frontier.count = frontier.count + 1
    frontier
}

/// Accept only a nonempty, complete power-of-two tree.
pub fn complete_frontier_root<F: Copy, H: TwoToOneHasher<F>, const LEVELS: usize>(
    _ frontier: own MerkleFrontier<F, LEVELS>,
) -> MerkleRoot<F> {
    if !frontier.valid || frontier.count == 0 || (frontier.count & (frontier.count - 1)) != 0 {
        return invalid_root<F, H>()
    }
    let mut count = frontier.count
    let mut level: usize = 0
    while count > 1 {
        count = count >> 1
        level = level + 1
    }
    if level >= LEVELS {
        return invalid_root<F, H>()
    }
    MerkleRoot { valid: true, value: frontier.nodes[level] }
}

/// Construct compact authentication data for leaves at `index` and
/// `index + N / 2`.
pub fn pair_path_from_leaves<
    F: Copy,
    H: TwoToOneHasher<F>,
    const N: usize,
    const HALF: usize,
    const DEPTH: usize,
>(_ leaves: own [F; N], _ index: u32) -> MerklePairPath<F, DEPTH>
where N > 1, HALF > 0, { HALF + HALF == N }
{
    let mut expected_half: usize = 1
    let mut level: usize = 0
    while level < DEPTH {
        expected_half = expected_half + expected_half
        level = level + 1
    }
    let half_u32: u32 = HALF.downcast_truncate()
    if expected_half != HALF || index >= half_u32 {
        return invalid_pair_path<F, H, DEPTH>()
    }

    let mut nodes = leaves
    let mut positive: usize = index as usize
    let mut negative: usize = positive + HALF
    let mut width: usize = N
    let mut positive_siblings = [H::zero(); DEPTH]
    let mut negative_siblings = [H::zero(); DEPTH]
    level = 0
    while level < DEPTH {
        positive_siblings[level] = nodes[positive ^ 1]
        negative_siblings[level] = nodes[negative ^ 1]

        let parent_count = width / 2
        let mut parent: usize = 0
        while parent < parent_count {
            nodes[parent] = H::hash2(nodes[parent + parent], nodes[parent + parent + 1])
            parent = parent + 1
        }
        positive = positive / 2
        negative = negative / 2
        width = parent_count
        level = level + 1
    }
    MerklePairPath {
        valid: width == 2,
        index: index,
        positive_siblings: positive_siblings,
        negative_siblings: negative_siblings,
    }
}

pub fn pair_root<F: Copy, H: TwoToOneHasher<F>, const DEPTH: usize>(
    _ positive_leaf: F,
    _ negative_leaf: F,
    _ path: own MerklePairPath<F, DEPTH>,
) -> MerkleRoot<F> {
    if !path.valid {
        return invalid_root<F, H>()
    }
    let mut half: u32 = 1
    let mut shape_level: usize = 0
    while shape_level < DEPTH {
        half = half + half
        shape_level = shape_level + 1
    }
    if path.index >= half {
        return invalid_root<F, H>()
    }

    let mut positive = positive_leaf
    let mut negative = negative_leaf
    let mut index = path.index
    let mut level: usize = 0
    while level < DEPTH {
        if (index & 1) == 0 {
            positive = H::hash2(positive, path.positive_siblings[level])
            negative = H::hash2(negative, path.negative_siblings[level])
        } else {
            positive = H::hash2(path.positive_siblings[level], positive)
            negative = H::hash2(path.negative_siblings[level], negative)
        }
        index = index / 2
        level = level + 1
    }
    MerkleRoot { valid: true, value: H::hash2(positive, negative) }
}

pub fn pair_verify<F: Copy, H: TwoToOneHasher<F>, const DEPTH: usize>(
    _ expected: F,
    _ positive_leaf: F,
    _ negative_leaf: F,
    _ path: own MerklePairPath<F, DEPTH>,
) -> bool {
    let opened = pair_root<F, H, DEPTH>(positive_leaf, negative_leaf, path)
    opened.valid && H::equal(opened.value, expected)
}

/// Build one compact four-quarter opening.
pub fn quartet_path_from_leaves<
    F: Copy,
    H: TwoToOneHasher<F>,
    const N: usize,
    const QUARTER: usize,
    const DEPTH: usize,
>(_ leaves: own [F; N], _ index: u32) -> MerkleQuartetPath<F, DEPTH>
where N > 3, QUARTER > 0, { QUARTER + QUARTER + QUARTER + QUARTER == N }
{
    let mut expected_quarter: usize = 1
    let mut level: usize = 0
    while level < DEPTH {
        expected_quarter = expected_quarter + expected_quarter
        level = level + 1
    }
    let quarter_u32: u32 = QUARTER.downcast_truncate()
    if expected_quarter != QUARTER || index >= quarter_u32 {
        return invalid_quartet_path<F, H, DEPTH>()
    }

    let mut nodes = leaves
    let mut first: usize = index as usize
    let mut second: usize = first + QUARTER
    let mut third: usize = second + QUARTER
    let mut fourth: usize = third + QUARTER
    let mut width: usize = N
    let mut first_siblings = [H::zero(); DEPTH]
    let mut second_siblings = [H::zero(); DEPTH]
    let mut third_siblings = [H::zero(); DEPTH]
    let mut fourth_siblings = [H::zero(); DEPTH]
    level = 0
    while level < DEPTH {
        first_siblings[level] = nodes[first ^ 1]
        second_siblings[level] = nodes[second ^ 1]
        third_siblings[level] = nodes[third ^ 1]
        fourth_siblings[level] = nodes[fourth ^ 1]

        let parent_count = width / 2
        let mut parent: usize = 0
        while parent < parent_count {
            nodes[parent] = H::hash2(nodes[parent + parent], nodes[parent + parent + 1])
            parent = parent + 1
        }
        first = first / 2
        second = second / 2
        third = third / 2
        fourth = fourth / 2
        width = parent_count
        level = level + 1
    }
    MerkleQuartetPath {
        valid: width == 4,
        index: index,
        first_siblings: first_siblings,
        second_siblings: second_siblings,
        third_siblings: third_siblings,
        fourth_siblings: fourth_siblings,
    }
}

pub fn quartet_root<F: Copy, H: TwoToOneHasher<F>, const DEPTH: usize>(
    _ first_leaf: F,
    _ second_leaf: F,
    _ third_leaf: F,
    _ fourth_leaf: F,
    _ path: own MerkleQuartetPath<F, DEPTH>,
) -> MerkleRoot<F> {
    if !path.valid {
        return invalid_root<F, H>()
    }
    let mut quarter: u32 = 1
    let mut shape_level: usize = 0
    while shape_level < DEPTH {
        quarter = quarter + quarter
        shape_level = shape_level + 1
    }
    if path.index >= quarter {
        return invalid_root<F, H>()
    }

    let mut first = first_leaf
    let mut second = second_leaf
    let mut third = third_leaf
    let mut fourth = fourth_leaf
    let mut index = path.index
    let mut level: usize = 0
    while level < DEPTH {
        if (index & 1) == 0 {
            first = H::hash2(first, path.first_siblings[level])
            second = H::hash2(second, path.second_siblings[level])
            third = H::hash2(third, path.third_siblings[level])
            fourth = H::hash2(fourth, path.fourth_siblings[level])
        } else {
            first = H::hash2(path.first_siblings[level], first)
            second = H::hash2(path.second_siblings[level], second)
            third = H::hash2(path.third_siblings[level], third)
            fourth = H::hash2(path.fourth_siblings[level], fourth)
        }
        index = index / 2
        level = level + 1
    }
    let left = H::hash2(first, second)
    let right = H::hash2(third, fourth)
    MerkleRoot { valid: true, value: H::hash2(left, right) }
}

pub fn quartet_verify<F: Copy, H: TwoToOneHasher<F>, const DEPTH: usize>(
    _ expected: F,
    _ first_leaf: F,
    _ second_leaf: F,
    _ third_leaf: F,
    _ fourth_leaf: F,
    _ path: own MerkleQuartetPath<F, DEPTH>,
) -> bool {
    let opened = quartet_root<F, H, DEPTH>(first_leaf, second_leaf, third_leaf, fourth_leaf, path)
    opened.valid && H::equal(opened.value, expected)
}

/// Base case for a two-leaf tree.
pub fn pair_path_two<F: Copy, H: TwoToOneHasher<F>>(_ index: u32) -> MerklePairPath<F, 0> {
    MerklePairPath {
        valid: index == 0,
        index: index,
        positive_siblings: [H::zero(); 0],
        negative_siblings: [H::zero(); 0],
    }
}

pub fn pair_verify_two<F: Copy, H: TwoToOneHasher<F>>(
    _ expected: F,
    _ positive_leaf: F,
    _ negative_leaf: F,
    _ path: own MerklePairPath<F, 0>,
) -> bool {
    path.valid && path.index == 0 && H::equal(H::hash2(positive_leaf, negative_leaf), expected)
}

/// Build a complete root and canonical sparse multipath in one tree
/// traversal. Duplicate and unsorted requests are normalized into one
/// ascending leaf set. Caller-owned outputs avoid an aggregate return at the
/// Wasm and GPU boundary.
pub fn write_multi_path_and_root_from_leaves<
    F: Copy,
    H: TwoToOneHasher<F>,
    const N: usize,
    const REQUESTS: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ leaves: ref [F; N],
    _ requested: ref [u32; REQUESTS],
    _ path: mut MerkleMultiPath<F, MAX_LEAVES, MAX_SIBLINGS>,
    _ root: mut MerkleRoot<F>,
) -> bool
where N > 1, N <= 2147483648, { (N & (N - 1)) == 0 }, REQUESTS > 0, MAX_LEAVES > 0
{
    path = invalid_multi_path<F, H, MAX_LEAVES, MAX_SIBLINGS>()
    root = invalid_root<F, H>()
    let width_u32: u32 = N.downcast_truncate()
    let mut indices = [0; MAX_LEAVES]
    let mut count: usize = 0
    let mut request: usize = 0
    while request < REQUESTS {
        let index = requested[request]
        if index >= width_u32 {
            return false
        }

        let mut position: usize = 0
        while position < count && indices[position] < index {
            position = position + 1
        }
        if position == count || indices[position] != index {
            if count >= MAX_LEAVES {
                return false
            }
            let mut cursor = count
            while cursor > position {
                indices[cursor] = indices[cursor - 1]
                cursor = cursor - 1
            }
            indices[position] = index
            count = count + 1
        }
        request = request + 1
    }
    if count == 0 { return false }

    let leaf_indices = indices
    let mut nodes = [H::zero(); N]
    let mut leaf_index: usize = 0
    while leaf_index < N {
        nodes[leaf_index] = leaves[leaf_index]
        leaf_index = leaf_index + 1
    }
    let mut siblings = [H::zero(); MAX_SIBLINGS]
    let mut sibling_count: usize = 0
    let mut active_count = count
    let mut width: usize = N
    while width > 1 {
        let mut next_indices = [0; MAX_LEAVES]
        let mut next_count: usize = 0
        let mut cursor: usize = 0
        while cursor < active_count {
            let index = indices[cursor]
            let paired = (index & 1) == 0
                && cursor + 1 < active_count
                && indices[cursor + 1] == index + 1
            if paired {
                cursor = cursor + 2
            } else {
                if sibling_count >= MAX_SIBLINGS {
                    return false
                }
                siblings[sibling_count] = nodes[(index ^ 1) as usize]
                sibling_count = sibling_count + 1
                cursor = cursor + 1
            }
            next_indices[next_count] = index / 2
            next_count = next_count + 1
        }

        let parent_count = width / 2
        let mut parent: usize = 0
        while parent < parent_count {
            nodes[parent] = H::hash2(nodes[parent + parent], nodes[parent + parent + 1])
            parent = parent + 1
        }
        indices = next_indices
        active_count = next_count
        width = parent_count
    }
    if active_count != 1 || indices[0] != 0 {
        return false
    }

    path = MerkleMultiPath {
        valid: true,
        leaf_count: count.downcast_truncate(),
        leaf_indices: leaf_indices,
        sibling_count: sibling_count.downcast_truncate(),
        siblings: siblings,
    }
    root = MerkleRoot { valid: true, value: nodes[0] }
    true
}

/// Require a canonical multipath to open exactly the normalized requested
/// leaf set. Request order and duplicates are irrelevant, but omitted or
/// extra authenticated leaves are rejected.
pub fn multi_path_matches_requests<
    F: Copy,
    const N: usize,
    const REQUESTS: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ path: ref MerkleMultiPath<F, MAX_LEAVES, MAX_SIBLINGS>,
    _ requested: ref [u32; REQUESTS],
) -> bool
where N > 0, N <= 2147483648, REQUESTS > 0, MAX_LEAVES > 0
{
    if !path.valid || path.leaf_count == 0 || path.leaf_count > MAX_LEAVES.downcast_truncate() {
        return false
    }
    let width: u32 = N.downcast_truncate()
    let mut expected = [0; MAX_LEAVES]
    let mut count: usize = 0
    let mut request: usize = 0
    while request < REQUESTS {
        let index = requested[request]
        if index >= width {
            return false
        }

        let mut position: usize = 0
        while position < count && expected[position] < index {
            position = position + 1
        }
        if position == count || expected[position] != index {
            if count >= MAX_LEAVES {
                return false
            }
            let mut cursor = count
            while cursor > position {
                expected[cursor] = expected[cursor - 1]
                cursor = cursor - 1
            }
            expected[position] = index
            count = count + 1
        }
        request = request + 1
    }
    let count_u32: u32 = count.downcast_truncate()
    if count_u32 != path.leaf_count {
        return false
    }

    let mut cursor: usize = 0
    while cursor < count {
        if path.leaf_indices[cursor] != expected[cursor] {
            return false
        }
        cursor = cursor + 1
    }
    while cursor < MAX_LEAVES {
        if path.leaf_indices[cursor] != 0 {
            return false
        }
        cursor = cursor + 1
    }
    true
}

/// Compatibility projection for callers that need only the sparse path.
pub fn multi_path_from_leaves<
    F: Copy,
    H: TwoToOneHasher<F>,
    const N: usize,
    const REQUESTS: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(_ leaves: own [F; N], _ requested: own [u32; REQUESTS]) -> MerkleMultiPath<
    F,
    MAX_LEAVES,
    MAX_SIBLINGS,
>
where N > 1, N <= 2147483648, { (N & (N - 1)) == 0 }, REQUESTS > 0, MAX_LEAVES > 0
{
    let mut path = invalid_multi_path<F, H, MAX_LEAVES, MAX_SIBLINGS>()
    let mut root = invalid_root<F, H>()
    write_multi_path_and_root_from_leaves<F, H, N, REQUESTS, MAX_LEAVES, MAX_SIBLINGS>(
        ref leaves,
        ref requested,
        mut path,
        mut root,
    )
    path
}

fn invalid_multi_path_interpretation<
    F: Copy,
    H: TwoToOneHasher<F>,
    I: MerkleMultiPathInterpreter<F, H>,
>(_ interpreter: I) -> MerkleMultiPathInterpretation<I, F> {
    MerkleMultiPathInterpretation {
        interpreter: interpreter,
        root: invalid_root<F, H>(),
        hashes: 0,
        used_siblings: 0,
    }
}

/// Physical storage interpretation for the canonical multipath reduction.
/// The traversal owns semantic topology; implementations choose only where
/// its double-buffered indices and nodes live.
pub trait MerkleMultiPathReductionStorage<F: Copy, const MAX_LEAVES: usize>: Copy {
    fn initialize(
        self,
        _ opened_leaves: ref [F; MAX_LEAVES],
        _ leaf_indices: ref [u32; MAX_LEAVES],
        _ zero: F,
    ) -> Self
    fn index(self, _ position: usize, _ current_a: bool) -> u32
    fn node(self, _ position: usize, _ current_a: bool) -> F
    fn write_next(self, _ position: usize, _ index: u32, _ node: F, _ current_a: bool) -> Self
}

struct LocalMerkleMultiPathReductionStorage<F: Copy, const MAX_LEAVES: usize> {
    indices_a: [u32; MAX_LEAVES],
    indices_b: [u32; MAX_LEAVES],
    nodes_a: [F; MAX_LEAVES],
    nodes_b: [F; MAX_LEAVES],
}
impl<F: Copy, const MAX_LEAVES: usize> Copy for LocalMerkleMultiPathReductionStorage<
    F,
    MAX_LEAVES,
> {}

impl<F: Copy, const MAX_LEAVES: usize> MerkleMultiPathReductionStorage<
    F,
    MAX_LEAVES,
> for LocalMerkleMultiPathReductionStorage<F, MAX_LEAVES> {
    fn initialize(
        self,
        _ opened_leaves: ref [F; MAX_LEAVES],
        _ leaf_indices: ref [u32; MAX_LEAVES],
        _ zero: F,
    ) -> Self {
        let mut storage = self
        let mut cursor: usize = 0
        while cursor < MAX_LEAVES {
            storage.indices_a[cursor] = leaf_indices[cursor]
            storage.indices_b[cursor] = 0
            storage.nodes_a[cursor] = opened_leaves[cursor]
            storage.nodes_b[cursor] = zero
            cursor = cursor + 1
        }
        storage
    }

    fn index(self, _ position: usize, _ current_a: bool) -> u32 {
        if current_a {
            self.indices_a[position]
        } else {
            self.indices_b[position]
        }
    }

    fn node(self, _ position: usize, _ current_a: bool) -> F {
        if current_a {
            self.nodes_a[position]
        } else {
            self.nodes_b[position]
        }
    }

    fn write_next(self, _ position: usize, _ index: u32, _ node: F, _ current_a: bool) -> Self {
        let mut storage = self
        if current_a {
            storage.indices_b[position] = index
            storage.nodes_b[position] = node
        } else {
            storage.indices_a[position] = index
            storage.nodes_a[position] = node
        }
        storage
    }
}

/// Opaque browser-memory target used by the browser storage interpretation.
/// Its fields remain private to this ingot; `merkle_browser` supplies the
/// effect handle and calls the checked accessors below.
pub struct MerkleMultiPathReductionWorkspace<F: Copy, const MAX_LEAVES: usize> {
    indices_a: [u32; MAX_LEAVES],
    indices_b: [u32; MAX_LEAVES],
    nodes_a: [F; MAX_LEAVES],
    nodes_b: [F; MAX_LEAVES],
}

pub fn initialize_multi_path_reduction_workspace<F: Copy, const MAX_LEAVES: usize>(
    _ opened_leaves: ref [F; MAX_LEAVES],
    _ leaf_indices: ref [u32; MAX_LEAVES],
    _ zero: F,
)
uses (workspace: mut MerkleMultiPathReductionWorkspace<F, MAX_LEAVES>)
{
    let mut cursor: usize = 0
    while cursor < MAX_LEAVES {
        workspace.indices_a[cursor] = leaf_indices[cursor]
        workspace.indices_b[cursor] = 0
        workspace.nodes_a[cursor] = opened_leaves[cursor]
        workspace.nodes_b[cursor] = zero
        cursor = cursor + 1
    }
}

pub fn multi_path_workspace_index<F: Copy, const MAX_LEAVES: usize>(
    _ position: usize,
    _ current_a: bool,
) -> u32
uses (workspace: mut MerkleMultiPathReductionWorkspace<F, MAX_LEAVES>)
{
    if current_a {
        workspace.indices_a[position]
    } else {
        workspace.indices_b[position]
    }
}

pub fn multi_path_workspace_node<F: Copy, const MAX_LEAVES: usize>(
    _ position: usize,
    _ current_a: bool,
) -> F
uses (workspace: mut MerkleMultiPathReductionWorkspace<F, MAX_LEAVES>)
{
    if current_a {
        workspace.nodes_a[position]
    } else {
        workspace.nodes_b[position]
    }
}

pub fn write_multi_path_workspace_next<F: Copy, const MAX_LEAVES: usize>(
    _ position: usize,
    _ index: u32,
    _ node: F,
    _ current_a: bool,
)
uses (workspace: mut MerkleMultiPathReductionWorkspace<F, MAX_LEAVES>)
{
    if current_a {
        workspace.indices_b[position] = index
        workspace.nodes_b[position] = node
    } else {
        workspace.indices_a[position] = index
        workspace.nodes_a[position] = node
    }
}

/// Interpret the canonical sparse reduction once. The semantic topology is
/// fixed here; an interpreter owns only the physical meaning of each ordered
/// hash task.
pub fn interpret_multi_root_with_storage<
    F: Copy,
    H: TwoToOneHasher<F>,
    I: MerkleMultiPathInterpreter<F, H>,
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
    S: MerkleMultiPathReductionStorage<F, MAX_LEAVES>,
>(
    _ opened_leaves: ref [F; MAX_LEAVES],
    _ path: ref MerkleMultiPath<F, MAX_LEAVES, MAX_SIBLINGS>,
    _ interpreter: I,
    _ storage: S,
) -> MerkleMultiPathInterpretation<I, F>
where N > 1, N <= 2147483648, { (N & (N - 1)) == 0 }, MAX_LEAVES > 0
{
    let mut storage = storage
    let leaf_count: usize = path.leaf_count as usize
    let sibling_count: usize = path.sibling_count as usize
    if !path.valid || leaf_count == 0 || leaf_count > MAX_LEAVES || sibling_count > MAX_SIBLINGS {
        return invalid_multi_path_interpretation<F, H, I>(interpreter)
    }
    let width_u32: u32 = N.downcast_truncate()
    let mut cursor: usize = 0
    while cursor < leaf_count {
        if path.leaf_indices[cursor] >= width_u32
            || (cursor > 0 && path.leaf_indices[cursor - 1] >= path.leaf_indices[cursor]) {
            return invalid_multi_path_interpretation<F, H, I>(interpreter)
        }
        cursor = cursor + 1
    }
    while cursor < MAX_LEAVES {
        if path.leaf_indices[cursor] != 0 || !H::equal(opened_leaves[cursor], H::zero()) {
            return invalid_multi_path_interpretation<F, H, I>(interpreter)
        }
        cursor = cursor + 1
    }
    cursor = sibling_count
    while cursor < MAX_SIBLINGS {
        if !H::equal(path.siblings[cursor], H::zero()) {
            return invalid_multi_path_interpretation<F, H, I>(interpreter)
        }
        cursor = cursor + 1
    }

    storage = storage.initialize(opened_leaves, ref path.leaf_indices, H::zero())
    let mut active_count = leaf_count
    let mut used_siblings: usize = 0
    let mut width: usize = N
    let mut level: u32 = 0
    let mut hashes: u32 = 0
    let mut current_a = true
    let mut interpreter = interpreter
    while width > 1 {
        let mut next_count: usize = 0
        cursor = 0
        while cursor < active_count {
            let index = storage.index(cursor, current_a)
            let paired = (index & 1) == 0
                && cursor + 1 < active_count
                && storage.index(cursor + 1, current_a) == index + 1
            let child = storage.node(cursor, current_a)
            let sibling_position: u32 = used_siblings.downcast_truncate()
            let sibling = if paired {
                let value = storage.node(cursor + 1, current_a)
                cursor = cursor + 2
                value
            } else {
                if used_siblings >= sibling_count {
                    return invalid_multi_path_interpretation<F, H, I>(interpreter)
                }
                let sibling = path.siblings[used_siblings]
                used_siblings = used_siblings + 1
                cursor = cursor + 1
                sibling
            }
            let compressed = interpreter
                .compress(
                    MerkleMultiPathTask {
                        level: level,
                        index: index,
                        paired: paired,
                        sibling_position: sibling_position,
                        direction: index & 1,
                    },
                    child,
                    sibling,
                )
            interpreter = compressed.interpreter
            let parent = compressed.value
            hashes = hashes + 1
            storage = storage.write_next(next_count, index / 2, parent, current_a)
            next_count = next_count + 1
        }
        current_a = !current_a
        active_count = next_count
        width = width / 2
        level = level + 1
    }
    if active_count != 1 || storage.index(0, current_a) != 0 || used_siblings != sibling_count {
        return invalid_multi_path_interpretation<F, H, I>(interpreter)
    }
    MerkleMultiPathInterpretation {
        interpreter: interpreter,
        root: MerkleRoot { valid: true, value: storage.node(0, current_a) },
        hashes: hashes,
        used_siblings: used_siblings.downcast_truncate(),
    }
}

/// Interpret the canonical sparse reduction with ordinary local Fe storage.
/// Browser and other large-memory placements provide another storage
/// interpretation to `interpret_multi_root_with_storage` instead of changing
/// this topology.
pub fn interpret_multi_root<
    F: Copy,
    H: TwoToOneHasher<F>,
    I: MerkleMultiPathInterpreter<F, H>,
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ opened_leaves: own [F; MAX_LEAVES],
    _ path: own MerkleMultiPath<F, MAX_LEAVES, MAX_SIBLINGS>,
    _ interpreter: I,
) -> MerkleMultiPathInterpretation<I, F>
where N > 1, N <= 2147483648, { (N & (N - 1)) == 0 }, MAX_LEAVES > 0
{
    let storage = LocalMerkleMultiPathReductionStorage {
        indices_a: [0; MAX_LEAVES],
        indices_b: [0; MAX_LEAVES],
        nodes_a: [H::zero(); MAX_LEAVES],
        nodes_b: [H::zero(); MAX_LEAVES],
    }
    interpret_multi_root_with_storage<
        F,
        H,
        I,
        N,
        MAX_LEAVES,
        MAX_SIBLINGS,
        LocalMerkleMultiPathReductionStorage<F, MAX_LEAVES>,
    >(ref opened_leaves, ref path, interpreter, storage)
}

/// Reconstruct a root from canonical sparse leaves and their deduplicated
/// multipath. `opened_leaves` follows `path.leaf_indices` exactly.
pub fn multi_root<
    F: Copy,
    H: TwoToOneHasher<F>,
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ opened_leaves: own [F; MAX_LEAVES],
    _ path: own MerkleMultiPath<F, MAX_LEAVES, MAX_SIBLINGS>,
) -> MerkleRoot<F>
where N > 1, N <= 2147483648, { (N & (N - 1)) == 0 }, MAX_LEAVES > 0
{
    interpret_multi_root<F, H, MerkleMultiPathValueInterpreter, N, MAX_LEAVES, MAX_SIBLINGS>(
        opened_leaves,
        path,
        MerkleMultiPathValueInterpreter::new(),
    )
        .root
}

pub fn multi_verify<
    F: Copy,
    H: TwoToOneHasher<F>,
    const N: usize,
    const MAX_LEAVES: usize,
    const MAX_SIBLINGS: usize,
>(
    _ expected: F,
    _ opened_leaves: own [F; MAX_LEAVES],
    _ path: own MerkleMultiPath<F, MAX_LEAVES, MAX_SIBLINGS>,
) -> bool
where N > 1, N <= 2147483648, { (N & (N - 1)) == 0 }, MAX_LEAVES > 0
{
    let opened = multi_root<F, H, N, MAX_LEAVES, MAX_SIBLINGS>(opened_leaves, path)
    opened.valid && H::equal(opened.value, expected)
}
