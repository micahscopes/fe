//! Reflection-derived, nominal word regions.
//!
//! A schema is an ordinary Fe record whose fields are `Region<Schema, T>`
//! values. The schema brand is checked by the derive provider, so an offset
//! minted for one layout cannot be interpreted as part of another layout.
//! Reflection assigns each field a contiguous offset using `T`'s canonical
//! word width. The offset remains private, so consumers select a semantic
//! region rather than constructing application tape coordinates.

use canonical_words::CanonicalWords
use core::derive::{Derive, Evidence, ImplBuilder, Reflect}
use std::webgpu::StorageBuffer

/// One compiler-derived contiguous region containing canonical words for `T`.
/// `Space` names the complete schema that owns the coordinate. The private
/// offset can only be minted by this ingot's schema provider.
pub struct Region<Space, T> { offset: u32 }

impl<Space, T> core::marker::Copy for Region<Space, T> {}

impl<Space, T: CanonicalWords> Region<Space, T> {
    /// Safe public reflection over the payload's canonical width.
    pub const fn word_width() -> u32 { T::WORDS }

    /// Authority boundary for physical coordinates. The derive provider below
    /// resolves this private constructor where it is defined; downstream Fe
    /// code cannot name it or initialize the private field directly.
    const fn from_derived_offset(_ offset: u32) -> Self {
        Self { offset: offset }
    }
}

/// Provider-only proof that a field's region brand is its declaring schema.
/// The generic impl deliberately unifies both occurrences of `Space`.
pub trait RegionMember<Space> {}

impl<Space, T: CanonicalWords> RegionMember<Space> for Region<Space, T> {}

/// Exact packed layout of an ordinary record of typed regions.
pub trait RegionSchema {
    const WORDS: u32
    const fn regions() -> Self
}

/// Derives contiguous offsets and the total width from canonical payload
/// widths. Declaration order is retained exactly.
pub struct RegionSchemaProvider {}

impl Derive<RegionSchema> for RegionSchemaProvider {
    const fn derive<T>(ev: own Evidence<RegionSchema<T>>)
        -> Evidence<RegionSchema<T>>
        uses (
            reflect: Reflect<T>,
            builder: mut ImplBuilder<RegionSchema<T>>,
        )
    {
        let mut regions = builder.struct_init()
        let mut offset = builder.int(0)
        for field in reflect.fields() {
            builder.require<RegionMember<T>>(field.ty())
            regions = builder.with_field(
                regions,
                field,
                builder.static_call(
                    field.ty(),
                    "from_derived_offset",
                    offset,
                ),
            )
            offset = builder.add(
                offset,
                builder.static_call(field.ty(), "word_width"),
            )
        }
        builder.emit_const("WORDS", builder.ty<u32>(), offset)
        builder.emit_method("regions", regions)
        builder.finish()
        ev
    }
}

/// Inspectable bounds for documentation, layout gates, and independent
/// decoders. Provider construction and schema-fit predicates establish the
/// coordinate invariant, so validity does not occupy runtime storage.
pub struct RegionBounds {
    pub start: u32,
    pub words: u32,
    pub end: u32,
}

impl core::marker::Copy for RegionBounds {}

pub const fn region_bounds<Space, T: CanonicalWords>(
    _ region: Region<Space, T>,
)
    -> RegionBounds {
    let end = region.offset + T::WORDS
    RegionBounds {
        start: region.offset,
        words: T::WORDS,
        end: end,
    }
}

/// Compose a provider-derived child layout inside a provider-derived parent
/// region. The child's complete schema must fit the parent payload. This is a
/// compile-time obligation, while the resulting coordinate retains the outer
/// storage-space brand.
pub const fn subregion<
    OuterSpace: RegionSchema,
    ChildSpace: RegionSchema,
    Outer: CanonicalWords,
    Inner: CanonicalWords,
>(
    _ outer: Region<OuterSpace, Outer>,
    _ inner: Region<ChildSpace, Inner>,
) -> Region<OuterSpace, Inner>
where
    ChildSpace::WORDS <= Outer::WORDS,
{
    Region { offset: outer.offset + inner.offset }
}

pub const fn region_contains<Space, T: CanonicalWords>(
    _ region: Region<Space, T>,
    _ index: u32,
) -> bool {
    index < T::WORDS
}

/// A checked word coordinate derived from a typed region and a relative index.
pub struct RegionAddress {
    pub valid: bool,
    pub absolute: u32,
}

/// A relative coordinate proven to lie inside the canonical words of `T`.
/// The value is private, so downstream code cannot forge an out-of-range
/// coordinate and pass it to the branch-free indexed accessors below.
pub struct RegionIndex<T> { value: u32 }

impl<T> core::marker::Copy for RegionIndex<T> {}

/// Map a cyclic lane coordinate into the word domain of `T`. This is useful
/// for GPU lane IDs and ring-buffer cursors whose intended semantics are
/// explicitly modular.
pub const fn cyclic_region_index<T: CanonicalWords>(
    _ index: u32,
) -> RegionIndex<T>
where
    T::WORDS > 0,
{
    RegionIndex { value: index % T::WORDS }
}

impl core::marker::Copy for RegionAddress {}

pub const fn region_address<Space, T: CanonicalWords>(
    _ region: Region<Space, T>,
    _ index: u32,
) -> RegionAddress {
    if index >= T::WORDS {
        return RegionAddress { valid: false, absolute: 0 }
    }
    RegionAddress { valid: true, absolute: region.offset + index }
}

/// Checked result of reading one canonical word from a typed GPU region.
pub struct RegionWordRead {
    pub valid: bool,
    pub value: u32,
}

/// Read through a reusable bounded coordinate. Schema fit and index fit are
/// type-level facts, so this path introduces no runtime validity branch.
pub fn load_region_indexed_word<
    Space: RegionSchema,
    T: CanonicalWords,
    const STORAGE_WORDS: usize,
>(
    _ storage: StorageBuffer<u32, STORAGE_WORDS>,
    _ region: Region<Space, T>,
    _ index: RegionIndex<T>,
) -> u32
where
    STORAGE_WORDS > 0,
    Space::WORDS <= STORAGE_WORDS.downcast_truncate(),
{
    storage.load(index: region.offset + index.value)
}

/// Store through a reusable bounded coordinate without repeating its proof.
pub fn store_region_indexed_word<
    Space: RegionSchema,
    T: CanonicalWords,
    const STORAGE_WORDS: usize,
>(
    _ storage: StorageBuffer<u32, STORAGE_WORDS>,
    _ region: Region<Space, T>,
    _ index: RegionIndex<T>,
    _ value: u32,
)
where
    STORAGE_WORDS > 0,
    Space::WORDS <= STORAGE_WORDS.downcast_truncate(),
{
    storage.store(index: region.offset + index.value, value: value)
}

impl core::marker::Copy for RegionWordRead {}

pub fn load_region_word<
    Space: RegionSchema,
    T: CanonicalWords,
    const STORAGE_WORDS: usize,
>(
    _ storage: StorageBuffer<u32, STORAGE_WORDS>,
    _ region: Region<Space, T>,
    _ index: u32,
) -> RegionWordRead
where
    STORAGE_WORDS > 0,
    Space::WORDS <= STORAGE_WORDS.downcast_truncate(),
{
    let address = region_address(region, index)
    if !address.valid {
        return RegionWordRead { valid: false, value: 0 }
    }
    RegionWordRead {
        valid: true,
        value: storage.load(index: address.absolute),
    }
}

/// Store one canonical word through a typed GPU region. Invalid relative or
/// resource coordinates fail closed without touching storage.
pub fn store_region_word<
    Space: RegionSchema,
    T: CanonicalWords,
    const STORAGE_WORDS: usize,
>(
    _ storage: StorageBuffer<u32, STORAGE_WORDS>,
    _ region: Region<Space, T>,
    _ index: u32,
    _ value: u32,
) -> bool
where
    STORAGE_WORDS > 0,
    Space::WORDS <= STORAGE_WORDS.downcast_truncate(),
{
    let address = region_address(region, index)
    if !address.valid {
        return false
    }
    storage.store(index: address.absolute, value: value)
    true
}
