//! Portable storage-grid placement for BabyBear Poseidon2.
//!
//! This ingot interprets the same Fe-derived permutation and sponge protocol
//! used by scalar code. One invocation owns one field lane, repeated dispatch
//! boundaries order the permutation steps, and private lane cursors keep the
//! host unaware of cryptographic phase or round policy.

use poseidon_baby_bear::{
    PackedCommitment,
    Poseidon2Digest,
    Poseidon2FieldDomain,
    Poseidon2FieldPermutation,
    Poseidon2FieldSponge,
    Poseidon2WorkgroupPlan,
    Poseidon2WorkgroupSchedule,
    begin_binding_placement_tag,
    begin_digest_squeeze_placement_tag,
    begin_indexed_digest_squeeze_placement_tag,
    fixed_length_sponge_permutations,
    poseidon2_workgroup_destination,
    poseidon2_workgroup_lane,
}
use precision::baby_bear::{BabyBear, BabyBearExt4, BABY_BEAR_MODULUS}
use std::webgpu::{ComputeInvocation, StorageBuffer}

pub const POSEIDON2_LANES: usize =
    <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::LANES
pub const POSEIDON2_STAGE_STEPS: usize =
    <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::STEPS
pub const INDEXED_DIGEST_SQUEEZE_STEPS: usize = 1 + 2 * POSEIDON2_STAGE_STEPS
pub const DIGEST_SQUEEZE_STEPS: usize = 1 + 2 * POSEIDON2_STAGE_STEPS
pub const DIGEST_BINDING_STEPS: usize = 1 + 3 * POSEIDON2_STAGE_STEPS

pub const fn digest_squeeze_batch_state_words(_ states: usize) -> usize {
    states * 2 * POSEIDON2_LANES
}

pub const fn digest_squeeze_batch_tail_start(_ states: usize) -> usize {
    digest_squeeze_batch_state_words(states)
}

pub const fn digest_squeeze_batch_valid_start(_ states: usize) -> usize {
    digest_squeeze_batch_tail_start(states) + states * 2
}

pub const fn digest_squeeze_batch_progress_start(_ states: usize) -> usize {
    digest_squeeze_batch_valid_start(states) + states
}

pub const fn digest_squeeze_batch_workspace_words(_ states: usize) -> usize {
    digest_squeeze_batch_progress_start(states)
        + states * POSEIDON2_LANES
}

pub const fn digest_squeeze_batch_output_valid_start(_ states: usize) -> usize {
    states * 4
}

pub const fn digest_squeeze_batch_output_words(_ states: usize) -> usize {
    digest_squeeze_batch_output_valid_start(states) + states
}

pub const fn digest_squeeze_batch_workgroups(
    _ states: usize,
    _ lanes_per_workgroup: usize,
) -> usize {
    if lanes_per_workgroup == 0 { return 0 }
    let work_items = states * POSEIDON2_LANES
    (work_items + lanes_per_workgroup - 1) / lanes_per_workgroup
}

pub const fn column_major_field_row_commitment_steps(
    _ prefix_fields: usize,
    _ fields: usize,
) -> usize {
    fixed_length_sponge_permutations(prefix_fields + fields)
}

pub const fn column_major_field_row_commitment_state_words(
    _ rows: usize,
) -> usize {
    rows * POSEIDON2_LANES
}

pub const fn column_major_field_row_commitment_valid_start(
    _ rows: usize,
) -> usize {
    column_major_field_row_commitment_state_words(rows)
}

pub const fn column_major_field_row_commitment_progress_start(
    _ rows: usize,
) -> usize {
    column_major_field_row_commitment_valid_start(rows) + rows
}

pub const fn column_major_field_row_commitment_workspace_words(
    _ rows: usize,
) -> usize {
    column_major_field_row_commitment_progress_start(rows) + rows
}

pub struct ColumnMajorFieldRowCommitmentStep {
    pub active: bool,
    pub complete: bool,
    pub valid: bool,
    pub row: u32,
    pub commitment: PackedCommitment,
}
impl core::marker::Copy for ColumnMajorFieldRowCommitmentStep {}

fn invalid_packed_commitment() -> PackedCommitment {
    Poseidon2FieldSponge::begin_tag(BABY_BEAR_MODULUS, 0)
        .finish_scheduled()
}

fn inactive_row_commitment_step() -> ColumnMajorFieldRowCommitmentStep {
    ColumnMajorFieldRowCommitmentStep {
        active: false,
        complete: false,
        valid: false,
        row: 0,
        commitment: invalid_packed_commitment(),
    }
}

/// Reset one private row cursor before a staged canonical commitment.
pub fn prepare_column_major_field_row_commitments<
    const ROWS: usize,
    const WORKSPACE_WORDS: usize,
>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ invocation: ComputeInvocation,
) {
    prepare_column_major_field_row_commitments_at<ROWS, WORKSPACE_WORDS>(
        workspace,
        0,
        invocation,
    )
}

/// Reset row cursors inside a caller-selected region of a shared placement
/// arena. The offset lets a later proof phase reuse one logical GPU resource
/// without overlapping the validity words retained beside it.
pub fn prepare_column_major_field_row_commitments_at<
    const ROWS: usize,
    const WORKSPACE_WORDS: usize,
>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ workspace_start: u32,
    _ invocation: ComputeInvocation,
) {
    let row = invocation.global.x
    if row >= ROWS.downcast_truncate()
        || (workspace_start as usize)
            + column_major_field_row_commitment_workspace_words(ROWS)
            > WORKSPACE_WORDS
    {
        return
    }
    let valid_start: u32 = workspace_start
        + column_major_field_row_commitment_valid_start(ROWS).downcast_truncate()
    let progress_start: u32 = workspace_start
        + column_major_field_row_commitment_progress_start(ROWS).downcast_truncate()
    workspace.store(index: valid_start + row, value: 0)
    workspace.store(index: progress_start + row, value: 0)
}

#[inline(always)]
fn load_column_major_commitment_state<const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ workspace_start: u32,
    _ row: u32,
) -> [u32; POSEIDON2_LANES] {
    let start = workspace_start + row * POSEIDON2_LANES.downcast_truncate()
    let mut lanes = [0; POSEIDON2_LANES]
    let mut lane: u32 = 0
    while lane < POSEIDON2_LANES.downcast_truncate() {
        lanes[lane as usize] = workspace.load(index: start + lane)
        lane = lane + 1
    }
    lanes
}

#[inline(always)]
fn store_column_major_commitment_state<const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ workspace_start: u32,
    _ row: u32,
    _ sponge: ref Poseidon2FieldSponge,
) {
    let start = workspace_start + row * POSEIDON2_LANES.downcast_truncate()
    let mut lane: u32 = 0
    while lane < POSEIDON2_LANES.downcast_truncate() {
        workspace.store(
            index: start + lane,
            value: sponge.lane_word(lane),
        )
        lane = lane + 1
    }
}

/// Execute one exact sponge permutation for every logical matrix row.
///
/// Repeating this entry by `column_major_field_row_commitment_steps` commits a
/// long canonical row without specializing one permutation per source field.
/// The first step absorbs six payload fields after the domain prefix, middle
/// steps absorb eight, and the last step performs the exact final permutation.
pub fn advance_column_major_field_row_commitments<
    D: Poseidon2FieldDomain,
    const ROWS: usize,
    const FIELDS: usize,
    const VALUE_WORDS: usize,
    const PREFIX_FIELDS: usize,
    const WORKSPACE_WORDS: usize,
>(
    _ values: StorageBuffer<u32, VALUE_WORDS>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ prefix: ref [BabyBear; PREFIX_FIELDS],
    _ invocation: ComputeInvocation,
) -> ColumnMajorFieldRowCommitmentStep {
    advance_column_major_field_row_commitments_at<
        D,
        ROWS,
        FIELDS,
        VALUE_WORDS,
        PREFIX_FIELDS,
        WORKSPACE_WORDS,
    >(values, workspace, 0, prefix, invocation)
}

/// Advance one canonical row commitment inside a caller-selected region of a
/// shared placement arena. Message semantics and domain selection are exactly
/// those of `advance_column_major_field_row_commitments`.
pub fn advance_column_major_field_row_commitments_at<
    D: Poseidon2FieldDomain,
    const ROWS: usize,
    const FIELDS: usize,
    const VALUE_WORDS: usize,
    const PREFIX_FIELDS: usize,
    const WORKSPACE_WORDS: usize,
>(
    _ values: StorageBuffer<u32, VALUE_WORDS>,
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ workspace_start: u32,
    _ prefix: ref [BabyBear; PREFIX_FIELDS],
    _ invocation: ComputeInvocation,
) -> ColumnMajorFieldRowCommitmentStep {
    let row = invocation.global.x
    if row >= ROWS.downcast_truncate()
        || VALUE_WORDS < ROWS * FIELDS
        || (workspace_start as usize)
            + column_major_field_row_commitment_workspace_words(ROWS)
            > WORKSPACE_WORDS
    {
        return inactive_row_commitment_step()
    }
    let payload: u32 = (PREFIX_FIELDS + FIELDS).downcast_truncate()
    let steps: u32 = column_major_field_row_commitment_steps(
        PREFIX_FIELDS,
        FIELDS,
    ).downcast_truncate()
    let valid_start: u32 = workspace_start
        + column_major_field_row_commitment_valid_start(ROWS).downcast_truncate()
    let progress_start: u32 = workspace_start
        + column_major_field_row_commitment_progress_start(ROWS).downcast_truncate()
    let progress_index = progress_start + row
    let step = workspace.load(index: progress_index)
    if step >= steps {
        return ColumnMajorFieldRowCommitmentStep {
            active: true,
            complete: false,
            valid: false,
            row: row,
            commitment: invalid_packed_commitment(),
        }
    }

    let first_capacity: u32 = 6
    let start: u32 = if step == 0 {
        0
    } else {
        first_capacity + (step - 1) * 8
    }
    let capacity: u32 = if step == 0 { first_capacity } else { 8 }
    let remaining = payload - start
    let count = if remaining < capacity { remaining } else { capacity }
    let final_block = step + 1 == steps
    let mut sponge = if step == 0 {
        Poseidon2FieldSponge::begin<D>(payload)
    } else {
        Poseidon2FieldSponge::restore(
            load_column_major_commitment_state(workspace, workspace_start, row),
            0,
            payload,
            start,
        )
    }
    let mut input_valid = step == 0
        || workspace.load(index: valid_start + row) == 1
    let mut block = [BabyBear::zero(); 8]
    let mut index: u32 = 0
    while index < count {
        let position = start + index
        if position < PREFIX_FIELDS.downcast_truncate() {
            block[index as usize] = prefix[position as usize]
        } else {
            let column = position - PREFIX_FIELDS.downcast_truncate()
            let word = values.load(
                index: column * ROWS.downcast_truncate() + row,
            )
            if word >= BABY_BEAR_MODULUS { input_valid = false }
            block[index as usize] = BabyBear::from_u32(word)
        }
        index = index + 1
    }
    sponge.absorb_scheduled_block(ref block, count, final_block)
    input_valid = input_valid && sponge.is_valid()
    store_column_major_commitment_state(workspace, workspace_start, row, ref sponge)
    workspace.store(
        index: valid_start + row,
        value: if input_valid { 1 } else { 0 },
    )
    workspace.store(index: progress_index, value: step + 1)
    let commitment = if final_block {
        sponge.finish_scheduled().require(input_valid)
    } else {
        invalid_packed_commitment()
    }
    ColumnMajorFieldRowCommitmentStep {
        active: true,
        complete: final_block,
        valid: input_valid,
        row: row,
        commitment: commitment,
    }
}

pub const fn indexed_digest_squeeze_state_words(_ states: usize) -> usize {
    states * 2 * POSEIDON2_LANES
}

pub const fn indexed_digest_squeeze_tail_words(_ states: usize) -> usize {
    states * 3
}

pub const fn indexed_digest_squeeze_valid_words(_ states: usize) -> usize {
    states
}

pub const fn indexed_digest_squeeze_progress_words(_ states: usize) -> usize {
    states * POSEIDON2_LANES
}

pub const fn indexed_digest_squeeze_tail_start(_ states: usize) -> usize {
    indexed_digest_squeeze_state_words(states)
}

pub const fn indexed_digest_squeeze_valid_start(_ states: usize) -> usize {
    indexed_digest_squeeze_tail_start(states)
        + indexed_digest_squeeze_tail_words(states)
}

pub const fn indexed_digest_squeeze_progress_start(_ states: usize) -> usize {
    indexed_digest_squeeze_valid_start(states)
        + indexed_digest_squeeze_valid_words(states)
}

pub const fn indexed_digest_squeeze_workspace_words(_ states: usize) -> usize {
    indexed_digest_squeeze_progress_start(states)
        + indexed_digest_squeeze_progress_words(states)
}

pub const fn indexed_digest_squeeze_workgroups(
    _ states: usize,
    _ lanes_per_workgroup: usize,
) -> usize {
    if lanes_per_workgroup == 0 { return 0 }
    let work_items = states * POSEIDON2_LANES
    (work_items + lanes_per_workgroup - 1) / lanes_per_workgroup
}

/// Observable state of one lane after one repeated dispatch.
pub struct IndexedDigestSqueezeStep {
    pub active: bool,
    pub complete: bool,
    pub valid: bool,
    pub state: u32,
    pub field_lane: u32,
    pub value: BabyBearExt4,
}
impl core::marker::Copy for IndexedDigestSqueezeStep {}

fn inactive_step() -> IndexedDigestSqueezeStep {
    IndexedDigestSqueezeStep {
        active: false,
        complete: false,
        valid: true,
        state: 0,
        field_lane: 0,
        value: BabyBearExt4::zero(),
    }
}

#[inline(always)]
fn state_buffer_start(_ state: u32, _ secondary: bool) -> u32 {
    let state_words: u32 = (2 * POSEIDON2_LANES).downcast_truncate()
    let buffer_words: u32 = POSEIDON2_LANES.downcast_truncate()
    state * state_words + if secondary { buffer_words } else { 0 }
}

#[inline(always)]
fn storage_state_buffer_start(
    _ state_start: u32,
    _ state: u32,
    _ secondary: bool,
) -> u32 {
    state_start + state_buffer_start(state, secondary)
}

#[inline(always)]
fn load_storage_state_buffer<const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ state_start: u32,
    _ state: u32,
    _ secondary: bool,
) -> [u32; POSEIDON2_LANES] {
    let mut words = [0; POSEIDON2_LANES]
    let start = storage_state_buffer_start(state_start, state, secondary)
    let mut lane: usize = 0
    while lane < POSEIDON2_LANES {
        words[lane] = workspace.load(index: start + lane.downcast_truncate())
        lane = lane + 1
    }
    words
}

#[inline(always)]
fn load_state_buffer<const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ state: u32,
    _ secondary: bool,
) -> [u32; POSEIDON2_LANES] {
    load_storage_state_buffer(workspace, 0, state, secondary)
}

/// Initialize one field lane of a storage-resident Poseidon2 permutation.
///
/// `state_start` owns two width-16 buffers per logical state. `valid_start`
/// owns one validity word per state. Callers derive physical batching and
/// progress placement independently from this exact permutation machine.
#[inline(always)]
pub fn initialize_poseidon2_permutation_lane<
    const WORKSPACE_WORDS: usize,
>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ state_start: u32,
    _ valid_start: u32,
    _ state: u32,
    _ field_lane: u32,
    _ permutation: ref Poseidon2FieldPermutation,
    _ input_valid: bool,
) {
    workspace.store(
        index: storage_state_buffer_start(state_start, state, false)
            + field_lane,
        value: permutation.lane_word(lane: field_lane),
    )
    workspace.store(
        index: storage_state_buffer_start(state_start, state, true)
            + field_lane,
        value: 0,
    )
    if field_lane == 0 {
        workspace.store(
            index: valid_start + state,
            value: if input_valid && permutation.is_valid() { 1 } else { 0 },
        )
    }
}

#[inline(always)]
fn initialize_lane<const STATES: usize, const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ state: u32,
    _ field_lane: u32,
    _ permutation: ref Poseidon2FieldPermutation,
    _ input_valid: bool,
) {
    let valid_start: u32 =
        indexed_digest_squeeze_valid_start(STATES).downcast_truncate()
    initialize_poseidon2_permutation_lane(
        workspace,
        0,
        valid_start,
        state,
        field_lane,
        permutation,
        input_valid,
    )
}

/// Advance one field lane by one exact Poseidon2 workgroup transition.
#[inline(always)]
pub fn advance_poseidon2_permutation_lane<
    const WORKSPACE_WORDS: usize,
>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ state_start: u32,
    _ valid_start: u32,
    _ state: u32,
    _ field_lane: u32,
    _ step: u32,
) -> bool {
    let transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    let primary = load_storage_state_buffer(
        workspace,
        state_start,
        state,
        false,
    )
    let secondary = load_storage_state_buffer(
        workspace,
        state_start,
        state,
        true,
    )
    let valid_index = valid_start + state
    // Keep the wide-loop validity reduction in the same word representation
    // used by storage. Only the final comparison projects it to `bool`.
    let mut failure: u32 =
        if workspace.load(index: valid_index) == 1 { 0 } else { 1 }
    if step >= transition { failure = 2 }
    let mut checked: usize = 0
    while checked < POSEIDON2_LANES {
        if primary[checked] >= BABY_BEAR_MODULUS {
            failure = 10 + checked.downcast_truncate()
        }
        if secondary[checked] >= BABY_BEAR_MODULUS {
            failure = 100 + checked.downcast_truncate()
        }
        checked = checked + 1
    }
    let state_valid = failure == 0
    let value = if state_valid {
        poseidon2_workgroup_lane(
            ref primary,
            ref secondary,
            step,
            field_lane,
        )
    } else {
        0
    }
    workspace.store(
        index: storage_state_buffer_start(
            state_start,
            state,
            poseidon2_workgroup_destination(step) == 1,
        ) + field_lane,
        value: value,
    )
    if field_lane == 0 {
        workspace.store(
            index: valid_index,
            value: if state_valid { 1 } else { 0 },
        )
    }
    state_valid
}

#[inline(always)]
fn advance_permutation_lane<
    const STATES: usize,
    const WORKSPACE_WORDS: usize,
>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ state: u32,
    _ field_lane: u32,
    _ step: u32,
) -> bool {
    let valid_start: u32 =
        indexed_digest_squeeze_valid_start(STATES).downcast_truncate()
    advance_poseidon2_permutation_lane(
        workspace,
        0,
        valid_start,
        state,
        field_lane,
        step,
    )
}

/// Read the first eight canonical fields of a completed storage permutation.
#[inline(always)]
pub fn poseidon2_permutation_digest<const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ state_start: u32,
    _ state: u32,
) -> Poseidon2Digest {
    let output = load_storage_state_buffer(
        workspace,
        state_start,
        state,
        true,
    )
    Poseidon2Digest::from_u32s([
        BabyBear::from_montgomery_word(output[0]).to_u32(),
        BabyBear::from_montgomery_word(output[1]).to_u32(),
        BabyBear::from_montgomery_word(output[2]).to_u32(),
        BabyBear::from_montgomery_word(output[3]).to_u32(),
        BabyBear::from_montgomery_word(output[4]).to_u32(),
        BabyBear::from_montgomery_word(output[5]).to_u32(),
        BabyBear::from_montgomery_word(output[6]).to_u32(),
        BabyBear::from_montgomery_word(output[7]).to_u32(),
    ])
}

/// Advance one unindexed digest squeeze without owning its progress cursor.
///
/// The caller places this exact two-permutation machine inside a larger typed
/// schedule. Completed quartic coefficients and validity are materialized in
/// caller-owned storage, so no protocol-sized aggregate crosses the kernel
/// boundary.
pub fn advance_digest_squeeze_storage_lane<
    const WORKSPACE_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ state_start: u32,
    _ valid_start: u32,
    _ tail_start: u32,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ output_start: u32,
    _ output_valid: u32,
    _ state: u32,
    _ field_lane: u32,
    _ step: u32,
    _ tag: u32,
    _ digest: Poseidon2Digest,
    _ input_valid: bool,
) {
    if step >= DIGEST_SQUEEZE_STEPS.downcast_truncate() { return }
    let hash_steps: u32 = POSEIDON2_STAGE_STEPS.downcast_truncate()
    let transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    let valid_index = valid_start + state
    let tail = tail_start + state * 2

    if step == 0 {
        let placed = begin_digest_squeeze_placement_tag(tag, digest)
        initialize_poseidon2_permutation_lane(
            workspace,
            state_start,
            valid_start,
            state,
            field_lane,
            ref placed.permutation,
            input_valid,
        )
        if field_lane < 2 {
            workspace.store(
                index: tail + field_lane,
                value: placed.remaining[field_lane as usize].to_u32(),
            )
        }
        if field_lane == 0 {
            output.store(index: output_valid, value: 0)
        }
        return
    }

    let relative = step - 1
    let block = relative / hash_steps
    let hash_step = relative % hash_steps
    if hash_step < transition {
        let advanced = advance_poseidon2_permutation_lane(
            workspace,
            state_start,
            valid_start,
            state,
            field_lane,
            hash_step,
        )
        if !advanced && field_lane == 0 {
            output.store(index: output_valid, value: 0)
        }
    } else if block == 0 {
        let first = load_storage_state_buffer(
            workspace,
            state_start,
            state,
            true,
        )
        let remaining = [
            BabyBear::from_u32(workspace.load(index: tail)),
            BabyBear::from_u32(workspace.load(index: tail + 1)),
        ]
        let permutation = Poseidon2FieldSponge::restore(
            lanes: first,
            rate: 0,
            expected: 8,
            written: 6,
        ).begin_final_permutation<2>(ref remaining)
        initialize_poseidon2_permutation_lane(
            workspace,
            state_start,
            valid_start,
            state,
            field_lane,
            ref permutation,
            workspace.load(index: valid_index) == 1,
        )
    } else {
        if field_lane < 4 {
            let raw = workspace.load(
                index: storage_state_buffer_start(
                    state_start,
                    state,
                    true,
                ) + field_lane,
            )
            output.store(
                index: output_start + field_lane,
                value: BabyBear::from_montgomery_word(raw).to_u32(),
            )
        }
        if field_lane == 0 {
            output.store(
                index: output_valid,
                value: workspace.load(index: valid_index),
            )
        }
    }
}

/// Reset every private field-lane cursor and public challenge-validity word
/// before a batch of independent typed digest squeezes.
pub fn prepare_digest_squeeze_batch<
    const STATES: usize,
    const WORKSPACE_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ invocation: ComputeInvocation,
)
where
    STATES > 0,
    { WORKSPACE_WORDS >= digest_squeeze_batch_workspace_words(STATES) },
    { OUTPUT_WORDS >= digest_squeeze_batch_output_words(STATES) },
{
    let global_lane = invocation.global.x
    let lanes: u32 = POSEIDON2_LANES.downcast_truncate()
    if global_lane >= (STATES * POSEIDON2_LANES).downcast_truncate() {
        return
    }
    let state = global_lane / lanes
    let progress_start: u32 =
        digest_squeeze_batch_progress_start(STATES).downcast_truncate()
    workspace.store(index: progress_start + global_lane, value: 0)
    if global_lane % lanes == 0 {
        let valid_start: u32 =
            digest_squeeze_batch_output_valid_start(STATES).downcast_truncate()
        output.store(index: valid_start + state, value: 0)
    }
}

/// Advance one field lane of one independent digest squeeze.
///
/// The caller supplies the nominal domain tag for the selected logical state.
/// Repeating this function `DIGEST_SQUEEZE_STEPS` times materializes four
/// canonical challenge coefficients plus one fail-closed validity word.
pub fn advance_digest_squeeze_batch_lane<
    const STATES: usize,
    const WORKSPACE_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ invocation: ComputeInvocation,
    _ tag: u32,
    _ digest: Poseidon2Digest,
    _ input_valid: bool,
)
where
    STATES > 0,
    { WORKSPACE_WORDS >= digest_squeeze_batch_workspace_words(STATES) },
    { OUTPUT_WORDS >= digest_squeeze_batch_output_words(STATES) },
{
    let global_lane = invocation.global.x
    let lanes: u32 = POSEIDON2_LANES.downcast_truncate()
    if global_lane >= (STATES * POSEIDON2_LANES).downcast_truncate() {
        return
    }
    let state = global_lane / lanes
    let field_lane = global_lane % lanes
    let state_start: u32 = 0
    let tail_start: u32 =
        digest_squeeze_batch_tail_start(STATES).downcast_truncate()
    let valid_start: u32 =
        digest_squeeze_batch_valid_start(STATES).downcast_truncate()
    let progress_start: u32 =
        digest_squeeze_batch_progress_start(STATES).downcast_truncate()
    let progress = progress_start + global_lane
    let step = workspace.load(index: progress)
    let output_valid_start: u32 =
        digest_squeeze_batch_output_valid_start(STATES).downcast_truncate()
    advance_digest_squeeze_storage_lane(
        workspace,
        state_start,
        valid_start,
        tail_start,
        output,
        state * 4,
        output_valid_start + state,
        state,
        field_lane,
        step,
        tag,
        digest,
        input_valid,
    )
    workspace.store(index: progress, value: step + 1)
}

pub struct DigestSqueezeBatchValue {
    pub valid: bool,
    pub value: BabyBearExt4,
}
impl core::marker::Copy for DigestSqueezeBatchValue {}

/// Read one completed batch output without accepting noncanonical field words.
pub fn load_digest_squeeze_batch_value<
    const STATES: usize,
    const OUTPUT_WORDS: usize,
>(
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ state: u32,
) -> DigestSqueezeBatchValue
where
    STATES > 0,
    { OUTPUT_WORDS >= digest_squeeze_batch_output_words(STATES) },
{
    if state >= STATES.downcast_truncate() {
        return DigestSqueezeBatchValue {
            valid: false,
            value: BabyBearExt4::zero(),
        }
    }
    let start = state * 4
    let words = [
        output.load(index: start),
        output.load(index: start + 1),
        output.load(index: start + 2),
        output.load(index: start + 3),
    ]
    let mut canonical = true
    let mut coefficient: usize = 0
    while coefficient < 4 {
        if words[coefficient] >= BABY_BEAR_MODULUS { canonical = false }
        coefficient = coefficient + 1
    }
    let output_valid_start: u32 =
        digest_squeeze_batch_output_valid_start(STATES).downcast_truncate()
    DigestSqueezeBatchValue {
        valid: canonical
            && output.load(index: output_valid_start + state) == 1,
        value: if canonical {
            BabyBearExt4::from_coefficients([
                BabyBear::from_u32(words[0]),
                BabyBear::from_u32(words[1]),
                BabyBear::from_u32(words[2]),
                BabyBear::from_u32(words[3]),
            ])
        } else {
            BabyBearExt4::zero()
        },
    }
}

/// Validate exact completion of every private field-lane cursor and output.
pub fn finish_digest_squeeze_batch<
    const STATES: usize,
    const WORKSPACE_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
) -> bool
where
    STATES > 0,
    { WORKSPACE_WORDS >= digest_squeeze_batch_workspace_words(STATES) },
    { OUTPUT_WORDS >= digest_squeeze_batch_output_words(STATES) },
{
    let progress_start: u32 =
        digest_squeeze_batch_progress_start(STATES).downcast_truncate()
    let mut valid = true
    let mut lane: u32 = 0
    while lane < (STATES * POSEIDON2_LANES).downcast_truncate() {
        valid = valid && workspace.load(index: progress_start + lane)
            == DIGEST_SQUEEZE_STEPS.downcast_truncate()
        lane = lane + 1
    }
    let mut state: u32 = 0
    while state < STATES.downcast_truncate() {
        valid = valid && load_digest_squeeze_batch_value<STATES, OUTPUT_WORDS>(
            output,
            state,
        ).valid
        state = state + 1
    }
    valid
}

/// Advance one ordered digest binding without owning its progress cursor.
///
/// The fixed message is `tag || 16 || left || right`. Its three exact
/// permutations materialize one eight-field digest plus a validity word in
/// caller-owned storage.
pub fn advance_digest_binding_storage_lane<
    const WORKSPACE_WORDS: usize,
    const OUTPUT_WORDS: usize,
>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ state_start: u32,
    _ valid_start: u32,
    _ tail_start: u32,
    _ output: StorageBuffer<u32, OUTPUT_WORDS>,
    _ output_start: u32,
    _ output_valid: u32,
    _ state: u32,
    _ field_lane: u32,
    _ step: u32,
    _ tag: u32,
    _ left: Poseidon2Digest,
    _ right: Poseidon2Digest,
    _ input_valid: bool,
) {
    if step >= DIGEST_BINDING_STEPS.downcast_truncate() { return }
    let hash_steps: u32 = POSEIDON2_STAGE_STEPS.downcast_truncate()
    let transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    let valid_index = valid_start + state
    let tail = tail_start + state * 10

    if step == 0 {
        let placed = begin_binding_placement_tag(tag, left, right)
        initialize_poseidon2_permutation_lane(
            workspace,
            state_start,
            valid_start,
            state,
            field_lane,
            ref placed.permutation,
            input_valid,
        )
        if field_lane < 10 {
            workspace.store(
                index: tail + field_lane,
                value: placed.remaining[field_lane as usize].to_u32(),
            )
        }
        if field_lane == 0 {
            output.store(index: output_valid, value: 0)
        }
        return
    }

    let relative = step - 1
    let block = relative / hash_steps
    let hash_step = relative % hash_steps
    if hash_step < transition {
        let advanced = advance_poseidon2_permutation_lane(
            workspace,
            state_start,
            valid_start,
            state,
            field_lane,
            hash_step,
        )
        if !advanced && field_lane == 0 {
            output.store(index: output_valid, value: 0)
        }
    } else if block == 0 {
        let first = load_storage_state_buffer(
            workspace,
            state_start,
            state,
            true,
        )
        let mut remaining = [BabyBear::zero(); 8]
        let mut index: usize = 0
        while index < 8 {
            remaining[index] = BabyBear::from_u32(
                workspace.load(index: tail + index.downcast_truncate()),
            )
            index = index + 1
        }
        let permutation = Poseidon2FieldSponge::restore(
            lanes: first,
            rate: 0,
            expected: 16,
            written: 6,
        ).begin_permutation<8>(ref remaining)
        initialize_poseidon2_permutation_lane(
            workspace,
            state_start,
            valid_start,
            state,
            field_lane,
            ref permutation,
            workspace.load(index: valid_index) == 1,
        )
    } else if block == 1 {
        let second = load_storage_state_buffer(
            workspace,
            state_start,
            state,
            true,
        )
        let remaining = [
            BabyBear::from_u32(workspace.load(index: tail + 8)),
            BabyBear::from_u32(workspace.load(index: tail + 9)),
        ]
        let permutation = Poseidon2FieldSponge::restore(
            lanes: second,
            rate: 0,
            expected: 16,
            written: 14,
        ).begin_final_permutation<2>(ref remaining)
        initialize_poseidon2_permutation_lane(
            workspace,
            state_start,
            valid_start,
            state,
            field_lane,
            ref permutation,
            workspace.load(index: valid_index) == 1,
        )
    } else {
        if field_lane < 8 {
            let raw = workspace.load(
                index: storage_state_buffer_start(
                    state_start,
                    state,
                    true,
                ) + field_lane,
            )
            output.store(
                index: output_start + field_lane,
                value: BabyBear::from_montgomery_word(raw).to_u32(),
            )
        }
        if field_lane == 0 {
            output.store(
                index: output_valid,
                value: workspace.load(index: valid_index),
            )
        }
    }
}

#[inline(always)]
fn output_value<const WORKSPACE_WORDS: usize>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ state: u32,
) -> BabyBearExt4 {
    let output = load_state_buffer(workspace, state, true)
    BabyBearExt4::from_coefficients([
        BabyBear::from_montgomery_word(output[0]),
        BabyBear::from_montgomery_word(output[1]),
        BabyBear::from_montgomery_word(output[2]),
        BabyBear::from_montgomery_word(output[3]),
    ])
}

/// Advance one lane of a batch of indexed digest squeezes.
///
/// Callers select only the number of logical states and the physical workgroup
/// tile. `INDEXED_DIGEST_SQUEEZE_STEPS` repeated queue submissions execute the
/// two exact Poseidon2 permutations and their typed absorption boundary. The
/// workspace layout is derived entirely from `STATES`.
pub fn advance_indexed_digest_squeeze_lane<
    const STATES: usize,
    const WORKSPACE_WORDS: usize,
>(
    _ workspace: StorageBuffer<u32, WORKSPACE_WORDS>,
    _ invocation: ComputeInvocation,
    _ tag: u32,
    _ digest: Poseidon2Digest,
    _ index_value: u32,
    _ input_valid: bool,
) -> IndexedDigestSqueezeStep
where
    STATES > 0,
    { WORKSPACE_WORDS == indexed_digest_squeeze_workspace_words(STATES) },
{
    let global_lane = invocation.global.x
    if global_lane >= (STATES * POSEIDON2_LANES).downcast_truncate() {
        return inactive_step()
    }
    let lanes: u32 = POSEIDON2_LANES.downcast_truncate()
    let state = global_lane / lanes
    let field_lane = global_lane % lanes
    let progress_start: u32 =
        indexed_digest_squeeze_progress_start(STATES).downcast_truncate()
    let progress_index = progress_start + global_lane
    let step = workspace.load(index: progress_index)
    if step >= INDEXED_DIGEST_SQUEEZE_STEPS.downcast_truncate() {
        return IndexedDigestSqueezeStep {
            active: true,
            complete: false,
            valid: false,
            state: state,
            field_lane: field_lane,
            value: BabyBearExt4::zero(),
        }
    }

    let hash_steps: u32 = POSEIDON2_STAGE_STEPS.downcast_truncate()
    let transition =
        <Poseidon2WorkgroupSchedule as Poseidon2WorkgroupPlan>::TRANSITION
    let valid_start: u32 =
        indexed_digest_squeeze_valid_start(STATES).downcast_truncate()
    let valid_index = valid_start + state
    let mut complete = false
    let mut state_valid = input_valid
    let mut value = BabyBearExt4::zero()

    if step == 0 {
        let placed = begin_indexed_digest_squeeze_placement_tag(
            tag,
            digest,
            index_value,
        )
        initialize_lane<STATES, WORKSPACE_WORDS>(
            workspace,
            state,
            field_lane,
            ref placed.permutation,
            input_valid,
        )
        if field_lane < 3 {
            let tail_start: u32 =
                indexed_digest_squeeze_tail_start(STATES).downcast_truncate()
            workspace.store(
                index: tail_start + state * 3 + field_lane,
                value: placed.remaining[field_lane as usize].to_u32(),
            )
        }
        state_valid = input_valid && placed.permutation.is_valid()
    } else {
        let relative = step - 1
        let block = relative / hash_steps
        let hash_step = relative % hash_steps
        state_valid = workspace.load(index: valid_index) == 1
        if hash_step < transition {
            state_valid = advance_permutation_lane<STATES, WORKSPACE_WORDS>(
                workspace,
                state,
                field_lane,
                hash_step,
            )
        } else if block == 0 {
            let output = load_state_buffer(workspace, state, true)
            let tails_start: u32 =
                indexed_digest_squeeze_tail_start(STATES).downcast_truncate()
            let tail_start = tails_start + state * 3
            let tail = [
                BabyBear::from_u32(workspace.load(index: tail_start)),
                BabyBear::from_u32(workspace.load(index: tail_start + 1)),
                BabyBear::from_u32(workspace.load(index: tail_start + 2)),
            ]
            let sponge = Poseidon2FieldSponge::restore(
                lanes: output,
                rate: 0,
                expected: 9,
                written: 6,
            )
            let permutation = sponge.begin_final_permutation<3>(
                fields: ref tail,
            )
            initialize_lane<STATES, WORKSPACE_WORDS>(
                workspace,
                state,
                field_lane,
                ref permutation,
                state_valid,
            )
            state_valid = state_valid && permutation.is_valid()
        } else if field_lane == 0 {
            complete = true
            state_valid = workspace.load(index: valid_index) == 1
            if state_valid { value = output_value(workspace, state) }
        }
    }

    workspace.store(index: progress_index, value: step + 1)
    IndexedDigestSqueezeStep {
        active: true,
        complete: complete,
        valid: state_valid,
        state: state,
        field_lane: field_lane,
        value: value,
    }
}
