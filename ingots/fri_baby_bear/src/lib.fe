//! Focused BabyBear FRI value denotation.
//!
//! Scalar proof construction, sparse verification, and WebGPU placement all
//! consume these exact pair operations. Scheduling may place independent pairs
//! in different lanes, but it does not own a second fold formula.

use precision::baby_bear::{BabyBear, BabyBearExt4}
use precision::polynomial::radix2_log
use poseidon_baby_bear::{
    Poseidon2Digest,
    Poseidon2FieldDomain,
    bind,
    commit_ext4_fields,
    squeeze_ext4,
}
pub use fri_structure::{
    FriRoundPlacement,
    FriSchedule,
    FriScheduleDone,
    FriScheduleFold,
    FriScheduleMetadata,
    FriSchedulePlacement,
    FriScheduleShape,
}

const fn protocol_prefix(_ prefix: String<2>) -> u32 {
    let bytes = prefix.as_bytes()
    ((bytes[0] as u32) << 24) | ((bytes[1] as u32) << 16)
}

const FRI_FOLD_PREFIX: u32 = protocol_prefix("FC")
const FRI_LAYER_ROW_PREFIX: u32 = protocol_prefix("FR")
const FRI_LAYER_TRANSCRIPT_PREFIX: u32 = protocol_prefix("FT")

const fn protocol_round_tag(_ prefix: u32, _ round: u32) -> u32 {
    let tens = round / 10
    let ones = round - tens * 10
    prefix | ((48 + tens) << 8)
        | (48 + ones)
}

pub const fn fri_fold_domain_tag(_ round: u32) -> u32 {
    protocol_round_tag(FRI_FOLD_PREFIX, round)
}

pub const fn fri_layer_row_domain_tag(_ round: u32) -> u32 {
    protocol_round_tag(FRI_LAYER_ROW_PREFIX, round)
}

pub const fn fri_layer_transcript_domain_tag(_ round: u32) -> u32 {
    protocol_round_tag(FRI_LAYER_TRANSCRIPT_PREFIX, round)
}

/// Typed transcript domains shared by scalar proof construction and GPU
/// placement. The round is the semantic authority for each domain tag.
pub struct FriFoldDomain<const ROUND: u32> {}
pub struct FriLayerRowDomain<const ROUND: u32> {}
pub struct FriLayerTranscriptDomain<const ROUND: u32> {}

impl<const ROUND: u32> Poseidon2FieldDomain for FriFoldDomain<ROUND> {
    const TAG: u32 = fri_fold_domain_tag(ROUND)
}

impl<const ROUND: u32> Poseidon2FieldDomain for FriLayerRowDomain<ROUND> {
    const TAG: u32 = fri_layer_row_domain_tag(ROUND)
}

impl<const ROUND: u32> Poseidon2FieldDomain
    for FriLayerTranscriptDomain<ROUND>
{
    const TAG: u32 = fri_layer_transcript_domain_tag(ROUND)
}

/// Squeeze one round challenge from the preceding transcript digest.
pub fn derive_fri_fold_challenge<const ROUND: u32>(
    _ transcript: Poseidon2Digest,
) -> BabyBearExt4
where { ROUND > 0 }, { ROUND < 100 }
{
    squeeze_ext4<FriFoldDomain<ROUND>>(transcript)
}

/// Commit one quartic evaluation as an ordered FRI-layer leaf.
pub fn commit_fri_layer_row<const ROUND: u32>(
    _ evaluation: BabyBearExt4,
) -> Poseidon2Digest
where { ROUND > 0 }, { ROUND < 100 }
{
    commit_ext4_fields<FriLayerRowDomain<ROUND>, 1>([evaluation])
}

/// Bind an ordered FRI-layer root into the transcript for one round.
pub fn bind_fri_layer_transcript<const ROUND: u32>(
    _ transcript: Poseidon2Digest,
    _ layer: Poseidon2Digest,
) -> Poseidon2Digest
where { ROUND > 0 }, { ROUND < 100 }
{
    bind<FriLayerTranscriptDomain<ROUND>>(transcript, layer)
}

/// The semantic result of folding one `(x, -x)` pair.
pub struct FriFoldPairEvaluation {
    pub valid: bool,
    pub evaluation: BabyBearExt4,
}
impl core::marker::Copy for FriFoldPairEvaluation {}

/// One reusable FRI binary fold over the quartic BabyBear challenge field.
/// Evaluations at `x` and `-x` become one evaluation at `x^2`.
#[inline(always)]
pub fn fold_fri_pair_value_at_point(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ challenge: BabyBearExt4,
    _ point: BabyBear,
) -> BabyBearExt4 {
    let inverse_two = BabyBearExt4::from_base(
        BabyBear::from_u32(2).inverse_or_zero(),
    )
    let even = (positive + negative) * inverse_two
    let odd = (positive - negative)
        * inverse_two
        * BabyBearExt4::from_base(point.inverse_or_zero())
    even + challenge * odd
}

/// Checked scalar view of the shared pair value. Placement interpreters whose
/// typed schedule already proves a nonzero point may consume the value function
/// directly and retain their validity channel in typed storage.
#[inline(always)]
pub fn fold_fri_pair_at_point(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ challenge: BabyBearExt4,
    _ point: BabyBear,
) -> FriFoldPairEvaluation {
    if point.is_zero() {
        return FriFoldPairEvaluation {
            valid: false,
            evaluation: BabyBearExt4::zero(),
        }
    }
    FriFoldPairEvaluation {
        valid: true,
        evaluation: fold_fri_pair_value_at_point(
            positive,
            negative,
            challenge,
            point,
        ),
    }
}

#[inline(always)]
pub fn fold_fri_pair_value_at_power_of_two<const N: usize>(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ challenge: BabyBearExt4,
    _ shift: BabyBear,
    _ index: u32,
) -> BabyBearExt4
where N > 0, N > 1, { (N & (N - 1)) == 0 }
{
    let half: u32 = (N / 2).downcast_truncate()
    if shift.is_zero() || index >= half {
        return BabyBearExt4::zero()
    }
    let root = BabyBear::two_adic_root(radix2_log<N>())
    fold_fri_pair_value_at_point(
        positive,
        negative,
        challenge,
        shift * root.pow_u32(index),
    )
}

/// Place one pair in a power-of-two FRI layer. The index selects the same
/// canonical root power used by scalar folding and sparse query verification.
#[inline(always)]
pub fn fold_fri_pair_at_power_of_two<const N: usize>(
    _ positive: BabyBearExt4,
    _ negative: BabyBearExt4,
    _ challenge: BabyBearExt4,
    _ shift: BabyBear,
    _ index: u32,
) -> FriFoldPairEvaluation
where N > 0, N > 1, { (N & (N - 1)) == 0 }
{
    let half: u32 = (N / 2).downcast_truncate()
    if shift.is_zero() || index >= half {
        return FriFoldPairEvaluation {
            valid: false,
            evaluation: BabyBearExt4::zero(),
        }
    }
    FriFoldPairEvaluation {
        valid: true,
        evaluation: fold_fri_pair_value_at_power_of_two<N>(
            positive,
            negative,
            challenge,
            shift,
            index,
        ),
    }
}
