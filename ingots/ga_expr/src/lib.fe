//! Static geometric-algebra expressions and conservative support analysis.
//!
//! This is the first reusable layer of the single-invocation GA compiler. A
//! ground expression type is ordinary Fe data for CTFE/FCO: operators remain
//! nominal, operand support is carried by leaf types, and `GaSupport<M>`
//! computes possible output blades before any runtime code exists.
//!
//! Support is deliberately conservative. It removes structural zeros but does
//! not claim coefficient cancellation. Exact term normalization, numeric
//! policy, and FCO emission are later layers described in
//! `docs/mb2/GA_SINGLE_INVOCATION_COMPILER.md`.
//!
//! Conservative whole-multivector `GaSupport` is currently bounded to
//! diagonal/orthogonal geometry with at most five generators, matching
//! `sparse_clifford::BladeSet`. A separate configured provider below handles a
//! high-dimensional, sparse symmetric metric for the explicitly narrower
//! vector scalar-product contract. General off-diagonal Clifford products are
//! not approximated by pretending the diagonal support rule applies.

use sparse_clifford::{
    BladeSet, blade_grade, blade_set, support_capacity_mask, support_dimension_valid,
    support_gp, support_grade,
}
use core::derive::{Derive, Evidence, ImplBuilder, Reflect}

/// A bounded diagonal metric. Bit `i` of `NONZERO_SQUARES` says generator `i`
/// has a nonzero square; its sign belongs to exact coefficient planning and
/// does not affect conservative support.
pub struct DiagonalMetric<const DIMENSION: u32, const NONZERO_SQUARES: u32> {}

/// A bounded signed orthogonal metric for the structural expression compiler.
/// `NONZERO_SQUARES` marks generators whose square survives and
/// `NEGATIVE_SQUARES` marks the surviving generators whose square is -1.
/// Bits outside `NONZERO_SQUARES` are ignored.
pub struct SignedOrthogonalMetric<
    const DIMENSION: usize,
    const NONZERO_SQUARES: usize,
    const NEGATIVE_SQUARES: usize,
> {}

pub trait StaticDiagonalMetric {
    const DIMENSION: u32
    const NONZERO_SQUARES: u32
}

impl<const Dimension: u32, const NonzeroSquares: u32> StaticDiagonalMetric
    for DiagonalMetric<Dimension, NonzeroSquares>
{
    const DIMENSION: u32 = Dimension
    const NONZERO_SQUARES: u32 = NonzeroSquares
}

/// One runtime multivector input. `Slot` is semantic leaf identity for the
/// later term/DAG planner; `Mask` is a bitset over basis-blade indices.
pub struct Input<const Slot: usize, const Mask: u32> {}

/// A sparse grade-1 input for dimensions whose full `2^dimension` blade set
/// does not fit the bounded `GaSupport` bitset. `Identity` is ordinary nominal
/// Fe type data—not an author-maintained numeric slot. Bit `i` of
/// `GeneratorSupport` names generator `i`; runtime coefficients are packed in
/// ascending generator order. This is the natural carrier for QCGA's sparse
/// 15-generator vectors.
pub struct VectorInput<Identity, const GeneratorSupport: usize> {}

/// A sparse whole-multivector leaf for the structural expression compiler.
/// `Coefficients` is both nominal leaf identity and its runtime coefficient
/// record. `BladeSupport` is a bitset over basis-blade masks; the record packs
/// only present blades, in ascending mask order.
pub struct MultivectorInput<Coefficients, const BladeSupport: usize> {}

pub struct Sum<A, B> {}
pub struct Difference<A, B> {}
pub struct Neg<A> {}
pub struct Geometric<A, B> {}
pub struct Outer<A, B> {}
pub struct LeftContraction<A, B> {}
pub struct RightContraction<A, B> {}
pub struct ScalarProduct<A, B> {}
pub struct Grade<A, const K: u32> {}
pub struct Reverse<A> {}
pub struct PoincareDual<A> {}
pub struct Regressive<A, B> {}

/// Preserve the authored expression tree's floating-point evaluation order.
/// Pure subexpressions may be shared, but reassociation and coefficient
/// collection are forbidden.
pub struct Strict {}

/// Permit exact symbolic coefficient collection followed by a balanced
/// straight-line schedule. Algebraically equivalent, but not promised to be
/// bit-identical to the authored f32 association.
pub struct AlgebraicBalanced {}

/// A fully static compilation request. `E` is the expression, `M` the metric,
/// and `P` the numerical policy. The value contains no runtime metadata.
pub struct GaProgram<E, M, P> {}

/// A sparse symmetric bilinear form. `Terms` is any finite ground type tree
/// containing `MetricTerm` leaves. A term stores one unordered matrix entry;
/// the structural scalar provider applies it in either operand orientation.
pub struct SparseSymmetricMetric<const Dimension: usize, Terms> {}

pub struct MetricZero {}
pub struct MetricSum<A, B> {}

/// One exact nonzero symmetric-metric entry. `Magnitude` is a natural exact
/// coefficient and `Negative` is 0 or 1. The first implementation emits
/// magnitude by repeated strict addition, preserving a visible scalar policy.
pub struct MetricTerm<
    const LeftGenerator: usize,
    const RightGenerator: usize,
    const Magnitude: usize,
    const Negative: usize,
> {}

const fn finite_support_has(_ support: usize, _ blade: usize) -> bool {
    ((support >> blade) & 1) == 1
}

const fn finite_support_rank(_ support: usize, _ blade: usize) -> usize {
    let mut probe: usize = 0
    let mut rank: usize = 0
    while probe < blade {
        if finite_support_has(support, probe) { rank = rank + 1 }
        probe = probe + 1
    }
    rank
}

const fn finite_support_width(_ support: usize, _ blade_count: usize) -> usize {
    let mut blade: usize = 0
    let mut width: usize = 0
    while blade < blade_count {
        if finite_support_has(support, blade) { width = width + 1 }
        blade = blade + 1
    }
    width
}

const fn finite_blade_grade(_ blade: usize) -> usize {
    let mut rest: usize = blade
    let mut grade: usize = 0
    while rest > 0 {
        grade = grade + (rest & 1)
        rest = rest >> 1
    }
    grade
}

/// Reordering parity for two canonical basis blades. Metric-square signs are
/// added separately by `geometric_negative`.
const fn merge_negative(_ left: usize, _ right: usize) -> bool {
    let mut generator: usize = 0
    let mut swaps: usize = 0
    while generator < 5 {
        if ((left >> generator) & 1) == 1 {
            swaps = swaps + finite_blade_grade(right & ((1 << generator) - 1))
        }
        generator = generator + 1
    }
    (swaps & 1) == 1
}

const fn geometric_negative(
    _ left: usize, _ right: usize, _ negative_squares: usize,
) -> bool {
    let metric_negatives = finite_blade_grade(left & right & negative_squares)
    let negative = merge_negative(left, right)
    if (metric_negatives & 1) == 1 { negative = !negative }
    negative
}

const fn geometric_survives(
    _ left: usize, _ right: usize, _ nonzero_squares: usize,
) -> bool {
    let shared = left & right
    (shared & nonzero_squares) == shared
}

const fn left_contraction_keeps(
    _ left: usize, _ right: usize, _ output: usize,
) -> bool {
    let left_grade = finite_blade_grade(left)
    let right_grade = finite_blade_grade(right)
    let output_grade = finite_blade_grade(output)
    if left_grade <= right_grade {
        output_grade == right_grade - left_grade
    } else {
        false
    }
}

const fn right_contraction_keeps(
    _ left: usize, _ right: usize, _ output: usize,
) -> bool {
    let left_grade = finite_blade_grade(left)
    let right_grade = finite_blade_grade(right)
    let output_grade = finite_blade_grade(output)
    if right_grade <= left_grade {
        output_grade == left_grade - right_grade
    } else {
        false
    }
}

const fn reverse_negative(_ blade: usize) -> bool {
    let grade = finite_blade_grade(blade)
    if grade == 0 {
        false
    } else {
        (((grade * (grade - 1)) / 2) & 1) == 1
    }
}

struct GaF32Scalar {}
impl GaF32Scalar {
    fn zero() -> f32 { 0.0 }
}

/// A compact result inferred from a finite GA expression. The associated
/// tuple contains only statically supported output blades, in ascending blade
/// order. No output record or lane list is authored beside the expression.
pub trait EvaluateGaF32 {
    type Output
    fn evaluate(_ operands: Self) -> Self::Output
}

/// Structural compiler for bounded, finite GA expression trees over signed
/// orthogonal metrics. The expression and metric are configured Fe types;
/// runtime leaves are nested coefficient records selected by nominal type.
/// The current implementation intentionally accepts `Strict` only. It emits
/// authored-tree-order straight-line arithmetic and prunes structural zeros,
/// but does not yet claim cross-occurrence algebraic CSE or reassociation.
pub struct CompileGaF32<Program> {}

impl<Program> Derive<EvaluateGaF32> for CompileGaF32<Program> {
    const fn derive<T>(ev: own Evidence<EvaluateGaF32<T>>)
        -> Evidence<EvaluateGaF32<T>>
        uses (
            reflect: Reflect<T>,
            builder: mut ImplBuilder<EvaluateGaF32<T>>,
        )
    {
        let operands = builder.arg_ref("operands")
        let zero = builder.static_call(builder.ty<GaF32Scalar>(), "zero")

        // Reflect each runtime leaf once. A descriptor contains its nominal
        // coefficient type and shared loads for every declared coefficient.
        // Repeated uses of the same leaf therefore reuse the same generated
        // roots without author-assigned slots.
        let carriers = 0..0
        for carrier_field in reflect.fields() {
            let coefficient_fields = carrier_field.ty().fields()
            if coefficient_fields.len() > 0 {
                let base = builder.field_get(operands, carrier_field)
                let loads = 0..0
                for coefficient_field in coefficient_fields {
                    loads = loads.append(builder.share(
                        builder.field_get(base, coefficient_field),
                    ))
                }
                carriers = carriers.append(
                    (0..0).append(carrier_field.ty()).append(loads),
                )
            }
        }

        // Extract the three normalized GaProgram arguments from the configured
        // provider type. There is no zero-sized program field in the carrier.
        let program_types = 0..0
        for configured in builder.provider_ty().normalized_preorder_types() {
            if builder.same_ty(configured.constructor(), builder.ty<GaProgram>()) {
                for arg in configured.generic_args() {
                    if arg.is_type() { program_types = program_types.append(arg.ty()) }
                }
            }
        }

        let dimension: usize = 0
        let nonzero_squares: usize = 0
        let negative_squares: usize = 0
        let metric_valid: usize = 0
        let strict: usize = 0
        if program_types.len() == 3 {
            let metric = program_types.at(1)
            if builder.same_ty(
                metric.constructor(), builder.ty<SignedOrthogonalMetric>(),
            ) {
                let ordinal: usize = 0
                for arg in metric.generic_args() {
                    if arg.is_const() {
                        if ordinal == 0 { dimension = arg.const_value() }
                        if ordinal == 1 { nonzero_squares = arg.const_value() }
                        if ordinal == 2 { negative_squares = arg.const_value() }
                        ordinal = ordinal + 1
                    }
                }
                if ordinal == 3 && dimension > 0 && dimension < 6 {
                    let generator_limit: usize = 1 << dimension
                    if nonzero_squares < generator_limit
                        && negative_squares < generator_limit
                        && (negative_squares & nonzero_squares)
                            == negative_squares
                    {
                        metric_valid = 1
                    }
                }
            }
            if builder.same_ty(
                program_types.at(2).constructor(), builder.ty<Strict>(),
            ) {
                strict = 1
            }
        }

        let stack = 0..0
        if metric_valid == 1 && strict == 1 {
            let blade_count: usize = 1 << dimension
            let expression = program_types.at(0)

            // Every normalized node produces exactly one stack entry. Unknown
            // metadata nodes produce an invalid entry; their parent consumes
            // it like any other type child. Consequently an unknown expression
            // wrapper cannot disappear and accidentally expose a valid child.
            for node in expression.normalized_postorder_types() {
                let type_args = 0..0
                let const_args = 0..0
                for arg in node.generic_args() {
                    if arg.is_type() { type_args = type_args.append(arg.ty()) }
                    if arg.is_const() {
                        const_args = const_args.append(arg.const_value())
                    }
                }
                let children = 0..0
                for _child in 0..type_args.len() {
                    children = children.append(stack.last())
                    stack = stack.without_last()
                }

                let result = 0..0

                if builder.same_ty(
                    node.constructor(), builder.ty<MultivectorInput>(),
                ) && type_args.len() == 1 && const_args.len() == 1 {
                    let support = const_args.at(0)
                    let width = finite_support_width(support, blade_count)
                    let matches: usize = 0
                    let matched_loads = 0..0
                    for carrier in carriers {
                        if builder.same_ty(
                            type_args.at(0).constructor(), carrier.at(0),
                        ) {
                            matches = matches + 1
                            matched_loads = carrier.at(1)
                        }
                    }
                    if matches == 1 && width > 0
                        && support < (1 << blade_count)
                        && matched_loads.len() == width
                    {
                        let value = 0..0
                        for blade in 0..blade_count {
                            let component = zero
                            if finite_support_has(support, blade) {
                                component = matched_loads.at(
                                    finite_support_rank(support, blade),
                                )
                            }
                            value = value.append(component)
                        }
                        result = (0..0).append(support).append(value)
                    }
                }

                if builder.same_ty(node.constructor(), builder.ty<Sum>())
                    && type_args.len() == 2 && children.len() == 2
                {
                    let right = children.at(0)
                    let left = children.at(1)
                    if left.len() == 2 && right.len() == 2 {
                        let support = left.at(0) | right.at(0)
                        let value = 0..0
                        for blade in 0..blade_count {
                            let component = zero
                            if finite_support_has(left.at(0), blade)
                                && finite_support_has(right.at(0), blade)
                            {
                                component = builder.add(
                                    left.at(1).at(blade), right.at(1).at(blade),
                                )
                            }
                            if finite_support_has(left.at(0), blade)
                                && !finite_support_has(right.at(0), blade)
                            {
                                component = left.at(1).at(blade)
                            }
                            if !finite_support_has(left.at(0), blade)
                                && finite_support_has(right.at(0), blade)
                            {
                                component = right.at(1).at(blade)
                            }
                            value = value.append(component)
                        }
                        result = (0..0).append(support).append(value)
                    }
                }

                if builder.same_ty(node.constructor(), builder.ty<Difference>())
                    && type_args.len() == 2 && children.len() == 2
                {
                    let right = children.at(0)
                    let left = children.at(1)
                    if left.len() == 2 && right.len() == 2 {
                        let support = left.at(0) | right.at(0)
                        let value = 0..0
                        for blade in 0..blade_count {
                            let component = zero
                            if finite_support_has(left.at(0), blade)
                                && finite_support_has(right.at(0), blade)
                            {
                                component = builder.sub(
                                    left.at(1).at(blade), right.at(1).at(blade),
                                )
                            }
                            if finite_support_has(left.at(0), blade)
                                && !finite_support_has(right.at(0), blade)
                            {
                                component = left.at(1).at(blade)
                            }
                            if !finite_support_has(left.at(0), blade)
                                && finite_support_has(right.at(0), blade)
                            {
                                component = builder.neg(right.at(1).at(blade))
                            }
                            value = value.append(component)
                        }
                        result = (0..0).append(support).append(value)
                    }
                }

                if builder.same_ty(node.constructor(), builder.ty<Neg>())
                    && type_args.len() == 1 && children.len() == 1
                {
                    let source = children.at(0)
                    if source.len() == 2 {
                        let value = 0..0
                        for blade in 0..blade_count {
                            let component = zero
                            if finite_support_has(source.at(0), blade) {
                                component = builder.neg(source.at(1).at(blade))
                            }
                            value = value.append(component)
                        }
                        result = (0..0).append(source.at(0)).append(value)
                    }
                }

                if builder.same_ty(node.constructor(), builder.ty<Reverse>())
                    && type_args.len() == 1 && children.len() == 1
                {
                    let source = children.at(0)
                    if source.len() == 2 {
                        let value = 0..0
                        for blade in 0..blade_count {
                            let component = zero
                            if finite_support_has(source.at(0), blade) {
                                component = source.at(1).at(blade)
                                if reverse_negative(blade) {
                                    component = builder.neg(component)
                                }
                            }
                            value = value.append(component)
                        }
                        result = (0..0).append(source.at(0)).append(value)
                    }
                }

                if builder.same_ty(node.constructor(), builder.ty<Grade>())
                    && type_args.len() == 1 && const_args.len() == 1
                    && children.len() == 1
                {
                    let source = children.at(0)
                    if source.len() == 2 {
                        let wanted_grade = const_args.at(0)
                        let support: usize = 0
                        let value = 0..0
                        for blade in 0..blade_count {
                            let component = zero
                            if finite_support_has(source.at(0), blade)
                                && finite_blade_grade(blade) == wanted_grade
                            {
                                support = support | (1 << blade)
                                component = source.at(1).at(blade)
                            }
                            value = value.append(component)
                        }
                        result = (0..0).append(support).append(value)
                    }
                }

                if builder.same_ty(node.constructor(), builder.ty<PoincareDual>())
                    && type_args.len() == 1 && children.len() == 1
                {
                    let source = children.at(0)
                    if source.len() == 2 {
                        let pseudoscalar = blade_count - 1
                        let support: usize = 0
                        let value = 0..0
                        for _blade in 0..blade_count { value = value.append(zero) }
                        for blade in 0..blade_count {
                            if finite_support_has(source.at(0), blade) {
                                let output = pseudoscalar ^ blade
                                let component = source.at(1).at(blade)
                                if merge_negative(blade, output) {
                                    component = builder.neg(component)
                                }
                                support = support | (1 << output)
                                value = value.replace(output, component)
                            }
                        }
                        result = (0..0).append(support).append(value)
                    }
                }

                // Bilinear operators share one sparse pair scan. `mode` is
                // 0 geometric, 1 outer, 2 left contraction, 3 right
                // contraction, and 4 scalar product.
                let bilinear_mode: usize = 5
                if builder.same_ty(node.constructor(), builder.ty<Geometric>()) {
                    bilinear_mode = 0
                }
                if builder.same_ty(node.constructor(), builder.ty<Outer>()) {
                    bilinear_mode = 1
                }
                if builder.same_ty(
                    node.constructor(), builder.ty<LeftContraction>(),
                ) { bilinear_mode = 2 }
                if builder.same_ty(
                    node.constructor(), builder.ty<RightContraction>(),
                ) { bilinear_mode = 3 }
                if builder.same_ty(
                    node.constructor(), builder.ty<ScalarProduct>(),
                ) { bilinear_mode = 4 }

                if bilinear_mode < 5 && type_args.len() == 2
                    && children.len() == 2
                {
                    let right = children.at(0)
                    let left = children.at(1)
                    if left.len() == 2 && right.len() == 2 {
                        let support: usize = 0
                        let value = 0..0
                        let counts = 0..0
                        for _blade in 0..blade_count {
                            value = value.append(zero)
                            counts = counts.append(0)
                        }
                        for left_blade in 0..blade_count {
                            for right_blade in 0..blade_count {
                                if finite_support_has(left.at(0), left_blade)
                                    && finite_support_has(right.at(0), right_blade)
                                {
                                    let output = left_blade ^ right_blade
                                    let keep = geometric_survives(
                                        left_blade, right_blade, nonzero_squares,
                                    )
                                    if bilinear_mode == 1 {
                                        keep = (left_blade & right_blade) == 0
                                    }
                                    if bilinear_mode > 1 {
                                        if keep {
                                            if bilinear_mode == 2 {
                                                keep = left_contraction_keeps(
                                                    left_blade, right_blade, output,
                                                )
                                            }
                                            if bilinear_mode == 3 {
                                                keep = right_contraction_keeps(
                                                    left_blade, right_blade, output,
                                                )
                                            }
                                            if bilinear_mode == 4 {
                                                keep = output == 0
                                            }
                                        }
                                    }
                                    if keep {
                                        let term = builder.mul(
                                            left.at(1).at(left_blade),
                                            right.at(1).at(right_blade),
                                        )
                                        let negative = merge_negative(
                                            left_blade, right_blade,
                                        )
                                        if bilinear_mode != 1 {
                                            negative = geometric_negative(
                                                left_blade, right_blade,
                                                negative_squares,
                                            )
                                        }
                                        if negative { term = builder.neg(term) }
                                        if counts.at(output) == 0 {
                                            value = value.replace(output, term)
                                        } else {
                                            value = value.replace(
                                                output,
                                                builder.add(value.at(output), term),
                                            )
                                        }
                                        support = support | (1 << output)
                                        counts = counts.replace(
                                            output, counts.at(output) + 1,
                                        )
                                    }
                                }
                            }
                        }
                        result = (0..0).append(support).append(value)
                    }
                }

                // Regressive product is dual(dual(left) ^ dual(right)). This
                // direct sparse scan preserves that pinned orientation without
                // inventing a runtime intermediate.
                if builder.same_ty(node.constructor(), builder.ty<Regressive>())
                    && type_args.len() == 2 && children.len() == 2
                {
                    let right = children.at(0)
                    let left = children.at(1)
                    if left.len() == 2 && right.len() == 2 {
                        let pseudoscalar = blade_count - 1
                        let support: usize = 0
                        let value = 0..0
                        let counts = 0..0
                        for _blade in 0..blade_count {
                            value = value.append(zero)
                            counts = counts.append(0)
                        }
                        for left_blade in 0..blade_count {
                            for right_blade in 0..blade_count {
                                if finite_support_has(left.at(0), left_blade)
                                    && finite_support_has(right.at(0), right_blade)
                                {
                                    let dual_left = pseudoscalar ^ left_blade
                                    let dual_right = pseudoscalar ^ right_blade
                                    if (dual_left & dual_right) == 0 {
                                        let dual_output = dual_left ^ dual_right
                                        let output = pseudoscalar ^ dual_output
                                        let negative = merge_negative(
                                            left_blade, dual_left,
                                        )
                                        if merge_negative(right_blade, dual_right) {
                                            negative = !negative
                                        }
                                        if merge_negative(dual_left, dual_right) {
                                            negative = !negative
                                        }
                                        if merge_negative(dual_output, output) {
                                            negative = !negative
                                        }
                                        let term = builder.mul(
                                            left.at(1).at(left_blade),
                                            right.at(1).at(right_blade),
                                        )
                                        if negative { term = builder.neg(term) }
                                        if counts.at(output) == 0 {
                                            value = value.replace(output, term)
                                        } else {
                                            value = value.replace(
                                                output,
                                                builder.add(value.at(output), term),
                                            )
                                        }
                                        support = support | (1 << output)
                                        counts = counts.replace(
                                            output, counts.at(output) + 1,
                                        )
                                    }
                                }
                            }
                        }
                        result = (0..0).append(support).append(value)
                    }
                }

                stack = stack.append(result)
            }
        }

        // Infer a compact tuple type and value from the single valid root.
        // Unknown/malformed trees leave no conforming generated method.
        if stack.len() == 1 && stack.at(0).len() == 2 {
            let root = stack.at(0)
            let output_ty = builder.tuple_ty()
            let output = builder.tuple_expr()
            for blade in 0..(1 << dimension) {
                if finite_support_has(root.at(0), blade) {
                    output_ty = builder.with_elem_ty(output_ty, builder.ty<f32>())
                    output = builder.with_elem(output, root.at(1).at(blade))
                }
            }
            builder.emit_assoc_ty("Output", output_ty)
            builder.emit_method("evaluate", output)
        }
        builder.finish()
        ev
    }
}

const fn vector_support_has(_ support: usize, _ generator: usize) -> bool {
    ((support >> generator) & 1) == 1
}

const fn vector_support_rank(_ support: usize, _ generator: usize) -> usize {
    let mut probe: usize = 0
    let mut rank: usize = 0
    while probe < generator {
        if vector_support_has(support, probe) { rank = rank + 1 }
        probe = probe + 1
    }
    rank
}

const fn vector_support_width(_ support: usize, _ dimension: usize) -> usize {
    let mut generator: usize = 0
    let mut width: usize = 0
    while generator < dimension {
        if vector_support_has(support, generator) { width = width + 1 }
        generator = generator + 1
    }
    width
}

/// Generated scalar result of a sparse symmetric-metric product between two
/// packed `VectorInput`s. The configured provider carries the static
/// `GaProgram`; the target record contains one field per nominal leaf identity,
/// whose nested coefficient record is packed in ascending generator order.
pub trait EvaluateVectorScalarF32 {
    fn scalar(_ operands: Self) -> f32
}

/// Structural Fe/FCO compiler for [`EvaluateVectorScalarF32`]. It recognizes
/// operator and metric-term constructors, never a complete expression alias or
/// a precomputed candidate mask. The current carrier contract is deliberately
/// narrow: two distinct nominal vector leaves, `ScalarProduct` at the root,
/// and `AlgebraicBalanced`'s deterministic four-term chunk reduction.
pub struct CompileVectorScalarF32<Program> {}

impl<Program> Derive<EvaluateVectorScalarF32>
    for CompileVectorScalarF32<Program>
{
    const fn derive<T>(ev: own Evidence<EvaluateVectorScalarF32<T>>)
        -> Evidence<EvaluateVectorScalarF32<T>>
        uses (
            reflect: Reflect<T>,
            builder: mut ImplBuilder<EvaluateVectorScalarF32<T>>,
        )
    {
        let operands = builder.arg_ref("operands")
        let program_types = 0..0

        for configured in builder.provider_ty().normalized_preorder_types() {
            if builder.same_ty(configured.constructor(), builder.ty<GaProgram>()) {
                for arg in configured.generic_args() {
                    if arg.is_type() { program_types = program_types.append(arg.ty()) }
                }
            }
        }

        let descriptors = 0..0
        if program_types.len() == 3 {
            let expression = program_types.at(0)
            if builder.same_ty(
                expression.constructor(), builder.ty<ScalarProduct>(),
            ) {
                // This provider's deliberately narrow grammar is a scalar
                // product whose two direct children are vector leaves. Read
                // those edges directly: a normalized postorder also contains
                // each leaf's nominal `Identity` argument, which is data
                // inside the leaf rather than another GA expression node.
                for expression_arg in expression.generic_args() {
                    if expression_arg.is_type() {
                        let node = expression_arg.ty()
                        if builder.same_ty(
                            node.constructor(), builder.ty<VectorInput>(),
                        ) {
                            let identity = node
                            let type_count: usize = 0
                            let const_count: usize = 0
                            let support: usize = 0
                            for arg in node.generic_args() {
                                if arg.is_type() {
                                    if type_count == 0 { identity = arg.ty() }
                                    type_count = type_count + 1
                                }
                                if arg.is_const() {
                                    if const_count == 0 {
                                        support = arg.const_value()
                                    }
                                    const_count = const_count + 1
                                }
                            }
                            if type_count == 1 && const_count == 1 {
                                descriptors = descriptors.append(
                                    (0..0).append(identity).append(support),
                                )
                            } else {
                                descriptors = descriptors.append(0)
                            }
                        } else {
                            descriptors = descriptors.append(0)
                        }
                    }
                }
            }
        }

        if descriptors.len() == 2 {
            let left = descriptors.at(0)
            let right = descriptors.at(1)
            if left.len() == 2 && right.len() == 2 {
                let left_support = left.at(1)
                let right_support = right.at(1)
                let metric_nodes = program_types.at(1).normalized_preorder_types()
                let dimension: usize = 0
                for metric_node in metric_nodes {
                    if builder.same_ty(
                        metric_node.constructor(),
                        builder.ty<SparseSymmetricMetric>(),
                    ) {
                        for metric_arg in metric_node.generic_args() {
                            if metric_arg.is_const() {
                                dimension = metric_arg.const_value()
                            }
                        }
                    }
                }

                // Bind each nominal leaf identity to exactly one top-level
                // carrier field, then reflect the nested coefficient record.
                // No author-maintained slot number or flat positional offset
                // enters this mapping.
                let left_base = operands
                let right_base = operands
                let left_fields = 0..0
                let right_fields = 0..0
                let left_matches: usize = 0
                let right_matches: usize = 0
                for carrier_field in reflect.fields() {
                    if builder.same_ty(
                        left.at(0).constructor(), carrier_field.ty(),
                    ) {
                        left_base = builder.field_get(operands, carrier_field)
                        left_fields = carrier_field.ty().fields()
                        left_matches = left_matches + 1
                    }
                    if builder.same_ty(
                        right.at(0).constructor(), carrier_field.ty(),
                    ) {
                        right_base = builder.field_get(operands, carrier_field)
                        right_fields = carrier_field.ty().fields()
                        right_matches = right_matches + 1
                    }
                }
                let left_width = vector_support_width(left_support, dimension)
                let right_width = vector_support_width(right_support, dimension)

                if left_matches == 1 && right_matches == 1
                    && left_fields.len() == left_width
                    && right_fields.len() == right_width
                    && left_width > 0 && right_width > 0
                {
                    let first = builder.field_get(left_base, left_fields.at(0))
                    let zero = builder.sub(first, first)
                    let sum0 = zero
                    let sum1 = zero
                    let sum2 = zero
                    let survivor: usize = 0
                    for metric_node in metric_nodes {
                        if builder.same_ty(
                            metric_node.constructor(),
                            builder.ty<MetricTerm>(),
                        ) {
                            let ordinal: usize = 0
                            let metric_left: usize = dimension
                            let metric_right: usize = dimension
                            let magnitude: usize = 0
                            let negative: usize = 0
                            for metric_arg in metric_node.generic_args() {
                                if metric_arg.is_const() {
                                    if ordinal == 0 {
                                        metric_left = metric_arg.const_value()
                                    }
                                    if ordinal == 1 {
                                        metric_right = metric_arg.const_value()
                                    }
                                    if ordinal == 2 {
                                        magnitude = metric_arg.const_value()
                                    }
                                    if ordinal == 3 {
                                        negative = metric_arg.const_value()
                                    }
                                    ordinal = ordinal + 1
                                }
                            }

                            // A symmetric entry can contribute in either
                            // operand orientation. Diagonal entries are
                            // considered once.
                            for orientation in 0..2 {
                                let left_generator = metric_left
                                let right_generator = metric_right
                                if orientation == 1 {
                                    left_generator = metric_right
                                    right_generator = metric_left
                                }
                                if magnitude > 0
                                    && (orientation == 0
                                        || metric_left != metric_right)
                                    && vector_support_has(
                                        left_support, left_generator,
                                    )
                                    && vector_support_has(
                                        right_support, right_generator,
                                    )
                                {
                                    let left_field = vector_support_rank(
                                        left_support, left_generator,
                                    )
                                    let right_field = vector_support_rank(
                                        right_support, right_generator,
                                    )
                                    let lhs = builder.field_get(
                                        left_base, left_fields.at(left_field),
                                    )
                                    let rhs = builder.field_get(
                                        right_base, right_fields.at(right_field),
                                    )

                                    let base = builder.mul(lhs, rhs)
                                    let term = base
                                    for _copy in 1..magnitude {
                                        term = builder.add(term, base)
                                    }
                                    if negative == 1 { term = builder.neg(term) }
                                    if survivor < 4 {
                                        sum0 = builder.add(sum0, term)
                                    } else if survivor < 8 {
                                        sum1 = builder.add(sum1, term)
                                    } else {
                                        sum2 = builder.add(sum2, term)
                                    }
                                    survivor = survivor + 1
                                }
                            }
                        }
                    }
                    if dimension > 0 && survivor > 0
                        && builder.same_ty(
                            program_types.at(2).constructor(),
                            builder.ty<AlgebraicBalanced>(),
                        )
                    {
                        builder.emit_method(
                            "scalar",
                            builder.add(builder.add(sum0, sum1), sum2),
                        )
                    }
                }
            }
        }
        builder.finish()
        ev
    }
}

/// Conservative possible output blades of expression `Self` in metric `M`.
/// A dense/unknown leaf should explicitly use the metric's capacity mask.
pub trait GaSupport<M: StaticDiagonalMetric> {
    const SUPPORT: u32
}

impl<
    M: StaticDiagonalMetric,
    const Slot: usize,
    const Mask: u32,
> GaSupport<M> for Input<Slot, Mask> {
    const SUPPORT: u32 = Mask & support_capacity_mask(M::DIMENSION)
}

impl<M: StaticDiagonalMetric, A: GaSupport<M>, B: GaSupport<M>> GaSupport<M>
    for Sum<A, B>
{
    const SUPPORT: u32 = A::SUPPORT | B::SUPPORT
}

impl<M: StaticDiagonalMetric, A: GaSupport<M>, B: GaSupport<M>> GaSupport<M>
    for Difference<A, B>
{
    const SUPPORT: u32 = A::SUPPORT | B::SUPPORT
}

impl<M: StaticDiagonalMetric, A: GaSupport<M>> GaSupport<M> for Neg<A> {
    const SUPPORT: u32 = A::SUPPORT
}

impl<M: StaticDiagonalMetric, A: GaSupport<M>> GaSupport<M> for Reverse<A> {
    const SUPPORT: u32 = A::SUPPORT
}

impl<M: StaticDiagonalMetric, A: GaSupport<M>, const K: u32> GaSupport<M>
    for Grade<A, K>
{
    const SUPPORT: u32 = support_grade(
        blade_set(A::SUPPORT, M::DIMENSION),
        K,
    ).bits
}

impl<M: StaticDiagonalMetric, A: GaSupport<M>, B: GaSupport<M>> GaSupport<M>
    for Geometric<A, B>
{
    const SUPPORT: u32 = support_gp(
        blade_set(A::SUPPORT, M::DIMENSION),
        blade_set(B::SUPPORT, M::DIMENSION),
        M::NONZERO_SQUARES,
    ).bits
}

impl<M: StaticDiagonalMetric, A: GaSupport<M>, B: GaSupport<M>> GaSupport<M>
    for Outer<A, B>
{
    const SUPPORT: u32 = support_gp(
        blade_set(A::SUPPORT, M::DIMENSION),
        blade_set(B::SUPPORT, M::DIMENSION),
        0,
    ).bits
}

/// Conservative support for a grade-selected diagonal-metric product. `Mode`
/// is 0 for left contraction, 1 for right contraction, and 2 for scalar
/// product. This is a CTFE scan, never a runtime shader loop.
pub const fn support_contraction(
    _ left: BladeSet,
    _ right: BladeSet,
    _ nonzero_square_generators: u32,
    _ mode: u32,
) -> BladeSet {
    if left.dimension != right.dimension || !support_dimension_valid(left.dimension) {
        return blade_set(0, left.dimension)
    }
    let blade_count: u32 = 1 << left.dimension
    let mut l: u32 = 0
    let mut output: u32 = 0
    while l < blade_count {
        if ((left.bits >> l) & 1) == 1 {
            let mut r: u32 = 0
            while r < blade_count {
                if ((right.bits >> r) & 1) == 1 {
                    let shared: u32 = l & r
                    if (shared & nonzero_square_generators) == shared {
                        let lg = blade_grade(l)
                        let rg = blade_grade(r)
                        let og = blade_grade(l ^ r)
                        let keep = if mode == 0 {
                            lg <= rg && og == rg - lg
                        } else if mode == 1 {
                            rg <= lg && og == lg - rg
                        } else {
                            og == 0
                        }
                        if keep { output = output | (1 << (l ^ r)) }
                    }
                }
                r = r + 1
            }
        }
        l = l + 1
    }
    blade_set(output, left.dimension)
}

impl<M: StaticDiagonalMetric, A: GaSupport<M>, B: GaSupport<M>> GaSupport<M>
    for LeftContraction<A, B>
{
    const SUPPORT: u32 = support_contraction(
        blade_set(A::SUPPORT, M::DIMENSION),
        blade_set(B::SUPPORT, M::DIMENSION),
        M::NONZERO_SQUARES,
        0,
    ).bits
}

impl<M: StaticDiagonalMetric, A: GaSupport<M>, B: GaSupport<M>> GaSupport<M>
    for RightContraction<A, B>
{
    const SUPPORT: u32 = support_contraction(
        blade_set(A::SUPPORT, M::DIMENSION),
        blade_set(B::SUPPORT, M::DIMENSION),
        M::NONZERO_SQUARES,
        1,
    ).bits
}

impl<M: StaticDiagonalMetric, A: GaSupport<M>, B: GaSupport<M>> GaSupport<M>
    for ScalarProduct<A, B>
{
    const SUPPORT: u32 = support_contraction(
        blade_set(A::SUPPORT, M::DIMENSION),
        blade_set(B::SUPPORT, M::DIMENSION),
        M::NONZERO_SQUARES,
        2,
    ).bits
}

/// Metric-independent complement-blade support (Poincare dual), bounded by the
/// same explicit five-generator envelope as `BladeSet`.
pub const fn support_poincare_dual(_ value: BladeSet) -> BladeSet {
    if !support_dimension_valid(value.dimension) {
        return blade_set(0, value.dimension)
    }
    let blade_count: u32 = 1 << value.dimension
    let pseudoscalar: u32 = blade_count - 1
    let mut blade: u32 = 0
    let mut output: u32 = 0
    while blade < blade_count {
        if ((value.bits >> blade) & 1) == 1 {
            output = output | ((1 as u32) << (pseudoscalar ^ blade))
        }
        blade = blade + 1
    }
    blade_set(output, value.dimension)
}

impl<M: StaticDiagonalMetric, A: GaSupport<M>> GaSupport<M> for PoincareDual<A> {
    const SUPPORT: u32 = support_poincare_dual(
        blade_set(A::SUPPORT, M::DIMENSION),
    ).bits
}

impl<M: StaticDiagonalMetric, A: GaSupport<M>, B: GaSupport<M>> GaSupport<M>
    for Regressive<A, B>
{
    const SUPPORT: u32 = support_poincare_dual(support_gp(
        support_poincare_dual(blade_set(A::SUPPORT, M::DIMENSION)),
        support_poincare_dual(blade_set(B::SUPPORT, M::DIMENSION)),
        0,
    )).bits
}

// Canonical exact-term witness vocabulary. The support layer above is already
// compositional; the next compiler layer materializes normalized ground trees
// of these nodes for bounded FCO inspection and straight-line emission.
pub struct TermZero {}
pub struct TermAdd<H, T> {}

/// One bilinear survivor. Leaf/component identities are semantic slots, not
/// DOM/binding IDs. The first prototype uses non-negative magnitude plus a
/// 0/1 sign because FCO's reflected const values are currently unsigned. The
/// full design generalizes this to an exact scalar-domain coefficient.
pub struct BilinearTerm<
    const Left: usize,
    const Right: usize,
    const OutputBlade: usize,
    const Magnitude: usize,
    const Negative: usize,
> {}

// Compile-time examples over PGA(2,0,1): e0^2=0, e1^2=e2^2=+1.
type Pga2 = DiagonalMetric<3, 6>
type LineA = Input<0, 22>
type LineB = Input<1, 22>
type LineSum = Sum<LineA, LineB>
type LineMeet = Outer<LineSum, LineB>
type LineGp = Geometric<LineA, LineB>
type ScalarLane = Grade<LineGp, 0>
type DualLine = PoincareDual<LineA>

static_assert(<LineA as GaSupport<Pga2>>::SUPPORT == 22)
static_assert(<LineSum as GaSupport<Pga2>>::SUPPORT == 22)
static_assert(<LineMeet as GaSupport<Pga2>>::SUPPORT == 104)
static_assert(<LineGp as GaSupport<Pga2>>::SUPPORT == 105)
static_assert(<ScalarLane as GaSupport<Pga2>>::SUPPORT == 1)
static_assert(<DualLine as GaSupport<Pga2>>::SUPPORT == 104)
