//! Target-neutral actor execution roles.
//!
//! These types describe how a backend may invoke an authored actor behavior;
//! they do not name a host platform or prescribe application event vocabulary.

use super::backend::Backend
use super::pending::Pending

/// A request/response edge derived from one actor behavior.
///
/// Actor lowering synthesizes `Handles<M, R> for C` when actor `C`
/// declares a self-less behavior taking exactly one `M` and returning `R`.
/// The relation contains no numeric selector or host-authored lane name. A
/// backend can therefore prove that a mailbox request belongs to its nominal
/// child program before choosing a transport interpretation.
pub trait Handles<M, R> {}

/// Typed request authority for one nominal child actor program.
///
/// The capability is already branded by `C`, so callers pass only the request
/// value. Actor lowering determines `C: Handles<M, R>` from authored
/// behavior signatures, and the ordinary affine `Pending` rail carries the
/// response, cancellation, and failure lifecycle.
pub trait ActorMailbox<B: Backend, C> {
    fn ask<M, R>(mut self, _ message: own M) -> Pending<B, R>
        where C: Handles<M, R>
}

/// Typed mailbox authority for sending one value to the resident transition
/// owned by the current actor scope. A provider chooses the realization; the
/// event type remains ordinary Fe data and must agree with that actor's
/// `ResidentTransition` input.
///
/// The begin-shaped operation deliberately returns the same affine `Pending`
/// token used by timers, browser sources, Workers, and GPU completion. Sending
/// from a resumable task therefore has one cancellation/failure model rather
/// than a component-only callback protocol.
pub trait ActorSink<B: Backend, E> {
    fn send_begin(mut self, _ event: own E) -> Pending<B, ()>
}

/// A behavior whose complete returned state remains resident between calls.
/// The behavior takes one ordinary event value before its flattened actor
/// fields and returns the complete non-resource state in declaration order.
#[actor_transition(resident)]
pub struct ResidentTransition {}

/// A self-less actor behavior returning complete initial state. Backends may
/// publish it behind a fixed initialization ABI without exposing its authored
/// name to the host.
#[actor_initializer]
pub struct InitialState {}

/// A read-only actor behavior projecting resident state to a closed value for
/// its host. The role is target-neutral; web component patches are one library
/// consumer, not compiler vocabulary.
#[actor_projection]
pub struct ProjectState {}

/// A self-less actor behavior whose resumable body lives for one host-owned
/// actor scope. Resident component hosts start these tasks when their actor is
/// connected and cancel them when that scope closes. The compiler derives the
/// task's continuation machine from the behavior; authors do not name exports
/// or maintain a parallel task table.
#[actor_scoped_task]
pub struct ScopedTask {}

/// A self-less actor behavior whose const result describes page structure.
/// Build tooling may project this typed value before runtime artifacts are
/// discovered; the authored behavior name and concrete page vocabulary remain
/// ordinary Fe library choices.
#[actor_page_projection]
pub struct PageComposition {}

/// A self-less resident-actor behavior whose const result describes the
/// component's initial light-DOM fragment. Build tooling projects it into each
/// mount before the resident Wasm instance boots.
#[actor_component_projection]
pub struct ComponentComposition {}
