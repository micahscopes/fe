use ingot::{Copy, Option}

/// An owner-authorized record input to a structural const provider.
/// These handles are issued by elaboration, not constructed by Fe code.
pub struct Record { seal: bool }
pub struct Field { seal: bool }
pub struct FieldType { seal: bool }
impl Copy for Record {}
impl Copy for Field {}
impl Copy for FieldType {}

/// Fe syntax held as a compile-time value, built by `quote { .. }`. `K` is its
/// kind: `Expr`, `Item` or `Where`. A code value has no runtime
/// representation, and nothing inspects it; generation copies it into
/// ordinary checked code.
pub struct Code<K> { seal: bool }
impl<K> Copy for Code<K> {}

/// An expression fragment.
pub struct Expr {}
/// A list of items: functions, constants and impls.
pub struct Item {}
/// A list of where predicates.
pub struct Where {}

/// A Fe-authored query family applies this trait to each reflected field type.
/// The implementation's ordinary prerequisites must hold before evaluation.
pub trait FieldQuery<R> {
    const fn evaluate() -> R
}

extern {
    /// Reflection is evaluated only on compiler-issued inputs. These values
    /// cannot be serialized into runtime constants.
    pub const fn field_count(_ record: Record) -> usize
    pub const fn field(_ record: Record, _ index: usize) -> Field
    pub const fn field_type(_ field: Field) -> FieldType
    /// Test for bool, u64 or u256 (including aliases). Other candidate types
    /// are unsupported, not false. This is not general reflected equality.
    pub const fn type_is<T>(_ ty: FieldType) -> bool
    /// Apply F to the actual field type and evaluate its checked FieldQuery<R>
    /// implementation. This operation grants no new reflection authority.
    pub const fn query_field<F: * -> *, R>(_ ty: FieldType) -> R
}

extern {
    /// The empty fragment of kind `K`, the seed of a fold over items or where
    /// predicates.
    pub const fn empty<K>() -> Code<K>
}

extern {
    /// Count the fields of a nongeneric record from its defining module.
    ///
    /// This owner-scoped operation includes private fields. Aliases retain the
    /// record's identity. The returned number carries no reflection authority.
    pub const fn record_field_count<T>() -> u256
}

pub enum DeclarationName {
    Literal(String<31>),
    FieldPrefix(String<31>, Field),
}
impl Copy for DeclarationName {}
