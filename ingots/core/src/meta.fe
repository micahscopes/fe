use ingot::{Copy, Option}

/// An owner-authorized record input to a structural const provider.
/// These handles are issued by elaboration, not constructed by Fe code.
pub struct Record { seal: bool }
pub struct Field { seal: bool }
pub struct FieldType { seal: bool }
impl Copy for Record {}
impl Copy for Field {}
impl Copy for FieldType {}

/// A Fe-authored query family applies this trait to each reflected field type.
/// The implementation's ordinary prerequisites must hold before evaluation.
pub trait FieldQuery<R> {
    const fn evaluate() -> R
}

extern {
    /// Reflection is evaluated only on compiler-issued inputs. These values
    /// cannot be serialized into runtime constants.
    pub const fn field_count(_ record: Record) -> usize
    pub const fn field(_ record: Record, _ index: usize) -> Field
    pub const fn field_type(_ field: Field) -> FieldType
    /// Test for bool, u64 or u256 (including aliases). Other candidate types
    /// are unsupported, not false. This is not general reflected equality.
    pub const fn type_is<T>(_ ty: FieldType) -> bool
    /// Apply F to the actual field type and evaluate its checked FieldQuery<R>
    /// implementation. This operation grants no new reflection authority.
    pub const fn query_field<F: * -> *, R>(_ ty: FieldType) -> R
}

/// A computed value for a generated function body.
///
/// The driver accepts bool and u256 bodies against an explicit function
/// template. This value carries no authority to alter the template's signature.
pub struct FunctionBody<T> {
    pub value: T,
}

/// A request to fill one driver-authorized function template with a value.
///
/// Constructing this request grants no authority. The driver checks `target`
/// against explicit grants for the current request, then checks the complete
/// generated declaration. A target number is not a portable evidence identity.
pub struct FunctionEmission<T> {
    pub target: u256,
    pub value: T,
}

extern {
    /// Count the fields of a nongeneric record from its defining module.
    ///
    /// This owner-scoped operation includes private fields. Aliases retain the
    /// record's identity. The returned number carries no reflection authority.
    pub const fn record_field_count<T>() -> u256
}

/// A bounded straight-line scalar body. References are zero-based node indices
/// and must point backward. Every node is evaluated in array order.
pub struct ScalarBody<T, const N: usize> {
    pub nodes: [ScalarOp; N],
    pub result: u256,
}

/// Operations in an authored scalar body. Parameter indices use declaration
/// order, independently of argument labels. Operations retain ordinary Fe rules.
pub enum ScalarOp {
    U256(u256),
    Bool(bool),
    U256Parameter(u256),
    BoolParameter(u256),
    Add(u256, u256),
    Less(u256, u256),
    Equal(u256, u256),
    Not(u256),
}
impl Copy for ScalarOp {}

/// Structural declaration syntax. Reflected leaves keep their owner identity;
/// constructing a value does not authorize its emission or certify its types.
pub enum DeclarationType {
    Unit,
    Bool,
    U64,
    U256,
    Record(Record),
    Field(FieldType),
    BytePointer,
    Named(String<31>),
}
impl Copy for DeclarationType {}

pub enum DeclarationName {
    Literal(String<31>),
    FieldPrefix(String<31>, Field),
}
impl Copy for DeclarationName {}

/// References use parameter order or earlier expression indices. Ordinary Fe
/// checking determines operation types, ownership, and arithmetic behavior.
pub enum BodyExpr {
    Parameter(usize),
    Field(usize, Field),
    Bool(bool),
    U256(u256),
    Add(usize, usize),
    Call(FunctionCall),
    Unit,
    /// Unused capacity. Every following slot must also be End. References and
    /// the result cannot refer to these slots.
    End,
}
impl Copy for BodyExpr {}

/// Explicit source paths are resolved in the generated declaration's owner
/// scope. They are syntax, not captured bindings or evidence. Paths must start
/// with `ingot`, `core`, or `std`; ordinary visibility and requirements apply.
/// Optional argument slots must form a prefix, with no holes.
pub struct FunctionCall {
    pub path: String<31>,
    pub types: [Option<DeclarationType>; 2],
    pub arguments: [Option<CallArgument>; 4],
}
impl Copy for FunctionCall {}

pub struct CallArgument {
    pub label: Option<String<31>>,
    pub expression: usize,
}
impl Copy for CallArgument {}

/// A complete function, including its signature, checked during ordinary
/// compilation after source-invoked providers produce all declarations.
pub struct FunctionDefinition<const P: usize, const N: usize> {
    pub name: DeclarationName,
    pub public: bool,
    pub const_function: bool,
    pub parameters: [DeclarationType; P],
    pub return_type: DeclarationType,
    pub expressions: [BodyExpr; N],
    pub result: usize,
}
impl<const P: usize, const N: usize> Copy for FunctionDefinition<P, N> {}

pub enum AssociatedConstant {
    Bool(DeclarationName, bool),
    U256(DeclarationName, u256),
}
impl Copy for AssociatedConstant {}

/// An implementation for the authorized record. An optional method reuses the
/// function syntax: its first parameter must be Record(owner) and denotes
/// `own self`. Trait methods must set `public` to false. Ordinary checking
/// establishes the trait contract and coherence, including unused members.
pub struct RecordImplementation<const P: usize, const N: usize> {
    pub owner: Record,
    pub trait_path: String<31>,
    pub types: [Option<DeclarationType>; 2],
    pub constants: [Option<AssociatedConstant>; 2],
    pub method: Option<FunctionDefinition<P, N>>,
}
impl<const P: usize, const N: usize> Copy for RecordImplementation<P, N> {}
