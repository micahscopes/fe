use super::effect_ref::MemPtr

/// Borrowed bytes in wasm32 linear memory.
///
/// This descriptor does not own its payload. Canonical browser wrappers copy
/// returned payloads into wrapper-owned arena storage before crossing the ABI.
pub struct BrowserBytes {
    pub ptr: u32,
    pub len: u32,
}

/// Borrowed UTF-8 bytes in wasm32 linear memory.
///
/// The type carries the UTF-8 contract at the browser ABI boundary; it is not
/// Fe's general-purpose `String<N>` type.
pub struct BrowserString {
    pub ptr: u32,
    pub len: u32,
}

/// Allocated bytes returned from Fe through the canonical browser ABI.
///
/// Keeping the pointer as `MemPtr<u8>` preserves the backend's native
/// raw-address carrier. The canonical wrapper copies the payload into its
/// response arena before exposing an ordinary `BrowserBytes` descriptor.
pub struct AllocatedBrowserBytes {
    pub ptr: MemPtr<u8>,
    pub len: u32,
}

/// Borrowed bounded homogeneous values in wasm32 linear memory.
///
/// `MAX` is part of the browser ABI contract. Canonical wrappers currently
/// expose only `u32` and `f32` instantiations and copy returned elements into
/// wrapper-owned arena storage before publishing the descriptor.
pub struct BrowserList<T, const MAX: usize> {
    // The element type is carried by the nominal descriptor. Keeping the wire
    // address as wasm32's plain scalar word lets ordinary message records be
    // scalarized by the canonical wrapper, while preventing this borrowed
    // browser view from masquerading as an owning/dereferenceable Fe pointer.
    pub ptr: u32,
    pub len: u32,
}

impl Copy for BrowserBytes {}
impl Copy for BrowserString {}
impl Copy for AllocatedBrowserBytes {}
impl<T, const MAX: usize> Copy for BrowserList<T, MAX> {}

/// Marks a canonical browser lane as host-executed.
pub trait HostEffect {}

/// Requires a canonical browser lane to reside on the browser main thread.
pub trait MainThread {}

/// Requires a canonical browser lane to reside in a Worker.
pub trait Worker {}
