use ingot::Copy
use super::effect_ref::{AddressSpace, EffectHandle, EffectHandleMut, EffectRef, EffectRefMut, MemPtr}
use super::num::IntDowncast

/// Borrowed bytes in wasm32 linear memory.
///
/// This descriptor does not own its payload. Canonical browser wrappers copy
/// returned payloads into wrapper-owned arena storage before crossing the ABI.
#[host_type(bytes)]
pub struct BrowserBytes {
    pub ptr: u32,
    pub len: u32,
}

/// Borrowed UTF-8 bytes in wasm32 linear memory.
///
/// The type carries the UTF-8 contract at the browser ABI boundary; it is not
/// Fe's general-purpose `String<N>` type.
#[host_type(string)]
pub struct BrowserString {
    pub ptr: u32,
    pub len: u32,
}

/// Borrowed UTF-16 code units in linear memory.
///
/// `len` counts 16-bit code units, matching Web IDL `DOMString` transport.
pub struct BrowserUtf16String {
    pub ptr: u32,
    pub len: u32,
}

/// Borrowed Latin-1 bytes in linear memory.
///
/// `len` counts bytes, matching Web IDL `ByteString` transport.
pub struct BrowserLatin1String {
    pub ptr: u32,
    pub len: u32,
}

/// wasm32-native pointer used by browser component state and effect buffers.
/// Unlike the cross-target `MemPtr`, its source-level carrier is exactly one
/// `u32`, so pointer arithmetic never introduces an out-of-envelope `u256`
/// into Wasm application code.
pub struct BrowserPtr<T> {
    addr: u32,
}

/// Allocate browser linear memory and return a wasm32-native pointer.
extern {
    pub fn alloc_browser_bytes(_ size: u32) -> BrowserPtr<u8>
}

/// Allocated bytes returned from Fe through the canonical browser ABI.
///
/// Keeping the pointer as `MemPtr<u8>` preserves the backend's native
/// raw-address carrier. The canonical wrapper copies the payload into its
/// response arena before exposing an ordinary `BrowserBytes` descriptor.
#[host_type(bytes)]
pub struct AllocatedBrowserBytes {
    pub ptr: MemPtr<u8>,
    pub len: u32,
}

/// Borrowed bounded homogeneous values in wasm32 linear memory.
///
/// `MAX` is part of the browser ABI contract. Canonical wrappers currently
/// expose only `u32` and `f32` instantiations and copy returned elements into
/// wrapper-owned arena storage before publishing the descriptor.
#[host_type(list)]
pub struct BrowserList<T, const MAX: usize> {
    // The typed pointer preserves Fe's memory-provider semantics while the
    // canonical wasm32 boundary carries its physical address as one i32 word.
    pub ptr: MemPtr<T>,
    pub len: u32,
}

impl Copy for BrowserBytes {}
impl Copy for BrowserString {}
impl Copy for BrowserUtf16String {}
impl Copy for BrowserLatin1String {}
impl<T> Copy for BrowserPtr<T> {}
impl Copy for AllocatedBrowserBytes {}
impl<T, const MAX: usize> Copy for BrowserList<T, MAX> {}

impl<T> EffectHandle for BrowserPtr<T> {
    type Target = T
    const SPACE: AddressSpace = AddressSpace::Memory

    fn from_raw(_ raw: u256) -> Self {
        Self { addr: raw.downcast_truncate() }
    }

    fn raw(self) -> u256 {
        self.addr as u256
    }
}

impl<T> EffectHandleMut for BrowserPtr<T> {}
impl<T> EffectRef<T> for BrowserPtr<T> {}
impl<T> EffectRefMut<T> for BrowserPtr<T> {}

impl<T> BrowserPtr<T> {
    pub fn from_u32(_ addr: u32) -> Self {
        Self { addr: addr }
    }

    pub fn address(self) -> u32 {
        self.addr
    }

    pub fn read(self) -> T
        where T: Copy
    {
        let mut ptr = self
        with (ptr) {
            super::effect_ref::read(ptr)
        }
    }

    pub fn write(self, _ value: T) {
        let mut ptr = self
        with (ptr) {
            super::effect_ref::write(ptr, value)
        }
    }
}

/// Marks a canonical browser lane as host-executed.
#[host_execution(external)]
pub trait HostEffect {}

/// Requires a canonical browser lane to reside on the browser main thread.
#[host_placement(main_thread)]
pub trait MainThread {}

/// Requires a canonical browser lane to reside in a Worker.
#[host_placement(worker)]
pub trait Worker {}
