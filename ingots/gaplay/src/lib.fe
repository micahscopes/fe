//! gaplay: a small geometric-algebra playground over `ga_expr`.
//!
//! This ingot adds the two operations ganja.js spells `^` (meet) and `&`
//! (join) for the projective plane PGA 2D = Cl(2,0,1). Fe does not overload
//! those tokens; the authored algebra is the ordinary type expression
//! `Wedge<Left, Right>` under a named basis metric. `CompileGaF32` infers
//! sparse support and the compact three-component result.
//!
//! One kernel, two operators. The outer product of two grade-1 vectors is the
//! antisymmetric bilinear map
//!     out = (i0*j1 - i1*j0,  i0*j2 - i2*j0,  i1*j2 - i2*j1)
//! over the three generators {e0, e1, e2}. In PGA 2D the LINES are grade-1
//! vectors and the POINTS are grade-2 (the dual), and the regressive (join)
//! product is the dual of the outer product, so the SAME kernel computes both:
//!   - meet(line, line)  = intersection POINT (outer product on line space);
//!   - join(point, point) = connecting LINE (outer product on the dual space).
//! Both fall out of one compiled `pga2_wedge3`.
//!
//! The codegen gate compiles this ingot to Wasm and checks the generated kernel
//! bit-for-bit against an independent hand-tabled cross product over 4,008
//! directed/random cases, plus the Desargues collinearity the demo rests on.

use core::marker::Copy
use ga_expr::{
    BasisMetric, CompileGaF32, Degenerate, EvaluateGaF32, GaProgram,
    Positive, Strict, Vector, Wedge,
}

// ---------------------------------------------------------------------------
// The complete authored PGA-2D algebra. Both operands are grade-1 over
// generators e0,e1,e2. e0 is null; e1/e2 square to +1. The result support
// {e01,e02,e12} and its compact tuple representation are compiler-derived.
// ---------------------------------------------------------------------------

struct Pga2Basis { e0: Degenerate, e1: Positive, e2: Positive }
struct LeftVector { e0: f32, e1: f32, e2: f32 }
struct RightVector { e0: f32, e1: f32, e2: f32 }
type Left = Vector<LeftVector>
type Right = Vector<RightVector>
type PgaWedge = Wedge<Left, Right>
type Pga2 = BasisMetric<Pga2Basis>

struct WedgeOperands { left: LeftVector, right: RightVector }

derive EvaluateGaF32 for WedgeOperands using CompileGaF32<
    GaProgram<PgaWedge, Pga2, Strict>
>

/// A grade-2 (or dually, grade-1) result: three coefficients.
pub struct Bivec3 { pub c0: f32, pub c1: f32, pub c2: f32 }
impl Copy for Bivec3 {}

/// The compiled outer product of two grade-1 vectors, as flat f32 arithmetic.
/// This one kernel is meet AND join (see below).
pub fn pga2_wedge3(
    _ l0: f32, _ l1: f32, _ l2: f32, _ r0: f32, _ r1: f32, _ r2: f32,
) -> Bivec3 {
    let result = <WedgeOperands as EvaluateGaF32>::evaluate(WedgeOperands {
        left: LeftVector { e0: l0, e1: l1, e2: l2 },
        right: RightVector { e0: r0, e1: r1, e2: r2 },
    })
    Bivec3 { c0: result.0, c1: result.1, c2: result.2 }
}

// ---------------------------------------------------------------------------
// PGA-2D points and lines, and the two operators over the one kernel.
//
// A LINE is a grade-1 vector (l0 e0 + l1 e1 + l2 e2); its zero set in the plane
// is { (x, y) : l0 + l2*x - l1*y = 0 }. A POINT is stored in homogeneous
// coordinates (c0 : c1 : c2), its Euclidean location (c0/c2, c1/c2). A
// Euclidean point (x, y) embeds as (x : y : 1).
// ---------------------------------------------------------------------------

pub struct Line { pub c0: f32, pub c1: f32, pub c2: f32 }
impl Copy for Line {}

pub struct Point { pub c0: f32, pub c1: f32, pub c2: f32 }
impl Copy for Point {}

pub fn point_xy(_ x: f32, _ y: f32) -> Point { Point { c0: x, c1: y, c2: 1.0 } }

pub fn point_world_x(_ p: Point) -> f32 { p.c0 / p.c2 }
pub fn point_world_y(_ p: Point) -> f32 { p.c1 / p.c2 }

/// join (ganja `&`): the LINE through two points, = outer product of the dual.
pub fn join(_ p: Point, _ q: Point) -> Line {
    let w = pga2_wedge3(p.c0, p.c1, p.c2, q.c0, q.c1, q.c2)
    Line { c0: w.c0, c1: w.c1, c2: w.c2 }
}

/// meet (ganja `^`): the intersection POINT of two lines, = outer product.
pub fn meet(_ a: Line, _ b: Line) -> Point {
    let w = pga2_wedge3(a.c0, a.c1, a.c2, b.c0, b.c1, b.c2)
    Point { c0: w.c0, c1: w.c1, c2: w.c2 }
}

/// Point-on-line incidence: zero exactly when the point lies on the line.
pub fn incidence(_ p: Point, _ l: Line) -> f32 {
    p.c0 * l.c2 - p.c1 * l.c1 + p.c2 * l.c0
}

/// Signed value of the line's field at a Euclidean sample point; zero on the
/// line. `= incidence(point_xy(x, y), l)`.
pub fn line_eval(_ l: Line, _ x: f32, _ y: f32) -> f32 {
    l.c0 + l.c2 * x - l.c1 * y
}

// ---------------------------------------------------------------------------
// The Desargues configuration, in a canonical (unrotated) frame. A fixed base
// triangle A, B, C and a centre of perspectivity O; the second triangle's
// vertices slide along the rays O->vertex by per-vertex scalars derived from
// one sweep parameter (distinct factors, so the second triangle is a genuine
// perspective image, not a similarity: its sides are not parallel to the
// first's, so the three cross-intersections are finite and visibly move). Both
// the demo and the codegen gate build the figure from THESE constructors, so
// they cannot drift.
//
// The negative vertex coordinates are formed by runtime subtraction from zero
// rather than negative `const` literals: a `const f32 = -0.6` initializer needs
// CTFE negation, which the const machine does not implement (it reports
// "expected int"). The magnitudes below are plain positive literals; the signs
// live in the runtime constructors. The meet/join kernel itself is unaffected.
// ---------------------------------------------------------------------------

pub const DESA_OX: f32 = 0.0
pub const DESA_OY: f32 = 0.05
pub const DESA_AXM: f32 = 0.6
pub const DESA_AYM: f32 = 0.4
pub const DESA_BX: f32 = 0.7
pub const DESA_BYM: f32 = 0.45
pub const DESA_CX: f32 = 0.0
pub const DESA_CY: f32 = 0.75
pub const DESA_FB: f32 = 1.45
pub const DESA_FC: f32 = 0.72

/// The centre of perspectivity O and the three base-triangle vertices, as the
/// ONE source of truth shared by the demo and the codegen gate.
pub fn desa_o() -> Point { point_xy(DESA_OX, DESA_OY) }
pub fn desa_a() -> Point { point_xy(0.0 - DESA_AXM, 0.0 - DESA_AYM) }
pub fn desa_b() -> Point { point_xy(DESA_BX, 0.0 - DESA_BYM) }
pub fn desa_c() -> Point { point_xy(DESA_CX, DESA_CY) }

/// The second-triangle vertex along ray O->v at ray scalar t.
pub fn desargues_image(_ v: Point, _ t: f32) -> Point {
    let o = desa_o()
    point_xy(o.c0 + t * (v.c0 - o.c0), o.c1 + t * (v.c1 - o.c1))
}

/// The three Desargues cross-intersections (corresponding-side meets) for a
/// sweep value. Theorem: they are collinear (the axis of perspectivity).
pub struct CrossPoints { pub pa: Point, pub pb: Point, pub pc: Point }
impl Copy for CrossPoints {}

pub fn desargues_cross(_ sweep: f32) -> CrossPoints {
    let a = desa_a()
    let b = desa_b()
    let c = desa_c()
    let ap = desargues_image(a, sweep)
    let bp = desargues_image(b, sweep * DESA_FB)
    let cp = desargues_image(c, sweep * DESA_FC)
    CrossPoints {
        pa: meet(join(b, c), join(bp, cp)),
        pb: meet(join(c, a), join(cp, ap)),
        pc: meet(join(a, b), join(ap, bp)),
    }
}

/// The homogeneous collinearity residual of the three cross-points: the
/// incidence of the third with the axis through the first two. Zero (up to
/// float rounding) is Desargues' theorem.
pub fn desargues_residual(_ sweep: f32) -> f32 {
    let x = desargues_cross(sweep)
    incidence(x.pc, join(x.pa, x.pb))
}
